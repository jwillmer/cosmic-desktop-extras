From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: patchset <patchset@localhost>
Date: Tue, 10 Nov 2026 23:03:04 +0100
Subject: [PATCH] status-area: keep the colors of tray icons given as a file
 path

Icons loaded by path were always drawn symbolic (one theme color). Only
do that when the file name ends in -symbolic, like named icons.

diff --git a/cosmic-applet-status-area/src/components/icon_color.rs b/cosmic-applet-status-area/src/components/icon_color.rs
new file mode 100644
index 0000000..e3fb542
--- /dev/null
+++ b/cosmic-applet-status-area/src/components/icon_color.rs
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+use std::path::Path;
+
+/// Whether an icon given as a file path is drawn in the theme color. Like named icons, only files
+/// named `*-symbolic.*` are; any other file keeps its own colors.
+pub fn path_is_symbolic(path: &Path) -> bool {
+    path.file_stem()
+        .and_then(|stem| stem.to_str())
+        .is_some_and(|stem| stem.ends_with("-symbolic"))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn symbolic_file_names_are_symbolic() {
+        for path in [
+            "/usr/share/icons/hicolor/scalable/status/mail-unread-symbolic.svg",
+            "/tmp/tray/foo-symbolic.png",
+            "/tmp/tray/foo-symbolic",
+            "foo-symbolic.svg",
+        ] {
+            assert!(path_is_symbolic(Path::new(path)), "{path}");
+        }
+    }
+
+    #[test]
+    fn colored_file_names_keep_their_colors() {
+        for path in [
+            "/tmp/tray/betterbird.svg",
+            "/tmp/tray/betterbird-unread.png",
+            "/tmp/tray/betterbird",
+            "/tmp/symbolic/foo.svg",
+            "/tmp/foo-symbolic/foo.svg",
+            "/tmp/tray/symbolic.svg",
+            "/tmp/tray/foo-symbolic-2.svg",
+            "/tmp/tray/foo.symbolic.svg",
+            "",
+        ] {
+            assert!(!path_is_symbolic(Path::new(path)), "{path}");
+        }
+    }
+
+    #[test]
+    fn suffix_is_case_sensitive_like_icon_names() {
+        assert!(!path_is_symbolic(Path::new("/tmp/tray/foo-Symbolic.svg")));
+        assert!(!path_is_symbolic(Path::new("/tmp/tray/FOO-SYMBOLIC.PNG")));
+    }
+}

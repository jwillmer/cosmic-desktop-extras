@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Publishes the tab count of each window of this process for external readers (e.g. a taskbar
+//! applet). The file is `$XDG_RUNTIME_DIR/cosmic-term-tabs/<pid>.json` and contains
+//! `{"windows":[{"title":"<window title>","tabs":<n>}]}`. It is rewritten atomically, and only
+//! when its content changes.
+
+use std::{env, fmt::Write as _, fs, path::PathBuf, process};
+
+fn file_path() -> Option<PathBuf> {
+    let runtime_dir = env::var_os("XDG_RUNTIME_DIR")?;
+    Some(
+        PathBuf::from(runtime_dir)
+            .join("cosmic-term-tabs")
+            .join(format!("{}.json", process::id())),
+    )
+}
+
+/// Remove the published file of this process, best effort
+pub fn remove_file() {
+    if let Some(path) = file_path() {
+        let _ = fs::remove_file(path);
+    }
+}
+
+fn push_json_string(json: &mut String, value: &str) {
+    json.push('"');
+    for c in value.chars() {
+        match c {
+            '"' => json.push_str("\\\""),
+            '\\' => json.push_str("\\\\"),
+            '\n' => json.push_str("\\n"),
+            '\r' => json.push_str("\\r"),
+            '\t' => json.push_str("\\t"),
+            c if (c as u32) < 0x20 => {
+                let _ = write!(json, "\\u{:04x}", c as u32);
+            }
+            c => json.push(c),
+        }
+    }
+    json.push('"');
+}
+
+fn to_json(windows: &[(&str, usize)]) -> String {
+    let mut json = String::from("{\"windows\":[");
+    for (i, (title, tabs)) in windows.iter().enumerate() {
+        if i > 0 {
+            json.push(',');
+        }
+        json.push_str("{\"title\":");
+        push_json_string(&mut json, title);
+        let _ = write!(json, ",\"tabs\":{tabs}}}");
+    }
+    json.push_str("]}");
+    json
+}
+
+#[derive(Default)]
+pub struct TabPublisher {
+    last_json: Option<String>,
+    warned: bool,
+}
+
+impl TabPublisher {
+    /// Publish `(window title, tab count)` for every window, if it changed since the last write
+    pub fn publish(&mut self, windows: &[(&str, usize)]) {
+        let json = to_json(windows);
+        if self.last_json.as_deref() == Some(json.as_str()) {
+            return;
+        }
+        let Some(path) = file_path() else {
+            if !self.warned {
+                log::warn!("XDG_RUNTIME_DIR is not set, not publishing tab counts");
+                self.warned = true;
+            }
+            self.last_json = Some(json);
+            return;
+        };
+        let tmp_path = path.with_extension("json.tmp");
+        let res = path
+            .parent()
+            .map_or(Ok(()), fs::create_dir_all)
+            .and_then(|()| fs::write(&tmp_path, &json))
+            .and_then(|()| fs::rename(&tmp_path, &path));
+        match res {
+            Ok(()) => {}
+            Err(err) => {
+                let _ = fs::remove_file(&tmp_path);
+                if !self.warned {
+                    log::warn!("failed to write tab counts to {}: {}", path.display(), err);
+                    self.warned = true;
+                }
+            }
+        }
+        // Remember the content even on error, so a failing write is not retried on every update
+        self.last_json = Some(json);
+    }
+}
+
+impl Drop for TabPublisher {
+    fn drop(&mut self) {
+        if self.last_json.is_some() {
+            remove_file();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::to_json;
+
+    #[test]
+    fn json_escapes_title() {
+        assert_eq!(
+            to_json(&[("a \"b\" \\ c\n\u{1}", 2)]),
+            r#"{"windows":[{"title":"a \"b\" \\ c\n\u0001","tabs":2}]}"#
+        );
+        assert_eq!(to_json(&[]), r#"{"windows":[]}"#);
+    }
+}

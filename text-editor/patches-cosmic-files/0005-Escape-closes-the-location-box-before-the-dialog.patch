+/// The location box closes itself on Escape (and on focus loss), and the same Escape reaches
+/// `on_escape` a moment later. An Escape that soon after the box closed is that one.
+const LOCATION_ESCAPE_WINDOW: time::Duration = time::Duration::from_millis(500);
+
+fn location_took_escape(closed_ago: Option<time::Duration>) -> bool {
+    closed_ago.is_some_and(|ago| ago < LOCATION_ESCAPE_WINDOW)
+}

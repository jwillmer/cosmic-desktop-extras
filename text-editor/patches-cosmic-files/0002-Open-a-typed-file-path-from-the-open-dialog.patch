+
+/// The file an open-file dialog accepts when the location field holds the absolute path of an
+/// existing file. Folders, missing paths, the save dialog and folder dialogs return None and keep
+/// the usual behaviour (change to the folder, or to the parent with the file selected).
+fn typed_file_to_open(kind: &DialogKind, edit_location: &EditLocation) -> Option<PathBuf> {
+    if kind.save() || kind.is_dir() {
+        return None;
+    }
+    match edit_location.resolve()? {
+        Location::Path(path) if path.is_absolute() && path.is_file() => Some(path),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use std::fs;
+    use std::path::PathBuf;
+
+    use tempfile::TempDir;
+
+    use super::{DialogKind, typed_file_to_open};
+    use crate::location::{EditLocation, Location};
+
+    fn typed(path: PathBuf) -> EditLocation {
+        Location::Path(PathBuf::new()).with_path(path).into()
+    }
+
+    #[test]
+    fn typed_file_opens_only_existing_files_in_open_file_dialogs() {
+        let dir = TempDir::new().unwrap();
+        let file = dir.path().join("notes").join("todo.md");
+        fs::create_dir_all(file.parent().unwrap()).unwrap();
+        fs::write(&file, "- [ ] item\n").unwrap();
+        let open = DialogKind::OpenFile;
+
+        assert_eq!(
+            typed_file_to_open(&open, &typed(file.clone())),
+            Some(file.clone())
+        );
+        assert_eq!(
+            typed_file_to_open(&DialogKind::OpenMultipleFiles, &typed(file.clone())),
+            Some(file.clone())
+        );
+        // A folder navigates, a missing path keeps the usual handling
+        assert_eq!(
+            typed_file_to_open(&open, &typed(dir.path().join("notes"))),
+            None
+        );
+        assert_eq!(
+            typed_file_to_open(&open, &typed(dir.path().join("missing.md"))),
+            None
+        );
+        // Relative paths are not resolved against the process directory
+        assert_eq!(
+            typed_file_to_open(&open, &typed(PathBuf::from("todo.md"))),
+            None
+        );
+        // Save and folder dialogs are unchanged
+        let save = DialogKind::SaveFile {
+            filename: String::new(),
+        };
+        assert_eq!(typed_file_to_open(&save, &typed(file.clone())), None);
+        assert_eq!(
+            typed_file_to_open(&DialogKind::OpenFolder, &typed(file.clone())),
+            None
+        );
+        // Other locations (search, network, trash) are unchanged
+        assert_eq!(typed_file_to_open(&open, &Location::Trash.into()), None);
+    }
+}

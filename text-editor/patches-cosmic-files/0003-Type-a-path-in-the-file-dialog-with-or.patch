+    #[test]
+    fn slash_and_tilde_start_a_typed_path() {
+        for mode in [TypeToSearch::Recursive, TypeToSearch::SelectByPrefix] {
+            assert!(starts_location(mode, "/", false), "{mode:?}");
+            assert!(starts_location(mode, "~", false), "{mode:?}");
+            // Not inside a search term or a name being typed
+            assert!(!starts_location(mode, "/", true), "{mode:?}");
+            assert!(!starts_location(mode, "~", true), "{mode:?}");
+            // Other characters keep searching or selecting
+            for text in ["a", ".", "-", " ", "\\", "~/"] {
+                assert!(!starts_location(mode, text, false), "{mode:?} {text:?}");
+            }
+        }
+        // Typed text goes to the location box already
+        assert!(!starts_location(TypeToSearch::EnterPath, "/", false));
+        assert!(!starts_location(TypeToSearch::EnterPath, "~", false));
+
+        assert_eq!(location_start("/"), "/");
+        assert_eq!(PathBuf::from(location_start("~")), home_dir());
+    }
+
+    #[test]
+    fn ctrl_l_edits_the_location_in_every_dialog() {
+        let ctrl_l = KeyBind {
+            modifiers: vec![Modifier::Ctrl],
+            key: Key::Character("l".into()),
+        };
+        for kind in [
+            DialogKind::OpenFile,
+            DialogKind::OpenFolder,
+            DialogKind::SaveFile {
+                filename: String::new(),
+            },
+        ] {
+            let binds = key_binds(&tab::Mode::Dialog(kind));
+            assert_eq!(binds.get(&ctrl_l), Some(&Action::EditLocation));
+        }
+    }
 
     fn typed(path: PathBuf) -> EditLocation {
         Location::Path(PathBuf::new()).with_path(path).into()

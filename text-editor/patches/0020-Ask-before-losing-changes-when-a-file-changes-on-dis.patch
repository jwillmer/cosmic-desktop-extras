index 0000000..e27268a
--- /dev/null
+++ b/src/disk_change.rs
@@ -0,0 +1,363 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Changed on disk: when the file of a tab with unsaved changes changes or goes away on disk,
+//! a bar above the editor offers Reload (take the disk version), Compare (with saved) and Keep
+//! mine (the next save overwrites the file). A tab without unsaved changes reloads silently, as
+//! upstream does.
+//!
+//! Each tab remembers the base: a content hash of the file as it last loaded or saved it. The
+//! file watcher, switching to a tab, saving and session restore compare the file against it, so
+//! our own saves never trigger the bar, and a save never overwrites a change nobody has seen.
+//! The base goes into the session with the draft, so an unanswered bar survives a restart.
+
+use cosmic::{
+    Application, Element,
+    app::Task,
+    iced::{Alignment, Length},
+    theme,
+    widget::{self, button, segmented_button::Entity},
+};
+use notify::{
+    EventKind, RecursiveMode, Watcher,
+    event::{ModifyKind, RemoveKind},
+};
+use serde::{Deserialize, Serialize};
+use std::{
+    fs,
+    hash::{DefaultHasher, Hash, Hasher},
+    io,
+    path::Path,
+    time::SystemTime,
+};
+
+use crate::{
+    App, Message as AppMessage, fl,
+    tab::{EditorTab, Tab},
+};
+
+/// The file contents as a hash; `None` when there is no file on disk.
+pub type Fingerprint = Option<u64>;
+
+pub fn hash_bytes(bytes: &[u8]) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    bytes.hash(&mut hasher);
+    hasher.finish()
+}
+
+/// The file a tab's text is based on.
+#[derive(Clone, Copy, Debug, Default, Deserialize, PartialEq, Serialize)]
+pub enum Base {
+    /// Not known: a restored draft over a file that changed since, or an unreadable file.
+    #[default]
+    Unknown,
+    Missing,
+    Hash(u64),
+}
+
+impl Base {
+    fn of(disk: Fingerprint) -> Self {
+        disk.map_or(Self::Missing, Self::Hash)
+    }
+}
+
+/// What the bar above the editor says.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Bar {
+    /// Reload, Compare and Keep mine.
+    Changed,
+    /// Keep mine only: saving recreates the file.
+    Deleted,
+}
+
+impl Bar {
+    fn for_disk(disk: Fingerprint) -> Self {
+        if disk.is_some() {
+            Self::Changed
+        } else {
+            Self::Deleted
+        }
+    }
+}
+
+#[derive(Debug, PartialEq)]
+pub enum Action {
+    Nothing,
+    SilentReload,
+    ShowBar(Bar),
+}
+
+/// Decide what a change on disk does to a tab.
+pub fn decide(dirty: bool, base: Base, disk: Fingerprint) -> Action {
+    if base == Base::of(disk) {
+        return Action::Nothing;
+    }
+    match (dirty, disk) {
+        (true, disk) => Action::ShowBar(Bar::for_disk(disk)),
+        (false, Some(_)) => Action::SilentReload,
+        // Upstream keeps the text of a clean tab whose file is gone
+        (false, None) => Action::Nothing,
+    }
+}
+
+/// Watcher events after which the watch on a file may be gone: a program that saves by
+/// writing a new file and renaming it over the old one replaces the watched inode.
+pub fn needs_rewatch(kind: &EventKind) -> bool {
+    matches!(
+        kind,
+        EventKind::Remove(RemoveKind::Any | RemoveKind::File)
+            | EventKind::Modify(ModifyKind::Name(_))
+    )
+}
+
+/// Per tab: the file the text is based on, and the bar shown for it.
+#[derive(Debug, Default)]
+pub struct DiskWatch {
+    base: Base,
+    pub bar: Option<Bar>,
+    /// The disk version the bar was shown for: Keep mine and Save accept this one only.
+    shown_for: Fingerprint,
+    /// Modification time, length and hash of the last read, to skip hashing an unchanged file.
+    stat: Option<(SystemTime, u64, u64)>,
+}
+
+impl DiskWatch {
+    /// Read the file's fingerprint; the file is hashed only when its time or length changed.
+    /// An unreadable file is an error, not a deleted one.
+    pub fn read(&mut self, path: &Path) -> io::Result<Fingerprint> {
+        let metadata = match fs::metadata(path) {
+            Ok(metadata) => metadata,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                self.stat = None;
+                return Ok(None);
+            }
+            Err(err) => return Err(err),
+        };
+        let modified = metadata.modified()?;
+        if let Some((cached_modified, len, hash)) = self.stat
+            && cached_modified == modified
+            && len == metadata.len()
+        {
+            return Ok(Some(hash));
+        }
+        let bytes = match fs::read(path) {
+            Ok(bytes) => bytes,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                self.stat = None;
+                return Ok(None);
+            }
+            Err(err) => return Err(err),
+        };
+        let hash = hash_bytes(&bytes);
+        self.stat = Some((modified, bytes.len() as u64, hash));
+        Ok(Some(hash))
+    }
+
+    /// The base, as the session keeps it with a draft.
+    pub fn base(&self) -> Base {
+        self.base
+    }
+
+    /// The tab took the file's text (open, reload).
+    pub fn loaded(&mut self, disk: Fingerprint) {
+        self.base = Base::of(disk);
+        self.bar = None;
+    }
+
+    /// The tab and the file at `path` hold `text`: after a reload or our own save.
+    pub fn took(&mut self, path: &Path, text: &str) {
+        let hash = hash_bytes(text.as_bytes());
+        self.loaded(Some(hash));
+        self.stat = fs::metadata(path)
+            .and_then(|metadata| Ok((metadata.modified()?, metadata.len(), hash)))
+            .ok()
+            .filter(|(_, len, _)| *len == text.len() as u64);
+    }
+
+    /// The tab writes to another file now (Save as): base it on what is there.
+    pub fn retarget(&mut self, path: &Path) {
+        self.stat = None;
+        match self.read(path) {
+            Ok(disk) => self.loaded(disk),
+            Err(err) => log::warn!("failed to read {:?}: {}", path, err),
+        }
+    }
+
+    fn show(&mut self, disk: Fingerprint) {
+        self.bar = Some(Bar::for_disk(disk));
+        self.shown_for = disk;
+    }
+
+    /// Keep the unsaved text over the disk version the bar was shown for; the bar comes back
+    /// when the file changes again, also when it changed again before the click.
+    pub fn keep_mine(&mut self) {
+        if self.bar.take().is_some() {
+            self.base = Base::of(self.shown_for);
+        }
+    }
+
+    /// A restored draft whose file changed on disk since the draft was written, by modification
+    /// time: a session from before the base was kept.
+    pub fn restored_over_change(&mut self, disk: Fingerprint) {
+        self.base = Base::Unknown;
+        self.show(disk);
+    }
+
+    /// A restored draft with the base the session kept for it.
+    pub fn restored(&mut self, base: Base, disk: Fingerprint) {
+        self.base = base;
+        self.check(true, disk);
+    }
+
+    /// Compare the file on disk with the base and show or hide the bar.
+    pub fn check(&mut self, dirty: bool, disk: Fingerprint) -> Action {
+        let action = decide(dirty, self.base, disk);
+        match action {
+            Action::ShowBar(_) => self.show(disk),
+            Action::Nothing | Action::SilentReload => self.bar = None,
+        }
+        action
+    }
+
+    /// Whether a save may write over the file on disk: when it is the base, or the version the
+    /// bar is shown for (saving answers the bar like Keep mine). Otherwise the bar shows first.
+    pub fn may_write(&mut self, disk: Fingerprint) -> bool {
+        if self.base == Base::of(disk) || (self.bar.is_some() && self.shown_for == disk) {
+            return true;
+        }
+        self.show(disk);
+        false
+    }
+}
+
+impl EditorTab {
+    fn disk_now(&mut self) -> Option<Fingerprint> {
+        let path = self.path_opt.as_ref()?;
+        self.disk
+            .read(path)
+            .inspect_err(|err| log::warn!("failed to read {:?}: {}", path, err))
+            .ok()
+    }
+
+    /// Session restore, for a session without the draft's base.
+    pub fn disk_restored_over_change(&mut self) {
+        if let Some(disk) = self.disk_now() {
+            self.disk.restored_over_change(disk);
+        }
+    }
+
+    /// Session restore: the draft is in, compare the file with the base the session kept.
+    pub fn disk_restored(&mut self, base: Option<Base>) {
+        if let Some(base) = base
+            && let Some(disk) = self.disk_now()
+        {
+            self.disk.restored(base, disk);
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    Reload(Entity),
+    KeepMine(Entity),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::DiskChange(message)
+    }
+}
+
+impl App {
+    /// Compare a tab's file with what the tab is based on: after a watcher event, when the tab
+    /// is activated.
+    pub fn disk_check(&mut self, entity: Entity) {
+        let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) else {
+            return;
+        };
+        let Some(path) = tab.path_opt.clone() else {
+            return;
+        };
+        let disk = match tab.disk.read(&path) {
+            Ok(disk) => disk,
+            Err(err) => {
+                log::warn!("failed to check {:?} for changes on disk: {}", path, err);
+                return;
+            }
+        };
+        match tab.disk.check(tab.changed(), disk) {
+            Action::SilentReload => {
+                tab.reload();
+                tab.markdown_refresh();
+            }
+            Action::ShowBar(bar) => {
+                log::warn!("{:?} {:?} on disk before being saved", path, bar);
+            }
+            Action::Nothing => {}
+        }
+    }
+
+    /// Watch a tab's file again after it was replaced on disk.
+    pub fn disk_rewatch(&mut self, path: &Path) {
+        let Some((watcher, paths)) = self.watcher_opt.as_mut() else {
+            return;
+        };
+        // Files in a project are covered by the project's watch
+        if !paths.contains(&(path.to_path_buf(), RecursiveMode::NonRecursive)) {
+            return;
+        }
+        let _ = watcher.unwatch(path);
+        if let Err(err) = watcher.watch(path, RecursiveMode::NonRecursive) {
+            log::debug!("failed to watch {:?} again: {}", path, err);
+        }
+    }
+
+    pub fn update_disk_change(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Reload(entity) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                    tab.reload();
+                    tab.markdown_refresh();
+                    return self.update(AppMessage::TabChanged(entity));
+                }
+            }
+            Message::KeepMine(entity) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                    tab.disk.keep_mine();
+                }
+            }
+        }
+        Task::none()
+    }
+
+    /// The bar above the editor of a tab whose file changed on disk.
+    pub fn disk_bar(&self, entity: Entity, tab: &EditorTab) -> Option<Element<'_, AppMessage>> {
+        let bar = tab.disk.bar?;
+        let spacing = self.core().system_theme().cosmic().spacing;
+        let name = tab.title();
+        let mut row = widget::row::with_capacity(4)
+            .align_y(Alignment::Center)
+            .spacing(spacing.space_xs);
+        row = match bar {
+            Bar::Changed => row
+                .push(widget::text::body(fl!("disk-changed", name = name)).width(Length::Fill))
+                .push(button::standard(fl!("disk-reload")).on_press(Message::Reload(entity).into()))
+                .push(
+                    button::standard(fl!("disk-compare"))
+                        .on_press(AppMessage::CompareWithSaved(Some(entity))),
+                ),
+            Bar::Deleted => {
+                row.push(widget::text::body(fl!("disk-deleted", name = name)).width(Length::Fill))
+            }
+        };
+        row = row.push(
+            button::suggested(fl!("disk-keep-mine")).on_press(Message::KeepMine(entity).into()),
+        );
+        Some(
+            widget::container(row)
+                .padding([spacing.space_xxs, spacing.space_s])
+                .width(Length::Fill)
+                .class(theme::Container::Card)
+                .into(),
+        )
+    }
+}

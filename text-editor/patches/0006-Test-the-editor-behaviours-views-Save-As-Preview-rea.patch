+    /// The file was saved as `path`: keep the current view, parse and resolve images again, as
+    /// relative images now resolve against another folder. `None` when `path` is not Markdown.
+    fn moved(preview: Option<Self>, path: &Path) -> Option<Self> {
+        if !is_markdown(path) {
+            return None;
+        }
+        let mut preview = preview.unwrap_or_else(|| Self::new(ViewMode::Source));
+        preview.parsed = None;
+        preview.images.clear();
+        Some(preview)
+    }
+
+    /// Parse `text` if it changed; images resolve against `base_dir`, the folder of the file.
+    fn parse(&mut self, text: &str, base_dir: Option<&Path>) {
+        let mut hasher = DefaultHasher::new();
+        text.hash(&mut hasher);
+        let hash = hasher.finish();
+        if self.parsed == Some(hash) {
+            return;
+        }
+        self.parsed = Some(hash);
+        self.parsed_len = text.len();
+        self.content = markdown::Content::parse(text);
+
+        let links = self.content.images();
+        // Missing images are looked up again, so one added later shows up
+        self.images
+            .retain(|uri, image| image.is_some() && links.contains(uri));
+        for uri in links {
+            self.images
+                .entry(uri.clone())
+                .or_insert_with(|| load_image(uri, base_dir));
+        }
+    }
+
+    /// Where to scroll the preview back to when it shows again, `None` while it is hidden.
+    fn scroll_target(&self) -> Option<(widget::Id, AbsoluteOffset)> {
+        self.mode
+            .shows_preview()
+            .then(|| (self.scroll_id.clone(), self.scroll_offset))
+    }
+
     fn reparse_delay(&self) -> Duration {
         if self.parsed_len > LARGE_FILE {
             REPARSE_DELAY_LARGE

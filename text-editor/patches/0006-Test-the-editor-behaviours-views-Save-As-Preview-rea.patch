 #[cfg(test)]
 mod tests {
+    // Behaviours covered:
+    // - Markdown is detected by file extension
+    // - a Markdown file opens in the configured view (Source, Preview or Split); other files get
+    //   no preview
+    // - an empty Markdown file opens in Source whatever the setting
+    // - Ctrl+Shift+V and Ctrl+Alt+V toggle between the views
+    // - Save As to a Markdown name keeps the tab's view; to another name drops the preview
+    // - a path change clears the parsed content and the image cache, so relative images resolve
+    //   against the new folder
+    // - Preview is read-only: it blocks Cut, Paste, Undo, Redo, SelectAll, FindReplace and
+    //   FindReplaceAll; Split and Source do not
+    // - each tab keeps its own preview scroll offset and restores it when shown again
+    // - Split re-parses after 150 ms, after 300 ms for documents over 100 KB
+    // - links resolve against the file's folder; a click never runs anything
+
     use super::*;
+    use std::time::Duration;
 
     #[test]
     fn detects_markdown_by_extension() {
@@ -1044,4 +1080,123 @@ mod tests {
         );

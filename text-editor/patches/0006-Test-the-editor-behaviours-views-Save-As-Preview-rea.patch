+        let notes = dir.join("notes.md");
+        let other = dir.join("other.md");
+        let tabs = [
+            ("untitled", None),
+            ("notes", Some(notes.as_path())),
+            ("other", Some(other.as_path())),
+        ];
+
+        // The second launch runs in another folder and names the file relative to it
+        for (cwd, arg) in [
+            (dir.clone(), "notes.md"),
+            (dir.join("sub"), "../notes.md"),
+            (dir.join("sub"), "./../sub/../notes.md"),
+        ] {
+            let args = absolute_args([arg.to_string()], &cwd);
+            // The editor canonicalizes a path before looking for its tab
+            let canonical = fs::canonicalize(&args[0]).unwrap();
+            assert_eq!(existing_tab(tabs, &canonical), Some("notes"), "{arg}");
+        }
+        assert_eq!(existing_tab(tabs, &dir.join("new.md")), None);
+        fs::remove_dir_all(dir).unwrap();

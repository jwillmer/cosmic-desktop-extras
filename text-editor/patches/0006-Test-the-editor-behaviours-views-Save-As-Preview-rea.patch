+
+    #[test]
+    fn markdown_file_opens_in_configured_view() {
+        for default in ViewMode::ALL {
+            for name in ["notes.md", "NOTES.MARKDOWN"] {
+                let path = Some(Path::new(name));
+                assert_eq!(opening_view(path, default, false), Some(default), "{name}");
+            }
+            assert_eq!(opening_view(Some(Path::new("a.txt")), default, false), None);
+            assert_eq!(opening_view(None, default, false), None);
+        }
+    }
+
+    #[test]
+    fn empty_markdown_file_opens_in_source_whatever_the_setting() {
+        for default in ViewMode::ALL {
+            assert_eq!(
+                opening_view(Some(Path::new("new.md")), default, true),
+                Some(ViewMode::Source)
+            );
+        }
+    }
+
+    #[test]
+    fn save_as_markdown_keeps_the_tab_view() {
+        for mode in ViewMode::ALL {
+            let moved = Preview::moved(Some(Preview::new(mode)), Path::new("/b/renamed.md"));
+            assert_eq!(moved.map(|p| p.mode), Some(mode));
+        }
+        // A plain text tab saved as Markdown starts in Source: its view does not jump
+        let moved = Preview::moved(None, Path::new("/b/notes.md"));
+        assert_eq!(moved.map(|p| p.mode), Some(ViewMode::Source));
+        // Saved under a name that is not Markdown: no preview any more
+        let moved = Preview::moved(Some(Preview::new(ViewMode::Split)), Path::new("/b/a.txt"));
+        assert!(moved.is_none());
+    }
+
+    #[test]
+    fn path_change_clears_images_and_parsed_content() {
+        let png = b"\x89PNG\r\n\x1a\n";
+        let old_dir = fixture("move-old", &[]);
+        let new_dir = fixture("move-new", &[("pic.png", png, false)]);
+        let text = "# Notes\n\n![a picture](pic.png)\n";
+        let image_found =
+            |preview: &Preview| matches!(preview.images.get("pic.png"), Some(Some(_)));
+
+        let mut preview = Preview::new(ViewMode::Preview);
+        preview.parse(text, Some(&old_dir));
+        assert!(preview.parsed.is_some());
+        assert!(preview.images.contains_key("pic.png") && !image_found(&preview));
+
+        // Same text elsewhere: without the reset, nothing is parsed or looked up again
+        preview.parse(text, Some(&new_dir));
+        assert!(!image_found(&preview));
+
+        let mut preview = Preview::moved(Some(preview), &new_dir.join("notes.md")).unwrap();
+        assert!(preview.parsed.is_none() && preview.images.is_empty());
+        preview.parse(text, Some(&new_dir));
+        assert!(image_found(&preview));
+
+        fs::remove_dir_all(old_dir).unwrap();
+        fs::remove_dir_all(new_dir).unwrap();
+    }
+
+    #[test]
+    fn preview_blocks_editing_messages() {
+        let editing = [
+            AppMessage::Cut,
+            AppMessage::Paste,
+            AppMessage::PasteValue("text".to_string()),
+            AppMessage::Undo,
+            AppMessage::Redo,
+            AppMessage::SelectAll,
+            AppMessage::Find(Some(false)),
+            AppMessage::Find(Some(true)),
+            AppMessage::FindReplace,
+            AppMessage::FindReplaceAll,
+        ];
+        for message in &editing {
+            assert!(blocks(Some(ViewMode::Preview), message), "{message:?}");
+            for view in [Some(ViewMode::Split), Some(ViewMode::Source), None] {
+                assert!(!blocks(view, message), "{view:?} {message:?}");
+            }
+        }
+        // Reading and closing still work in the preview
+        for message in [AppMessage::Copy, AppMessage::Find(None)] {
+            assert!(!blocks(Some(ViewMode::Preview), &message), "{message:?}");
+        }
+    }
+
+    #[test]
+    fn each_tab_restores_its_own_preview_scroll() {
+        let mut first = Preview::new(ViewMode::Preview);
+        let mut second = Preview::new(ViewMode::Split);
+        first.scroll_offset = AbsoluteOffset { x: 0.0, y: 1200.0 };
+        second.scroll_offset = AbsoluteOffset { x: 0.0, y: 40.0 };
+
+        let (first_id, first_offset) = first.scroll_target().unwrap();
+        let (second_id, second_offset) = second.scroll_target().unwrap();
+        assert_ne!(first_id, second_id);
+        assert_eq!(first_offset, AbsoluteOffset { x: 0.0, y: 1200.0 });
+        assert_eq!(second_offset, AbsoluteOffset { x: 0.0, y: 40.0 });
+
+        // Hidden in Source: nothing to restore, the offset is kept for later
+        first.mode = ViewMode::Source;
+        assert!(first.scroll_target().is_none());
+        first.mode = ViewMode::Preview;
+        assert_eq!(first.scroll_target().unwrap().1.y, 1200.0);
+    }
+
+    #[test]
+    fn split_reparse_waits_longer_for_large_documents() {
+        let mut preview = Preview::new(ViewMode::Split);
+        assert_eq!(preview.reparse_delay(), Duration::from_millis(150));
+        preview.parse(&"a".repeat(100_000), None);
+        assert_eq!(preview.reparse_delay(), Duration::from_millis(150));
+        preview.parse(&"a".repeat(100_001), None);
+        assert_eq!(preview.reparse_delay(), Duration::from_millis(300));
+    }
 }

+    #[test]
+    fn repeated_summary_added_in_another_section_keeps_the_open_state() {
+        let text = "# Install\n\n<details><summary>Example</summary>a</details>\n\n\
+                    # Usage\n\n<details><summary>Example</summary>b</details>\n";
+        let usage = details_keys(text)[1].clone();
+        assert_eq!(usage.heading, "Usage");
+        let mut preview = Preview::new(ViewMode::Preview);
+        preview.parse(text, None);
+        preview.toggle_details(usage.clone());
+        // Another "Example" in the section above
+        let added = text.replace(
+            "a</details>\n",
+            "a</details>\n\n<details><summary>Example</summary>c</details>\n",
+        );
+        preview.parse(&added, None);
+        let keys = details_keys(&added);
+        assert_eq!(keys.len(), 3);
+        assert_eq!(keys[2], usage);
+        assert!(preview.open_details.contains(&usage));
+        assert!(
+            !preview.open_details.contains(&keys[0]) && !preview.open_details.contains(&keys[1])
+        );
+    }

+/// Tint the unsaved changed text of each visible line with the theme warning colour at low alpha,
+/// behind the glyphs. A range over a wrapped line covers its part in each visual row.
+fn draw_change_tints(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    tints: &Tints,
+    theme: &cosmic::cosmic_theme::Theme,
+    line_height: f32,
+) {
+    let c = theme.warning_color();
+    let channel = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+    // Light enough to keep the text readable in light and dark themes
+    let color = cosmic_text::Color::rgba(channel(c.red), channel(c.green), channel(c.blue), 56);
+    editor.with_buffer(|buffer| {
+        for run in buffer.layout_runs() {
+            for range in tints.line(run.line_i) {
+                let start = Cursor::new(run.line_i, range.start);
+                let end = Cursor::new(run.line_i, range.end);
+                for (x, w) in run.highlight(start, end) {
+                    let left = x.floor();
+                    renderer.rectangle(
+                        left as i32,
+                        run.line_top as i32,
+                        (x + w - left).ceil() as u32,
+                        line_height as u32,
+                        color,
+                    );
+                }
+            }
+        }
+    });
+}

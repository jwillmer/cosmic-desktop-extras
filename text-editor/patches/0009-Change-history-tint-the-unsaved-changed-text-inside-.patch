+/// The unsaved inserted or changed text of each line of the current text, as byte ranges of the
+/// line. Only tinted lines are stored, in line order.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct Tints(Vec<(usize, Vec<Range<usize>>)>);
+
+impl Tints {
+    /// The ranges to tint in line `line`, in order and not overlapping.
+    pub fn line(&self, line: usize) -> &[Range<usize>] {
+        match self.0.binary_search_by_key(&line, |(i, _)| *i) {
+            Ok(i) => &self.0[i].1,
+            Err(_) => &[],
+        }
+    }
+}
+
 fn lines(text: &str) -> Vec<&str> {
     // Same count as the editor's buffer lines: "a\n" is two lines, the second empty
     text.split('\n').collect()
 }
 
+/// Splits a line into words (letters, digits and `_`), runs of whitespace and single other
+/// chars, as byte ranges: the units the inline diff compares.
+fn words(line: &str) -> Vec<Range<usize>> {
+    #[derive(PartialEq)]
+    enum Kind {
+        Word,
+        Space,
+        Other,
+    }
+    let kind = |c: char| {
+        if c.is_alphanumeric() || c == '_' {
+            Kind::Word
+        } else if c.is_whitespace() {
+            Kind::Space
+        } else {
+            Kind::Other
+        }
+    };
+    let mut words: Vec<Range<usize>> = Vec::new();
+    let mut last = None;
+    for (i, c) in line.char_indices() {
+        let k = kind(c);
+        let end = i + c.len_utf8();
+        match words.last_mut() {
+            Some(word) if k != Kind::Other && last.as_ref() == Some(&k) => word.end = end,
+            _ => words.push(i..end),
+        }
+        last = Some(k);
+    }
+    words
+}
+
+/// The byte ranges of `new` inserted or changed against `old`, by words; adjacent ranges are
+/// joined.
+fn inline_diff(old: &str, new: &str, deadline: Instant) -> Vec<Range<usize>> {
+    let old_words = words(old);
+    let new_words = words(new);
+    let old_strs: Vec<&str> = old_words.iter().map(|r| &old[r.clone()]).collect();
+    let new_strs: Vec<&str> = new_words.iter().map(|r| &new[r.clone()]).collect();
+    let mut ranges: Vec<Range<usize>> = Vec::new();
+    for op in capture_diff_slices_deadline(Algorithm::Myers, &old_strs, &new_strs, Some(deadline)) {
+        let (tag, _, new_range) = op.as_tag_tuple();
+        if !matches!(tag, DiffTag::Insert | DiffTag::Replace) || new_range.is_empty() {
+            continue;
+        }
+        let range = new_words[new_range.start].start..new_words[new_range.end - 1].end;
+        match ranges.last_mut() {
+            Some(last) if last.end == range.start => last.end = range.end,
+            _ => ranges.push(range),
+        }
+    }
+    ranges
+}
+
+/// Blocks of more lines than this pair their lines by position only.
+const PAIR_LIMIT: usize = 16;
+
+/// The changed text of each line of a replaced block `new_range`, against the old line it
+/// replaces. Blocks of the same length pair by position. Otherwise each new line, in order, takes
+/// the most similar old line after the one taken before (lines added or removed inside the
+/// block would shift the positions); a line nothing is similar to counts as new: tinted whole.
+fn pair_lines(
+    old: &[&str],
+    new: &[&str],
+    old_range: Range<usize>,
+    new_range: Range<usize>,
+    deadline: Instant,
+) -> Vec<(usize, Vec<Range<usize>>)> {
+    let whole = |text: &str| {
+        vec![Range {
+            start: 0,
+            end: text.len(),
+        }]
+    };
+    if old_range.len() == new_range.len()
+        || old_range.len() > PAIR_LIMIT
+        || new_range.len() > PAIR_LIMIT
+    {
+        return new_range
+            .enumerate()
+            .map(|(k, new_i)| {
+                let ranges = match old_range.clone().nth(k) {
+                    Some(old_i) => inline_diff(old[old_i], new[new_i], deadline),
+                    None => whole(new[new_i]),
+                };
+                (new_i, ranges)
+            })
+            .collect();
+    }
+    let mut next = old_range.start;
+    new_range
+        .map(|new_i| {
+            let text = new[new_i];
+            let unchanged = |ranges: &[Range<usize>]| {
+                text.len() - ranges.iter().map(|r| r.len()).sum::<usize>()
+            };
+            let best = (next..old_range.end)
+                .map(|old_i| (old_i, inline_diff(old[old_i], text, deadline)))
+                .max_by_key(|(old_i, ranges)| (unchanged(ranges), std::cmp::Reverse(*old_i)));
+            match best {
+                Some((old_i, ranges)) if unchanged(&ranges) > 0 => {
+                    next = old_i + 1;
+                    (new_i, ranges)
+                }
+                _ => (new_i, whole(text)),
+            }
+        })
+        .collect()
+}

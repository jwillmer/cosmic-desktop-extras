+/// The graphemes of the word at `grapheme` of `text`, by Unicode word boundaries as the
+/// editor's: a run of spaces or a punctuation mark counts as a word.
+pub fn word_at(text: &str, grapheme: usize) -> (usize, usize) {
+    let mut start = 0;
+    let mut last = (0, 0);
+    for word in text.split_word_bounds() {
+        let end = start + word.graphemes(true).count();
+        if grapheme < end {
+            return (start, end);
+        }
+        last = (start, end);
+        start = end;
+    }
+    // Past the end: the last word
+    last
+}

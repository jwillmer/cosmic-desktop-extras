+    #[test]
+    fn word_and_shift_clicks_select() {
+        use select::{Action, Spot};
+        let mut preview = Preview::new(ViewMode::Preview);
+        preview.parse("Tomatoes need sun\n\nWater weekly\n", None);
+        let copied = |preview: &Preview| preview.selected_text(test_settings(), "");
+        let spot = |leaf, grapheme| Spot { leaf, grapheme };
+        // A double click selects a word
+        preview.select(Action::PressRange(spot(0, 9), spot(0, 13), over(1.0)));
+        preview.select(Action::Release);
+        assert_eq!(copied(&preview).as_deref(), Some("need"));
+        // Shift+click extends it, into the next paragraph
+        preview.select(Action::Extend(spot(1, 5), over(2.0)));
+        preview.select(Action::Release);
+        assert_eq!(copied(&preview).as_deref(), Some("need sun\n\nWater"));
+        // Shift+click with nothing selected starts there
+        preview.select(Action::Clear);
+        preview.select(Action::Extend(spot(1, 0), over(3.0)));
+        assert_eq!(preview.selection.map(|s| s.anchor), Some(spot(1, 0)));
+    }
+
     fn test_settings() -> Settings {
         settings(14.0, Font::MONOSPACE)
     }

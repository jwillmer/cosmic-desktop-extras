+            end: at,
+            text: "[text](url)".to_string(),
+        }],
+        cursor: (line, at + 5),
+        anchor: Some((line, at + 1)),
+    })
+}
+
+/// Pasting `value` over a selection: a URL over text on one line makes a link
+/// `[selection](URL)`, with the cursor after it. `None` for a normal paste.
+pub fn paste_link(
+    lines: &[&str],
+    cursor: Pos,
+    anchor: Option<Pos>,
+    value: &str,
+) -> Option<Outcome> {
+    let url = value.trim();
+    let anchor = anchor.filter(|anchor| *anchor != cursor)?;
+    if !is_url(url) {
+        return None;
+    }
+    let (line, start, end) = selected_text(lines, cursor, anchor)?;
+    let selected = &lines[line][start..end];
+    if is_url(selected) {
+        return None;
+    }
+    let text = format!("[{selected}]({url})");
+    let after = start + text.len();
+    Some(Outcome {
+        changes: vec![Change {
+            line,
+            start,
+            end,
+            text,
+        }],
+        cursor: (line, after),
+        anchor: None,
+    })
+}
+
+/// The heading marker of a line, after its indentation, quote `>` and list markers: where it
+/// starts, where the text after it starts, and its level (0 for none).
+fn heading_marker(text: &str) -> (usize, usize, usize) {
+    let rest = after_list_marker(after_quotes(text));
+    let start = text.len() - rest.len();
+    let hashes = rest.len() - rest.trim_start_matches('#').len();
+    let after = &rest[hashes..];
+    if (1..=6).contains(&hashes) && (after.is_empty() || after.starts_with([' ', '\t'])) {
+        let end = text.len() - after.trim_start_matches([' ', '\t']).len();
+        (start, end, hashes)
+    } else {
+        (start, start, 0)
     }
-    editor.finish_change();
-    editor.set_redraw(true);
+}
+
+/// Whether a line is a task item (`- [ ] text`, also in a quote).
+fn is_task(text: &str) -> bool {
+    let rest = after_quotes(text);
+    let after = after_list_marker(rest);
+    after.len() < rest.len()
+        && ["[ ]", "[x]", "[X]"].iter().any(|task| {
+            after
+                .strip_prefix(task)
+                .is_some_and(|tail| tail.is_empty() || tail.starts_with([' ', '\t']))
+        })
+}
+
+/// Set heading `level` (1 to 6, 0 for plain text) on the line of the cursor, or each line of
+/// the selection outside code. When all of them already have that level, they become plain
+/// text. Quote and list markers stay in front; task items stay as they are. `None` when there is
+/// no line to change.
+pub fn heading(lines: &[&str], cursor: Pos, anchor: Option<Pos>, level: usize) -> Option<Outcome> {
+    let anchor = anchor.filter(|anchor| *anchor != cursor);
+    let (first, last) = match anchor {
+        Some(anchor) if anchor < cursor => (anchor, cursor),
+        Some(anchor) => (cursor, anchor),
+        None => (cursor, cursor),
+    };
+    // A selection that ends at the start of a line leaves that line alone
+    let last_line = if last.0 > first.0 && last.1 == 0 {
+        last.0 - 1
+    } else {
+        last.0
+    };
+    let markdown = text_lines(lines, last_line);
+    let text = |line: usize| lines.get(line).copied().unwrap_or_default();
+    let several = last_line > first.0;
+    let markers: Vec<(usize, (usize, usize, usize))> = (first.0..=last_line)
+        .filter(|line| {
+            // Blank lines between selected ones stay blank; a heading would end a task item
+            markdown[*line] && !(several && text(*line).trim().is_empty()) && !is_task(text(*line))
+        })
+        .map(|line| (line, heading_marker(text(line))))
+        .collect();
+    if markers.is_empty() {
+        return None;
+    }
+    let level = level.min(6);
+    let level = if markers.iter().all(|(_, (_, _, now))| *now == level) {
+        0
+    } else {
+        level
+    };
+    let marker = if level == 0 {
+        String::new()
+    } else {
+        format!("{} ", "#".repeat(level))
+    };
+    // Where a position ends up: after the new marker when it was in or after the old one
+    let moved = |(line, at): Pos| {
+        let changed = markers
+            .iter()
+            .find(|(l, (_, _, now))| *l == line && *now != level);
+        let Some((_, (start, end, _))) = changed else {
+            return (line, at);
+        };
+        if at >= *end {
+            (line, at - (end - start) + marker.len())
+        } else if at >= *start {
+            (line, start + marker.len())
+        } else {
+            (line, at)
+        }
+    };
+    let changes = markers
+        .iter()
+        .rev()
+        .filter(|(_, (_, _, now))| *now != level)
+        .map(|(line, (start, end, _))| Change {
+            line: *line,
+            start: *start,
+            end: *end,
+            text: marker.clone(),
+        })
+        .collect();
+    Some(Outcome {
+        changes,
+        cursor: moved(cursor),
+        anchor: anchor.map(moved),
+    })
+}
+
+/// Run `format` in `editor` at its cursor and selection, as one undo step.
+pub fn apply(editor: &mut ViEditor<'static, 'static>, format: Format) {
+    run(
+        editor,
+        LineEnding::Lf,
+        |lines, cursor, anchor| match format {
+            Format::Style(style) => toggle(lines, cursor, anchor, style),
+            Format::Link => link(lines, cursor, anchor),
+            Format::ToggleTask => crate::md_lists::toggle_task(lines, cursor, anchor),
+            Format::Heading(level) => heading(lines, cursor, anchor, level),
+        },
+    );
+}
+
+/// Paste `value` in `editor` as a link around the selection when it is a URL over text (see
+/// `paste_link`), as one undo step. Whether it did; otherwise paste as usual.
+pub fn paste(editor: &mut ViEditor<'static, 'static>, value: &str) -> bool {
+    if !is_url(value.trim()) || editor.selection_bounds().is_none() {
+        return false;
+    }
+    run(editor, LineEnding::Lf, |lines, cursor, anchor| {
+        paste_link(lines, cursor, anchor, value)
+    })
 }
 

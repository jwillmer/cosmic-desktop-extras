+            }
+            lines.push(plain);
+        }
+        let refs: Vec<&str> = lines.iter().map(String::as_str).collect();
+        let outcome = edit(&refs, cursor.unwrap(), anchor)?;
+        let mut joined = lines.clone();
+        for change in &outcome.changes {
+            joined[change.line].replace_range(change.start..change.end, &change.text);
+        }
+        let mut lines: Vec<String> = joined.join("\n").split('\n').map(str::to_string).collect();
+        let mut marks = vec![(outcome.cursor, '|')];
+        if let Some(anchor) = outcome.anchor {
+            marks.push((anchor, '^'));
+        }
+        marks.sort();
+        for ((line, index), mark) in marks.into_iter().rev() {
+            lines[line].insert(index, mark);
+        }
+        Some(lines.join("\n"))
+    }
+
+    fn enter_on(text: &str) -> String {
+        run_on(text, |lines, cursor, _| enter(lines, cursor)).unwrap_or_else(|| "plain".into())
+    }
+
+    fn tab_on(text: &str) -> String {
+        run_on(text, |lines, cursor, anchor| {
+            indent(lines, cursor, anchor, false)
+        })
+        .unwrap_or_else(|| "plain".into())
+    }
+
+    fn shift_tab_on(text: &str) -> String {
+        run_on(text, |lines, cursor, anchor| {
+            indent(lines, cursor, anchor, true)
+        })
+        .unwrap_or_else(|| "plain".into())
+    }
+
+    fn task_on(text: &str) -> String {
+        run_on(text, toggle_task).unwrap_or_else(|| "none".into())
+    }
+
+    #[test]
+    fn enter_continues_each_marker() {
+        assert_eq!(enter_on("- item|"), "- item\n- |");
+        assert_eq!(enter_on("* item|"), "* item\n* |");
+        assert_eq!(enter_on("+ item|"), "+ item\n+ |");
+        assert_eq!(enter_on("1. item|"), "1. item\n2. |");
+        assert_eq!(enter_on("9) item|"), "9) item\n10) |");
+        assert_eq!(enter_on("- [ ] task|"), "- [ ] task\n- [ ] |");
+        assert_eq!(enter_on("- [x] done|"), "- [x] done\n- [ ] |");
+        assert_eq!(enter_on("1. [X] done|"), "1. [X] done\n2. [ ] |");
+        assert_eq!(enter_on("> quote|"), "> quote\n> |");
+        assert_eq!(enter_on(">quote|"), ">quote\n> |");
+        // The space after the marker is kept as it is
+        assert_eq!(enter_on("-   wide|"), "-   wide\n-   |");
+    }
+
+    #[test]
+    fn enter_keeps_nesting_and_quotes() {
+        assert_eq!(enter_on("- a\n  - b|"), "- a\n  - b\n  - |");
+        assert_eq!(enter_on("> - item|"), "> - item\n> - |");
+        assert_eq!(enter_on("> > 1. item|"), "> > 1. item\n> > 2. |");
+        assert_eq!(enter_on("- a\n\t- tab|"), "- a\n\t- tab\n\t- |");
+        // Indented by a tab at the margin is code
+        assert_eq!(enter_on("\t- code|"), "plain");
+    }
+
+    #[test]
+    fn enter_moves_the_rest_into_the_new_item() {
+        assert_eq!(enter_on("- one |two"), "- one\n- |two");
+        // At the start of the text: the item moves down, an empty one stays above; a ticked
+        // task keeps its tick
+        assert_eq!(enter_on("- [x] |done"), "- [ ] \n- [x] |done");
+        assert_eq!(enter_on("- [x] do|ne"), "- [x] do\n- [ ] |ne");
+        assert_eq!(enter_on("- |item"), "- \n- |item");
+    }
+
+    #[test]
+    fn enter_in_front_of_the_text_is_plain() {
+        assert_eq!(enter_on("|- item"), "plain");
+        assert_eq!(enter_on("-| item"), "plain");
+        assert_eq!(enter_on("1|. item"), "plain");
+        assert_eq!(enter_on("- [ |] task"), "plain");
+        assert_eq!(enter_on("text|"), "plain");
+        assert_eq!(enter_on("# Heading|"), "plain");
+        assert_eq!(enter_on("---|"), "plain");
+        assert_eq!(enter_on("-item|"), "plain");
+    }
+
+    #[test]
+    fn enter_on_an_empty_item_ends_the_list() {
+        assert_eq!(enter_on("- a\n- |"), "- a\n|");
+        assert_eq!(enter_on("- a\n-|"), "- a\n|");
+        assert_eq!(enter_on("- [ ] a\n- [ ] |"), "- [ ] a\n|");
+        assert_eq!(enter_on("1. a\n2. |"), "1. a\n|");
+        assert_eq!(enter_on("> - a\n> - |"), "> - a\n> |");
+        // Quotes lose one level
+        assert_eq!(enter_on("> a\n> |"), "> a\n|");
+        assert_eq!(enter_on("> > a\n> > |"), "> > a\n> |");
+        // Nested: out one level first
+        assert_eq!(enter_on("- a\n  - b\n  - |"), "- a\n  - b\n- |");
+        assert_eq!(enter_on("1. a\n   1. b\n   2. |"), "1. a\n   1. b\n2. |");
+    }
+
+    #[test]
+    fn enter_on_a_number_in_a_paragraph_is_plain() {
+        assert_eq!(enter_on("We grew in\n2024. Then|"), "plain");
+        assert_eq!(enter_on("Steps:\n1. one|"), "Steps:\n1. one\n2. |");
+        assert_eq!(
+            enter_on("1. a\n   more\n2. b|"),
+            "1. a\n   more\n2. b\n3. |"
+        );
+    }
+
+    #[test]
+    fn enter_on_an_empty_item_mid_list_renumbers_the_rest() {
+        // A blank line does not end a list: the items below follow on from the one above
+        assert_eq!(enter_on("1. a\n2. |\n3. b\n4. c"), "1. a\n|\n2. b\n3. c");
+    }
+
+    #[test]
+    fn indent_keeps_tabs_in_code() {
+        assert_eq!(
+            tab_on("- a\n- b|\n  ```\n  \tcode\n  ```"),
+            "- a\n  - b|\n    ```\n    \tcode\n    ```"
+        );
+        assert_eq!(shift_tab_on("- a\n\t- b|"), "- a\n- b|");
+        // A tab after the marker: children start at the next tab stop
+        assert_eq!(tab_on("-\ta\n- b|"), "-\ta\n    - b|");
+    }
+
+    #[test]
+    fn enter_renumbers_the_items_below() {
+        assert_eq!(
+            enter_on("1. a|\n2. b\n   - child\n\n3. c\n- other"),
+            "1. a\n2. |\n3. b\n   - child\n\n4. c\n- other"
+        );
+        // Another delimiter or a lesser level ends the list
+        assert_eq!(enter_on("1. a|\n2) b"), "1. a\n2. |\n2) b");
+        assert_eq!(
+            enter_on("1. a\n   1. x|\n   2. y\n2. b"),
+            "1. a\n   1. x\n   2. |\n   3. y\n2. b"
+        );
+    }
+
+    #[test]
+    fn nothing_in_code_blocks() {
+        assert_eq!(enter_on("```\n- item|\n```"), "plain");
+        assert_eq!(enter_on("~~~md\n> q|"), "plain");
+        assert_eq!(tab_on("```\n- a\n- b|\n```"), "plain");
+        assert_eq!(task_on("```\n- [ ] a|\n```"), "none");
+        // After the fence closes it works again
+        assert_eq!(enter_on("```\n```\n- a|"), "```\n```\n- a\n- |");
+    }
+
+    #[test]
+    fn unicode_text() {
+        assert_eq!(enter_on("- Grüße 🎉|"), "- Grüße 🎉\n- |");
+        assert_eq!(enter_on("- Grü|ße"), "- Grü\n- |ße");
+        assert_eq!(tab_on("- ä\n- ö|ü"), "- ä\n  - ö|ü");
+        assert_eq!(task_on("- [ ] 日本|語"), "- [x] 日本|語");
+    }
+
+    #[test]
+    fn tab_nests_under_the_item_above() {
+        assert_eq!(tab_on("- a\n- b|"), "- a\n  - b|");
+        assert_eq!(tab_on("- a\n- |b"), "- a\n  - |b");
+        assert_eq!(tab_on("1. a\n2. b|"), "1. a\n   1. b|");
+        assert_eq!(tab_on("10. a\n11. b|"), "10. a\n    1. b|");
+        assert_eq!(tab_on("> - a\n> - b|"), "> - a\n>   - b|");
+        // Under a nested item: to its text
+        assert_eq!(tab_on("- a\n  - b\n- c|"), "- a\n  - b\n  - c|");
+        assert_eq!(tab_on("- a\n  - b\n  - c|"), "- a\n  - b\n    - c|");
+        // The first item has nothing to nest under: the key is used, nothing changes
+        assert_eq!(tab_on("text\n\n- a|"), "text\n\n- a|");
+        // Not a list item: plain Tab
+        assert_eq!(tab_on("text|"), "plain");
+    }
+
+    #[test]
+    fn tab_moves_children_along() {
+        assert_eq!(
+            tab_on("- a\n- b|\n  - c\n\n    more\n- d"),
+            "- a\n  - b|\n    - c\n\n      more\n- d"
+        );
+    }
+
+    #[test]
+    fn child_code_blocks_stay_with_their_item() {
+        // A `>` line in a child code block is code, not a quote that ends the item
+        assert_eq!(
+            tab_on("- a\n- b|\n  ```\n  > x\n  ```\n  more\n- c"),
+            "- a\n  - b|\n    ```\n    > x\n    ```\n    more\n- c"
+        );
+        assert_eq!(
+            enter_on("1. a|\n   ```\n   > x\n   ```\n2. b"),
+            "1. a\n2. |\n   ```\n   > x\n   ```\n3. b"
+        );
+        // An item after a child code block nests under the item before it
+        assert_eq!(
+            tab_on("- a\n  ```\n- x\n  ```\n- b|"),
+            "- a\n  ```\n- x\n  ```\n  - b|"
+        );
+    }
+
+    #[test]
+    fn shift_tab_moves_out_to_the_parent() {
+        assert_eq!(shift_tab_on("- a\n  - b|"), "- a\n- b|");
+        assert_eq!(shift_tab_on("- a\n  - |b\n    - c"), "- a\n- |b\n  - c");
+        assert_eq!(shift_tab_on("> - a\n>   - b|"), "> - a\n> - b|");
+        // Indented without a parent: to the margin
+        assert_eq!(shift_tab_on("  - a|"), "- a|");
+        assert_eq!(shift_tab_on("- a|"), "- a|");
+    }
+
+    #[test]
+    fn tab_on_a_selection() {
+        assert_eq!(tab_on("- a\n- ^b\n- c|\n- d"), "- a\n  - ^b\n  - c|\n- d");
+        // Mixed levels keep their places relative to each other
+        assert_eq!(
+            shift_tab_on("- a\n  - ^b\n    - c\n  - d|"),
+            "- a\n- ^b\n  - c\n- d|"
+        );
+        // A selection that ends at the start of a line leaves it alone
+        assert_eq!(tab_on("- a\n^- b\n|- c"), "- a\n  ^- b\n|- c");
+        // Text among the items: plain Tab
+        assert_eq!(tab_on("- a\n^- b\ntext|"), "plain");
+    }
+
+    #[test]
+    fn indent_renumbers_both_levels() {
+        assert_eq!(tab_on("1. a\n2. b|\n3. c"), "1. a\n   1. b|\n2. c");
+        assert_eq!(
+            tab_on("1. a\n   1. x\n2. b|\n3. c"),
+            "1. a\n   1. x\n   2. b|\n2. c"
+        );
+        assert_eq!(
+            shift_tab_on("1. a\n   1. x|\n   2. y\n2. b"),
+            "1. a\n2. x|\n   1. y\n3. b"
+        );
+    }
+
+    #[test]
+    fn task_toggles() {
+        assert_eq!(task_on("- [ ] a|"), "- [x] a|");
+        assert_eq!(task_on("- [x] a|"), "- [ ] a|");
+        assert_eq!(task_on("- [X] a|"), "- [ ] a|");
+        assert_eq!(task_on("> 1. [ ] a|"), "> 1. [x] a|");
+        // A list item or plain line becomes a task
+        assert_eq!(task_on("- a|"), "- [ ] a|");
+        assert_eq!(task_on("1. |a"), "1. [ ] |a");
+        assert_eq!(task_on("-|"), "- [ ] |");
+        assert_eq!(task_on("  text|"), "  - [ ] text|");
+        assert_eq!(task_on("> text|"), "> - [ ] text|");
+        assert_eq!(task_on("|"), "- [ ] |");
+        // Headings and table rows stay
+        assert_eq!(task_on("# Title|"), "none");
+        assert!(keeps_without_task("| a | b |"));
+        assert_eq!(task_on("Title|\n====="), "none");
+        assert_eq!(task_on("Title|\n---"), "none");
+        assert_eq!(task_on("=====|"), "none");
+        assert!(keeps_without_task("[x]: https://example.com"));
+    }
+
+    #[test]
+    fn task_toggles_a_selection() {
+        // Some open: all ticked; other lines stay
+        assert_eq!(
+            task_on("^- [ ] a\n- [x] b\n- c|"),
+            "^- [x] a\n- [x] b\n- c|"
+        );
+        // All ticked: all open
+        assert_eq!(task_on("^- [x] a\n- [x] b|"), "^- [ ] a\n- [ ] b|");
+        // No tasks: items become tasks, blank lines stay blank
+        assert_eq!(task_on("^- a\n\n- b|"), "^- [ ] a\n\n- [ ] b|");
+    }
+
+    mod editor {
+        use super::super::*;
+        use crate::tab::editor_text;
+        use cosmic_text::{
+            Attrs, Buffer, Cursor, Metrics, Selection, Shaping, SyntaxEditor, SyntaxSystem,
+            ViEditor,
+        };
+        use std::sync::Arc;
+
+        fn editor(text: &str) -> ViEditor<'static, 'static> {
+            let system = crate::SYNTAX_SYSTEM.get_or_init(SyntaxSystem::new);
+            let mut buffer = Buffer::new_empty(Metrics::new(14.0, 20.0));
+            buffer.set_text(text, &Attrs::new(), Shaping::Advanced, None);
+            let theme = system.theme_set.themes.keys().next().unwrap();
+            ViEditor::new(SyntaxEditor::new(Arc::new(buffer), system, theme).unwrap())
+        }
+
+        #[test]
+        fn crlf_enter_is_one_undo_step() {
+            let text = "1. a\r\n2. b\r\n";
+            let mut editor = editor(text);
+            editor.set_cursor(Cursor::new(0, 4));
+            assert!(enter_key(&mut editor, LineEnding::CrLf));
+            assert_eq!(editor_text(&editor), "1. a\r\n2. \r\n3. b\r\n");
+            assert_eq!(editor.cursor(), Cursor::new(1, 3));
+            editor.undo();
+            assert_eq!(editor_text(&editor), text);
+        }
+
+        #[test]
+        fn crlf_tab_and_task_keep_line_endings() {
+            let mut editor = editor("- a\r\n- b\r\n");
+            editor.set_cursor(Cursor::new(1, 3));
+            assert!(tab_key(&mut editor, false));
+            assert_eq!(editor_text(&editor), "- a\r\n  - b\r\n");
+            crate::md_format::apply(&mut editor, crate::md_format::Format::ToggleTask);
+            assert_eq!(editor_text(&editor), "- a\r\n  - [ ] b\r\n");
+            assert_eq!(editor.cursor(), Cursor::new(1, 9));
+            editor.undo();
+            assert_eq!(editor_text(&editor), "- a\r\n  - b\r\n");
+        }
+
+        #[test]
+        fn enter_with_a_selection_is_plain() {
+            let mut editor = editor("- a");
+            editor.set_cursor(Cursor::new(0, 3));
+            editor.set_selection(Selection::Normal(Cursor::new(0, 2)));
+            assert!(!enter_key(&mut editor, LineEnding::Lf));
+        }
+    }
+}

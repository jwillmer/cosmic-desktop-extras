+/// The length of the fences of a code span written `` `` text `` `` around `start..end` of
+/// `text`: a space, then equally long runs of backticks, on both sides.
+fn padded_fence(text: &str, start: usize, end: usize) -> Option<usize> {
+    let before = text[..start].strip_suffix(' ')?;
+    let after = text[end..].strip_prefix(' ')?;
+    let left = before.len() - before.trim_end_matches('`').len();
+    let right = after.len() - after.trim_start_matches('`').len();
+    let open = before.len() - left;
+    // The fences are the two ends of one code span
+    (left > 0 && left == right)
+        .then(|| code_spans(text))
+        .and_then(|spans| {
+            spans
+                .into_iter()
+                .find(|span| *span == (open, left, end + 1))
+        })
+        .map(|_| left)

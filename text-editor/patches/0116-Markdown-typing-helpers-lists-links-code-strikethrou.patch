+/// The URL part (without a title) of the link `[text](url)` around byte `at` of `text`.
+fn link_url_at(text: &str, at: usize) -> Option<(usize, usize)> {
+    text.match_indices("](").find_map(|(middle, _)| {
+        let open = text[..middle].rfind('[')?;
+        // A URL may hold balanced parentheses: `Foo_(bar)`
+        let mut depth = 0usize;
+        let close = middle
+            + 2
+            + text[middle + 2..].find(|c| match c {
+                '(' => {
+                    depth += 1;
+                    false
+                }
+                ')' if depth > 0 => {
+                    depth -= 1;
+                    false
+                }
+                ')' => true,
+                _ => false,
+            })?;
+        let url = &text[middle + 2..close];
+        let url_end = middle + 2 + url.find(' ').unwrap_or(url.len());
+        (open <= at && at <= close + 1).then_some((middle + 2, url_end))
+    })

 }
 
+/// Remembers the text of the last copy or cut when it came from a column block, so pasting
+/// that text again (and not something copied elsewhere since) pastes it as a block.
+#[derive(Debug, Default)]
+pub struct BlockClipboard(Option<String>);
+
+impl BlockClipboard {
+    /// A copy or cut put `text` on the clipboard, from a column block or not
+    pub fn copied(&mut self, text: &str, from_block: bool) {
+        self.0 = from_block.then(|| text.to_string());
+    }
+
+    /// Whether `text` read from the clipboard is the last column block copied
+    pub fn is_block(&self, text: &str) -> bool {
+        self.0
+            .as_deref()
+            .is_some_and(|copied| copied == text.replace("\r\n", "\n"))
+    }
+}
+
+/// Paste `text` copied from a column block as a block at the cursor, as Notepad++ does, as
+/// one undo step: row `i` goes in at the cursor's visual column on the `i`th line from the
+/// cursor down. A line ending left of that column is padded with spaces, and rows past the end
+/// of the file go on new lines. A selection is replaced first.
+pub fn paste_block<'buffer, E: Edit<'buffer>>(editor: &mut E, text: &str) {
+    let text = text.replace("\r\n", "\n");
+    let rows: Vec<&str> = text.split('\n').collect();
+    let tab_width = editor.tab_width() as usize;
+    // A selection reaching into a fold is unfolded before it is replaced
+    crate::folding::reveal_selection(editor);
+    editor.start_change();
+    editor.delete_selection();
+    let cursor = editor.cursor();
+    let col = editor
+        .with_buffer(|buffer| col_of(buffer.lines[cursor.line].text(), cursor.index, tab_width));
+    // Never edit hidden text: the rows go to lines that may be folded
+    editor.with_buffer_mut(|buffer| {
+        crate::folding::unfold_lines(buffer, cursor.line, cursor.line + rows.len() - 1)
+    });
+    let mut end = cursor;
+    // Top down: each row edits one line, or appends one at the end of the file
+    for (i, row) in rows.iter().enumerate() {
+        let line = cursor.line + i;
+        let (line_count, line_text) = editor.with_buffer(|buffer| {
+            let text = buffer.lines.get(line).map(|l| l.text().to_string());
+            (buffer.lines.len(), text)
+        });
+        end = match line_text {
+            Some(line_text) => {
+                let line_width = width(&line_text, tab_width);
+                let (at, insert) = if line_width < col {
+                    (
+                        line_text.len(),
+                        format!("{}{row}", " ".repeat(col - line_width)),
+                    )
+                } else {
+                    (index_at(&line_text, col, tab_width), row.to_string())
+                };
+                editor.insert_at(Cursor::new(line, at), &insert, None)
+            }
+            None => {
+                let last = line_count - 1;
+                let at = editor.with_buffer(|buffer| buffer.lines[last].text().len());
+                let insert = format!("\n{}{row}", " ".repeat(col));
+                editor.insert_at(Cursor::new(last, at), &insert, None)
+            }
+        };
+    }
+    editor.finish_change();
+    editor.set_cursor(end);
+    editor.set_redraw(true);
+}
+
 /// Behaviours under test:
 /// - a block from two points covers the same visual columns on every line between them
 /// - short lines are skipped, a tab counts as reaching the next tab stop
@@ -429,6 +501,55 @@ pub(crate) mod tests {
         assert_eq!(b, Some(block((0, 5), (1, 5))));
     }
 
+    #[test]
+    fn column_copy_pastes_as_block_at_cursor() {
+        let mut editor = editor("abcdef\nghijkl\nmnopqr\n\nstu\nvwx\nyz\n");
+        let copied = copy(&editor, &block((0, 0), (2, 3)));
+        assert_eq!(copied, "abc\nghi\nmno");
+        let mut clipboard = BlockClipboard::default();
+        clipboard.copied(&copied, true);
+        assert!(clipboard.is_block(&copied));
+        // Each row goes in at the cursor's column on the lines below, no line is split
+        editor.set_cursor(Cursor::new(4, 1));
+        paste_block(&mut editor, &copied);
+        assert_eq!(
+            editor_text(&editor),
+            "abcdef\nghijkl\nmnopqr\n\nsabctu\nvghiwx\nymnoz\n"
+        );
+        assert_eq!(editor.cursor(), Cursor::new(6, 4));
+        // One undo step
+        editor.undo();
+        assert_eq!(
+            editor_text(&editor),
+            "abcdef\nghijkl\nmnopqr\n\nstu\nvwx\nyz\n"
+        );
+    }
+
+    #[test]
+    fn block_paste_pads_short_lines() {
+        let mut editor = editor("abcd\nx\nabcd");
+        editor.set_cursor(Cursor::new(0, 3));
+        paste_block(&mut editor, "1\n2\n3\n4");
+        // A short line is padded to the column, rows past the end of the file get new lines
+        assert_eq!(editor_text(&editor), "abc1d\nx  2\nabc3d\n   4");
+        assert_eq!(editor.cursor(), Cursor::new(3, 4));
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abcd\nx\nabcd");
+    }
+
+    #[test]
+    fn normal_copy_still_pastes_normally() {
+        let mut clipboard = BlockClipboard::default();
+        clipboard.copied("abc\nghi", true);
+        // The clipboard may hand it back with CRLF: still the block
+        assert!(clipboard.is_block("abc\r\nghi"));
+        // Something else on the clipboard since: not a block
+        assert!(!clipboard.is_block("other"));
+        // The same text copied as a normal selection: not a block either
+        clipboard.copied("abc\nghi", false);
+        assert!(!clipboard.is_block("abc\nghi"));
+    }
+

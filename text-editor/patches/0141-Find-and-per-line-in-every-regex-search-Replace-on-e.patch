+    /// A tab holding `text`, its cursor at the start
+    fn tab_with(text: &str) -> super::EditorTab {
+        let tab = super::EditorTab::new(&crate::Config::default());
+        let mut editor = tab.editor.lock().unwrap();
+        editor.insert_string(text, None);
+        editor.set_cursor(cosmic_text::Cursor::new(0, 0));
+        drop(editor);
+        tab
+    }
+
+    /// The tab's text with each line's own ending
+    fn text_of(tab: &super::EditorTab) -> String {
+        tab.editor.lock().unwrap().with_buffer(|buffer| {
+            buffer
+                .lines
+                .iter()
+                .map(|line| format!("{}{}", line.text(), line.ending().as_str()))
+                .collect()
+        })
+    }
+
+    /// The find bar's regex for `pattern` in regex mode, and how it is searched (as
+    /// `App::find_joined` gives it)
+    fn regex_query(pattern: &str) -> (regex::Regex, Option<bool>) {
+        let config = crate::Config {
+            find_use_regex: true,
+            ..crate::Config::default()
+        };
+        let joined = crate::find_text::spans_lines(pattern, true, false, false)
+            .then(|| crate::find_text::needs_real_endings(pattern, true));
+        (config.find_regex(pattern).unwrap(), joined)
+    }
+
+    /// Replace all of `pattern` with `replace` in `text`, as the find bar runs it
+    fn replace_all(text: &str, pattern: &str, replace: &str) -> (usize, String) {
+        let tab = tab_with(text);
+        let (regex, joined) = regex_query(pattern);
+        let replacement = crate::find_text::Replacement::new(replace, true, false);
+        let (count, _) = match joined {
+            Some(real_endings) => tab.replace_all_joined(&regex, real_endings, &replacement, None),
+            None => tab.replace_all(&regex, &replacement, None),
+        };
+        (count, text_of(&tab))
+    }
+
+    #[test]
+    fn replace_all_anchors_each_line() {
+        // `^\s+` strips every line's indent; blank lines stay
+        assert_eq!(
+            replace_all("  a\n\n\tb\n  c", r"^\s+", ""),
+            (3, "a\n\nb\nc".to_string())
+        );
+        // `\s+$` trims every line's end and does not eat the blank lines after it
+        assert_eq!(
+            replace_all("a  \n\nb\t\n\nc ", r"\s+$", ""),
+            (3, "a\n\nb\n\nc".to_string())
+        );
+        // In the joined lines too: `^` and `$` are each line's start and end
+        assert_eq!(
+            replace_all("a\n\n  \nb", r"^\s*\n", ""),
+            (1, "a\nb".to_string())
+        );
+        assert_eq!(
+            replace_all("a\r\n\r\nb", r"^\r\n", ""),
+            (1, "a\r\nb".to_string())
+        );
+    }
+
+    #[test]
+    fn replace_all_in_range_sees_whole_lines() {
+        // A range that starts mid-line: `^` does not match at the range's start
+        let tab = tab_with("xa\na");
+        let (regex, joined) = regex_query("^a");
+        assert_eq!(joined, None);
+        let replacement = crate::find_text::Replacement::new("b", true, false);
+        let (count, _) = tab.replace_all(&regex, &replacement, Some(((0, 1), (1, 1))));
+        assert_eq!((count, text_of(&tab)), (1, "xa\nb".to_string()));
+    }
+
+    #[test]
+    fn replace_inserts_at_empty_matches() {
+        for (pattern, replace, once, twice) in [
+            ("^", "> ", "> a\nb\n", "> a\n> b\n"),
+            ("$", ";", "a;\nb\n", "a;\nb;\n"),
+        ] {
+            let tab = tab_with("a\nb\n");
+            let (regex, joined) = regex_query(pattern);
+            assert_eq!(joined, None);
+            let replacement = crate::find_text::Replacement::new(replace, true, false);
+            assert!(tab.replace(&regex, &replacement, false));
+            assert_eq!(text_of(&tab), once, "{pattern}: no line break is deleted");
+            assert!(tab.replace(&regex, &replacement, false));
+            assert_eq!(text_of(&tab), twice, "{pattern}: the next Replace moves on");
+        }
+        // The same in the joined lines and inside a range
+        let tab = tab_with("a\nb\n");
+        let (regex, _) = regex_query(r"$(?:\n)?");
+        let replacement = crate::find_text::Replacement::new(";", true, false);
+        assert!(tab.replace_joined(&regex, false, &replacement, false));
+        assert_eq!(text_of(&tab), "a;b\n");
+        let tab = tab_with("a\nb\n");
+        let (regex, _) = regex_query("^");
+        let replacement = crate::find_text::Replacement::new("> ", true, false);
+        let range = ((0, 0), (1, 1));
+        assert!(
+            tab.replace_in_range(&regex, None, &replacement, range, false)
+                .is_some()
+        );
+        assert!(
+            tab.replace_in_range(&regex, None, &replacement, range, false)
+                .is_some()
+        );
+        assert_eq!(text_of(&tab), "> a\n> b\n");
+    }
+
+    #[test]
+    fn replace_edits_crlf_line_endings() {
+        // `\r\n` → `\n` turns CRLF lines into LF ones, not back into CRLF
+        assert_eq!(
+            replace_all("a\r\nb\r\nc", r"\r\n", r"\n"),
+            (2, "a\nb\nc".to_string())
+        );
+        // `\r` → "": the `\n` stays
+        assert_eq!(
+            replace_all("a\r\nb\r\nc", r"\r", ""),
+            (2, "a\nb\nc".to_string())
+        );
+        // `\r|\n` → "" joins the lines
+        assert_eq!(
+            replace_all("a\r\nb\r\nc", r"\r|\n", ""),
+            (2, "abc".to_string())
+        );
+        // Replace takes one; the cursor ends after it
+        let tab = tab_with("a\r\nb\r\nc");
+        let (regex, joined) = regex_query(r"\r\n");
+        assert_eq!(joined, Some(true));
+        let replacement = crate::find_text::Replacement::new(r"\n", true, false);
+        assert!(tab.replace_joined(&regex, true, &replacement, false));
+        assert_eq!(text_of(&tab), "a\nb\r\nc");
+        assert!(tab.replace_joined(&regex, true, &replacement, false));
+        assert_eq!(text_of(&tab), "a\nb\nc");
+        assert!(!tab.replace_joined(&regex, true, &replacement, false));
+        // Replace all leaves the cursor after the last replacement
+        let tab = tab_with("a\r\nb\r\nc");
+        let replacement = crate::find_text::Replacement::new("-", true, false);
+        tab.replace_all_joined(&regex, true, &replacement, None);
+        assert_eq!(text_of(&tab), "a-b-c");
+        assert_eq!(
+            tab.editor.lock().unwrap().cursor(),
+            cosmic_text::Cursor::new(0, 4)
+        );
+    }

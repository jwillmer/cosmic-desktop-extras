+++ b/src/markdown_html.rs
@@ -973,6 +973,30 @@ fn alert_color(kind: BlockQuoteKind, theme: &theme::Theme) -> Color {
     })
 }
 
+/// Add the keys of every `<details>` in `blocks`, nested ones too, to `keys`.
+pub fn details_keys<'a>(blocks: &'a [Block], keys: &mut HashSet<&'a DetailsKey>) {
+    for block in blocks {
+        match block {
+            Block::Details { key, body, .. } => {
+                keys.insert(key);
+                details_keys(body, keys);
+            }
+            Block::Center(body) | Block::Alert(_, body) => details_keys(body, keys),
+            Block::Footnotes(notes) => {
+                for (_, body) in notes {
+                    details_keys(body, keys);
+                }
+            }
+            Block::List { items, .. } => {
+                for item in items {
+                    details_keys(&item.blocks, keys);
+                }
+            }
+            Block::Markdown(_) | Block::Inline { .. } | Block::Table { .. } => {}
+        }
+    }
+}

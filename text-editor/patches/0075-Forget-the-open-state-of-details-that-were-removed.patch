From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Fri, 13 Nov 2026 12:01:25 +0100
Subject: [PATCH 075/110] Forget the open state of <details> that were removed

With <details> kept by summary, a removed open one left its key behind
and a later <details> with the same summary showed open without a
click. After each parse the open set keeps only keys still in the
document.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/markdown.rs b/src/markdown.rs
index 15ad1bf..6d53137 100644
--- a/src/markdown.rs
+++ b/src/markdown.rs
@@ -439,6 +439,10 @@ impl Preview {
         self.parsed = Some(hash);
         self.parsed_len = text.len();
         self.document = html::parse(text);
+        // Forget opened <details> that are gone, so a new one with that summary starts closed
+        let mut keys = HashSet::new();
+        html::details_keys(&self.document.blocks, &mut keys);
+        self.open_details.retain(|key| keys.contains(key));
         self.layout = map::Layout::new(text);
         self.heights = self.layout.heights(self.columns);
         self.highlights.sweep();

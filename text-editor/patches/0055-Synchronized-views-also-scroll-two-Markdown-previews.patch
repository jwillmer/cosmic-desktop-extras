@@ -1314,6 +1363,24 @@ mod tests {
     use super::*;
     use std::time::Duration;
 
+    #[test]
+    fn synchronized_previews_follow_by_fraction() {
+        let mut preview = Preview::new(ViewMode::Preview);
+        preview.content_height = 1000.0;
+        preview.viewport_height = 200.0;
+        preview.scroll_offset = AbsoluteOffset { x: 0.0, y: 400.0 };
+        assert_eq!(preview.scroll_fraction(), Some(0.5));
+        // The other preview goes to the same fraction...
+        assert_eq!(follow_fraction(Some(0.5), Some(0.1)), Some(0.5));
+        // ...and its own scroll event, already there, does not echo back
+        assert_eq!(follow_fraction(Some(0.5), Some(0.5)), None);
+        // Content that fits has nothing to follow or to scroll
+        preview.content_height = 150.0;
+        assert_eq!(preview.scroll_fraction(), None);
+        assert_eq!(follow_fraction(None, Some(0.3)), None);
+        assert_eq!(follow_fraction(Some(0.3), None), None);
+    }

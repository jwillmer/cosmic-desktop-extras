+    /// How far down the preview is scrolled, from 0 to 1; `None` when it shows all content.
+    fn scroll_fraction(&self) -> Option<f32> {
+        let max = self.content_height - self.viewport_height;
+        (max > 0.0).then(|| (self.scroll_offset.y / max).clamp(0.0, 1.0))
+    }

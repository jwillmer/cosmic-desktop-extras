 impl App {
+    /// With synchronized views and a Markdown preview in both, the other view's preview follows
+    /// this one by the same fraction of its height.
+    fn follow_preview_scroll(&self, entity: Entity) -> Task<AppMessage> {
+        if !self.config.sync_scroll_views {
+            return Task::none();
+        }
+        let Some(split) = &self.split else {
+            return Task::none();
+        };
+        let Some(side) = split
+            .side_of(entity)
+            .filter(|side| split.shown(*side) == Some(entity))
+        else {
+            return Task::none();
+        };
+        let preview = |tab: Entity| match self.tab_model.data::<Tab>(tab) {
+            Some(Tab::Editor(tab)) => tab
+                .markdown
+                .as_ref()
+                .filter(|preview| preview.mode == ViewMode::Preview),
+            _ => None,
+        };
+        let (Some(this), Some(other)) =
+            (preview(entity), split.shown(side.other()).and_then(preview))
+        else {
+            return Task::none();
+        };
+        match follow_fraction(this.scroll_fraction(), other.scroll_fraction()) {
+            Some(y) => iced::widget::operation::snap_to(
+                other.scroll_id.clone(),
+                RelativeOffset { x: 0.0, y },
+            ),
+            None => Task::none(),
+        }
+    }
     fn active_editor_tab_mut(&mut self) -> Option<&mut EditorTab> {
         match self.active_tab_mut() {
             Some(Tab::Editor(tab)) => Some(tab),
@@ -734,6 +782,7 @@ impl App {

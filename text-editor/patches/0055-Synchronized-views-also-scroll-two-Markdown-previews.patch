+/// Where the other preview scrolls to follow one at `this`, as a fraction; `None` when it
+/// already is there (so its own scroll event does not echo back) or either has nothing to scroll.
+fn follow_fraction(this: Option<f32>, other: Option<f32>) -> Option<f32> {
+    let (this, other) = (this?, other?);
+    ((this - other).abs() > 0.001).then_some(this)
+}

+    /// The selection after a find bar action: start and end, as (line, index)
+    fn selected(tab: &super::EditorTab) -> ((usize, usize), (usize, usize)) {
+        let editor = tab.editor.lock().unwrap();
+        let cursor = editor.cursor();
+        let (start, end) = editor.selection_bounds().unwrap_or((cursor, cursor));
+        ((start.line, start.index), (end.line, end.index))
+    }

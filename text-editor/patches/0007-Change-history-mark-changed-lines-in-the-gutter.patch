diff --git a/src/change_history.rs b/src/change_history.rs
new file mode 100644
index 0000000..cd12f1d
--- /dev/null
+++ b/src/change_history.rs
@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Change history: a thin bar in the gutter marks the lines changed since the file was opened,
+//! like Notepad++. Orange: changed and not saved yet. Green: changed and saved in this session.
+//!
+//! Marks come from line diffs, not from tracking edits, so undoing back to the saved text clears
+//! them: `base` is the text when the tab was opened (or reloaded from disk), `saved` the text at
+//! the last save, `current` the buffer. The diff runs off the UI thread, a short pause after the
+//! last edit, and only for the visible tab.
+
+use cosmic::{
+    action,
+    app::Task,
+    iced::{Subscription, advanced::input_method, event, keyboard, mouse},
+    widget::{self, segmented_button::Entity},
+};
+use cosmic_text::Edit;
+use similar::{Algorithm, DiffTag, capture_diff_slices_deadline};
+use std::{
+    hash::{DefaultHasher, Hash, Hasher},
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+use crate::{
+    App, Message as AppMessage, fl,
+    tab::{EditorTab, Tab, editor_text},
+};
+
+const DIFF_DELAY: Duration = Duration::from_millis(200);
+const DIFF_DELAY_LARGE: Duration = Duration::from_millis(500);
+/// Files above this size (bytes) wait longer after an edit before the diff runs.
+const LARGE_FILE: usize = 1024 * 1024;
+/// Each of the two diffs that takes longer falls back to a coarser result instead of blocking.
+const DIFF_DEADLINE: Duration = Duration::from_millis(50);
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub enum Mark {
+    #[default]
+    None,
+    /// Changed and saved during this session (green).
+    Saved,
+    /// Changed and not saved yet (orange).
+    Unsaved,
+}
+
+/// The marks of one line of the current text.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct LineMark {
+    /// The line itself was inserted or changed.
+    pub line: Mark,
+    /// Lines were deleted just above this one (after the last line: on the last line).
+    pub deleted_above: Mark,
+}
+
+fn lines(text: &str) -> Vec<&str> {
+    // Same count as the editor's buffer lines: "a\n" is two lines, the second empty
+    text.split('\n').collect()
+}
+
+/// Marks every line of `new` inserted or changed against `old` with `mark`, and the line after
+/// each deletion. Also returns, per line of `new`, the line of `old` it equals, if any.
+fn diff(old: &[&str], new: &[&str], mark: Mark) -> (Vec<LineMark>, Vec<Option<usize>>) {
+    let deadline = Instant::now() + DIFF_DEADLINE;
+    let mut marks = vec![LineMark::default(); new.len()];
+    let mut origin = vec![None; new.len()];
+    let last = new.len().saturating_sub(1);
+    for op in capture_diff_slices_deadline(Algorithm::Myers, old, new, Some(deadline)) {
+        let (tag, old_range, new_range) = op.as_tag_tuple();
+        match tag {
+            DiffTag::Equal => {
+                for (new_i, old_i) in new_range.zip(old_range) {
+                    origin[new_i] = Some(old_i);
+                }
+            }
+            DiffTag::Delete => {
+                if let Some(line) = marks.get_mut(new_range.start.min(last)) {
+                    line.deleted_above = mark;
+                }
+            }
+            DiffTag::Insert | DiffTag::Replace => {
+                for line in &mut marks[new_range] {
+                    line.line = mark;
+                }
+            }
+        }
+    }
+    (marks, origin)
+}
+
+/// The marks of each line of `current`: `Unsaved` where it differs from `saved`, `Saved` where
+/// it equals `saved` but `saved` differs from `base` there.
+pub fn line_marks(base: &str, saved: &str, current: &str) -> Vec<LineMark> {
+    let (base, saved, current) = (lines(base), lines(saved), lines(current));
+    let saved_marks = if base == saved {
+        vec![LineMark::default(); saved.len()]
+    } else {
+        diff(&base, &saved, Mark::Saved).0
+    };
+    if saved == current {
+        return saved_marks;
+    }
+    let (mut marks, origin) = diff(&saved, &current, Mark::Unsaved);
+    for (mark, origin) in marks.iter_mut().zip(origin) {
+        if let Some(saved_mark) = origin.and_then(|i| saved_marks.get(i)) {
+            mark.line = saved_mark.line;
+            if mark.deleted_above == Mark::None {
+                mark.deleted_above = saved_mark.deleted_above;
+            }
+        }
+    }
+    marks
+}
+
+/// How long to wait after an edit before diffing a text of `len` bytes.
+pub fn diff_delay(len: usize) -> Duration {
+    if len > LARGE_FILE {
+        DIFF_DELAY_LARGE
+    } else {
+        DIFF_DELAY
+    }
+}
+
+fn text_hash(text: &str) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    text.hash(&mut hasher);
+    hasher.finish()
+}
+
+/// Per tab state: the texts to diff against and the marks of the last diff.
+#[derive(Debug, Default)]
+pub struct History {
+    base: Arc<str>,
+    saved: Arc<str>,
+    pub marks: Arc<[LineMark]>,
+    /// Debounce counter: only the result of the newest scheduled diff is kept.
+    generation: u64,
+    /// Hash of the text the marks belong to, `None` when they are out of date.
+    diffed: Option<u64>,
+    /// Length of the last text seen, to debounce large files longer.
+    len: usize,
+}
+
+/// A diff to run off the UI thread.
+pub struct Job {
+    generation: u64,
+    hash: u64,
+    base: Arc<str>,
+    saved: Arc<str>,
+    current: String,
+}
+
+impl Job {
+    pub fn run(self) -> Diffed {
+        Diffed {
+            generation: self.generation,
+            hash: self.hash,
+            marks: line_marks(&self.base, &self.saved, &self.current).into(),
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Diffed {
+    generation: u64,
+    hash: u64,
+    marks: Arc<[LineMark]>,
+}
+
+impl History {
+    /// The text was opened or reloaded from disk: no line counts as changed.
+    pub fn opened(&mut self, text: &str) {
+        self.base = text.into();
+        self.saved = self.base.clone();
+        self.marks = Arc::new([]);
+        self.diffed = Some(text_hash(text));
+        self.len = text.len();
+        // A diff still running belongs to the old text
+        self.generation = self.generation.wrapping_add(1);
+    }
+
+    /// The text was saved: its changed lines turn from unsaved to saved.
+    pub fn saved(&mut self, text: &str) {
+        self.saved = text.into();
+        self.diffed = None;
+        self.generation = self.generation.wrapping_add(1);
+    }
+
+    /// Forget the marks; the next diff computes them again.
+    pub fn clear_marks(&mut self) {
+        self.marks = Arc::new([]);
+        self.diffed = None;
+    }
+
+    /// Start a new debounce period; returns its generation and how long to wait.
+    pub fn schedule(&mut self) -> (u64, Duration) {
+        self.generation = self.generation.wrapping_add(1);
+        (self.generation, diff_delay(self.len))
+    }
+
+    /// Whether `generation` is the newest scheduled diff; check before reading the text.
+    pub fn is_newest(&self, generation: u64) -> bool {
+        generation == self.generation
+    }
+
+    /// The diff to run for `current`, `None` when a newer one was scheduled or the marks
+    /// already belong to this text.
+    pub fn job(&mut self, generation: u64, current: String) -> Option<Job> {
+        if !self.is_newest(generation) {
+            return None;
+        }
+        self.len = current.len();
+        let hash = text_hash(&current);
+        if self.diffed == Some(hash) {
+            return None;
+        }
+        Some(Job {
+            generation,
+            hash,
+            base: self.base.clone(),
+            saved: self.saved.clone(),
+            current,
+        })
+    }
+
+    /// Keep the marks of a finished diff unless a newer one was scheduled since; returns whether
+    /// they were kept.
+    pub fn finish(&mut self, diffed: Diffed) -> bool {
+        if !self.is_newest(diffed.generation) {
+            return false;
+        }
+        self.diffed = Some(diffed.hash);
+        self.marks = diffed.marks;
+        true
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    Diff(Entity, u64),
+    Diffed(Entity, Diffed),
+    Edited,
+    Enabled(bool),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::ChangeHistory(message)
+    }
+}
+
+impl EditorTab {
+    /// The marks to draw, `None` when the feature is off.
+    pub fn change_marks(&self, enabled: bool) -> Option<&[LineMark]> {
+        enabled.then_some(&*self.history.marks)
+    }
+}
+
+impl App {
+    /// The text of `entity` may have changed: diff it after a pause, if it is the visible tab.
+    pub fn change_history_changed(&mut self, entity: Entity) -> Task<AppMessage> {
+        if !self.config.change_history || entity != self.tab_model.active() {
+            return Task::none();
+        }
+        let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) else {
+            return Task::none();
+        };
+        let (generation, delay) = tab.history.schedule();
+        Task::perform(tokio::time::sleep(delay), move |()| {
+            action::app(Message::Diff(entity, generation).into())
+        })
+    }
+
+    pub fn update_change_history(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Diff(entity, generation) => {
+                if !self.config.change_history || entity != self.tab_model.active() {
+                    return Task::none();
+                }
+                let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) else {
+                    return Task::none();
+                };
+                // Every key schedules a diff: only the last one reads the text
+                if !tab.history.is_newest(generation) {
+                    return Task::none();
+                }
+                let current = editor_text(&tab.editor.lock().unwrap());
+                if let Some(job) = tab.history.job(generation, current) {
+                    return Task::perform(tokio::task::spawn_blocking(|| job.run()), move |res| {
+                        match res {
+                            Ok(diffed) => action::app(Message::Diffed(entity, diffed).into()),
+                            Err(err) => {
+                                log::warn!("change history: diff failed: {}", err);
+                                action::none()
+                            }
+                        }
+                    });
+                }
+            }
+            Message::Diffed(entity, diffed) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && tab.history.finish(diffed)
+                {
+                    // The gutter is drawn with the text: redraw it with the new marks
+                    tab.editor.lock().unwrap().set_redraw(true);
+                }
+            }
+            Message::Edited => return self.change_history_changed(self.tab_model.active()),
+            Message::Enabled(enabled) => {
+                match &self.config_handler {
+                    Some(config_handler) => {
+                        if let Err(err) = self.config.set_change_history(config_handler, enabled) {
+                            log::warn!("failed to save config \"change_history\": {}", err);
+                        }
+                    }
+                    None => self.config.change_history = enabled,
+                }
+                for entity in self.tab_model.iter().collect::<Vec<_>>() {
+                    if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                        // Marks of the text before the feature was off would be misplaced
+                        tab.history.clear_marks();
+                        tab.editor.lock().unwrap().set_redraw(true);
+                    }
+                }
+                return self.change_history_changed(self.tab_model.active());
+            }
+        }
+        Task::none()
+    }
+
+    pub fn change_history_settings(&self) -> cosmic::Element<'_, AppMessage> {
+        widget::settings::section()
+            .title(fl!("change-history"))
+            .add(
+                widget::settings::item::builder(fl!("show-changed-lines"))
+                    .toggler(self.config.change_history, |enabled| {
+                        Message::Enabled(enabled).into()
+                    }),
+            )
+            .into()
+    }
+
+    /// Edits: keys, clicks and input method text, as the editor reports only its saved state.
+    pub fn change_history_subscription(&self) -> Subscription<AppMessage> {
+        if !self.config.change_history {
+            return Subscription::none();
+        }
+        event::listen_with(|event, _status, _window| match event {
+            event::Event::Keyboard(keyboard::Event::KeyPressed { .. })
+            | event::Event::Mouse(mouse::Event::ButtonReleased(_))
+            | event::Event::InputMethod(input_method::Event::Commit(_)) => {
+                Some(Message::Edited.into())
+            }
+            _ => None,
+        })
+    }
+}

+/// Draw the change history bar of each visible line, and a short tick at the top of a line
+/// where lines above it were deleted.
+fn draw_change_marks(
+    pixels: &mut [u32],
+    canvas: Canvas,
+    editor: &ViEditor<'static, 'static>,
+    marks: &[LineMark],
+    theme: &cosmic::cosmic_theme::Theme,
+    bar_w: i32,
+    tick_w: i32,
+) {
+    let color = |mark: Mark| {
+        let c = match mark {
+            Mark::None => return None,
+            Mark::Saved => theme.success_color(),
+            Mark::Unsaved => theme.warning_color(),
+        };
+        let channel = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+        Some(cosmic_text::Color::rgba(
+            channel(c.red),
+            channel(c.green),
+            channel(c.blue),
+            channel(c.alpha),
+        ))
+    };
+    editor.with_buffer(|buffer| {
+        let line_height = buffer.metrics().line_height;
+        let line_h = line_height.ceil() as i32;
+        let tick_h = (line_height / 8.0).ceil().max(1.0) as i32;
+        let mut last_line = None;
+        for run in buffer.layout_runs() {

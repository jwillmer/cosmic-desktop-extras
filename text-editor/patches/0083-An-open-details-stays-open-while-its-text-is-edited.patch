+/// The `<details>` still open after a parse turned the keys `old` into `new`, both in document
+/// order: those whose key is still there, and those whose source changed (edited while open), by
+/// their place among the blocks with that heading and summary.
+pub fn carry_open(
+    open: &HashSet<DetailsKey>,
+    old: &[DetailsKey],
+    new: &[&DetailsKey],
+) -> HashSet<DetailsKey> {
+    let same = |a: &DetailsKey, b: &DetailsKey| a.heading == b.heading && a.summary == b.summary;
+    let mut kept = HashSet::new();
+    for key in open {
+        if new.contains(&key) {
+            kept.insert(key.clone());
+            continue;
+        }
+        let Some(place) = old
+            .iter()
+            .filter(|other| same(other, key))
+            .position(|other| other == key)
+        else {
+            continue;
+        };
+        // The block now at that place, unless it is another block that was there before
+        if let Some(edited) = new.iter().filter(|other| same(other, key)).nth(place)
+            && !old
+                .iter()
+                .any(|other| same(other, key) && other.body == edited.body)
+        {
+            kept.insert((*edited).clone());
+        }
+    }
+    kept
+}

+    #[test]
+    fn editing_inside_open_details_keeps_it_open() {
+        let text = "# Notes\n\n<details><summary>Example</summary>\n\nfirst\n\n</details>\n\n\
+                    <details><summary>Example</summary>\n\nsecond\n\n</details>\n";
+        let mut preview = Preview::new(ViewMode::Split);
+        preview.parse(text, None);
+        let keys = details_keys(text);
+        preview.toggle_details(keys[1].clone());
+        // Typing inside the open one changes its source
+        let edited = text.replace("second", "second, typed");
+        preview.parse(&edited, None);
+        let now = details_keys(&edited);
+        assert_ne!(now[1], keys[1]);
+        assert!(preview.open_details.contains(&now[1]));
+        assert!(!preview.open_details.contains(&now[0]));
+        // Removed: nothing left open
+        preview.parse("# Notes\n\nNo details.\n", None);
+        assert!(preview.open_details.is_empty());
+    }

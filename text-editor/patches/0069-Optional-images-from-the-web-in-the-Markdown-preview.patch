diff --git a/src/markdown_remote.rs b/src/markdown_remote.rs
new file mode 100644
index 0000000..ce66a6c
--- /dev/null
+++ b/src/markdown_remote.rs
@@ -0,0 +1,295 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Images from the web in the preview, only when the setting "Load images from the web in
+//! Markdown previews" is on (off by default). Only https is fetched, through GIO (the gvfs HTTP
+//! backend, so no cookies and no referrer from the editor), off the UI thread, up to
+//! [`MAX_BYTES`] and [`TIMEOUT`]. Results stay in memory for the session; a failure keeps the
+//! alt text chip and is logged once per image.
+
+use std::{
+    collections::HashMap,
+    sync::{
+        Arc, LazyLock, Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::Duration,
+};
+
+/// Larger images are not shown.
+pub const MAX_BYTES: usize = 10 * 1024 * 1024;
+/// A fetch that takes longer is cancelled.
+pub const TIMEOUT: Duration = Duration::from_secs(15);
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static CACHE: LazyLock<Mutex<Cache>> = LazyLock::new(Mutex::default);
+
+/// Fetches by URL, for the session.
+#[derive(Default)]
+pub struct Cache {
+    entries: HashMap<String, State>,
+    /// A fetch finished since the last [`take_finished`].
+    finished: bool,
+}
+
+#[derive(Clone)]
+pub enum State {
+    Loading,
+    Loaded(Arc<[u8]>),
+    Failed,
+}
+
+impl Cache {
+    /// The state of `url`; a fetch is started with `fetch` the first time it is asked for.
+    pub fn request(&mut self, url: &str, fetch: impl FnOnce(String)) -> State {
+        if let Some(state) = self.entries.get(url) {
+            return state.clone();
+        }
+        self.entries.insert(url.to_string(), State::Loading);
+        fetch(url.to_string());
+        State::Loading
+    }
+
+    /// A fetch ended: keep the image, or remember the failure so it is not tried again.
+    pub fn finish(&mut self, url: &str, result: Result<Vec<u8>, String>) {
+        let state = match result.and_then(|bytes| check(&bytes).map(|()| bytes)) {
+            Ok(bytes) => State::Loaded(bytes.into()),
+            Err(reason) => {
+                log::warn!("image from {} not shown: {reason}", host(url));
+                State::Failed
+            }
+        };
+        self.entries.insert(url.to_string(), state);
+        self.finished = true;
+    }
+
+    fn loading(&self) -> bool {
+        self.entries
+            .values()
+            .any(|state| matches!(state, State::Loading))
+    }
+}
+
+pub fn set_enabled(enabled: bool) {
+    ENABLED.store(enabled, Ordering::Relaxed);
+}
+
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// Whether the image at `url` is one this module loads: an https URL with a host.
+pub fn is_fetchable(url: &str) -> bool {
+    url.trim()
+        .get(..8)
+        .is_some_and(|scheme| scheme.eq_ignore_ascii_case("https://"))
+        && !host(url).is_empty()
+}
+
+/// The image at `url`, `None` while it loads, after a failure, for anything but https, or with
+/// the setting off (then nothing is fetched). The first ask starts the fetch.
+pub fn image(url: &str) -> Option<Arc<[u8]>> {
+    if !enabled() || !is_fetchable(url) {
+        return None;
+    }
+    match CACHE.lock().unwrap().request(url, spawn_fetch) {
+        State::Loaded(bytes) => Some(bytes),
+        State::Loading | State::Failed => None,
+    }
+}
+
+/// Whether fetches are running or results wait, so the preview checks back for them.
+pub fn pending() -> bool {
+    let cache = CACHE.lock().unwrap();
+    cache.finished || cache.loading()
+}
+
+/// Whether a fetch finished since the last call: the previews should resolve their images again.
+pub fn take_finished() -> bool {
+    std::mem::take(&mut CACHE.lock().unwrap().finished)
+}
+
+/// The host of a URL, for the log.
+pub fn host(url: &str) -> &str {
+    let rest = url.trim().split_once("://").map_or("", |(_, rest)| rest);
+    let authority = rest.split(['/', '?', '#']).next().unwrap_or_default();
+    // Never log credentials in user:password@host
+    authority.rsplit('@').next().unwrap_or_default()
+}
+
+/// Whether the bytes look like an image the preview can draw.
+fn check(bytes: &[u8]) -> Result<(), String> {
+    if bytes.len() > MAX_BYTES {
+        return Err(format!("larger than {} MB", MAX_BYTES / 1024 / 1024));
+    }
+    if is_svg(bytes) || is_raster(bytes) {
+        Ok(())
+    } else {
+        Err("not an image".to_string())
+    }
+}
+
+/// PNG, JPEG, GIF, WebP, BMP or ICO, by their magic numbers.
+pub fn is_raster(bytes: &[u8]) -> bool {
+    bytes.starts_with(b"\x89PNG")
+        || bytes.starts_with(b"\xff\xd8\xff")
+        || bytes.starts_with(b"GIF8")
+        || (bytes.starts_with(b"RIFF") && bytes.get(8..12) == Some(b"WEBP"))
+        || bytes.starts_with(b"BM")
+        || bytes.starts_with(b"\0\0\x01\0")
+}
+
+pub fn is_svg(bytes: &[u8]) -> bool {
+    let head = &bytes[..bytes.len().min(1024)];
+    String::from_utf8_lossy(head).contains("<svg")
+}
+
+fn spawn_fetch(url: String) {
+    std::thread::spawn(move || {
+        let result = fetch(&url);
+        CACHE.lock().unwrap().finish(&url, result);
+    });
+}
+
+#[cfg(feature = "gvfs")]
+fn fetch(url: &str) -> Result<Vec<u8>, String> {
+    use gio::prelude::*;
+
+    let cancellable = gio::Cancellable::new();
+    // Cancel the fetch when it takes too long
+    let (done, timer) = std::sync::mpsc::channel::<()>();
+    let timeout = cancellable.clone();
+    std::thread::spawn(move || {
+        if let Err(std::sync::mpsc::RecvTimeoutError::Timeout) = timer.recv_timeout(TIMEOUT) {
+            timeout.cancel();
+        }
+    });
+    let result = (|| {
+        let stream = gio::File::for_uri(url)
+            .read(Some(&cancellable))
+            .map_err(|err| err.to_string())?;
+        let mut bytes = Vec::new();
+        loop {
+            let chunk = stream
+                .read_bytes(64 * 1024, Some(&cancellable))
+                .map_err(|err| {
+                    if cancellable.is_cancelled() {
+                        format!("no answer within {} s", TIMEOUT.as_secs())
+                    } else {
+                        err.to_string()
+                    }
+                })?;
+            if chunk.is_empty() {
+                return Ok(bytes);
+            }
+            if bytes.len() + chunk.len() > MAX_BYTES {
+                return Err(format!("larger than {} MB", MAX_BYTES / 1024 / 1024));
+            }
+            bytes.extend_from_slice(&chunk);
+        }
+    })();
+    let _ = done.send(());
+    result
+}
+
+#[cfg(not(feature = "gvfs"))]
+fn fetch(_url: &str) -> Result<Vec<u8>, String> {
+    Err("built without gvfs".to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    // Behaviours covered:
+    // - with the setting off nothing is fetched
+    // - only https URLs with a host are fetched
+    // - each URL is fetched once per session, also after a failure
+    // - a result over the size limit or that is not an image keeps the chip
+    // - the log names the host only, never credentials or the path
+
+    use super::*;
+
+    const PNG: &[u8] = b"\x89PNG\r\n\x1a\n rest";
+
+    #[test]
+    fn nothing_is_fetched_with_the_setting_off() {
+        set_enabled(false);
+        assert!(image("https://example.com/off.png").is_none());
+        assert!(
+            !CACHE
+                .lock()
+                .unwrap()
+                .entries
+                .contains_key("https://example.com/off.png"),
+            "no fetch was started"
+        );
+    }
+
+    #[test]
+    fn only_https_is_fetched() {
+        assert!(is_fetchable("https://example.com/a.png"));
+        assert!(is_fetchable("HTTPS://example.com/a.png"));
+        assert!(!is_fetchable("http://example.com/a.png"));
+        assert!(!is_fetchable("ftp://example.com/a.png"));
+        assert!(!is_fetchable("file:///etc/passwd"));
+        assert!(!is_fetchable("img/a.png"));
+        assert!(!is_fetchable("https:///a.png"));
+    }
+
+    #[test]
+    fn each_url_is_fetched_once() {
+        let mut cache = Cache::default();
+        let mut fetches = Vec::new();
+        let url = "https://example.com/a.png";
+        assert!(matches!(
+            cache.request(url, |url| fetches.push(url)),
+            State::Loading
+        ));
+        assert!(cache.loading());
+        assert!(matches!(
+            cache.request(url, |url| fetches.push(url)),
+            State::Loading
+        ));
+        cache.finish(url, Ok(PNG.to_vec()));
+        assert!(!cache.loading() && cache.finished);
+        assert!(
+            matches!(cache.request(url, |url| fetches.push(url)), State::Loaded(bytes) if &*bytes == PNG)
+        );
+        // A failure is not tried again in this session
+        let failing = "https://example.com/missing.png";
+        cache.request(failing, |url| fetches.push(url));
+        cache.finish(failing, Err("not found".to_string()));
+        assert!(matches!(
+            cache.request(failing, |url| fetches.push(url)),
+            State::Failed
+        ));
+        assert_eq!(fetches, [url, failing]);
+    }
+
+    #[test]
+    fn too_large_or_not_an_image_keeps_the_chip() {
+        let mut cache = Cache::default();
+        let mut large = PNG.to_vec();
+        large.resize(MAX_BYTES + 1, 0);
+        for (url, bytes) in [
+            ("https://example.com/large.png", large),
+            (
+                "https://example.com/page.png",
+                b"<html>login</html>".to_vec(),
+            ),
+        ] {
+            cache.request(url, |_| {});
+            cache.finish(url, Ok(bytes));
+            assert!(matches!(cache.request(url, |_| {}), State::Failed), "{url}");
+        }
+        assert!(
+            check(b"<?xml version=\"1.0\"?><svg xmlns=\"http://www.w3.org/2000/svg\"/>").is_ok()
+        );
+        assert!(check(b"GIF89a....").is_ok());
+    }
+
+    #[test]
+    fn log_names_the_host_only() {
+        assert_eq!(host("https://example.com/a/b.png?x=1"), "example.com");
+        assert_eq!(host("https://user:secret@example.com/a.png"), "example.com");
+        assert_eq!(host("https://example.com"), "example.com");
+    }
+}

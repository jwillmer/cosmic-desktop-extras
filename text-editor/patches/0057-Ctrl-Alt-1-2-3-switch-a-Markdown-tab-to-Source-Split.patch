+    fn editor_tab() -> crate::tab::EditorTab {
+        let mut config = crate::Config::default();
+        let system = crate::SYNTAX_SYSTEM.get_or_init(crate::syntax_system);
+        let theme = system.theme_set.themes.keys().next().unwrap();
+        config.syntax_theme_dark = theme.clone();
+        config.syntax_theme_light = theme.clone();
+        crate::tab::EditorTab::new(&config)
+    }
+
+    /// The action bound to Ctrl+Alt+`digit`, matched as the keyboard reports it.
+    fn ctrl_alt_digit(digit: &str) -> Option<Action> {
+        use cosmic::iced::keyboard::{
+            Modifiers,
+            key::{Code, Physical},
+        };
+        let code = match digit {
+            "1" => Code::Digit1,
+            "2" => Code::Digit2,
+            _ => Code::Digit3,
+        };
+        let key = Key::Character(digit.into());
+        crate::key_bind::key_binds()
+            .into_iter()
+            .find(|(bind, _)| {
+                bind.matches(
+                    Modifiers::CTRL | Modifiers::ALT,
+                    &key,
+                    Some(&Physical::Code(code)),
+                )
+            })
+            .map(|(_, action)| action)
+    }
+
+    #[test]
+    fn view_shortcuts_set_each_mode() {
+        let mut tab = editor_tab();
+        tab.markdown = Some(Preview::new(ViewMode::Preview));
+        for (digit, mode) in [
+            ("1", ViewMode::Source),
+            ("2", ViewMode::Split),
+            ("3", ViewMode::Preview),
+        ] {
+            let action = ctrl_alt_digit(digit);
+            assert_eq!(action, Some(Action::MarkdownView(mode)), "Ctrl+Alt+{digit}");
+            assert!(tab.set_markdown_view(mode));
+            assert_eq!(tab.markdown_view(), Some(mode));
+        }
+        // The toggles stay where they were
+        let binds = crate::key_bind::key_binds();
+        assert!(binds.values().any(|a| *a == Action::MarkdownTogglePreview));
+        assert!(binds.values().any(|a| *a == Action::MarkdownToggleSplit));
+    }
+
+    #[test]
+    fn view_shortcuts_ignore_non_markdown_tabs() {
+        let mut tab = editor_tab();
+        assert_eq!(tab.markdown_view(), None);
+        for mode in ViewMode::ALL {
+            assert!(!tab.set_markdown_view(mode));
+            assert_eq!(tab.markdown_view(), None);
+        }
+    }

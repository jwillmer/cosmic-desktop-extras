+    /// Switch a Markdown tab to `mode`; `false` and no change for any other tab.
+    pub fn set_markdown_view(&mut self, mode: ViewMode) -> bool {
+        let Some(preview) = self.markdown.as_mut() else {
+            return false;
+        };
+        preview.mode = mode;
+        self.markdown_refresh();
+        // Force redraw when the editor comes back
+        self.editor.lock().unwrap().set_redraw(true);
+        true

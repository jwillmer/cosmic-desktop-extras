+++ b/src/md_format.rs
@@ -0,0 +1,1225 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Text formatting in Markdown files: bold (Ctrl+B), italic (Ctrl+I), strikethrough
+//! (Ctrl+Shift+X) and inline code (Ctrl+`) wrap the selection, or the word at the cursor, in
+//! their markers, or remove the markers when it already has them. Bold and italic share the `*`
+//! marker: a run of three is both, so toggling one leaves the other; `__` and `_` count when
+//! removing. Also links (Ctrl+K, and pasting a URL over a selection) and headings
+//! (Ctrl+Shift+0..6).
+
+use cosmic_text::{Edit, LineEnding, ViEditor};
+
+use crate::markdown::ViewMode;
+use crate::md_edit::{Change, Fenced, Outcome, Pos, after_quotes, fenced, run};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Style {
+    Bold,
+    Italic,
+    Strikethrough,
+    Code,
+}
+
+impl Style {
+    fn marker(self) -> &'static str {
+        match self {
+            Self::Bold => "**",
+            Self::Italic => "*",
+            Self::Strikethrough => "~~",
+            Self::Code => "`",
+        }
+    }
+
+    /// Whether a run of `n` marker characters around a text gives it this style.
+    fn in_run(self, n: usize) -> bool {
+        match self {
+            Self::Bold | Self::Strikethrough => n >= 2,
+            Self::Italic => n % 2 == 1,
+            Self::Code => n >= 1,
+        }
+    }
+}
+
+impl From<Style> for Format {
+    fn from(style: Style) -> Self {
+        Self::Style(style)
+    }
+}
+
+/// A formatting command of the Edit menu and its shortcuts.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Format {
+    Style(Style),
+    Link,
+    /// Heading level 1 to 6; 0 makes the line plain text.
+    Heading(usize),
+    /// Tick or untick task items (see `md_lists`).
+    ToggleTask,
+    /// Align the columns of the table at the cursor (see `md_table`).
+    Table,
+}
+
+/// Whether the formatting commands work in a tab with this Markdown view: only in Markdown
+/// files (`None` is any other file) with the source shown.
+pub fn enabled(view: Option<ViewMode>) -> bool {
+    view.is_some_and(|view| view != ViewMode::Preview)
+}
+
+/// The part of a line to style, as byte offsets, with the marker runs (of `*`, `_`, `~` or a
+/// backtick) at its two ends: `*_in` markers are the first or last bytes of `start..end`,
+/// `*_out` markers sit just outside it. The selection may cut a run anywhere: `**word**`
+/// selected from `w` to the end is still bold.
+#[derive(Clone, Copy, Debug)]
+struct Span {
+    line: usize,
+    start: usize,
+    end: usize,
+    left_in: usize,
+    left_out: usize,
+    right_in: usize,
+    right_out: usize,
+    /// Code only: a space between each fence and the text, as around text that starts or ends
+    /// with a backtick (`` `` `a` `` ``)
+    pad: bool,
+}
+
+/// The length of the longest run of `c` in `text`.
+fn longest_run(text: &str, c: char) -> usize {
+    text.split(|x| x != c).map(str::len).max().unwrap_or(0)
+}
+
+/// The length of the fences of a code span written `` `` text `` `` around `start..end` of
+/// `text`: a space, then equally long runs of backticks, on both sides.
+fn padded_fence(text: &str, start: usize, end: usize) -> Option<usize> {
+    let before = text[..start].strip_suffix(' ')?;
+    let after = text[end..].strip_prefix(' ')?;
+    let left = before.len() - before.trim_end_matches('`').len();
+    let right = after.len() - after.trim_start_matches('`').len();
+    let open = before.len() - left;
+    // The fences are the two ends of one code span
+    (left > 0 && left == right)
+        .then(|| code_spans(text))
+        .and_then(|spans| {
+            spans
+                .into_iter()
+                .find(|span| *span == (open, left, end + 1))
+        })
+        .map(|_| left)
+}
+
+impl Span {
+    /// The span `start..end` of `text` with its runs of the marker character `c`.
+    fn new(text: &str, line: usize, start: usize, end: usize, c: char) -> Self {
+        if c == '`'
+            && let Some(n) = padded_fence(text, start, end)
+        {
+            return Self {
+                line,
+                start,
+                end,
+                left_in: 0,
+                left_out: n,
+                right_in: 0,
+                right_out: n,
+                pad: true,
+            };
+        }
+        let part = &text[start..end];
+        let lead = part.len() - part.trim_start_matches(c).len();
+        let lead = lead.min(part.len() / 2);
+        let trail = part.len() - part.trim_end_matches(c).len();
+        let trail = trail.min(part.len() - lead);
+        let before = start - text[..start].trim_end_matches(c).len();
+        let after = text.len() - end - text[end..].trim_start_matches(c).len();
+        // An escaped marker is text, not a marker
+        let before = if text[..start - before].ends_with('\\') {
+            0
+        } else {
+            before
+        };
+        // `**a** and **b**` selected: the markers at the ends close and open two different runs
+        let (lead, trail) = if lead.min(trail) > 0
+            && longest_run(&part[lead..part.len() - trail], c) >= lead.min(trail)
+        {
+            (0, 0)
+        } else {
+            (lead, trail)
+        };
+        Self {
+            line,
+            start,
+            end,
+            left_in: lead,
+            left_out: before,
+            right_in: trail,
+            right_out: after,
+            pad: false,
+        }
+    }
+
+    fn has(&self, style: Style) -> bool {
+        style.in_run((self.left_in + self.left_out).min(self.right_in + self.right_out))
+    }
+
+    /// The change that adds or removes `style`, where the styled text is afterwards, and where
+    /// it started before (to keep the cursor on the same letter).
+    fn toggle(&self, text: &str, style: Style, remove: bool) -> (Change, usize, usize, usize) {
+        let k = match style {
+            // A code span's fences are as long as each other, however long
+            Style::Code => (self.left_in + self.left_out).min(self.right_in + self.right_out),
+            _ => style.marker().len(),
+        };
+        let pad = usize::from(self.pad);
+        if remove {
+            // Markers inside the selection go first; `has` made sure each end has `k`
+            let (left_in, right_in) = (k.min(self.left_in), k.min(self.right_in));
+            let start = self.start - pad - (k - left_in);
+            let kept = &text[self.start + left_in..self.end - right_in];
+            let change = Change {
+                line: self.line,
+                start,
+                end: self.end + pad + (k - right_in),
+                text: kept.to_string(),
+            };
+            (change, start, start + kept.len(), self.start + left_in)
+        } else if style == Style::Code {
+            // Backticks in the text need a longer fence, and a space keeps one at either end of
+            // the text apart from it (CommonMark strips that space again)
+            let part = &text[self.start..self.end];
+            let fence = "`".repeat(longest_run(part, '`') + 1);
+            let pad = if part.starts_with('`') || part.ends_with('`') {
+                " "
+            } else {
+                ""
+            };
+            let change = Change {
+                line: self.line,
+                start: self.start,
+                end: self.end,
+                text: format!("{fence}{pad}{part}{pad}{fence}"),
+            };
+            let k = fence.len() + pad.len();
+            (change, self.start + k, self.end + k, self.start)
+        } else {
+            let marker = style.marker();
+            let change = Change {
+                line: self.line,
+                start: self.start,
+                end: self.end,
+                text: format!("{marker}{}{marker}", &text[self.start..self.end]),
+            };
+            (change, self.start + k, self.end + k, self.start)
+        }
+    }
+}
+
+fn is_word(c: char) -> bool {
+    c.is_alphanumeric() || c == '_'
+}
+
+/// The word that contains or touches byte `at` of `text`.
+fn word_at(text: &str, at: usize) -> Option<(usize, usize)> {
+    let start = text[..at]
+        .char_indices()
+        .rev()
+        .take_while(|(_, c)| is_word(*c))
+        .last()
+        .map_or(at, |(i, _)| i);
+    let end = text[at..]
+        .char_indices()
+        .find(|(_, c)| !is_word(*c))
+        .map_or(text.len(), |(i, _)| at + i);
+    (start < end).then_some((start, end))
+}
+
+/// The word at byte `at` of `text`, or the one just behind the markers `c` before `at` or just
+/// after the markers after it: `**word**|` toggles `word`.
+fn word_near(text: &str, at: usize, c: char) -> Option<(usize, usize)> {
+    if let Some(word) = word_at(text, at) {
+        return Some(word);
+    }
+    let before = text[..at].trim_end_matches(c).len();
+    let after = text.len() - text[at..].trim_start_matches(c).len();
+    (before < at)
+        .then(|| word_at(text, before).filter(|word| word.1 == before))
+        .flatten()
+        .or_else(|| {
+            (after > at)
+                .then(|| word_at(text, after).filter(|word| word.0 == after))
+                .flatten()
+        })
+}
+
+/// The code spans of `text`, as CommonMark reads them: where the opening run of backticks
+/// starts, its length, and where the closing run (as long as the opening one) starts. A run
+/// without a closing one is text, and so is a backtick escaped by a backslash.
+fn code_spans(text: &str) -> Vec<(usize, usize, usize)> {
+    let bytes = text.as_bytes();
+    let run = |at: usize| bytes[at..].iter().take_while(|b| **b == b'`').count();
+    let mut spans = Vec::new();
+    let mut i = 0;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'\\' => i += 2,
+            b'`' => {
+                let n = run(i);
+                let mut j = i + n;
+                let mut close = None;
+                while j < bytes.len() {
+                    if bytes[j] == b'`' {
+                        let m = run(j);
+                        if m == n {
+                            close = Some(j);
+                            break;
+                        }
+                        j += m;
+                    } else {
+                        j += 1;
+                    }
+                }
+                match close {
+                    Some(close) => {
+                        spans.push((i, n, close));
+                        i = close + n;
+                    }
+                    None => i += n,
+                }
+            }
+            _ => i += 1,
+        }
+    }
+    spans
+}
+
+/// The code span that byte `at` of `text` is inside (after its first backtick, up to its
+/// closing run).
+fn code_span_at(text: &str, at: usize) -> Option<(usize, usize, usize)> {
+    code_spans(text)
+        .into_iter()
+        .find(|(open, _, close)| *open < at && at <= *close)
+}
+
+/// Whether byte `at` of `text` is inside a code span.
+fn in_code_span(text: &str, at: usize) -> bool {
+    code_span_at(text, at).is_some()
+}
+
+/// For lines `0..=last`: whether each is Markdown text the commands change, not in a fenced
+/// code block or front matter.
+fn text_lines(lines: &[&str], last: usize) -> Vec<bool> {
+    let front = crate::slash_menu::front_matter_end(lines);
+    fenced(lines, last)
+        .into_iter()
+        .enumerate()
+        .map(|(line, code)| code == Fenced::Text && front.is_none_or(|end| line > end))
+        .collect()
+}
+
+/// `rest` after a list marker `-`, `*`, `+` or `1.` and the spaces after it, if it starts
+/// with one.
+fn after_list_marker(rest: &str) -> &str {
+    let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+    let bullet = if rest.starts_with(['-', '*', '+']) {
+        1
+    } else if (1..=9).contains(&digits) && rest[digits..].starts_with(['.', ')']) {
+        digits + 1
+    } else {
+        0
+    };
+    if bullet > 0 && rest[bullet..].starts_with([' ', '\t']) {
+        rest[bullet..].trim_start_matches([' ', '\t'])
+    } else {
+        rest
+    }
+}
+
+/// Where the text of a line starts after its indentation and block markers: quote `>`,
+/// heading `#`, list `-`, `*`, `+` or `1.`, task box `[ ]`. A selection that starts in them
+/// starts here, so `- item` becomes `- **item**`.
+fn content_start(text: &str) -> usize {
+    let mut rest = after_quotes(text);
+    let hashes = rest.len() - rest.trim_start_matches('#').len();
+    if (1..=6).contains(&hashes) && rest[hashes..].starts_with(' ') {
+        rest = rest[hashes..].trim_start_matches(' ');
+    } else {
+        let after = after_list_marker(rest);
+        if after.len() < rest.len() {
+            rest = after;
+            for task in ["[ ] ", "[x] ", "[X] "] {
+                if let Some(after) = rest.strip_prefix(task) {
+                    rest = after.trim_start_matches(' ');
+                }
+            }
+        }
+    }
+    text.len() - rest.len()
+}
+
+/// Toggle `style` on `lines` (the lines of the file, without line endings) for the cursor and
+/// the selection anchor, when there is a selection.
+///
+/// - A selection: its text on each line (without spaces at its ends and without block markers
+///   at the line start) gets the markers, the selection stays on the text inside them. A
+///   selection over several lines wraps each line's part on its own. When every part already
+///   has the style, the markers come off instead, inside or just outside the selection.
+/// - No selection, in or next to a word: the same for the word; the cursor stays on its letter.
+/// - No selection elsewhere: an empty pair (`****`, `**`) with the cursor in the middle, or
+///   the pair around the cursor comes off.
+/// - Bold and italic are added with `*` but also come off when written with `_`.
+/// - Code is left alone, except that inline code comes off a code span around the cursor.
+///
+/// `None` when there is nothing to style (a selection of spaces or block markers only).
+pub fn toggle(lines: &[&str], cursor: Pos, anchor: Option<Pos>, style: Style) -> Option<Outcome> {
+    let text = |line: usize| lines.get(line).copied().unwrap_or_default();
+    let anchor = anchor.filter(|anchor| *anchor != cursor);
+    let Some(anchor) = anchor else {
+        let (line, at) = cursor;
+        let line_text = text(line);
+        if !text_lines(lines, line)[line] {
+            return None;
+        }
+        if in_code_span(line_text, at) {
+            return (style == Style::Code)
+                .then(|| unwrap_code_span(line_text, line, at))
+                .flatten();
+        }
+        let (span, remove) = styled_span(line_text, style, |c| {
+            let (start, end) = word_near(line_text, at, c).unwrap_or((at, at));
+            Span::new(line_text, line, start, end, c)
+        });
+        let (change, new_start, new_end, old_start) = span.toggle(line_text, style, remove);
+        // `~~~~` alone at the start of a line would open a code block
+        if span.start == span.end && !remove {
+            let new = format!(
+                "{}{}{}",
+                &line_text[..change.start],
+                change.text,
+                &line_text[change.end..]
+            );
+            if after_list_marker(after_quotes(&new)).starts_with("~~~") {
+                return None;
+            }
+        }
+        // On the same letter; before or after the word's markers: at its start or end
+        let offset = at.saturating_sub(old_start).min(new_end - new_start);
+        return Some(Outcome {
+            changes: vec![change],
+            cursor: (line, new_start + offset),
+            anchor: None,
+        });
+    };
+    let (first, last) = if anchor < cursor {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    };
+    let markdown = text_lines(lines, last.0);
+    let spans: Vec<(Span, bool)> = (first.0..=last.0)
+        .filter(|line| markdown[*line])
+        .filter_map(|line| {
+            let line_text = text(line);
+            let mut start = if line == first.0 { first.1 } else { 0 };
+            let end = if line == last.0 {
+                last.1
+            } else {
+                line_text.len()
+            };
+            start = start.max(content_start(line_text).min(end));
+            let part = &line_text[start..end];
+            let start = start + (part.len() - part.trim_start().len());
+            let end = start + part.trim().len();
+            let (span, has) = styled_span(line_text, style, |c| {
+                Span::new(line_text, line, start, end, c)
+            });
+            // Inside a code span only inline code itself can come off
+            let code_span = in_code_span(line_text, start);
+            (start < end && (!code_span || style == Style::Code && has)).then_some((span, has))
+        })
+        .collect();
+    let remove = !spans.is_empty() && spans.iter().all(|(_, has)| *has);
+    let mut changes = Vec::new();
+    let mut bounds = Vec::new();
+    for (span, has) in spans.iter().rev() {
+        let line_text = text(span.line);
+        if remove || !has {
+            let (change, start, end, _) = span.toggle(line_text, style, remove);
+            changes.push(change);
+            bounds.push((span.line, start, end));
+        } else {
+            bounds.push((span.line, span.start, span.end));
+        }
+    }
+    let (end_line, _, end) = *bounds.first()?;
+    let (start_line, start, _) = *bounds.last()?;
+    let (start, end) = ((start_line, start), (end_line, end));
+    let (cursor, anchor) = if cursor < anchor {
+        (start, end)
+    } else {
+        (end, start)
+    };
+    Some(Outcome {
+        changes,
+        cursor,
+        anchor: Some(anchor),
+    })
+}
+
+/// The span `span_with` gives for the marker characters of `style`, and whether it has the
+/// style. Bold and italic are added with `*` but also come off when written with `_`, unless
+/// the `_` is inside a word (`snake_case` has none to remove).
+fn styled_span(text: &str, style: Style, span_with: impl Fn(char) -> Span) -> (Span, bool) {
+    let chars: &[char] = match style {
+        Style::Bold | Style::Italic => &['*', '_'],
+        Style::Strikethrough => &['~'],
+        Style::Code => &['`'],
+    };
+    for c in chars {
+        let span = span_with(*c);
+        if span.has(style) {
+            let (change, ..) = span.toggle(text, style, true);
+            let flanked = *c != '_'
+                || !text[..change.start].ends_with(char::is_alphanumeric)
+                    && !text[change.end..].starts_with(char::is_alphanumeric);
+            if flanked {
+                return (span, true);
+            }
+        }
+    }
+    (span_with(chars[0]), false)
+}
+
+/// Remove the backticks of the code span around byte `at` of `text`, and the space that pads
+/// its text from them.
+fn unwrap_code_span(text: &str, line: usize, at: usize) -> Option<Outcome> {
+    let (open, n, close) = code_span_at(text, at)?;
+    let inner = &text[open + n..close];
+    let pad = usize::from(
+        inner.len() > 2
+            && inner.starts_with(' ')
+            && inner.ends_with(' ')
+            && !inner.trim().is_empty(),
+    );
+    let kept = &inner[pad..inner.len() - pad];
+    let offset = at.saturating_sub(open + n + pad).min(kept.len());
+    Some(Outcome {
+        changes: vec![Change {
+            line,
+            start: open,
+            end: close + n,
+            text: kept.to_string(),
+        }],
+        cursor: (line, open + offset),
+        anchor: None,
+    })
+}
+
+/// Whether `text` looks like a URL to link to.
+fn is_url(text: &str) -> bool {
+    let lower = text.to_ascii_lowercase();
+    !text.is_empty()
+        && !text.contains(char::is_whitespace)
+        && [
+            "http://", "https://", "ftp://", "file://", "mailto:", "www.",
+        ]
+        .iter()
+        .any(|scheme| lower.starts_with(scheme) && lower.len() > scheme.len())
+}
+
+/// The URL part (without a title) of the link `[text](url)` around byte `at` of `text`.
+fn link_url_at(text: &str, at: usize) -> Option<(usize, usize)> {
+    text.match_indices("](").find_map(|(middle, _)| {
+        let open = text[..middle].rfind('[')?;
+        // A URL may hold balanced parentheses: `Foo_(bar)`
+        let mut depth = 0usize;
+        let close = middle
+            + 2
+            + text[middle + 2..].find(|c| match c {
+                '(' => {
+                    depth += 1;
+                    false
+                }
+                ')' if depth > 0 => {
+                    depth -= 1;
+                    false
+                }
+                ')' => true,
+                _ => false,
+            })?;
+        let url = &text[middle + 2..close];
+        let url_end = middle + 2 + url.find(' ').unwrap_or(url.len());
+        (open <= at && at <= close + 1).then_some((middle + 2, url_end))
+    })
+}
+
+/// The selection on one line, without spaces at its ends, outside code: line, start and end.
+fn selected_text(lines: &[&str], cursor: Pos, anchor: Pos) -> Option<(usize, usize, usize)> {
+    let (first, last) = if anchor < cursor {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    };
+    let line = first.0;
+    let text = lines.get(line)?;
+    if last.0 != line || !text_lines(lines, line)[line] || in_code_span(text, first.1) {
+        return None;
+    }
+    let part = &text[first.1..last.1];
+    let start = first.1 + (part.len() - part.trim_start().len());
+    let end = start + part.trim().len();
+    (start < end).then_some((line, start, end))
+}
+
+/// Ctrl+K:
+///
+/// - A selection on one line: `[selection](url)` with `url` selected; a selected URL becomes
+///   `[](URL)` with the cursor between the brackets.
+/// - No selection in a link: its URL is selected.
+/// - No selection in or next to a word: `[word](url)` with `url` selected.
+/// - No selection elsewhere: `[text](url)` with `text` selected.
+///
+/// `None` in code, and for a selection over several lines or of spaces only.
+pub fn link(lines: &[&str], cursor: Pos, anchor: Option<Pos>) -> Option<Outcome> {
+    if let Some(anchor) = anchor.filter(|anchor| *anchor != cursor) {
+        let (line, start, end) = selected_text(lines, cursor, anchor)?;
+        let selected = &lines[line][start..end];
+        let change = |text: String| Change {
+            line,
+            start,
+            end,
+            text,
+        };
+        return Some(if is_url(selected) {
+            Outcome {
+                changes: vec![change(format!("[]({selected})"))],
+                cursor: (line, start + 1),
+                anchor: None,
+            }
+        } else {
+            let url = start + selected.len() + 3;
+            Outcome {
+                changes: vec![change(format!("[{selected}](url)"))],
+                cursor: (line, url + 3),
+                anchor: Some((line, url)),
+            }
+        });
+    }
+    let (line, at) = cursor;
+    let text = lines.get(line).copied().unwrap_or_default();
+    if !text_lines(lines, line)[line] || in_code_span(text, at) {
+        return None;
+    }
+    if let Some((start, end)) = link_url_at(text, at) {
+        return Some(Outcome {
+            changes: Vec::new(),
+            cursor: (line, end),
+            anchor: Some((line, start)),
+        });
+    }
+    if let Some((start, end)) = word_at(text, at) {
+        let url = end + 3;
+        return Some(Outcome {
+            changes: vec![Change {
+                line,
+                start,
+                end,
+                text: format!("[{}](url)", &text[start..end]),
+            }],
+            cursor: (line, url + 3),
+            anchor: Some((line, url)),
+        });
+    }
+    Some(Outcome {
+        changes: vec![Change {
+            line,
+            start: at,
+            end: at,
+            text: "[text](url)".to_string(),
+        }],
+        cursor: (line, at + 5),
+        anchor: Some((line, at + 1)),
+    })
+}
+
+/// Pasting `value` over a selection: a URL over text on one line makes a link
+/// `[selection](URL)`, with the cursor after it. `None` for a normal paste.
+pub fn paste_link(
+    lines: &[&str],
+    cursor: Pos,
+    anchor: Option<Pos>,
+    value: &str,
+) -> Option<Outcome> {
+    let url = value.trim();
+    let anchor = anchor.filter(|anchor| *anchor != cursor)?;
+    if !is_url(url) {
+        return None;
+    }
+    let (line, start, end) = selected_text(lines, cursor, anchor)?;
+    let selected = &lines[line][start..end];
+    if is_url(selected) {
+        return None;
+    }
+    let text = format!("[{selected}]({url})");
+    let after = start + text.len();
+    Some(Outcome {
+        changes: vec![Change {
+            line,
+            start,
+            end,
+            text,
+        }],
+        cursor: (line, after),
+        anchor: None,
+    })
+}
+
+/// The heading marker of a line, after its indentation, quote `>` and list markers: where it
+/// starts, where the text after it starts, and its level (0 for none).
+fn heading_marker(text: &str) -> (usize, usize, usize) {
+    let rest = after_list_marker(after_quotes(text));
+    let start = text.len() - rest.len();
+    let hashes = rest.len() - rest.trim_start_matches('#').len();
+    let after = &rest[hashes..];
+    if (1..=6).contains(&hashes) && (after.is_empty() || after.starts_with([' ', '\t'])) {
+        let end = text.len() - after.trim_start_matches([' ', '\t']).len();
+        (start, end, hashes)
+    } else {
+        (start, start, 0)
+    }
+}
+
+/// Whether a line is a task item (`- [ ] text`, also in a quote).
+fn is_task(text: &str) -> bool {
+    let rest = after_quotes(text);
+    let after = after_list_marker(rest);
+    after.len() < rest.len()
+        && ["[ ]", "[x]", "[X]"].iter().any(|task| {
+            after
+                .strip_prefix(task)
+                .is_some_and(|tail| tail.is_empty() || tail.starts_with([' ', '\t']))
+        })
+}
+
+/// Set heading `level` (1 to 6, 0 for plain text) on the line of the cursor, or each line of
+/// the selection outside code. When all of them already have that level, they become plain
+/// text. Quote and list markers stay in front; task items stay as they are. `None` when there is
+/// no line to change.
+pub fn heading(lines: &[&str], cursor: Pos, anchor: Option<Pos>, level: usize) -> Option<Outcome> {
+    let anchor = anchor.filter(|anchor| *anchor != cursor);
+    let (first, last) = match anchor {
+        Some(anchor) if anchor < cursor => (anchor, cursor),
+        Some(anchor) => (cursor, anchor),
+        None => (cursor, cursor),
+    };
+    // A selection that ends at the start of a line leaves that line alone
+    let last_line = if last.0 > first.0 && last.1 == 0 {
+        last.0 - 1
+    } else {
+        last.0
+    };
+    let markdown = text_lines(lines, last_line);
+    let text = |line: usize| lines.get(line).copied().unwrap_or_default();
+    let several = last_line > first.0;
+    let markers: Vec<(usize, (usize, usize, usize))> = (first.0..=last_line)
+        .filter(|line| {
+            // Blank lines between selected ones stay blank; a heading would end a task item
+            markdown[*line] && !(several && text(*line).trim().is_empty()) && !is_task(text(*line))
+        })
+        .map(|line| (line, heading_marker(text(line))))
+        .collect();
+    if markers.is_empty() {
+        return None;
+    }
+    let level = level.min(6);
+    let level = if markers.iter().all(|(_, (_, _, now))| *now == level) {
+        0
+    } else {
+        level
+    };
+    let marker = if level == 0 {
+        String::new()
+    } else {
+        format!("{} ", "#".repeat(level))
+    };
+    // Where a position ends up: after the new marker when it was in or after the old one
+    let moved = |(line, at): Pos| {
+        let changed = markers
+            .iter()
+            .find(|(l, (_, _, now))| *l == line && *now != level);
+        let Some((_, (start, end, _))) = changed else {
+            return (line, at);
+        };
+        if at >= *end {
+            (line, at - (end - start) + marker.len())
+        } else if at >= *start {
+            (line, start + marker.len())
+        } else {
+            (line, at)
+        }
+    };
+    let changes = markers
+        .iter()
+        .rev()
+        .filter(|(_, (_, _, now))| *now != level)
+        .map(|(line, (start, end, _))| Change {
+            line: *line,
+            start: *start,
+            end: *end,
+            text: marker.clone(),
+        })
+        .collect();
+    Some(Outcome {
+        changes,
+        cursor: moved(cursor),
+        anchor: anchor.map(moved),
+    })
+}
+
+/// Run `format` in `editor` at its cursor and selection, as one undo step.
+pub fn apply(editor: &mut ViEditor<'static, 'static>, format: Format) {
+    run(
+        editor,
+        LineEnding::Lf,
+        |lines, cursor, anchor| match format {
+            Format::Style(style) => toggle(lines, cursor, anchor, style),
+            Format::Link => link(lines, cursor, anchor),
+            Format::ToggleTask => crate::md_lists::toggle_task(lines, cursor, anchor),
+            Format::Heading(level) => heading(lines, cursor, anchor, level),
+            Format::Table => crate::md_table::format_at(lines, cursor, anchor),
+        },
+    );
+}
+
+/// Paste `value` in `editor` as a link around the selection when it is a URL over text (see
+/// `paste_link`), as one undo step. Whether it did; otherwise paste as usual.
+pub fn paste(editor: &mut ViEditor<'static, 'static>, value: &str) -> bool {
+    if !is_url(value.trim()) || editor.selection_bounds().is_none() {
+        return false;
+    }
+    run(editor, LineEnding::Lf, |lines, cursor, anchor| {
+        paste_link(lines, cursor, anchor, value)
+    })
+}

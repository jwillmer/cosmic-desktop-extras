+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The "/" command menu of Markdown files: typing "/" at the start of a line (or after only
+//! whitespace) lists Markdown constructs, typing filters them, picking one replaces the
+//! "/query" with plain Markdown text. Pure logic only; `text_box` draws it and feeds it keys.
+
+use pulldown_cmark::{Event, Parser, Tag, TagEnd};
+
+use std::sync::LazyLock;
+
+use crate::fl;
+
+/// One construct of the menu.
+#[derive(Debug)]
+pub struct Item {
+    /// The English label: it identifies the item and its words always match the query.
+    name: &'static str,
+    /// The label in the user's language.
+    label: fn() -> String,
+    /// Short Markdown syntax shown next to the label.
+    hint: &'static str,
+    /// Extra words the query may start with (besides the words of the label).
+    keywords: &'static [&'static str],
+    /// The Markdown inserted, lines separated by `\n`.
+    text: &'static str,
+    /// A block of its own: blank lines keep it apart from text above and below.
+    block: bool,
+    /// Byte offset in `text` of the cursor after the insertion.
+    cursor: usize,
+    /// Byte offset in `text` of the selection anchor, when part of it is selected (the cursor
+    /// ends the selection).
+    anchor: Option<usize>,
+}
+
+impl Item {
+    /// The label to show, in the user's language.
+    pub fn label(&self) -> &'static str {
+        &labels()[self.index()].0
+    }
+
+    /// The position of this item in `ITEMS` (every item lives there).
+    pub fn index(&self) -> usize {
+        let offset = std::ptr::from_ref(self) as usize - ITEMS.as_ptr() as usize;
+        let index = offset / std::mem::size_of::<Item>();
+        debug_assert!(std::ptr::eq(&ITEMS[index], self));
+        index
+    }
+
+    /// The Markdown syntax to show next to the label, e.g. `##` or `- [ ]`.
+    pub fn hint(&self) -> &'static str {
+        self.hint
+    }
+}
+
+/// The translated labels of `ITEMS`, and in lower case: looked up once, the language does not
+/// change while the editor runs.
+fn labels() -> &'static [(String, String)] {
+    static LABELS: LazyLock<Vec<(String, String)>> = LazyLock::new(|| {
+        ITEMS
+            .iter()
+            .map(|item| {
+                let label = (item.label)();
+                let lower = label.to_lowercase();
+                (label, lower)
+            })
+            .collect()
+    });
+    &LABELS
+}
+
+const fn item(
+    name: &'static str,
+    label: fn() -> String,
+    hint: &'static str,
+    keywords: &'static [&'static str],
+    text: &'static str,
+) -> Item {
+    Item {
+        name,
+        label,
+        hint,
+        keywords,
+        text,
+        block: false,
+        cursor: text.len(),
+        anchor: None,
+    }
+}
+
+pub static ITEMS: &[Item] = &[
+    item(
+        "Heading 1",
+        || fl!("slash-heading-1"),

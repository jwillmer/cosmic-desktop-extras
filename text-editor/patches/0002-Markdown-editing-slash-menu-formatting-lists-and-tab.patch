index 0000000..0279cea
--- /dev/null
+++ b/src/md_table.rs
@@ -0,0 +1,872 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Pipe tables in Markdown files (GFM): moving between cells, adding rows and aligning the
+//! columns.
+//!
+//! - Tab in a table row selects the content of the next cell (or puts the cursor in it when
+//!   it is empty), Shift+Tab the previous one; the delimiter row is skipped. Tab in the last
+//!   cell of the last row adds a row and moves into its first cell.
+//! - Enter in a cell adds an empty row below the row (below the delimiter row on the header)
+//!   and moves into its first cell, as in Typora. Enter on an empty last row removes it and
+//!   ends the table, as Enter on an empty list item ends the list. Enter in front of a row or
+//!   after its last pipe is a plain new line, so a line can still be added above the table and
+//!   a table can be typed row by row.
+//! - Tab, Shift+Tab and Enter format the table on the way (as the Advanced Tables plugin of
+//!   Obsidian does), and so does the "Format table" command: every row gets leading and
+//!   trailing pipes, cells are padded to the widest one in their column, as the delimiter row
+//!   aligns them (`:---` left, `:---:` center, `---:` right), and short rows get empty cells.
+//!   Widths count characters.
+//!
+//! Cells split at every `|` that is not escaped as `\|`, also inside code spans, as GFM
+//! splits them. Tables may be indented or quoted. Nothing happens in code blocks, front matter
+//! or HTML blocks.
+
+use cosmic_text::{Edit, LineEnding};
+
+use crate::md_edit::{Change, Outcome, Pos, after_quotes, run};
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Align {
+    None,
+    Left,
+    Center,
+    Right,
+}
+
+/// A table row, as byte offsets in its line.
+#[derive(Clone, Debug)]
+struct Row {
+    /// Where the row starts, after the quote markers and indentation
+    start: usize,
+    /// The number of quote markers in front of the row
+    quotes: usize,
+    /// The indentation after the quote markers, in bytes
+    indent: usize,
+    /// Each cell between its pipes, spaces included
+    cells: Vec<(usize, usize)>,
+}
+
+impl Row {
+    /// The content of cell `k` of `text` without the spaces around it.
+    fn content(&self, text: &str, k: usize) -> (usize, usize) {
+        let (start, end) = self.cells[k];
+        let cell = &text[start..end];
+        let lead = cell.len() - cell.trim_start_matches([' ', '\t']).len();
+        let trail = cell.len() - cell.trim_end_matches([' ', '\t']).len();
+        if lead == cell.len() {
+            // Empty: the cursor goes after the first space
+            let at = (start + 1).min(end);
+            (at, at)
+        } else {
+            (start + lead, end - trail)
+        }
+    }
+
+    /// The cell that byte `at` is in: in front of the row it is the first, past it the last.
+    fn cell_at(&self, at: usize) -> usize {
+        self.cells
+            .iter()
+            .position(|(_, end)| at <= *end)
+            .unwrap_or(self.cells.len() - 1)
+    }
+}
+
+/// `text` as a table row: `None` without an unescaped pipe.
+fn split_row(text: &str) -> Option<Row> {
+    let start = text.len() - after_quotes(text).len();
+    let head = &text[..start];
+    let quotes = head.matches('>').count();
+    let indent = head.len() - head.rfind('>').map_or(0, |quote| quote + 1);
+    let mut pipes = Vec::new();
+    let mut escaped = false;
+    for (i, c) in text[start..].char_indices() {
+        match c {
+            _ if escaped => escaped = false,
+            '\\' => escaped = true,
+            '|' => pipes.push(start + i),
+            _ => {}
+        }
+    }
+    if pipes.is_empty() {
+        return None;
+    }
+    let mut bounds = vec![start];
+    for pipe in &pipes {
+        bounds.push(*pipe);
+        bounds.push(pipe + 1);
+    }
+    bounds.push(text.len());
+    let mut cells: Vec<(usize, usize)> = bounds.chunks(2).map(|b| (b[0], b[1])).collect();
+    // A leading pipe has nothing in front of it, a trailing one nothing but spaces after it
+    if pipes[0] == start {
+        cells.remove(0);
+    }
+    if text[pipes[pipes.len() - 1] + 1..].trim().is_empty() {
+        cells.pop();
+    }
+    (!cells.is_empty()).then_some(Row {
+        start,
+        quotes,
+        indent,
+        cells,
+    })
+}
+
+/// `text` as a row of a table body. As in GFM, a line with text but no pipe is a row too, of one
+/// cell; a thematic break (`---`, `***`, `___`) is not.
+fn body_row(text: &str) -> Option<Row> {
+    split_row(text).or_else(|| {
+        let start = text.len() - after_quotes(text).len();
+        let rest = text[start..].trim();
+        let rule = rest.len() >= 3
+            && ['-', '*', '_'].into_iter().any(|c| {
+                rest.chars().all(|x| x == c || x == ' ' || x == '\t')
+                    && rest.matches(c).count() >= 3
+            });
+        if rest.is_empty() || rule {
+            return None;
+        }
+        let head = &text[..start];
+        Some(Row {
+            start,
+            quotes: head.matches('>').count(),
+            indent: head.len() - head.rfind('>').map_or(0, |quote| quote + 1),
+            cells: vec![(start, text.len())],
+        })
+    })
+}
+
+/// The alignment of a delimiter cell, `None` when it is no delimiter cell.
+fn delimiter(cell: &str) -> Option<Align> {
+    let cell = cell.trim();
+    let left = cell.starts_with(':');
+    let right = cell.len() > 1 && cell.ends_with(':');
+    let dashes = &cell[left as usize..cell.len() - right as usize];
+    if dashes.is_empty() || !dashes.chars().all(|c| c == '-') {
+        return None;
+    }
+    Some(match (left, right) {
+        (true, true) => Align::Center,
+        (true, false) => Align::Left,
+        (false, true) => Align::Right,
+        (false, false) => Align::None,
+    })
+}
+
+/// The alignments of `row` on `text`, when it is a delimiter row.
+fn delimiter_row(text: &str, row: &Row) -> Option<Vec<Align>> {
+    row.cells
+        .iter()
+        .map(|(start, end)| delimiter(&text[*start..*end]))
+        .collect()
+}
+
+/// A table: its lines `first..=last`, the delimiter row on `first + 1`.
+struct Table {
+    first: usize,
+    last: usize,
+    rows: Vec<Row>,
+    aligns: Vec<Align>,
+}
+
+impl Table {
+    fn row(&self, line: usize) -> &Row {
+        &self.rows[line - self.first]
+    }
+
+    fn delimiter(&self) -> usize {
+        self.first + 1
+    }
+}
+
+/// The table that line `line` is in.
+fn find(lines: &[&str], line: usize) -> Option<Table> {
+    let row = |i: usize| body_row(lines[i]).filter(|row| !starts_block(lines[i], row, row));
+    if line >= lines.len() {
+        return None;
+    }
+    // The cursor's line has a pipe; the header and delimiter rows need one too
+    let at = split_row(lines[line]).filter(|row| !starts_block(lines[line], row, row))?;
+    if !crate::slash_menu::markdown_allows(lines.iter().copied(), line, at.start) {
+        return None;
+    }
+    let same = |i: usize| row(i).filter(|row| row.quotes == at.quotes);
+    let mut top = line;
+    while top > 0 && same(top - 1).is_some() {
+        top -= 1;
+    }
+    let mut last = line;
+    while last + 1 < lines.len() && same(last + 1).is_some() {
+        last += 1;
+    }
+    let rows: Vec<Row> = (top..=last).filter_map(same).collect();
+    // The header is the first row with a delimiter row of as many cells below it
+    let first = (top..last).find(|i| {
+        let (header, below) = (&rows[i - top], &rows[i + 1 - top]);
+        split_row(lines[*i]).is_some()
+            && split_row(lines[i + 1]).is_some()
+            && header.cells.len() == below.cells.len()
+            && !starts_block(lines[i + 1], below, header)
+            && delimiter_row(lines[i + 1], below).is_some()
+    })?;
+    // Rows indented 4 columns deeper than the header are code, and end the table
+    let header = &rows[first - top];
+    let last = (first + 2..=last)
+        .take_while(|i| !starts_block(lines[*i], &rows[i - top], header))
+        .last()
+        .unwrap_or(first + 1);
+    if line < first || line > last {
+        return None;
+    }
+    let aligns = delimiter_row(lines[first + 1], &rows[first + 1 - top])?;
+    Some(Table {
+        first,
+        last,
+        rows: rows[first - top..=last - top].to_vec(),
+        aligns,
+    })
+}
+
+/// Whether the line `text` (a row by its pipes) starts another block instead, which ends a
+/// table: a heading, a list item, a fence, or code indented 4 columns deeper than `table`.
+fn starts_block(text: &str, row: &Row, table: &Row) -> bool {
+    let rest = &text[row.start..];
+    crate::md_edit::is_heading(rest)
+        || rest.starts_with("```")
+        || rest.starts_with("~~~")
+        || crate::md_lists::starts_item(rest, false)
+        || row.indent >= table.indent + 4
+}
+
+/// The display width of `text` in a monospace font: East Asian wide characters and emoji take
+/// two columns, combining marks and zero-width characters none.
+fn width(text: &str) -> usize {
+    unicode_width::UnicodeWidthStr::width(text)
+}
+
+fn pad(content: &str, width: usize, align: Align) -> String {
+    let space = width.saturating_sub(self::width(content));
+    let (left, right) = match align {
+        Align::Right => (space, 0),
+        Align::Center => (space / 2, space - space / 2),
+        Align::None | Align::Left => (0, space),
+    };
+    format!("{}{content}{}", " ".repeat(left), " ".repeat(right))
+}
+
+fn delimiter_cell(width: usize, align: Align) -> String {
+    let width = width.max(3);
+    match align {
+        Align::None => "-".repeat(width),
+        Align::Left => format!(":{}", "-".repeat(width - 1)),
+        Align::Right => format!("{}:", "-".repeat(width - 1)),
+        Align::Center => format!(":{}:", "-".repeat(width - 2)),
+    }
+}
+
+/// The lines of `table` formatted, with an empty row added after line `after`.
+fn format(lines: &[&str], table: &Table, after: Option<usize>) -> Vec<String> {
+    let columns = table.aligns.len();
+    let mut rows: Vec<(String, Vec<String>)> = Vec::new();
+    for line in table.first..=table.last {
+        let row = table.row(line);
+        let text = lines[line];
+        let mut cells: Vec<String> = (0..row.cells.len())
+            .map(|k| {
+                let (start, end) = row.content(text, k);
+                text[start..end].to_string()
+            })
+            .collect();
+        // Short rows get empty cells; extra cells stay, GFM leaves them out of the table
+        if cells.len() < columns {
+            cells.resize(columns, String::new());
+        }
+        rows.push((text[..row.start].to_string(), cells));
+        if after == Some(line) {
+            let prefix = text[..row.start].to_string();
+            rows.push((prefix, vec![String::new(); columns]));
+        }
+    }
+    let delimiter_index = 1;
+    let count = rows.iter().map(|(_, cells)| cells.len()).max().unwrap_or(0);
+    let widths: Vec<usize> = (0..count)
+        .map(|k| {
+            rows.iter()
+                .enumerate()
+                .filter(|(i, _)| *i != delimiter_index)
+                .filter_map(|(_, (_, cells))| cells.get(k).map(|cell| width(cell)))
+                .max()
+                .unwrap_or(0)
+                .max(3)
+        })
+        .collect();
+    let align = |k: usize| table.aligns.get(k).copied().unwrap_or(Align::None);
+    rows.iter()
+        .enumerate()
+        .map(|(i, (prefix, cells))| {
+            let cells: Vec<String> = if i == delimiter_index {
+                (0..columns)
+                    .map(|k| delimiter_cell(widths[k], align(k)))
+                    .collect()
+            } else {
+                cells
+                    .iter()
+                    .enumerate()
+                    .map(|(k, cell)| pad(cell, widths[k], align(k)))
+                    .collect()
+            };
+            format!("{prefix}| {} |", cells.join(" | "))
+        })
+        .collect()
+}
+
+/// The changes that turn lines `first..=last` of `old` into `new` (which may have more lines,
+/// joined to the last one).
+fn changes(old: &[&str], first: usize, last: usize, new: &[String]) -> Vec<Change> {
+    let mut changes = Vec::new();
+    for line in first..=last {
+        let text = if line == last {
+            new[line - first..].join("\n")
+        } else {
+            new[line - first].clone()
+        };
+        if old[line] != text {
+            changes.push(Change {
+                line,
+                start: 0,
+                end: old[line].len(),
+                text,
+            });
+        }
+    }
+    changes.reverse();
+    changes
+}
+
+/// Where the cursor goes in cell `k` of `text` (a new line of the table): the cell's content
+/// selected, from anchor to cursor.
+fn select(text: &str, line: usize, k: usize) -> (Pos, Option<Pos>) {
+    let row = split_row(text).expect("formatted rows have pipes");
+    let (start, end) = row.content(text, k.min(row.cells.len() - 1));
+    if start == end {
+        ((line, end), None)
+    } else {
+        ((line, end), Some((line, start)))
+    }
+}
+
+/// Tab (`back` false) or Shift+Tab at `cursor`. `None`: not in a table row, and Tab does what
+/// it does elsewhere.
+pub fn tab(lines: &[&str], cursor: Pos, anchor: Option<Pos>, back: bool) -> Option<Outcome> {
+    let (l, at) = cursor;
+    if anchor.is_some_and(|anchor| anchor.0 != l) {
+        return None;
+    }
+    let table = find(lines, l)?;
+    // In front of the row: Tab indents it as elsewhere
+    if anchor.is_none() && at <= table.row(l).start {
+        return None;
+    }
+    let delimiter = table.delimiter();
+    let columns = table.aligns.len();
+    // The cells in order, without the delimiter row; short rows get their missing cells on the
+    // way, as `format` adds them
+    let cells: Vec<(usize, usize)> = (table.first..=table.last)
+        .filter(|line| *line != delimiter)
+        .flat_map(|line| (0..table.row(line).cells.len().max(columns)).map(move |k| (line, k)))
+        .collect();
+    let index = if l == delimiter {
+        // Between the header and the first body row
+        let header = table.row(table.first).cells.len();
+        if back { header } else { header - 1 }
+    } else {
+        let k = table.row(l).cell_at(at);
+        cells.iter().position(|cell| *cell == (l, k))?
+    };
+    let target = if back {
+        match index.checked_sub(1) {
+            Some(target) => Some(cells[target]),
+            // Nowhere to go: the key is used, the text stays
+            None => {
+                return Some(Outcome {
+                    changes: Vec::new(),
+                    cursor,
+                    anchor,
+                });
+            }
+        }
+    } else {
+        cells.get(index + 1).copied()
+    };
+    let (after, (line, k)) = match target {
+        Some(target) => (None, target),
+        None => (Some(table.last), (table.last + 1, 0)),
+    };
+    let new = format(lines, &table, after);
+    let (cursor, anchor) = select(&new[line - table.first], line, k);
+    Some(Outcome {
+        changes: changes(lines, table.first, table.last, &new),
+        cursor,
+        anchor,
+    })
+}
+
+/// Enter at `cursor` (no selection). `None`: not in a table row, or in front of it, and Enter
+/// is a plain new line.
+pub fn enter(lines: &[&str], cursor: Pos) -> Option<Outcome> {
+    let (l, at) = cursor;
+    let table = find(lines, l)?;
+    let row = table.row(l);
+    // In front of the row or after its last pipe: a plain new line, so a table can still be
+    // typed row by row
+    if at <= row.start || at > row.cells[row.cells.len() - 1].1 {
+        return None;
+    }
+    let text = lines[l];
+    let empty = (0..row.cells.len()).all(|k| {
+        let (start, end) = row.content(text, k);
+        start == end
+    });
+    if l == table.last && l > table.delimiter() && empty {
+        // An empty last row ends the table
+        // The quote markers and indentation stay: text typed next stays in the quote or item
+        let ended = text[..row.start].to_string();
+        return Some(Outcome {
+            cursor: (l, ended.len()),
+            changes: vec![Change {
+                line: l,
+                start: 0,
+                end: text.len(),
+                text: ended,
+            }],
+            anchor: None,
+        });
+    }
+    let after = l.max(table.delimiter());
+    let new = format(lines, &table, Some(after));
+    let (cursor, anchor) = select(&new[after + 1 - table.first], after + 1, 0);
+    Some(Outcome {
+        changes: changes(lines, table.first, table.last, &new),
+        cursor,
+        anchor,
+    })
+}
+
+/// "Format table": align the columns of the table at the cursor. The cursor and selection stay
+/// in their cells. `None`: not in a table.
+pub fn format_at(lines: &[&str], cursor: Pos, anchor: Option<Pos>) -> Option<Outcome> {
+    let table = find(lines, cursor.0)?;
+    let new = format(lines, &table, None);
+    let map = |(line, at): Pos| -> Pos {
+        if !(table.first..=table.last).contains(&line) {
+            return (line, at);
+        }
+        let row = table.row(line);
+        let text = &new[line - table.first];
+        // In front of the row the prefix stays as it is; after the last pipe goes to the end
+        if at <= row.start {
+            return (line, at);
+        }
+        if at > row.cells[row.cells.len() - 1].1 {
+            return (line, text.len());
+        }
+        let k = row.cell_at(at);
+        let (start, end) = row.content(lines[line], k);
+        let offset = at.clamp(start, end) - start;
+        let new_row = split_row(text).expect("formatted rows have pipes");
+        let (start, end) = new_row.content(text, k.min(new_row.cells.len() - 1));
+        let mut index = (start + offset).min(end);
+        while !text.is_char_boundary(index) {
+            index -= 1;
+        }
+        (line, index)
+    };
+    Some(Outcome {
+        changes: changes(lines, table.first, table.last, &new),
+        cursor: map(cursor),
+        anchor: anchor.map(map),
+    })
+}
+
+/// Whether the cursor's line of `editor` may be a table row: most lines are not, and need no
+/// look at the whole file.
+fn candidate<'buffer, E: Edit<'buffer>>(editor: &E) -> bool {
+    let cursor = editor.cursor();
+    editor.with_buffer(|buffer| {
+        buffer
+            .lines
+            .get(cursor.line)
+            .is_some_and(|line| line.text().contains('|'))
+    })
+}
+
+/// Tab or Shift+Tab in `editor`, as one undo step, a new row ending with `ending`. `false`: not in a table row, and Tab does
+/// what it does elsewhere.
+pub fn tab_key<'buffer, E: Edit<'buffer>>(editor: &mut E, back: bool, ending: LineEnding) -> bool {
+    candidate(editor)
+        && run(editor, ending, |lines, cursor, anchor| {
+            tab(lines, cursor, anchor, back)
+        })
+}
+
+/// Enter in `editor`, as one undo step. A selection in the row (a cell that Tab selected) stays
+/// as it is. `false`: not in a table row, or with a selection over several lines, and Enter
+/// does what it does elsewhere.
+pub fn enter_key<'buffer, E: Edit<'buffer>>(editor: &mut E, ending: LineEnding) -> bool {
+    editor
+        .selection_bounds()
+        .is_none_or(|(start, end)| start.line == end.line)
+        && candidate(editor)
+        && run(editor, ending, |lines, cursor, _| enter(lines, cursor))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Apply `edit` to `text`, where `|` is a pipe, `‸` marks the cursor and `^` the selection
+    /// anchor; the text after it with the cursor and anchor marked the same way, or "plain"
+    /// when the edit does not apply.
+    fn run_on(
+        text: &str,
+        edit: impl FnOnce(&[&str], Pos, Option<Pos>) -> Option<Outcome>,
+    ) -> String {
+        let mut cursor = None;
+        let mut anchor = None;
+        let mut lines: Vec<String> = Vec::new();
+        for (n, line) in text.split('\n').enumerate() {
+            let mut plain = String::new();
+            for c in line.chars() {
+                match c {
+                    '‸' => cursor = Some((n, plain.len())),
+                    '^' => anchor = Some((n, plain.len())),
+                    _ => plain.push(c),
+                }
+            }
+            lines.push(plain);
+        }
+        let refs: Vec<&str> = lines.iter().map(String::as_str).collect();
+        let Some(outcome) = edit(&refs, cursor.unwrap(), anchor) else {
+            return "plain".into();
+        };
+        for change in &outcome.changes {
+            lines[change.line].replace_range(change.start..change.end, &change.text);
+        }
+        let mut lines: Vec<String> = lines.join("\n").split('\n').map(str::to_string).collect();
+        let mut marks = vec![(outcome.cursor, '‸')];
+        if let Some(anchor) = outcome.anchor {
+            marks.push((anchor, '^'));
+        }
+        marks.sort();
+        for ((line, index), mark) in marks.into_iter().rev() {
+            lines[line].insert(index, mark);
+        }
+        lines.join("\n")
+    }
+
+    fn tab_on(text: &str) -> String {
+        run_on(text, |lines, cursor, anchor| {
+            tab(lines, cursor, anchor, false)
+        })
+    }
+
+    fn shift_tab_on(text: &str) -> String {
+        run_on(text, |lines, cursor, anchor| {
+            tab(lines, cursor, anchor, true)
+        })
+    }
+
+    fn enter_on(text: &str) -> String {
+        run_on(text, |lines, cursor, _| enter(lines, cursor))
+    }
+
+    fn format_on(text: &str) -> String {
+        run_on(text, format_at)
+    }
+
+    const TABLE: &str = "| Name | Qty |\n| --- | ---: |\n| apple | 3 |\n| fig | 12 |";
+
+    #[test]
+    fn splits_rows_into_cells() {
+        let cells = |text: &str| -> Vec<String> {
+            let row = split_row(text).unwrap();
+            (0..row.cells.len())
+                .map(|k| {
+                    let (s, e) = row.content(text, k);
+                    text[s..e].to_string()
+                })
+                .collect()
+        };
+        assert_eq!(cells("| a | b |"), ["a", "b"]);
+        assert_eq!(cells("a | b"), ["a", "b"]);
+        assert_eq!(cells("|a||c|"), ["a", "", "c"]);
+        assert_eq!(cells("| a \\| b | c |"), ["a \\| b", "c"]);
+        // GFM splits at pipes in code spans too, unless they are escaped
+        assert_eq!(cells("| `a|b` | c |"), ["`a", "b`", "c"]);
+        assert_eq!(cells("| `a\\|b` | c |"), ["`a\\|b`", "c"]);
+        assert_eq!(cells("> | a | b |"), ["a", "b"]);
+        assert!(split_row("no pipes").is_none());
+        assert!(split_row("a \\| b").is_none());
+    }
+
+    #[test]
+    fn finds_tables_only_with_a_delimiter_row() {
+        let lines = ["text", "| a | b |", "|:-|-:|", "| 1 | 2 |", "", "| x |"];
+        assert!(find(&lines, 0).is_none());
+        let table = find(&lines, 3).unwrap();
+        assert_eq!((table.first, table.last), (1, 3));
+        assert_eq!(table.aligns, [Align::Left, Align::Right]);
+        assert!(find(&lines, 5).is_none());
+        // Header and delimiter differ in cells: no table
+        assert!(find(&["| a | b |", "| --- |", "| 1 | 2 |"], 2).is_none());
+        // In a code block: no table
+        assert!(find(&["```", "| a |", "| - |", "```"], 1).is_none());
+        // As in GFM, a line without a pipe is a row of one cell, up to a blank line, a
+        // thematic break or another block
+        let lines = [
+            "| a | b |",
+            "|---|---|",
+            "| 1 | 2 |",
+            "plain row",
+            "| 3 | 4 |",
+            "---",
+            "| x |",
+        ];
+        let table = find(&lines, 2).unwrap();
+        assert_eq!((table.first, table.last), (0, 4));
+        assert_eq!(find(&lines, 4).unwrap().last, 4);
+        let lines = ["| a | b |", "|---|---|", "| 1 | 2 |", "- item", "| 3 | 4 |"];
+        assert_eq!(find(&lines, 2).unwrap().last, 2);
+    }
+
+    #[test]
+    fn format_aligns_columns() {
+        assert_eq!(
+            format_on(&format!("‸{TABLE}")),
+            "‸| Name  | Qty |\n| ----- | --: |\n| apple |   3 |\n| fig   |  12 |"
+        );
+        assert_eq!(
+            format_on("|a|b|c|\n|:-:|:--|--|\n|xxxxx|y|‸z|"),
+            "|   a   | b   | c   |\n| :---: | :-- | --- |\n| xxxxx | y   | ‸z   |"
+        );
+    }
+
+    #[test]
+    fn format_fills_ragged_rows_and_keeps_extra_cells() {
+        assert_eq!(
+            format_on("| a | b |\n|---|---|\n| 1 |\n| 1 | 2 | 3 |‸"),
+            "| a   | b   |\n| --- | --- |\n| 1   |     |\n| 1   | 2   | 3   |‸"
+        );
+    }
+
+    #[test]
+    fn format_keeps_escaped_pipes_quotes_and_unicode() {
+        // Wide characters take two columns, combining marks none
+        assert_eq!(width("日本"), 4);
+        assert_eq!(width("e\u{301}"), 1);
+        assert_eq!(
+            format_on("> | a \\| b | c |\n> |-|-|\n> | äöü‸ß | 日本 |"),
+            "> | a \\| b | c    |\n> | ------ | ---- |\n> | äöü‸ß   | 日本 |"
+        );
+    }
+
+    #[test]
+    fn format_keeps_the_cursor_and_selection_in_their_cells() {
+        assert_eq!(
+            format_on("|a|b|\n|-|-|\n|^lo‸ng|x|"),
+            "| a    | b   |\n| ---- | --- |\n| ^lo‸ng | x   |"
+        );
+        // In front of the row and after its last pipe the cursor stays there
+        assert_eq!(format_on("|a|\n|-|\n|b|‸"), "| a   |\n| --- |\n| b   |‸");
+        assert_eq!(format_on("> ‸|a|\n> |-|"), "> ‸| a   |\n> | --- |");
+        // Already formatted: nothing changes
+        let formatted = "| a   | b   |\n| --- | --- |\n| 1‸   | 2   |";
+        assert_eq!(format_on(formatted), formatted);
+    }
+
+    #[test]
+    fn tab_selects_the_next_cell() {
+        assert_eq!(
+            tab_on("| Name‸ | Qty |\n| --- | ---: |\n| apple | 3 |"),
+            "| Name  | ^Qty‸ |\n| ----- | --: |\n| apple |   3 |"
+        );
+        // From the last cell of a row to the first body cell, past the delimiter row
+        assert_eq!(
+            tab_on("| a | b‸ |\n|---|---|\n| 1 | 2 |"),
+            "| a   | b   |\n| --- | --- |\n| ^1‸   | 2   |"
+        );
+        // A selected cell moves on to the next
+        assert_eq!(
+            tab_on("| a   | b   |\n| --- | --- |\n| ^1‸   | 2   |"),
+            "| a   | b   |\n| --- | --- |\n| 1   | ^2‸   |"
+        );
+        // An empty cell: the cursor goes into it
+        assert_eq!(
+            tab_on("| a   | b   |\n| --- | --- |\n| 1‸   |     |"),
+            "| a   | b   |\n| --- | --- |\n| 1   | ‸    |"
+        );
+    }
+
+    #[test]
+    fn tab_in_the_last_cell_adds_a_row() {
+        assert_eq!(
+            tab_on("| a | b |\n|---|---|\n| 1 | 2‸ |\n\ntext"),
+            "| a   | b   |\n| --- | --- |\n| 1   | 2   |\n| ‸    |     |\n\ntext"
+        );
+        assert_eq!(
+            tab_on("> | a |\n> |---|\n> | 1‸ |"),
+            "> | a   |\n> | --- |\n> | 1   |\n> | ‸    |"
+        );
+    }
+
+    #[test]
+    fn shift_tab_selects_the_previous_cell() {
+        assert_eq!(
+            shift_tab_on("| a | b |\n|---|---|\n| ‸1 | 2 |"),
+            "| a   | ^b‸   |\n| --- | --- |\n| 1   | 2   |"
+        );
+        // In the first cell: the key is used, nothing moves
+        assert_eq!(
+            shift_tab_on("| ‸a | b |\n|---|---|"),
+            "| ‸a | b |\n|---|---|"
+        );
+    }
+
+    #[test]
+    fn tab_reaches_the_cells_short_rows_get() {
+        assert_eq!(
+            tab_on("| a | b |\n|---|---|\n| 1‸ |\n| 2 | 3 |"),
+            "| a   | b   |\n| --- | --- |\n| 1   | ‸    |\n| 2   | 3   |"
+        );
+    }
+
+    #[test]
+    fn rows_end_where_another_block_starts() {
+        let lines = [
+            "| a |",
+            "|---|",
+            "| 1 |",
+            "# Notes | x",
+            "- item | x",
+            "1. one | x",
+        ];
+        for line in 3..lines.len() {
+            assert!(find(&lines, line).is_none(), "{}", lines[line]);
+        }
+        assert_eq!(find(&lines, 2).unwrap().last, 2);
+        // Indented 4 columns deeper: code, not a row
+        let lines = ["| a |", "|---|", "    | 1 |"];
+        assert_eq!(find(&lines, 0).unwrap().last, 1);
+        // A table in a list item keeps its indented rows
+        let lines = ["- item", "", "  | a |", "  |---|", "  | 1 |"];
+        assert_eq!(find(&lines, 4).unwrap().first, 2);
+    }
+
+    #[test]
+    fn tab_outside_tables_is_plain() {
+        assert_eq!(tab_on("text‸"), "plain");
+        assert_eq!(tab_on("a | b‸"), "plain");
+        assert_eq!(tab_on("```\n| a |\n| - |\n| b‸ |\n```"), "plain");
+        // A selection over several lines
+        assert_eq!(tab_on("| ^a |\n| - |\n| b‸ |"), "plain");
+        // In front of the row: Tab indents it
+        assert_eq!(tab_on("‸| a |\n| - |"), "plain");
+        assert_eq!(tab_on("  ‸| a |\n  | - |"), "plain");
+    }
+
+    #[test]
+    fn enter_adds_a_row_below() {
+        assert_eq!(
+            enter_on("| a | b |\n|---|---|\n| 1‸ | 2 |\n| 3 | 4 |"),
+            "| a   | b   |\n| --- | --- |\n| 1   | 2   |\n| ‸    |     |\n| 3   | 4   |"
+        );
+        // On the header: below the delimiter row
+        assert_eq!(
+            enter_on("| a‸ |\n|---|\n| 1 |"),
+            "| a   |\n| --- |\n| ‸    |\n| 1   |"
+        );
+        // In front of the row or after its last pipe: a plain new line
+        assert_eq!(enter_on("‸| a |\n|---|"), "plain");
+        assert_eq!(enter_on("| a |\n|---|‸"), "plain");
+        assert_eq!(enter_on("| a |\n|---|\n| 1 |‸"), "plain");
+        // Without a trailing pipe the end of the line is in the last cell
+        assert_eq!(
+            enter_on("a | b\n--|--\n1 | 2‸"),
+            "| a   | b   |\n| --- | --- |\n| 1   | 2   |\n| ‸    |     |"
+        );
+    }
+
+    #[test]
+    fn enter_on_an_empty_last_row_ends_the_table() {
+        assert_eq!(
+            enter_on("| a |\n|---|\n| 1 |\n|  ‸ |"),
+            "| a |\n|---|\n| 1 |\n‸"
+        );
+        assert_eq!(
+            enter_on("> | a |\n> |---|\n> |  ‸ |"),
+            "> | a |\n> |---|\n> ‸"
+        );
+        // In a list item the indentation stays
+        assert_eq!(
+            enter_on("- item\n\n  | a |\n  |---|\n  |  ‸ |"),
+            "- item\n\n  | a |\n  |---|\n  ‸"
+        );
+    }
+
+    mod editor {
+        use super::super::*;
+        use crate::tab::editor_text;
+        use cosmic_text::{
+            Attrs, Buffer, Cursor, Metrics, Shaping, SyntaxEditor, SyntaxSystem, ViEditor,
+        };
+        use std::sync::Arc;
+
+        fn editor(text: &str) -> ViEditor<'static, 'static> {
+            let system = crate::SYNTAX_SYSTEM.get_or_init(SyntaxSystem::new);
+            let mut buffer = Buffer::new_empty(Metrics::new(14.0, 20.0));
+            buffer.set_text(text, &Attrs::new(), Shaping::Advanced, None);
+            let theme = system.theme_set.themes.keys().next().unwrap();
+            ViEditor::new(SyntaxEditor::new(Arc::new(buffer), system, theme).unwrap())
+        }
+
+        #[test]
+        fn crlf_tab_adds_a_row_as_one_undo_step() {
+            let text = "| a |\r\n|---|\r\n| 1 |\r\n";
+            let mut editor = editor(text);
+            editor.set_cursor(Cursor::new(2, 3));
+            assert!(tab_key(&mut editor, false, LineEnding::CrLf));
+            assert_eq!(
+                editor_text(&editor),
+                "| a   |\r\n| --- |\r\n| 1   |\r\n|     |\r\n"
+            );
+            assert_eq!(editor.cursor(), Cursor::new(3, 2));
+            editor.undo();
+            assert_eq!(editor_text(&editor), text);
+        }
+
+        #[test]
+        fn enter_on_a_selected_cell_adds_a_row() {
+            let mut editor = editor("| a | b |\n|---|---|\n| 1 | 2 |");
+            editor.set_cursor(Cursor::new(2, 3));
+            editor.set_selection(cosmic_text::Selection::Normal(Cursor::new(2, 2)));
+            assert!(enter_key(&mut editor, LineEnding::Lf));
+            assert_eq!(
+                editor_text(&editor),
+                "| a   | b   |\n| --- | --- |\n| 1   | 2   |\n|     |     |"
+            );
+            assert_eq!(editor.selection_bounds(), None);
+            // Over several lines: plain
+            editor.set_cursor(Cursor::new(3, 2));
+            editor.set_selection(cosmic_text::Selection::Normal(Cursor::new(2, 2)));
+            assert!(!enter_key(&mut editor, LineEnding::Lf));
+        }
+
+        #[test]
+        fn crlf_enter_adds_a_row() {
+            let mut editor = editor("| a |\r\n|---|\r\n");
+            editor.set_cursor(Cursor::new(0, 3));
+            assert!(enter_key(&mut editor, LineEnding::CrLf));
+            assert_eq!(editor_text(&editor), "| a   |\r\n| --- |\r\n|     |\r\n");
+        }
+    }
+}

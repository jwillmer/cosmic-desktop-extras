+
+    mod editor {
+        use super::super::*;
+        use crate::tab::editor_text;
+        use cosmic_text::{
+            Attrs, Buffer, Cursor, Metrics, Selection, Shaping, SyntaxEditor, SyntaxSystem,
+            ViEditor,
+        };
+        use std::sync::Arc;
+
+        fn editor(text: &str) -> ViEditor<'static, 'static> {
+            let system = crate::SYNTAX_SYSTEM.get_or_init(SyntaxSystem::new);
+            let mut buffer = Buffer::new_empty(Metrics::new(14.0, 20.0));
+            buffer.set_text(text, &Attrs::new(), Shaping::Advanced, None);
+            let theme = system.theme_set.themes.keys().next().unwrap();
+            ViEditor::new(SyntaxEditor::new(Arc::new(buffer), system, theme).unwrap())
+        }
+
+        #[test]
+        fn crlf_enter_is_one_undo_step() {
+            let text = "1. a\r\n2. b\r\n";
+            let mut editor = editor(text);
+            editor.set_cursor(Cursor::new(0, 4));
+            assert!(enter_key(&mut editor, LineEnding::CrLf));
+            assert_eq!(editor_text(&editor), "1. a\r\n2. \r\n3. b\r\n");
+            assert_eq!(editor.cursor(), Cursor::new(1, 3));
+            editor.undo();
+            assert_eq!(editor_text(&editor), text);
+        }
+
+        #[test]
+        fn crlf_tab_and_task_keep_line_endings() {
+            let mut editor = editor("- a\r\n- b\r\n");
+            editor.set_cursor(Cursor::new(1, 3));
+            assert!(tab_key(&mut editor, false));
+            assert_eq!(editor_text(&editor), "- a\r\n  - b\r\n");
+            crate::md_format::apply(&mut editor, crate::md_format::Format::ToggleTask);
+            assert_eq!(editor_text(&editor), "- a\r\n  - [ ] b\r\n");
+            assert_eq!(editor.cursor(), Cursor::new(1, 9));
+            editor.undo();
+            assert_eq!(editor_text(&editor), "- a\r\n  - b\r\n");
+        }
+
+        #[test]
+        fn tab_unfolds_the_children_it_moves() {
+            use crate::folding::{FoldKind, fold, is_hidden};
+            let mut editor = editor("- a\n- b\n  - c\n");
+            editor.with_buffer_mut(|buffer| fold(buffer, 1, FoldKind::Indent));
+            assert!(editor.with_buffer(|buffer| is_hidden(&buffer.lines[2])));
+            editor.set_cursor(Cursor::new(1, 3));
+            assert!(tab_key(&mut editor, false));
+            assert_eq!(editor_text(&editor), "- a\n  - b\n    - c\n");
+            assert!(!editor.with_buffer(|buffer| is_hidden(&buffer.lines[2])));
+        }
+
+        #[test]
+        fn backspace_is_one_undo_step() {
+            let text = "- a\n  - [ ] b\n";
+            let mut editor = editor(text);
+            editor.set_cursor(Cursor::new(1, 8));
+            assert!(backspace_key(&mut editor));
+            assert_eq!(editor_text(&editor), "- a\n  - b\n");
+            assert!(backspace_key(&mut editor));
+            assert_eq!(editor_text(&editor), "- a\n- b\n");
+            assert_eq!(editor.cursor(), Cursor::new(1, 2));
+            // Not right after a marker: plain
+            editor.set_cursor(Cursor::new(1, 3));
+            assert!(!backspace_key(&mut editor));
+            editor.undo();
+            assert_eq!(editor_text(&editor), "- a\n  - b\n");
+        }
+
+        #[test]
+        fn enter_in_item_code_without_auto_indent() {
+            let mut editor = editor("- a\n  ```\n  ```\n");
+            editor.set_auto_indent(false);
+            editor.set_cursor(Cursor::new(1, 5));
+            assert!(enter_key(&mut editor, LineEnding::Lf));
+            assert_eq!(editor_text(&editor), "- a\n  ```\n  \n  ```\n");
+            assert_eq!(editor.cursor(), Cursor::new(2, 2));
+            // With automatic indentation the editor's own Enter keeps the indentation
+            editor.set_auto_indent(true);
+            assert!(!enter_key(&mut editor, LineEnding::Lf));
+        }
+
+        #[test]
+        fn enter_with_a_selection_is_plain() {
+            let mut editor = editor("- a");
+            editor.set_cursor(Cursor::new(0, 3));
+            editor.set_selection(Selection::Normal(Cursor::new(0, 2)));
+            assert!(!enter_key(&mut editor, LineEnding::Lf));
+        }
+    }
+}

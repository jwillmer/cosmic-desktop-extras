+            "- a\n  ```\n      x\n  |\n  ```"
+        );
+        assert_eq!(
+            code_enter_on("- a\n  ```\n      x|\n  ```", true),
+            "- a\n  ```\n      x\n      |\n  ```"
+        );
+        assert_eq!(
+            code_enter_on("- a\n  ```\n  ```|", false),
+            "- a\n  ```\n  ```\n  |"
+        );
+        // The rest of the line moves along
+        assert_eq!(
+            code_enter_on("- a\n  ```\n  x|y\n  ```", false),

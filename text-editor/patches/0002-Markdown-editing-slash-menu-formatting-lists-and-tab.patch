+/// Whether the menu may open at all: the setting is on, the file is Markdown and Vim bindings
+/// (which own "/" for search) are off.
+pub fn enabled(setting: bool, markdown: bool, vim_bindings: bool) -> bool {
+    setting && markdown && !vim_bindings
+}
+
+/// Whether a "/" at byte `start` of line `line` is Markdown text, where the menu may open: not
+/// in front matter, a code block (fenced or indented) or an HTML block or comment. `lines` are
+/// the lines of the file from the first; only those up to `line` are parsed (past it only to
+/// find the end of front matter).
+pub fn markdown_allows<'a>(
+    lines: impl IntoIterator<Item = &'a str>,
+    line: usize,
+    start: usize,
+) -> bool {
+    let lines: Vec<&str> = lines.into_iter().collect();
+    markdown_allows_all(&lines, &[(line, start)])[0]
+}
+
+/// `markdown_allows` for several positions (line, byte) at once, with one parse of the lines up
+/// to the last of them.
+pub fn markdown_allows_all(lines: &[&str], positions: &[(usize, usize)]) -> Vec<bool> {
+    // Front matter, up to and with its closing line, is no Markdown text
+    let skip = front_matter_end(lines).map_or(0, |end| end + 1);
+    let inner: Vec<(usize, usize, usize)> = positions
+        .iter()
+        .enumerate()
+        .filter(|(_, (line, _))| *line >= skip && *line < lines.len().max(1))
+        .map(|(i, (line, start))| (i, line - skip, *start))
+        .collect();
+    let mut allowed = vec![false; positions.len()];
+    let Some(last) = inner.iter().map(|(_, line, _)| *line).max() else {
+        return allowed;
+    };
+    let rest = &lines[skip.min(lines.len())..];
+    let rest = &rest[..(last + 1).min(rest.len())];
+    if needs_parse(rest) {
+        parse_allows_all(rest, &inner, &mut allowed);
+    } else {
+        for (i, _, _) in inner {
+            allowed[i] = true;
+        }
+    }
+    allowed
+}
+
+/// The closing line of front matter: "---" (YAML) or "+++" (TOML) on the first line, up to its
+/// closing line. As the preview reads it, the first line inside is neither blank nor the closing
+/// line; without one, "---" is a divider.
+pub fn front_matter_end(lines: &[&str]) -> Option<usize> {
+    let close: &[&str] = match lines.first().map(|first| first.trim_end()) {
+        Some("---") => &["---", "..."],
+        Some("+++") => &["+++"],
+        _ => return None,
+    };
+    let second = lines.get(1)?;
+    if second.trim().is_empty() || close.contains(&second.trim_end()) {
+        return None;
+    }
+    (2..lines.len()).find(|i| close.contains(&lines[*i].trim_end()))
+}
+
+/// Whether byte `start` of line `line` of `lines` is outside code blocks, HTML blocks and HTML
+/// comments. Only the lines up to `line` are read: what follows cannot open a block there, and a
+/// comment open at the cursor stays open whether it closes below or never.
+#[cfg(test)]
+fn markdown_text_at<'a>(
+    lines: impl IntoIterator<Item = &'a str>,
+    line: usize,
+    start: usize,
+) -> bool {
+    let lines: Vec<&str> = lines.into_iter().take(line + 1).collect();
+    !needs_parse(&lines) || parse_allows(&lines, line, start)
+}
+
+/// Whether `lines` may hold something that blocks the menu: a fence ("```", "~~~"), HTML ("<")
+/// or code indented by four spaces or a tab (also after quote and list markers). Without any,
+/// the parse is skipped.
+fn needs_parse(lines: &[&str]) -> bool {
+    lines.iter().any(|line| {
+        let lead_len = line
+            .find(|c: char| {
+                !matches!(
+                    c,
+                    ' ' | '\t' | '>' | '-' | '*' | '+' | '.' | ')' | '0'..='9'
+                )
+            })
+            .unwrap_or(line.len());
+        let lead = &line[..lead_len];
+        lead.contains('\t')
+            || lead.contains("    ")
+            || line.contains('<')
+            || line.contains("```")
+            || line.contains("~~~")
+    })
+}
+
+/// The full check of `markdown_text_at`, parsing `lines` with pulldown-cmark.
+#[cfg(test)]
+fn parse_allows(lines: &[&str], line: usize, start: usize) -> bool {
+    let mut allowed = [false];
+    parse_allows_all(lines, &[(0, line, start)], &mut allowed);
+    allowed[0]
+}
+
+/// The full check for `positions` (index into `allowed`, line, byte), parsing `lines` with
+/// pulldown-cmark once and walking its events once.
+fn parse_allows_all(lines: &[&str], positions: &[(usize, usize, usize)], allowed: &mut [bool]) {
+    let mut text = String::new();
+    let mut line_starts = Vec::with_capacity(lines.len());
+    for next in lines {
+        line_starts.push(text.len());
+        text.push_str(next);
+        text.push('\n');
+    }
+    // (offset in `text`, index into `allowed`), in the order of the text
+    let mut offsets: Vec<(usize, usize)> = positions
+        .iter()
+        .map(|(i, line, start)| {
+            (
+                line_starts.get(*line).map_or(text.len(), |at| at + start),
+                *i,
+            )
+        })
+        .collect();
+    offsets.sort_unstable();
+    let events: Vec<_> = Parser::new_ext(&text, crate::markdown::PARSE_OPTIONS)
+        .into_offset_iter()
+        .collect();
+    // Code blocks, HTML blocks and inline HTML block the positions in them
+    let mut blocked = vec![false; allowed.len()];
+    for (event, range) in &events {
+        if matches!(
+            event,
+            Event::Start(Tag::CodeBlock(_) | Tag::HtmlBlock) | Event::InlineHtml(_)
+        ) {
+            let from = offsets.partition_point(|(offset, _)| *offset < range.start);
+            for (_, i) in offsets[from..]
+                .iter()
+                .take_while(|(offset, _)| *offset < range.end)
+            {
+                blocked[*i] = true;
+            }
+        }
+    }
+    // The source of the paragraph's text before the position: an unclosed "<!--" in it is a
+    // comment that runs on past it. The events up to a position are read once; an event that
+    // ends past it (and every one after it, up to the next position) counts for the next.
+    let mut paragraph = String::new();
+    // The end of the source last added to `paragraph`
+    let mut pushed_to = 0;
+    let mut next = 0;
+    for (offset, i) in offsets {
+        while let Some((event, range)) = events.get(next) {
+            if range.start > offset {
+                break;
+            }
+            match event {
+                // A new block (or its end) starts over; inline tags stay in the paragraph
+                Event::Start(tag)
+                    if !matches!(
+                        tag,
+                        Tag::Emphasis | Tag::Strong | Tag::Strikethrough | Tag::Link { .. }
+                    ) =>
+                {
+                    paragraph.clear();
+                }
+                Event::End(end)
+                    if !matches!(
+                        end,
+                        TagEnd::Emphasis | TagEnd::Strong | TagEnd::Strikethrough | TagEnd::Link
+                    ) =>
+                {
+                    if range.end > offset {
+                        break;
+                    }
+                    paragraph.clear();
+                }
+                Event::Text(_) | Event::SoftBreak | Event::HardBreak => {
+                    if range.end > offset {
+                        break;
+                    }
+                    // An escaped character's text leaves out its backslash: keep it, so an
+                    // escaped "<!--" stays text
+                    let start = match range.start.checked_sub(1) {
+                        Some(at) if at >= pushed_to && text.as_bytes()[at] == b'\\' => at,
+                        _ => range.start,
+                    };
+                    pushed_to = range.end;
+                    paragraph.push_str(&text[start..range.end]);
+                }
+                _ => (),
+            }
+            next += 1;
+        }
+        let comment = match (rfind_unescaped(&paragraph, "<!--"), paragraph.rfind("-->")) {
+            (Some(open), close) => !close.is_some_and(|close| close > open),
+            (None, _) => false,
+        };
+        allowed[i] = !blocked[i] && !comment;
+    }
+}
+
+/// The last `pat` in `text` not escaped by a backslash (`\<!--` is text, not a comment).
+fn rfind_unescaped(text: &str, pat: &str) -> Option<usize> {
+    text.rmatch_indices(pat)
+        .map(|(at, _)| at)
+        .find(|&at| text[..at].bytes().rev().take_while(|&b| b == b'\\').count() % 2 == 0)
+}
+
+/// A "/query" on a line: the menu belongs to it while it lasts.
+#[derive(Debug, PartialEq)]
+pub struct Trigger<'a> {
+    /// Byte offset of the "/" in the line.
+    pub start: usize,
+    /// The text typed after the "/", up to the cursor.
+    pub query: &'a str,
+}
+
+/// The "/query" that ends at byte `cursor` of `line`: only whitespace before the "/", no
+/// whitespace or "/" in the query.
+pub fn trigger(line: &str, cursor: usize) -> Option<Trigger<'_>> {
+    let before = line.get(..cursor)?;
+    let start = before.rfind('/')?;
+    let query = &before[start + 1..];
+    (before[..start].chars().all(char::is_whitespace) && !query.contains(char::is_whitespace))
+        .then_some(Trigger { start, query })
+}
+
+/// The items matching `query`: a word of the label (English or translated) or a keyword starts
+/// with it (ignoring case). Labels starting with the query come first ("/li" offers Link before
+/// the lists).
+pub fn filter(query: &str) -> Vec<&'static Item> {
+    let query = query.to_lowercase();
+    let mut items: Vec<_> = ITEMS
+        .iter()
+        .zip(labels())
+        .filter_map(|(item, (_, label))| {
+            let name = item.name.to_lowercase();
+            let matches = name
+                .split(' ')
+                .chain(label.split_whitespace())
+                .chain(item.keywords.iter().copied())
+                .any(|word| word.starts_with(&query));
+            matches.then(|| {
+                let first = name.starts_with(&query) || label.starts_with(&query);
+                (!first, item)
+            })
+        })
+        .collect();
+    // Stable: the order of `ITEMS` within each group
+    items.sort_by_key(|(later, _)| *later);
+    items.into_iter().map(|(_, item)| item).collect()
+}
+
+/// A position relative to the edited line: (lines below it, byte column).
+pub type RelPos = (usize, usize);
+
+/// Replace bytes `start..end` of the edited line with `text`, then put the cursor (and the
+/// selection anchor, if any) at the given positions.
+#[derive(Debug, PartialEq)]
+pub struct Edit {
+    pub start: usize,
+    pub end: usize,
+    pub text: String,
+    pub cursor: RelPos,
+    pub anchor: Option<RelPos>,
+}
+
+/// The edit that picks `item` for `trigger` on `line`, with the cursor at byte `cursor`.
+/// Further lines of a multi-line construct get the indentation before the "/". A block gets a
+/// blank line before it when `above` (the line above, if any) has text, and after it when
+/// `below` or the rest of the line has text, so that it does not run into a paragraph ("---"
+/// under text makes it a heading, a line under a table joins it).
+pub fn edit(
+    line: &str,
+    trigger: &Trigger,
+    cursor: usize,
+    item: &Item,
+    above: Option<&str>,
+    below: Option<&str>,
+) -> Edit {
+    let indent = &line[..trigger.start];
+    let has_text = |line: Option<&str>| line.is_some_and(|line| !line.trim().is_empty());
+    let rest = line.get(cursor..).unwrap_or_default();
+    let blank_before = item.block && has_text(above);
+    let blank_after = item.block && (has_text(below) || has_text(Some(rest)));
+    // "---" on the first line could start front matter with a "---" further down: "***" is the
+    // same divider
+    let item_text = if item.text == "---" && above.is_none() {
+        "***"
+    } else {
+        item.text
+    };
+    let mut text = item_text.replace('\n', &format!("\n{indent}"));
+    let mut start = trigger.start;
+    if blank_before {
+        // The "/" line stays empty, without the indentation
+        text = format!("\n{indent}{text}");
+        start = 0;
+    }
+    if blank_after {
+        // Before the line below; text after the cursor moves to a line of its own below that
+        text.push('\n');
+        if has_text(Some(rest)) {
+            text.push('\n');
+            text.push_str(indent);
+        }
+    }
+    let rows = usize::from(blank_before);
+    // Offsets in `item.text` to positions after the insertion
+    let pos = |offset: usize| -> RelPos {
+        let head = &item.text[..offset];
+        match head.rfind('\n') {
+            None => (rows, trigger.start + offset),
+            Some(nl) => (
+                rows + head.matches('\n').count(),
+                indent.len() + offset - nl - 1,
+            ),
+        }
+    };
+    Edit {
+        start,
+        end: cursor,
+        text,
+        cursor: pos(item.cursor),
+        anchor: item.anchor.map(pos),
+    }
+}
+
+/// The open menu: where its "/" is and which item is highlighted.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Menu {
+    pub line: usize,
+    pub start: usize,
+    pub selected: usize,
+}
+
+impl Menu {
+    /// Move the highlight within `count` items, wrapping around.
+    pub fn step(&mut self, down: bool, count: usize) {
+        if count == 0 {
+            return;
+        }
+        self.selected = if down {
+            (self.selected + 1) % count
+        } else {
+            (self.selected + count - 1) % count
+        };
+    }
+}
+
+/// The matching items while the menu at `menu` is still valid for the cursor at (`line`,
+/// `cursor`) on `text`; `None` closes it (cursor moved away, "/" gone, whitespace typed, nothing
+/// matches).
+#[cfg(test)]
+pub fn still_open(
+    menu: &Menu,
+    line: usize,
+    text: &str,
+    cursor: usize,
+) -> Option<Vec<&'static Item>> {
+    let items = filter(open_query(menu, line, text, cursor)?);
+    (!items.is_empty()).then_some(items)
+}
+
+/// The query of the menu at `menu` while its "/query" still holds for the cursor at (`line`,
+/// `cursor`) on `text`: the part of `still_open` before filtering.
+pub fn open_query<'a>(menu: &Menu, line: usize, text: &'a str, cursor: usize) -> Option<&'a str> {
+    if line != menu.line {
+        return None;
+    }
+    let trigger = trigger(text, cursor)?;
+    (trigger.start == menu.start).then_some(trigger.query)
+}

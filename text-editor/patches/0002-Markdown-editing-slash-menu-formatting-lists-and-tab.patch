+    #[test]
+    fn unicode_words() {
+        assert_eq!(run("über grö|ße", Bold), "über **grö|ße**");
+        assert_eq!(run("日本|語 text", Italic), "*日本|語* text");
+        assert_eq!(run("^Ärger| ok", Italic), "*^Ärger|* ok");
+        assert_eq!(run("**grö|ße**", Bold), "grö|ße");
+    }
+
+    #[test]
+    fn only_markdown_with_source_shown() {
+        assert!(enabled(Some(ViewMode::Source)));
+        assert!(enabled(Some(ViewMode::Split)));
+        assert!(!enabled(Some(ViewMode::Preview)));
+        assert!(!enabled(None));
+    }
+
+    #[test]
+    fn content_start_skips_block_markers() {
+        assert_eq!(content_start("text"), 0);
+        assert_eq!(content_start("  - item"), 4);
+        assert_eq!(content_start("12. item"), 4);
+        assert_eq!(content_start("> > ### h"), 8);
+        assert_eq!(content_start("- [x] done"), 6);
+        assert_eq!(content_start("**bold**"), 0);
+        assert_eq!(content_start("#tag"), 0);
+    }
+
+    use Style::{Code, Strikethrough};
+
+    fn link_run(text: &str) -> String {
+        run_with(text, link)
+    }
+
+    fn paste_run(text: &str, value: &str) -> String {
+        run_with(text, |lines, cursor, anchor| {
+            paste_link(lines, cursor, anchor, value)
+        })
+    }
+
+    fn heading_run(text: &str, level: usize) -> String {
+        run_with(text, |lines, cursor, anchor| {
+            heading(lines, cursor, anchor, level)
+        })
+    }
+
+    #[test]
+    fn strikethrough_toggles_like_bold() {
+        assert_eq!(run("a ^word| b", Strikethrough), "a ~~^word|~~ b");
+        assert_eq!(run("a ~~^word|~~ b", Strikethrough), "a ^word| b");
+        assert_eq!(run("a ^~~word~~| b", Strikethrough), "a ^word| b");
+        assert_eq!(run("one wo|rd", Strikethrough), "one ~~wo|rd~~");
+        assert_eq!(run("one ~~wo|rd~~", Strikethrough), "one wo|rd");
+        assert_eq!(run("one | two", Strikethrough), "one ~~|~~ two");
+        assert_eq!(run("one ~~|~~ two", Strikethrough), "one | two");
+        // Stars stay
+        assert_eq!(run("**wo|rd**", Strikethrough), "**~~wo|rd~~**");
+        assert_eq!(run("a `co|de` b", Strikethrough), "a `co|de` b");
+    }
+
+    #[test]
+    fn inline_code_toggles_and_unwraps_spans() {
+        assert_eq!(run("a ^two words| b", Code), "a `^two words|` b");
+        assert_eq!(run("a `^two words|` b", Code), "a ^two words| b");
+        assert_eq!(run("a ^`two words`| b", Code), "a ^two words| b");
+        assert_eq!(run("call fo|o now", Code), "call `fo|o` now");
+        assert_eq!(run("one | two", Code), "one `|` two");
+        assert_eq!(run("one `|` two", Code), "one | two");
+        // Anywhere in a code span: the span comes off
+        assert_eq!(run("a `x + |y` b", Code), "a x + |y b");
+        assert_eq!(run("a `code`| b", Code), "a code| b");
+        assert_eq!(run("a |`code` b", Code), "a |code b");
+        // Not in fenced code
+        assert_eq!(run("```\nco|de\n```", Code), "```\nco|de\n```");
+    }
+
+    #[test]
+    fn underscores_count_when_removing() {
+        assert_eq!(run("a __wo|rd__ b", Bold), "a wo|rd b");
+        assert_eq!(run("a _wo|rd_ b", Italic), "a wo|rd b");
+        assert_eq!(run("a __^word|__ b", Bold), "a ^word| b");
+        assert_eq!(run("a ^_word_| b", Italic), "a ^word| b");
+        // Added with stars
+        assert_eq!(run("a _wo|rd_ b", Bold), "a **_wo|rd_** b");
+        assert_eq!(run("snake_ca|se", Italic), "*snake_ca|se*");
+        assert_eq!(run("snake_ca|se", Bold), "**snake_ca|se**");
+        // `_` inside a word is not a marker
+        assert_eq!(run("foo_^bar|_baz", Italic), "foo_*^bar|*_baz");
+        assert_eq!(run("foo__^bar|__baz", Bold), "foo__**^bar|**__baz");
+    }
+
+    #[test]
+    fn link_wraps_selection_or_inserts_placeholder() {
+        assert_eq!(
+            link_run("see ^the docs| here"),
+            "see [the docs](^url|) here"
+        );
+        assert_eq!(
+            link_run("see |the docs^ here"),
+            "see [the docs](^url|) here"
+        );
+        assert_eq!(
+            link_run("go ^https://example.org/a?b=1| now"),
+            "go [|](https://example.org/a?b=1) now"
+        );
+        assert_eq!(
+            link_run("go ^www.example.org |now"),
+            "go [|](www.example.org) now"
+        );
+        assert_eq!(link_run("a | b"), "a [^text|](url) b");
+        assert_eq!(link_run("|"), "[^text|](url)");
+        // Over several lines or in code: nothing
+        assert_eq!(link_run("^a\nb|"), "^a\nb|");
+        assert_eq!(link_run("`co|de`"), "`co|de`");
+    }
+
+    #[test]
+    fn link_selects_url_of_existing_link() {
+        assert_eq!(
+            link_run("a [te|xt](https://x.org) b"),
+            "a [text](^https://x.org|) b"
+        );
+        assert_eq!(link_run("[t](u|rl \"title\")"), "[t](^url| \"title\")");
+        assert_eq!(link_run("[t](url)| b"), "[t](^url|) b");
+        assert_eq!(link_run("![alt|](img.png)"), "![alt](^img.png|)");
+        assert_eq!(link_run("[w|](a_(b))"), "[w](^a_(b)|)");
+        assert_eq!(link_run("[w](a_(b))| c"), "[w](^a_(b)|) c");
+        // Not in a link: a new one, around the word at the cursor
+        assert_eq!(link_run("[t](url) |b"), "[t](url) [b](^url|)");
+    }
+
+    #[test]
+    fn link_without_selection_uses_the_word() {
+        assert_eq!(link_run("see the do|cs here"), "see the [docs](^url|) here");
+        assert_eq!(link_run("docs|"), "[docs](^url|)");
+        // Not in a word: a placeholder
+        assert_eq!(link_run("see | here"), "see [^text|](url) here");
+        assert_eq!(link_run("|"), "[^text|](url)");
+    }
+
+    #[test]
+    fn code_around_backticks_uses_a_longer_fence() {
+        assert_eq!(run("a ^x`y| b", Code), "a ``^x`y|`` b");
+        assert_eq!(run("^a``b|", Code), "```^a``b|```");
+        // A backtick at either end: a space between it and the fence
+        assert_eq!(run("^`a` b|", Code), "`` ^`a` b| ``");
+        assert_eq!(run("^a`|", Code), "`` ^a`| ``");
+        // And off again
+        assert_eq!(run("`` ^`a` b| ``", Code), "^`a` b|");
+        assert_eq!(run("a ``^x`y|`` b", Code), "a ^x`y| b");
+        // Spaces between two code spans are no padded fence
+        assert_eq!(run("`x` ^a| `y`", Code), "`x` `^a|` `y`");
+    }
+
+    #[test]
+    fn removes_from_lines_mixing_star_and_underscore() {
+        assert_eq!(run("^*a*\n_b_|", Italic), "^a\nb|");
+        assert_eq!(run("^__a__\n**b**|", Bold), "^a\nb|");
+        // One line without the style: added on that one only, with `*`
+        assert_eq!(run("^_a_\nb|", Italic), "^_a_\n*b|*");
+        // `_` inside a word is text
+        assert_eq!(run("^*a*\nsnake_case_x|", Italic), "^*a*\n*snake_case_x|*");
+    }
+
+    #[test]
+    fn code_spans_follow_commonmark() {
+        // A lone backtick is text: the rest of the line is no code
+        assert_eq!(run("Don`t touch th|is", Bold), "Don`t touch **th|is**");
+        assert_eq!(run("a \\`b` c|d", Bold), "a \\`b` **c|d**");
+        assert!(in_code_span("x ``a`b`` y", 6));
+        assert!(!in_code_span("x ``a`b`` y", 10));
+        // Off a double-backtick span with a backtick inside, and its padding
+        assert_eq!(run("x ``a`|b`` y", Code), "x a`|b y");
+        assert_eq!(run("`` `a|` ``", Code), "`a|`");
+    }
+
+    #[test]
+    fn front_matter_and_task_items_stay() {
+        let front = "---\ntitle: F|oo\n---\ntext";
+        assert_eq!(run(front, Bold), front);
+        assert_eq!(heading_run(front, 1), front);
+        assert_eq!(link_run(front), front);
+        assert_eq!(heading_run("- [ ] bu|y milk", 2), "- [ ] bu|y milk");
+        assert_eq!(heading_run("- bu|y milk", 2), "- ## bu|y milk");
+    }
+
+    #[test]
+    fn strikethrough_never_opens_a_code_block() {
+        // `~~~~` would start a fenced code block: nothing happens
+        assert_eq!(run("|", Strikethrough), "|");
+        assert_eq!(run("  |", Strikethrough), "  |");
+        assert_eq!(run("- |", Strikethrough), "- |");
+        assert_eq!(run("> |", Strikethrough), "> |");
+        // Elsewhere the empty pair is fine
+        assert_eq!(run("# |", Strikethrough), "# ~~|~~");
+        assert_eq!(run("a |", Strikethrough), "a ~~|~~");
+        assert_eq!(run("|", Bold), "**|**");
+    }
+
+    #[test]
+    fn pasting_url_over_text_makes_link() {
+        assert_eq!(
+            paste_run("see ^the docs| here", "https://x.org\n"),
+            "see [the docs](https://x.org)| here"
+        );
+        // Not a URL, no selection, or a URL selected: normal paste
+        assert_eq!(
+            paste_run("see ^the docs| here", "text"),
+            "see ^the docs| here"
+        );
+        assert_eq!(paste_run("see | here", "https://x.org"), "see | here");
+        assert_eq!(
+            paste_run("^https://a.org|", "https://x.org"),
+            "^https://a.org|"
+        );
+        assert_eq!(paste_run("^a\nb|", "https://x.org"), "^a\nb|");
+        assert_eq!(paste_run("^two words|", "https://x .org"), "^two words|");
+    }
+
+    #[test]
+    fn headings_set_toggle_and_remove() {
+        assert_eq!(heading_run("Ti|tle", 2), "## Ti|tle");
+        assert_eq!(heading_run("## Ti|tle", 2), "Ti|tle");
+        assert_eq!(heading_run("## Ti|tle", 3), "### Ti|tle");
+        assert_eq!(heading_run("###### Ti|tle", 0), "Ti|tle");
+        assert_eq!(heading_run("Ti|tle", 0), "Ti|tle");
+        assert_eq!(heading_run("|", 1), "# |");
+        assert_eq!(heading_run("|Title", 1), "# |Title");
+        // A cursor in the old marker goes after the new one
+        assert_eq!(heading_run("#|## Title", 1), "# |Title");
+        // `#tag` is text
+        assert_eq!(heading_run("#ta|g", 1), "# #ta|g");
+        // Quotes and lists stay in front
+        assert_eq!(heading_run("> ## x|", 3), "> ### x|");
+        assert_eq!(heading_run("> > x|", 1), "> > # x|");
+        assert_eq!(heading_run("- it|em", 2), "- ## it|em");
+        assert_eq!(heading_run("  1. ### it|em", 0), "  1. it|em");
+    }
+
+    #[test]
+    fn headings_on_selected_lines() {
+        assert_eq!(
+            heading_run("^one\n## two\nthree|", 2),
+            "## ^one\n## two\n## three|"
+        );
+        // All at that level: plain text again
+        assert_eq!(heading_run("## ^one\n## two|", 2), "^one\ntwo|");
+        // Blank lines between stay blank, and do not block the toggle
+        assert_eq!(heading_run("^one\n\ntwo|", 2), "## ^one\n\n## two|");
+        assert_eq!(heading_run("## ^one\n\n## two|", 2), "^one\n\ntwo|");
+        // Ending at the start of a line leaves it alone
+        assert_eq!(heading_run("^one\n|two", 1), "# ^one\n|two");
+        // Code is left alone
+        assert_eq!(
+            heading_run("^a\n```\n# code\n```\nb|", 1),
+            "# ^a\n```\n# code\n```\n# b|"
+        );
+        assert_eq!(heading_run("```\nco|de", 1), "```\nco|de");
+    }
+}

new file mode 100644
index 0000000..29f65ce
--- /dev/null
+++ b/src/md_edit.rs
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! What the Markdown typing helpers (`md_format`, `md_lists`) share: an edit as line changes
+//! plus the cursor and selection after it, applied to the editor as one undo step, and the map
+//! of fenced code lines.
+
+use cosmic_text::{Cursor, Edit, LineEnding, Selection};
+
+/// A position: line and byte offset in it.
+pub type Pos = (usize, usize);
+
+/// Replace bytes `start..end` of `line` with `text`, where `\n` starts a new line.
+#[derive(Debug, PartialEq)]
+pub struct Change {
+    pub line: usize,
+    pub start: usize,
+    pub end: usize,
+    pub text: String,
+}
+
+/// What a command does: the changes (at most one per line, from the last line up, so each
+/// applies to offsets the ones before it did not move) and the cursor and selection after.
+/// No changes: only the cursor and selection move, or nothing happens when they stay.
+#[derive(Debug, PartialEq)]
+pub struct Outcome {
+    pub changes: Vec<Change>,
+    pub cursor: Pos,
+    pub anchor: Option<Pos>,
+}
+
+/// The cursor and selection anchor of `editor`; a selection by lines (Vim) is wider than
+/// cursor to anchor, so its bounds count.
+pub fn cursor_and_anchor<'buffer, E: Edit<'buffer>>(editor: &E) -> (Pos, Option<Pos>) {
+    let pos = |cursor: Cursor| (cursor.line, cursor.index);
+    match editor.selection_bounds() {
+        Some((start, end)) if editor.cursor() == start => (pos(start), Some(pos(end))),
+        Some((start, end)) => (pos(end), Some(pos(start))),
+        None => (pos(editor.cursor()), None),
+    }
+}
+
+/// Run `command` on the lines, cursor and anchor of `editor` and apply its outcome as one undo
+/// step, new lines ending with `ending`. Whether there was an outcome.
+pub fn run<'buffer, E: Edit<'buffer>>(
+    editor: &mut E,
+    ending: LineEnding,
+    command: impl FnOnce(&[&str], Pos, Option<Pos>) -> Option<Outcome>,
+) -> bool {
+    let (cursor, anchor) = cursor_and_anchor(editor);
+    let outcome = editor.with_buffer(|buffer| {
+        let lines: Vec<&str> = buffer.lines.iter().map(|line| line.text()).collect();
+        command(&lines, cursor, anchor)
+    });
+    let Some(outcome) = outcome else {
+        return false;
+    };
+    // The key is used but nothing moves: keep the selection as it is (a Vim selection by lines)
+    if outcome.changes.is_empty() && outcome.cursor == cursor && outcome.anchor == anchor {
+        return true;
+    }
+    // Never edit hidden text: unfold what hides a changed line (children that move along, the
+    // items a renumbering reaches)
+    editor.with_buffer_mut(|buffer| {
+        for change in &outcome.changes {
+            // New lines after a fold header would land in front of its hidden block
+            let last = change.line + usize::from(change.text.contains('\n'));
+            crate::folding::unfold_lines(buffer, change.line, last);
+        }
+    });
+    editor.start_change();
+    editor.set_selection(Selection::None);
+    for change in &outcome.changes {
+        let start = Cursor::new(change.line, change.start);
+        if change.end > change.start {
+            editor.delete_range(start, Cursor::new(change.line, change.end));
+        }
+        let text = match ending {
+            LineEnding::Lf | LineEnding::None => change.text.clone(),
+            _ => change.text.replace('\n', ending.as_str()),
+        };
+        crate::tab::insert_in_pieces(editor, start, &text);
+    }
+    let at = |(line, index): Pos| Cursor::new(line, index);
+    editor.set_cursor(at(outcome.cursor));
+    if let Some(anchor) = outcome.anchor {
+        editor.set_selection(Selection::Normal(at(anchor)));
+    }
+    editor.finish_change();
+    editor.set_redraw(true);
+    true
+}
+
+/// An ATX heading: up to 3 spaces, `#` to `######`, then a space or the end of the line.
+pub fn is_heading(text: &str) -> bool {
+    let text = text.trim_start();
+    let level = text.len() - text.trim_start_matches('#').len();
+    (1..=6).contains(&level) && text[level..].chars().next().is_none_or(char::is_whitespace)
+}
+
+/// Where a line is relative to fenced code blocks.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Fenced {
+    Text,
+    /// The fence that opens a code block
+    Open,
+    /// Inside a code block, or its closing fence
+    Inside,
+}
+
+/// The rest of a line after its indentation and quote markers `>`.
+pub fn after_quotes(text: &str) -> &str {
+    quotes(text).1
+}
+
+/// The number of quote markers `>` at the start of a line, and the rest after them and the
+/// indentation.
+fn quotes(text: &str) -> (usize, &str) {
+    let mut depth = 0;
+    let mut rest = text.trim_start_matches([' ', '\t']);
+    while let Some(after) = rest.strip_prefix('>') {
+        depth += 1;
+        rest = after.trim_start_matches([' ', '\t']);
+    }
+    (depth, rest)
+}
+
+/// For lines `0..=last` (or all lines, when fewer): where each is relative to fenced code
+/// blocks (```` ``` ```` or `~~~`, also indented or in a quote), in one pass.
+pub fn fenced<S: AsRef<str>>(lines: &[S], last: usize) -> Vec<Fenced> {
+    // The open fence: its character, length and quote depth
+    let mut open: Option<(char, usize, usize)> = None;
+    (0..=last)
+        .map(|line| {
+            let (depth, text) = quotes(lines.get(line).map_or("", AsRef::as_ref));
+            // A block in a quote ends with the quote
+            if open.is_some_and(|(.., d)| depth < d) {
+                open = None;
+            }
+            let fence = ['`', '~'].into_iter().find_map(|c| {
+                let len = text.len() - text.trim_start_matches(c).len();
+                (len >= 3).then_some((c, len))
+            });
+            match (open, fence) {
+                (None, Some((c, len))) => {
+                    open = Some((c, len, depth));
+                    Fenced::Open
+                }
+                // A closing fence is at least as long as the opening one, with nothing after it
+                (Some((o, n, _)), Some((c, len)))
+                    if o == c && len >= n && text[len..].trim().is_empty() =>
+                {
+                    open = None;
+                    Fenced::Inside
+                }
+                (Some(_), _) => Fenced::Inside,
+                (None, None) => Fenced::Text,
+            }
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fenced_tracks_fences_in_quotes_and_lengths() {
+        use Fenced::*;
+        let lines = [
+            "text",
+            "> ````",
+            "> ```",
+            "> > x",
+            "> ````",
+            "  ~~~ rust",
+            "  ```",
+            "  ~~~",
+        ];
+        assert_eq!(
+            fenced(&lines, lines.len() - 1),
+            [Text, Open, Inside, Inside, Inside, Open, Inside, Inside]
+        );
+        // A block in a quote ends with the quote
+        assert_eq!(
+            fenced(&["> ```", "> code", "text"], 2),
+            [Open, Inside, Text]
+        );
+        // Past the end: text
+        assert_eq!(fenced(&["a"], 1), [Text, Text]);
+    }
+
+    #[test]
+    fn large_change_goes_in_pieces_as_one_undo_step() {
+        let text = "head\r\nold tail\r\n";
+        let mut editor = crate::column_select::tests::editor(text);
+        let value = format!("{}\n", "x".repeat(78)).repeat(25_000);
+        let outcome = Outcome {
+            changes: vec![Change {
+                line: 1,
+                start: 0,
+                end: 3,
+                text: value.clone(),
+            }],
+            cursor: (25_001, 0),
+            anchor: None,
+        };
+        let mut counted = crate::tab_pieces::tests::Counted {
+            editor: &mut editor,
+            moved: 0,
+        };
+        assert!(run(&mut counted, LineEnding::CrLf, |_, _, _| Some(outcome)));
+        let moved = counted.moved;
+        eprintln!("change of 25,000 lines: {moved} lines moved");
+        assert!(moved <= 25_000 * 256, "{moved} lines moved");
+        let after = format!("head\r\n{} tail\r\n", value.replace('\n', "\r\n"));
+        assert_eq!(crate::tab::editor_text(&editor), after);
+        assert_eq!(editor.cursor(), Cursor::new(25_001, 0));
+        editor.undo();
+        assert_eq!(crate::tab::editor_text(&editor), text);
+    }
+}

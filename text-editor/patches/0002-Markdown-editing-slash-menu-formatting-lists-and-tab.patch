index 0000000..a64f97e
--- /dev/null
+++ b/src/md_lists.rs
@@ -0,0 +1,1328 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! List editing in Markdown files: Enter continues a list item or quote, Tab and Shift+Tab
+//! nest and un-nest list items, Ctrl+Enter ticks task items.
+//!
+//! - Enter after the marker of `- item`, `* item`, `+ item`, `1. item`, `1) item`,
+//!   `- [ ] item` or `> text` (also indented and inside quotes) starts the next item with the
+//!   same indentation: numbers count up, task boxes start empty. Text after the cursor moves
+//!   into the new item. Enter on an empty item ends the list: a nested item moves out one level
+//!   first, a top-level one loses its marker; an empty `>` line loses one quote level.
+//! - Tab makes the item at the cursor (or the selected items) a child of the item above it,
+//!   indented to the column where that item's text starts, as CommonMark nests. Shift+Tab moves
+//!   it out to its parent's indentation. Children move along. Tab on the first item of a list
+//!   does nothing, since there is no item to nest under.
+//! - Backspace right after a marker (and its task box) steps back like Enter on an empty item
+//!   does, also when the item has text, as in Markdown All in One and Obsidian: a task box
+//!   goes first (`- [ ] |a` becomes `- |a`), then a nested item moves out one level and a
+//!   top-level item loses its marker (`- |a` becomes `|a`). An emptied item renumbers the
+//!   items below like Enter does.
+//! - Ctrl+Enter ticks or unticks the task item at the cursor, or every task in the selection
+//!   (all ticked: all unticked, else all ticked). Without tasks it turns list items and plain
+//!   lines into task items; headings, table rows, fences and dividers stay as they are.
+//!
+//! Ordered lists are renumbered from the changed item down. Nothing happens in code blocks,
+//! front matter or HTML blocks.
+
+use cosmic_text::{Edit, LineEnding};
+
+use crate::md_edit::{Change, Fenced, Outcome, Pos, fenced, run};
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Kind {
+    Bullet,
+    Ordered { number: u64, delim: char },
+}
+
+/// A list marker, as byte offsets in its line.
+#[derive(Clone, Copy, Debug)]
+struct Marker {
+    kind: Kind,
+    /// Where the marker starts (its first digit or bullet character)
+    start: usize,
+    /// Just after the marker character(s)
+    end: usize,
+    /// Where the item's content starts, after the space(s) behind the marker
+    content: usize,
+    /// The column (from the end of the quote markers) where children of this item start
+    nest: usize,
+    /// The task box: whether it is ticked
+    task: Option<bool>,
+    /// Where the item's text starts, after the task box
+    text: usize,
+}
+
+/// The block structure at the start of a line.
+#[derive(Clone, Copy, Debug)]
+struct Line {
+    quotes: usize,
+    /// Where the last quote marker `>` starts
+    last_quote: usize,
+    /// Just after the quote markers, with the one space after each
+    quote_end: usize,
+    /// Just after the indentation that follows the quote markers
+    indent_end: usize,
+    /// The width of that indentation in columns (tabs stop every 4)
+    indent: usize,
+    blank: bool,
+    marker: Option<Marker>,
+}
+
+fn columns(indent: &str) -> usize {
+    indent.chars().fold(0, |col, c| {
+        if c == '\t' {
+            col + 4 - col % 4
+        } else {
+            col + 1
+        }
+    })
+}
+
+/// Whether `rest` (a line without its quote markers and indentation) is a divider, like
+/// `---` or `* * *`, which looks like a list item but is not one.
+fn is_divider(rest: &str) -> bool {
+    ['-', '*', '_'].into_iter().any(|c| {
+        rest.chars().all(|x| x == c || x == ' ' || x == '\t')
+            && rest.chars().filter(|x| *x == c).count() >= 3
+    })
+}
+
+fn marker(text: &str, start: usize, indent: usize) -> Option<Marker> {
+    let rest = &text[start..];
+    let digits = rest.len() - rest.trim_start_matches(|c: char| c.is_ascii_digit()).len();
+    let (kind, len) = if rest.starts_with(['-', '*', '+']) {
+        (Kind::Bullet, 1)
+    } else if (1..=9).contains(&digits) && rest[digits..].starts_with(['.', ')']) {
+        let number = rest[..digits].parse().ok()?;
+        let delim = rest[digits..].chars().next()?;
+        (Kind::Ordered { number, delim }, digits + 1)
+    } else {
+        return None;
+    };
+    let after = &rest[len..];
+    if !(after.is_empty() || after.starts_with([' ', '\t'])) || is_divider(rest) {
+        return None;
+    }
+    let end = start + len;
+    let gap = after.len() - after.trim_start_matches([' ', '\t']).len();
+    // Five spaces or more start code inside the item: its content starts after the first
+    let gap = if after.trim().is_empty() || gap > 4 {
+        gap.min(1)
+    } else {
+        gap
+    };
+    let content = end + gap;
+    // A tab after the marker reaches the next tab stop
+    let gap_columns = text[end..content].chars().fold(indent + len, |col, c| {
+        if c == '\t' {
+            col + 4 - col % 4
+        } else {
+            col + 1
+        }
+    }) - indent
+        - len;
+    let nest = indent + len + gap_columns.max(1);
+    let (task, text_start) = match &text[content..] {
+        rest if rest
+            .get(..3)
+            .is_some_and(|task| ["[ ]", "[x]", "[X]"].contains(&task))
+            && (rest.len() == 3 || rest[3..].starts_with([' ', '\t'])) =>
+        {
+            let after = &rest[3..];
+            let spaces = after.len() - after.trim_start_matches([' ', '\t']).len();
+            (Some(&rest[..3] != "[ ]"), content + 3 + spaces)
+        }
+        _ => (None, content),
+    };
+    Some(Marker {
+        kind,
+        start,
+        end,
+        content,
+        nest,
+        task,
+        text: text_start,
+    })
+}
+
+fn parse(text: &str) -> Line {
+    parse_quotes(text, usize::MAX)
+}
+
+/// `parse` with at most `max` quote markers: a line in a code block has as many as the block.
+fn parse_quotes(text: &str, max: usize) -> Line {
+    let (mut quotes, mut last_quote, mut quote_end) = (0, 0, 0);
+    while quotes < max {
+        let rest = &text[quote_end..];
+        let spaces = rest.len() - rest.trim_start_matches(' ').len();
+        if spaces > 3 || !rest[spaces..].starts_with('>') {
+            break;
+        }
+        quotes += 1;
+        last_quote = quote_end + spaces;
+        quote_end = last_quote + 1;
+        if text[quote_end..].starts_with(' ') {
+            quote_end += 1;
+        }
+    }
+    let rest = &text[quote_end..];
+    let indent_end = text.len() - rest.trim_start_matches([' ', '\t']).len();
+    let indent = columns(&text[quote_end..indent_end]);
+    Line {
+        quotes,
+        last_quote,
+        quote_end,
+        indent_end,
+        indent,
+        blank: text[quote_end..].trim().is_empty(),
+        marker: marker(text, indent_end, indent),
+    }
+}
+
+/// Whether `text` starts a list item, after its quote markers and indentation. With
+/// `in_paragraph` only one that may interrupt a paragraph: a bullet or the number 1, with text.
+pub fn starts_item(text: &str, in_paragraph: bool) -> bool {
+    let Some(marker) = parse(text).marker else {
+        return false;
+    };
+    if !in_paragraph {
+        return true;
+    }
+    let numbered = matches!(marker.kind, Kind::Ordered { number, .. } if number != 1);
+    !numbered && !text[marker.content..].trim().is_empty()
+}
+
+/// Whether line `line` is Markdown text where list editing applies: not in a code block,
+/// front matter or an HTML block.
+fn allowed(lines: &[&str], line: usize, at: usize) -> bool {
+    crate::slash_menu::markdown_allows(lines.iter().copied(), line, at)
+}
+
+/// `allowed` for each of `candidates` (line, byte), with one parse for all of them.
+fn allowed_all(lines: &[&str], candidates: &[(usize, usize)]) -> Vec<bool> {
+    crate::slash_menu::markdown_allows_all(lines, candidates)
+}
+
+/// How a line relates to a list level while walking along it.
+enum Relation {
+    /// An item at the same level
+    Sibling(Line),
+    /// A blank line, or a child or continuation of an item at the level
+    Inside,
+    /// Past the level: less indented, another quote depth, or text at the level
+    Outside,
+}
+
+fn relation(text: &str, code: Fenced, quotes: usize, indent: usize) -> Relation {
+    let line = parse(text);
+    // A line in a code block nested in an item belongs to the item, whatever it looks like;
+    // a fence at the level itself is no item and ends it
+    if code == Fenced::Inside {
+        Relation::Inside
+    } else if line.quotes != quotes {
+        Relation::Outside
+    } else if line.blank || line.indent > indent {
+        Relation::Inside
+    } else if line.indent == indent && line.marker.is_some() {
+        Relation::Sibling(line)
+    } else {
+        Relation::Outside
+    }
+}
+
+/// The item above line `line` at the same level, before the list or its level ends.
+fn sibling_above<S: AsRef<str>>(lines: &[S], line: usize) -> Option<(usize, Line)> {
+    let at = parse(lines[line].as_ref());
+    let code = fenced(lines, line);
+    (0..line)
+        .rev()
+        .map(|i| {
+            (
+                i,
+                relation(lines[i].as_ref(), code[i], at.quotes, at.indent),
+            )
+        })
+        .find(|(_, relation)| !matches!(relation, Relation::Inside))
+        .and_then(|(i, relation)| match relation {
+            Relation::Sibling(line) => Some((i, line)),
+            _ => None,
+        })
+}
+
+/// The item that line `line` (an item) is nested in.
+fn parent<S: AsRef<str>>(lines: &[S], line: usize) -> Option<Line> {
+    let at = parse(lines[line].as_ref());
+    let code = fenced(lines, line);
+    for i in (0..line).rev() {
+        if code[i] == Fenced::Inside {
+            continue;
+        }
+        let above = parse(lines[i].as_ref());
+        if above.quotes != at.quotes {
+            return None;
+        }
+        if above.blank || above.indent >= at.indent {
+            continue;
+        }
+        return above.marker.is_some().then_some(above);
+    }
+    None
+}
+
+/// Number the ordered item at line `line` one more than the item above it at its level (1 when
+/// it is the first) and the items after it at that level on from there.
+fn renumber(lines: &mut [String], line: usize) {
+    let at = parse(&lines[line]);
+    let Some(Marker {
+        kind: Kind::Ordered { delim, .. },
+        ..
+    }) = at.marker
+    else {
+        return;
+    };
+    let mut next = match sibling_above(lines, line) {
+        Some((
+            _,
+            Line {
+                marker:
+                    Some(Marker {
+                        kind: Kind::Ordered { number, .. },
+                        ..
+                    }),
+                ..
+            },
+        )) => number + 1,
+        _ => 1,
+    };
+    let code = fenced(lines, lines.len().saturating_sub(1));
+    for (text, code) in lines[line..].iter_mut().zip(&code[line..]) {
+        match relation(text, *code, at.quotes, at.indent) {
+            Relation::Inside => continue,
+            Relation::Outside => break,
+            Relation::Sibling(sibling) => {
+                let Some(Marker {
+                    kind: Kind::Ordered { number, delim: d },
+                    start,
+                    end,
+                    ..
+                }) = sibling.marker
+                else {
+                    break;
+                };
+                if d != delim {
+                    break;
+                }
+                if number != next {
+                    text.replace_range(start..end - 1, &next.to_string());
+                }
+                next += 1;
+            }
+        }
+    }
+}
+
+/// The byte where `a` and `b` stop being equal, and the length of their equal ends after that.
+fn common(a: &str, b: &str) -> (usize, usize) {
+    let prefix = a
+        .char_indices()
+        .zip(b.chars())
+        .find(|((_, x), y)| x != y)
+        .map_or(a.len().min(b.len()), |((i, _), _)| i);
+    let suffix = a[prefix..]
+        .char_indices()
+        .rev()
+        .zip(b[prefix..].chars().rev())
+        .find(|((_, x), y)| x != y)
+        .map_or(a.len().min(b.len()) - prefix, |((i, x), _)| {
+            a.len() - prefix - i - x.len_utf8()
+        });
+    (prefix, suffix)
+}
+
+/// Where byte `at` of `old` is in `new`, the same line after an edit.
+fn map_pos(old: &str, new: &str, at: usize) -> usize {
+    let (prefix, suffix) = common(old, new);
+    // Text inserted at `at` goes in front of it
+    if at >= old.len() - suffix {
+        at + new.len() - old.len()
+    } else if at <= prefix {
+        at
+    } else {
+        new.len() - suffix
+    }
+}
+
+/// The changes that turn `old` into `new`, where `new` has one more line after line `split`
+/// when it is set.
+fn changes(old: &[&str], new: &[String], split: Option<usize>) -> Vec<Change> {
+    let mut changes = Vec::new();
+    let mut j = 0;
+    for (i, old) in old.iter().enumerate() {
+        let joined;
+        let new = if split == Some(i) {
+            j += 2;
+            joined = format!("{}\n{}", new[j - 2], new[j - 1]);
+            joined.as_str()
+        } else {
+            j += 1;
+            new[j - 1].as_str()
+        };
+        if *old != new {
+            let (prefix, suffix) = common(old, new);
+            changes.push(Change {
+                line: i,
+                start: prefix,
+                end: old.len() - suffix,
+                text: new[prefix..new.len() - suffix].to_string(),
+            });
+        }
+    }
+    changes.reverse();
+    changes
+}
+
+fn owned(lines: &[&str]) -> Vec<String> {
+    lines.iter().map(|line| line.to_string()).collect()
+}
+
+/// Whether line `l` (as `line`) follows paragraph text: a line with text at the same quote
+/// depth that is no list item, not indented under one.
+fn in_paragraph(lines: &[&str], l: usize, line: &Line) -> bool {
+    l.checked_sub(1).is_some_and(|above| {
+        let above = parse(lines[above]);
+        above.quotes == line.quotes
+            && !above.blank
+            && above.marker.is_none()
+            && above.indent <= line.indent
+            && !keeps_without_task(&lines[l - 1][above.indent_end..])
+    })
+}
+
+/// Enter at `cursor` (no selection). `None`: not in a list item or quote, or the cursor is in
+/// front of the text, and Enter is a plain new line.
+pub fn enter(lines: &[&str], cursor: Pos) -> Option<Outcome> {
+    let (l, at) = cursor;
+    let text = *lines.get(l)?;
+    let line = parse(text);
+    let start = match line.marker {
+        // `2024. text` in a paragraph is text: only 1 starts a list there
+        Some(Marker {
+            kind: Kind::Ordered { number, .. },
+            ..
+        }) if number != 1 && in_paragraph(lines, l, &line) => return None,
+        Some(marker) => marker.text,
+        None if line.quotes > 0 => line.quote_end,
+        None => return None,
+    };
+    if at < start || at > text.len() || !allowed(lines, l, line.indent_end) {
+        return None;
+    }
+    let mut new = owned(lines);
+    if text[start..].trim().is_empty() {
+        // An empty item ends the list: nested, it moves out a level first
+        if line.marker.is_some() && parent(lines, l).is_some() {
+            return indent(lines, (l, text.len()), None, true);
+        }
+        new[l] = match line.marker {
+            Some(_) => text[..line.quote_end].to_string(),
+            None => text[..line.last_quote].to_string(),
+        };
+        let cursor = (l, new[l].len());
+        // The items below close the gap
+        if let Some(next) = (l + 1..lines.len()).find(|i| !parse(lines[*i]).blank)
+            && let next_line = parse(lines[next])
+            && next_line.quotes == line.quotes
+            && next_line.indent == line.indent
+        {
+            renumber(&mut new, next);
+        }
+        return Some(Outcome {
+            changes: changes(lines, &new, None),
+            cursor,
+            anchor: None,
+        });
+    }
+    let keep = text[..at].trim_end().len().max(start);
+    let rest = text[at..].trim_start();
+    // At the start of the text the whole item moves down: a ticked task stays ticked
+    let moves_all = text[start..at].trim().is_empty();
+    let mut item = match line.marker {
+        Some(marker) => {
+            let mut item = text[..marker.start].to_string();
+            match marker.kind {
+                Kind::Bullet => item.push_str(&text[marker.start..marker.end]),
+                Kind::Ordered { number, delim } => {
+                    item.push_str(&format!("{}{delim}", number + 1));
+                }
+            }
+            item.push_str(match &text[marker.end..marker.content] {
+                "" => " ",
+                gap => gap,
+            });
+            match marker.task {
+                Some(true) if moves_all => {
+                    item.push_str(&text[marker.content..marker.content + 3]);
+                    item.push(' ');
+                }
+                Some(_) => item.push_str("[ ] "),
+                None => {}
+            }
+            item
+        }
+        None => {
+            let mut item = text[..line.quote_end].to_string();
+            if item.ends_with('>') {
+                item.push(' ');
+            }
+            item
+        }
+    };
+    let cursor = (l + 1, item.len());
+    item.push_str(rest);
+    new[l].truncate(keep);
+    if moves_all
+        && let Some(Marker {
+            task: Some(true),
+            content,
+            ..
+        }) = line.marker
+    {
+        new[l].replace_range(content + 1..content + 2, " ");
+    }
+    new.insert(l + 1, item);
+    renumber(&mut new, l + 1);
+    Some(Outcome {
+        changes: changes(lines, &new, Some(l)),
+        cursor,
+        anchor: None,
+    })
+}
+
+/// Enter at `cursor` (no selection) in a fenced code block, or on its fences, that is indented
+/// or quoted, as in a list item: the new line starts with the fence's indentation and quote
+/// markers, so the code stays in the item, also without automatic indentation. With `keep`
+/// (automatic indentation) a line indented further keeps its own indentation. `None`: not in
+/// such a block, or the cursor is in the indentation, and Enter is a plain new line.
+pub fn code_enter(lines: &[&str], cursor: Pos, keep: bool) -> Option<Outcome> {
+    let (l, at) = cursor;
+    let text = *lines.get(l)?;
+    let code = fenced(lines, l);
+    if code[l] == Fenced::Text {
+        return None;
+    }
+    // The fence that opened the block; a closing fence is `Inside` too
+    let open = (0..=l).rev().find(|i| code[*i] == Fenced::Open)?;
+    let fence = parse(lines[open]);
+    let mut prefix = &lines[open][..fence.indent_end];
+    if prefix.is_empty() {
+        return None;
+    }
+    let own = &text[..text.len() - text.trim_start_matches([' ', '\t', '>']).len()];
+    if keep && own.len() > prefix.len() && own.starts_with(prefix) {
+        prefix = own;
+    }
+    if at > text.len() || at < prefix.len().min(own.len()) || !text.is_char_boundary(at) {
+        return None;
+    }
+    let mut new = owned(lines);
+    new[l].truncate(at);
+    new.insert(l + 1, format!("{prefix}{}", &text[at..]));
+    Some(Outcome {
+        changes: changes(lines, &new, Some(l)),
+        cursor: (l + 1, prefix.len()),
+        anchor: None,
+    })
+}
+
+/// Backspace at `cursor` (no selection). `None`: the cursor is not right after a list marker,
+/// and Backspace deletes a character as usual.
+pub fn backspace(lines: &[&str], cursor: Pos) -> Option<Outcome> {
+    let (l, at) = cursor;
+    let text = *lines.get(l)?;
+    let line = parse(text);
+    let marker = line.marker?;
+    if at != marker.text || !allowed(lines, l, line.indent_end) {
+        return None;
+    }
+    // `2024. text` in a paragraph is text
+    if matches!(marker.kind, Kind::Ordered { number, .. } if number != 1)
+        && in_paragraph(lines, l, &line)
+    {
+        return None;
+    }
+    let mut new = owned(lines);
+    let cursor = if marker.task.is_some() {
+        // The task box goes first, the item stays
+        new[l].replace_range(marker.content..marker.text, "");
+        (l, marker.content)
+    } else if parent(lines, l).is_some() {
+        return indent(lines, cursor, None, true);
+    } else {
+        new[l].replace_range(marker.start..marker.text, "");
+        // An emptied item: the items below close the gap, as with Enter
+        if crate::md_edit::after_quotes(&new[l]).trim().is_empty()
+            && let Some(next) = (l + 1..lines.len()).find(|i| !parse(lines[*i]).blank)
+            && let next_line = parse(lines[next])
+            && next_line.quotes == line.quotes
+            && next_line.indent == line.indent
+        {
+            renumber(&mut new, next);
+        }
+        (l, marker.start)
+    };
+    Some(Outcome {
+        changes: changes(lines, &new, None),
+        cursor,
+        anchor: None,
+    })
+}
+
+/// The lines a selection from `cursor` to `anchor` covers: a selection that ends at the start
+/// of a line leaves that line out.
+fn selected_lines(cursor: Pos, anchor: Option<Pos>) -> (usize, usize) {
+    let anchor = anchor.unwrap_or(cursor);
+    let (first, last) = if anchor < cursor {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    };
+    if last.0 > first.0 && last.1 == 0 {
+        (first.0, last.0 - 1)
+    } else {
+        (first.0, last.0)
+    }
+}
+
+/// Tab (`outdent` false) or Shift+Tab on the list items at the cursor or in the selection.
+/// `None`: not only list items, and Tab does what it does elsewhere.
+pub fn indent(lines: &[&str], cursor: Pos, anchor: Option<Pos>, outdent: bool) -> Option<Outcome> {
+    let (first, last) = selected_lines(cursor, anchor);
+    if last >= lines.len() {
+        return None;
+    }
+    let parsed: Vec<Line> = lines[first..=last].iter().map(|text| parse(text)).collect();
+    let starts: Vec<(usize, usize)> = (first..=last)
+        .zip(&parsed)
+        .map(|(i, line)| (i, line.indent_end))
+        .collect();
+    let allowed = allowed_all(lines, &starts);
+    // The least indented item; the others keep their place relative to it
+    let (base, base_line) = parsed
+        .iter()
+        .enumerate()
+        .filter(|(_, line)| !line.blank)
+        .min_by_key(|(_, line)| line.indent)
+        .map(|(i, line)| (first + i, *line))?;
+    let items_only = parsed.iter().enumerate().all(|(i, line)| {
+        line.blank || line.marker.is_some() && line.quotes == base_line.quotes && allowed[i]
+    });
+    if !items_only {
+        return None;
+    }
+    // Children of the last item move along
+    let mut end = last;
+    let code = fenced(lines, lines.len() - 1);
+    for (i, text) in lines.iter().enumerate().skip(last + 1) {
+        match relation(text, code[i], base_line.quotes, base_line.indent) {
+            Relation::Inside if !parse(text).blank => end = i,
+            Relation::Inside => {}
+            _ => break,
+        }
+    }
+    let target = if outdent {
+        parent(lines, base)
+            .map(|parent| parent.indent)
+            .or((base_line.indent > 0).then_some(0))
+    } else {
+        sibling_above(lines, base).and_then(|(_, sibling)| sibling.marker.map(|m| m.nest))
+    };
+    let Some(target) = target else {
+        // Nowhere to go: the key is used, the text stays
+        return Some(Outcome {
+            changes: Vec::new(),
+            cursor,
+            anchor,
+        });
+    };
+    let delta = target as isize - base_line.indent as isize;
+    let mut new = owned(lines);
+    for (i, text) in lines.iter().enumerate().take(end + 1).skip(first) {
+        let line = if code[i] == Fenced::Inside {
+            parse_quotes(text, base_line.quotes)
+        } else {
+            parse(text)
+        };
+        if line.blank || line.quotes != base_line.quotes {
+            continue;
+        }
+        new[i] = shift_indent(text, &line, delta);
+    }
+    renumber(&mut new, base);
+    // The item after the moved ones, at the level they left
+    if let Some(next) = (end + 1..lines.len()).find(|i| !parse(lines[*i]).blank) {
+        let line = parse(lines[next]);
+        if line.marker.is_some()
+            && line.quotes == base_line.quotes
+            && line.indent == base_line.indent
+        {
+            renumber(&mut new, next);
+        }
+    }
+    let at = |(line, index): Pos| (line, map_pos(lines[line], &new[line], index));
+    Some(Outcome {
+        changes: changes(lines, &new, None),
+        cursor: at(cursor),
+        anchor: anchor.map(at),
+    })
+}
+
+/// `text` (parsed as `line`) with its indentation `delta` columns wider or narrower. Columns
+/// are added or removed at the start of the indentation, so tabs further in (code) stay.
+fn shift_indent(text: &str, line: &Line, delta: isize) -> String {
+    let (head, indent) = text.split_at(line.quote_end);
+    if delta >= 0 {
+        return format!("{head}{}{indent}", " ".repeat(delta as usize));
+    }
+    let mut drop = delta.unsigned_abs();
+    let mut rest = indent;
+    let mut col = 0;
+    while drop > 0 {
+        let width = match rest.chars().next() {
+            Some(' ') => 1,
+            Some('\t') => 4 - col % 4,
+            _ => break,
+        };
+        rest = &rest[1..];
+        col += width;
+        if width > drop {
+            // A tab wider than what is left to drop: the rest of it as spaces
+            return format!("{head}{}{rest}", " ".repeat(width - drop));
+        }
+        drop -= width;
+    }
+    format!("{head}{rest}")
+}
+
+/// Whether a line that is not a list item stays as it is on Ctrl+Enter.
+fn keeps_without_task(rest: &str) -> bool {
+    let trimmed = rest.trim_end();
+    rest.starts_with(['#', '|', '<'])
+        || !trimmed.is_empty() && trimmed.chars().all(|c| c == '=')
+        || rest.starts_with('[') && rest.contains("]:")
+        || rest.starts_with("```")
+        || rest.starts_with("~~~")
+        || is_divider(rest)
+}
+
+/// Ctrl+Enter: tick or untick the task items at the cursor or in the selection, or make them
+/// task items. `None` when nothing changes.
+pub fn toggle_task(lines: &[&str], cursor: Pos, anchor: Option<Pos>) -> Option<Outcome> {
+    let (first, last) = selected_lines(cursor, anchor);
+    let parsed: Vec<(usize, Line)> = (first..=last.min(lines.len().saturating_sub(1)))
+        .map(|i| (i, parse(lines[i])))
+        .collect();
+    let starts: Vec<(usize, usize)> = parsed
+        .iter()
+        .map(|(i, line)| (*i, line.indent_end))
+        .collect();
+    let allowed = allowed_all(lines, &starts);
+    let candidates: Vec<(usize, Line)> = parsed
+        .into_iter()
+        .zip(allowed)
+        .filter_map(|(candidate, allowed)| allowed.then_some(candidate))
+        .collect();
+    let tasks: Vec<(usize, Marker)> = candidates
+        .iter()
+        .filter_map(|(i, line)| line.marker.filter(|m| m.task.is_some()).map(|m| (*i, m)))
+        .collect();
+    let mut new = owned(lines);
+    if tasks.is_empty() {
+        let several = first < last;
+        for (i, line) in &candidates {
+            let text = lines[*i];
+            match line.marker {
+                Some(marker) => {
+                    let space = if marker.content == marker.end {
+                        " "
+                    } else {
+                        ""
+                    };
+                    new[*i].insert_str(marker.content, &format!("{space}[ ] "));
+                }
+                // Blank lines in a selection stay blank; at the cursor one gets a task
+                None if line.blank && several => {}
+                None if keeps_without_task(&text[line.indent_end..]) => {}
+                // A setext heading's text
+                None if lines.get(*i + 1).is_some_and(|below| {
+                    let below = below.trim();
+                    !below.is_empty() && (below.chars().all(|c| c == '=') || is_divider(below))
+                }) => {}
+                None => new[*i].insert_str(line.indent_end, "- [ ] "),
+            }
+        }
+    } else {
+        let tick = tasks.iter().any(|(_, marker)| marker.task == Some(false));
+        let mark = if tick { "x" } else { " " };
+        for (i, marker) in &tasks {
+            new[*i].replace_range(marker.content + 1..marker.content + 2, mark);
+        }
+    }
+    let changes = changes(lines, &new, None);
+    if changes.is_empty() {
+        return None;
+    }
+    let at = |(line, index): Pos| (line, map_pos(lines[line], &new[line], index));
+    Some(Outcome {
+        changes,
+        cursor: at(cursor),
+        anchor: anchor.map(at),
+    })
+}
+
+/// Enter in `editor`, as one undo step, new lines ending with `ending`. `false`: not in a list
+/// item or quote, or with a selection, and Enter does what it does elsewhere.
+pub fn enter_key<'buffer, E: Edit<'buffer>>(editor: &mut E, ending: LineEnding) -> bool {
+    if editor.selection_bounds().is_some() {
+        return false;
+    }
+    // Most lines are no list item, quote or indented code: no need to look at the whole file
+    let cursor = editor.cursor();
+    let keep = editor.auto_indent();
+    let (item, code) = editor.with_buffer(|buffer| {
+        buffer
+            .lines
+            .get(cursor.line)
+            .map_or((false, false), |line| {
+                let text = line.text();
+                let line = parse(text);
+                // Automatic indentation keeps the indentation of code, but not quote markers
+                let code = line.quotes > 0 || (!keep && text.starts_with([' ', '\t']));
+                (line.marker.is_some() || line.quotes > 0, code)
+            })
+    });
+    if !item && !code {
+        return false;
+    }
+    run(editor, ending, |lines, cursor, _| {
+        code.then(|| code_enter(lines, cursor, keep))
+            .flatten()
+            .or_else(|| item.then(|| enter(lines, cursor)).flatten())
+    })
+}
+
+/// Backspace in `editor`, as one undo step. `false`: not right after a list marker, or with a
+/// selection, and Backspace does what it does elsewhere.
+pub fn backspace_key<'buffer, E: Edit<'buffer>>(editor: &mut E) -> bool {
+    if editor.selection_bounds().is_some() {
+        return false;
+    }
+    // Most lines are no list item: no need to look at the whole file
+    let cursor = editor.cursor();
+    let candidate = editor.with_buffer(|buffer| {
+        buffer.lines.get(cursor.line).is_some_and(|line| {
+            parse(line.text())
+                .marker
+                .is_some_and(|m| m.text == cursor.index)
+        })
+    });
+    candidate
+        && run(editor, LineEnding::Lf, |lines, cursor, _| {
+            backspace(lines, cursor)
+        })
+}
+
+/// Tab or Shift+Tab in `editor`, as one undo step. `false`: not on list items, and Tab does
+/// what it does elsewhere.
+pub fn tab_key<'buffer, E: Edit<'buffer>>(editor: &mut E, outdent: bool) -> bool {
+    // Most lines are no list item: no need to look at the whole file
+    let cursor = editor.cursor();
+    let candidate = editor.with_buffer(|buffer| {
+        buffer
+            .lines
+            .get(cursor.line)
+            .is_some_and(|line| parse(line.text()).marker.is_some())
+    });
+    if !candidate && editor.selection_bounds().is_none() {
+        return false;
+    }
+    run(editor, LineEnding::Lf, |lines, cursor, anchor| {
+        indent(lines, cursor, anchor, outdent)
+    })
+}

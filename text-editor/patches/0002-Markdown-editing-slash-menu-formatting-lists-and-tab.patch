+        // Not indented, outside code or in the indentation: plain
+        assert_eq!(code_enter_on("```|\n```", false), "plain");
+        assert_eq!(code_enter_on("- a\n  b|", false), "plain");
+        assert_eq!(code_enter_on("- a\n|  ```\n  ```", false), "plain");
+    }
+
+    fn backspace_on(text: &str) -> String {
+        run_on(text, |lines, cursor, _| backspace(lines, cursor)).unwrap_or_else(|| "plain".into())
+    }
+
+    fn task_on(text: &str) -> String {
+        run_on(text, toggle_task).unwrap_or_else(|| "none".into())
+    }
+
+    #[test]

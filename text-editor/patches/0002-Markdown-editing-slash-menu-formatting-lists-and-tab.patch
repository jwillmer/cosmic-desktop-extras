+        run_on(text, |lines, cursor, _| enter(lines, cursor)).unwrap_or_else(|| "plain".into())
+    }
+
+    fn tab_on(text: &str) -> String {
+        run_on(text, |lines, cursor, anchor| {
+            indent(lines, cursor, anchor, false)
+        })
+        .unwrap_or_else(|| "plain".into())
+    }
+
+    fn shift_tab_on(text: &str) -> String {
+        run_on(text, |lines, cursor, anchor| {
+            indent(lines, cursor, anchor, true)
+        })
+        .unwrap_or_else(|| "plain".into())
+    }
+
+    fn code_enter_on(text: &str, keep: bool) -> String {
+        run_on(text, |lines, cursor, _| code_enter(lines, cursor, keep))
+            .unwrap_or_else(|| "plain".into())
+    }
+
+    #[test]
+    fn enter_in_code_keeps_the_item_indentation() {
+        // After the opening fence, inside the code and after the closing fence
+        assert_eq!(
+            code_enter_on("- a\n  ```rust|\n  ```", false),
+            "- a\n  ```rust\n  |\n  ```"
+        );
+        assert_eq!(

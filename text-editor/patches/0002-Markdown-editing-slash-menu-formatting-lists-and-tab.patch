+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The Markdown shortcuts panel: every key that writes Markdown, grouped by what it edits, in the
+//! context drawer. The key texts of the bound shortcuts come from `key_bind_ext`, and a test
+//! checks that every Markdown binding is listed, so the panel cannot drift from the keys.
+
+use cosmic::{
+    Element,
+    app::context_drawer,
+    iced::{Alignment, Color, Length, widget::text},
+    theme, widget,
+};
+
+use crate::{Config, ContextPage, Message, fl, key_bind_ext};
+
+/// The keys of Heading 1 to 6 on one keycap.
+const HEADING_RANGE_SHORTCUT: &str = "Ctrl + Shift + 1…6";
+
+/// Keys the editor handles itself in Markdown files, written like the bindings.
+const ENTER: &str = "Enter";
+const TAB: &str = "Tab";
+const SHIFT_TAB: &str = "Shift + Tab";
+const BACKSPACE: &str = "Backspace";
+const SLASH: &str = "/";
+
+/// The width of the keycap column, so the descriptions line up.
+const KEYS_WIDTH: f32 = 168.0;
+
+/// One row: the keys and what they do.
+struct Row {
+    keys: &'static str,
+    label: fn() -> String,
+    /// The editor handles the key itself, which it does not with Vim bindings (bindings work).
+    no_vim: bool,
+}
+
+/// A group of rows under a heading.
+struct Section {
+    title: fn() -> String,
+    rows: &'static [Row],
+}
+
+/// A row of a bound shortcut.
+const fn row(keys: &'static str, label: fn() -> String) -> Row {
+    Row {
+        keys,
+        label,
+        no_vim: false,
+    }
+}
+
+/// A row of a key the editor handles in Markdown files, without Vim bindings only.
+const fn key(keys: &'static str, label: fn() -> String) -> Row {
+    Row {
+        keys,
+        label,
+        no_vim: true,
+    }
+}
+
+static SECTIONS: &[Section] = &[
+    Section {
+        title: || fl!("md-shortcuts-text"),
+        rows: &[
+            row(key_bind_ext::BOLD_SHORTCUT, || fl!("md-shortcuts-bold")),
+            row(key_bind_ext::ITALIC_SHORTCUT, || fl!("md-shortcuts-italic")),
+            row(key_bind_ext::STRIKETHROUGH_SHORTCUT, || {
+                fl!("md-shortcuts-strikethrough")
+            }),
+            row(key_bind_ext::CODE_SHORTCUT, || {
+                fl!("md-shortcuts-inline-code")
+            }),
+            row(key_bind_ext::LINK_SHORTCUT, || fl!("md-shortcuts-link")),
+        ],
+    },
+    Section {
+        title: || fl!("md-shortcuts-headings"),
+        rows: &[
+            row(HEADING_RANGE_SHORTCUT, || fl!("md-shortcuts-heading-level")),
+            row(key_bind_ext::PLAIN_TEXT_SHORTCUT, || {
+                fl!("md-shortcuts-plain-text")
+            }),
+        ],
+    },
+    Section {
+        title: || fl!("md-shortcuts-lists"),
+        rows: &[
+            key(ENTER, || fl!("md-shortcuts-next-item")),
+            key(TAB, || fl!("md-shortcuts-nest")),
+            key(SHIFT_TAB, || fl!("md-shortcuts-un-nest")),
+            key(BACKSPACE, || fl!("md-shortcuts-step-back")),
+            row(key_bind_ext::TASK_SHORTCUT, || {
+                fl!("md-shortcuts-tick-task")
+            }),
+        ],
+    },
+    Section {
+        title: || fl!("md-shortcuts-tables"),
+        rows: &[
+            key(TAB, || fl!("md-shortcuts-next-cell")),
+            key(SHIFT_TAB, || fl!("md-shortcuts-previous-cell")),
+            key(ENTER, || fl!("md-shortcuts-new-row")),
+        ],
+    },
+    Section {
+        title: || fl!("md-shortcuts-blocks"),
+        rows: &[key(SLASH, || fl!("md-shortcuts-block-menu"))],
+    },
+];
+
+/// A key or key combination drawn as a small rounded box in the drawer's colours.
+fn keycap(keys: &'static str) -> Element<'static, Message> {
+    widget::container(widget::text(keys).size(13).font(cosmic::font::mono()))
+        .padding([2, 8])
+        .class(theme::Container::custom(|theme| {
+            let cosmic = theme.cosmic();
+            widget::container::Style {
+                text_color: Some(Color::from(cosmic.on_primary_component_color())),
+                background: Some(Color::from(cosmic.primary_component_color()).into()),
+                border: cosmic::iced::Border {
+                    color: Color::from(cosmic.primary_component_divider()),
+                    width: 1.0,
+                    radius: cosmic.radius_s().into(),
+                },
+                ..Default::default()
+            }
+        }))
+        .into()
+}
+
+/// The text colour of a row that does not work with the current settings.
+fn dimmed(theme: &cosmic::Theme) -> text::Style {
+    let mut color = Color::from(theme.cosmic().on_bg_color());
+    color.a *= 0.5;
+    text::Style {
+        color: Some(color),
+        ..text::Catalog::style(theme, &theme::Text::Default)
+    }
+}
+
+fn content(config: &Config) -> Element<'static, Message> {
+    let space = cosmic::theme::spacing();
+    let mut column = widget::column::with_capacity(SECTIONS.len() * 6).spacing(space.space_xxs);
+    for (i, section) in SECTIONS.iter().enumerate() {
+        let title = widget::text::caption_heading((section.title)().to_uppercase())
+            .class(theme::Text::Accent);
+        // A gap above every heading but the first
+        let top = if i == 0 { 0 } else { space.space_xs };
+        column = column.push(widget::container(title).padding([top, 0, 0, 0]));
+        for row in section.rows {
+            let label = if row.keys == SLASH && !config.markdown_slash_menu {
+                fl!("md-shortcuts-block-menu-off")
+            } else {
+                (row.label)()
+            };
+            // Off with Vim bindings: dimmed, the header says why
+            let off = row.no_vim && config.vim_bindings;
+            let label = widget::text::body(label).width(Length::Fill);
+            let label = if off {
+                label.class(theme::Text::Custom(dimmed))
+            } else {
+                label
+            };
+            column = column.push(
+                widget::row::with_capacity(2)
+                    .align_y(Alignment::Center)
+                    .spacing(space.space_s)
+                    .push(widget::container(keycap(row.keys)).width(Length::Fixed(KEYS_WIDTH)))
+                    .push(label),
+            );
+        }
+    }
+    column.into()
+}
+
+/// The context drawer page with the Markdown shortcuts.
+pub fn drawer(config: &Config) -> context_drawer::ContextDrawer<'static, Message> {
+    let mut hint = fl!("md-shortcuts-hint");
+    if config.vim_bindings {
+        hint = format!("{hint} {}", fl!("md-shortcuts-vim"));
+    }
+    let space = cosmic::theme::spacing();
+    context_drawer::context_drawer(
+        content(config),
+        Message::ToggleContextPage(ContextPage::MarkdownShortcuts),
+    )
+    .title(fl!("md-shortcuts"))
+    .header(widget::text::caption(hint).width(Length::Fill))
+    .footer(
+        widget::container(widget::text::caption(fl!("md-shortcuts-format-table")))
+            .padding([space.space_s, 0]),
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::Action;
+
+    /// The keys written on one keycap: a range like `1…6` stands for each of its keys.
+    fn expand(keys: &str) -> Vec<String> {
+        match keys.split_once('…') {
+            Some((head, last)) => {
+                let Some((at, _)) = head.char_indices().last() else {
+                    return vec![keys.to_string()];
+                };
+                let (prefix, first) = head.split_at(at);
+                let (Ok(first), Ok(last)) = (first.parse::<u8>(), last.parse::<u8>()) else {
+                    return vec![keys.to_string()];
+                };
+                (first..=last).map(|n| format!("{prefix}{n}")).collect()
+            }
+            None => vec![keys.to_string()],
+        }
+    }
+
+    fn listed() -> Vec<String> {
+        SECTIONS
+            .iter()
+            .flat_map(|section| section.rows)
+            .flat_map(|row| expand(row.keys))
+            .collect()
+    }
+
+    #[test]
+    fn every_markdown_binding_is_listed() {
+        let listed = listed();
+        let mut checked = 0;
+        for (key_bind, action) in crate::key_bind::key_binds() {
+            let markdown = matches!(
+                action,
+                Action::MarkdownBold
+                    | Action::MarkdownItalic
+                    | Action::MarkdownStrikethrough
+                    | Action::MarkdownCode
+                    | Action::MarkdownLink
+                    | Action::MarkdownHeading(_)
+                    | Action::MarkdownToggleTask
+                    | Action::MarkdownFormatTable
+            );
+            if markdown {
+                let text = key_bind.to_string();
+                assert!(
+                    listed.contains(&text),
+                    "{text} ({action:?}) is not in the panel"
+                );
+                checked += 1;
+            }
+        }
+        // Bold, italic, strikethrough, code, link, headings 0 to 6, task
+        assert_eq!(checked, 13);
+    }
+
+    #[test]
+    fn listed_shortcuts_are_bound() {
+        let bound: Vec<String> = crate::key_bind::key_binds()
+            .keys()
+            .map(|key_bind| key_bind.to_string())
+            .collect();
+        // Rows of bindings work with Vim bindings too; the editor's own keys are bound to nothing
+        for row in SECTIONS.iter().flat_map(|section| section.rows) {
+            for keys in expand(row.keys) {
+                assert_eq!(bound.contains(&keys), !row.no_vim, "{keys}");
+            }
+        }
+    }
+
+    #[test]
+    fn ranges_expand() {
+        assert_eq!(
+            expand(HEADING_RANGE_SHORTCUT),
+            key_bind_ext::HEADING_SHORTCUTS.map(String::from)
+        );
+        assert_eq!(expand("Tab"), ["Tab"]);
+    }
+}

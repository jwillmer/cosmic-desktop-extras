+
+    #[test]
+    fn edit_link_selects_text() {
+        let line = " /li";
+        let e = edit(
+            line,
+            &trigger(line, 4).unwrap(),
+            4,
+            by_label("Link"),
+            None,
+            None,
+        );
+        assert_eq!(e.text, "[text](url)");
+        // Positions are in the line after the edit: " [text](url)"
+        assert_eq!((e.anchor, e.cursor), (Some((0, 2)), (0, 6)));
+        let image = by_label("Image");
+        assert_eq!(&image.text[image.anchor.unwrap()..image.cursor], "alt");
+    }
+
+    #[test]
+    fn every_item_cursor_and_anchor_in_bounds() {
+        for item in ITEMS {
+            assert!(item.cursor <= item.text.len(), "{}", item.name);
+            assert!(item.text.is_char_boundary(item.cursor), "{}", item.name);
+            if let Some(anchor) = item.anchor {
+                assert!(anchor < item.cursor, "{}", item.name);
+            }
+        }
+    }
+
+    #[test]
+    fn menu_closes_when_cursor_leaves_or_nothing_matches() {
+        let menu = Menu {
+            line: 3,
+            start: 0,
+            selected: 0,
+        };
+        assert_eq!(still_open(&menu, 3, "/hea", 4).map(|i| i.len()), Some(3));
+        assert!(still_open(&menu, 4, "/hea", 4).is_none());
+        assert!(still_open(&menu, 3, "/hea ", 5).is_none());
+        assert!(still_open(&menu, 3, "/zz", 3).is_none());
+        assert!(still_open(&menu, 3, "x", 1).is_none());
+        // Backspace over the "/" closes it
+        assert!(still_open(&menu, 3, "", 0).is_none());
+        // A different "/" (a second menu) is not this one
+        assert!(still_open(&Menu { start: 2, ..menu }, 3, "/x", 2).is_none());
+    }
+
+    #[test]
+    fn step_wraps() {
+        let mut menu = Menu {
+            line: 0,
+            start: 0,
+            selected: 0,
+        };
+        menu.step(false, 3);
+        assert_eq!(menu.selected, 2);
+        menu.step(true, 3);
+        assert_eq!(menu.selected, 0);
+        menu.step(true, 0);
+        assert_eq!(menu.selected, 0);
+    }
+
+    /// `markdown_allows` for the "/" that starts the last line (after its indentation).
+    fn allows(text: &str) -> bool {
+        let lines: Vec<&str> = text.split('\n').collect();
+        let last = lines.len() - 1;
+        let start = lines[last].find('/').unwrap();
+        markdown_allows(lines.iter().copied(), last, start)
+    }
+
+    #[test]
+    fn allowed_in_text_lists_and_quotes() {
+        assert!(allows("/"));
+        assert!(allows("# Notes\n\nSome text\n/"));
+        assert!(allows("- item\n  /"));
+        assert!(allows("- item\n\n    /"));
+        assert!(allows("```\ncode\n```\n/"));
+        assert!(allows("~~~\ncode\n~~~\n\n/"));
+        assert!(allows("<!-- note -->\n\n/"));
+        // A paragraph line indented by four continues the paragraph
+        assert!(allows("text\n    /"));
+    }
+
+    #[test]
+    fn not_in_fenced_code() {
+        assert!(!allows("```\n/"));
+        assert!(!allows("```\ncode\n/"));
+        assert!(!allows("~~~\n/"));
+        assert!(!allows("```rust\nfn main() {}\n/"));
+        assert!(!allows("~~~ python title=\"x\"\n/"));
+        assert!(!allows("text\n\n  ```\n  /"));
+        assert!(!allows("- item\n\n  ```sh\n  /"));
+        assert!(!allows("> ```\n> /"));
+        // A shorter or different fence does not close it
+        assert!(!allows("````\n```\n/"));
+        assert!(!allows("```\n~~~\n/"));
+        // Closed above, then a new one opened
+        assert!(!allows("```\na\n```\n\n```mermaid\n/"));
+    }
+
+    #[test]
+    fn not_in_indented_code() {
+        assert!(!allows("    code\n    /"));
+        assert!(!allows("text\n\n    /"));
+        assert!(!allows("\t/"));
+    }
+
+    #[test]
+    fn not_in_html_blocks_or_comments() {
+        assert!(!allows("<div>\n/"));
+        assert!(!allows("<!--\n/"));
+        assert!(!allows("<!-- a\nb\n/"));
+        assert!(!allows("<pre>\ncode\n/"));
+        assert!(!allows("text\n\n<details>\n<summary>x</summary>\n/"));
+        // A blank line ends a <div> block
+        assert!(allows("<div>\n\n/"));
+    }
+
+    #[test]
+    fn not_in_front_matter() {
+        assert!(!markdown_allows(["---", "/", "title: x", "---"], 1, 0));
+        let doc = "---\ntitle: x\n/\n---\n# Doc\n/";
+        let lines: Vec<&str> = doc.split('\n').collect();
+        assert!(!markdown_allows(lines.iter().copied(), 2, 0));
+        assert!(markdown_allows(lines.iter().copied(), 5, 0));
+        let toml = ["+++", "/", "+++", "/"];
+        assert!(!markdown_allows(toml, 1, 0));
+        assert!(markdown_allows(toml, 3, 0));
+        let dots = ["---", "a: 1", "...", "/"];
+        assert!(markdown_allows(dots, 3, 0));
+        assert_eq!(
+            markdown_allows_all(
+                &["---", "a: 1", "---", "/", "```", "/"],
+                &[(1, 0), (3, 0), (5, 0)]
+            ),
+            [false, true, false]
+        );
+        // "---" not on the first line, never closed, or followed by a blank line: a divider
+        assert!(allows("text\n\n---\n/"));
+        assert!(allows("---\n/"));
+        assert!(allows("---\n\nIntro\n\n---\n/"));
+        assert!(allows("---\n---\n/"));
+        // Front matter, then a code block
+        assert!(!allows("---\na: 1\n---\n```\n/"));
+    }
+
+    fn edit_with(item: &str, line: &str, above: Option<&str>, below: Option<&str>) -> Edit {
+        let cursor = line.find('/').unwrap() + 1;
+        let t = trigger(line, cursor).unwrap();
+        edit(line, &t, cursor, by_label(item), above, below)
+    }
+
+    #[test]
+    fn divider_keeps_apart_from_text() {
+        // Under text: a blank line first, else "---" makes the text a heading
+        let e = edit_with("Divider", "/", Some("Some text"), None);
+        assert_eq!((e.start, e.text.as_str(), e.cursor), (0, "\n---", (1, 3)));
+        // Text below: a blank line after
+        let e = edit_with("Divider", "/", Some(""), Some("More"));
+        assert_eq!((e.text.as_str(), e.cursor), ("---\n", (0, 3)));
+        // On the first line "***", never front matter
+        let e = edit_with("Divider", "/", None, Some("More"));
+        assert_eq!((e.text.as_str(), e.cursor), ("***\n", (0, 3)));
+        let e = edit_with("Divider", "/", None, None);
+        assert_eq!(e.text, "***");
+        // Blank lines around already: nothing added
+        let e = edit_with("Divider", "/", Some(""), Some("  "));
+        assert_eq!((e.start, e.text.as_str()), (0, "---"));
+        // Indented: the blank line has no indentation
+        let e = edit_with("Divider", "  /", Some("  - item"), Some("  more"));
+        assert_eq!(
+            (e.start, e.text.as_str(), e.cursor),
+            (0, "\n  ---\n", (1, 5))
+        );
+    }
+
+    #[test]
+    fn blocks_keep_apart_from_text() {
+        let e = edit_with("Code block", "/", Some("text"), Some("text"));
+        assert_eq!(e.text, "\n```\n```\n");
+        assert_eq!(e.cursor, (1, 3));
+        let e = edit_with("Mermaid diagram", "/", Some("text"), None);
+        assert_eq!(e.text, "\n```mermaid\n\n```");
+        assert_eq!(e.cursor, (2, 0));
+        // A line under a table would become a row
+        let e = edit_with("Table", "/", Some("text"), Some("text"));
+        assert!(e.text.starts_with("\n| Column 1"));
+        assert!(e.text.ends_with("|  |  |\n"));
+        assert_eq!((e.anchor, e.cursor), (Some((1, 2)), (1, 10)));
+        // Text after the cursor goes below the block, after a blank line
+        let line = "/hello";
+        let t = trigger(line, 1).unwrap();
+        let e = edit(line, &t, 1, by_label("Divider"), Some(""), None);
+        assert_eq!((e.end, e.text.as_str()), (1, "---\n\n"));
+        // Inline items are left alone
+        let e = edit_with("Heading 1", "/", Some("text"), Some("text"));
+        assert_eq!((e.start, e.text.as_str()), (0, "# "));
+        let e = edit_with("Link", "/", Some("text"), Some("text"));
+        assert_eq!(e.text, "[text](url)");
+    }
+
+    #[test]
+    fn inline_styles_select_text_without_spacing() {
+        for (name, text) in [
+            ("Bold", "**text**"),
+            ("Italic", "*text*"),
+            ("Strikethrough", "~~text~~"),
+            ("Inline code", "`text`"),
+        ] {
+            let e = edit_with(name, "  /", Some("para"), Some("para"));
+            assert_eq!((e.start, e.end, e.text.as_str()), (2, 3, text));
+            let open = text.find("text").unwrap();
+            assert_eq!(e.anchor, Some((0, 2 + open)));
+            assert_eq!(e.cursor, (0, 2 + open + 4));
+        }
+        assert_eq!(labels("bo"), ["Bold"]);
+        assert_eq!(labels("ita")[0], "Italic");
+        assert_eq!(labels("strike"), ["Strikethrough"]);
+        assert_eq!(labels("code")[0], "Code block");
+        assert!(labels("code").contains(&"Inline code"));
+    }
+
+    #[test]
+    fn item_index_is_its_position() {
+        for (i, item) in ITEMS.iter().enumerate() {
+            assert_eq!(item.index(), i);
+        }
+    }
+
+    #[test]
+    fn every_item_has_hint_and_label() {
+        let hints: Vec<_> = ITEMS.iter().map(Item::hint).collect();
+        assert_eq!(
+            hints,
+            [
+                "Ctrl + Shift + 1",
+                "Ctrl + Shift + 2",
+                "Ctrl + Shift + 3",
+                "-",
+                "1.",
+                "Ctrl + Enter",
+                ">",
+                "```",
+                "|",
+                "---",
+                "Ctrl + K",
+                "![]()",
+                "Ctrl + B",
+                "Ctrl + I",
+                "Ctrl + Shift + X",
+                "Ctrl + `",
+                "```mermaid"
+            ]
+        );
+        for item in ITEMS {
+            // English is the fallback language
+            assert_eq!(item.label(), item.name);
+        }
+    }
+
+    #[test]
+    fn enabled_only_with_setting_markdown_and_no_vim() {
+        assert!(enabled(true, true, false));
+        assert!(!enabled(false, true, false));
+        assert!(!enabled(true, false, false));
+        assert!(!enabled(true, true, true));
+    }
+
+    #[test]
+    fn not_in_html_comment_running_past_the_cursor() {
+        assert!(!allows("Some text <!-- hidden\n/"));
+        assert!(!allows("Some text <!-- hidden\nmore\n/"));
+        assert!(!allows("- item <!-- a\n  /"));
+        // Closed before the "/", in a code span, or in an earlier paragraph
+        assert!(allows("Some text <!-- a --> b\n/"));
+        assert!(allows("Some `<!--` text\n/"));
+        assert!(allows("Text <!-- a\n\n/"));
+        assert!(allows("Text <!-- a\n\n# Heading\n/"));
+        // Escaped: text, not a comment; an escaped backslash before it does not escape it
+        assert!(allows("Some text \\<!-- not hidden\n/"));
+        assert!(!allows("Some text \\\\<!-- hidden\n/"));
+    }
+
+    /// Every case of the tests above: the fast path skips the parse only where it would allow.
+    #[test]
+    fn fast_path_agrees_with_parse() {
+        let cases = [
+            "/",
+            "# Notes\n\nSome text\n/",
+            "- item\n  /",
+            "- item\n\n    /",
+            "```\ncode\n```\n/",
+            "~~~\ncode\n~~~\n\n/",
+            "<!-- note -->\n\n/",
+            "text\n    /",
+            "```\n/",
+            "```rust\nfn main() {}\n/",
+            "~~~ python title=\"x\"\n/",
+            "text\n\n  ```\n  /",
+            "> ```\n> /",
+            "````\n```\n/",
+            "    code\n    /",
+            "text\n\n    /",
+            "\t/",
+            "> text\n>\n>     /",
+            "- a\n\n  -     /",
+            "1. a\n\n   1.     /",
+            "<div>\n/",
+            "<!--\n/",
+            "<div>\n\n/",
+            "text\n\n---\n/",
+            "Some text <!-- hidden\n/",
+            "Some `<!--` text\n/",
+            "* a\n* b\n\n/",
+            "> quote\n/",
+        ];
+        for case in cases {
+            let lines: Vec<&str> = case.split('\n').collect();
+            let last = lines.len() - 1;
+            let start = lines[last].find('/').unwrap();
+            let parsed = parse_allows(&lines, last, start);
+            assert!(needs_parse(&lines) || parsed, "{case:?}");
+            assert_eq!(
+                markdown_text_at(lines.iter().copied(), last, start),
+                parsed,
+                "{case:?}"
+            );
+        }
+        // All lines of all cases at once, with one parse: as each line on its own
+        let joined = cases.join("\n\n");
+        let lines: Vec<&str> = joined.split('\n').collect();
+        let positions: Vec<(usize, usize)> = lines
+            .iter()
+            .enumerate()
+            .flat_map(|(i, line)| [(i, 0), (i, line.len() - line.trim_start().len())])
+            .collect();
+        let each: Vec<bool> = positions
+            .iter()
+            .map(|(line, start)| markdown_allows(lines.iter().copied(), *line, *start))
+            .collect();
+        assert_eq!(markdown_allows_all(&lines, &positions), each);
+        assert!(each.contains(&true) && each.contains(&false));
+        // Plain text skips the parse
+        assert!(!needs_parse(&[
+            "# Title",
+            "",
+            "Some text, a - b",
+            "- item",
+            "  /"
+        ]));
+    }
+}

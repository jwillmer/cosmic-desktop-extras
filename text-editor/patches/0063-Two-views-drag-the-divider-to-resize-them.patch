+
+/// The narrowest a view gets when the divider is dragged, in pixels.
+pub const MIN_VIEW_WIDTH: f32 = 240.0;
+
+/// The left view's share of `width` when the divider is at `ratio`, so that both views keep
+/// [`MIN_VIEW_WIDTH`]; an even split when the width cannot hold two such views.
+pub fn divider_ratio(ratio: f32, width: f32) -> f32 {
+    if !ratio.is_finite() || width < 2.0 * MIN_VIEW_WIDTH {
+        return 0.5;
+    }
+    let min = MIN_VIEW_WIDTH / width;
+    ratio.clamp(min, 1.0 - min)
 }
 

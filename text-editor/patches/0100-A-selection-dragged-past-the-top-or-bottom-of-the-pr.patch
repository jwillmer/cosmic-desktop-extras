+    #[test]
+    fn a_drag_past_an_edge_scrolls_faster_the_farther() {
+        assert_eq!(edge_scroll(100.0, 500.0, 300.0), 0.0);
+        assert_eq!(edge_scroll(100.0, 500.0, 100.0), 0.0);
+        assert!(edge_scroll(100.0, 500.0, 99.0) < 0.0);
+        assert!(edge_scroll(100.0, 500.0, 501.0) > 0.0);
+        assert!(edge_scroll(100.0, 500.0, 700.0) > edge_scroll(100.0, 500.0, 520.0));
+        assert!(edge_scroll(100.0, 500.0, -50.0) < edge_scroll(100.0, 500.0, 90.0));
+        assert_eq!(edge_scroll(100.0, 500.0, 5000.0), SCROLL_MAX);
+    }

+/// Pixels the preview scrolls per frame for each pixel the pointer is past its edge, and the
+/// least and most per frame.
+const SCROLL_RATE: f32 = 0.2;
+const SCROLL_MIN: f32 = 2.0;
+const SCROLL_MAX: f32 = 40.0;
+
+/// How far the preview, showing `top` to `bottom`, scrolls this frame with a drag at `y`:
+/// nothing inside, faster the farther past an edge.
+pub fn edge_scroll(top: f32, bottom: f32, y: f32) -> f32 {
+    let speed = |past: f32| (past * SCROLL_RATE).clamp(SCROLL_MIN, SCROLL_MAX);
+    if y < top {
+        -speed(top - y)
+    } else if y > bottom {
+        speed(y - bottom)
+    } else {
+        0.0
+    }
+}
+
+/// Around the preview's scrollable: while a selection is dragged past its top or bottom, it
+/// scrolls every frame and the selection follows to the text at that edge. Shares its content's
+/// state, as a container does, so the preview keeps its widget tree.
+pub struct DragEdge<'a, Message, Theme, Renderer> {
+    content: Element<'a, Message, Theme, Renderer>,
+    dragging: bool,
+    on_scroll: Box<dyn Fn(f32) -> Message + 'a>,
+}
+
+impl<'a, Message, Theme, Renderer> DragEdge<'a, Message, Theme, Renderer> {
+    pub fn new(
+        content: impl Into<Element<'a, Message, Theme, Renderer>>,
+        dragging: bool,
+        on_scroll: impl Fn(f32) -> Message + 'a,
+    ) -> Self {
+        Self {
+            content: content.into(),
+            dragging,
+            on_scroll: Box::new(on_scroll),
+        }
+    }
+}
+
+impl<Message, Theme, Renderer> Widget<Message, Theme, Renderer>
+    for DragEdge<'_, Message, Theme, Renderer>
+where
+    Renderer: cosmic::iced::advanced::Renderer,
+{
+    fn tag(&self) -> tree::Tag {
+        self.content.as_widget().tag()
+    }
+
+    fn state(&self) -> tree::State {
+        self.content.as_widget().state()
+    }
+
+    fn children(&self) -> Vec<Tree> {
+        self.content.as_widget().children()
+    }
+
+    fn diff(&mut self, tree: &mut Tree) {
+        self.content.as_widget_mut().diff(tree);
+    }
+
+    fn size(&self) -> Size<Length> {
+        self.content.as_widget().size()
+    }
+
+    fn size_hint(&self) -> Size<Length> {
+        self.content.as_widget().size_hint()
+    }
+
+    fn layout(
+        &mut self,
+        tree: &mut Tree,
+        renderer: &Renderer,
+        limits: &layout::Limits,
+    ) -> layout::Node {
+        self.content.as_widget_mut().layout(tree, renderer, limits)
+    }
+
+    fn draw(
+        &self,
+        tree: &Tree,
+        renderer: &mut Renderer,
+        theme: &Theme,
+        style: &renderer::Style,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        viewport: &Rectangle,
+    ) {
+        self.content
+            .as_widget()
+            .draw(tree, renderer, theme, style, layout, cursor, viewport);
+    }
+
+    fn operate(
+        &mut self,
+        tree: &mut Tree,
+        layout: Layout<'_>,
+        renderer: &Renderer,
+        operation: &mut dyn Operation,
+    ) {
+        self.content
+            .as_widget_mut()
+            .operate(tree, layout, renderer, operation);
+    }
+
+    fn update(
+        &mut self,
+        tree: &mut Tree,
+        event: &Event,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        renderer: &Renderer,
+        clipboard: &mut dyn Clipboard,
+        shell: &mut Shell<'_, Message>,
+        viewport: &Rectangle,
+    ) {
+        let bounds = layout.bounds();
+        let past_edge = cursor.land().position().filter(|pointer| {
+            self.dragging && !(bounds.y..bounds.y + bounds.height).contains(&pointer.y)
+        });
+        let Some(pointer) = past_edge else {
+            self.content.as_widget_mut().update(
+                tree, event, layout, cursor, renderer, clipboard, shell, viewport,
+            );
+            return;
+        };
+        // The text at the edge the pointer is past: the selection follows to it
+        let edge = Point::new(
+            pointer.x.clamp(bounds.x, bounds.x + bounds.width - 1.0),
+            pointer.y.clamp(bounds.y, bounds.y + bounds.height - 1.0),
+        );
+        let moved = Event::Mouse(mouse::Event::CursorMoved { position: edge });
+        let event = match event {
+            Event::Mouse(mouse::Event::CursorMoved { .. }) => {
+                shell.request_redraw();
+                &moved
+            }
+            Event::Window(cosmic::iced::window::Event::RedrawRequested(_)) => {
+                shell.publish((self.on_scroll)(edge_scroll(
+                    bounds.y,
+                    bounds.y + bounds.height,
+                    pointer.y,
+                )));
+                // Scrolled, the text under the edge changed
+                self.content.as_widget_mut().update(
+                    tree,
+                    &moved,
+                    layout,
+                    mouse::Cursor::Available(edge),
+                    renderer,
+                    clipboard,
+                    shell,
+                    viewport,
+                );
+                shell.request_redraw();
+                event
+            }
+            _ => event,
+        };
+        self.content.as_widget_mut().update(
+            tree,
+            event,
+            layout,
+            mouse::Cursor::Available(edge),
+            renderer,
+            clipboard,
+            shell,
+            viewport,
+        );
+    }
+
+    fn mouse_interaction(
+        &self,
+        tree: &Tree,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        viewport: &Rectangle,
+        renderer: &Renderer,
+    ) -> mouse::Interaction {
+        self.content
+            .as_widget()
+            .mouse_interaction(tree, layout, cursor, viewport, renderer)
+    }
+
+    fn overlay<'b>(
+        &'b mut self,
+        tree: &'b mut Tree,
+        layout: Layout<'b>,
+        renderer: &Renderer,
+        viewport: &Rectangle,
+        translation: Vector,
+    ) -> Option<overlay::Element<'b, Message, Theme, Renderer>> {
+        self.content
+            .as_widget_mut()
+            .overlay(tree, layout, renderer, viewport, translation)
+    }
+
+    fn id(&self) -> Option<Id> {
+        self.content.as_widget().id()
+    }
+
+    fn set_id(&mut self, id: Id) {
+        self.content.as_widget_mut().set_id(id);
+    }
+}
+
+impl<'a, Message, Theme, Renderer> From<DragEdge<'a, Message, Theme, Renderer>>
+    for Element<'a, Message, Theme, Renderer>
+where
+    Message: 'a,
+    Theme: 'a,
+    Renderer: cosmic::iced::advanced::Renderer + 'a,
+{
+    fn from(edge: DragEdge<'a, Message, Theme, Renderer>) -> Self {
+        Element::new(edge)
+    }
+}

+/// The pixel spans (x, width) of `block` on one layout row, by visual columns: a tab cut by an
+/// edge of the block is highlighted up to that edge only. Width 0 is the bar of a zero-width
+/// block.
+fn column_spans(run: &LayoutRun, block: &Block, tab_width: usize) -> Vec<(f32, f32)> {
+    if run.line_i < block.top() || run.line_i > block.bottom() {
+        return Vec::new();
+    }
+    let Some(range) = column_select::line_range(run.text, block.left(), block.right(), tab_width)
+    else {
+        return Vec::new();
+    };
+    let line = run.line_i;
+    // Where visual column `col` falls inside the tab reaching across it, on this row
+    let cut = |col: usize| {
+        let (i, w) = column_select::tab_across(run.text, col, tab_width)?;
+        let from = run.cursor_position(&Cursor::new(line, i))?;
+        let to = run.cursor_position(&Cursor::new(line, i + 1))?;
+        let into = (col - column_select::col_of(run.text, i, tab_width)) as f32 / w as f32;
+        Some((i, from + (to - from) * into))
+    };
+    let left_cut = cut(block.left());
+    if block.is_empty() || range.is_empty() && left_cut.is_none() {
+        let x = left_cut
+            .map(|(_, x)| x)
+            .or_else(|| run.cursor_position(&Cursor::new(line, range.start)));
+        return x.map(|x| vec![(x, 0.0)]).unwrap_or_default();
+    }
+    let right_cut = cut(block.right());
+    let start = left_cut.map_or(range.start, |(i, _)| i);
+    let (min, max) = (
+        left_cut.map_or(f32::MIN, |(_, x)| x),
+        right_cut.map_or(f32::MAX, |(_, x)| x),
+    );
+    run.highlight(Cursor::new(line, start), Cursor::new(line, range.end))
+        .filter_map(|(x, w)| {
+            let (from, to) = (x.max(min), (x + w).min(max));
+            (to > from).then_some((from, to - from))
+        })
+        .collect()
+}

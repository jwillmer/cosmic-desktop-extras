+    #[test]
+    fn column_highlight_covers_the_cut_part_of_a_tab() {
+        // Tab width 4: "a\tb" has the tab on columns 1..4, "b" on column 4
+        let mut editor = column_select::tests::editor("a\tb\nabcdef\n");
+        let mut font_system = crate::font_system().write().unwrap();
+        editor.borrow_with(font_system.raw()).shape_as_needed(true);
+        let spans = |left, right| {
+            let block = Block::new(Pos::new(0, left), Pos::new(1, right));
+            editor.with_buffer(|buffer| {
+                buffer
+                    .layout_runs()
+                    .map(|run| column_spans(&run, &block, 4))
+                    .collect::<Vec<_>>()
+            })
+        };
+        let col = |run: usize, col: usize| {
+            editor.with_buffer(|buffer| {
+                let run = buffer.layout_runs().nth(run).unwrap();
+                run.cursor_position(&Cursor::new(run.line_i, col)).unwrap()
+            })
+        };
+        let (tab_start, tab_end) = (col(0, 1), col(0, 2));
+        let third = |n: f32| tab_start + (tab_end - tab_start) * n / 3.0;
+        let close = |a: f32, b: f32| (a - b).abs() < 0.01;
+        // Columns 2..5: the last two thirds of the tab and the "b"
+        let rows = spans(2, 5);
+        let (x, w) = rows[0][0];
+        assert!(close(x, third(1.0)), "{rows:?}");
+        assert!(close(x + w, col(0, 3)), "{rows:?}");
+        assert!(close(rows[1][0].0, col(1, 2)));
+        // Columns 2..3: only the middle third of the tab
+        let rows = spans(2, 3);
+        let (x, w) = rows[0][0];
+        assert!(close(x, third(1.0)) && close(x + w, third(2.0)), "{rows:?}");
+        // A zero-width block inside the tab: the bar sits at the cut
+        let rows = spans(3, 3);
+        assert_eq!(rows[0].len(), 1);
+        assert!(close(rows[0][0].0, third(2.0)) && rows[0][0].1 == 0.0);
+    }

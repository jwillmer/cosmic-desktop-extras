+/// Whether opening the find bar turns "In selection" on for a selection of `chars` characters
+/// (see [`chars`]): only when the bar was closed (Ctrl+H with the bar open only shows the
+/// replace field), for a selection of at least [`AUTO_CHARS`], and never for the match the last
+/// find selected (it is a result, not a range to search).
+pub fn auto(chars: usize, bar_was_open: bool, last_hit: bool) -> bool {
+    chars >= AUTO_CHARS && !bar_was_open && !last_hit
+}
+
+/// How many characters the selection `start` to `end` holds, a line break counting as one,
+/// counted no further than [`AUTO_CHARS`]. `lines` are the text's lines from `start`'s on.
+pub fn chars<'a>(lines: impl IntoIterator<Item = &'a str>, start: Pos, end: Pos) -> usize {
+    let mut count = 0;
+    for (line, text) in (start.0..=end.0).zip(lines) {
+        let from = if line == start.0 { start.1 } else { 0 };
+        let to = if line == end.0 { end.1 } else { text.len() };
+        let part = text.get(from..to).unwrap_or_default();
+        count += part.chars().take(AUTO_CHARS - count).count();
+        if line != end.0 {
+            count += 1;
+        }
+        if count >= AUTO_CHARS {
+            return AUTO_CHARS;
+        }
+    }
+    count
+}
+
+/// Where the range `range` is after one edit (the start and end of the replaced text and the
+/// text put there): an edit inside it moves its end, one before it the whole range, one after
+/// it nothing. `None` for an edit over one of its ends: the range no longer covers what was
+/// selected.
+pub fn edited((from, to): (Pos, Pos), edit: (Pos, Pos, &str)) -> Option<(Pos, Pos)> {
+    let (start, end, _) = edit;
+    if start >= from && end <= to {
+        Some((from, shift(to, &[edit])))
+    } else if end <= from {
+        Some((shift(from, &[edit]), shift(to, &[edit])))
+    } else if start >= to {
+        Some((from, to))
+    } else {
+        None
+    }
 }
 

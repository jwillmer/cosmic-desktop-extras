+    #[test]
+    fn two_different_drafts_are_not_mirrored() {
+        let (path, mut a, mut b) = tabs("drafts", "milk\n");
+        type_at(&a, Cursor::new(0, 0), "oat ");
+        type_at(&b, Cursor::new(0, 4), " and honey");
+        let outcome = sync(&mut [&mut a, &mut b], None, 0);
+        assert!(outcome.diverged);
+        assert_eq!(text(&a), "oat milk\n");
+        assert_eq!(text(&b), "milk and honey\n");
+        assert!(a.changed() && b.changed());
+        let _ = std::fs::remove_dir_all(path.parent().unwrap());
+    }
+
+    #[test]
+    fn reload_acts_on_the_whole_clone_group() {
+        let (path, mut a, mut b) = tabs("reload", "milk\n");
+        let synced = sync(&mut [&mut a, &mut b], None, 0).hash;
+        type_at(&a, Cursor::new(0, 0), "oat ");
+        let synced = sync(&mut [&mut a, &mut b], Some(synced), 0).hash;
+        std::fs::write(&path, "bread\n").unwrap();
+        // Reload from b's bar: both tabs take the file, nothing is mirrored as an edit
+        reload_group(&mut [&mut a, &mut b]);
+        assert_eq!(text(&a), "bread\n");
+        assert_eq!(text(&b), "bread\n");
+        assert!(!a.changed() && !b.changed());
+        let outcome = sync(&mut [&mut a, &mut b], Some(synced), 1);
+        assert_eq!(outcome.mirrored, Vec::<usize>::new());
+        // Undo in a brings back its own edit, not b's
+        a.editor.lock().unwrap().undo();
+        assert_eq!(text(&a), "oat milk\n");
+        let _ = std::fs::remove_dir_all(path.parent().unwrap());
+    }

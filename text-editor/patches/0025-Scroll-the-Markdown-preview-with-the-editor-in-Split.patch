+    /// Where to scroll the preview so it shows editor line `line` at the top.
+    fn sync_offset(&self, line: usize) -> SyncOffset {
+        let fraction = map::preview_fraction(&self.blocks, line);
+        if self.content_height <= 0.0 {
+            return SyncOffset::Relative(fraction);
+        }
+        let max = (self.content_height - self.viewport_height).max(0.0);
+        SyncOffset::Absolute((fraction * self.content_height).min(max))
+    }

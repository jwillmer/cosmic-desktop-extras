+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Where things sit in the Markdown source, by line: the top-level blocks, so the Split view can
+//! scroll the preview to the part the editor shows.
+//!
+//! The preview widget does not report where it draws each block, so the preview position is an
+//! estimate: every block counts its source lines plus one line of spacing, and blank lines between
+//! blocks count nothing. Wrapped paragraphs, images, tables and closed `<details>` are taller or
+//! shorter than their source, so the match is close at block starts and drifts inside long blocks.
+
+use pulldown_cmark::{Event, Parser, Tag};
+use std::ops::Range;
+
+use super::html::OPTIONS;
+
+/// Space between two rendered blocks, in source lines.
+const BLOCK_GAP: f32 = 1.0;
+
+/// Line index of every line start, to turn byte offsets into lines.
+struct Lines(Vec<usize>);
+
+impl Lines {
+    fn new(text: &str) -> Self {
+        Self(
+            std::iter::once(0)
+                .chain(text.match_indices('\n').map(|(index, _)| index + 1))
+                .collect(),
+        )
+    }
+
+    fn line(&self, offset: usize) -> usize {
+        self.0.partition_point(|&start| start <= offset) - 1
+    }
+
+    /// Lines covered by a byte range, end exclusive.
+    fn range(&self, bytes: &Range<usize>) -> Range<usize> {
+        let start = self.line(bytes.start);
+        let end = self.line(bytes.end.saturating_sub(1).max(bytes.start)) + 1;
+        start..end
+    }
+}
+
+/// Source lines of each top-level block that shows in the preview, in order. Front matter and
+/// footnote definitions (drawn at the end) are left out.
+pub fn block_lines(text: &str) -> Vec<Range<usize>> {
+    let lines = Lines::new(text);
+    let mut blocks = Vec::new();
+    let mut depth = 0usize;
+    for (event, range) in Parser::new_ext(text, OPTIONS).into_offset_iter() {
+        match event {
+            Event::Start(tag) => {
+                if depth == 0 && !matches!(tag, Tag::MetadataBlock(_) | Tag::FootnoteDefinition(_))
+                {
+                    blocks.push(lines.range(&range));
+                }
+                depth += 1;
+            }
+            Event::End(_) => depth = depth.saturating_sub(1),
+            _ if depth == 0 => blocks.push(lines.range(&range)),
+            _ => {}
+        }
+    }
+    blocks
+}
+
+/// Index of the block that holds `line`; a line between blocks belongs to the next one. `None`
+/// after the last block.
+pub fn block_at(blocks: &[Range<usize>], line: usize) -> Option<usize> {
+    let index = blocks.partition_point(|block| block.end <= line);
+    (index < blocks.len()).then_some(index)
+}
+
+fn weight(block: &Range<usize>) -> f32 {
+    block.len() as f32 + BLOCK_GAP
+}
+
+/// How far down the preview `line` of the source is drawn, from 0 (top) to 1 (end).
+pub fn preview_fraction(blocks: &[Range<usize>], line: usize) -> f32 {
+    let total: f32 = blocks.iter().map(weight).sum();
+    let Some(index) = block_at(blocks, line) else {
+        return 1.0;
+    };
+    let block = &blocks[index];
+    let before: f32 = blocks[..index].iter().map(weight).sum();
+    let inside = line.saturating_sub(block.start) as f32;
+    (before + inside) / total
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const DOC: &str =
+        "# Title\n\nFirst paragraph\nstill first.\n\n```\ncode\ncode\n```\n\n- a\n- b\n";
+
+    #[test]
+    fn finds_top_level_blocks() {
+        assert_eq!(block_lines(DOC), vec![0..1, 2..4, 5..9, 10..12]);
+        // Front matter is hidden in the preview
+        assert_eq!(block_lines("---\na: 1\n---\n\nText\n"), vec![4..5]);
+    }
+
+    #[test]
+    fn editor_line_maps_to_containing_block() {
+        let blocks = block_lines(DOC);
+        assert_eq!(block_at(&blocks, 0), Some(0));
+        assert_eq!(block_at(&blocks, 3), Some(1));
+        // The blank line before the code block belongs to it
+        assert_eq!(block_at(&blocks, 4), Some(2));
+        assert_eq!(block_at(&blocks, 7), Some(2));
+        // Weights 2, 3, 5, 3: the code block starts 5/13 down, its second line one more
+        assert_eq!(preview_fraction(&blocks, 5), 5.0 / 13.0);
+        assert_eq!(preview_fraction(&blocks, 6), 6.0 / 13.0);
+        assert_eq!(preview_fraction(&blocks, 0), 0.0);
+        let mut last = 0.0;
+        for line in 0..12 {
+            let fraction = preview_fraction(&blocks, line);
+            assert!(fraction >= last, "line {line} goes back up");
+            last = fraction;
+        }
+    }
+
+    #[test]
+    fn lines_after_last_block_map_to_end() {
+        let blocks = block_lines(DOC);
+        assert_eq!(block_at(&blocks, 12), None);
+        assert_eq!(preview_fraction(&blocks, 12), 1.0);
+        assert_eq!(preview_fraction(&blocks, 500), 1.0);
+        assert_eq!(preview_fraction(&[], 0), 1.0);
+    }
+}

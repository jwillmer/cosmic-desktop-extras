From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Fri, 20 Nov 2026 01:17:34 +0100
Subject: [PATCH 150/151] Find: F3 and Shift+F3 work from the find and replace
 fields, as in Notepad++

A focused text field used every key it got, F3 included, so the find keys
(F3, Shift+F3, Ctrl+F3, Ctrl+Shift+F3) only acted with focus in the text.
A named key a field used now still runs a find key bound to it while the
find bar is open; focus stays in the field. Typed text and the field's own
shortcuts stay with the field, and a key the text used never comes this
way, so a find key does not act twice.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main.rs b/src/main.rs
index c195659..e3d5448 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -512,6 +512,14 @@ pub enum Message {
     FindDotMatchesNewline(bool),
     FindExtended(bool),
     FindFocused(bool),
+    /// A named key a focused field used, in a window: the find keys (F3 and its variants) still
+    /// act from the find bar's fields, as in Notepad++
+    FindFieldKey(
+        window::Id,
+        Modifiers,
+        keyboard::key::Physical,
+        keyboard::Key,
+    ),
     FindInSelection(bool),
     FindNext,
     FindPrevious,
@@ -2667,6 +2675,39 @@ impl App {
                 config_set!(find_extended, find_extended);
                 return self.update_config();
             }
+            Message::FindFieldKey(window_id, modifiers, physical, key) => {
+                // Only from the find bar: a dialog, a menu or the settings keep their keys. A key
+                // the text used never comes here, so a find key never acts twice.
+                if self.find_opt.is_none()
+                    || Some(window_id) != self.core.main_window_id()
+                    || !self.surfaces.is_empty()
+                    || self.dialog_page_opt.is_some()
+                    || self.context_page_modal()
+                {
+                    return Task::none();
+                }
+                let action = self.key_binds.iter().find_map(|(key_bind, action)| {
+                    (matches!(
+                        action,
+                        Action::FindNext
+                            | Action::FindPrevious
+                            | Action::FindWordNext
+                            | Action::FindWordPrevious
+                    ) && key_bind.matches(modifiers, &key, Some(&physical)))
+                    .then_some(action)
+                });
+                let Some(action) = action else {
+                    return Task::none();
+                };
+                // Without a query F3 would open the bar again: it is open, so nothing to do
+                if matches!(action, Action::FindNext | Action::FindPrevious)
+                    && self.find_search_value.is_empty()
+                {
+                    return Task::none();
+                }
+                // Focus stays in the field, as in Notepad++: the action's refocus is dropped
+                let _ = self.update(action.message(None));
+            }
             Message::FindInSelection(on) => {
                 self.find_range = None;
                 if on {
@@ -4904,7 +4945,16 @@ impl Application for App {
                         key,
                         text.map(|text| text.to_string()),
                     )),
-                    event::Status::Captured => None,
+                    // Only named keys (F3): typed text stays with the field
+                    event::Status::Captured => match key {
+                        keyboard::Key::Named(_) => Some(Message::FindFieldKey(
+                            window_id,
+                            modifiers,
+                            physical_key,
+                            key,
+                        )),
+                        _ => None,
+                    },
                 },
                 event::Event::Keyboard(keyboard::Event::ModifiersChanged(modifiers)) => {
                     Some(Message::Modifiers(modifiers))

+
+#[cfg(test)]
+mod tests {
+    use super::Config;
+
+    fn config(case: bool, regex: bool, whole_word: bool, dot: bool) -> Config {
+        Config {
+            find_case_sensitive: case,
+            find_use_regex: regex,
+            find_whole_word: whole_word,
+            find_dot_matches_newline: dot,
+            ..Config::default()
+        }
+    }
+
+    fn matches(config: &Config, pattern: &str, haystack: &str) -> Vec<String> {
+        config
+            .find_regex(pattern)
+            .unwrap()
+            .find_iter(haystack)
+            .map(|m| m.as_str().to_string())
+            .collect()
+    }
+
+    #[test]
+    fn plain_matches_inside_words() {
+        let c = config(false, false, false, false);
+        assert_eq!(matches(&c, "cat", "cat concat cat."), ["cat", "cat", "cat"]);
+        // Normal mode escapes regex syntax
+        assert_eq!(matches(&c, "a.c", "abc a.c"), ["a.c"]);
+    }
+
+    #[test]
+    fn whole_word_normal() {
+        let c = config(false, false, true, false);
+        assert_eq!(matches(&c, "cat", "cat concat cat."), ["cat", "cat"]);
+        assert_eq!(matches(&c, "cat", "cats _cat cat_ cat"), ["cat"]);
+        assert!(matches(&c, "cat", "concatenate").is_empty());
+        // Whole word plus escaping: `.` stays literal
+        assert_eq!(matches(&c, "a.c", "abc a.c xa.c"), ["a.c"]);
+    }
+
+    #[test]
+    fn whole_word_non_word_edges() {
+        let c = config(false, false, true, false);
+        // Leading non-word char: no word boundary needed before it
+        assert_eq!(matches(&c, ".foo", "file.foo"), [".foo"]);
+        assert!(matches(&c, ".foo", "file.food").is_empty());
+        // Trailing non-word char: no word boundary needed after it
+        assert_eq!(matches(&c, "foo-", "foo-bar"), ["foo-"]);
+        assert!(matches(&c, "foo-", "xfoo-bar").is_empty());
+        // Only non-word chars: matches anywhere
+        assert_eq!(matches(&c, "--", "a--b"), ["--"]);
+        // Non-ASCII word chars count as word chars
+        assert!(matches(&c, "cat", "écat").is_empty());
+    }
+
+    #[test]
+    fn whole_word_regex() {
+        let c = config(false, true, true, false);
+        assert_eq!(matches(&c, "ca[tr]", "cat car scar cart"), ["cat", "car"]);
+        // Alternation is grouped, so the boundary applies to every branch
+        assert_eq!(matches(&c, "cat|dog", "cat dogs dog"), ["cat", "dog"]);
+        assert_eq!(matches(&c, r"\.foo", "file.foo file.food"), [".foo"]);
+        assert_eq!(matches(&c, r"\d+", "a1 22 3b 44"), ["22", "44"]);
+    }
+
+    #[test]
+    fn case_sensitivity() {
+        let insensitive = config(false, false, false, false);
+        assert_eq!(matches(&insensitive, "Cat", "cat CAT"), ["cat", "CAT"]);
+        let sensitive = config(true, false, false, false);
+        assert_eq!(matches(&sensitive, "Cat", "cat Cat CAT"), ["Cat"]);
+        let sensitive_word_regex = config(true, true, true, false);
+        assert_eq!(
+            matches(&sensitive_word_regex, "C.t", "Cat cat Cats Cut"),
+            ["Cat", "Cut"]
+        );
+        let insensitive_word = config(false, false, true, false);
+        assert_eq!(matches(&insensitive_word, "CAT", "Cat concat"), ["Cat"]);
+    }
+
+    #[test]
+    fn dot_matches_newline_regex_only() {
+        let off = config(false, true, false, false);
+        assert_eq!(matches(&off, "a.b", "a\nb axb"), ["axb"]);
+        let on = config(false, true, false, true);
+        assert_eq!(matches(&on, "a.b", "a\nb axb"), ["a\nb", "axb"]);
+        // Multi-line: ^ and $ match at line starts and ends
+        assert_eq!(matches(&on, "^b$", "a\nb\nc"), ["b"]);
+        assert!(matches(&off, "^b$", "a\nb\nc").is_empty());
+        // Ignored in normal mode: `.` is escaped there anyway
+        let normal = config(false, false, false, true);
+        assert!(matches(&normal, "a.b", "a\nb").is_empty());
+        // Combines with whole word
+        let on_word = config(false, true, true, true);
+        assert_eq!(matches(&on_word, "a.b", "a\nb xa\nb"), ["a\nb"]);
+    }
+}

+++ b/i18n/en/cosmic_edit.ftl
@@ -71,7 +71,9 @@ replace-placeholder = Replace...
 replace = Replace
 replace-all = Replace all
 case-sensitive = Case sensitive
+whole-word = Match whole word
 use-regex = Use regex
+dot-matches-newline = . matches newline
 wrap-around = Wrap around
 
 # Menu

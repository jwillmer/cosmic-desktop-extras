From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Fri, 20 Nov 2026 10:16:51 +0100
Subject: [PATCH 09/10] Our text box, menu, key and message code

The text box drawing and keys, underlined links that open on double-click, scrolling along with a mouse selection, our menus, key bindings and update arms, kept in our own files next to the upstream ones they extend.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/app_update.rs b/src/app_update.rs
new file mode 100644
index 0000000..c62edb0
--- /dev/null
+++ b/src/app_update.rs
@@ -0,0 +1,418 @@
+//! Our messages in [`App::update`]: the arms for the messages upstream does not have, so
+//! upstream's `update` keeps one hook arm and its own arms.
+
+use super::*;
+
+impl App {
+    /// Handle one of our messages; upstream's `update` hands over the messages it has no
+    /// arm for.
+    pub(crate) fn update_ext(&mut self, message: Message) -> Task<Message> {
+        // Helper for updating config values efficiently
+        macro_rules! config_set {
+            ($name: ident, $value: expr) => {
+                match &self.config_handler {
+                    Some(config_handler) => {
+                        if let Err(err) =
+                            paste::paste! { self.config.[<set_ $name>](config_handler, $value) }
+                        {
+                            log::warn!("failed to save config {:?}: {}", stringify!($name), err);
+                        }
+                    }
+                    None => {
+                        self.config.$name = $value;
+                        log::warn!(
+                            "failed to save config {:?}: no config handler",
+                            stringify!($name)
+                        );
+                    }
+                }
+            };
+        }
+        match message {
+            Message::CloseTabs(message) => return self.update_close_tabs(message),
+            Message::Views(message) => return self.update_views(message),
+            Message::FindResults(message) => return self.update_find_results(message),
+            Message::FindFiles(message) => return self.update_find_files(message),
+            Message::FindAgain(forwards) => {
+                // The query outlives the Find dialog, so this works with the dialog closed
+                if self.find_search_value.is_empty() {
+                    return self.update(Message::Find(Some(false)));
+                }
+                return self.update(if forwards {
+                    Message::FindNext
+                } else {
+                    Message::FindPrevious
+                });
+            }
+            Message::FindWord(forwards) => {
+                let Some(Tab::Editor(tab)) = self.active_tab() else {
+                    return Task::none();
+                };
+                let query = {
+                    let mut editor = tab.editor.lock().unwrap();
+                    let range = match editor.selection_bounds() {
+                        Some((start, end)) if start.line == end.line && start.index < end.index => {
+                            Some((start.line, start.index..end.index))
+                        }
+                        _ => {
+                            let cursor = editor.cursor();
+                            editor.with_buffer(|buffer| {
+                                buffer.lines.get(cursor.line).and_then(|line| {
+                                    find_word::word_at(line.text(), cursor.index)
+                                        .map(|range| (cursor.line, range))
+                                })
+                            })
+                        }
+                    };
+                    range.map(|(line, range)| {
+                        // Select it the way a search does (cursor at the start), so the search
+                        // skips it and moves on to the next or previous occurrence
+                        editor.set_cursor(Cursor::new(line, range.start));
+                        editor.set_selection(Selection::Normal(Cursor::new(line, range.end)));
+                        editor.with_buffer(|buffer| buffer.lines[line].text()[range].to_string())
+                    })
+                };
+                let Some(query) = query else {
+                    return Task::none();
+                };
+                self.find_search_value = if self.config.find_use_regex {
+                    regex::escape(&query)
+                } else if self.config.find_extended {
+                    // Its backslashes are text, not escapes
+                    query.replace('\\', "\\\\")
+                } else {
+                    query
+                };
+                // As typed in the find field, but counted at once: nothing is being typed
+                // The Find dialog stays as it is, as in Notepad++: typing goes on in the text, and
+                // F3 works from there with this query
+                let _ = self.find_query_changed(true);
+                return self.update(if forwards {
+                    Message::FindNext
+                } else {
+                    Message::FindPrevious
+                });
+            }
+            Message::FindDotMatchesNewline(find_dot_matches_newline) => {
+                config_set!(find_dot_matches_newline, find_dot_matches_newline);
+                return self.update_config();
+            }
+            Message::FindExtended(find_extended) => {
+                config_set!(find_extended, find_extended);
+                return self.update_config();
+            }
+            Message::FindFieldKey(window_id, modifiers, physical, key) => {
+                // Only from the find fields: a dialog, a menu or the settings keep their keys. A key
+                // the text used never comes here, so a find key never acts twice.
+                if self.find_opt.is_none()
+                    || (Some(window_id) != self.core.main_window_id()
+                        && !self.is_find_window(window_id))
+                    || !self.surfaces.is_empty()
+                    || self.dialog_page_opt.is_some()
+                    || self.context_page_modal()
+                {
+                    return Task::none();
+                }
+                let action = self.key_binds.iter().find_map(|(key_bind, action)| {
+                    (matches!(
+                        action,
+                        Action::FindNext
+                            | Action::FindPrevious
+                            | Action::FindWordNext
+                            | Action::FindWordPrevious
+                    ) && key_bind.matches(modifiers, &key, Some(&physical)))
+                    .then_some(action)
+                });
+                let Some(action) = action else {
+                    return Task::none();
+                };
+                // Without a query F3 would open the dialog again: it is open, so nothing to do
+                if matches!(action, Action::FindNext | Action::FindPrevious)
+                    && self.find_search_value.is_empty()
+                {
+                    return Task::none();
+                }
+                // Focus stays in the field, as in Notepad++: the action's refocus is dropped
+                let _ = self.update(action.message(None));
+            }
+            Message::FindInSelection(on) => {
+                self.find_in_selection = on;
+            }
+            Message::FindCountQuery(query) => {
+                // Another key in the find field since: its own pause counts
+                if query == self.find_query {
+                    self.find_query_settled = query;
+                }
+            }
+            Message::FindWholeWord(find_whole_word) => {
+                config_set!(find_whole_word, find_whole_word);
+                return self.update_config();
+            }
+            Message::GotoLine(value_opt) => {
+                self.goto_line_opt = value_opt.map(|value| GotoLineField {
+                    value,
+                    has_focus: true,
+                    invalid: false,
+                });
+                // The Find dialog stays open, as in Notepad++; the bar takes the keyboard
+                if self.goto_line_opt.is_some()
+                    && let Some(find) = self.find_opt.as_mut()
+                {
+                    find.has_focus = false;
+                }
+                return self.update_focus();
+            }
+            Message::GotoLineValueChanged(value) => {
+                if let Some(goto) = self.goto_line_opt.as_mut() {
+                    goto.value = value;
+                    goto.invalid = false;
+                }
+            }
+            Message::GotoLineSubmit => {
+                let Some(goto) = self.goto_line_opt.as_mut() else {
+                    return Task::none();
+                };
+                let Some(target) = goto_line::parse(&goto.value) else {
+                    goto.invalid = true;
+                    return self.update_focus();
+                };
+                self.goto_line_opt = None;
+                let mut tasks = Vec::with_capacity(3);
+                // The Preview view hides the cursor: show the source beside it
+                let switch = goto_line::view_for_jump(self.active_markdown_view());
+                if let Some(mode) = switch {
+                    tasks.push(self.update_markdown(markdown::Message::SetView(mode)));
+                }
+                if let Some(Tab::Editor(tab)) = self.active_tab() {
+                    let mut editor = tab.editor.lock().unwrap();
+                    let cursor = editor.with_buffer_mut(|buffer| {
+                        let line = goto_line::clamp_line(target.line, buffer.lines.len());
+                        let index = target.column.map_or(0, |column| {
+                            goto_line::byte_index(line, buffer.lines[line].text(), column)
+                        });
+                        // A line inside a fold is shown, as for a find hit
+                        folding::reveal(buffer, line);
+                        // The editor that just came back does not scroll to its cursor on its
+                        // own: put the line at its top, as the outline does
+                        if switch.is_some() {
+                            buffer.set_scroll(cosmic_text::Scroll::new(line, 0.0, 0.0));
+                        }
+                        cosmic_text::Cursor::new(line, index)
+                    });
+                    editor.set_selection(Selection::None);
+                    // A column block left active would still show and take the column keys
+                    *tab.column.lock().unwrap() = None;
+                    editor.set_cursor(cursor);
+                }
+                tasks.push(self.update_focus());
+                // In the Split view the preview follows the editor's new scroll
+                tasks.push(self.update_markdown(markdown::Message::SyncScroll));
+                return Task::batch(tasks);
+            }
+            Message::Markdown(message) => return self.update_markdown(message),
+            Message::MarkdownFormat(format) => {
+                if let Some(Tab::Editor(tab)) = self.active_tab()
+                    && md_format::enabled(tab.markdown_view())
+                {
+                    {
+                        let mut editor = tab.editor.lock().unwrap();
+                        *tab.column.lock().unwrap() = None;
+                        folding::reveal_selection(&mut *editor);
+                        md_format::apply(&mut editor, format);
+                    }
+                    return Task::batch([
+                        self.update(Message::TabChanged(self.tab_model.active())),
+                        self.focus_text_box(),
+                    ]);
+                }
+            }
+            Message::Session(message) => return self.update_session(message),
+            Message::Sidebar(message) => return self.update_sidebar(message),
+            Message::ChangeHistory(message) => return self.update_change_history(message),
+            Message::DiskChange(message) => return self.update_disk_change(message),
+            Message::TabFile(message) => return self.update_tab_file(message),
+            Message::Json(message) => {
+                let from_menu = matches!(
+                    message,
+                    json_tools::Message::Format
+                        | json_tools::Message::Minify
+                        | json_tools::Message::Validate
+                );
+                let task = self.update_json(message);
+                return if from_menu {
+                    Task::batch([task, self.focus_text_box()])
+                } else {
+                    task
+                };
+            }
+            Message::Folding(message) => return self.update_folding(message),
+            Message::CompareWithSaved(entity_opt) => return self.compare_with_saved(entity_opt),
+            Message::CompareTabs(left, right) => return self.compare_tabs(left, right),
+            Message::TabEdited(entity) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                    let generation = tab.edited();
+                    return status_count_after_pause(entity, Some(generation));
+                }
+            }
+            Message::StatusBarRefresh => {}
+            Message::LineEndingNoteEnd(conversion) => {
+                if self
+                    .line_ending_note
+                    .is_some_and(|(_, _, shown)| shown == conversion)
+                {
+                    self.line_ending_note = None;
+                }
+            }
+            Message::StatusBarCount(entity, generation) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                    tab.generation.paused(generation);
+                }
+            }
+            Message::ToggleSyncScrollViews => {
+                config_set!(sync_scroll_views, !self.config.sync_scroll_views);
+                return Task::batch([self.update_config(), self.focus_text_box()]);
+            }
+            Message::ToggleShowLineEndings => {
+                config_set!(show_line_endings, !self.config.show_line_endings);
+                return Task::batch([self.update_config(), self.focus_text_box()]);
+            }
+            Message::ToggleShowWhitespace => {
+                config_set!(show_whitespace, !self.config.show_whitespace);
+                return Task::batch([self.update_config(), self.focus_text_box()]);
+            }
+            Message::ToggleStatusBar(show) => {
+                config_set!(
+                    show_status_bar,
+                    show.unwrap_or(!self.config.show_status_bar)
+                );
+                return self.update_config();
+            }
+            Message::ConvertLineEndings(ending) => {
+                if let Some(Tab::Editor(tab)) = self.active_tab() {
+                    let converted = {
+                        let mut editor = tab.editor.lock().unwrap();
+                        whitespace::convert_line_endings(&mut *editor, ending)
+                    };
+                    if converted {
+                        let entity = self.tab_model.active();
+                        self.line_ending_conversions += 1;
+                        let conversion = self.line_ending_conversions;
+                        self.line_ending_note = Some((entity, ending, conversion));
+                        return Task::batch([
+                            self.update(Message::TabChanged(entity)),
+                            self.focus_text_box(),
+                            Task::perform(time::sleep(LINE_ENDING_NOTE_TIME), move |()| {
+                                action::app(Message::LineEndingNoteEnd(conversion))
+                            }),
+                        ]);
+                    }
+                }
+                return self.focus_text_box();
+            }
+            Message::DismissPlain(entity) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                    tab.plain_notice = None;
+                }
+            }
+            Message::SurfaceOpened(id, open) => {
+                // The Find dialog is no menu: typing in the editor goes on while it is open
+                if open && Some(id) != self.core.main_window_id() && !self.is_find_window(id) {
+                    self.surfaces.insert(id);
+                } else {
+                    self.surfaces.remove(&id);
+                }
+            }
+            other => log::error!("unhandled message {:?}", other),
+        }
+
+        Task::none()
+    }
+
+    /// A tick of a drag selection held past an edge of the text: scroll the active editor and
+    /// move the selection end along.
+    pub(crate) fn auto_scroll_tick(&mut self) {
+        let Some(auto_scroll) = self.auto_scroll else {
+            return;
+        };
+        // The tab changed or closed during the drag: its release went elsewhere
+        if auto_scroll
+            .tab
+            .is_some_and(|tab| tab != self.tab_model.active())
+        {
+            self.auto_scroll = None;
+            return;
+        }
+        if let Some(Tab::Editor(tab)) = self.active_tab_mut() {
+            let mut editor = tab.editor.lock().unwrap();
+            let mut font_system = font_system().write().unwrap();
+            auto_scroll.tick(&mut editor.borrow_with(font_system.raw()), &tab.column);
+        }
+    }
+}
+
+impl Action {
+    /// The message of one of our actions; [`Action::message`] hands over the actions it has no
+    /// arm for.
+    pub(crate) fn message_ext(&self, entity_opt: Option<Entity>) -> Message {
+        match self {
+            Self::CloseAllTabs => {
+                close_tabs::Message::Request(close_tabs::Scope::All, entity_opt).into()
+            }
+            Self::CloseOtherTabs => {
+                close_tabs::Message::Request(close_tabs::Scope::Others, entity_opt).into()
+            }
+            Self::CloseTabsToRight => {
+                close_tabs::Message::Request(close_tabs::Scope::ToTheRight, entity_opt).into()
+            }
+            Self::CloneToOtherView => views::Message::Clone(entity_opt).into(),
+            Self::CompareViews => Message::CompareTabs(None, None),
+            Self::CompareWithSaved => Message::CompareWithSaved(entity_opt),
+            Self::CompareWithTab(pos) => Message::CompareTabs(entity_opt, Some(*pos)),
+            Self::MoveToOtherView => views::Message::Move(entity_opt).into(),
+            Self::ToggleSyncScrollViews => Message::ToggleSyncScrollViews,
+            Self::FindInFiles => find_files::Message::Open.into(),
+            Self::ToggleSearchResults => Message::FindResults(find_results::Message::TogglePanel),
+            Self::FindNext => Message::FindAgain(true),
+            Self::FindPrevious => Message::FindAgain(false),
+            Self::FindWordNext => Message::FindWord(true),
+            Self::FindWordPrevious => Message::FindWord(false),
+            Self::GotoLine => goto_line::open(),
+            Self::Fold => folding::Message::Fold.into(),
+            Self::FoldAll => folding::Message::FoldAll.into(),
+            Self::Unfold => folding::Message::Unfold.into(),
+            Self::UnfoldAll => folding::Message::UnfoldAll.into(),
+            Self::JsonFormat => json_tools::Message::Format.into(),
+            Self::JsonMinify => json_tools::Message::Minify.into(),
+            Self::JsonValidate => json_tools::Message::Validate.into(),
+            Self::MarkdownTogglePreview => markdown::Message::TogglePreview.into(),
+            Self::MarkdownToggleSplit => markdown::Message::ToggleSplit.into(),
+            Self::MarkdownToggleSyncScroll => markdown::Message::ToggleSyncScroll.into(),
+            Self::MarkdownToggleOutline => markdown::Message::ToggleOutline.into(),
+            Self::MarkdownView(mode) => markdown::Message::SetView(*mode).into(),
+            Self::MarkdownBold => Message::MarkdownFormat(md_format::Style::Bold.into()),
+            Self::MarkdownItalic => Message::MarkdownFormat(md_format::Style::Italic.into()),
+            Self::MarkdownStrikethrough => {
+                Message::MarkdownFormat(md_format::Style::Strikethrough.into())
+            }
+            Self::MarkdownCode => Message::MarkdownFormat(md_format::Style::Code.into()),
+            Self::MarkdownLink => Message::MarkdownFormat(md_format::Format::Link),
+            Self::MarkdownHeading(level) => {
+                Message::MarkdownFormat(md_format::Format::Heading(*level))
+            }
+            Self::MarkdownToggleTask => Message::MarkdownFormat(md_format::Format::ToggleTask),
+            Self::MarkdownFormatTable => Message::MarkdownFormat(md_format::Format::Table),
+            Self::ToggleMarkdownShortcuts => {
+                Message::ToggleContextPage(ContextPage::MarkdownShortcuts)
+            }
+            Self::ToggleShowLineEndings => Message::ToggleShowLineEndings,
+            Self::ToggleShowWhitespace => Message::ToggleShowWhitespace,
+            Self::ToggleStatusBar => Message::ToggleStatusBar(None),
+            Self::ConvertToCrlf => Message::ConvertLineEndings(LineEnding::CrLf),
+            Self::ConvertToLf => Message::ConvertLineEndings(LineEnding::Lf),
+            other => {
+                log::error!("unhandled action {:?}", other);
+                Message::NoOp
+            }
+        }
+    }
+}
diff --git a/src/key_bind_ext.rs b/src/key_bind_ext.rs
new file mode 100644
index 0000000..c302670
--- /dev/null
+++ b/src/key_bind_ext.rs
@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Our key bindings and the shortcut texts the Markdown help shows, added to upstream's map by
+//! `key_bind::key_binds`.
+
+use cosmic::iced::core::keyboard::key::{Code, Named, Physical};
+use cosmic::iced::keyboard::{Key, Modifiers};
+use cosmic::widget::menu::key_bind::{KeyBind, Modifier};
+use std::collections::HashMap;
+
+use crate::Action;
+use crate::markdown::ViewMode;
+
+/// The shortcuts of the Markdown commands as the "/" menu and the Markdown shortcuts panel show
+/// them, written like the menus write them (a test checks them against the bindings below).
+pub const BOLD_SHORTCUT: &str = "Ctrl + B";
+pub const ITALIC_SHORTCUT: &str = "Ctrl + I";
+pub const STRIKETHROUGH_SHORTCUT: &str = "Ctrl + Shift + X";
+pub const CODE_SHORTCUT: &str = "Ctrl + `";
+pub const LINK_SHORTCUT: &str = "Ctrl + K";
+pub const TASK_SHORTCUT: &str = "Ctrl + Enter";
+pub const HEADING_SHORTCUTS: [&str; 6] = [
+    "Ctrl + Shift + 1",
+    "Ctrl + Shift + 2",
+    "Ctrl + Shift + 3",
+    "Ctrl + Shift + 4",
+    "Ctrl + Shift + 5",
+    "Ctrl + Shift + 6",
+];
+pub const PLAIN_TEXT_SHORTCUT: &str = "Ctrl + Shift + 0";
+/// Opens the Markdown shortcuts panel; F1 is the usual help key and free in the editor.
+pub const MARKDOWN_SHORTCUTS_SHORTCUT: &str = "F1";
+
+/// With Shift held, the digit of a digit key: Shift turns digits into symbols that differ
+/// between layouts (`!` or `"` over 2), so Ctrl+Shift+digit bindings match the key instead.
+pub fn shifted_digit(modifiers: Modifiers, physical: &Physical) -> Option<Key> {
+    let Physical::Code(code) = physical else {
+        return None;
+    };
+    let digit = match code {
+        Code::Digit0 => "0",
+        Code::Digit1 => "1",
+        Code::Digit2 => "2",
+        Code::Digit3 => "3",
+        Code::Digit4 => "4",
+        Code::Digit5 => "5",
+        Code::Digit6 => "6",
+        Code::Digit7 => "7",
+        Code::Digit8 => "8",
+        Code::Digit9 => "9",
+        _ => return None,
+    };
+    modifiers.shift().then(|| Key::Character(digit.into()))
+}
+
+/// Adds our bindings to `key_binds`, after upstream's.
+pub fn add_key_binds(key_binds: &mut HashMap<KeyBind, Action>) {
+    macro_rules! bind {
+        ([$($modifier:ident),+ $(,)?], $key:expr, $action:ident) => {{
+            key_binds.insert(
+                KeyBind {
+                    modifiers: vec![$(Modifier::$modifier),+],
+                    key: $key,
+                },
+                Action::$action,
+            );
+        }};
+    }
+
+    bind!([Ctrl, Shift], Key::Character("W".into()), CloseAllTabs);
+    // Notepad++: F3 repeats the last search, Ctrl+F3 searches the word under the cursor
+    for (modifiers, action) in [
+        (Vec::new(), Action::FindNext),
+        (vec![Modifier::Shift], Action::FindPrevious),
+        (vec![Modifier::Ctrl], Action::FindWordNext),
+        (
+            vec![Modifier::Ctrl, Modifier::Shift],
+            Action::FindWordPrevious,
+        ),
+    ] {
+        key_binds.insert(
+            KeyBind {
+                modifiers,
+                key: Key::Named(Named::F3),
+            },
+            action,
+        );
+    }
+    bind!([Ctrl], Key::Character("g".into()), GotoLine);
+    // Notepad++: Ctrl+Shift+F is Find in Files (upstream's "Find in project" drawer had it),
+    // F7 shows or hides the Search results panel
+    bind!([Ctrl, Shift], Key::Character("F".into()), FindInFiles);
+    key_binds.insert(
+        KeyBind {
+            modifiers: Vec::new(),
+            key: Key::Named(Named::F7),
+        },
+        Action::ToggleSearchResults,
+    );
+    bind!(
+        [Ctrl, Shift],
+        Key::Character("V".into()),
+        MarkdownTogglePreview
+    );
+    bind!([Ctrl, Alt], Key::Character("v".into()), MarkdownToggleSplit);
+    // In the order of the header buttons; digits are the same on every layout
+    for (digit, mode) in ["1", "2", "3"].into_iter().zip(ViewMode::ALL) {
+        key_binds.insert(
+            KeyBind {
+                modifiers: vec![Modifier::Ctrl, Modifier::Alt],
+                key: Key::Character(digit.into()),
+            },
+            Action::MarkdownView(mode),
+        );
+    }
+    bind!(
+        [Ctrl, Alt],
+        Key::Character("o".into()),
+        MarkdownToggleOutline
+    );
+    // Shift turns the brackets into braces on most layouts
+    bind!([Ctrl, Shift], Key::Character("[".into()), Fold);
+    bind!([Ctrl, Shift], Key::Character("{".into()), Fold);
+    bind!([Ctrl, Shift], Key::Character("]".into()), Unfold);
+    bind!([Ctrl, Shift], Key::Character("}".into()), Unfold);
+    bind!([Ctrl, Alt, Shift], Key::Character("F".into()), JsonFormat);
+    bind!([Ctrl, Alt, Shift], Key::Character("M".into()), JsonMinify);
+    bind!([Ctrl], Key::Character("b".into()), MarkdownBold);
+    bind!([Ctrl], Key::Character("i".into()), MarkdownItalic);
+    bind!(
+        [Ctrl, Shift],
+        Key::Character("X".into()),
+        MarkdownStrikethrough
+    );
+    // Matched by position too where the key left of 1 is a dead key or another character
+    bind!([Ctrl], Key::Character("`".into()), MarkdownCode);
+    bind!([Ctrl], Key::Character("k".into()), MarkdownLink);
+    // Ctrl+0..9 are taken by zoom and tab switching; see shifted_digit
+    for level in 0..=6 {
+        key_binds.insert(
+            KeyBind {
+                modifiers: vec![Modifier::Ctrl, Modifier::Shift],
+                key: Key::Character(level.to_string().into()),
+            },
+            Action::MarkdownHeading(level),
+        );
+    }
+    bind!([Ctrl], Key::Named(Named::Enter), MarkdownToggleTask);
+    key_binds.insert(
+        KeyBind {
+            modifiers: Vec::new(),
+            key: Key::Named(Named::F1),
+        },
+        Action::ToggleMarkdownShortcuts,
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::key_bind::key_binds;
+
+    /// Every binding, one line each, sorted: moving bindings between `key_bind` and this
+    /// module must not change the map (a key bound twice keeps its last action).
+    #[test]
+    fn key_binds_match_the_snapshot() {
+        let mut lines: Vec<String> = key_binds()
+            .iter()
+            .map(|(key_bind, action)| {
+                format!(
+                    "{:?} {:?} => {:?}",
+                    key_bind.modifiers, key_bind.key, action
+                )
+            })
+            .collect();
+        lines.sort();
+        let snapshot: Vec<&str> = include_str!("key_bind_ext.snapshot").lines().collect();
+        assert_eq!(
+            lines, snapshot,
+            "the key bindings changed; if on purpose, write the new list (one line each, \
+             sorted, as printed above) to src/key_bind_ext.snapshot"
+        );
+    }
+
+    #[test]
+    fn shortcut_texts_match_the_bindings() {
+        let binds = key_binds();
+        for (action, text) in [
+            (Action::MarkdownBold, BOLD_SHORTCUT),
+            (Action::MarkdownItalic, ITALIC_SHORTCUT),
+            (Action::MarkdownStrikethrough, STRIKETHROUGH_SHORTCUT),
+            (Action::MarkdownCode, CODE_SHORTCUT),
+            (Action::MarkdownLink, LINK_SHORTCUT),
+            (Action::MarkdownHeading(1), HEADING_SHORTCUTS[0]),
+            (Action::MarkdownHeading(2), HEADING_SHORTCUTS[1]),
+            (Action::MarkdownHeading(3), HEADING_SHORTCUTS[2]),
+            (Action::MarkdownHeading(4), HEADING_SHORTCUTS[3]),
+            (Action::MarkdownHeading(5), HEADING_SHORTCUTS[4]),
+            (Action::MarkdownHeading(6), HEADING_SHORTCUTS[5]),
+            (Action::MarkdownHeading(0), PLAIN_TEXT_SHORTCUT),
+            (Action::MarkdownToggleTask, TASK_SHORTCUT),
+            (Action::ToggleMarkdownShortcuts, MARKDOWN_SHORTCUTS_SHORTCUT),
+        ] {
+            let shown: Vec<String> = binds
+                .iter()
+                .filter(|(_, bound)| **bound == action)
+                .map(|(key_bind, _)| key_bind.to_string())
+                .collect();
+            assert_eq!(shown, [text]);
+        }
+    }
+
+    #[test]
+    fn shifted_digits_match_heading_bindings() {
+        let binds = key_binds();
+        let ctrl_shift = Modifiers::CTRL | Modifiers::SHIFT;
+        // German layout: Shift+2 types `"`
+        let key = Key::Character("\"".into());
+        let physical = Physical::Code(Code::Digit2);
+        let bound = shifted_digit(ctrl_shift, &physical).unwrap_or(key.clone());
+        let actions: Vec<_> = binds
+            .iter()
+            .filter(|(key_bind, _)| key_bind.matches(ctrl_shift, &bound, Some(&physical)))
+            .map(|(_, action)| *action)
+            .collect();
+        assert_eq!(actions, [Action::MarkdownHeading(2)]);
+        // Without Shift the digit key stays a digit: Ctrl+2 switches tabs
+        assert_eq!(shifted_digit(Modifiers::CTRL, &physical), None);
+        assert_eq!(shifted_digit(ctrl_shift, &Physical::Code(Code::KeyA)), None);
+    }
+}

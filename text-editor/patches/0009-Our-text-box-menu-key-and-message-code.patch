+/// Draw `…` after the header of each fold, as three dots in the editor's text colour.
+pub(super) fn draw_fold_markers(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    metrics: Metrics,
+) {
+    let mut color = editor.foreground_color();
+    color = cosmic_text::Color::rgba(color.r(), color.g(), color.b(), 160);
+    let dot = (metrics.font_size / 7.0).ceil().max(2.0) as u32;
+    editor.with_buffer(|buffer| {
+        let mut runs = buffer.layout_runs().peekable();
+        while let Some(run) = runs.next() {
+            // The last row of a line followed by a hidden line
+            let next = runs.peek();
+            if folding::is_folded_run(&run)
+                || next.is_some_and(|next| next.line_i == run.line_i)
+                || !folding::is_fold_header(buffer, run.line_i)
+            {
+                continue;
+            }
+            let x = run.line_w + metrics.font_size / 2.0;
+            let y = run.line_top + metrics.line_height * 0.6;
+            for i in 0..3 {
+                renderer.rectangle(
+                    (x + i as f32 * dot as f32 * 2.0) as i32,
+                    y as i32,
+                    dot,
+                    dot,
+                    color,
+                );
+            }
+        }
+    });
+}
+
+/// Draw a chevron in the fold area (`x`, `w`, physical pixels) of each visible fold header:
+/// `▸` on a folded block always, `▾` on a foldable one only while the pointer is over the
+/// gutter or on the cursor line, fainter.
+pub(super) fn draw_fold_chevrons(
+    pixels: &mut [u32],
+    canvas: Canvas,
+    editor: &ViEditor<'static, 'static>,
+    kind: folding::FoldKind,
+    (area_x, area_w): (i32, i32),
+    hover: bool,
+    color: cosmic_text::Color,
+) {
+    let cursor_line = editor.cursor().line;
+    let tint = |alpha: u8| cosmic_text::Color::rgba(color.r(), color.g(), color.b(), alpha);
+    editor.with_buffer(|buffer| {
+        let line_height = buffer.metrics().line_height;
+        // Half the chevron's long side
+        let half = ((area_w as f32 * 0.25).round() as i32).max(2);
+        let cx = area_x + area_w / 2;
+        let mut last_line = None;
+        for run in buffer.layout_runs() {
+            if folding::is_folded_run(&run) || last_line == Some(run.line_i) {
+                continue;
+            }
+            last_line = Some(run.line_i);
+            let line = run.line_i;
+            let cy = (run.line_top + line_height / 2.0) as i32;
+            if folding::is_fold_header(buffer, line) {
+                // ▸: columns shrinking to the right
+                for i in 0..=half {
+                    draw_rect(
+                        pixels,
+                        canvas,
+                        Canvas {
+                            w: 1,
+                            h: 2 * (half - i) + 1,
+                        },
+                        Offset {
+                            x: cx - half / 2 + i,
+                            y: cy - (half - i),
+                        },
+                        tint(220),
+                    );
+                }
+            } else if (hover || line == cursor_line)
+                && folding::is_foldable(|i| buffer.lines.get(i).map(|l| l.text()), line, kind)
+            {
+                // ▾: rows shrinking downwards
+                for i in 0..=half {
+                    draw_rect(
+                        pixels,
+                        canvas,
+                        Canvas {
+                            w: 2 * (half - i) + 1,
+                            h: 1,
+                        },
+                        Offset {
+                            x: cx - (half - i),
+                            y: cy - half / 2 + i,
+                        },
+                        tint(130),
+                    );
+                }
+            }
+        }
+    });
+}
+
+/// Draw the whitespace and line end markers of the visible rows (see `whitespace`) in the
+/// editor's text colour at low alpha, behind the glyphs. Built from rectangles, so no glyph is
+/// shaped and nothing moves: a dot for a space, an arrow across a tab, `↵` after LF, `¶` after
+/// CRLF and `←` after CR. Trailing whitespace is a little stronger.
+pub(super) fn draw_whitespace_markers(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    show_whitespace: bool,
+    show_line_endings: bool,
+    metrics: Metrics,
+) {
+    let markers = editor.with_buffer(|buffer| {
+        whitespace::visible_markers(buffer, show_whitespace, show_line_endings)
+    });
+    if markers.is_empty() {
+        return;
+    }
+    let fg = editor.foreground_color();
+    let faint = cosmic_text::Color::rgba(fg.r(), fg.g(), fg.b(), 72);
+    let strong = cosmic_text::Color::rgba(fg.r(), fg.g(), fg.b(), 128);
+    let size = metrics.font_size;
+    let line_h = metrics.line_height;
+    // Stroke width, and the half height of an arrowhead
+    let t = (size / 14.0).round().max(1.0);
+    let head = (size / 5.0).round().max(2.0);
+    let rect = |renderer: &mut CustomRenderer, x: f32, y: f32, w: f32, h: f32, color| {
+        renderer.rectangle(
+            x.round() as i32,
+            y.round() as i32,
+            w.round().max(1.0) as u32,
+            h.round().max(1.0) as u32,
+            color,
+        );
+    };
+    // An arrow pointing left with its tip at `x`, or right with its tip at `x + w`
+    let arrow = |renderer: &mut CustomRenderer, x: f32, w: f32, mid: f32, left: bool, color| {
+        rect(renderer, x, mid - (t / 2.0).floor(), w, t, color);
+        for i in 0..head as i32 {
+            let i = i as f32;
+            let col = if left { x + i } else { x + w - 1.0 - i };
+            rect(renderer, col, mid - i, 1.0, 2.0 * i + 1.0, color);
+        }
+    };
+    for marker in markers {
+        let color = if marker.trailing { strong } else { faint };
+        let mid = (marker.line_top + line_h / 2.0).round();
+        match marker.kind {
+            MarkerKind::Space => {
+                let d = (size / 8.0).round().max(1.0);
+                rect(
+                    renderer,
+                    marker.x + (marker.w - d) / 2.0,
+                    mid - (d / 2.0).floor(),
+                    d,
+                    d,
+                    color,
+                );
+            }
+            MarkerKind::Tab => {
+                let pad = (marker.w * 0.15).max(1.0);
+                arrow(
+                    renderer,
+                    marker.x + pad,
+                    marker.w - 2.0 * pad,
+                    mid,
+                    false,
+                    color,
+                );
+            }
+            MarkerKind::LineEnd(ending) => {
+                let x = marker.x + (size / 4.0).round();
+                let w = (size * 0.6).round();
+                let top = marker.line_top + line_h * 0.2;
+                let bottom = marker.line_top + line_h * 0.8;
+                match ending {
+                    LineEnding::Lf => {
+                        // Down the right side, then left to the arrowhead
+                        rect(renderer, x + w - t, top, t, mid - top + t, color);
+                        arrow(renderer, x, w, mid, true, color);
+                    }
+                    LineEnding::CrLf => {
+                        // Pilcrow: a filled bowl on two stems
+                        let stem1 = x + w * 0.5;
+                        let stem2 = x + w - t;
+                        rect(renderer, stem1, top, t, bottom - top, color);
+                        rect(renderer, stem2, top, t, bottom - top, color);
+                        rect(renderer, x, top, stem2 - x, t, color);
+                        rect(renderer, x, top, stem1 - x, (bottom - top) * 0.45, color);
+                    }
+                    _ => arrow(renderer, x, w, mid, true, color),
+                }
+            }
+        }
+    }
+}
+
+impl<'a, Message> TextBox<'a, Message>
+where
+    Message: Clone,
+{
+    /// The change history area left of the line numbers and the fold chevrons right of them,
+    /// saved in `state`: the change bar width, the change area width, the fold area (left edge
+    /// and width) and `editor_offset_x` widened by both, all in physical pixels.
+    pub(super) fn gutter_areas(
+        &self,
+        state: &State,
+        scale_factor: f32,
+        metrics: Metrics,
+        editor_offset_x: i32,
+    ) -> (i32, i32, (i32, i32), i32) {
+        // Change history bar, left of the line numbers: 3 px and a 2 px gap, in physical pixels
+        let change_bar_w = (3.0 * scale_factor).round().max(1.0) as i32;
+        let change_area_w = if self.ext.change_marks.is_some() {
+            change_bar_w + (2.0 * scale_factor).round() as i32
+        } else {
+            0
+        };
+        // Fold chevrons, right of the line numbers
+        let fold_area = match self.ext.fold_kind {
+            Some(_) if self.line_numbers => (
+                change_area_w + editor_offset_x,
+                (metrics.font_size * 0.9).ceil() as i32,
+            ),
+            _ => (0, 0),
+        };
+        state.ext.fold_area.set(fold_area);
+        let editor_offset_x = editor_offset_x + change_area_w + fold_area.1;
+        state.ext.change_area_w.set(change_area_w);
+        (change_bar_w, change_area_w, fold_area, editor_offset_x)
+    }
+
+    /// Fold chevrons and change history bars in the gutter pixels; `gutter` is the gutter's
+    /// size.
+    pub(super) fn draw_gutter_marks(
+        &self,
+        pixels: &mut [u32],
+        canvas: Canvas,
+        editor: &ViEditor<'static, 'static>,
+        state: &State,
+        theme: &cosmic::cosmic_theme::Theme,
+        (change_bar_w, change_area_w, fold_area): (i32, i32, (i32, i32)),
+        gutter: Canvas,
+    ) {
+        if let Some(kind) = self.ext.fold_kind
+            && fold_area.1 > 0
+        {
+            let color = editor
+                .theme()
+                .settings
+                .gutter_foreground
+                .map_or(editor.foreground_color(), |color| {
+                    cosmic_text::Color::rgba(color.r, color.g, color.b, color.a)
+                });
+            draw_fold_chevrons(
+                pixels,
+                canvas,
+                editor,
+                kind,
+                fold_area,
+                state.ext.gutter_hover.get(),
+                color,
+            );
+        }
+
+        if let Some(marks) = self.ext.change_marks {
+            // Without line numbers nothing else fills the gutter
+            if !self.line_numbers {
+                draw_rect(
+                    pixels,
+                    canvas,
+                    gutter,
+                    Offset { x: 0, y: 0 },
+                    editor.background_color(),
+                );
+            }
+            draw_change_marks(
+                pixels,
+                canvas,
+                editor,
+                marks,
+                theme,
+                change_bar_w,
+                change_area_w,
+            );
+        }
+    }
+
+    /// Change tints, the find range and matches, and fold markers: under the selection, which
+    /// is drawn next.
+    pub(super) fn draw_under_selection(
+        &self,
+        renderer: &mut CustomRenderer,
+        editor: &ViEditor<'static, 'static>,
+        theme: &cosmic::cosmic_theme::Theme,
+        metrics: Metrics,
+    ) {
+        // Under the selection, which is drawn next
+        if let Some(tints) = self.ext.change_tints {
+            draw_change_tints(renderer, editor, tints, theme, metrics.line_height);
+        }
+
+        if let Some(range) = self.ext.find_range {
+            draw_find_range(renderer, editor, range, theme, metrics.line_height);
+        }
+
+        if let Some((regex, joined)) = self.ext.find_matches {
+            draw_find_matches(
+                renderer,
+                editor,
+                regex,
+                joined,
+                self.ext.find_range,
+                theme,
+                metrics.line_height,
+            );
+        }
+
+        draw_fold_markers(renderer, editor, metrics);
+    }
+
+    /// The column block and whitespace markers: over the selection, under the glyphs.
+    pub(super) fn draw_over_selection(
+        &self,
+        renderer: &mut CustomRenderer,
+        editor: &ViEditor<'static, 'static>,
+        metrics: Metrics,
+    ) {
+        if let Some(block) = self.ext.column.and_then(|column| *column.lock().unwrap()) {
+            draw_column_block(renderer, editor, &block, metrics.line_height);
+        }
+
+        if self.ext.on_link.is_some() {
+            draw_link_underlines(renderer, editor, metrics);
+        }
+
+        // Over the selection, under the glyphs
+        if self.ext.show_whitespace || self.ext.show_line_endings {
+            draw_whitespace_markers(
+                renderer,
+                editor,
+                self.ext.show_whitespace,
+                self.ext.show_line_endings,
+                metrics,
+            );
+        }
+    }
+}

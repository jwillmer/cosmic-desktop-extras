diff --git a/src/menu_ext.rs b/src/menu_ext.rs
new file mode 100644
index 0000000..bfbcbde
--- /dev/null
+++ b/src/menu_ext.rs
@@ -0,0 +1,418 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Our menus and menu entries: the tab bar and status bar menus, and the entries `menu` adds
+//! to upstream's menu bar and editor context menu.
+
+use cosmic::widget::menu::Item as MenuItem;
+use cosmic::widget::menu::action::MenuAction;
+use cosmic::widget::menu::key_bind::KeyBind;
+use cosmic::{
+    Element,
+    app::Core,
+    widget::{
+        self,
+        menu::{ItemHeight, ItemWidth},
+        segmented_button,
+    },
+};
+use std::collections::HashMap;
+
+use crate::{
+    Action, Config, Message,
+    close_tabs::{self, Scope},
+    fl,
+    menu::TabAction,
+};
+
+/// A button, or the same button greyed out when not `enabled`.
+fn optional<A: MenuAction>(label: String, action: A, enabled: bool) -> MenuItem<A, String> {
+    if enabled {
+        MenuItem::Button(label, None, action)
+    } else {
+        MenuItem::ButtonDisabled(label, None, action)
+    }
+}
+
+/// The editor context menu's "Compare with saved", greyed without unsaved changes.
+pub fn context_compare_with_saved(
+    entity: segmented_button::Entity,
+    has_changes: bool,
+) -> MenuItem<TabAction, String> {
+    optional(
+        fl!("compare-with-saved"),
+        TabAction(entity, Action::CompareWithSaved),
+        has_changes,
+    )
+}
+
+/// The tab bar's right-click menu; its entries act on the tab it was opened on. The tab bar
+/// wants one menu per tab, in tab bar order (it asserts that), so `tabs` has the view state of
+/// each.
+pub fn tab_bar_context_menu(
+    key_binds: &HashMap<KeyBind, Action>,
+    tabs: impl Iterator<Item = crate::views::MenuState>,
+) -> Vec<widget::menu::Tree<Message>> {
+    let item =
+        |label: String, scope: Scope| MenuItem::Button(label, None, TabBarAction::Close(scope));
+    let view = |label: String, action: TabBarAction, enabled: bool| {
+        if enabled {
+            MenuItem::Button(label, None, action)
+        } else {
+            MenuItem::ButtonDisabled(label, None, action)
+        }
+    };
+    let key_binds: HashMap<KeyBind, TabBarAction> = key_binds
+        .iter()
+        .filter_map(|(key_bind, action)| {
+            let scope = match action {
+                Action::CloseAllTabs => Scope::All,
+                Action::CloseOtherTabs => Scope::Others,
+                Action::CloseTabsToRight => Scope::ToTheRight,
+                _ => return None,
+            };
+            Some((key_bind.clone(), TabBarAction::Close(scope)))
+        })
+        .collect();
+    let menu = |views: crate::views::MenuState| {
+        vec![
+            view(
+                fl!("copy-file-path"),
+                TabBarAction::CopyPath,
+                views.has_file,
+            ),
+            view(
+                fl!("open-containing-folder"),
+                TabBarAction::OpenFolder,
+                views.has_file,
+            ),
+            MenuItem::Divider,
+            item(fl!("close-all"), Scope::All),
+            item(fl!("close-others"), Scope::Others),
+            item(fl!("close-tabs-to-right"), Scope::ToTheRight),
+            MenuItem::Divider,
+            view(
+                fl!("move-to-other-view"),
+                TabBarAction::Move,
+                views.can_move,
+            ),
+            view(
+                fl!("clone-to-other-view"),
+                TabBarAction::Clone,
+                views.can_clone,
+            ),
+            MenuItem::Divider,
+            compare_menu(&views, TabBarAction::Compare),
+        ]
+    };
+    widget::menu::nav_context(&key_binds, tabs.map(menu).collect())
+}
+
+/// "Compare with" and the open tabs, with "Compare the two views" first when split; `action`
+/// gets the tab's position, or `None` for the two views.
+fn compare_menu<A: MenuAction>(
+    views: &crate::views::MenuState,
+    action: impl Fn(Option<usize>) -> A,
+) -> MenuItem<A, String> {
+    let mut items = Vec::new();
+    if views.split {
+        items.push(MenuItem::Button(fl!("compare-views"), None, action(None)));
+        if !views.compare.is_empty() {
+            items.push(MenuItem::Divider);
+        }
+    }
+    for (pos, title) in &views.compare {
+        items.push(MenuItem::Button(title.clone(), None, action(Some(*pos))));
+    }
+    if items.is_empty() {
+        return MenuItem::ButtonDisabled(fl!("compare-with"), None, action(None));
+    }
+    MenuItem::Folder(fl!("compare-with"), items)
+}
+
+/// The Edit menu's Heading submenu: levels 1 to 6 and plain text, greyed outside Markdown.
+fn markdown_heading_menu(
+    markdown_view: Option<crate::markdown::ViewMode>,
+) -> MenuItem<Action, String> {
+    let label = fl!("markdown-heading");
+    if !crate::md_format::enabled(markdown_view) {
+        return MenuItem::ButtonDisabled(label, None, Action::NoOp);
+    }
+    let mut items: Vec<_> = (1..=6)
+        .map(|level| {
+            MenuItem::Button(
+                fl!("markdown-heading-level", level = level),
+                None,
+                Action::MarkdownHeading(level),
+            )
+        })
+        .collect();
+    items.push(MenuItem::Button(
+        fl!("markdown-plain-text"),
+        None,
+        Action::MarkdownHeading(0),
+    ));
+    MenuItem::Folder(label, items)
+}
+
+/// A tab bar context menu entry.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum TabBarAction {
+    Close(Scope),
+    Move,
+    Clone,
+    Compare(Option<usize>),
+    CopyPath,
+    OpenFolder,
+}
+
+impl MenuAction for TabBarAction {
+    type Message = Message;
+
+    fn message(&self) -> Message {
+        match self {
+            Self::Close(scope) => close_tabs::Message::TabBar(*scope).into(),
+            Self::Move => crate::views::Message::TabBarMove.into(),
+            Self::Clone => crate::views::Message::TabBarClone.into(),
+            Self::Compare(other) => crate::views::Message::TabBarCompare(*other).into(),
+            Self::CopyPath => crate::tab_file::Message::CopyPath.into(),
+            Self::OpenFolder => crate::tab_file::Message::OpenFolder.into(),
+        }
+    }
+}
+
+/// File > Close: the active tab, all tabs, the other tabs or the tabs to its right.
+pub fn close_menu() -> MenuItem<Action, String> {
+    MenuItem::Folder(
+        fl!("close-submenu"),
+        vec![
+            MenuItem::Button(fl!("close-file"), None, Action::CloseFile),
+            MenuItem::Button(fl!("close-all-tabs"), None, Action::CloseAllTabs),
+            MenuItem::Button(fl!("close-other-tabs"), None, Action::CloseOtherTabs),
+            MenuItem::Button(fl!("close-tabs-to-right"), None, Action::CloseTabsToRight),
+        ],
+    )
+}
+
+/// File > Compare with saved, greyed without unsaved changes.
+pub fn compare_with_saved(has_changes: bool) -> MenuItem<Action, String> {
+    optional(
+        fl!("compare-with-saved"),
+        Action::CompareWithSaved,
+        has_changes,
+    )
+}
+
+/// File > Compare with: the two views or another tab.
+pub fn compare_with(views: &crate::views::MenuState) -> MenuItem<Action, String> {
+    compare_menu(views, |other| match other {
+        Some(pos) => Action::CompareWithTab(pos),
+        None => Action::CompareViews,
+    })
+}
+
+/// Edit > Markdown: the formatting commands, greyed outside Markdown.
+pub fn markdown_menu(markdown_view: Option<crate::markdown::ViewMode>) -> MenuItem<Action, String> {
+    let enabled = crate::md_format::enabled(markdown_view);
+    MenuItem::Folder(
+        fl!("markdown"),
+        vec![
+            optional(fl!("markdown-bold"), Action::MarkdownBold, enabled),
+            optional(fl!("markdown-italic"), Action::MarkdownItalic, enabled),
+            optional(
+                fl!("markdown-strikethrough"),
+                Action::MarkdownStrikethrough,
+                enabled,
+            ),
+            optional(fl!("markdown-inline-code"), Action::MarkdownCode, enabled),
+            optional(fl!("markdown-link"), Action::MarkdownLink, enabled),
+            markdown_heading_menu(markdown_view),
+            optional(
+                fl!("markdown-toggle-task"),
+                Action::MarkdownToggleTask,
+                enabled,
+            ),
+            optional(
+                fl!("markdown-format-table"),
+                Action::MarkdownFormatTable,
+                enabled,
+            ),
+        ],
+    )
+}
+
+/// View > Show whitespace.
+pub fn show_whitespace(config: &Config) -> MenuItem<Action, String> {
+    MenuItem::CheckBox(
+        fl!("show-whitespace"),
+        None,
+        config.show_whitespace,
+        Action::ToggleShowWhitespace,
+    )
+}
+
+/// View > Show line endings.
+pub fn show_line_endings(config: &Config) -> MenuItem<Action, String> {
+    MenuItem::CheckBox(
+        fl!("show-line-endings"),
+        None,
+        config.show_line_endings,
+        Action::ToggleShowLineEndings,
+    )
+}
+
+/// View > Status bar.
+pub fn status_bar(config: &Config) -> MenuItem<Action, String> {
+    MenuItem::CheckBox(
+        fl!("status-bar"),
+        None,
+        config.show_status_bar,
+        Action::ToggleStatusBar,
+    )
+}
+
+/// View > Folding.
+pub fn folding_menu() -> MenuItem<Action, String> {
+    MenuItem::Folder(
+        fl!("folding"),
+        vec![
+            MenuItem::Button(fl!("fold"), None, Action::Fold),
+            MenuItem::Button(fl!("unfold"), None, Action::Unfold),
+            MenuItem::Button(fl!("fold-all"), None, Action::FoldAll),
+            MenuItem::Button(fl!("unfold-all"), None, Action::UnfoldAll),
+        ],
+    )
+}
+
+/// View > Views: move or clone the tab to the other view, and synchronized scrolling.
+pub fn views_menu(config: &Config, views: &crate::views::MenuState) -> MenuItem<Action, String> {
+    MenuItem::Folder(
+        fl!("views-submenu"),
+        vec![
+            optional(
+                fl!("move-to-other-view"),
+                Action::MoveToOtherView,
+                views.can_move,
+            ),
+            optional(
+                fl!("clone-to-other-view"),
+                Action::CloneToOtherView,
+                views.can_clone,
+            ),
+            MenuItem::CheckBox(
+                fl!("sync-scroll-views"),
+                None,
+                config.sync_scroll_views,
+                Action::ToggleSyncScrollViews,
+            ),
+        ],
+    )
+}
+
+/// View > Markdown shortcuts...
+pub fn markdown_shortcuts() -> MenuItem<Action, String> {
+    MenuItem::Button(
+        fl!("menu-markdown-shortcuts"),
+        None,
+        Action::ToggleMarkdownShortcuts,
+    )
+}
+
+/// "Line endings: LF" with the line ending entries; disabled when the active tab is not an
+/// editor.
+pub fn line_endings_menu(
+    line_endings: Option<crate::whitespace::EndingCounts>,
+) -> MenuItem<Action, String> {
+    let Some(counts) = line_endings else {
+        return MenuItem::ButtonDisabled(fl!("line-endings", ending = "-"), None, Action::NoOp);
+    };
+    MenuItem::Folder(
+        fl!(
+            "line-endings",
+            ending = crate::status_bar::line_ending_label(counts.endings())
+        ),
+        line_endings_items(counts),
+    )
+}
+
+/// LF and CRLF, the file's own checked (see `status_bar::line_ending_choices`), after the
+/// counts of a mixed file.
+fn line_endings_items(counts: crate::whitespace::EndingCounts) -> Vec<MenuItem<Action, String>> {
+    let (header, choices) = crate::status_bar::line_ending_choices(counts);
+    let header = header.map(|header| MenuItem::ButtonDisabled(header, None, Action::NoOp));
+    header
+        .into_iter()
+        .chain(choices.into_iter().map(|choice| {
+            let (label, action) = if choice.ending == cosmic_text::LineEnding::CrLf {
+                (fl!("line-ending-crlf"), Action::ConvertToCrlf)
+            } else {
+                (fl!("line-ending-lf"), Action::ConvertToLf)
+            };
+            if choice.enabled {
+                MenuItem::CheckBox(label, None, choice.checked, action)
+            } else {
+                MenuItem::ButtonDisabled(label, None, Action::NoOp)
+            }
+        }))
+        .collect()
+}
+
+/// "Tab width: 4", checked when it is the config's
+fn tab_width_item(config: &Config, tab_width: u16) -> MenuItem<Action, String> {
+    MenuItem::CheckBox(
+        fl!("tab-width", tab_width = tab_width),
+        None,
+        config.tab_width == tab_width,
+        Action::TabWidth(tab_width),
+    )
+}
+
+/// A status bar item that opens a menu above or below it when clicked: the text `label`
+/// styled like the bar's other buttons, and `items`.
+fn status_bar_menu<'a>(
+    core: &Core,
+    key_binds: &HashMap<KeyBind, Action>,
+    label: String,
+    padding: u16,
+    items: Vec<MenuItem<Action, String>>,
+) -> Element<'a, Message> {
+    let root = widget::button::custom(widget::text::caption(label))
+        .padding([0, padding])
+        .class(cosmic::theme::Button::Text);
+    widget::menu::bar(vec![widget::menu::Tree::with_children(
+        widget::RcElementWrapper::new(Element::from(root)),
+        widget::menu::items(key_binds, items),
+    )])
+    .item_height(ItemHeight::Dynamic(40))
+    .item_width(ItemWidth::Uniform(240))
+    .on_surface_action(Message::Surface)
+    .window_id_maybe(core.main_window_id())
+    .into()
+}
+
+/// The status bar's line ending item (`label`, e.g. "LF"): click it to pick LF or CRLF, as
+/// in Edit > Line endings.
+pub fn status_line_endings<'a>(
+    core: &Core,
+    key_binds: &HashMap<KeyBind, Action>,
+    label: String,
+    padding: u16,
+    counts: crate::whitespace::EndingCounts,
+) -> Element<'a, Message> {
+    status_bar_menu(core, key_binds, label, padding, line_endings_items(counts))
+}
+
+/// The status bar's indentation item (`label`, e.g. "Spaces: 4"): click it for tab width 2,
+/// 4 or 8, as in View > Indentation.
+pub fn status_indentation<'a>(
+    core: &Core,
+    config: &Config,
+    key_binds: &HashMap<KeyBind, Action>,
+    label: String,
+    padding: u16,
+) -> Element<'a, Message> {
+    let items = [2, 4, 8]
+        .into_iter()
+        .map(|tab_width| tab_width_item(config, tab_width))
+        .collect();
+    status_bar_menu(core, key_binds, label, padding, items)
+}
diff --git a/src/shell.rs b/src/shell.rs
new file mode 100644
index 0000000..dd691f7
--- /dev/null
+++ b/src/shell.rs
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The application COSMIC runs: [`App`] with our step after every message.
+//!
+//! Upstream's `Application::update` keeps its body in its place. Our inherent `App::update`
+//! shadows it, so every `self.update(..)` (also the nested ones in that body) runs the body and
+//! then `views_after_update`. [`Shell`] is what `main` runs: it forwards every method `App`
+//! implements, and its `update` goes to the inherent one.
+
+use cosmic::{
+    Application, Element, action,
+    app::{Core, Task, context_drawer},
+    dbus_activation, executor,
+    iced::{Subscription, window},
+    widget::nav_bar,
+};
+
+use crate::{App, Flags, Message};
+
+impl App {
+    /// Upstream's `update`, then keep the views in step with the tabs and the Find dialog's
+    /// window with the find state.
+    pub fn update(&mut self, message: Message) -> Task<Message> {
+        if let Some(task) = self.find_window_message(&message) {
+            return task;
+        }
+        let raise = matches!(message, Message::Find(Some(_)));
+        let task = <App as Application>::update(self, message);
+        let task = self.views_after_update(task);
+        Task::batch([task, self.find_window_sync(raise)])
+    }
+}
+
+/// Runs [`App`] with our inherent `App::update`; forwards every method `App` implements.
+pub struct Shell(App);
+
+impl Application for Shell {
+    type Executor = executor::Default;
+    type Flags = Flags;
+    type Message = Message;
+    const APP_ID: &'static str = App::APP_ID;
+
+    fn core(&self) -> &Core {
+        self.0.core()
+    }
+
+    fn core_mut(&mut self) -> &mut Core {
+        self.0.core_mut()
+    }
+
+    fn init(core: Core, flags: Self::Flags) -> (Self, Task<Self::Message>) {
+        let (app, task) = App::init(core, flags);
+        (Self(app), task)
+    }
+
+    fn nav_bar(&self) -> Option<Element<'_, action::Action<Self::Message>>> {
+        self.0.nav_bar()
+    }
+
+    fn nav_model(&self) -> Option<&nav_bar::Model> {
+        self.0.nav_model()
+    }
+
+    fn on_app_exit(&mut self) -> Option<Message> {
+        self.0.on_app_exit()
+    }
+
+    fn on_context_drawer(&mut self) -> Task<Message> {
+        self.0.on_context_drawer()
+    }
+
+    fn on_escape(&mut self) -> Task<Message> {
+        // An Escape in the Find dialog only closes the dialog
+        if self.0.find_escape_nav() {
+            return Task::none();
+        }
+        self.0.on_escape()
+    }
+
+    fn on_nav_select(&mut self, id: nav_bar::Id) -> Task<Message> {
+        self.0.on_nav_select(id)
+    }
+
+    fn dialog(&self) -> Option<Element<'_, Self::Message>> {
+        self.0.dialog()
+    }
+
+    fn update(&mut self, message: Message) -> Task<Message> {
+        self.0.update(message)
+    }
+
+    fn context_drawer(&self) -> Option<context_drawer::ContextDrawer<'_, Message>> {
+        self.0.context_drawer()
+    }
+
+    fn header_start(&self) -> Vec<Element<'_, Message>> {
+        self.0.header_start()
+    }
+
+    fn dbus_activation(&mut self, msg: dbus_activation::Message) -> Task<Message> {
+        self.0.dbus_activation(msg)
+    }
+
+    fn header_end(&self) -> Vec<Element<'_, Message>> {
+        self.0.header_end()
+    }
+
+    fn view(&self) -> Element<'_, Message> {
+        self.0.view()
+    }
+
+    fn view_window(&self, window_id: window::Id) -> Element<'_, Message> {
+        self.0.view_window(window_id)
+    }
+
+    fn subscription(&self) -> Subscription<Message> {
+        self.0.subscription()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    /// The names of the methods in the `impl Application for <name>` block of `source`.
+    fn methods(source: &str, name: &str) -> Vec<String> {
+        let head = format!("impl Application for {name} {{");
+        let start = source.find(&head).expect("impl block") + head.len();
+        let end = start + source[start..].find("\n}\n").expect("end of impl block");
+        let mut names: Vec<String> = source[start..end]
+            .lines()
+            .filter_map(|line| line.strip_prefix("    fn "))
+            .map(|rest| rest.split(['(', '<']).next().unwrap().to_string())
+            .collect();
+        names.sort();
+        names
+    }
+
+    /// A method `App` implements but `Shell` does not forward would silently fall back to the
+    /// trait's default.
+    #[test]
+    fn shell_forwards_every_app_method() {
+        let app = methods(include_str!("main.rs"), "App");
+        assert!(app.contains(&"update".to_string()), "{app:?}");
+        assert_eq!(methods(include_str!("shell.rs"), "Shell"), app);
+    }
+}
diff --git a/src/text_box/autoscroll.rs b/src/text_box/autoscroll.rs
new file mode 100644
index 0000000..38f3ae6
--- /dev/null
+++ b/src/text_box/autoscroll.rs
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Scrolling with a drag selection: while the pointer is held past an edge of the text, the
+//! app scrolls on a timer, faster the further out it is, and the selection end follows, also
+//! with the pointer held still. The speed curve is the Markdown preview's.
+
+use super::*;
+use cosmic::widget::segmented_button::Entity;
+use cosmic_text::BorrowedWithFontSystem;
+
+use crate::column_select::Block;
+
+/// How often the app scrolls while a drag is past an edge.
+pub const AUTO_SCROLL_TICK: Duration = Duration::from_millis(16);
+/// Logical pixels per tick for each logical pixel the pointer is past the edge
+const SCROLL_RATE: f32 = 0.2;
+/// The slowest and the fastest scroll, in logical pixels per tick
+const SCROLL_MIN: f32 = 2.0;
+const SCROLL_MAX: f32 = 40.0;
+/// Near the top and the bottom the scroll starts this many logical pixels inside the text, so
+/// it works with the window at the screen's edge. Left and right it starts at the edge.
+const SCROLL_ZONE_Y: f32 = 8.0;
+
+/// A drag past an edge of the text, in the buffer's physical pixels.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct AutoScroll {
+    /// Scroll by this much per tick
+    pub dx: f32,
+    pub dy: f32,
+    /// The pointer, from the top left of the visible text
+    pub x: f32,
+    pub y: f32,
+    /// An Alt column drag, not a normal selection
+    pub column: bool,
+    /// The tab of the drag: in another tab the scroll stops
+    pub tab: Option<Entity>,
+}
+
+/// The scroll speed for the pointer at `v` with the text from `lo` to `hi`: negative before
+/// `lo + zone`, positive after `hi - zone`, else 0. All in logical pixels.
+fn edge_speed(lo: f32, hi: f32, v: f32, zone: f32) -> f32 {
+    let speed = |past: f32| (past * SCROLL_RATE).clamp(SCROLL_MIN, SCROLL_MAX);
+    if v < lo + zone {
+        -speed(lo + zone - v)
+    } else if v > hi - zone {
+        speed(v - (hi - zone))
+    } else {
+        0.0
+    }
+}
+
+impl AutoScroll {
+    /// The scroll for a drag at `x`, `y` over a buffer of `w` × `h`, all physical pixels, or
+    /// `None` when the pointer is away from the edges.
+    pub(super) fn at(x: f32, y: f32, w: f32, h: f32, scale: f32, column: bool) -> Option<Self> {
+        let dx = edge_speed(0.0, w / scale, x / scale, 0.0) * scale;
+        // A view too low for both zones has none
+        let zone = if h / scale > 2.0 * SCROLL_ZONE_Y {
+            SCROLL_ZONE_Y
+        } else {
+            0.0
+        };
+        let dy = edge_speed(0.0, h / scale, y / scale, zone) * scale;
+        (dx != 0.0 || dy != 0.0).then_some(Self {
+            dx,
+            dy,
+            x,
+            y,
+            column,
+            tab: None,
+        })
+    }
+
+    /// One tick: scroll, then move the selection end to the pointer, kept inside the text.
+    pub fn tick(
+        &self,
+        editor: &mut BorrowedWithFontSystem<'_, ViEditor<'static, 'static>>,
+        column: &Mutex<Option<Block>>,
+    ) {
+        // A column block cleared during the drag (say by Escape) is not started anew
+        if self.column && column.lock().unwrap().is_none() {
+            return;
+        }
+        editor.action(Action::Scroll { pixels: self.dy });
+        editor.shape_as_needed(false);
+        let (w, h, scroll) = editor.with_buffer_mut(|buffer| {
+            let w = buffer.size().0.unwrap_or(0.0);
+            let max_line_width = buffer
+                .layout_runs()
+                .map(|run| run.line_w)
+                .fold(0.0, f32::max);
+            let mut scroll = buffer.scroll();
+            // Only a drag past the left or right edge scrolls sideways: the widest visible
+            // line changes as the text scrolls up or down
+            if self.dx != 0.0 {
+                scroll.horizontal = scroll_x(scroll.horizontal, self.dx, max_line_width, w);
+                buffer.set_scroll(scroll);
+            }
+            (w, buffer.size().1.unwrap_or(0.0), scroll)
+        });
+        let (x, y) = clamp_into(self.x, self.y, w, h);
+        let x = x + scroll.horizontal;
+        if self.column {
+            column_press(column, editor, x, y, true);
+        } else {
+            editor.action(Action::Drag {
+                x: x as i32,
+                y: y as i32,
+            });
+        }
+        // The text scrolls only at the speed above: a selection end on a partly visible row
+        // would otherwise scroll it into view on every tick
+        editor.shape_as_needed(false);
+        editor.with_buffer_mut(|buffer| buffer.set_scroll(scroll));
+    }
+}
+
+/// The horizontal scroll after moving `from` by `dx`, kept between the start and the widest
+/// line's end at the right edge of a view `w` wide (as the wheel does).
+fn scroll_x(from: f32, dx: f32, max_line_width: f32, w: f32) -> f32 {
+    (from + dx).min(max_line_width - w).max(0.0)
+}
+
+/// The pointer moved inside a view `w` × `h`, so the selection end lands on visible text.
+fn clamp_into(x: f32, y: f32, w: f32, h: f32) -> (f32, f32) {
+    (
+        x.clamp(0.0, (w - 1.0).max(0.0)),
+        y.clamp(0.0, (h - 1.0).max(0.0)),
+    )
+}
+
+impl<Message> TextBox<'_, Message> {
+    /// After a drag motion at `x`, `y` (physical pixels from the text's top left, not
+    /// scrolled): tell the app to scroll while the pointer is past an edge, or to stop.
+    /// Returns the point kept inside the text, where the selection end goes, as on a tick.
+    pub(super) fn publish_auto_scroll(
+        &self,
+        shell: &mut Shell<'_, Message>,
+        (x, y): (f32, f32),
+        buffer_size: (Option<f32>, Option<f32>),
+        scale_factor: f32,
+        column: bool,
+    ) -> (f32, f32) {
+        let w = buffer_size.0.unwrap_or(0.0);
+        let h = buffer_size.1.unwrap_or(0.0);
+        if let Some(on_auto_scroll) = &self.on_auto_scroll {
+            let auto_scroll =
+                AutoScroll::at(x, y, w, h, scale_factor, column).map(|auto_scroll| AutoScroll {
+                    tab: self.ext.tab,
+                    ..auto_scroll
+                });
+            shell.publish(on_auto_scroll(auto_scroll));
+        }
+        clamp_into(x, y, w, h)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn speed_grows_with_distance_and_is_capped() {
+        assert_eq!(edge_speed(0.0, 500.0, 250.0, 8.0), 0.0);
+        assert_eq!(edge_speed(0.0, 500.0, 495.0, 8.0), SCROLL_MIN);
+        assert_eq!(edge_speed(0.0, 500.0, 592.0, 8.0), 20.0);
+        assert_eq!(edge_speed(0.0, 500.0, 5000.0, 8.0), SCROLL_MAX);
+        assert_eq!(edge_speed(0.0, 500.0, -92.0, 8.0), -20.0);
+        // No zone: only past the edge
+        assert_eq!(edge_speed(0.0, 500.0, 499.0, 0.0), 0.0);
+        assert_eq!(edge_speed(0.0, 500.0, 0.0, 0.0), 0.0);
+        assert_eq!(edge_speed(0.0, 500.0, -1.0, 0.0), -SCROLL_MIN);
+    }
+
+    #[test]
+    fn at_scales_and_stops_inside() {
+        assert_eq!(AutoScroll::at(100.0, 100.0, 800.0, 600.0, 1.0, false), None);
+        // 100 logical px below at scale 2: 20 logical px per tick, 40 physical
+        let below = AutoScroll::at(
+            100.0,
+            1200.0 + 2.0 * (100.0 - 8.0),
+            800.0,
+            1200.0,
+            2.0,
+            false,
+        )
+        .unwrap();
+        assert_eq!((below.dx, below.dy), (0.0, 40.0));
+        // Left of the text (over the gutter) scrolls left; at the right edge not yet
+        let left = AutoScroll::at(-10.0, 100.0, 800.0, 600.0, 1.0, true).unwrap();
+        assert_eq!((left.dx, left.dy, left.column), (-SCROLL_MIN, 0.0, true));
+        assert_eq!(AutoScroll::at(800.0, 100.0, 800.0, 600.0, 1.0, false), None);
+    }
+
+    #[test]
+    fn a_low_view_has_no_zone() {
+        // 12 px high: only past the top or the bottom
+        assert_eq!(AutoScroll::at(100.0, 6.0, 800.0, 12.0, 1.0, false), None);
+        assert_eq!(AutoScroll::at(100.0, 0.0, 800.0, 0.0, 1.0, false), None);
+        assert!(AutoScroll::at(100.0, 13.0, 800.0, 12.0, 1.0, false).is_some());
+    }
+
+    #[test]
+    fn horizontal_scroll_stays_in_range() {
+        assert_eq!(scroll_x(0.0, 10.0, 2000.0, 800.0), 10.0);
+        assert_eq!(scroll_x(1195.0, 10.0, 2000.0, 800.0), 1200.0);
+        assert_eq!(scroll_x(5.0, -10.0, 2000.0, 800.0), 0.0);
+        // Lines narrower than the view (or word wrap): no horizontal scroll
+        assert_eq!(scroll_x(0.0, 10.0, 500.0, 800.0), 0.0);
+    }
+
+    #[test]
+    fn pointer_is_kept_on_visible_text() {
+        assert_eq!(clamp_into(-5.0, 900.0, 800.0, 600.0), (0.0, 599.0));
+        assert_eq!(clamp_into(900.0, -5.0, 800.0, 600.0), (799.0, 0.0));
+        assert_eq!(clamp_into(10.0, 20.0, 800.0, 600.0), (10.0, 20.0));
+    }
+}
diff --git a/src/text_box/draw.rs b/src/text_box/draw.rs
new file mode 100644
index 0000000..1c3c942
--- /dev/null
+++ b/src/text_box/draw.rs
@@ -0,0 +1,989 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Our drawing in the text box (change marks and tints, find matches, column blocks, folds,
+//! whitespace markers), kept out of `text_box.rs` so it stays close to upstream.
+
+use super::*;
+use cosmic_text::{LayoutRun, LineEnding};
+
+use crate::{
+    change_history::{LineMark, Mark, Tints},
+    column_select::{self, Block},
+    find_count, find_range, find_text, folding,
+    markdown::links,
+    whitespace::{self, MarkerKind},
+};
+
+/// Forget the horizontal scroll when the editor width changes, so `shape_as_needed` scrolls
+/// again only as far as the cursor needs. cosmic-text never scrolls back when the width grows:
+/// a draft restored before the first layout kept the text shifted left until the next click.
+pub(super) fn reset_horizontal_scroll(buffer: &mut cosmic_text::Buffer) {
+    let mut scroll = buffer.scroll();
+    if scroll.horizontal != 0.0 {
+        scroll.horizontal = 0.0;
+        buffer.set_scroll(scroll);
+    }
+}
+
+/// Draw the change history bar of each visible line, and a short tick at the top of a line
+/// where lines above it were deleted.
+pub(super) fn draw_change_marks(
+    pixels: &mut [u32],
+    canvas: Canvas,
+    editor: &ViEditor<'static, 'static>,
+    marks: &[LineMark],
+    theme: &cosmic::cosmic_theme::Theme,
+    bar_w: i32,
+    tick_w: i32,
+) {
+    let color = |mark: Mark| {
+        let c = match mark {
+            Mark::None => return None,
+            Mark::Saved => theme.success_color(),
+            Mark::Unsaved => theme.warning_color(),
+        };
+        let channel = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+        Some(cosmic_text::Color::rgba(
+            channel(c.red),
+            channel(c.green),
+            channel(c.blue),
+            channel(c.alpha),
+        ))
+    };
+    editor.with_buffer(|buffer| {
+        let line_height = buffer.metrics().line_height;
+        let line_h = line_height.ceil() as i32;
+        let tick_h = (line_height / 8.0).ceil().max(1.0) as i32;
+        let mut last_line = None;
+        for run in buffer.layout_runs() {
+            let Some(mark) = marks
+                .get(run.line_i)
+                .filter(|_| !folding::is_folded_run(&run))
+            else {
+                continue;
+            };
+            let top = run.line_top as i32;
+            if let Some(color) = color(mark.line) {
+                draw_rect(
+                    pixels,
+                    canvas,
+                    Canvas {
+                        w: bar_w,
+                        h: line_h,
+                    },
+                    Offset { x: 0, y: top },
+                    color,
+                );
+            }
+            // Wrapped lines have several runs: the tick goes on the first only
+            if last_line != Some(run.line_i)
+                && let Some(color) = color(mark.deleted_above)
+            {
+                draw_rect(
+                    pixels,
+                    canvas,
+                    Canvas {
+                        w: tick_w,
+                        h: tick_h,
+                    },
+                    Offset { x: 0, y: top },
+                    color,
+                );
+            }
+            last_line = Some(run.line_i);
+        }
+    });
+}
+
+/// The line whose clickable change mark is at `x`, `y` (physical pixels from the left of the
+/// change area and the top of the view), given the visible rows as `(line, top)` in order.
+/// Clickable: the bar of an unsaved line, and the top third of the first row of a line with an
+/// unsaved deletion tick. Saved (green) marks are not clickable.
+pub(super) fn change_mark_hit(
+    x: f32,
+    y: f32,
+    area_w: i32,
+    line_height: f32,
+    rows: impl IntoIterator<Item = (usize, f32)>,
+    marks: &[LineMark],
+) -> Option<usize> {
+    if x < 0.0 || x >= area_w as f32 {
+        return None;
+    }
+    let mut last_line = None;
+    for (line_i, top) in rows {
+        let first_row = last_line != Some(line_i);
+        last_line = Some(line_i);
+        if y < top || y >= top + line_height {
+            continue;
+        }
+        let mark = marks.get(line_i)?;
+        let on_tick = first_row
+            && mark.deleted_above == Mark::Unsaved
+            && y < top + (line_height / 3.0).max(1.0);
+        return (mark.line == Mark::Unsaved || on_tick).then_some(line_i);
+    }
+    None
+}
+
+/// Tint the unsaved changed text of each visible line with the theme warning colour at low alpha,
+/// behind the glyphs. A range over a wrapped line covers its part in each visual row.
+pub(super) fn draw_change_tints(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    tints: &Tints,
+    theme: &cosmic::cosmic_theme::Theme,
+    line_height: f32,
+) {
+    let c = theme.warning_color();
+    let channel = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+    // Light enough to keep the text readable in light and dark themes
+    let color = cosmic_text::Color::rgba(channel(c.red), channel(c.green), channel(c.blue), 56);
+    editor.with_buffer(|buffer| {
+        for run in buffer
+            .layout_runs()
+            .filter(|run| !folding::is_folded_run(run))
+        {
+            for range in tints.line(run.line_i) {
+                let start = Cursor::new(run.line_i, range.start);
+                let end = Cursor::new(run.line_i, range.end);
+                for (x, w) in run.highlight(start, end) {
+                    let left = x.floor();
+                    renderer.rectangle(
+                        left as i32,
+                        run.line_top as i32,
+                        (x + w - left).ceil() as u32,
+                        line_height as u32,
+                        color,
+                    );
+                }
+            }
+        }
+    });
+}
+
+/// Above this many bytes, a line is searched for find matches only around its visible rows
+pub(super) const FIND_LINE_BYTES: usize = 64 * 1024;
+
+/// How far around the visible part of such a line its matches are searched
+pub(super) const FIND_MARGIN_BYTES: usize = 1024;
+
+/// For a query that spans lines: how many lines before and after the visible ones are joined
+/// with them to find the matches. A match reaching further than this is drawn only in part.
+pub(super) const FIND_MARGIN_LINES: usize = 200;
+
+/// For a query that spans lines: above this many bytes the joined lines are not searched as
+/// one, and the matches are drawn line by line (a huge line, a minified file)
+pub(super) const FIND_JOINED_BYTES: usize = 1024 * 1024;
+
+/// Highlight the matches of the find bar's query in the visible rows, in the accent colour at
+/// low alpha, behind the selection. Only the visible lines are searched, each frame: the full
+/// scan of the match count is never needed for drawing.
+pub(super) fn draw_find_matches(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    regex: &regex::Regex,
+    joined: Option<bool>,
+    range: Option<(find_range::Pos, find_range::Pos)>,
+    theme: &cosmic::cosmic_theme::Theme,
+    line_height: f32,
+) {
+    // "In selection": only the matches inside its range
+    let shown = |start: Cursor, end: Cursor| {
+        range.is_none_or(|range| {
+            find_range::inside((start.line, start.index), (end.line, end.index), range)
+        })
+    };
+    let c = theme.accent_color();
+    let channel = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+    let color = cosmic_text::Color::rgba(channel(c.red), channel(c.green), channel(c.blue), 72);
+    if let Some(real_endings) = joined
+        && draw_joined_find_matches(
+            renderer,
+            editor,
+            regex,
+            real_endings,
+            &shown,
+            color,
+            line_height,
+        )
+    {
+        return;
+    }
+    editor.with_buffer(|buffer| {
+        // The matches of the line the last run was on: a wrapped line is searched once
+        let mut line_spans: Option<(usize, Vec<(usize, usize)>)> = None;
+        for run in buffer
+            .layout_runs()
+            .filter(|run| !folding::is_folded_run(run))
+        {
+            let text = buffer.lines[run.line_i].text();
+            let window;
+            let spans: &[(usize, usize)] = if text.len() <= FIND_LINE_BYTES {
+                if line_spans
+                    .as_ref()
+                    .is_none_or(|(line, _)| *line != run.line_i)
+                {
+                    let spans = find_count::line_matches(regex, text).collect();
+                    line_spans = Some((run.line_i, spans));
+                }
+                line_spans.as_ref().map_or(&[], |(_, spans)| spans)
+            } else {
+                // A huge line (minified, a log): only the part this row shows
+                let Some(first) = run.glyphs.iter().map(|glyph| glyph.start).min() else {
+                    continue;
+                };
+                let last = run
+                    .glyphs
+                    .iter()
+                    .map(|glyph| glyph.end)
+                    .max()
+                    .unwrap_or(first);
+                let from = floor_boundary(text, first.saturating_sub(FIND_MARGIN_BYTES));
+                let to = ceil_boundary(text, last + FIND_MARGIN_BYTES);
+                window = find_count::line_matches(regex, &text[from..to])
+                    .map(|(start, end)| (start + from, end + from))
+                    .collect::<Vec<_>>();
+                &window
+            };
+            for &(start, end) in spans {
+                let start = Cursor::new(run.line_i, start);
+                let end = Cursor::new(run.line_i, end);
+                if !shown(start, end) {
+                    continue;
+                }
+                for (x, w) in run.highlight(start, end) {
+                    let left = x.floor();
+                    renderer.rectangle(
+                        left as i32,
+                        run.line_top as i32,
+                        (x + w - left).ceil() as u32,
+                        line_height as u32,
+                        color,
+                    );
+                }
+            }
+        }
+    });
+}
+
+/// Draw the find bar's "In selection" range behind its matches, in the accent colour at a lower
+/// alpha than they have: the selection it was taken from goes as soon as Find next selects a
+/// match, the range stays visible.
+pub(super) fn draw_find_range(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    (from, to): (find_range::Pos, find_range::Pos),
+    theme: &cosmic::cosmic_theme::Theme,
+    line_height: f32,
+) {
+    let c = theme.accent_color();
+    let channel = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+    let color = cosmic_text::Color::rgba(channel(c.red), channel(c.green), channel(c.blue), 28);
+    editor.with_buffer(|buffer| {
+        for run in buffer
+            .layout_runs()
+            .filter(|run| !folding::is_folded_run(run))
+        {
+            let line = run.line_i;
+            if line < from.0 || line > to.0 {
+                continue;
+            }
+            let start = Cursor::new(line, if line == from.0 { from.1 } else { 0 });
+            let len = buffer.lines[line].text().len();
+            let end = Cursor::new(line, if line == to.0 { to.1.min(len) } else { len });
+            for (x, w) in run.highlight(start, end) {
+                // An empty line inside the range still shows a sliver
+                let w = if w < 1.0 && line < to.0 { 4.0 } else { w };
+                let left = x.floor();
+                renderer.rectangle(
+                    left as i32,
+                    run.line_top as i32,
+                    (x + w - left).ceil() as u32,
+                    line_height as u32,
+                    color,
+                );
+            }
+        }
+    });
+}
+
+/// `draw_find_matches` for a query that spans lines: the visible lines and
+/// `FIND_MARGIN_LINES` around them are joined and searched, and each visible row draws its part
+/// of the matches. False, drawing nothing, when those lines exceed `FIND_JOINED_BYTES`.
+pub(super) fn draw_joined_find_matches(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    regex: &regex::Regex,
+    real_endings: bool,
+    shown: &dyn Fn(Cursor, Cursor) -> bool,
+    color: cosmic_text::Color,
+    line_height: f32,
+) -> bool {
+    editor.with_buffer(|buffer| {
+        let visible = || {
+            buffer
+                .layout_runs()
+                .filter(|run| !folding::is_folded_run(run))
+        };
+        let Some((first, last)) = visible().fold(None, |range, run| match range {
+            None => Some((run.line_i, run.line_i)),
+            Some((first, last)) => Some((run.line_i.min(first), run.line_i.max(last))),
+        }) else {
+            return true;
+        };
+        let from = first.saturating_sub(FIND_MARGIN_LINES);
+        let to = (last + FIND_MARGIN_LINES + 1).min(buffer.lines.len());
+        let lines = &buffer.lines[from..to];
+        if lines
+            .iter()
+            .map(|line| line.text().len() + 2)
+            .sum::<usize>()
+            > FIND_JOINED_BYTES
+        {
+            return false;
+        }
+        let joined = find_text::Joined::new(
+            lines.iter().map(|line| (line.text(), line.ending())),
+            from,
+            real_endings,
+        );
+        let spans: Vec<(Cursor, Cursor)> = find_count::line_matches(regex, &joined.text)
+            .map(|(start, end)| (joined.cursor(start), joined.cursor(end)))
+            .filter(|(start, end)| end.line >= first && start.line <= last && shown(*start, *end))
+            .collect();
+        for run in visible() {
+            let line = run.line_i;
+            for &(start, end) in &spans {
+                if line < start.line || line > end.line {
+                    continue;
+                }
+                let start = if start.line == line {
+                    start
+                } else {
+                    Cursor::new(line, 0)
+                };
+                let end = if end.line == line {
+                    end
+                } else {
+                    Cursor::new(line, buffer.lines[line].text().len())
+                };
+                for (x, w) in run.highlight(start, end) {
+                    let left = x.floor();
+                    renderer.rectangle(
+                        left as i32,
+                        run.line_top as i32,
+                        (x + w - left).ceil() as u32,
+                        line_height as u32,
+                        color,
+                    );
+                }
+            }
+        }
+        true
+    })
+}
+
+/// The largest char boundary of `text` not after `index`
+pub(super) fn floor_boundary(text: &str, index: usize) -> usize {
+    let mut index = index.min(text.len());
+    while !text.is_char_boundary(index) {
+        index -= 1;
+    }
+    index
+}
+
+/// The smallest char boundary of `text` not before `index`
+pub(super) fn ceil_boundary(text: &str, index: usize) -> usize {
+    let mut index = index.min(text.len());
+    while !text.is_char_boundary(index) {
+        index += 1;
+    }
+    index
+}

index 0000000..dba0318
--- /dev/null
+++ b/src/text_box/ext.rs
@@ -0,0 +1,345 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Our options of the text box and the state they need, kept out of `text_box.rs` so it stays
+//! close to upstream: the builders, and hit tests for the gutter.
+
+use super::*;
+use cosmic::widget::segmented_button::Entity;
+use cosmic_text::LineEnding;
+use std::cell::RefCell;
+
+use crate::{
+    change_history::{LineMark, Tints},
+    column_select::Block,
+    find_range, folding,
+    markdown::links,
+    slash_menu, slash_popup,
+};
+
+/// Our options of [`TextBox`], set by the builders below.
+pub(super) struct Ext<'a, Message> {
+    /// Sent instead of `on_changed` for a Vi mode change that left the text as it was
+    pub(super) on_mode_changed: Option<Message>,
+    pub(super) on_edit: Option<Message>,
+    pub(super) on_scroll: Option<Message>,
+    pub(super) change_marks: Option<&'a [LineMark]>,
+    pub(super) change_tints: Option<&'a Tints>,
+    /// The find bar's query: its matches in the visible rows are highlighted. With
+    /// `Some(real_endings)` it spans lines (see `find_text`).
+    pub(super) find_matches: Option<(&'a regex::Regex, Option<bool>)>,
+    /// The find bar's "In selection" range: drawn faintly, and only the matches inside it are
+    /// highlighted
+    pub(super) find_range: Option<(find_range::Pos, find_range::Pos)>,
+    pub(super) on_change_mark: Option<Message>,
+    pub(super) show_whitespace: bool,
+    pub(super) show_line_endings: bool,
+    pub(super) new_line_ending: LineEnding,
+    pub(super) column: Option<&'a Mutex<Option<Block>>>,
+    pub(super) fold_kind: Option<folding::FoldKind>,
+    pub(super) slash_menu: bool,
+    pub(super) md_lists: bool,
+    pub(super) md_task_key: bool,
+    /// Without Vim bindings: an Escape with nothing to cancel goes on to the app.
+    pub(super) escape_to_app: bool,
+    /// The Go to line bar is open: with `escape_to_app` Escape closes it first and keeps the
+    /// selection. The Find dialog is no bar: Escape in the text leaves it open.
+    pub(super) bar_open: bool,
+    pub(super) tab: Option<Entity>,
+    /// Web and mail addresses are underlined; a double-click on one publishes this.
+    pub(super) on_link: Option<fn(String) -> Message>,
+}
+
+impl<Message> Ext<'_, Message> {
+    pub(super) fn new() -> Self {
+        Self {
+            on_mode_changed: None,
+            on_edit: None,
+            on_scroll: None,
+            change_marks: None,
+            change_tints: None,
+            find_matches: None,
+            find_range: None,
+            on_change_mark: None,
+            show_whitespace: false,
+            show_line_endings: false,
+            new_line_ending: LineEnding::Lf,
+            column: None,
+            fold_kind: None,
+            slash_menu: false,
+            md_lists: false,
+            md_task_key: false,
+            escape_to_app: false,
+            bar_open: false,
+            tab: None,
+            on_link: None,
+        }
+    }
+}
+
+/// Our part of the widget [`State`].
+pub(super) struct StateExt {
+    /// Width of the change history area at the left of the gutter, in physical pixels.
+    pub(super) change_area_w: Cell<i32>,
+    /// Left edge and width of the fold chevrons in the gutter, in physical pixels.
+    pub(super) fold_area: Cell<(i32, i32)>,
+    /// Whether the pointer is over the gutter, which shows every `▾`.
+    pub(super) gutter_hover: Cell<bool>,
+    /// The scroll position last reported by `on_scroll`.
+    pub(super) reported_scroll: Cell<Option<(usize, f32, f32)>>,
+    /// The open "/" command menu.
+    pub(super) slash: Option<slash_popup::Open>,
+    /// The last query of the "/" menu and its items, so one query is filtered once.
+    pub(super) slash_filter: RefCell<Option<(String, Vec<&'static slash_menu::Item>)>>,
+    /// The item widths of the open "/" menu, measured once per menu.
+    pub(super) slash_widths: slash_popup::Widths,
+}
+
+impl StateExt {
+    pub(super) fn new() -> Self {
+        Self {
+            change_area_w: Cell::new(0),
+            fold_area: Cell::new((0, 0)),
+            gutter_hover: Cell::new(false),
+            reported_scroll: Cell::new(None),
+            slash: None,
+            slash_filter: RefCell::new(None),
+            slash_widths: Vec::new(),
+        }
+    }
+}
+
+impl<'a, Message> TextBox<'a, Message>
+where
+    Message: Clone,
+{
+    /// Typing "/" at the start of a line opens the Markdown command menu (see `slash_menu`).
+    pub fn slash_menu(mut self, enabled: bool) -> Self {
+        self.ext.slash_menu = enabled;
+        self
+    }
+
+    /// A Markdown file: Ctrl+Enter is left to the Toggle task shortcut, and with `lists` Enter,
+    /// Tab and Backspace edit list items and tables (see `md_lists`, `md_table`).
+    pub fn markdown_lists(mut self, lists: bool) -> Self {
+        self.ext.md_lists = lists;
+        self.ext.md_task_key = true;
+        self
+    }
+
+    /// Vim bindings off: an Escape with no selection to clear is not taken, so it closes the
+    /// context drawer or the find bar. With Vim bindings Escape always stays in the editor.
+    pub fn escape_to_app(mut self, escape_to_app: bool) -> Self {
+        self.ext.escape_to_app = escape_to_app;
+        self
+    }
+
+    /// The find or Go to line bar is open: an Escape (Vim bindings off) closes it before it
+    /// clears the selection, as the next Escape then does.
+    pub fn bar_open(mut self, bar_open: bool) -> Self {
+        self.ext.bar_open = bar_open;
+        self
+    }
+
+    /// The tab whose editor this is: tells tabs apart for the "/" menu, also after one closes.
+    pub fn tab(mut self, tab: Entity) -> Self {
+        self.ext.tab = Some(tab);
+        self
+    }
+
+    /// The editor's identity for the "/" menu (see `slash_popup::EditorId`).
+    pub(super) fn editor_id(&self) -> slash_popup::EditorId {
+        (self.ext.tab, std::ptr::from_ref(self.editor) as usize)
+    }
+
+    /// Sent instead of `on_changed` when a key changed only the Vi mode, not the text
+    pub fn on_mode_changed(mut self, on_mode_changed: Message) -> Self {
+        self.ext.on_mode_changed = Some(on_mode_changed);
+        self
+    }
+
+    /// Sent when a key or input method text changed the text (see [`EditPrint`]).
+    pub fn on_edit(mut self, on_edit: Message) -> Self {
+        self.ext.on_edit = Some(on_edit);
+        self
+    }
+
+    /// Draw the change history bar left of the line numbers.
+    pub fn change_marks(mut self, marks: &'a [LineMark]) -> Self {
+        self.ext.change_marks = Some(marks);
+        self
+    }
+
+    /// Tint the unsaved changed text behind the glyphs.
+    pub fn change_tints(mut self, tints: &'a Tints) -> Self {
+        self.ext.change_tints = Some(tints);
+        self
+    }
+
+    /// Highlight the matches of the find bar's query in the visible rows; `joined` as
+    /// `App::find_joined` gives it, for a query that spans lines
+    pub fn find_matches(mut self, regex: &'a regex::Regex, joined: Option<bool>) -> Self {
+        self.ext.find_matches = Some((regex, joined));
+        self
+    }
+
+    /// The find bar's "In selection" range (see `find_range`)
+    pub fn find_range(mut self, range: (find_range::Pos, find_range::Pos)) -> Self {
+        self.ext.find_range = Some(range);
+        self
+    }
+
+    /// Draw a faint dot on each space and an arrow on each tab.
+    pub fn show_whitespace(mut self, show: bool) -> Self {
+        self.ext.show_whitespace = show;
+        self
+    }
+
+    /// Draw a faint marker after each line end (LF, CRLF or CR).
+    pub fn show_line_endings(mut self, show: bool) -> Self {
+        self.ext.show_line_endings = show;
+        self
+    }
+
+    /// The line ending Enter inserts (LF by default, as upstream).
+    pub fn new_line_ending(mut self, ending: LineEnding) -> Self {
+        self.ext.new_line_ending = ending;
+        self
+    }
+
+    /// Enable column selection (Alt+drag, Alt+Shift+arrows), kept in `column`.
+    pub fn column_block(mut self, column: &'a Mutex<Option<Block>>) -> Self {
+        self.ext.column = Some(column);
+        self
+    }
+
+    /// Show fold chevrons right of the line numbers, and drop folds an edit touches.
+    pub fn folding(mut self, kind: folding::FoldKind) -> Self {
+        self.ext.fold_kind = Some(kind);
+        self
+    }
+
+    /// The header whose fold chevron is at `p` (in logical pixels relative to the widget).
+    pub(super) fn chevron_at(&self, state: &State, p: Point) -> Option<usize> {
+        let kind = self.ext.fold_kind?;
+        let (area_x, area_w) = state.ext.fold_area.get();
+        let scale_factor = state.scale_factor.get();
+        let x = (p.x - self.padding.left) * scale_factor;
+        let y = (p.y - self.padding.top) * scale_factor;
+        if x < area_x as f32 || x >= (area_x + area_w) as f32 {
+            return None;
+        }
+        let editor = self.editor.lock().unwrap();
+        editor.with_buffer(|buffer| {
+            let line_height = buffer.metrics().line_height;
+            let line = buffer
+                .layout_runs()
+                .find(|run| {
+                    !folding::is_folded_run(run)
+                        && y >= run.line_top
+                        && y < run.line_top + line_height
+                })?
+                .line_i;
+            (folding::is_fold_header(buffer, line)
+                || folding::is_foldable(|i| buffer.lines.get(i).map(|l| l.text()), line, kind))
+            .then_some(line)
+        })
+    }
+
+    /// A plain click or key leaves column selection.
+    pub(super) fn leave_column(&self) {
+        if let Some(column) = self.ext.column {
+            *column.lock().unwrap() = None;
+        }
+    }
+
+    /// Publish `message` on a left click on an unsaved change bar or deletion tick.
+    pub fn on_change_mark(mut self, message: Message) -> Self {
+        self.ext.on_change_mark = Some(message);
+        self
+    }
+
+    /// The line whose unsaved change mark is at `p` (in logical pixels relative to the widget).
+    pub(super) fn change_mark_at(&self, state: &State, p: Point) -> Option<usize> {
+        let marks = self.ext.change_marks?;
+        let scale_factor = state.scale_factor.get();
+        let x = (p.x - self.padding.left) * scale_factor;
+        let y = (p.y - self.padding.top) * scale_factor;
+        let editor = self.editor.lock().unwrap();
+        editor.with_buffer(|buffer| {
+            let line_height = buffer.metrics().line_height;
+            // A hidden row shares its top with the next visible one
+            let rows = buffer
+                .layout_runs()
+                .filter(|run| !folding::is_folded_run(run))
+                .map(|run| (run.line_i, run.line_top));
+            change_mark_hit(
+                x,
+                y,
+                state.ext.change_area_w.get(),
+                line_height,
+                rows,
+                marks,
+            )
+        })
+    }
+
+    /// Published when the view moved up or down (wheel, scroll bar, keys, cursor motion).
+    pub fn on_scroll(mut self, on_scroll: Message) -> Self {
+        self.ext.on_scroll = Some(on_scroll);
+        self
+    }
+
+    /// Underline web and mail addresses, and publish `on_link` with the address on a
+    /// double-click on one (see [`links::double_click`]).
+    pub fn on_link(mut self, on_link: fn(String) -> Message) -> Self {
+        self.ext.on_link = Some(on_link);
+        self
+    }
+
+    /// A double-click at `x`, `y` (buffer coordinates, as for [`Action::DoubleClick`]): on an
+    /// address it publishes `on_link` and places the cursor, returning true; elsewhere it does
+    /// nothing and returns false, so the word is selected.
+    pub(super) fn link_double_click(
+        &self,
+        editor: &mut BorrowedWithFontSystem<'_, ViEditor<'static, 'static>>,
+        x: f32,
+        y: f32,
+        shell: &mut Shell<'_, Message>,
+    ) -> bool {
+        let Some(on_link) = self.ext.on_link else {
+            return false;
+        };
+        // The character under the pointer: right of a line's end or below the last row there
+        // is none, and the word is selected as before
+        let action = editor.with_buffer(|buffer| {
+            let under = buffer
+                .layout_runs()
+                .filter(|run| !folding::is_folded_run(run))
+                .filter(|run| y >= run.line_top && y < run.line_top + run.line_height)
+                .find_map(|run| {
+                    run.glyphs
+                        .iter()
+                        .find(|glyph| x >= glyph.x && x < glyph.x + glyph.w)
+                        .map(|glyph| (run.line_i, glyph.start))
+                });
+            links::double_click(under.map(|(line, index)| (buffer.lines[line].text(), index)))
+        });
+        match action {
+            links::DoubleClick::Open(target) => {
+                editor.action(Action::Click {
+                    x: x as i32,
+                    y: y as i32,
+                });
+                shell.publish(on_link(target));
+                true
+            }
+            links::DoubleClick::SelectWord => false,
+        }
+    }
+
+    /// The pointer is over an unsaved change mark that opens compare, or a fold chevron.
+    pub(super) fn gutter_pointer(&self, state: &State, p: Point) -> bool {
+        self.ext.on_change_mark.is_some() && self.change_mark_at(state, p).is_some()
+            || self.chevron_at(state, p).is_some()
+    }
+}
diff --git a/src/text_box/keys.rs b/src/text_box/keys.rs
new file mode 100644
index 0000000..dc0c827
--- /dev/null
+++ b/src/text_box/keys.rs
@@ -0,0 +1,1174 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Our key and mouse handling in the text box (column selection, folds, the "/" menu, the
+//! edit print), kept out of `text_box.rs` so it stays close to upstream.
+
+use super::*;
+use cosmic_text::LineEnding;
+use std::cell::RefCell;
+
+use crate::{
+    column_select::{self, Block, Pos},
+    folding, md_edit, md_lists, md_table,
+    slash_menu::{self, Menu},
+    slash_popup::{self, Popup},
+    whitespace,
+};
+
+/// The line and visual column at `x`, `y` (buffer pixels). Right of the end of a line the
+/// empty columns count too, so a block can reach past short lines.
+pub(super) fn column_pos(editor: &ViEditor<'static, 'static>, x: f32, y: f32) -> Option<Pos> {
+    let tab_width = editor.tab_width() as usize;
+    editor.with_buffer(|buffer| {
+        let cursor = buffer.hit(x, y)?;
+        let text = buffer.lines.get(cursor.line)?.text();
+        let mut col = column_select::col_of(text, cursor.index, tab_width);
+        if cursor.index == text.len() {
+            let char_w = buffer
+                .layout_runs()
+                .filter(|run| !folding::is_folded_run(run))
+                .flat_map(|run| run.glyphs.iter().map(move |glyph| (run.text, glyph)))
+                .find(|(text, glyph)| text.get(glyph.start..glyph.end) != Some("\t"))
+                .map(|(_, glyph)| glyph.w)
+                .unwrap_or(buffer.metrics().font_size * 0.6)
+                .max(1.0);
+            let end_x = buffer
+                .layout_runs()
+                .filter(|run| run.line_i == cursor.line)
+                .find_map(|run| run.cursor_position(&cursor));
+            if let Some(end_x) = end_x
+                && x > end_x
+            {
+                col += ((x - end_x) / char_w).round() as usize;
+            }
+        }
+        Some(Pos::new(cursor.line, col))
+    })
+}
+
+/// Start (`drag` false) or extend a column selection to `x`, `y` (buffer pixels).
+pub(super) fn column_press(
+    column: &Mutex<Option<Block>>,
+    editor: &mut ViEditor<'static, 'static>,
+    x: f32,
+    y: f32,
+    drag: bool,
+) {
+    let Some(pos) = column_pos(editor, x, y) else {
+        return;
+    };
+    let mut column = column.lock().unwrap();
+    let block = match *column {
+        Some(block) if drag => Block::new(block.anchor, pos),
+        _ => Block::new(pos, pos),
+    };
+    editor.set_selection(Selection::None);
+    unfold_block(editor, &block);
+    column_select::place_cursor(editor, &block);
+    *column = Some(block);
+}
+
+/// Handle a key for column selection: Alt+Shift+arrows start or extend it, and while it is
+/// active typing, Backspace and Delete act on every line. Navigation keys leave it and go on
+/// to their usual action. Returns true when the key was used up.
+pub(super) fn column_key(
+    column: &Mutex<Option<Block>>,
+    editor: &mut ViEditor<'static, 'static>,
+    event: &Event,
+) -> bool {
+    let Event::Keyboard(KeyEvent::KeyPressed {
+        modified_key,
+        modifiers,
+        text,
+        ..
+    }) = event
+    else {
+        return false;
+    };
+    let mut column = column.lock().unwrap();
+    if modifiers.alt() && modifiers.shift() {
+        let step = match modified_key {
+            Key::Named(Named::ArrowUp) => Some((-1, 0)),
+            Key::Named(Named::ArrowDown) => Some((1, 0)),
+            Key::Named(Named::ArrowLeft) => Some((0, -1)),
+            Key::Named(Named::ArrowRight) => Some((0, 1)),
+            _ => None,
+        };
+        if let Some((lines, cols)) = step {
+            editor.set_selection(Selection::None);
+            let block = column_select::extend(editor, *column, lines, cols);
+            unfold_block(editor, &block);
+            *column = Some(block);
+            return true;
+        }
+    }
+    let Some(block) = *column else {
+        return false;
+    };
+    let shortcut = modifiers.control() || modifiers.alt() || modifiers.logo();
+    match modified_key {
+        Key::Named(Named::Backspace) if !shortcut => {
+            *column = Some(column_select::delete(editor, &block, false));
+            true
+        }
+        Key::Named(Named::Delete) if !shortcut => {
+            *column = Some(column_select::delete(editor, &block, true));
+            true
+        }
+        // Ctrl+Backspace/Delete edit at the single cursor: leave block mode first
+        Key::Named(Named::Backspace | Named::Delete) => {
+            *column = None;
+            editor.set_redraw(true);
+            false
+        }
+        Key::Named(Named::Escape) => {
+            *column = None;
+            editor.set_redraw(true);
+            true
+        }
+        Key::Named(
+            Named::ArrowUp
+            | Named::ArrowDown
+            | Named::ArrowLeft
+            | Named::ArrowRight
+            | Named::Home
+            | Named::End
+            | Named::PageUp
+            | Named::PageDown
+            | Named::Enter
+            | Named::Tab,
+        ) => {
+            *column = None;
+            editor.set_redraw(true);
+            false
+        }
+        _ => match text.as_deref() {
+            Some(text) if !shortcut && !text.chars().any(char::is_control) && !text.is_empty() => {
+                *column = Some(column_select::insert(editor, &block, text));
+                true
+            }
+            _ => false,
+        },
+    }
+}
+
+/// A column block edits every line it covers: unfold those first, so hidden text is never
+/// edited.
+pub(super) fn unfold_block(editor: &mut ViEditor<'static, 'static>, block: &Block) {
+    editor.with_buffer_mut(|buffer| folding::unfold_lines(buffer, block.top(), block.bottom()));
+}
+
+/// Whether `event` changes the text in the text box's `update`, as typing, Enter, Backspace,
+/// Delete, Tab or an input method commit do.
+pub(super) fn is_edit(event: &Event, state_modifiers: Modifiers) -> bool {
+    match event {
+        Event::Keyboard(KeyEvent::KeyPressed {
+            modified_key: Key::Named(Named::Enter | Named::Backspace | Named::Delete),
+            ..
+        }) => true,
+        Event::Keyboard(KeyEvent::KeyPressed {
+            modified_key: Key::Named(Named::Tab),
+            modifiers,
+            ..
+        }) => !modifiers.control() && !modifiers.alt(),
+        Event::Keyboard(KeyEvent::KeyPressed { text, .. }) => {
+            !state_modifiers.logo()
+                && !state_modifiers.control()
+                && !state_modifiers.alt()
+                && text
+                    .as_deref()
+                    .and_then(|text| text.chars().next())
+                    .is_some_and(|c| !c.is_control())
+        }
+        Event::InputMethod(InputMethodEvent::Commit(_)) => true,
+        _ => false,
+    }
+}
+
+/// What a key can change, taken before the key: the number of lines and a hash of the lines
+/// of the cursor, the selection and the column block. Keys and input method text edit there
+/// (typing, Enter, Backspace, Tab over a selection, the Markdown and column keys), so the same
+/// lines after the key tell whether it edited, without reading the whole text. Vim commands
+/// that edit away from the cursor and keep the line count (`u` on a far line) are not seen;
+/// the app's own edits (paste, undo, replace) report themselves.
+pub(super) struct EditPrint {
+    len: usize,
+    cursor: usize,
+    /// The lines hashed; `None` when they are more than [`EditPrint::MAX_LINES`]: then only
+    /// the line count, the cursor line and the summed length of the lines tell an edit.
+    lines: Option<(usize, usize, u64)>,
+    /// Bytes in the lines `first..=last` when they are too many to hash (indenting or typing
+    /// into a column block over them changes this, not the line count).
+    size: Option<(usize, usize, usize)>,
+}
+
+impl EditPrint {
+    const MAX_LINES: usize = 10_000;
+
+    pub(super) fn new(editor: &ViEditor<'static, 'static>, block: Option<&Block>) -> Self {
+        let cursor = editor.cursor().line;
+        let (mut first, mut last) = (cursor, cursor);
+        if let Some((start, end)) = editor.selection_bounds() {
+            first = first.min(start.line);
+            last = last.max(end.line);
+        }
+        if let Some(block) = block {
+            first = first.min(block.top());
+            last = last.max(block.bottom());
+        }
+        editor.with_buffer(|buffer| {
+            let small = last - first < Self::MAX_LINES;
+            Self {
+                len: buffer.lines.len(),
+                cursor,
+                lines: small.then(|| (first, last, Self::hash(&buffer.lines, first, last))),
+                size: (!small).then(|| (first, last, Self::size(&buffer.lines, first, last))),
+            }
+        })
+    }
+
+    fn hash(lines: &[cosmic_text::BufferLine], first: usize, last: usize) -> u64 {
+        let mut hasher = std::hash::DefaultHasher::new();
+        for line in lines.iter().take(last + 1).skip(first) {
+            std::hash::Hash::hash(line.text(), &mut hasher);
+        }
+        std::hash::Hasher::finish(&hasher)
+    }
+
+    fn size(lines: &[cosmic_text::BufferLine], first: usize, last: usize) -> usize {
+        let lines = lines.iter().take(last + 1).skip(first);
+        lines.map(|line| line.text().len()).sum()
+    }
+
+    pub(super) fn edited(&self, editor: &ViEditor<'static, 'static>) -> bool {
+        let Some((first, last, hash)) = self.lines else {
+            // Typing over a huge selection replaces it: the lines or the cursor line change;
+            // indenting it or typing into a huge column block changes the lines' length
+            return editor.cursor().line != self.cursor
+                || editor.with_buffer(|buffer| {
+                    buffer.lines.len() != self.len
+                        || self.size.is_some_and(|(first, last, size)| {
+                            Self::size(&buffer.lines, first, last) != size
+                        })
+                });
+        };
+        editor.with_buffer(|buffer| {
+            buffer.lines.len() != self.len || Self::hash(&buffer.lines, first, last) != hash
+        })
+    }
+
+    /// Whether `event` is one that may edit, worth an [`EditPrint`]: not a modifier key on
+    /// its own, nor a key that only moves the cursor
+    pub(super) fn may_edit(event: &Event) -> bool {
+        match event {
+            Event::Keyboard(KeyEvent::KeyPressed {
+                modified_key: Key::Named(key),
+                ..
+            }) => !matches!(
+                key,
+                Named::Shift
+                    | Named::Control
+                    | Named::Alt
+                    | Named::AltGraph
+                    | Named::Super
+                    | Named::Meta
+                    | Named::Hyper
+                    | Named::Fn
+                    | Named::CapsLock
+                    | Named::NumLock
+                    | Named::ScrollLock
+                    | Named::ArrowUp
+                    | Named::ArrowDown
+                    | Named::ArrowLeft
+                    | Named::ArrowRight
+                    | Named::Home
+                    | Named::End
+                    | Named::PageUp
+                    | Named::PageDown
+            ),
+            Event::Keyboard(KeyEvent::KeyPressed { .. })
+            | Event::InputMethod(InputMethodEvent::Commit(_)) => true,
+            _ => false,
+        }
+    }
+}
+
+/// After a cursor motion: step over a fold instead of landing inside it.
+pub(super) fn skip_fold(
+    editor: &mut BorrowedWithFontSystem<'_, ViEditor<'static, 'static>>,
+    from: Cursor,
+) {
+    let to = editor.cursor();
+    let skipped = editor.with_buffer(|buffer| folding::skip_fold(buffer, from, to));
+    if skipped != to {
+        editor.set_cursor(skipped);
+    }
+}

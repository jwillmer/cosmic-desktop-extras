+/// Underline the web and mail addresses in the visible rows in the text colour, as Notepad++
+/// does: a double-click opens them. Only the visible lines are searched, each frame, and lines
+/// longer than [`links::MAX_LINE_BYTES`] not at all.
+pub(super) fn draw_link_underlines(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    metrics: Metrics,
+) {
+    let fg = editor.foreground_color();
+    let thickness = (metrics.font_size / 14.0).round().max(1.0);
+    editor.with_buffer(|buffer| {
+        // The links of the line the last run was on: a wrapped line is searched once
+        let mut line_links: Option<(usize, Vec<links::Found>)> = None;
+        for run in buffer
+            .layout_runs()
+            .filter(|run| !folding::is_folded_run(run))
+        {
+            if line_links
+                .as_ref()
+                .is_none_or(|(line, _)| *line != run.line_i)
+            {
+                let text = buffer.lines[run.line_i].text();
+                let found = if text.len() <= links::MAX_LINE_BYTES {
+                    links::find(text, links::Flavor::Text)
+                } else {
+                    Vec::new()
+                };
+                line_links = Some((run.line_i, found));
+            }
+            let Some((_, found)) = &line_links else {
+                continue;
+            };
+            for link in found {
+                let start = Cursor::new(run.line_i, link.range.start);
+                let end = Cursor::new(run.line_i, link.range.end);
+                for (x, w) in run.highlight(start, end) {
+                    renderer.rectangle(
+                        x.round() as i32,
+                        (run.line_y + thickness).round() as i32,
+                        w.round().max(1.0) as u32,
+                        thickness as u32,
+                        fg,
+                    );
+                }
+            }
+        }
+    });
+}

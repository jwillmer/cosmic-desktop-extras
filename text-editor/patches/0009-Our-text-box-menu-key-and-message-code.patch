+impl<'a, Message> TextBox<'a, Message>
+where
+    Message: Clone,
+{
+    /// The "/" menu popup, while it is open in this editor.
+    pub(super) fn slash_overlay<'b>(
+        &'b mut self,
+        tree: &'b mut widget::Tree,
+        layout: Layout<'b>,
+        renderer: &Renderer,
+        translation: Vector,
+    ) -> Option<overlay::Element<'b, Message, cosmic::Theme, Renderer>> {
+        let state = tree.state.downcast_mut::<State>();
+        let open = state.ext.slash.filter(|open| {
+            self.ext.slash_menu && state.is_focused && open.editor == self.editor_id()
+        })?;
+        let (items, position) = {
+            let editor = self.editor.lock().unwrap();
+            let items = slash_items(&editor, &open.menu, &state.ext.slash_filter)?;
+            let position = editor.with_buffer(|buffer| {
+                let scroll_x = buffer.scroll().horizontal;
+                buffer
+                    .cursor_position(&Cursor::new(open.menu.line, open.menu.start))
+                    .map(|(x, top)| (x - scroll_x, top))
+            });
+            (items, position)
+        };
+        // Not laid out (yet, or scrolled out of view): hidden; `slash_key` closes it
+        let (x, top) = position?;
+        // The line box of the "/", in window coordinates
+        let scale = state.scale_factor.get();
+        let bounds = layout.bounds() + translation;
+        let anchor = Rectangle::new(
+            Point::new(
+                bounds.x + self.padding.left + (state.editor_offset_x.get() as f32 + x) / scale,
+                bounds.y + self.padding.top + top / scale,
+            ),
+            Size::new(1.0, self.metrics.line_height),
+        );
+        // The "/" out of view (resize, horizontal scroll, under the gutter) closes the menu, so
+        // no hidden menu takes keys
+        let text_x = bounds.x + self.padding.left + state.editor_offset_x.get() as f32 / scale;
+        if anchor.y < bounds.y
+            || anchor.y + anchor.height > bounds.y + bounds.height
+            || anchor.x < text_x
+            || anchor.x > bounds.x + bounds.width
+        {
+            state.ext.slash = None;
+            return None;
+        }
+        // A click pick ends like a key pick: folds touched by the edit unfold
+        let fold_kind = self.ext.fold_kind;
+        let ending = self.ext.new_line_ending;
+        let pick = move |editor: &mut ViEditor<'static, 'static>, item: &slash_menu::Item| {
+            slash_pick(editor, item, ending);
+            if let Some(kind) = fold_kind {
+                let line = editor.cursor().line;
+                editor.with_buffer_mut(|buffer| folding::reconcile(buffer, kind, line));
+            }
+        };
+        Some(Popup::new(
+            &mut state.ext.slash,
+            &mut state.ext.slash_widths,
+            self.editor,
+            items,
+            anchor,
+            self.on_changed.clone(),
+            Box::new(pick),
+            renderer,
+        ))
+    }
+}
+
+/// The text of buffer line `line`.
+pub(super) fn line_text(editor: &ViEditor<'static, 'static>, line: usize) -> Option<String> {
+    editor.with_buffer(|buffer| buffer.lines.get(line).map(|line| line.text().to_string()))
+}
+
+/// The items of the "/" menu while it still holds for the cursor, `None` once it should close.
+/// `cache` keeps the last query's items, so the same query is filtered only once.
+pub(super) fn slash_items(
+    editor: &ViEditor<'static, 'static>,
+    menu: &Menu,
+    cache: &RefCell<Option<(String, Vec<&'static slash_menu::Item>)>>,
+) -> Option<Vec<&'static slash_menu::Item>> {
+    if editor.selection() != Selection::None {
+        return None;
+    }
+    let cursor = editor.cursor();
+    let text = line_text(editor, cursor.line)?;
+    let query = slash_menu::open_query(menu, cursor.line, &text, cursor.index)?;
+    let mut cache = cache.borrow_mut();
+    let items = match &*cache {
+        Some((cached, items)) if cached == query => items.clone(),
+        _ => {
+            let items = slash_menu::filter(query);
+            *cache = Some((query.to_string(), items.clone()));
+            items
+        }
+    };
+    (!items.is_empty()).then_some(items)
+}
+
+/// Replace the "/query" before the cursor with `item`, as one undo step. New lines end with
+/// `ending`, like Enter.
+pub(super) fn slash_pick(
+    editor: &mut ViEditor<'static, 'static>,
+    item: &slash_menu::Item,
+    ending: LineEnding,
+) {
+    let cursor = editor.cursor();
+    let Some(text) = line_text(editor, cursor.line) else {
+        return;
+    };
+    let Some(trigger) = slash_menu::trigger(&text, cursor.index) else {
+        return;
+    };
+    let above = cursor
+        .line
+        .checked_sub(1)
+        .and_then(|line| line_text(editor, line));
+    let below = line_text(editor, cursor.line + 1);
+    let edit = slash_menu::edit(
+        &text,
+        &trigger,
+        cursor.index,
+        item,
+        above.as_deref(),
+        below.as_deref(),
+    );
+    let line = cursor.line;
+    let at = |(below, index): slash_menu::RelPos| (line + below, index);
+    let outcome = md_edit::Outcome {
+        changes: vec![md_edit::Change {
+            line,
+            start: edit.start,
+            end: edit.end,
+            text: edit.text,
+        }],
+        cursor: at(edit.cursor),
+        anchor: edit.anchor.map(at),
+    };
+    md_edit::run(editor, ending, |_, _, _| Some(outcome));
+}
+
+/// Keys the open "/" menu takes: Up/Down move the highlight, Enter/Tab pick, Escape closes it
+/// and keeps the text. `true` when the event was used. Mouse input goes to the popup.
+/// `items` are the menu's items before the event.
+pub(super) fn slash_key(
+    state: &mut State,
+    editor: &mut ViEditor<'static, 'static>,
+    event: &Event,
+    items: Option<&[&'static slash_menu::Item]>,
+    ending: LineEnding,
+) -> bool {
+    let (Some(mut open), Some(items)) = (state.ext.slash, items) else {
+        return false;
+    };
+    let Event::Keyboard(KeyEvent::KeyPressed {
+        modified_key: Key::Named(key),
+        modifiers,
+        ..
+    }) = event
+    else {
+        return false;
+    };
+    // Shift too: Shift+Tab unindents, Shift+arrows select
+    if modifiers.control() || modifiers.alt() || modifiers.logo() || modifiers.shift() {
+        return false;
+    }
+    // The line of the "/" scrolled out of view (scroll bar, synchronized scrolling): the menu
+    // is hidden and closes, so no hidden menu takes keys
+    let shown = editor.with_buffer(|buffer| {
+        buffer
+            .cursor_position(&Cursor::new(open.menu.line, open.menu.start))
+            .is_some()
+    });
+    if !shown {
+        state.ext.slash = None;
+        return false;
+    }
+    match key {
+        Named::ArrowUp | Named::ArrowDown => {
+            open.menu.step(*key == Named::ArrowDown, items.len());
+            open.hover = false;
+            open.first = slash_popup::scroll_to_show(open.first, open.menu.selected, items.len());
+            state.ext.slash = Some(open);
+        }
+        Named::Enter | Named::Tab => {
+            slash_pick(
+                editor,
+                items[open.menu.selected.min(items.len() - 1)],
+                ending,
+            );
+            state.ext.slash = None;
+        }
+        Named::Escape => state.ext.slash = None,
+        _ => return false,
+    }
+    true
+}
+
+/// Open the "/" menu when a "/" was just typed where it may start one; close it once the
+/// "/query" no longer holds (cursor moved away, whitespace typed, nothing matches). While the
+/// list changes, the highlight stays on the item highlighted before (`prev`) if it is still
+/// listed, else it goes to the first.
+pub(super) fn slash_follow(
+    state: &mut State,
+    editor: &ViEditor<'static, 'static>,
+    event: &Event,
+    slash_used: bool,
+    prev: Option<*const slash_menu::Item>,
+    editor_id: slash_popup::EditorId,
+) {
+    if slash_used {
+        return;
+    }
+    // A "/" typed, also through an input method
+    let typed_slash = match event {
+        Event::Keyboard(KeyEvent::KeyPressed {
+            text, modifiers, ..
+        }) => {
+            !modifiers.control()
+                && !modifiers.alt()
+                && !modifiers.logo()
+                && text.as_deref() == Some("/")
+        }
+        Event::InputMethod(InputMethodEvent::Commit(text)) => text == "/",
+        _ => false,
+    };
+    if typed_slash && state.ext.slash.is_none() {
+        let cursor = editor.cursor();
+        if let Some(line) = line_text(editor, cursor.line)
+            && let Some(trigger) = slash_menu::trigger(&line, cursor.index)
+            && trigger.query.is_empty()
+            && editor.with_buffer(|buffer| {
+                let lines = buffer.lines.iter().map(|line| line.text());
+                slash_menu::markdown_allows(lines, cursor.line, trigger.start)
+            })
+        {
+            state.ext.slash = Some(slash_popup::Open {
+                menu: Menu {
+                    line: cursor.line,
+                    start: trigger.start,
+                    selected: 0,
+                },
+                first: 0,
+                editor: editor_id,
+                wheel: 0.0,
+                hover: false,
+            });
+            // Measured again per menu: the font or the scale may have changed since
+            state.ext.slash_widths.clear();
+        }
+    }
+    if let Some(open) = &mut state.ext.slash {
+        match slash_items(editor, &open.menu, &state.ext.slash_filter) {
+            None => state.ext.slash = None,
+            Some(items) => {
+                let selected = slash_popup::keep_highlight(
+                    prev,
+                    items.iter().map(|item| slash_popup::item_id(item)),
+                );
+                // Only a moved highlight scrolls, never undoing a wheel scroll
+                if selected != open.menu.selected || prev.is_none() {
+                    open.menu.selected = selected;
+                    open.hover = false;
+                    open.first = slash_popup::scroll_to_show(open.first, selected, items.len());
+                }
+            }
+        }
+    }
+}
+
+/// What [`TextBox::before_keys`] did, for upstream's key handling and [`TextBox::after_keys`].
+pub(super) struct Pre {
+    /// A column block took the event.
+    pub(super) column_used: bool,
+    /// The "/" menu took the event.
+    pub(super) slash_used: bool,
+    /// The "/" menu item selected before the event.
+    slash_prev: Option<*const slash_menu::Item>,
+    /// The "/" menu before the event.
+    slash_before: Option<slash_popup::Open>,
+    editor_id: slash_popup::EditorId,
+}
+
+impl<'a, Message> TextBox<'a, Message>
+where
+    Message: Clone,
+{
+    /// A left click on an unsaved change mark or a fold chevron, taken before upstream sees it:
+    /// returns whether it was taken.
+    pub(super) fn gutter_click(
+        &self,
+        tree: &widget::Tree,
+        event: &Event,
+        layout: Layout<'_>,
+        cursor_position: mouse::Cursor,
+        shell: &mut Shell<'_, Message>,
+    ) -> bool {
+        // A left click on an unsaved change mark opens compare, without moving the cursor
+        if let Event::Mouse(MouseEvent::ButtonPressed(Button::Left)) = event
+            && let Some(message) = &self.ext.on_change_mark
+            && let Some(p) = cursor_position.position_in(layout.bounds())
+            && self
+                .change_mark_at(tree.state.downcast_ref::<State>(), p)
+                .is_some()
+        {
+            shell.publish(message.clone());
+            shell.capture_event();
+            return true;
+        }
+
+        // A left click on a fold chevron folds or unfolds, without moving the cursor
+        if let Event::Mouse(MouseEvent::ButtonPressed(Button::Left)) = event
+            && let Some(kind) = self.ext.fold_kind
+            && let Some(p) = cursor_position.position_in(layout.bounds())
+            && let Some(header) = self.chevron_at(tree.state.downcast_ref::<State>(), p)
+        {
+            self.leave_column();
+            let mut editor = self.editor.lock().unwrap();
+            editor.with_buffer_mut(|buffer| folding::toggle(buffer, header, kind));
+            // Unless the cursor or selection was in the block just folded: it goes to the header
+            folding::leave_folds(&mut *editor);
+            editor.set_redraw(true);
+            shell.request_redraw();
+            shell.capture_event();
+            return true;
+        }
+        false
+    }
+
+    /// The edit print before a key that may edit the text, when someone listens to `on_edit`.
+    pub(super) fn edit_print(
+        &self,
+        state: &State,
+        editor: &ViEditor<'static, 'static>,
+        event: &Event,
+    ) -> Option<EditPrint> {
+        self.ext
+            .on_edit
+            .as_ref()
+            .filter(|_| state.is_focused && EditPrint::may_edit(event))
+            .map(|_| {
+                let block = self.ext.column.and_then(|column| *column.lock().unwrap());
+                EditPrint::new(editor, block.as_ref())
+            })
+    }
+
+    /// Gutter hover, column block keys, unfolding before an edit and the "/" menu's keys:
+    /// before upstream's key handling, which skips the event when one of them took it.
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn before_keys(
+        &self,
+        state: &mut State,
+        editor: &mut ViEditor<'static, 'static>,
+        event: &Event,
+        layout: Layout<'_>,
+        cursor_position: mouse::Cursor,
+        scale_factor: f32,
+        editor_offset_x: i32,
+        shell: &mut Shell<'_, Message>,
+    ) -> Pre {
+        // Over the gutter every foldable line shows its chevron
+        if let Event::Mouse(MouseEvent::CursorMoved { .. } | MouseEvent::CursorLeft) = event {
+            let hover = state.ext.fold_area.get().1 > 0
+                && cursor_position
+                    .position_in(layout.bounds())
+                    .is_some_and(|p| {
+                        ((p.x - self.padding.left) * scale_factor) < editor_offset_x as f32
+                    });
+            if state.ext.gutter_hover.replace(hover) != hover {
+                editor.set_redraw(true);
+            }
+        }
+
+        let column_used = state.is_focused
+            && self
+                .ext
+                .column
+                .is_some_and(|column| column_key(column, editor, event));
+        if column_used {
+            shell.capture_event();
+        }
+        // Never edit hidden text: unfold what the selection reaches into first
+        if !column_used
+            && state.is_focused
+            && self.ext.fold_kind.is_some()
+            && is_edit(event, state.modifiers)
+        {
+            folding::reveal_selection(&mut *editor);
+            if let Event::Keyboard(KeyEvent::KeyPressed {
+                modified_key: Key::Named(key @ (Named::Backspace | Named::Delete)),
+                modifiers,
+                ..
+            }) = event
+            {
+                folding::reveal_join(&mut *editor, *key == Named::Delete, modifiers.control());
+            }
+        }
+
+        // The "/" menu closes when it is off, belongs to another tab, or the text scrolls or
+        // gets a click (clicks on the popup never get here)
+        let slash_before = state.ext.slash;
+        let editor_id = self.editor_id();
+        if state.ext.slash.is_some_and(|open| open.editor != editor_id)
+            || !self.ext.slash_menu
+            || matches!(event, Event::Mouse(MouseEvent::ButtonPressed(_)))
+            || matches!(event, Event::Mouse(MouseEvent::WheelScrolled { .. }))
+                && cursor_position.position_in(layout.bounds()).is_some()
+        {
+            state.ext.slash = None;
+        }
+        // The items before this event, filtered once for the highlight and the menu's keys
+        let slash_before_items = state
+            .ext
+            .slash
+            .and_then(|open| slash_items(editor, &open.menu, &state.ext.slash_filter));
+        if state.ext.slash.is_some() && slash_before_items.is_none() {
+            state.ext.slash = None;
+        }
+        let slash_prev = state.ext.slash.and_then(|open| {
+            let items = slash_before_items.as_ref()?;
+            items
+                .get(open.menu.selected)
+                .map(|item| slash_popup::item_id(item))
+        });
+        let slash_used = !column_used
+            && state.is_focused
+            && self.ext.slash_menu
+            && slash_key(
+                state,
+                editor,
+                event,
+                slash_before_items.as_deref(),
+                self.ext.new_line_ending,
+            );
+        if slash_used {
+            shell.capture_event();
+        }
+
+        Pre {
+            column_used,
+            slash_used,
+            slash_prev,
+            slash_before,
+            editor_id,
+        }
+    }
+
+    /// The "/" menu follows the edit, folds an edit touched unfold, and `on_edit` is
+    /// published: after upstream's key handling. Returns whether the text was edited.
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn after_keys(
+        &self,
+        state: &mut State,
+        editor: &mut ViEditor<'static, 'static>,
+        event: &Event,
+        pre: &Pre,
+        edit_print: Option<&EditPrint>,
+        tab_reformatted: bool,
+        shell: &mut Shell<'_, Message>,
+    ) -> bool {
+        if self.ext.slash_menu && state.is_focused && !pre.column_used {
+            // Turned off (setting, Vim bindings), unfocused or a column block edit: a menu open
+            // before does not come back
+            slash_follow(
+                state,
+                editor,
+                event,
+                pre.slash_used,
+                pre.slash_prev,
+                pre.editor_id,
+            );
+        } else {
+            state.ext.slash = None;
+        }
+        if state.ext.slash != pre.slash_before {
+            shell.request_redraw();
+        }
+
+        // An edit that touches a fold unfolds it (see `folding::reconcile`)
+        if let Some(kind) = self.ext.fold_kind
+            && matches!(
+                event,
+                Event::Keyboard(KeyEvent::KeyPressed { .. })
+                    | Event::InputMethod(InputMethodEvent::Commit(_))
+            )
+        {
+            let line = editor.cursor().line;
+            editor.with_buffer_mut(|buffer| folding::reconcile(buffer, kind, line));
+        }
+
+        let edited = tab_reformatted || edit_print.is_some_and(|print| print.edited(&*editor));
+        if let Some(on_edit) = &self.ext.on_edit
+            && edited
+        {
+            shell.publish(on_edit.clone());
+        }
+        edited
+    }
+
+    /// Publish `on_scroll` when the view moved since it was last reported.
+    pub(super) fn report_scroll(
+        &self,
+        editor: &ViEditor<'static, 'static>,
+        state: &State,
+        shell: &mut Shell<'_, Message>,
+    ) {
+        // Keys scroll during layout (to keep the cursor visible), so compare with the position
+        // last reported, not the one at the start of this event; the next event (key release,
+        // redraw) reports it
+        if let Some(on_scroll) = &self.ext.on_scroll {
+            let scroll = editor.with_buffer(|buffer| buffer.scroll());
+            let scroll = Some((scroll.line, scroll.vertical, scroll.horizontal));
+            if state.ext.reported_scroll.get() != scroll {
+                if state.ext.reported_scroll.get().is_some() {
+                    shell.publish(on_scroll.clone());
+                }
+                state.ext.reported_scroll.set(scroll);
+            }
+        }
+    }
+}
+
+/// The editor as upstream's key handling has it.
+type Borrowed<'b> = BorrowedWithFontSystem<'b, ViEditor<'static, 'static>>;
+
+impl<'a, Message> TextBox<'a, Message>
+where
+    Message: Clone,
+{
+    /// Alt+click in the text starts a column block: returns whether it did.
+    pub(super) fn column_press_at(
+        &self,
+        editor: &mut ViEditor<'static, 'static>,
+        state: &State,
+        x: f32,
+        y: f32,
+        buffer_size: (Option<f32>, Option<f32>),
+        buffer_scroll: Scroll,
+    ) -> bool {
+        if let Some(column) = self.ext.column
+            && state.modifiers.alt()
+            && x >= 0.0
+            && x < buffer_size.0.unwrap_or(0.0)
+            && y >= 0.0
+            && y < buffer_size.1.unwrap_or(0.0)
+        {
+            let x = x + buffer_scroll.horizontal;
+            column_press(column, editor, x, y, false);
+            return true;
+        }
+        false
+    }
+
+    /// An Alt+drag extends the column block to `x`, `y` (`x` with the horizontal scroll).
+    pub(super) fn column_drag(&self, editor: &mut ViEditor<'static, 'static>, x: f32, y: f32) {
+        if let Some(column) = self.ext.column {
+            column_press(column, editor, x, y, true);
+        }
+    }
+
+    pub(super) fn escape_key(&self, editor: &mut Borrowed<'_>, shell: &mut Shell<'_, Message>) {
+        // Nothing to cancel, or the find bar is open: the app gets the key and closes
+        // the bar or the context drawer; a selection stays for the next Escape
+        if !(self.ext.escape_to_app && self.ext.bar_open) {
+            let idle = self.ext.escape_to_app && editor.selection() == Selection::None;
+            editor.action(Action::Escape);
+            if !idle {
+                shell.capture_event();
+            }
+        }
+    }
+
+    /// Enter in a Markdown file: Ctrl+Enter is left to the Toggle task shortcut (see
+    /// `key_bind`), and list items and tables continue. Returns whether the key was handled.
+    pub(super) fn md_enter_key(
+        &self,
+        editor: &mut Borrowed<'_>,
+        modifiers: Modifiers,
+        shell: &mut Shell<'_, Message>,
+    ) -> bool {
+        // Ctrl+Enter toggles a task (see `key_bind`)
+        if self.ext.md_task_key && modifiers.control() && !modifiers.shift() && !modifiers.alt() {
+            return true;
+        }
+        if self.ext.md_lists
+            && !modifiers.shift()
+            && !modifiers.alt()
+            && (md_table::enter_key(&mut **editor, self.ext.new_line_ending)
+                || md_lists::enter_key(&mut **editor, self.ext.new_line_ending))
+        {
+            shell.capture_event();
+            return true;
+        }
+        false
+    }
+
+    /// Enter: a new line with the file's line ending.
+    pub(super) fn enter_key(&self, editor: &mut Borrowed<'_>) {
+        if self.ext.new_line_ending == LineEnding::Lf {
+            editor.action(Action::Enter);
+        } else {
+            whitespace::insert_new_line(&mut **editor, self.ext.new_line_ending);
+        }
+    }
+
+    /// Backspace in a Markdown list item. Returns whether the key was handled.
+    pub(super) fn md_backspace_key(
+        &self,
+        editor: &mut Borrowed<'_>,
+        modifiers: Modifiers,
+        shell: &mut Shell<'_, Message>,
+    ) -> bool {
+        let used = self.ext.md_lists
+            && !modifiers.control()
+            && !modifiers.alt()
+            && md_lists::backspace_key(&mut **editor);
+        if used {
+            shell.capture_event();
+        }
+        used
+    }
+
+    /// Tab in a Markdown table or list item. Returns whether the key was handled; it may
+    /// reformat rows away from the cursor, which the edit print does not see.
+    pub(super) fn md_tab_key(
+        &self,
+        editor: &mut Borrowed<'_>,
+        modifiers: Modifiers,
+        shell: &mut Shell<'_, Message>,
+    ) -> bool {
+        let used = self.ext.md_lists
+            && !modifiers.control()
+            && !modifiers.alt()
+            && (md_table::tab_key(&mut **editor, modifiers.shift(), self.ext.new_line_ending)
+                || md_lists::tab_key(&mut **editor, modifiers.shift()));
+        if used {
+            shell.capture_event();
+        }
+        used
+    }
+}
+
+/// Behaviours under test:
+/// - Alt+Shift+arrows start a column selection at the cursor and extend it
+/// - typing goes to every line of the block; a plain click or arrow key leaves block mode
+#[cfg(test)]
+mod column_tests {
+    use super::*;
+    use crate::tab::editor_text;
+    use cosmic::iced::keyboard::{Location, key};
+
+    fn press(key: Key, modifiers: Modifiers, text: Option<&str>) -> Event {
+        Event::Keyboard(KeyEvent::KeyPressed {
+            key: key.clone(),
+            modified_key: key,
+            physical_key: key::Physical::Unidentified(key::NativeCode::Unidentified),
+            location: Location::Standard,
+            modifiers,
+            text: text.map(Into::into),
+            repeat: false,
+        })
+    }
+
+    #[test]
+    fn wider_editor_scrolls_back_to_the_left() {
+        let mut editor = column_select::tests::editor("## Decisions dirty\n- Ship it\n");
+        let mut font_system = crate::font_system().write().unwrap();
+        let mut editor = editor.borrow_with(font_system.raw());
+        // Cursor at the end of the first line, laid out before the window has its width
+        editor.set_cursor(Cursor::new(0, 18));
+        editor.with_buffer_mut(|buffer| {
+            buffer.set_wrap(cosmic_text::Wrap::None);
+            buffer.set_size(Some(40.0), Some(200.0));
+        });
+        editor.shape_as_needed(true);
+        assert!(editor.with_buffer(|buffer| buffer.scroll().horizontal) > 0.0);
+        // The real width arrives: the whole line fits, nothing may stay clipped
+        editor.with_buffer_mut(|buffer| {
+            reset_horizontal_scroll(buffer);
+            buffer.set_size(Some(800.0), Some(200.0));
+        });
+        editor.shape_as_needed(true);
+        assert_eq!(editor.with_buffer(|buffer| buffer.scroll().horizontal), 0.0);
+    }
+
+    #[test]
+    fn column_highlight_covers_the_cut_part_of_a_tab() {
+        // Tab width 4: "a\tb" has the tab on columns 1..4, "b" on column 4
+        let mut editor = column_select::tests::editor("a\tb\nabcdef\n");
+        let mut font_system = crate::font_system().write().unwrap();
+        editor.borrow_with(font_system.raw()).shape_as_needed(true);
+        let spans = |left, right| {
+            let block = Block::new(Pos::new(0, left), Pos::new(1, right));
+            editor.with_buffer(|buffer| {
+                buffer
+                    .layout_runs()
+                    .map(|run| column_spans(&run, &block, 4))
+                    .collect::<Vec<_>>()
+            })
+        };
+        let col = |run: usize, col: usize| {
+            editor.with_buffer(|buffer| {
+                let run = buffer.layout_runs().nth(run).unwrap();
+                run.cursor_position(&Cursor::new(run.line_i, col)).unwrap()
+            })
+        };
+        let (tab_start, tab_end) = (col(0, 1), col(0, 2));
+        let third = |n: f32| tab_start + (tab_end - tab_start) * n / 3.0;
+        let close = |a: f32, b: f32| (a - b).abs() < 0.01;
+        // Columns 2..5: the last two thirds of the tab and the "b"
+        let rows = spans(2, 5);
+        let (x, w) = rows[0][0];
+        assert!(close(x, third(1.0)), "{rows:?}");
+        assert!(close(x + w, col(0, 3)), "{rows:?}");
+        assert!(close(rows[1][0].0, col(1, 2)));
+        // Columns 2..3: only the middle third of the tab
+        let rows = spans(2, 3);
+        let (x, w) = rows[0][0];
+        assert!(close(x, third(1.0)) && close(x + w, third(2.0)), "{rows:?}");
+        // A zero-width block inside the tab: the bar sits at the cut
+        let rows = spans(3, 3);
+        assert_eq!(rows[0].len(), 1);
+        assert!(close(rows[0][0].0, third(2.0)) && rows[0][0].1 == 0.0);
+    }
+
+    #[test]
+    fn alt_shift_arrows_and_typing() {
+        let mut editor = column_select::tests::editor("abc\ndef\nghi\n");
+        editor.set_cursor(Cursor::new(0, 1));
+        let column = Mutex::new(None);
+        let down = press(
+            Key::Named(Named::ArrowDown),
+            Modifiers::ALT | Modifiers::SHIFT,
+            None,
+        );
+        assert!(column_key(&column, &mut editor, &down));
+        assert!(column_key(&column, &mut editor, &down));
+        assert_eq!(
+            *column.lock().unwrap(),
+            Some(Block::new(Pos::new(0, 1), Pos::new(2, 1)))
+        );
+        let x = press(Key::Character("x".into()), Modifiers::empty(), Some("x"));
+        assert!(column_key(&column, &mut editor, &x));
+        assert_eq!(editor_text(&editor), "axbc\ndxef\ngxhi\n");
+        // Shortcuts go to the app
+        let copy = press(Key::Character("c".into()), Modifiers::CTRL, Some("c"));
+        assert!(!column_key(&column, &mut editor, &copy));
+        assert!(column.lock().unwrap().is_some());
+    }
+
+    #[test]
+    fn column_block_across_fold_unfolds_it() {
+        let mut editor = column_select::tests::editor("a {\n  b\n  c\n}\nz\n");
+        let hidden = |editor: &ViEditor<'static, 'static>| {
+            editor.with_buffer(|buffer| {
+                buffer
+                    .lines
+                    .iter()
+                    .filter(|l| folding::is_hidden(l))
+                    .count()
+            })
+        };
+        editor.with_buffer_mut(|buffer| folding::fold(buffer, 0, folding::FoldKind::Brackets));
+        assert_eq!(hidden(&editor), 2);
+        // Alt+Shift+Down from the header reaches a hidden line: the fold opens
+        editor.set_cursor(Cursor::new(0, 0));
+        let column = Mutex::new(None);
+        let down = press(
+            Key::Named(Named::ArrowDown),
+            Modifiers::ALT | Modifiers::SHIFT,
+            None,
+        );
+        assert!(column_key(&column, &mut editor, &down));
+        assert_eq!(hidden(&editor), 0);
+        // Typing then edits only the lines the block shows
+        let x = press(Key::Character("x".into()), Modifiers::empty(), Some("x"));
+        assert!(column_key(&column, &mut editor, &x));
+        assert_eq!(editor_text(&editor), "xa {\nx  b\n  c\n}\nz\n");
+
+        // An Alt+drag from the header to the line below the fold opens it too
+        let mut editor = crate::folding::tests::editor("a {\n  b\n  c\n}\nz\n", "rs");
+        editor.with_buffer_mut(|buffer| folding::fold(buffer, 0, folding::FoldKind::Brackets));
+        crate::folding::tests::shape(&mut editor);
+        let column = Mutex::new(None);
+        column_press(&column, &mut editor, 1.0, 5.0, false);
+        // Right below the header row sits the closing line 3
+        column_press(&column, &mut editor, 1.0, 25.0, true);
+        assert_eq!(column.lock().unwrap().map(|block| block.bottom()), Some(3));
+        assert_eq!(hidden(&editor), 0);
+    }
+
+    #[test]
+    fn plain_click_leaves_block_mode() {
+        let editor = Mutex::new(column_select::tests::editor("abc\ndef\n"));
+        let block = Block::new(Pos::new(0, 0), Pos::new(1, 2));
+        let column = Mutex::new(Some(block));
+        TextBox::<()>::new(&editor, Metrics::new(14.0, 20.0))
+            .column_block(&column)
+            .leave_column();
+        assert_eq!(*column.lock().unwrap(), None);
+
+        // A plain arrow key leaves it too, and still moves the cursor as usual
+        *column.lock().unwrap() = Some(block);
+        let down = press(Key::Named(Named::ArrowDown), Modifiers::empty(), None);
+        let mut editor = editor.lock().unwrap();
+        assert!(!column_key(&column, &mut editor, &down));
+        assert_eq!(*column.lock().unwrap(), None);
+    }
+
+    #[test]
+    fn edit_print_skips_keys_that_cannot_edit() {
+        let plain = Modifiers::empty();
+        assert!(!EditPrint::may_edit(&press(
+            Key::Named(Named::Shift),
+            Modifiers::SHIFT,
+            None
+        )));
+        assert!(!EditPrint::may_edit(&press(
+            Key::Named(Named::ArrowDown),
+            plain,
+            None
+        )));
+        assert!(!EditPrint::may_edit(&press(
+            Key::Named(Named::PageUp),
+            plain,
+            None
+        )));
+        assert!(EditPrint::may_edit(&press(
+            Key::Named(Named::Enter),
+            plain,
+            None
+        )));
+        assert!(EditPrint::may_edit(&press(
+            Key::Named(Named::Tab),
+            plain,
+            None
+        )));
+        assert!(EditPrint::may_edit(&press(
+            Key::Character("a".into()),
+            plain,
+            Some("a")
+        )));
+    }
+
+    #[test]
+    fn edit_print_over_a_huge_selection() {
+        let text = "x\n".repeat(EditPrint::MAX_LINES + 10);
+        let mut editor = column_select::tests::editor(&text);
+        editor.set_selection(Selection::Normal(Cursor::new(0, 0)));
+        editor.set_cursor(Cursor::new(EditPrint::MAX_LINES + 5, 0));
+        let print = EditPrint::new(&editor, None);
+        assert!(print.lines.is_none(), "too many lines to hash");
+        // A key that changed nothing is no edit
+        assert!(!print.edited(&editor));
+        // Indenting lines of it keeps the line count and the cursor line
+        editor.insert_at(Cursor::new(3, 0), "    ", None);
+        assert!(print.edited(&editor));
+        let print = EditPrint::new(&editor, None);
+        // Typing over the selection replaces it
+        editor.delete_selection();
+        assert!(print.edited(&editor));
+    }
+}

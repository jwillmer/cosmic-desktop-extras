+/// The line ending a click on the status bar's line ending item converts the text to: CRLF
+/// for LF, LF for the rest (CRLF, CR, Mixed). `None` for a text without any line break, which
+/// has nothing to convert.
+pub fn line_ending_target(endings: FileEndings) -> Option<LineEnding> {
+    match endings {
+        FileEndings::None => None,
+        FileEndings::One(LineEnding::Lf) => Some(LineEnding::CrLf),
+        _ => Some(LineEnding::Lf),
+    }
+}

+    #[test]
+    fn line_ending_menu() {
+        use crate::whitespace::EndingCounts;
+        let choice = |ending, checked, enabled| LineEndingChoice {
+            ending,
+            checked,
+            enabled,
+        };
+        let (lf, crlf) = (LineEnding::Lf, LineEnding::CrLf);
+
+        // The file's own ending is checked; no first line
+        let counts = EndingCounts {
+            crlf: 40,
+            ..Default::default()
+        };
+        assert_eq!(
+            line_ending_choices(counts),
+            (None, [choice(lf, false, true), choice(crlf, true, true)])
+        );
+        let counts = EndingCounts {
+            lf: 2,
+            ..Default::default()
+        };
+        assert_eq!(
+            line_ending_choices(counts),
+            (None, [choice(lf, true, true), choice(crlf, false, true)])
+        );
+
+        // Mixed: the counts of the kinds present, in a fixed order; neither checked
+        let counts = EndingCounts {
+            lf: 1200,
+            crlf: 3,
+            ..Default::default()
+        };
+        assert_eq!(
+            line_ending_choices(counts),
+            (
+                Some("Mixed: 1,200 LF, 3 CRLF".to_string()),
+                [choice(lf, false, true), choice(crlf, false, true)]
+            )
+        );
+        let counts = EndingCounts {
+            lf: 0,
+            crlf: 1,
+            cr: 2,
+            lfcr: 3,
+        };
+        assert_eq!(
+            line_ending_choices(counts).0.as_deref(),
+            Some("Mixed: 1 CRLF, 2 CR, 3 LFCR")
+        );
+
+        // CR throughout is neither LF nor CRLF
+        let counts = EndingCounts {
+            cr: 5,
+            ..Default::default()
+        };
+        assert_eq!(
+            line_ending_choices(counts),
+            (
+                Some("CR: 5 CR".to_string()),
+                [choice(lf, false, true), choice(crlf, false, true)]
+            )
+        );
+
+        // No line break: LF, what new lines get; CRLF has nothing to convert
+        let (header, choices) = line_ending_choices(EndingCounts::default());
+        assert!(header.is_some());
+        assert_eq!(choices, [choice(lf, true, true), choice(crlf, false, false)]);
+    }

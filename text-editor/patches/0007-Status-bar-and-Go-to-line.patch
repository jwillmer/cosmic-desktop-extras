+    #[test]
+    fn cache_scans_once_per_generation() {
+        let mut cache = CountsCache::default();
+        let lines = ["one two", "three"];
+        let first = cache.get(1, true, || lines);
+        assert_eq!(
+            first,
+            Counts {
+                lines: 2,
+                chars: 12,
+                words: Some(3)
+            }
+        );
+        // Same generation: no scan, even with other lines
+        assert_eq!(cache.get(1, true, || ["changed"]), first);
+        assert_eq!(cache.scans, 1);
+        // Words asked for or not is part of the key
+        assert_eq!(cache.get(1, false, || lines).words, None);
+        assert_eq!(cache.scans, 2);
+        // A new generation scans again
+        assert_eq!(cache.get(2, false, || ["changed"]).lines, 1);
+        assert_eq!(cache.scans, 3);
+        cache.clear();
+        cache.get(2, false, || ["changed"]);
+        assert_eq!(cache.scans, 4);
+    }
+
+    #[test]
+    fn counts_wait_for_a_pause_in_typing() {
+        let mut generations = Generations::default();
+        generations.loaded();
+        assert_eq!(generations.counted, generations.current);
+        // Typing: the counted generation stays behind
+        let first = generations.edited();
+        let second = generations.edited();
+        assert_ne!(generations.counted, generations.current);
+        // The pause after the first key is no pause: the second key came after it
+        assert!(!generations.paused(first));
+        assert_ne!(generations.counted, generations.current);
+        // The pause after the last key counts the text as it is now
+        assert!(generations.paused(second));
+        assert_eq!(generations.counted, second);
+        assert!(!generations.paused(second), "counted once");
+        // A load counts at once, and an old pause does not undo it
+        generations.edited();
+        generations.loaded();
+        assert_eq!(generations.counted, generations.current);
+        assert!(!generations.paused(second));
+    }
+
+    #[test]
+    fn counts_cache_follows_the_counted_generation() {
+        // While typing the view asks for the counted generation and keeps the old counts
+        let mut generations = Generations::default();
+        let mut cache = CountsCache::default();
+        generations.loaded();
+        assert_eq!(cache.get(generations.counted, false, || ["one"]).chars, 3);
+        let typed = generations.edited();
+        assert_eq!(cache.get(generations.counted, false, || ["one!"]).chars, 3);
+        assert_eq!(cache.scans, 1);
+        generations.paused(typed);
+        assert_eq!(cache.get(generations.counted, false, || ["one!"]).chars, 4);
+        assert_eq!(cache.scans, 2);
+    }

Subject: [PATCH 07/10] Status bar and Go to line

Cursor, selection and document counts, line ending, encoding and indentation in an optional status bar; Ctrl+G jumps to a line or line:column.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/app_status.rs b/src/app_status.rs
new file mode 100644
index 0000000..d62f2f5
--- /dev/null
+++ b/src/app_status.rs
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The status bar of the window: its row of widgets and when it counts the text again. The
+//! values it shows come from `status_bar`.
+
+use cosmic::{
+    Application, Element, action,
+    app::Task,
+    cosmic_theme,
+    iced::{self, Alignment, Length, Subscription, event, keyboard, mouse},
+    style,
+    widget::{self, button, segmented_button},
+};
+use cosmic_text::Edit;
+use tokio::time;
+
+use crate::{
+    Action, App, Message, fl, goto_line, language, menu_ext, status_bar, tab::Tab, whitespace,
+};
+
+/// How long typing pauses before the status bar counts the text again
+const STATUS_COUNT_DELAY: time::Duration = time::Duration::from_millis(300);
+
+/// How long the status bar says which line ending a conversion gave
+pub(crate) const LINE_ENDING_NOTE_TIME: time::Duration = time::Duration::from_secs(4);
+
+/// After edit `generation` of tab `entity`: a [`Message::StatusBarCount`] once typing pauses
+pub(crate) fn status_count_after_pause(
+    entity: segmented_button::Entity,
+    generation: Option<u64>,
+) -> Task<Message> {
+    let Some(generation) = generation else {
+        return Task::none();
+    };
+    Task::perform(time::sleep(STATUS_COUNT_DELAY), move |()| {
+        action::app(Message::StatusBarCount(entity, generation))
+    })
+}
+
+impl App {
+    /// The bar at the bottom of the window, for the active editor tab (the focused view's when
+    /// split): the cursor, selection or column block on the left, which opens Go to line; the
+    /// size of the text (for a few seconds after a line ending conversion, a note that names
+    /// it), its line endings (a click opens LF and CRLF), encoding, indentation and language on the right. The counts come from the tab's cache, scanned again only once typing pauses
+    /// after a change (see `status_bar::Generations`); the selection's from its own cache.
+    pub(crate) fn status_bar(&self) -> Option<Element<'_, Message>> {
+        if !self.config.show_status_bar {
+            return None;
+        }
+        let Some(Tab::Editor(tab)) = self.active_tab() else {
+            return None;
+        };
+        let cosmic_theme::Spacing {
+            space_xxs, space_s, ..
+        } = self.core().system_theme().cosmic().spacing;
+        let words = tab.is_markdown_language();
+        // Before the editor is locked: it locks the editor itself
+        let ending_counts = tab.ending_counts();
+        let ending = status_bar::line_ending_label(ending_counts.endings());
+        let block = *tab.column.lock().unwrap();
+        let editor = tab.editor.lock().unwrap();
+        let cursor = editor.cursor();
+        let selection = editor.selection_bounds();
+        let (position, counts, encoding) = editor.with_buffer(|buffer| {
+            let lines = &buffer.lines;
+            let position = match (block, selection) {
+                (Some(block), _) => status_bar::block_text(&block),
+                (None, Some((start, end))) => status_bar::selection_size_text(
+                    tab.selection_size
+                        .borrow_mut()
+                        .get(tab.generation.current, start, end, || {
+                            lines.iter().map(|line| line.text())
+                        }),
+                ),
+                (None, None) => status_bar::cursor_text(
+                    lines.get(cursor.line).map_or("", |line| line.text()),
+                    cursor,
+                ),
+            };
+            let counts = tab
+                .counts
+                .borrow_mut()
+                .get(tab.generation.counted, words, || {
+                    lines.iter().map(|line| line.text())
+                });
+            let encoding = status_bar::encoding_label(lines.first().map_or("", |line| line.text()));
+            (position, counts, encoding)
+        });
+        drop(editor);
+        let indentation = status_bar::Indentation::from_tab_width(self.config.tab_width).text();
+
+        let counts = match self.line_ending_note {
+            Some((entity, ending, _)) if entity == self.tab_model.active() => {
+                let undo = self
+                    .key_binds
+                    .iter()
+                    .find(|(_, action)| **action == Action::Undo)
+                    .map_or_else(
+                        || "Ctrl+Z".to_string(),
+                        |(key_bind, _)| key_bind.to_string(),
+                    );
+                fl!(
+                    "converted-line-endings",
+                    ending = whitespace::ending_label(ending),
+                    undo = undo
+                )
+            }
+            _ => counts.text(),
+        };
+
+        let row = widget::row::with_children(vec![
+            button::custom(widget::text::caption(position))
+                .on_press(goto_line::open())
+                .padding([0, space_xxs])
+                .class(style::Button::Text)
+                .into(),
+            widget::space::horizontal().into(),
+            widget::text::caption(counts).into(),
+            menu_ext::status_line_endings(
+                self.core(),
+                &self.key_binds,
+                ending.to_string(),
+                space_xxs,
+                ending_counts,
+            ),
+            widget::text::caption(encoding).into(),
+            menu_ext::status_indentation(
+                self.core(),
+                &self.config,
+                &self.key_binds,
+                indentation,
+                space_xxs,
+            ),
+            language::status_item(self.core(), &self.key_binds, tab, space_xxs),
+        ])
+        .align_y(Alignment::Center)
+        .padding([0, space_xxs])
+        .spacing(space_s);
+        Some(
+            widget::layer_container(row)
+                .layer(cosmic_theme::Layer::Primary)
+                .width(Length::Fill)
+                .into(),
+        )
+    }
+
+    /// Keys, clicks and input method text move the cursor without a message of the editor's
+    /// own: one for the status bar to show where it went.
+    pub(crate) fn status_bar_subscription(&self) -> Subscription<Message> {
+        if !self.config.show_status_bar {
+            return Subscription::none();
+        }
+        event::listen_with(|event, _status, _window| match event {
+            event::Event::Keyboard(keyboard::Event::KeyPressed { .. })
+            | event::Event::Mouse(mouse::Event::ButtonReleased(_))
+            | event::Event::InputMethod(iced::advanced::input_method::Event::Commit(_)) => {
+                Some(Message::StatusBarRefresh)
+            }
+            _ => None,
+        })
+    }
+}
diff --git a/src/goto_line.rs b/src/goto_line.rs
new file mode 100644
index 0000000..bdb9272
--- /dev/null
+++ b/src/goto_line.rs
@@ -0,0 +1,203 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! "Go to line": the bar under the text that takes `42` or `42:7` and moves the cursor there.
+
+use crate::markdown::ViewMode;
+
+const BOM: char = '\u{feff}';
+
+/// Where to go, 1-based as typed: a line and, after a colon, a column.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Target {
+    pub line: usize,
+    pub column: Option<usize>,
+}
+
+/// The message that opens the bar, for anything besides the menu and Ctrl+G that wants to
+/// open it (such as a status bar).
+pub fn open() -> crate::Message {
+    crate::Message::GotoLine(Some(String::new()))
+}
+
+/// Reads `42` or `42:7`, with spaces allowed around each part. Zero, signs, letters and an
+/// empty part are not a place; a number too big for the platform is taken as the largest,
+/// so it clamps to the end like any other number past it.
+pub fn parse(input: &str) -> Option<Target> {
+    let (line, column) = match input.split_once(':') {
+        Some((line, column)) => (line, Some(column)),
+        None => (input, None),
+    };
+    Some(Target {
+        line: number(line)?,
+        column: match column {
+            Some(column) => Some(number(column)?),
+            None => None,
+        },
+    })
+}
+
+fn number(part: &str) -> Option<usize> {
+    let part = part.trim();
+    if part.is_empty() || !part.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    let value = part.parse().unwrap_or(usize::MAX);
+    (value > 0).then_some(value)
+}
+
+/// The 0-based line for a 1-based `line` in a text of `line_count` lines: past the end is
+/// the last line.
+pub fn clamp_line(line: usize, line_count: usize) -> usize {
+    line.saturating_sub(1).min(line_count.saturating_sub(1))
+}
+
+/// The byte index of the 1-based character `column` in `text`, the text of the 0-based line
+/// `line`: past the end is the end of the line. On the first line columns start after a byte
+/// order mark, as the status bar counts them.
+pub fn byte_index(line: usize, text: &str, column: usize) -> usize {
+    let start = if line == 0 && text.starts_with(BOM) {
+        BOM.len_utf8()
+    } else {
+        0
+    };
+    text[start..]
+        .char_indices()
+        .nth(column.saturating_sub(1))
+        .map_or(text.len(), |(index, _)| start + index)
+}
+
+/// The view to switch a tab to before the jump, `None` to keep it: a Markdown tab that shows
+/// only the Preview gets Split, so the cursor lands where it can be seen.
+pub fn view_for_jump(view: Option<ViewMode>) -> Option<ViewMode> {
+    (view == Some(ViewMode::Preview)).then_some(ViewMode::Split)
+}
+
+/// The open bar: what is typed in it.
+#[derive(Debug, Clone)]
+pub(crate) struct GotoLineField {
+    pub(crate) value: String,
+    pub(crate) has_focus: bool,
+    /// The last Enter did not read as a line.
+    pub(crate) invalid: bool,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preview_only_switches_to_split() {
+        assert_eq!(view_for_jump(Some(ViewMode::Preview)), Some(ViewMode::Split));
+        assert_eq!(view_for_jump(Some(ViewMode::Split)), None);
+        assert_eq!(view_for_jump(Some(ViewMode::Source)), None);
+        assert_eq!(view_for_jump(None), None);
+    }
+
+    fn target(line: usize, column: Option<usize>) -> Option<Target> {
+        Some(Target { line, column })
+    }
+
+    #[test]
+    fn a_line() {
+        assert_eq!(parse("42"), target(42, None));
+        assert_eq!(parse("1"), target(1, None));
+    }
+
+    #[test]
+    fn a_line_and_column() {
+        assert_eq!(parse("42:7"), target(42, Some(7)));
+    }
+
+    #[test]
+    fn spaces_around_the_parts() {
+        assert_eq!(parse("  42 "), target(42, None));
+        assert_eq!(parse(" 42 : 7 "), target(42, Some(7)));
+        assert_eq!(parse("\t12:3\n"), target(12, Some(3)));
+    }
+
+    #[test]
+    fn zero_is_not_a_place() {
+        assert_eq!(parse("0"), None);
+        assert_eq!(parse("00"), None);
+        assert_eq!(parse("3:0"), None);
+        assert_eq!(parse("0:3"), None);
+    }
+
+    #[test]
+    fn signs_are_refused() {
+        assert_eq!(parse("-5"), None);
+        assert_eq!(parse("5:-1"), None);
+        assert_eq!(parse("+5"), None);
+    }
+
+    #[test]
+    fn empty_parts_are_refused() {
+        assert_eq!(parse(""), None);
+        assert_eq!(parse("   "), None);
+        assert_eq!(parse("42:"), None);
+        assert_eq!(parse(":7"), None);
+        assert_eq!(parse("1:2:3"), None);
+    }
+
+    #[test]
+    fn letters_are_refused() {
+        assert_eq!(parse("abc"), None);
+        assert_eq!(parse("4a"), None);
+        assert_eq!(parse("4 2"), None);
+        assert_eq!(parse("42:x"), None);
+        assert_eq!(parse("١٢"), None);
+    }
+
+    #[test]
+    fn huge_numbers_become_the_largest() {
+        assert_eq!(
+            parse("99999999999999999999999999"),
+            target(usize::MAX, None)
+        );
+        assert_eq!(
+            parse("3:99999999999999999999999999"),
+            target(3, Some(usize::MAX))
+        );
+    }
+
+    #[test]
+    fn lines_clamp_to_the_last() {
+        assert_eq!(clamp_line(1, 10), 0);
+        assert_eq!(clamp_line(10, 10), 9);
+        assert_eq!(clamp_line(11, 10), 9);
+        assert_eq!(clamp_line(usize::MAX, 10), 9);
+        assert_eq!(clamp_line(5, 0), 0);
+    }
+
+    #[test]
+    fn columns_count_characters_and_clamp_to_the_end() {
+        assert_eq!(byte_index(1, "hello", 1), 0);
+        assert_eq!(byte_index(1, "hello", 3), 2);
+        assert_eq!(byte_index(1, "hello", 6), 5);
+        assert_eq!(byte_index(1, "hello", usize::MAX), 5);
+        assert_eq!(byte_index(1, "", 4), 0);
+        // "ä" is two bytes
+        assert_eq!(byte_index(1, "äbc", 2), 2);
+    }
+
+    #[test]
+    fn columns_start_after_a_byte_order_mark() {
+        let text = "\u{feff}abcd";
+        // The mark is three bytes
+        assert_eq!(byte_index(0, text, 1), 3);
+        assert_eq!(byte_index(0, text, 5), 7);
+        assert_eq!(byte_index(0, text, 99), 7);
+        assert_eq!(byte_index(0, "\u{feff}", 1), 3);
+        // Only on the first line
+        assert_eq!(byte_index(1, text, 1), 0);
+        // Where the status bar shows the same column
+        for column in 1..=5 {
+            let index = byte_index(0, text, column);
+            let cursor = cosmic_text::Cursor::new(0, index);
+            assert_eq!(
+                crate::status_bar::cursor_position(text, cursor),
+                (1, column)
+            );
+        }
+    }
+}
diff --git a/src/status_bar.rs b/src/status_bar.rs
new file mode 100644
index 0000000..65c5064
--- /dev/null
+++ b/src/status_bar.rs
@@ -0,0 +1,855 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Data and text of the status bar: where the cursor is, what is selected, how long the text
+//! is, and the line endings, encoding and indentation of the file. Everything here takes plain
+//! values (line texts, cursors, a column block), so it can be tested without a window.
+//!
+//! Columns count characters (Unicode scalar values) from 1, and a tab is one character. Counts
+//! of characters count graphemes (what a reader sees as one character: "e" with a combining
+//! accent, a flag), as the Document statistics do, and leave out the line breaks and a byte
+//! order mark at the start of the file.
+
+use crate::column_select::Block;
+use crate::fl;
+use crate::whitespace::{FileEndings, ending_label};
+use cosmic_text::{Cursor, LineEnding};
+use unicode_segmentation::UnicodeSegmentation;
+
+/// Above this much text (in bytes) words are not counted: the status bar shows lines and
+/// characters only, so a huge file costs one cheap pass per change.
+pub const WORD_COUNT_LIMIT: usize = 2 * 1024 * 1024;
+
+/// Above this much selected text (in bytes) the selection shows its line count only: counting
+/// its characters would cost too much for a selection that changes with every mouse move.
+pub const SELECTION_COUNT_BYTES: usize = 2 * 1024 * 1024;
+
+const BOM: char = '\u{feff}';
+
+/// `n` with a comma between groups of three digits: 4567 is "4,567"
+pub fn thousands(n: usize) -> String {
+    let digits = n.to_string();
+    let mut out = String::with_capacity(digits.len() + digits.len() / 3);
+    for (i, c) in digits.chars().enumerate() {
+        if i > 0 && (digits.len() - i) % 3 == 0 {
+            out.push(',');
+        }
+        out.push(c);
+    }
+    out
+}
+
+/// The 1-based line and column of `cursor` on the line with the text `line`
+pub fn cursor_position(line: &str, cursor: Cursor) -> (usize, usize) {
+    let index = floor_char_boundary(line, cursor.index);
+    let from = text_start(cursor.line, line).min(index);
+    (cursor.line + 1, line[from..index].chars().count() + 1)
+}
+
+/// `Ln 12, Col 5`
+pub fn cursor_text(line: &str, cursor: Cursor) -> String {
+    let (line, col) = cursor_position(line, cursor);
+    fl!(
+        "status-cursor",
+        line = thousands(line),
+        col = thousands(col)
+    )
+}
+
+/// The characters and lines between `start` and `end` of the text whose lines `lines` yields
+/// (all of them, from the first). Line breaks are left out, as in `Counts::of`, so a selection
+/// of the whole text has its character count; the lines are every line the selection touches.
+pub fn selection_counts<'a>(
+    lines: impl IntoIterator<Item = &'a str>,
+    start: Cursor,
+    end: Cursor,
+) -> (usize, usize) {
+    let (start, end) = if (end.line, end.index) < (start.line, start.index) {
+        (end, start)
+    } else {
+        (start, end)
+    };
+    let mut chars = 0;
+    for (i, text) in lines
+        .into_iter()
+        .enumerate()
+        .skip(start.line)
+        .take(end.line - start.line + 1)
+    {
+        let from = if i == start.line {
+            floor_char_boundary(text, start.index)
+        } else {
+            0
+        }
+        .max(text_start(i, text));
+        let to = if i == end.line {
+            floor_char_boundary(text, end.index).max(from)
+        } else {
+            text.len()
+        };
+        chars += text[from..to].graphemes(true).count();
+    }
+    (chars, end.line - start.line + 1)
+}
+
+/// The characters (`None` above [`SELECTION_COUNT_BYTES`]) and lines between `start` and `end`,
+/// as [`selection_counts`] counts them. The size is summed first, which only reads lengths.
+pub fn selection_size<'a, I: Iterator<Item = &'a str> + Clone>(
+    lines: I,
+    start: Cursor,
+    end: Cursor,
+) -> (Option<usize>, usize) {
+    let (first, last) = if end.line < start.line {
+        (end.line, start.line)
+    } else {
+        (start.line, end.line)
+    };
+    let mut bytes = 0;
+    for text in lines.clone().skip(first).take(last - first + 1) {
+        bytes += text.len();
+        if bytes > SELECTION_COUNT_BYTES {
+            return (None, last - first + 1);
+        }
+    }
+    let (chars, lines) = selection_counts(lines, start, end);
+    (Some(chars), lines)
+}
+
+/// The text for a selection's [`selection_size`]
+pub fn selection_size_text((chars, lines): (Option<usize>, usize)) -> String {
+    match chars {
+        Some(chars) => selection_text(chars, lines),
+        None => selection_lines_text(lines),
+    }
+}
+
+/// The size of one tab's selection, kept while the text and the selection stay the same, so
+/// a view rebuilt for other reasons does not count it again.
+#[derive(Debug, Default)]
+pub struct SelectionCache {
+    cached: Option<(SelectionKey, (Option<usize>, usize))>,
+    scans: usize,
+}
+
+/// Text generation, start and end (line, index) of a selection
+type SelectionKey = (u64, (usize, usize), (usize, usize));
+
+impl SelectionCache {
+    /// The [`selection_size`] of the selection from `start` to `end` in text generation
+    /// `generation`, counting the lines `lines` returns only when one of them differs from the
+    /// last call
+    pub fn get<'a, I: Iterator<Item = &'a str> + Clone>(
+        &mut self,
+        generation: u64,
+        start: Cursor,
+        end: Cursor,
+        lines: impl FnOnce() -> I,
+    ) -> (Option<usize>, usize) {
+        let key = (generation, (start.line, start.index), (end.line, end.index));
+        if let Some((cached_key, size)) = self.cached
+            && cached_key == key
+        {
+            return size;
+        }
+        let size = selection_size(lines(), start, end);
+        self.scans += 1;
+        self.cached = Some((key, size));
+        size
+    }
+}
+
+/// `Sel 14 chars, 2 lines`
+pub fn selection_text(chars: usize, lines: usize) -> String {
+    fl!(
+        "status-selection",
+        chars = counted(Unit::Chars, chars),
+        lines = counted(Unit::Lines, lines)
+    )
+}
+
+/// `Sel 123,456 lines`, for a selection too large to count its characters
+pub fn selection_lines_text(lines: usize) -> String {
+    fl!(
+        "status-selection-lines",
+        lines = counted(Unit::Lines, lines)
+    )
+}
+
+/// The lines and visual columns of a column block
+pub fn block_size(block: &Block) -> (usize, usize) {
+    (block.height(), block.right() - block.left())
+}
+
+/// `Block 3 × 12` (lines × columns)
+pub fn block_text(block: &Block) -> String {
+    let (lines, cols) = block_size(block);
+    fl!(
+        "status-block",
+        lines = thousands(lines),
+        cols = thousands(cols)
+    )
+}
+
+/// The size of a text. `words` is `None` when words were not asked for, or the text is larger
+/// than `WORD_COUNT_LIMIT`.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct Counts {
+    pub lines: usize,
+    pub chars: usize,
+    pub words: Option<usize>,
+}
+
+impl Counts {
+    /// One pass over the lines `lines` yields; words only when `words` (the caller decides,
+    /// e.g. for Markdown). A word is a run of non-whitespace with a letter or digit in it, so
+    /// Markdown markers standing alone (`#`, `-`, `>`, `|---|`, `**`) are not words.
+    pub fn of<'a>(lines: impl IntoIterator<Item = &'a str>, words: bool) -> Self {
+        let mut counts = Self::default();
+        let mut bytes = 0;
+        let mut word_count = words.then_some(0);
+        for (i, mut text) in lines.into_iter().enumerate() {
+            if i == 0 {
+                text = text.strip_prefix(BOM).unwrap_or(text);
+            }
+            counts.lines += 1;
+            bytes += text.len();
+            if bytes > WORD_COUNT_LIMIT {
+                word_count = None;
+            }
+            match &mut word_count {
+                Some(word_count) => {
+                    let mut in_word = false;
+                    let mut has_alnum = false;
+                    for grapheme in text.graphemes(true) {
+                        counts.chars += 1;
+                        if grapheme.chars().all(char::is_whitespace) {
+                            if in_word && has_alnum {
+                                *word_count += 1;
+                            }
+                            in_word = false;
+                            has_alnum = false;
+                        } else {
+                            in_word = true;
+                            has_alnum |= grapheme.chars().any(char::is_alphanumeric);
+                        }
+                    }
+                    if in_word && has_alnum {
+                        *word_count += 1;
+                    }
+                }
+                None => counts.chars += text.graphemes(true).count(),
+            }
+        }
+        counts.words = word_count;
+        counts
+    }
+
+    /// `123 lines, 4,567 chars, 789 words`; the words only when counted
+    pub fn text(&self) -> String {
+        let mut text = format!(
+            "{}, {}",
+            counted(Unit::Lines, self.lines),
+            counted(Unit::Chars, self.chars)
+        );
+        if let Some(words) = self.words {
+            text.push_str(", ");
+            text.push_str(&counted(Unit::Words, words));
+        }
+        text
+    }
+}
+
+/// The text generations of one tab: `current` goes up with every change of the text, and
+/// `counted` is the one the status bar counts. A load or reload is counted at once; typing
+/// only once it pauses, so a key in a large file does not wait for a count of the whole text.
+/// Until then the bar shows the counts from before.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct Generations {
+    pub current: u64,
+    pub counted: u64,
+}
+
+impl Generations {
+    /// The text was loaded or reloaded: count it at once
+    pub fn loaded(&mut self) {
+        self.current = self.current.wrapping_add(1);
+        self.counted = self.current;
+    }
+
+    /// The text was edited. Returns the generation for [`Generations::paused`], to call when
+    /// no edit followed for a while.
+    pub fn edited(&mut self) -> u64 {
+        self.current = self.current.wrapping_add(1);
+        self.current
+    }
+
+    /// The pause after edit `generation` ended: count the text, unless another edit came since
+    /// (its own pause counts it) or it is counted already. Returns true when the counts change.
+    pub fn paused(&mut self, generation: u64) -> bool {
+        if generation != self.current || self.counted == self.current {
+            return false;
+        }
+        self.counted = self.current;
+        true
+    }
+}
+
+/// The counts of one tab, kept until the text changes. The caller supplies a generation number
+/// that changes with every edit; the same number gives the counts without a new scan.
+#[derive(Debug, Default)]
+pub struct CountsCache {
+    cached: Option<(u64, bool, Counts)>,
+    scans: usize,
+}
+
+impl CountsCache {
+    /// The counts for text generation `generation`, scanning the lines `lines` returns only
+    /// when the generation or `words` differs from the last call
+    pub fn get<'a, I: IntoIterator<Item = &'a str>>(
+        &mut self,
+        generation: u64,
+        words: bool,
+        lines: impl FnOnce() -> I,
+    ) -> Counts {
+        if let Some((cached_generation, cached_words, counts)) = self.cached
+            && cached_generation == generation
+            && cached_words == words
+        {
+            return counts;
+        }
+        let counts = Counts::of(lines(), words);
+        self.scans += 1;
+        self.cached = Some((generation, words, counts));
+        counts
+    }
+
+    pub fn clear(&mut self) {
+        self.cached = None;
+    }
+}
+
+/// `LF`, `CRLF`, `CR` or `Mixed`. A text without any line break shows the ending a new line
+/// would get (LF), not a dash.
+pub fn line_ending_label(endings: FileEndings) -> &'static str {
+    match endings {
+        FileEndings::None => ending_label(LineEnding::default()),
+        _ => endings.label(),
+    }
+}
+
+/// One entry of the line ending menu: LF or CRLF, checked when the whole file already has
+/// it, disabled when picking it can do nothing.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct LineEndingChoice {
+    pub ending: LineEnding,
+    pub checked: bool,
+    pub enabled: bool,
+}
+
+/// The line ending menu of the status bar and Edit > Line endings: an optional disabled first
+/// line, then LF and CRLF. A file with LF or CRLF throughout has that one checked, and picking
+/// it changes nothing. Mixed, CR and LFCR files get a first line with the counts of the kinds
+/// present (`Mixed: 120 LF, 3 CRLF`) and neither checked; picking one converts every line.
+/// A text without any line break has LF checked, the ending its new lines get; CRLF is
+/// disabled there, as there is no line to convert and new lines follow the file's own ending.
+pub fn line_ending_choices(
+    counts: crate::whitespace::EndingCounts,
+) -> (Option<String>, [LineEndingChoice; 2]) {
+    let endings = counts.endings();
+    let choice = |ending| LineEndingChoice {
+        ending,
+        checked: match endings {
+            FileEndings::None => ending == LineEnding::default(),
+            _ => endings == FileEndings::One(ending),
+        },
+        enabled: endings != FileEndings::None || ending == LineEnding::default(),
+    };
+    let list = |counts: crate::whitespace::EndingCounts| {
+        counts
+            .present()
+            .map(|(ending, count)| format!("{} {}", thousands(count), ending_label(ending)))
+            .collect::<Vec<_>>()
+            .join(", ")
+    };
+    let header = match endings {
+        FileEndings::None => Some(fl!("no-line-breaks")),
+        FileEndings::One(LineEnding::Lf | LineEnding::CrLf) => None,
+        _ => Some(format!("{}: {}", endings.label(), list(counts))),
+    };
+    (header, [choice(LineEnding::Lf), choice(LineEnding::CrLf)])
+}
+
+/// `UTF-8`, or `UTF-8 BOM` when the first line starts with a byte order mark. Files are read
+/// with `fs::read_to_string`, which only accepts UTF-8 and keeps a BOM in the text (and so it
+/// is written back on save); other encodings do not open.
+pub fn encoding_label(first_line: &str) -> &'static str {
+    if first_line.starts_with(BOM) {
+        "UTF-8 BOM"
+    } else {
+        "UTF-8"
+    }
+}
+
+/// How the Tab key indents. There is no setting for tabs yet.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Indentation {
+    Spaces(u16),
+}
+
+impl Indentation {
+    /// The editor's indentation for the config `tab_width`. Tab is `Action::Indent`, which
+    /// always inserts spaces up to the next multiple of the tab width.
+    pub fn from_tab_width(tab_width: u16) -> Self {
+        Self::Spaces(tab_width)
+    }
+
+    /// `Spaces: 4`
+    pub fn text(self) -> String {
+        match self {
+            Self::Spaces(width) => fl!("status-spaces", width = width),
+        }
+    }
+}
+
+/// What `counted` counts
+#[derive(Clone, Copy)]
+enum Unit {
+    Lines,
+    Chars,
+    Words,
+}
+
+/// `count` with its unit, e.g. `4,567 chars` or `1 line`
+fn counted(unit: Unit, count: usize) -> String {
+    let text = thousands(count);
+    match unit {
+        Unit::Lines => fl!("status-lines", count = count, text = text),
+        Unit::Chars => fl!("status-chars", count = count, text = text),
+        Unit::Words => fl!("status-words", count = count, text = text),
+    }
+}
+
+/// Where the text of line `line` starts: after the byte order mark on the first line
+fn text_start(line: usize, text: &str) -> usize {
+    if line == 0 && text.starts_with(BOM) {
+        BOM.len_utf8()
+    } else {
+        0
+    }
+}
+
+/// The largest char boundary of `text` not after `index`
+fn floor_char_boundary(text: &str, index: usize) -> usize {
+    let mut index = index.min(text.len());
+    while !text.is_char_boundary(index) {
+        index -= 1;
+    }
+    index
+}

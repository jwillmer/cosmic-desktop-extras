+/// A heading of the outline.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Heading {
+    /// 1 to 6.
+    pub level: u8,
+    pub text: String,
+    /// Source line of the heading (the text line of a setext heading).
+    pub line: usize,
+}
+
+/// The headings of the document in order: ATX (`#`), setext (underlined) and the `<h1>`..`<h6>`
+/// of HTML blocks. Headings inside code blocks are text, not headings.
+pub fn headings(text: &str) -> Vec<Heading> {
+    let lines = Lines::new(text);
+    let mut headings = Vec::new();
+    // The heading being read: level, line, text so far
+    let mut current: Option<(u8, usize, String)> = None;
+    // The HTML block being read: start offset, text so far
+    let mut html: Option<(usize, String)> = None;
+    for (event, range) in Parser::new_ext(text, OPTIONS).into_offset_iter() {
+        match event {
+            Event::Start(Tag::Heading { level, .. }) => {
+                current = Some((level as u8, lines.line(range.start), String::new()));
+            }
+            Event::End(TagEnd::Heading(_)) => {
+                if let Some((level, line, text)) = current.take() {
+                    push_heading(&mut headings, level, line, &text);
+                }
+            }
+            Event::Text(value) | Event::Code(value) => {
+                if let Some((_, _, text)) = current.as_mut() {
+                    text.push_str(&value);
+                }
+            }
+            Event::Start(Tag::HtmlBlock) => html = Some((range.start, String::new())),
+            Event::Html(value) => {
+                if let Some((_, block)) = html.as_mut() {
+                    block.push_str(&value);
+                }
+            }
+            Event::End(TagEnd::HtmlBlock) => {
+                if let Some((start, block)) = html.take() {
+                    html_headings(&mut headings, &block, lines.line(start));
+                }
+            }
+            _ => {}
+        }
+    }
+    headings
+}
+
+fn push_heading(headings: &mut Vec<Heading>, level: u8, line: usize, text: &str) {
+    let text = text.split_whitespace().collect::<Vec<_>>().join(" ");
+    if !text.is_empty() {
+        headings.push(Heading { level, text, line });
+    }
+}
+
+/// `<h1>`..`<h6>` in the text of an HTML block that starts on `first_line`; tags inside the
+/// heading are dropped.
+fn html_headings(headings: &mut Vec<Heading>, block: &str, first_line: usize) {
+    let lower = block.to_ascii_lowercase();
+    let mut from = 0;
+    while let Some(found) = lower[from..].find("<h") {
+        let open = from + found;
+        from = open + 2;
+        let Some(level) = lower[from..]
+            .chars()
+            .next()
+            .and_then(|c| c.to_digit(10))
+            .filter(|level| (1..=6).contains(level))
+        else {
+            continue;
+        };
+        let after = &lower[from + 1..];
+        if !after.starts_with(['>', ' ', '\t', '\n', '\r']) {
+            continue;
+        }
+        let Some(start) = after.find('>').map(|end| from + 1 + end + 1) else {
+            break;
+        };
+        let close = format!("</h{level}");
+        let Some(end) = lower[start..].find(&close).map(|end| start + end) else {
+            break;
+        };
+        let mut text = String::new();
+        let mut in_tag = false;
+        for c in block[start..end].chars() {
+            match c {
+                '<' => in_tag = true,
+                '>' => in_tag = false,
+                c if !in_tag => text.push(c),
+                _ => {}
+            }
+        }
+        let line = first_line + block[..open].matches('\n').count();
+        push_heading(headings, level as u8, line, &text);
+        from = end;
+    }
+}
+
+/// Index of the heading the source `line` sits under: the last one at or above it.
+pub fn current_heading(headings: &[Heading], line: usize) -> Option<usize> {
+    headings
+        .partition_point(|heading| heading.line <= line)
+        .checked_sub(1)
+}

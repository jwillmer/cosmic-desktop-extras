+    #[test]
+    fn outline_lists_atx_and_setext_headings_with_levels() {
+        assert_eq!(
+            levels(OUTLINE),
+            vec![
+                (1, "One".into(), 0),
+                (1, "Two".into(), 4),
+                (2, "Three code".into(), 7),
+                (2, "Four".into(), 15),
+                (6, "Six".into(), 18),
+            ]
+        );
+        let html = "<h1 align=\"center\">\n  <img src=\"logo.png\"> Logo <b>name</b>\n</h1>\n\n<p>x</p>\n<H3>Small</H3>\n<hr>\n";
+        assert_eq!(
+            levels(html),
+            vec![(1, "Logo name".into(), 0), (3, "Small".into(), 5)]
+        );
+    }
+
+    #[test]
+    fn headings_in_code_blocks_are_ignored() {
+        let texts: Vec<String> = headings(OUTLINE).into_iter().map(|h| h.text).collect();
+        assert!(!texts.iter().any(|text| text.contains("not a heading")));
+        assert!(!texts.iter().any(|text| text.contains("indented")));
+        assert!(headings("```\n<h1>x</h1>\n```\n").is_empty());
+    }

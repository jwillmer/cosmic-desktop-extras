+        let outline = headings(OUTLINE);
+        assert_eq!(current_heading(&outline, 0), Some(0));
+        assert_eq!(current_heading(&outline, 3), Some(0));
+        assert_eq!(current_heading(&outline, 5), Some(1));
+        assert_eq!(current_heading(&outline, 12), Some(2));

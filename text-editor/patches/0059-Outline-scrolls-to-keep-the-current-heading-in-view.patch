+/// Where the outline scrolls to show row `index` of `count` rows, below `padding` at the top;
+/// `None` when the row is already in view, so a manual scroll is not undone.
+fn outline_scroll(index: usize, count: usize, padding: f32, viewport: &Viewport) -> Option<f32> {
+    if count == 0 || index >= count || viewport.content_height <= 0.0 {
+        return None;
+    }
+    // The rows all have the same height
+    let row = (viewport.content_height - 2.0 * padding) / count as f32;
+    let top = if index == 0 {
+        0.0
+    } else {
+        padding + index as f32 * row
+    };
+    let bottom = if index + 1 == count {
+        viewport.content_height
+    } else {
+        padding + (index + 1) as f32 * row
+    };
+    let offset = viewport.offset.y;
+    if top < offset {
+        Some(top)
+    } else if bottom > offset + viewport.height {
+        Some((bottom - viewport.height).max(0.0))
+    } else {
+        None
+    }
+}

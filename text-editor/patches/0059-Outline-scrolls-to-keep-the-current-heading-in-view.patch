+    /// When the heading above the cursor changed, scroll the outline so it is in view. Only a
+    /// change scrolls: the outline can be scrolled away by hand in between.
+    fn outline_reveal(&mut self) -> Task<AppMessage> {
+        if !self.config.markdown_outline {
+            return Task::none();
+        }
+        let space_xxs = f32::from(theme::spacing().space_xxs);
+        let Some(tab) = self.active_editor_tab_mut() else {
+            return Task::none();
+        };
+        let cursor_line = tab.editor.lock().unwrap().cursor().line;
+        let Some(preview) = tab.markdown.as_mut() else {
+            return Task::none();
+        };
+        let current = map::current_heading(&preview.headings, cursor_line);
+        if current == preview.outline_current {
+            return Task::none();
+        }
+        // Not drawn yet: try again once it reports its size
+        let Some(viewport) = preview.outline_viewport else {
+            return Task::none();
+        };
+        preview.outline_current = current;
+        match current
+            .and_then(|index| outline_scroll(index, preview.headings.len(), space_xxs, &viewport))
+        {
+            Some(y) => iced::widget::operation::scroll_to(
+                preview.outline_id.clone(),
+                AbsoluteOffset { x: 0.0, y },
+            ),
+            None => Task::none(),
+        }
+    }

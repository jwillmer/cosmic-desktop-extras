+    #[test]
+    fn outline_scroll_keeps_current_heading_visible() {
+        // Below the view: just far enough that the row's bottom shows
+        assert_eq!(
+            outline_scroll(70, 80, 4.0, &outline_viewport(0.0)),
+            Some(1834.0)
+        );
+        // Above the view: the row's top at the top
+        assert_eq!(
+            outline_scroll(10, 80, 4.0, &outline_viewport(1000.0)),
+            Some(304.0)
+        );
+        // Partly hidden rows count as hidden
+        assert_eq!(
+            outline_scroll(10, 80, 4.0, &outline_viewport(310.0)),
+            Some(304.0)
+        );
+        // The first and last rows take the padding with them
+        assert_eq!(
+            outline_scroll(0, 80, 4.0, &outline_viewport(500.0)),
+            Some(0.0)
+        );
+        assert_eq!(
+            outline_scroll(79, 80, 4.0, &outline_viewport(0.0)),
+            Some(2108.0)
+        );
+    }
+
+    #[test]
+    fn outline_scroll_does_not_move_when_visible() {
+        for index in 0..9 {
+            assert_eq!(outline_scroll(index, 80, 4.0, &outline_viewport(0.0)), None);
+        }
+        assert_eq!(outline_scroll(40, 80, 4.0, &outline_viewport(1000.0)), None);
+        // Not drawn yet, or no such row
+        let mut viewport = outline_viewport(0.0);
+        viewport.content_height = 0.0;
+        assert_eq!(outline_scroll(70, 80, 4.0, &viewport), None);
+        assert_eq!(outline_scroll(80, 80, 4.0, &outline_viewport(0.0)), None);
+    }

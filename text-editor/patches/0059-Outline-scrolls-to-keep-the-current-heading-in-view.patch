+    /// 80 rows of 30 px below 4 px padding, in a 300 px high outline scrolled to `y`.
+    fn outline_viewport(y: f32) -> Viewport {
+        Viewport {
+            offset: AbsoluteOffset { x: 0.0, y },
+            content_height: 2408.0,
+            height: 300.0,
+        }

+    /// The editor's cursor and selection are `now`: a change since the preview selection was
+    /// made clears it, so Copy takes what the user selected last.
+    fn editor_now(&mut self, now: EditorState) {
+        if self.selection.is_none() {
+            self.editor_at = None;
+            return;
+        }
+        match self.editor_at {
+            Some(at) if at != now => {
+                self.selection = None;
+                self.editor_at = None;
+            }
+            Some(_) => {}
+            None => self.editor_at = Some(now),
+        }
+    }
+

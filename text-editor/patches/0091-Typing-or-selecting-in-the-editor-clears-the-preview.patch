+    #[test]
+    fn editor_input_clears_the_preview_selection() {
+        use cosmic_text::{Cursor, Selection as EditorSelection};
+        let mut preview = Preview::new(ViewMode::Split);
+        preview.parse("Some intro\n", None);
+        let still = (Cursor::new(0, 3), EditorSelection::None);
+        preview.select(select::Action::Press(select::Spot::default()));
+        preview.editor_now(still);
+        preview.select(select::Action::Drag(select::Spot {
+            leaf: 0,
+            grapheme: 4,
+        }));
+        preview.select(select::Action::Release);
+        // Messages while the editor stays put keep it
+        preview.editor_now(still);
+        assert_eq!(
+            preview.selected_text(test_settings(), "").as_deref(),
+            Some("Some")
+        );
+        // Shift+arrow in the editor: its selection changes
+        preview.editor_now((
+            Cursor::new(0, 4),
+            EditorSelection::Normal(Cursor::new(0, 3)),
+        ));
+        assert_eq!(preview.selection, None);
+        assert_eq!(preview.selected_text(test_settings(), ""), None);
+        // Select All in the preview, then typing in the editor moves its cursor
+        preview.selection = Some(select::select_all());
+        preview.editor_at = None;
+        preview.editor_now(still);
+        preview.editor_now((Cursor::new(0, 4), EditorSelection::None));
+        assert_eq!(preview.selection, None);
+    }
+

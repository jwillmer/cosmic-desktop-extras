+    /// Apply the setting for images from the web to every preview.
+    pub fn markdown_reload_images(&mut self) {
+        remote::set_enabled(self.config.markdown_remote_images);
+        let entities: Vec<_> = self.tab_model.iter().collect();
+        for entity in entities {
+            if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                tab.markdown_reload_images();
+            }
+        }
+    }

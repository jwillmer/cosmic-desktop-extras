+    went_to: Option<usize>,
+    /// First editor line the preview was last scrolled to.
+    synced_line: Option<usize>,
+    /// A scroll sync is scheduled.
+    sync_pending: bool,
+    /// Headings for the outline, kept current also while the preview is hidden.
+    headings: Vec<map::Heading>,
+    /// Hash of the text `headings` was read from.
+    outlined: Option<u64>,
+    outline_id: widget::Id,
+    /// The outline's scroll position and size, as last drawn; `None` before the first draw.
+    outline_viewport: Option<Viewport>,
+    /// The current heading the outline last scrolled into view.
+    outline_current: Option<usize>,
+    /// Text selected with the mouse in the preview, across its text runs.
+    selection: Option<Selection>,
+    /// The editor's cursor and selection when the preview selection was made: once they move,
+    /// the user selected or typed in the editor, and the preview selection goes.
+    editor_at: Option<EditorState>,
+    /// The leaf nearest the pointer of the last press or drag so far: the leaves near it each
+    /// report, the nearest counts.
+    near: Option<select::Near>,
+    /// A drag at the top or bottom edge reached the start or end of the document, which the
+    /// selection holds until the pointer leaves the edge.
+    pinned: bool,
+    /// A selection is dragged at the top or bottom edge: scroll by this much per tick, with the
+    /// pointer last at this place in the window.
+    scroll_speed: Option<(f32, iced::Point)>,
+    /// The file is over [`LARGE_PREVIEW`], this many bytes, and opened in Source instead of this
+    /// view: a notice offers the preview.
+    held: Option<(ViewMode, usize)>,
+    /// A parse on another thread, for text over [`BACKGROUND_PARSE`].
+    job: Option<Job>,
+    /// Height of each top-level element in lines of prose, estimated and then measured, when the
+    /// preview has more than [`WINDOW_ELEMENTS`]; empty otherwise.
+    sizes: Vec<f32>,
+    /// Height above each element, in lines of prose; one more entry than `sizes`.
+    tops: Vec<f32>,
+    /// The elements drawn, of a windowed preview.
+    window: Option<std::ops::Range<usize>>,
+    /// Pixels of a line of prose, as last drawn.
+    unit: f32,
+    /// When a key typed in the Preview view last switched to Source and went to the editor.
+    typed_at: Option<Instant>,
+}
+
+/// What a parse of the text yields; made on another thread for a large file.
+struct Parsed {
+    hash: u64,
+    len: usize,
+    document: html::Document,
+    layout: map::Layout,
+    anchor_lines: Vec<Option<usize>>,
+}
+
+impl Parsed {
+    fn new(text: &str, hash: u64) -> Self {
+        let document = html::parse(text);
+        let anchor_lines = map::offset_lines(text, &html::anchors(&document));
+        Self {
+            hash,
+            len: text.len(),
+            document,
+            layout: map::Layout::new(text),
+            anchor_lines,
+        }
+    }
+}
+
+/// Headings and, when the preview shows, the parse of the text with this hash.
+type JobResult = (u64, Vec<map::Heading>, Option<Parsed>);
+
+/// A parse running on another thread.
+struct Job {
+    /// Hash of the text it parses.
+    hash: u64,
+    /// The preview is parsed too, not only the headings.
+    preview: bool,
+    result: std::sync::Arc<Mutex<Option<JobResult>>>,
+    thread: std::thread::JoinHandle<()>,
+}
+
+impl Job {
+    /// Read the headings of `text`, with the hash `hash`, and with `preview` parse it for the
+    /// preview too.
+    fn start(text: String, hash: u64, preview: bool) -> Self {
+        let result = std::sync::Arc::new(Mutex::new(None));
+        let slot = result.clone();
+        let thread = std::thread::spawn(move || {
+            let headings = map::headings(&text);
+            let parsed = preview.then(|| Parsed::new(&text, hash));
+            *slot.lock().unwrap() = Some((hash, headings, parsed));
+        });
+        Self {
+            hash,
+            preview,
+            result,
+            thread,
+        }
+    }
+
+    /// The result once the thread is done; `Some(None)` when it ended without one (it panicked).
+    fn take(&self) -> Option<Option<JobResult>> {
+        // Asked first: a thread done now has put its result, if any, before it ended
+        let finished = self.thread.is_finished();
+        let result = self
+            .result
+            .lock()
+            .unwrap_or_else(|err| err.into_inner())
+            .take();
+        match result {
+            Some(result) => Some(Some(result)),
+            None if finished => Some(None),
+            None => None,
+        }
+    }
+}
+
+impl Preview {
+    fn new(mode: ViewMode) -> Self {
+        Self {
+            mode,
+            document: html::Document::default(),
+            open_details: HashSet::new(),
+            details_order: Vec::new(),
+            parsed: None,
+            generation: 0,
+            images: HashMap::new(),
+            highlights: highlight::Cache::default(),
+            diagrams: mermaid::Cache::default(),
+            parsed_len: 0,
+            scroll_id: widget::Id::unique(),
+            scroll_offset: AbsoluteOffset::default(),
+            content_height: 0.0,
+            viewport_height: 0.0,
+            layout: map::Layout::default(),
+            heights: map::Heights::default(),
+            columns: DEFAULT_COLUMNS,
+            anchor_lines: Vec::new(),
+            anchor_ids: Vec::new(),
+            anchors: None,
+            remeasure: false,
+            expected_offset: None,
+            restoring: false,
+            went_to: None,
+            synced_line: None,
+            sync_pending: false,
+            headings: Vec::new(),
+            outlined: None,
+            outline_id: widget::Id::unique(),
+            outline_viewport: None,
+            outline_current: None,
+            selection: None,
+            editor_at: None,
+            near: None,
+            scroll_speed: None,
+            pinned: false,
+            held: None,
+            job: None,
+            sizes: Vec::new(),
+            tops: Vec::new(),
+            window: None,
+            // The default 14 px editor font draws prose at 16 px
+            unit: 16.0 * LINE_HEIGHT,
+            typed_at: None,
+        }
+    }
+
+    /// The file was saved as `path`: keep the current view, parse and resolve images again, as
+    /// relative images now resolve against another folder. `None` when `path` is not Markdown.
+    fn moved(preview: Option<Self>, path: &Path) -> Option<Self> {
+        if !is_markdown(path) {
+            return None;
+        }
+        let mut preview = preview.unwrap_or_else(|| Self::new(ViewMode::Source));
+        preview.parsed = None;
+        preview.outlined = None;
+        preview.images.clear();
+        Some(preview)
+    }
+
+    /// The notice that a large file opened in Source shows.
+    pub fn held_notice(&self) -> bool {
+        self.held.is_some() && self.mode == ViewMode::Source
+    }
+
+    /// Read the headings of `text` again if it changed.
+    fn outline(&mut self, text: &str) {
+        let hash = text_hash(text);
+        if self.outlined != Some(hash) {
+            self.outlined = Some(hash);
+            self.headings = map::headings(text);
+        }
+    }
+
+    /// Parse `text` if it changed; images resolve against `base_dir`, the folder of the file.
+    fn parse(&mut self, text: &str, base_dir: Option<&Path>) {
+        let hash = text_hash(text);
+        if self.parsed == Some(hash) {
+            return;
+        }
+        self.apply(Parsed::new(text, hash), base_dir);
+    }
+
+    /// Take the parse `parsed` as the preview's content.
+    fn apply(&mut self, parsed: Parsed, base_dir: Option<&Path>) {
+        self.parsed = Some(parsed.hash);
+        self.parsed_len = parsed.len;
+        self.document = parsed.document;
+        // The text runs are numbered anew
+        self.selection = None;
+        self.near = None;
+        self.scroll_speed = None;
+        // Forget opened <details> that are gone, so a new one with that summary starts closed;
+        // one edited while open stays open
+        let mut keys = Vec::new();
+        html::details_keys(&self.document.blocks, &mut keys);
+        self.open_details = html::carry_open(&self.open_details, &self.details_order, &keys);
+        self.details_order = keys.into_iter().cloned().collect();
+        let old_lines = self.heights.lines();
+        self.layout = parsed.layout;
+        self.heights = self.layout.heights(self.columns);
+        let old_anchors = std::mem::replace(&mut self.anchor_lines, parsed.anchor_lines);
+        while self.anchor_ids.len() < self.anchor_lines.len() {
+            self.anchor_ids.push(widget::Id::unique());
+        }
+        self.anchors = None;
+        self.remeasure = true;
+        let old_sizes = std::mem::take(&mut self.sizes);
+        self.estimate_sizes();
+        self.keep_sizes(&old_anchors, &old_sizes, old_lines);
+        self.highlights.sweep();
+        self.diagrams.sweep();
+        self.resolve_images(base_dir);
+    }
+
+    /// Load the images of the document not loaded yet; with images from the web turned off,
+    /// forget the ones loaded from the web.
+    fn resolve_images(&mut self, base_dir: Option<&Path>) {
+        let links = &self.document.images;
+        let web = remote::enabled();
+        // Missing images are looked up again, so one added later shows up
+        self.images.retain(|uri, image| {
+            image.is_some() && links.contains(uri) && (web || !remote::is_fetchable(uri))
+        });
+        for uri in links {
+            self.images
+                .entry(uri.clone())
+                .or_insert_with(|| load_image(uri, base_dir));
+        }
+    }
+
+    /// The editor's cursor and selection are `now`: a change since the preview selection was
+    /// made clears it, so Copy takes what the user selected last.
+    fn editor_now(&mut self, now: EditorState) {
+        if self.selection.is_none() {
+            self.editor_at = None;
+            return;
+        }
+        match self.editor_at {
+            Some(at) if at != now => {
+                self.selection = None;
+                self.near = None;
+                self.scroll_speed = None;
+                self.editor_at = None;
+            }
+            Some(_) => {}
+            None => self.editor_at = Some(now),
+        }
+    }
+
+    /// Follow the mouse selecting text in the preview.
+    fn select(&mut self, action: select::Action) {
+        if matches!(
+            action,
+            select::Action::Press(..) | select::Action::PressRange(..) | select::Action::Extend(..)
+        ) {
+            self.pinned = false;
+        }
+        match action {
+            select::Action::Press(spot, near) => {
+                if self.near.is_some_and(|nearest| near.loses_to(&nearest)) {
+                    return;
+                }
+                self.near = Some(near);
+                self.editor_at = None;
+                self.selection = Some(Selection {
+                    anchor: spot,
+                    focus: spot,
+                    dragging: true,
+                });
+            }
+            select::Action::PressRange(anchor, focus, near) => {
+                if self.near.is_some_and(|nearest| near.loses_to(&nearest)) {
+                    return;
+                }
+                self.near = Some(near);
+                self.editor_at = None;
+                self.selection = Some(Selection {
+                    anchor,
+                    focus,
+                    dragging: true,
+                });
+            }
+            select::Action::Extend(spot, near) => {
+                if self.near.is_some_and(|nearest| near.loses_to(&nearest)) {
+                    return;
+                }
+                self.near = Some(near);
+                match self.selection.as_mut() {
+                    Some(selection) => {
+                        selection.focus = spot;
+                        selection.dragging = true;
+                    }
+                    None => {
+                        self.editor_at = None;
+                        self.selection = Some(Selection {
+                            anchor: spot,
+                            focus: spot,
+                            dragging: true,
+                        });
+                    }
+                }
+            }
+            select::Action::Drag(spot, near) => {
+                if self.pinned || self.near.is_some_and(|nearest| near.loses_to(&nearest)) {
+                    return;
+                }
+                if let Some(selection) = self.selection.as_mut().filter(|s| s.dragging) {
+                    self.near = Some(near);
+                    selection.focus = spot;
+                }
+            }
+            select::Action::Release => {
+                self.pinned = false;
+                self.near = None;
+                self.scroll_speed = None;
+                if let Some(selection) = self.selection.as_mut() {
+                    selection.dragging = false;
+                }
+            }
+            // A press elsewhere may come in the same event as the press that starts a new
+            // selection, after it: that one stays
+            select::Action::Clear => {
+                if !self.selection.is_some_and(|selection| selection.dragging) {
+                    self.selection = None;
+                    self.near = None;
+                    self.scroll_speed = None;
+                }
+            }
+        }
+    }
+
+    /// A step of scrolling while a selection is dragged at an edge; `None` at the end of the
+    /// document, which stops the ticks until the pointer moves again.
+    fn drag_scroll(&mut self) -> Option<Task<AppMessage>> {
+        let (speed, _) = self.scroll_speed?;
+        let Some(selection) = self.selection.as_mut().filter(|s| s.dragging) else {
+            self.scroll_speed = None;
+            return None;
+        };
+        if !select::can_scroll(
+            self.scroll_offset.y,
+            self.content_height,
+            self.viewport_height,
+            speed,
+        ) {
+            // At the end of the document the selection takes it all, whatever the last block
+            // is, until the pointer leaves the edge
+            selection.focus = if speed > 0.0 {
+                select::END
+            } else {
+                select::Spot::default()
+            };
+            self.pinned = true;
+            self.scroll_speed = None;
+            return None;
+        }
+        // The text at the edge after this step is a new place: its leaves compare afresh
+        self.near = None;
+        // Scrolls as the user does: its scroll event syncs the editor
+        Some(iced::widget::scrollable::scroll_by(
+            self.scroll_id.clone(),
+            AbsoluteOffset { x: 0.0, y: speed },
+        ))
+    }
+
+    /// The selected rendered text, `None` when nothing is selected. Read from the document as
+    /// it is now, not as last drawn: a Copy right after Select All or an edit gets current text.
+    fn selected_text(&self, settings: Settings, syntax_theme: &str) -> Option<String> {
+        let selection = self.selection.filter(|selection| !selection.is_empty())?;
+        let text = select::copied_numbered(&self.leaves(settings, syntax_theme), &selection);
+        (!text.is_empty()).then_some(text)
+    }
+
+    /// The text runs of the preview, numbered as the view numbers them: built by the same view
+    /// code, only to be dropped.
+    fn leaves(&self, settings: Settings, syntax_theme: &str) -> Vec<(usize, Leaf)> {
+        // A windowed preview: the elements the selection spans, drawn or not
+        let window = self.drawn().map(|_| {
+            let count = self.sizes.len();
+            let (from, to) = self.selection.map_or((0, 0), |selection| {
+                let (start, end) = selection.ordered();
+                (start.leaf / LEAF_STRIDE, end.leaf / LEAF_STRIDE + 1)
+            });
+            html::Window {
+                range: from.min(count)..to.min(count),
+                above: 0.0,
+                below: 0.0,
+            }
+        });
+        let viewer = PreviewViewer {
+            images: &self.images,
+            highlights: &self.highlights,
+            diagrams: &self.diagrams,
+            syntax_theme,
+            entity: Entity::default(),
+            selection: None,
+            leaves: RefCell::new(LeafLog {
+                record: true,
+                ..LeafLog::default()
+            }),
+        };
+        drop(html::view_document(
+            &self.document,
+            settings,
+            &viewer,
+            &self.open_details,
+            &self.anchor_ids,
+            window,
+        ));
+        let log = viewer.leaves.into_inner();
+        log.numbers.into_iter().zip(log.leaves).collect()
+    }
+
+    fn toggle_details(&mut self, key: html::DetailsKey) {
+        if !self.open_details.remove(&key) {
+            self.open_details.insert(key);
+        }
+        // The text runs after it are numbered anew
+        self.selection = None;
+        self.near = None;
+        self.scroll_speed = None;
+        self.remeasure = true;
+    }
+
+    /// Measure where the preview of `entity` drew its top-level elements, when it changed since
+    /// the last measure; the result comes back as [`Message::Measured`].
+    fn measure(&mut self, entity: Entity) -> Task<AppMessage> {
+        if !self.remeasure || !self.mode.shows_preview() || self.anchor_ids.is_empty() {
+            return Task::none();
+        }
+        self.remeasure = false;
+        let parsed = self.parsed.unwrap_or_default();
+        let ids = &self.anchor_ids[..self.anchor_lines.len()];
+        let drawn = self.window.clone().unwrap_or(0..ids.len());
+        iced::runtime::task::widget(Measure::new(self.scroll_id.clone(), ids, drawn)).map(
+            move |(tops, height)| {
+                action::app(Message::Measured(entity, parsed, tops, height).into())
+            },
+        )
+    }
+
+    /// The measure of the parse `parsed` came back: the content is `height` high and its
+    /// elements start at `tops`. For a windowed preview, how far the content above the viewport
+    /// grew, in pixels, as its estimated sizes gave way to measured ones.
+    fn measured(&mut self, parsed: u64, tops: &[Option<f32>], height: f32) -> f32 {
+        if self.parsed != Some(parsed) || tops.len() != self.anchor_lines.len() {
+            return 0.0;
+        }
+        if self.sizes.is_empty() {
+            self.anchors = Some(map::Anchors::new(&self.anchor_lines, tops, height));
+            return 0.0;
+        }
+        let mut grown = 0.0;
+        for (index, pair) in tops.windows(2).enumerate() {
+            let (Some(top), Some(next)) = (pair[0], pair[1]) else {
+                continue;
+            };
+            let size = ((next - top) / self.unit).max(0.0);
+            if (self.tops[index + 1] * self.unit) <= self.scroll_offset.y {
+                grown += (size - self.sizes[index]) * self.unit;
+            }
+            self.sizes[index] = size;
+        }
+        // The last element drawn has no next one: it ends where the space below the window
+        // starts. The padding above the content is where the first element starts less the
+        // space above it, and the same below.
+        if let Some(window) = self.window.clone()
+            && window.end > window.start
+            && let (Some(first), Some(last)) = (tops[window.start], tops[window.end - 1])
+        {
+            let total = self.tops.last().copied().unwrap_or(0.0);
+            let padding = first - self.tops[window.start] * self.unit;
+            let bottom = height - padding - (total - self.tops[window.end]) * self.unit;
+            let index = window.end - 1;
+            let size = ((bottom - last) / self.unit).max(0.0);
+            if (self.tops[index + 1] * self.unit) <= self.scroll_offset.y {
+                grown += (size - self.sizes[index]) * self.unit;
+            }
+            self.sizes[index] = size;
+        }
+        self.sum_sizes();
+        grown
+    }
+
+    /// Estimate the height of each top-level element from its source lines, for a preview of more
+    /// than [`WINDOW_ELEMENTS`].
+    fn estimate_sizes(&mut self) {
+        self.sizes.clear();
+        self.tops.clear();
+        self.window = None;
+        let count = self.anchor_lines.len();
+        if count <= WINDOW_ELEMENTS {
+            return;
+        }
+        // The next known line after each element, for where it ends
+        let mut end = self.heights.lines();
+        let mut ends = vec![0; count];
+        for index in (0..count).rev() {
+            ends[index] = end;
+            if let Some(line) = self.anchor_lines[index] {
+                end = line;
+            }
+        }
+        self.sizes = (0..count)
+            .map(|index| match self.anchor_lines[index] {
+                Some(line) => (self.heights.above(ends[index]) - self.heights.above(line)).max(1.0),
+                None => UNKNOWN_SIZE,
+            })
+            .collect();
+        self.sum_sizes();
+        self.update_window();
+    }
+
+    /// After a parse of edited text, keep the sizes of the elements before and after the edit,
+    /// matched by their source lines, `old_anchors` and `old_sizes` of `old_lines` lines: the
+    /// preview does not jump by the estimates' error on every edit.
+    fn keep_sizes(&mut self, old_anchors: &[Option<usize>], old_sizes: &[f32], old_lines: usize) {
+        if self.sizes.is_empty() || old_sizes.len() != old_anchors.len() {
+            return;
+        }
+        let count = self.sizes.len();
+        let mut head = 0;
+        while head < count.min(old_sizes.len()) && self.anchor_lines[head] == old_anchors[head] {
+            self.sizes[head] = old_sizes[head];
+            head += 1;
+        }
+        // After the edit the lines moved by as many as were added or removed
+        let shift = self.heights.lines() as isize - old_lines as isize;
+        let mut tail = 1;
+        while tail <= (count - head).min(old_sizes.len() - head) {
+            let (new, old) = (count - tail, old_sizes.len() - tail);
+            let moved = old_anchors[old].map(|line| line as isize + shift);
+            if self.anchor_lines[new].map(|line| line as isize) != moved {
+                break;
+            }
+            self.sizes[new] = old_sizes[old];
+            tail += 1;
+        }
+        self.sum_sizes();
+        self.window = None;
+        self.update_window();
+    }
+
+    /// Add up `sizes` into `tops`, and take them as where the elements are drawn.
+    fn sum_sizes(&mut self) {
+        self.tops.clear();
+        let mut sum = 0.0;
+        self.tops.push(sum);
+        for size in &self.sizes {
+            sum += size;
+            self.tops.push(sum);
+        }
+        let unit = self.unit;
+        let tops: Vec<Option<f32>> = self.tops.iter().map(|top| Some(top * unit)).collect();
+        self.anchors = Some(map::Anchors::new(
+            &self.anchor_lines,
+            &tops[..self.sizes.len()],
+            sum * unit,
+        ));
+    }
+
+    /// Choose the elements a windowed preview draws: those within a margin of the viewport. The
+    /// window stays while it still covers the viewport and half the margin. `true` when it changed.
+    fn update_window(&mut self) -> bool {
+        let count = self.sizes.len();
+        if count == 0 {
+            return false;
+        }
+        let height = if self.viewport_height > 0.0 {
+            self.viewport_height
+        } else {
+            1000.0
+        };
+        let margin = height * WINDOW_MARGIN;
+        let top = self.scroll_offset.y / self.unit;
+        let bottom = (self.scroll_offset.y + height) / self.unit;
+        let half = margin * 0.5 / self.unit;
+        if let Some(window) = &self.window
+            && window.end <= count
+            && self.tops[window.start] <= (top - half).max(0.0)
+            && (self.tops[window.end] >= bottom + half || window.end == count)
+        {
+            return false;
+        }
+        let from = top - margin / self.unit;
+        let to = bottom + margin / self.unit;
+        let first = self.tops[..count]
+            .partition_point(|above| *above <= from)
+            .saturating_sub(1);
+        let last = self.tops[..count]
+            .partition_point(|above| *above < to)
+            .clamp(first + 1, count);
+        // Too many to draw: the viewport first, then what fits of the margins
+        let first = if last - first > WINDOW_MAX {
+            let in_view = self.tops[..count]
+                .partition_point(|above| *above <= top)
+                .saturating_sub(1);
+            in_view.saturating_sub(WINDOW_MAX / 4).max(first)
+        } else {
+            first
+        };
+        let window = first..last.min(first + WINDOW_MAX);
+        if self.window.as_ref() == Some(&window) {
+            return false;
+        }
+        self.window = Some(window);
+        self.remeasure = true;
+        true
+    }
+
+    /// The elements drawn and the space above and below them, in pixels, of a windowed preview.
+    fn drawn(&self) -> Option<html::Window> {
+        let window = self.window.clone()?;
+        let total = self.tops.last().copied().unwrap_or(0.0);
+        Some(html::Window {
+            above: self.tops[window.start] * self.unit,
+            below: (total - self.tops[window.end]) * self.unit,
+            range: window,
+        })
+    }
+
+    /// Whether the preview shows and is being parsed, with no content yet to show meanwhile.
+    fn preparing(&self) -> bool {
+        self.parsed.is_none() && self.job.is_some() && self.mode.shows_preview()
+    }
+
+    /// Where to scroll the preview back to when it shows again, `None` while it is hidden.
+    fn scroll_target(&self) -> Option<(widget::Id, AbsoluteOffset)> {
+        self.mode
+            .shows_preview()
+            .then(|| (self.scroll_id.clone(), self.scroll_offset))
+    }
+
+    /// How far down the preview is scrolled, from 0 to 1; `None` when it shows all content.
+    fn scroll_fraction(&self) -> Option<f32> {
+        let max = self.content_height - self.viewport_height;
+        (max > 0.0).then(|| (self.scroll_offset.y / max).clamp(0.0, 1.0))
+    }
+
+    /// The preview reports its scroll position and size; it fits `columns` characters per line.
+    /// `true` when the user scrolled it: not a scroll the app started, not a change of size.
+    fn scrolled(&mut self, viewport: Viewport, columns: usize) -> bool {
+        if columns != self.columns {
+            self.columns = columns;
+            self.heights = self.layout.heights(columns);
+            self.remeasure = true;
+            if !self.sizes.is_empty() {
+                self.estimate_sizes();
+            }
+        }
+        if (viewport.content_height - self.content_height).abs() > 0.5 {
+            self.remeasure = true;
+        }
+        // Scrolled back by `RestoreScroll`, which reads the offset kept from before
+        if self.restoring {
+            return false;
+        }
+        let moved = (viewport.offset.y - self.scroll_offset.y).abs() > 0.5;
+        let resized = (viewport.content_height - self.content_height).abs() > 0.5
+            || (viewport.height - self.viewport_height).abs() > 0.5;
+        self.scroll_offset = viewport.offset;
+        self.content_height = viewport.content_height;
+        self.viewport_height = viewport.height;
+        self.update_window();
+        if !moved {
+            return false;
+        }
+        let echo = self
+            .expected_offset
+            .take()
+            .is_some_and(|y| (y - viewport.offset.y).abs() <= 1.0);
+        let user = !echo && !resized;
+        if user {
+            self.went_to = None;
+        }
+        user
+    }
+
+    /// The heading the outline shows as current: in the Preview view the top-most one the preview
+    /// shows, else the one above the cursor on `cursor_line`.
+    fn current_heading(&self, cursor_line: usize) -> Option<usize> {
+        if self.mode != ViewMode::Preview {
+            return map::current_heading(&self.headings, cursor_line);
+        }
+        if let Some(line) = self.went_to {
+            return map::current_heading(&self.headings, line);
+        }
+        let bottom = self.line_at(self.scroll_offset.y + self.viewport_height);
+        let at_end = self.content_height > self.viewport_height
+            && self.scroll_offset.y + self.viewport_height >= self.content_height - 1.0;
+        map::visible_heading(&self.headings, self.first_line_in_view(), bottom, at_end)
+    }
+
+    /// The first source line whose top is in view, blank lines skipped: a heading scrolled half
+    /// out of view at the top is not the top-most one visible.
+    fn first_line_in_view(&self) -> usize {
+        // Not drawn yet: nothing to measure by
+        if self.anchors.is_none() && self.content_height <= 0.0 {
+            return 0;
+        }
+        let y = self.scroll_offset.y;
+        let last = self.heights.lines().saturating_sub(1);
+        let mut line = self.line_at(y);
+        if line < last && self.line_y(line) + 1.0 < y {
+            line += 1;
+        }
+        // A line drawn with no height of its own (blank) is drawn where the next one is
+        while line < last && self.line_y(line + 1) <= self.line_y(line) + 0.5 {
+            line += 1;
+        }
+        line
+    }
+
+    /// The source line drawn `y` pixels down the preview's content: where it was measured, else
+    /// estimated.
+    fn line_at(&self, y: f32) -> usize {
+        if let Some(anchors) = &self.anchors {
+            return anchors.line(&self.heights, y);
+        }
+        if self.content_height <= 0.0 {
+            return 0;
+        }
+        self.heights.line(y / self.content_height)
+    }
+
+    /// How far down the preview's content source `line` is drawn: where it was measured, else
+    /// estimated.
+    fn line_y(&self, line: usize) -> f32 {
+        match &self.anchors {
+            Some(anchors) => anchors.y(&self.heights, line),
+            None => self.heights.fraction(line) * self.content_height,
+        }
+    }
+
+    /// Where to scroll the preview so it shows editor line `line` at the top.
+    fn sync_offset(&self, line: usize) -> SyncOffset {
+        if self.content_height <= 0.0 {
+            return SyncOffset::Relative(self.heights.fraction(line));
+        }
+        let y = self.line_y(line);
+        let max = (self.content_height - self.viewport_height).max(0.0);
+        SyncOffset::Absolute(y.min(max))
+    }
+
+    /// Scroll the preview so it shows source line `line` at the top.
+    fn scroll_to_line(&mut self, line: usize) -> Task<AppMessage> {
+        let id = self.scroll_id.clone();
+        match self.sync_offset(line) {
+            SyncOffset::Relative(y) => {
+                self.expected_offset = None;
+                iced::widget::operation::snap_to(id, RelativeOffset { x: 0.0, y })
+            }
+            SyncOffset::Absolute(y) => {
+                // Already there: no scroll event will come to match
+                self.expected_offset = ((y - self.scroll_offset.y).abs() > 0.5).then_some(y);
+                iced::widget::operation::scroll_to(id, AbsoluteOffset { x: 0.0, y })
+            }
+        }
+    }
+
+    fn reparse_delay(&self) -> Duration {
+        if self.parsed_len > LARGE_FILE {
+            REPARSE_DELAY_LARGE
+        } else {
+            REPARSE_DELAY
+        }
+    }
+}
+
+/// Finds where the containers with the given ids sit in the content of the scrollable `scroll`.
+struct Measure {
+    scroll: widget::Id,
+    ids: HashMap<widget::Id, usize>,
+    tops: Vec<Option<f32>>,
+    /// Top and height of the scrollable's content.
+    content: Option<(f32, f32)>,
+}
+
+impl Measure {
+    /// Measure the elements `drawn` of those with `ids`; the others stay unknown.
+    fn new(scroll: widget::Id, ids: &[widget::Id], drawn: std::ops::Range<usize>) -> Self {
+        Self {
+            scroll,
+            ids: ids[drawn.clone()]
+                .iter()
+                .zip(drawn)
+                .map(|(id, index)| (id.clone(), index))
+                .collect(),
+            tops: vec![None; ids.len()],
+            content: None,
+        }
+    }
+}
+
+impl iced::advanced::widget::Operation<(Vec<Option<f32>>, f32)> for Measure {
+    fn traverse(
+        &mut self,
+        operate: &mut dyn FnMut(
+            &mut dyn iced::advanced::widget::Operation<(Vec<Option<f32>>, f32)>,
+        ),
+    ) {
+        operate(self);
+    }
+
+    fn container(&mut self, id: Option<&widget::Id>, bounds: iced::Rectangle) {
+        if let Some(&index) = id.and_then(|id| self.ids.get(id)) {
+            self.tops[index] = Some(bounds.y);
+        }
+    }
+
+    fn scrollable(
+        &mut self,
+        id: Option<&widget::Id>,
+        _bounds: iced::Rectangle,
+        content_bounds: iced::Rectangle,
+        _translation: iced::Vector,
+        _state: &mut dyn iced::advanced::widget::operation::Scrollable,
+    ) {
+        if id == Some(&self.scroll) {
+            self.content = Some((content_bounds.y, content_bounds.height));
+        }
+    }
+
+    fn finish(&self) -> iced::advanced::widget::operation::Outcome<(Vec<Option<f32>>, f32)> {
+        use iced::advanced::widget::operation::Outcome;
+        // Not drawn (another tab, hidden): nothing measured
+        let Some((top, height)) = self.content else {
+            return Outcome::None;
+        };
+        let tops = self.tops.iter().map(|y| y.map(|y| y - top)).collect();
+        Outcome::Some((tops, height))
+    }
+}
+
+fn text_hash(text: &str) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    text.hash(&mut hasher);
+    hasher.finish()
+}
+
+impl EditorTab {
+    /// Start the preview of a file just opened, in the configured view.
+    pub fn markdown_init(&mut self, default: ViewMode) {
+        let (empty, len) = self.editor.lock().unwrap().with_buffer(|buffer| {
+            (
+                buffer.lines.iter().all(|line| line.text().is_empty()),
+                buffer
+                    .lines
+                    .iter()
+                    .map(|line| line.text().len() + line.ending().as_str().len())
+                    .sum::<usize>(),
+            )
+        });
+        self.markdown = opening_view(self.path_opt.as_deref(), default, empty).map(|mode| {
+            let mut preview = Preview::new(mode);
+            if mode.shows_preview() && len > LARGE_PREVIEW {
+                preview.held = Some((mode, len));
+                preview.mode = ViewMode::Source;
+            }
+            preview
+        });
+        self.markdown_refresh();
+    }
+
+    /// The tab was saved under a new path: keep the current view, resolve images again.
+    pub fn markdown_path_changed(&mut self) {
+        let preview = self.markdown.take();
+        self.markdown = self
+            .path_opt
+            .as_deref()
+            .and_then(|path| Preview::moved(preview, path));
+        self.markdown_refresh();
+    }
+
+    pub fn markdown_view(&self) -> Option<ViewMode> {
+        self.markdown.as_ref().map(|preview| preview.mode)
+    }
+
+    /// Switch a Markdown tab to `mode`; `false` and no change for any other tab.
+    pub fn set_markdown_view(&mut self, mode: ViewMode) -> bool {
+        let Some(preview) = self.markdown.as_mut() else {
+            return false;
+        };
+        preview.mode = mode;
+        preview.held = None;
+        self.markdown_refresh();
+        // Force redraw when the editor comes back
+        self.editor.lock().unwrap().set_redraw(true);
+        true
+    }
+
+    /// Read the headings again and, if the preview is visible, parse the text again; both only
+    /// when the text changed. Text over [`BACKGROUND_PARSE`] is read on another thread, see
+    /// [`Self::markdown_job_done`].
+    pub fn markdown_refresh(&mut self) {
+        let Some(preview) = self.markdown.as_mut() else {
+            return;
+        };
+        // One parse at a time: when it is done, the text is read again. Not copied meanwhile,
+        // which takes long for a large file
+        if preview.job.is_some() && buffer_len(&self.editor.lock().unwrap()) > BACKGROUND_PARSE {
+            return;
+        }
+        let text = crate::tab::editor_text(&self.editor.lock().unwrap());
+        if text.len() > BACKGROUND_PARSE {
+            let hash = text_hash(&text);
+            let preview_wanted = preview.mode.shows_preview() && preview.parsed != Some(hash);
+            if !preview_wanted && preview.outlined == Some(hash) {
+                return;
+            }
+            preview.job = Some(Job::start(text, hash, preview_wanted));
+            return;
+        }
+        // Read here now: a parse still running on older, longer text is stale
+        preview.job = None;
+        preview.outline(&text);
+        if preview.mode.shows_preview() {
+            preview.parse(&text, self.path_opt.as_deref().and_then(Path::parent));
+        }
+    }
+
+    /// Take the result of the parse on another thread, if it is done, and read the text again
+    /// if it changed meanwhile. `true` when it was done.
+    fn markdown_job_done(&mut self) -> bool {
+        let base_dir = self.path_opt.as_deref().and_then(Path::parent);
+        let Some(preview) = self.markdown.as_mut() else {
+            return false;
+        };
+        let Some(job) = preview.job.as_ref() else {
+            return false;
+        };
+        let Some(result) = job.take() else {
+            return false;
+        };
+        let (hash, with_preview) = (job.hash, job.preview);
+        preview.job = None;
+        let Some((hash, headings, parsed)) = result else {
+            // Not tried again for this text: it would only fail again. An empty preview rather
+            // than the content of older text.
+            log::error!("failed to parse the Markdown of {:?}", self.path_opt);
+            preview.outlined = Some(hash);
+            preview.headings.clear();
+            if with_preview {
+                preview.apply(Parsed::new("", hash), base_dir);
+            }
+            self.markdown_refresh();
+            return true;
+        };
+        preview.outlined = Some(hash);
+        preview.headings = headings;
+        if let Some(parsed) = parsed {
+            preview.apply(parsed, base_dir);
+        }
+        self.markdown_refresh();
+        true
+    }
+
+    /// Images from the web arrived or were turned on or off: resolve the images again.
+    fn markdown_reload_images(&mut self) {
+        let base_dir = self.path_opt.as_deref().and_then(Path::parent);
+        if let Some(preview) = self.markdown.as_mut()
+            && preview.parsed.is_some()
+        {
+            preview.resolve_images(base_dir);
+        }
+    }
+
+    /// Scroll the editor so `line` is its top line; the cursor stays where it is.
+    /// The line it scrolled to: the map can be a reparse behind the text.
+    fn markdown_scroll_editor(&mut self, line: usize) -> usize {
+        let mut editor = self.editor.lock().unwrap();
+        let line = editor.with_buffer_mut(|buffer| {
+            let line = line.min(buffer.lines.len().saturating_sub(1));
+            let horizontal = buffer.scroll().horizontal;
+            buffer.set_scroll(cosmic_text::Scroll::new(line, 0.0, horizontal));
+            line
+        });
+        editor.set_redraw(true);
+        line
+    }
+
+    /// Put the cursor on `line` and scroll the editor so it is the top line.
+    fn markdown_go_to(&mut self, line: usize) {
+        let mut editor = self.editor.lock().unwrap();
+        // The headings can be a debounce behind the text
+        let line = editor.with_buffer(|buffer| line.min(buffer.lines.len().saturating_sub(1)));
+        editor.set_cursor(cosmic_text::Cursor::new(line, 0));
+        editor.with_buffer_mut(|buffer| {
+            buffer.set_scroll(cosmic_text::Scroll::new(line, 0.0, 0.0));
+        });
+        editor.set_redraw(true);
+    }
+
+    /// Type `text` as the Source view's text box would: with `line`, the source line at the top
+    /// of the preview, at the end of the block there (`type_position`), with the editor
+    /// scrolled so `line` is its top line; with `None`, at the cursor.
+    fn markdown_type(&mut self, line: Option<usize>, text: &str) {
+        let ending = self.new_line_ending();
+        let mut editor = self.editor.lock().unwrap();
+        let (at, prefix) = match line {
+            Some(line) => editor.with_buffer(|buffer| {
+                let lines: Vec<&str> = buffer.lines.iter().map(|line| line.text()).collect();
+                type_position(&lines, line)
+            }),
+            None => {
+                let cursor = editor.cursor();
+                ((cursor.line, cursor.index), "")
+            }
+        };
+        editor.set_selection(cosmic_text::Selection::None);
+        editor.set_cursor(cosmic_text::Cursor::new(at.0, at.1));
+        // Enter continues a table, list or quote as in the text box
+        if !(text == "\n"
+            && prefix.is_empty()
+            && (crate::md_table::enter_key(&mut *editor, ending)
+                || crate::md_lists::enter_key(&mut *editor, ending)))
+        {
+            let text = format!("{prefix}{text}");
+            crate::md_edit::run(&mut *editor, ending, |_, _, _| {
+                Some(crate::md_edit::Outcome {
+                    changes: vec![crate::md_edit::Change {
+                        line: at.0,
+                        start: at.1,
+                        end: at.1,
+                        text: text.clone(),
+                    }],
+                    cursor: after_insert(at, &text),
+                    anchor: None,
+                })
+            });
+        }
+        // A folded block opens where the text goes
+        crate::folding::reveal_selection(&mut *editor);
+        if let Some(line) = line {
+            // Shaped now, while the editor is hidden: shaping at its first draw would scroll to
+            // the cursor by the size the hidden editor had
+            let mut font_system = iced::advanced::graphics::text::font_system()
+                .write()
+                .unwrap();
+            editor.shape_as_needed(font_system.raw(), false);
+            editor.with_buffer_mut(|buffer| {
+                let top = line.min(buffer.lines.len().saturating_sub(1));
+                buffer.set_scroll(cosmic_text::Scroll::new(top, 0.0, 0.0));
+            });
+        }
+        editor.set_redraw(true);
+    }
+
+    /// Backspace, Delete or Tab (Shift+Tab with `shift`) at the cursor, as the text box does
+    /// them in a Markdown file. `false`: another key, nothing done.
+    fn markdown_follow_key(&mut self, key: &Key, shift: bool) -> bool {
+        use cosmic_text::Action;
+        let ending = self.new_line_ending();
+        let mut editor = self.editor.lock().unwrap();
+        let mut font_system = iced::advanced::graphics::text::font_system()
+            .write()
+            .unwrap();
+        match key {
+            Key::Named(Named::Backspace) if !shift => {
+                if !crate::md_lists::backspace_key(&mut *editor) {
+                    editor.action(font_system.raw(), Action::Backspace);
+                }
+            }
+            Key::Named(Named::Delete) if !shift => editor.action(font_system.raw(), Action::Delete),
+            Key::Named(Named::Tab) => {
+                if !crate::md_table::tab_key(&mut *editor, shift, ending)
+                    && !crate::md_lists::tab_key(&mut *editor, shift)
+                {
+                    editor.action(
+                        font_system.raw(),
+                        if shift {
+                            Action::Unindent
+                        } else {
+                            Action::Indent
+                        },
+                    );
+                }
+            }
+            _ => return false,
+        }
+        editor.set_redraw(true);
+        true
+    }
+}

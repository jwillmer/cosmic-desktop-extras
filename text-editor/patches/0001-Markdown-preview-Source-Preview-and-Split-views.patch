+//! Where things sit in the Markdown source, by line: the top-level blocks, so the Split view can
+//! scroll the preview to the part the editor shows, and the headings for the outline.
+//!
+//! The preview widget does not report where it draws each block, so the preview position is an
+//! estimate, line by line, from the sizes the Markdown widget draws with: a line of prose counts
+//! the lines it wraps to at the preview's width, a heading its larger size and the space above it,
+//! code its smaller size and the block's padding, a table row its cell padding and the `|---|` rule
+//! nothing, every block the spacing after it, and blank lines between blocks nothing. A long
+//! paragraph or table maps line by line (row by row), not as one block. Lists, quotes, images and
+//! closed `<details>` count as prose, so they can be taller or shorter than estimated.
+
+use pulldown_cmark::{CodeBlockKind, Event, Parser, Tag, TagEnd};
+use std::ops::Range;
+
+use super::html::OPTIONS;
+
+// Sizes as the preview's Markdown widget draws them (`Settings::with_text_size`), in lines of
+// prose: text is drawn 1.3 times its size high.
+const LINE_HEIGHT: f32 = 1.3;
+/// Space between two blocks: 0.875 of the text size.
+const BLOCK_GAP: f32 = 0.875 / LINE_HEIGHT;
+/// Heading sizes by level, as a share of the text size.
+const HEADING_SIZE: [f32; 6] = [2.0, 1.75, 1.5, 1.25, 1.0, 1.0];
+/// Space above a heading: half the text size.
+const HEADING_PADDING: f32 = 0.5 / LINE_HEIGHT;
+/// A table row: a line of text with half the block gap above and below.
+const TABLE_ROW: f32 = 1.0 + BLOCK_GAP;
+/// Code is drawn at 0.875 of the text size; the block has a padding of 1.25 code sizes at the top
+/// and bottom, here on the fence lines.
+const CODE_LINE: f32 = 0.875;
+const CODE_FENCE: f32 = 0.875 * 1.25 / LINE_HEIGHT;
+
+/// Line index of every line start, to turn byte offsets into lines.
+struct Lines(Vec<usize>);
+
+impl Lines {
+    fn new(text: &str) -> Self {
+        Self(
+            std::iter::once(0)
+                .chain(text.match_indices('\n').map(|(index, _)| index + 1))
+                .collect(),
+        )
+    }
+
+    fn line(&self, offset: usize) -> usize {
+        self.0.partition_point(|&start| start <= offset) - 1
+    }
+
+    /// Lines covered by a byte range, end exclusive.
+    fn range(&self, bytes: &Range<usize>) -> Range<usize> {
+        let start = self.line(bytes.start);
+        let end = self.line(bytes.end.saturating_sub(1).max(bytes.start)) + 1;
+        start..end
+    }
+}
+
+/// The events of a document with their byte ranges, read once and shared by the block lines and
+/// the line kinds.
+fn events(text: &str) -> Vec<(Event<'_>, Range<usize>)> {
+    Parser::new_ext(text, OPTIONS).into_offset_iter().collect()
+}
+
+/// Source lines of each top-level block that shows in the preview, in order. Front matter and
+/// footnote definitions (drawn at the end) are left out.
+fn block_lines(lines: &Lines, events: &[(Event, Range<usize>)]) -> Vec<Range<usize>> {
+    let mut blocks = Vec::new();
+    let mut depth = 0usize;
+    for (event, range) in events {
+        match event {
+            Event::Start(tag) => {
+                if depth == 0 && !matches!(tag, Tag::MetadataBlock(_) | Tag::FootnoteDefinition(_))
+                {
+                    blocks.push(lines.range(range));
+                }
+                depth += 1;
+            }
+            Event::End(_) => depth = depth.saturating_sub(1),
+            _ if depth == 0 => blocks.push(lines.range(range)),
+            _ => {}
+        }
+    }
+    blocks
+}
+
+/// The source line of each byte offset in `text`.
+pub fn offset_lines(text: &str, offsets: &[Option<usize>]) -> Vec<Option<usize>> {
+    let lines = Lines::new(text);
+    offsets
+        .iter()
+        .map(|offset| offset.map(|offset| lines.line(offset)))
+        .collect()
+}
+
+/// What a source line turns into in the preview, for its estimated height.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Kind {
+    /// Between blocks, front matter, footnote definitions: no height of its own.
+    Outside,
+    /// Prose of this many characters, wrapped to the preview width.
+    Text(usize),
+    /// A line of a paragraph, this many characters: the lines of a paragraph flow together
+    /// before they wrap.
+    Para(usize),
+    /// A heading of this level (1 to 6) and so many characters.
+    Heading(u8, usize),
+    /// A line of a code block: code does not wrap.
+    Code,
+    /// The ``` or ~~~ line of a fenced code block: the block's padding.
+    Fence,
+    /// A row of a table.
+    Row,
+    /// The `|---|` row of a table, or the underline of a setext heading: not drawn.
+    Rule,
+}
+
+fn is_fence(line: &str) -> bool {
+    let line = line.trim_start();
+    line.starts_with("```") || line.starts_with("~~~")
+}
+
+/// The source lines of a document as the preview draws them, to map between a source line and a
+/// position in the preview both ways.
+#[derive(Debug, Default)]
+pub struct Layout {
+    /// Kind of each source line, and whether it is the last line of a block.
+    lines: Vec<(Kind, bool)>,
+}
+
+impl Layout {
+    pub fn new(text: &str) -> Self {
+        let lines_of = Lines::new(text);
+        let mut lines: Vec<(Kind, bool)> =
+            text.split('\n').map(|_| (Kind::Outside, false)).collect();
+        let events = events(text);
+        let blocks = block_lines(&lines_of, &events);
+        let source: Vec<&str> = text.split('\n').collect();
+        for block in &blocks {
+            for line in block.clone() {
+                lines[line].0 = Kind::Text(source[line].trim().chars().count());
+            }
+            if let Some(last) = block.end.checked_sub(1) {
+                lines[last].1 = true;
+            }
+        }
+        let mut depth = 0usize;
+        for (event, range) in &events {
+            match event {
+                Event::Start(tag) => {
+                    if depth == 0 {
+                        let block = lines_of.range(range);
+                        match tag {
+                            Tag::CodeBlock(kind) => {
+                                let fenced = matches!(kind, CodeBlockKind::Fenced(_));
+                                for line in block.clone() {
+                                    lines[line].0 = Kind::Code;
+                                }
+                                if fenced {
+                                    lines[block.start].0 = Kind::Fence;
+                                    let last = block.end - 1;
+                                    if last > block.start && is_fence(source[last]) {
+                                        lines[last].0 = Kind::Fence;
+                                    }
+                                }
+                            }
+                            Tag::Table(_) => {
+                                for line in block.clone() {
+                                    lines[line].0 = Kind::Row;
+                                }
+                                if block.len() > 1 {
+                                    lines[block.start + 1].0 = Kind::Rule;
+                                }
+                            }
+                            Tag::Paragraph => {
+                                for line in block {
+                                    if let Kind::Text(chars) = lines[line].0 {
+                                        lines[line].0 = Kind::Para(chars);
+                                    }
+                                }
+                            }
+                            Tag::Heading { level, .. } => {
+                                let chars = source[block.start]
+                                    .trim()
+                                    .trim_start_matches('#')
+                                    .trim()
+                                    .chars()
+                                    .count();
+                                lines[block.start].0 = Kind::Heading(*level as u8, chars);
+                                for line in &mut lines[block.start + 1..block.end] {
+                                    line.0 = Kind::Rule;
+                                }
+                            }
+                            _ => {}
+                        }
+                    }
+                    depth += 1;
+                }
+                Event::End(_) => depth = depth.saturating_sub(1),
+                _ => {}
+            }
+        }
+        Self { lines }
+    }
+
+    /// Estimated heights for a preview that fits `columns` characters of prose per line.
+    pub fn heights(&self, columns: usize) -> Heights {
+        let columns = columns.max(1);
+        let mut above = Vec::with_capacity(self.lines.len() + 1);
+        let mut sum = 0.0;
+        above.push(sum);
+        for (index, (kind, last)) in self.lines.iter().enumerate() {
+            sum += match *kind {
+                Kind::Para(chars) => self.paragraph_share(index, chars, columns),
+                Kind::Outside | Kind::Rule => 0.0,
+                Kind::Code => CODE_LINE,
+                Kind::Fence => CODE_FENCE,
+                Kind::Row => TABLE_ROW,
+                Kind::Text(chars) => chars.div_ceil(columns).max(1) as f32,
+                Kind::Heading(level, chars) => {
+                    let size = HEADING_SIZE[usize::from(level.clamp(1, 6)) - 1];
+                    // Larger letters: fewer of them fit on a line
+                    let wrapped = ((chars as f32 * size) / columns as f32).ceil().max(1.0);
+                    HEADING_PADDING + wrapped * size
+                }
+            };
+            if *last {
+                sum += BLOCK_GAP;
+            }
+            above.push(sum);
+        }
+        Heights(above)
+    }
+}
+
+impl Layout {
+    /// The height of paragraph line `index` of `chars` characters: the wrapped height of its
+    /// paragraph, shared by its lines by their length.
+    fn paragraph_share(&self, index: usize, chars: usize, columns: usize) -> f32 {
+        let para = |line: &(Kind, bool)| matches!(line.0, Kind::Para(_));
+        let mut start = index;
+        while start > 0 && para(&self.lines[start - 1]) && !self.lines[start - 1].1 {
+            start -= 1;
+        }
+        let mut end = index;
+        while !self.lines[end].1 && end + 1 < self.lines.len() && para(&self.lines[end + 1]) {
+            end += 1;
+        }
+        let lengths = self.lines[start..=end].iter().map(|line| match line.0 {
+            Kind::Para(chars) => chars,
+            _ => 0,
+        });
+        let count = end + 1 - start;
+        // Lines flow together with a space between them
+        let total: usize = lengths.sum::<usize>() + count - 1;
+        let height = total.div_ceil(columns).max(1) as f32;
+        if total == 0 {
+            return height / count as f32;
+        }
+        height * (chars + usize::from(index < end)) as f32 / total as f32
+    }
+}
+
+/// Estimated preview height above each source line, in lines of prose; one more entry than
+/// lines, the last being the total.
+#[derive(Debug, Default)]
+pub struct Heights(Vec<f32>);
+
+impl Heights {
+    /// Number of source lines.
+    pub fn lines(&self) -> usize {
+        self.0.len().saturating_sub(1)
+    }
+
+    fn total(&self) -> f32 {
+        self.0.last().copied().unwrap_or(0.0)
+    }
+
+    /// Estimated height above `line`, in lines of prose; the total for the end.
+    pub fn above(&self, line: usize) -> f32 {
+        self.0.get(line).copied().unwrap_or_else(|| self.total())
+    }
+
+    /// How far down the preview `line` of the source is drawn, from 0 (top) to 1 (end). A line
+    /// between blocks is drawn where the next block starts.
+    pub fn fraction(&self, line: usize) -> f32 {
+        let total = self.total();
+        match self.0.get(line) {
+            Some(above) if total > 0.0 => above / total,
+            _ => 1.0,
+        }
+    }
+
+    /// The source line drawn at `fraction` of the preview's height: the inverse of
+    /// [`Self::fraction`], to the line.
+    pub fn line(&self, fraction: f32) -> usize {
+        let lines = self.0.len().saturating_sub(1);
+        let target = fraction.clamp(0.0, 1.0) * self.total();
+        // The last line that starts at or above the target; a line of no height (blank, a table
+        // rule) shares its start with the next line, so this lands on the line drawn there
+        self.0[..lines]
+            .partition_point(|above| *above <= target)
+            .saturating_sub(1)
+    }
+}
+
+/// Where the preview drew its top-level elements, measured after layout: pairs of source line
+/// and position, in pixels from the top of the preview's content. Between two of them a line
+/// takes its share of the space by its estimated height, so the estimate only spreads a block's
+/// measured height over its lines.
+#[derive(Debug, Default, PartialEq)]
+pub struct Anchors {
+    points: Vec<(usize, f32)>,
+    height: f32,
+}
+
+impl Anchors {
+    /// `lines` and `tops` of the drawn elements in order, `None` where unknown; `height` of all
+    /// content. Points out of order (footnotes drawn at the end) are left out.
+    pub fn new(lines: &[Option<usize>], tops: &[Option<f32>], height: f32) -> Self {
+        let mut points: Vec<(usize, f32)> = Vec::with_capacity(lines.len());
+        for (line, top) in lines.iter().zip(tops) {
+            let (Some(line), Some(top)) = (*line, *top) else {
+                continue;
+            };
+            if points
+                .last()
+                .is_none_or(|&(last, y)| line > last && top >= y)
+            {
+                points.push((line, top));
+            }
+        }
+        Self { points, height }
+    }
+
+    /// The anchors around `index`, a position in `points` from a partition: the one before
+    /// (else the top of the document) and the one after (else its end).
+    fn segment(&self, index: usize, heights: &Heights) -> ((usize, f32), (usize, f32)) {
+        let lines = heights.0.len().saturating_sub(1);
+        let before = index
+            .checked_sub(1)
+            .map_or((0, 0.0), |index| self.points[index]);
+        let after = self
+            .points
+            .get(index)
+            .copied()
+            .unwrap_or((lines, self.height));
+        (before, after)
+    }
+
+    /// How far down the content source `line` is drawn, in pixels.
+    pub fn y(&self, heights: &Heights, line: usize) -> f32 {
+        let line = line.min(heights.0.len().saturating_sub(1));
+        let index = self.points.partition_point(|&(start, _)| start <= line);
+        let ((a, top_a), (b, top_b)) = self.segment(index, heights);
+        let (above_a, above_b) = (heights.0[a], heights.0[b.max(a)]);
+        let share = if above_b > above_a {
+            (heights.0[line] - above_a) / (above_b - above_a)
+        } else {
+            0.0
+        };
+        top_a + share.clamp(0.0, 1.0) * (top_b - top_a)
+    }
+
+    /// The source line drawn `y` pixels down the content: the inverse of [`Self::y`], to the
+    /// line.
+    pub fn line(&self, heights: &Heights, y: f32) -> usize {
+        let index = self.points.partition_point(|&(_, top)| top <= y);
+        let ((a, top_a), (b, top_b)) = self.segment(index, heights);
+        if b <= a {
+            return a;
+        }
+        let share = if top_b > top_a {
+            ((y - top_a) / (top_b - top_a)).clamp(0.0, 1.0)
+        } else {
+            0.0
+        };
+        let target = heights.0[a] + share * (heights.0[b] - heights.0[a]);
+        // The last line of the segment that starts at or above the target
+        a + heights.0[a..b]
+            .partition_point(|above| *above <= target)
+            .saturating_sub(1)
+    }
+}
+
+/// A heading of the outline.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Heading {
+    /// 1 to 6.
+    pub level: u8,
+    pub text: String,
+    /// Source line of the heading (the text line of a setext heading).
+    pub line: usize,
+}
+
+/// The headings of the document in order: ATX (`#`), setext (underlined) and the `<h1>`..`<h6>`
+/// of HTML blocks. Headings inside code blocks are text, not headings.
+pub fn headings(text: &str) -> Vec<Heading> {
+    let lines = Lines::new(text);
+    let mut headings = Vec::new();
+    // The heading being read: level, line, text so far
+    let mut current: Option<(u8, usize, String)> = None;
+    // The HTML block being read: start offset, text so far
+    let mut html: Option<(usize, String)> = None;
+    // Inside an image: its alt text is not part of the outline label
+    let mut images = 0usize;
+    for (event, range) in Parser::new_ext(text, OPTIONS).into_offset_iter() {
+        match event {
+            Event::Start(Tag::Heading { level, .. }) => {
+                current = Some((level as u8, lines.line(range.start), String::new()));
+            }
+            Event::End(TagEnd::Heading(_)) => {
+                if let Some((level, line, text)) = current.take() {
+                    push_heading(&mut headings, level, line, &text);
+                }
+            }
+            Event::Start(Tag::Image { .. }) => images += 1,
+            Event::End(TagEnd::Image) => images = images.saturating_sub(1),
+            Event::Text(value) | Event::Code(value) if images == 0 => {
+                if let Some((_, _, text)) = current.as_mut() {
+                    text.push_str(&value);
+                }
+            }
+            Event::Start(Tag::HtmlBlock) => html = Some((range.start, String::new())),
+            Event::Html(value) => {
+                if let Some((_, block)) = html.as_mut() {
+                    block.push_str(&value);
+                }
+            }
+            Event::End(TagEnd::HtmlBlock) => {
+                if let Some((start, block)) = html.take() {
+                    html_headings(&mut headings, &block, lines.line(start));
+                }
+            }
+            _ => {}
+        }
+    }
+    headings
+}
+
+fn push_heading(headings: &mut Vec<Heading>, level: u8, line: usize, text: &str) {
+    let text = text.split_whitespace().collect::<Vec<_>>().join(" ");
+    if !text.is_empty() {
+        headings.push(Heading { level, text, line });
+    }
+}
+
+/// `<h1>`..`<h6>` in the text of an HTML block that starts on `first_line`; tags inside the
+/// heading are dropped.
+fn html_headings(headings: &mut Vec<Heading>, block: &str, first_line: usize) {
+    let lower = block.to_ascii_lowercase();
+    let mut from = 0;
+    while let Some(found) = lower[from..].find("<h") {
+        let open = from + found;
+        from = open + 2;
+        let Some(level) = lower[from..]
+            .chars()
+            .next()
+            .and_then(|c| c.to_digit(10))
+            .filter(|level| (1..=6).contains(level))
+        else {
+            continue;
+        };
+        let after = &lower[from + 1..];
+        if !after.starts_with(['>', ' ', '\t', '\n', '\r']) {
+            continue;
+        }
+        let Some(start) = after.find('>').map(|end| from + 1 + end + 1) else {
+            break;
+        };
+        let close = format!("</h{level}");
+        let Some(end) = lower[start..].find(&close).map(|end| start + end) else {
+            break;
+        };
+        let mut text = String::new();
+        let mut in_tag = false;
+        for c in block[start..end].chars() {
+            match c {
+                '<' => in_tag = true,
+                '>' => in_tag = false,
+                c if !in_tag => text.push(c),
+                _ => {}
+            }
+        }
+        let line = first_line + block[..open].matches('\n').count();
+        push_heading(headings, level as u8, line, &text);
+        from = end;
+    }
+}
+
+/// Index of the heading the source `line` sits under: the last one at or above it.
+pub fn current_heading(headings: &[Heading], line: usize) -> Option<usize> {
+    headings
+        .partition_point(|heading| heading.line <= line)
+        .checked_sub(1)
+}
+
+/// Index of the heading to show as current for a preview that shows source lines `top` to
+/// `bottom`: the top-most heading in view, else the one the top line sits under. At the end of
+/// the scroll range the last one in view, as the headings further down can never reach the top.
+pub fn visible_heading(
+    headings: &[Heading],
+    top: usize,
+    bottom: usize,
+    at_end: bool,
+) -> Option<usize> {
+    if at_end {
+        return current_heading(headings, bottom);
+    }
+    let first = headings.partition_point(|heading| heading.line < top);
+    match headings.get(first) {
+        Some(heading) if heading.line < bottom => Some(first),
+        _ => current_heading(headings, top),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const DOC: &str =
+        "# Title\n\nFirst paragraph\nstill first.\n\n```\ncode\ncode\n```\n\n- a\n- b\n";
+
+    #[test]
+    fn finds_top_level_blocks() {
+        let blocks = |text| block_lines(&Lines::new(text), &events(text));
+        assert_eq!(blocks(DOC), vec![0..1, 2..4, 5..9, 10..12]);
+        // Front matter is hidden in the preview
+        assert_eq!(blocks("---\na: 1\n---\n\nText\n"), vec![4..5]);
+    }
+
+    /// Height above `line`, in lines of prose.
+    fn above(heights: &Heights, line: usize) -> f32 {
+        heights.0[line]
+    }
+
+    fn close(a: f32, b: f32) -> bool {
+        (a - b).abs() < 1e-4
+    }
+
+    #[test]
+    fn measured_positions_place_each_block() {
+        // A heading, a closed <details> of many source lines but one drawn line, a heading
+        let text =
+            "# One\n\n<details>\n<summary>More</summary>\n\na\nb\nc\nd\n\n</details>\n\n# Two\n";
+        let heights = Layout::new(text).heights(80);
+        let anchors = Anchors::new(
+            &[Some(0), Some(2), Some(12)],
+            &[Some(10.0), Some(60.0), Some(90.0)],
+            200.0,
+        );
+        assert_eq!(anchors.y(&heights, 0), 10.0);
+        assert_eq!(anchors.y(&heights, 2), 60.0);
+        // The second heading is drawn right below the closed block, whatever its source length
+        assert_eq!(anchors.y(&heights, 12), 90.0);
+        assert_eq!(anchors.line(&heights, 90.0), 12);
+        assert_eq!(anchors.line(&heights, 95.0), 12);
+        assert!((2..12).contains(&anchors.line(&heights, 89.0)));
+        assert!((2..12).contains(&anchors.line(&heights, 70.0)));
+        assert_eq!(anchors.line(&heights, 0.0), 0);
+        // Lines inside a block share its measured height by their estimate
+        let y = anchors.y(&heights, 6);
+        assert!(y > 60.0 && y < 90.0, "{y}");
+        assert_eq!(anchors.line(&heights, y + 0.01), 6);
+    }
+
+    #[test]
+    fn anchors_out_of_order_are_left_out() {
+        let anchors = Anchors::new(
+            &[Some(0), None, Some(5), Some(3)],
+            &[Some(0.0), Some(10.0), Some(20.0), Some(500.0)],
+            600.0,
+        );
+        assert_eq!(anchors.points, vec![(0, 0.0), (5, 20.0)]);
+    }
+
+    // DOC as drawn: the 1 heading (padding, twice the size), the paragraph (its 2 short lines flow
+    // into 1), the code
+    // block (fences, 2 code lines), the list (2 lines), each with spacing after
+    const H1: f32 = HEADING_PADDING + 2.0 + BLOCK_GAP;
+    const PARAGRAPH: f32 = 1.0 + BLOCK_GAP;
+    const CODE: f32 = 2.0 * CODE_FENCE + 2.0 * CODE_LINE + BLOCK_GAP;
+    const TOTAL: f32 = H1 + PARAGRAPH + CODE + 2.0 + BLOCK_GAP;
+
+    #[test]
+    fn editor_line_maps_to_preview_position() {
+        let heights = Layout::new(DOC).heights(80);
+        assert!(close(heights.total(), TOTAL));
+        // The code block starts below heading and paragraph; the blank line before it is drawn
+        // where it starts; its first code line below the fence
+        assert!(close(above(&heights, 4), H1 + PARAGRAPH));
+        assert!(close(above(&heights, 5), H1 + PARAGRAPH));
+        assert!(close(above(&heights, 6), H1 + PARAGRAPH + CODE_FENCE));
+        assert!(close(heights.fraction(5), (H1 + PARAGRAPH) / TOTAL));
+        assert_eq!(heights.fraction(0), 0.0);
+        let mut last = 0.0;
+        for line in 0..12 {
+            let fraction = heights.fraction(line);
+            assert!(fraction >= last, "line {line} goes back up");
+            last = fraction;
+        }
+    }
+
+    #[test]
+    fn lines_after_last_block_map_to_end() {
+        let heights = Layout::new(DOC).heights(80);
+        assert_eq!(heights.fraction(12), 1.0);
+        assert_eq!(heights.fraction(500), 1.0);
+        assert_eq!(Layout::new("").heights(80).fraction(0), 1.0);
+        assert_eq!(Heights::default().fraction(0), 1.0);
+        assert_eq!(Heights::default().line(0.5), 0);
+    }
+
+    #[test]
+    fn preview_position_maps_back_to_the_line_drawn_there() {
+        let heights = Layout::new(DOC).heights(80);
+        for line in [0, 2, 3, 5, 6, 7, 8, 10, 11] {
+            assert_eq!(heights.line(heights.fraction(line)), line, "line {line}");
+        }
+        // The blank line before a block is not drawn: its position is the block's
+        assert_eq!(heights.line(heights.fraction(4)), 5);
+        // Inside the second source line of the paragraph (16 of its 28 characters down) stays on it
+        assert_eq!(heights.line((H1 + 0.8) / TOTAL), 3);
+        assert_eq!(heights.line(0.0), 0);
+        assert_eq!(heights.line(1.0), 12);
+        assert_eq!(heights.line(-1.0), 0);
+    }
+
+    #[test]
+    fn long_lines_count_the_lines_they_wrap_to() {
+        // One 400 character line wraps to 5 lines at 80 columns, 10 at 40
+        let text = format!("{}\n\nAfter\n", "word ".repeat(80).trim_end());
+        let heights = Layout::new(&text).heights(80);
+        assert!(close(above(&heights, 2), 5.0 + BLOCK_GAP));
+        assert!(close(
+            above(&Layout::new(&text).heights(40), 2),
+            10.0 + BLOCK_GAP
+        ));
+        // A position inside the wrapped line maps to it, not past it
+        assert_eq!(heights.line(4.0 / heights.total()), 0);
+    }
+
+    #[test]
+    fn hard_wrapped_paragraphs_flow_before_they_wrap() {
+        // Ten source lines of 39 characters: 399 with the spaces between, 5 lines at 80 columns,
+        // not 10
+        let line = "x".repeat(39);
+        let text = format!("{}\n\nAfter\n", vec![line.as_str(); 10].join("\n"));
+        let heights = Layout::new(&text).heights(80);
+        assert!(close(above(&heights, 11), 5.0 + BLOCK_GAP));
+        // Shared by length: the fifth line starts about half way down
+        assert!(close(above(&heights, 5), 5.0 * 200.0 / 399.0));
+        // A list keeps a line per item
+        let list = Layout::new("- a\n- b\n- c\n").heights(80);
+        assert!(close(list.total(), 3.0 + BLOCK_GAP));
+    }
+
+    #[test]
+    fn headings_tables_and_code_take_their_drawn_size() {
+        let long = "x".repeat(200);
+        let text = format!(
+            "## Two\n\n| a | b |\n|---|---|\n| 1 | 2 |\n\n```\n{long}\n```\n\nSetext\n===\n"
+        );
+        let heights = Layout::new(&text).heights(80);
+        // The heading: padding above, 1.75 times the size
+        let h2 = HEADING_PADDING + 1.75 + BLOCK_GAP;
+        assert!(close(above(&heights, 2), h2));
+        // Header row; the rule is not drawn: the first row starts below the header
+        assert!(close(above(&heights, 3), h2 + TABLE_ROW));
+        assert!(close(above(&heights, 4), h2 + TABLE_ROW));
+        assert_eq!(heights.line(heights.fraction(3)), 4);
+        let table = 2.0 * TABLE_ROW + BLOCK_GAP;
+        // Code: the fence's padding, one line of code (it does not wrap), the closing fence
+        assert!(close(above(&heights, 7), h2 + table + CODE_FENCE));
+        let code = 2.0 * CODE_FENCE + CODE_LINE + BLOCK_GAP;
+        assert!(close(above(&heights, 10), h2 + table + code));
+        // A setext heading: its underline is not drawn
+        assert!(close(
+            heights.total(),
+            h2 + table + code + HEADING_PADDING + 2.0 + BLOCK_GAP
+        ));
+    }
+
+    const OUTLINE: &str = "# One\n\nText\n\nTwo\n===\n\n## Three `code`\n\n```\n# not a heading\n```\n\n    # indented code\n\nFour\n----\n\n###### Six\n";
+
+    fn levels(text: &str) -> Vec<(u8, String, usize)> {
+        headings(text)
+            .into_iter()
+            .map(|heading| (heading.level, heading.text, heading.line))
+            .collect()
+    }
+
+    #[test]
+    fn outline_lists_atx_and_setext_headings_with_levels() {
+        assert_eq!(
+            levels(OUTLINE),
+            vec![
+                (1, "One".into(), 0),
+                (1, "Two".into(), 4),
+                (2, "Three code".into(), 7),
+                (2, "Four".into(), 15),
+                (6, "Six".into(), 18),
+            ]
+        );
+        let html = "<h1 align=\"center\">\n  <img src=\"logo.png\"> Logo <b>name</b>\n</h1>\n\n<p>x</p>\n<H3>Small</H3>\n<hr>\n";
+        assert_eq!(
+            levels(html),
+            vec![(1, "Logo name".into(), 0), (3, "Small".into(), 5)]
+        );
+    }
+
+    #[test]
+    fn outline_labels_leave_out_images() {
+        let text = "## Image in a heading ![dot](x.png)\n\n# ![logo](l.png) Title\n";
+        assert_eq!(
+            levels(text),
+            vec![
+                (2, "Image in a heading".to_string(), 0),
+                (1, "Title".to_string(), 2)
+            ]
+        );
+    }
+
+    #[test]
+    fn headings_in_code_blocks_are_ignored() {
+        let texts: Vec<String> = headings(OUTLINE).into_iter().map(|h| h.text).collect();
+        assert!(!texts.iter().any(|text| text.contains("not a heading")));
+        assert!(!texts.iter().any(|text| text.contains("indented")));
+        assert!(headings("```\n<h1>x</h1>\n```\n").is_empty());
+    }
+
+    #[test]
+    fn click_target_is_heading_source_line() {
+        let lines: Vec<&str> = OUTLINE.lines().collect();
+        for heading in headings(OUTLINE) {
+            assert!(
+                lines[heading.line].contains(heading.text.split(' ').next().unwrap()),
+                "{heading:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn current_heading_follows_cursor() {
+        let outline = headings(OUTLINE);
+        assert_eq!(current_heading(&outline, 0), Some(0));
+        assert_eq!(current_heading(&outline, 3), Some(0));
+        assert_eq!(current_heading(&outline, 5), Some(1));
+        assert_eq!(current_heading(&outline, 12), Some(2));
+        assert_eq!(current_heading(&outline, 100), Some(4));
+        assert_eq!(current_heading(&headings("Text\n\n# Later\n"), 0), None);
+    }
+
+    #[test]
+    fn preview_highlights_top_most_visible_heading() {
+        // Headings on lines 0, 4, 7, 15, 18
+        let outline = headings(OUTLINE);
+        // A heading in view wins over the one above the top
+        assert_eq!(visible_heading(&outline, 1, 6, false), Some(1));
+        assert_eq!(visible_heading(&outline, 4, 10, false), Some(1));
+        // None in view: the section the top line is in
+        assert_eq!(visible_heading(&outline, 8, 14, false), Some(2));
+        assert_eq!(visible_heading(&outline, 0, 3, false), Some(0));
+        // The heading on the bottom edge is not in view yet
+        assert_eq!(visible_heading(&outline, 8, 15, false), Some(2));
+        // Scrolled to the end: the last heading in view, even below the first one in view
+        assert_eq!(visible_heading(&outline, 14, 19, true), Some(4));
+        assert_eq!(visible_heading(&outline, 14, 16, true), Some(3));
+        assert_eq!(visible_heading(&[], 0, 10, false), None);
+        assert_eq!(
+            visible_heading(&headings("Text\n\n# Later\n"), 0, 1, false),
+            None
+        );
+    }
+}

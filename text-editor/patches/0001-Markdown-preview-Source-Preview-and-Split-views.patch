+#[cfg(test)]
+mod tests {
+    // Behaviours covered:
+    // - hard breaks split a leaf into lines, as the paragraph draws it
+    // - copying one leaf, part of a leaf, and across paragraph, list, code lines and table cells
+    // - a drag upwards copies the same as one downwards
+    // - an empty selection copies nothing
+    // - select all spans every leaf, and copies nothing from an empty document
+    use super::*;
+
+    fn leaf(text: &str, joint: Joint) -> Leaf {
+        Leaf {
+            text: text.to_string(),
+            joint,
+            whole: false,
+        }
+    }
+
+    fn selection(anchor: (usize, usize), focus: (usize, usize)) -> Selection {
+        Selection {
+            anchor: Spot {
+                leaf: anchor.0,
+                grapheme: anchor.1,
+            },
+            focus: Spot {
+                leaf: focus.0,
+                grapheme: focus.1,
+            },
+            dragging: false,
+        }
+    }
+
+    #[test]
+    fn hard_breaks_start_lines() {
+        assert_eq!(
+            line_ranges("ab\ncde\n").collect::<Vec<_>>(),
+            [0..2, 3..6, 7..7]
+        );
+        assert_eq!(line_ranges("").collect::<Vec<_>>(), [0..0]);
+    }
+
+    #[test]
+    fn leaves_near_the_pointer_are_ranked() {
+        let bounds = Rectangle::new(Point::new(10.0, 100.0), Size::new(200.0, 40.0));
+        let off = |x, y| Near::of(bounds, Point::new(x, y)).map(|near| near.off);
+        assert_eq!(off(50.0, 120.0), Some((0.0, 0.0)));
+        // Past the end of a line, in the margin, above and below
+        assert_eq!(off(260.0, 120.0), Some((0.0, 50.0)));
+        assert_eq!(off(0.0, 120.0), Some((0.0, 10.0)));
+        assert_eq!(off(50.0, 90.0), Some((10.0, 0.0)));
+        assert_eq!(off(50.0, 150.0), Some((10.0, 0.0)));
+        assert_eq!(off(50.0, 500.0), None);
+        // Beside beats above or below; nearer beats farther
+        let at = |off| Near {
+            pointer: Point::ORIGIN,
+            off,
+        };
+        assert!(at((5.0, 0.0)).loses_to(&at((0.0, 300.0))));
+        assert!(at((0.0, 20.0)).loses_to(&at((0.0, 10.0))));
+        assert!(!at((0.0, 0.0)).loses_to(&at((0.0, 10.0))));
+        let elsewhere = Near {
+            pointer: Point::new(1.0, 0.0),
+            off: (40.0, 0.0),
+        };
+        assert!(!elsewhere.loses_to(&at((0.0, 0.0))));
+    }
+
+    #[test]
+    fn the_selection_fill_stands_out_and_keeps_text_readable() {
+        for theme in [cosmic::Theme::light(), cosmic::Theme::dark()] {
+            let cosmic = theme.cosmic();
+            let accent = Color::from(cosmic.accent.base);
+            // The page, and code blocks on their component surface
+            for (background, text) in [
+                (cosmic.bg_color(), cosmic.on_bg_color()),
+                (cosmic.bg_component_color(), cosmic.on_bg_component_color()),
+            ] {
+                let (background, text) = (Color::from(background), Color::from(text));
+                let fill = selection_fill(accent, background, text);
+                assert_eq!((fill.r, fill.g, fill.b), (accent.r, accent.g, accent.b));
+                assert!(fill.a <= 0.6 * accent.a + 1e-6, "{fill:?}");
+                let shown = blend(accent, background, fill.a / accent.a);
+                assert!(contrast(text, shown) >= 4.0, "{text:?} on {shown:?}");
+                assert!(
+                    contrast(shown, background) >= 1.5,
+                    "{fill:?} on {background:?}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn a_double_click_selects_the_word() {
+        let text = "Tomatoes need sun, caf\u{e9}s too";
+        assert_eq!(word_at(text, 0), (0, 8));
+        assert_eq!(word_at(text, 5), (0, 8));
+        assert_eq!(word_at(text, 8), (8, 9));
+        assert_eq!(word_at(text, 10), (9, 13));
+        assert_eq!(word_at(text, 17), (17, 18));
+        assert_eq!(word_at(text, 20), (19, 24));
+        // Past the end, and nothing to select
+        assert_eq!(word_at(text, 99), (25, 28));
+        assert_eq!(word_at("", 0), (0, 0));
+    }
+
+    #[test]
+    fn leaves_in_a_scrolled_block_compare_with_the_rest() {
+        // A code line in a block scrolled 120 px to the right sees the pointer 120 px further
+        let window = Some(Point::new(300.0, 200.0));
+        let paragraph = Rectangle::new(Point::new(0.0, 150.0), Size::new(100.0, 20.0));
+        let code_line = Rectangle::new(Point::new(0.0, 190.0), Size::new(600.0, 20.0));
+        let beside = Near::of(paragraph, Point::new(300.0, 200.0))
+            .unwrap()
+            .in_window(window);
+        let over = Near::of(code_line, Point::new(420.0, 200.0))
+            .unwrap()
+            .in_window(window);
+        assert!(beside.loses_to(&over));
+        assert!(!over.loses_to(&beside));
+    }
+
+    #[test]
+    fn a_drag_past_an_edge_scrolls_faster_the_farther() {
+        assert_eq!(edge_scroll(100.0, 500.0, 300.0), 0.0);
+        assert_eq!(edge_scroll(100.0, 500.0, 124.0), 0.0);
+        assert_eq!(edge_scroll(100.0, 500.0, 476.0), 0.0);
+        // Near an edge inside, as with the window maximised
+        assert!(edge_scroll(100.0, 500.0, 110.0) < 0.0);
+        assert!(edge_scroll(100.0, 500.0, 499.0) > 0.0);
+        assert!(edge_scroll(100.0, 500.0, 99.0) < 0.0);
+        assert!(edge_scroll(100.0, 500.0, 501.0) > 0.0);
+        // A view smaller than its edge zones does not panic
+        let _ = edge_scroll(0.0, 0.5, 0.2);
+        assert!(edge_scroll(100.0, 500.0, 700.0) > edge_scroll(100.0, 500.0, 520.0));
+        assert!(edge_scroll(100.0, 500.0, -50.0) < edge_scroll(100.0, 500.0, 90.0));
+        assert_eq!(edge_scroll(100.0, 500.0, 5000.0), SCROLL_MAX);
+    }
+
+    #[test]
+    fn scrolling_stops_at_the_ends() {
+        assert!(!can_scroll(0.0, 2000.0, 500.0, -5.0));
+        assert!(can_scroll(10.0, 2000.0, 500.0, -5.0));
+        assert!(can_scroll(0.0, 2000.0, 500.0, 5.0));
+        assert!(!can_scroll(1500.0, 2000.0, 500.0, 5.0));
+        assert!(!can_scroll(0.0, 300.0, 500.0, 5.0));
+    }
+
+    #[test]
+    fn a_marker_counts_only_from_its_start() {
+        let leaves = [
+            Leaf {
+                text: "- ".to_string(),
+                joint: Joint::Paragraph,
+                whole: true,
+            },
+            leaf("seed", Joint::Inline),
+        ];
+        assert_eq!(copied_text(&leaves, &selection((0, 0), (1, 2))), "- se");
+        assert_eq!(copied_text(&leaves, &selection((0, 1), (1, 2))), "se");
+    }
+
+    #[test]
+    fn copies_part_of_one_leaf() {
+        let leaves = [leaf("The quick fox", Joint::Paragraph)];
+        assert_eq!(copied_text(&leaves, &selection((0, 4), (0, 9))), "quick");
+    }
+
+    #[test]
+    fn copies_from_a_paragraph_into_a_list() {
+        let leaves = [
+            leaf("Intro text", Joint::Paragraph),
+            leaf("first item", Joint::Paragraph),
+            leaf("second item", Joint::Line),
+        ];
+        assert_eq!(
+            copied_text(&leaves, &selection((0, 6), (2, 6))),
+            "text\n\nfirst item\nsecond"
+        );
+    }
+
+    #[test]
+    fn copies_code_lines_with_newlines() {
+        let leaves = [
+            leaf("fn main() {", Joint::Paragraph),
+            leaf("    run();", Joint::Line),
+            leaf("}", Joint::Line),
+        ];
+        assert_eq!(
+            copied_text(&leaves, &selection((0, 0), (2, 1))),
+            "fn main() {\n    run();\n}"
+        );
+    }
+
+    #[test]
+    fn copies_table_rows_tab_separated() {
+        let leaves = [
+            leaf("Name", Joint::Paragraph),
+            leaf("Size", Joint::Tab),
+            leaf("apple", Joint::Line),
+            leaf("3", Joint::Tab),
+        ];
+        assert_eq!(
+            copied_text(&leaves, &selection((0, 0), (3, 1))),
+            "Name\tSize\napple\t3"
+        );
+    }
+
+    #[test]
+    fn a_drag_upwards_copies_the_same() {
+        let leaves = [leaf("one", Joint::Paragraph), leaf("two", Joint::Paragraph)];
+        assert_eq!(
+            copied_text(&leaves, &selection((1, 2), (0, 1))),
+            copied_text(&leaves, &selection((0, 1), (1, 2)))
+        );
+        assert_eq!(copied_text(&leaves, &selection((1, 2), (0, 1))), "ne\n\ntw");
+    }
+
+    #[test]
+    fn an_empty_selection_copies_nothing() {
+        let leaves = [leaf("one", Joint::Paragraph)];
+        assert_eq!(copied_text(&leaves, &selection((0, 2), (0, 2))), "");
+        assert_eq!(selection((0, 2), (0, 2)).in_leaf(0), None);
+    }
+
+    #[test]
+    fn select_all_spans_every_leaf() {
+        let leaves = [
+            leaf("Title", Joint::Paragraph),
+            leaf("body ✓", Joint::Paragraph),
+        ];
+        let all = select_all();
+        assert_eq!(copied_text(&leaves, &all), "Title\n\nbody ✓");
+        assert_eq!(all.in_leaf(1), Some((0, usize::MAX)));
+        assert_eq!(copied_text(&[], &all), "");
+    }

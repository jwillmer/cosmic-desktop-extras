+    /// A long document of every kind of block, `count` sections.
+    fn long_document(count: usize, extra: &str) -> String {
+        let mut text = String::from("---\ntitle: x\n---\n\n");
+        for n in 1..=count {
+            text.push_str(&format!(
+                "## Section {n}\n\nSome **bold** text and a [link][ref] with `code`.\n\n\
+                 - item a\n  - nested b\n- [ ] task {n}\n\n1. one\n2. two\n\n\
+                 | a | b |\n|---|---|\n| {n} | x |\n\n```python\nprint({n})\n```\n\n\
+                 > quote {n}\n\n---\n\n{extra}"
+            ));
+        }
+        text.push_str("[ref]: https://example.org/ref\n");
+        text
+    }
+
+    /// The items of all Markdown blocks, as text, and their starts.
+    fn items_and_starts(document: &Document) -> (Vec<String>, Vec<usize>) {
+        let mut items = Vec::new();
+        let mut starts = Vec::new();
+        for (block, block_starts) in document.blocks.iter().zip(&document.starts) {
+            if let Block::Markdown(content) = block {
+                items.extend(content.items().iter().map(|item| format!("{item:?}")));
+                starts.extend(block_starts);
+            }
+        }
+        (items, starts)
+    }
+
+    #[test]
+    fn long_plain_markdown_goes_to_the_widget_in_parts() {
+        let text = long_document(1000, "");
+        assert!(text.len() > 4 * CHUNK_BYTES);
+        let whole = Document {
+            images: HashSet::new(),
+            blocks: vec![Block::Markdown(Content::parse(&text))],
+            starts: vec![item_starts(&text)],
+        };
+        let parts = parse(&text);
+        assert!(parts.blocks.len() > 1);
+        assert_eq!(items_and_starts(&parts), items_and_starts(&whole));
+        // Reference links resolve in every part, not only where the definition is
+        let (items, _) = items_and_starts(&parts);
+        assert!(items.iter().any(|item| item.contains("example.org/ref")));
+        assert_eq!(
+            items
+                .iter()
+                .filter(|item| item.contains("example.org/ref"))
+                .count(),
+            1000
+        );
+    }
+
+    #[test]
+    fn parts_stay_small_whatever_the_length() {
+        // Each part is parsed alone: none may grow with the document, or the parse is
+        // quadratic again
+        let text = long_document(1000, "");
+        let starts = item_starts(&text);
+        let ranges = chunk_ranges(&text, &starts, CHUNK_BYTES);
+        let longest_item = starts
+            .windows(2)
+            .map(|pair| pair[1] - pair[0])
+            .max()
+            .unwrap();
+        assert_eq!(ranges.first().unwrap().start, 0);
+        assert_eq!(ranges.last().unwrap().end, text.len());
+        assert!(ranges.windows(2).all(|pair| pair[0].end == pair[1].start));
+        // Never at a rule: alone at the start of a part it would read as front matter
+        assert!(
+            ranges[1..]
+                .iter()
+                .all(|range| !text[range.clone()].starts_with("---"))
+        );
+        assert!(
+            ranges
+                .iter()
+                .all(|range| range.len() < CHUNK_BYTES + longest_item + 64)
+        );
+        // With HTML the pass hands its plain runs over in parts too
+        let text = long_document(1000, "<kbd>K</kbd>\n\n");
+        let document = parse(&text);
+        let parts = document
+            .blocks
+            .iter()
+            .filter(|block| matches!(block, Block::Markdown(_)))
+            .count();
+        assert!(parts > 4, "{parts} parts");
+    }

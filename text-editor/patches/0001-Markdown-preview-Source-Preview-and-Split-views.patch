+    /// Wait for the parse on another thread to finish and take its result.
+    fn finish_job(tab: &mut crate::tab::EditorTab) {
+        // Only a guard against a hang: the parse takes well under a second
+        for _ in 0..6000 {
+            if tab.markdown_job_done() {
+                return;
+            }
+            std::thread::sleep(Duration::from_millis(10));
+        }
+        panic!("the parse on another thread did not finish");
+    }

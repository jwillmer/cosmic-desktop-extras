+/// The editor's cursor and selection.
+type EditorState = (cosmic_text::Cursor, cosmic_text::Selection);
+
+/// Where Copy or Select All goes in a Markdown tab.
+#[derive(Debug, PartialEq, Eq)]
+enum Target {
+    Preview,
+    Editor,
+    /// The preview shows alone and has nothing selected: never the hidden editor's selection.
+    Nothing,
+}
+
+/// Copy takes the preview's selection where it has one; in the Preview view nothing else.
+fn copy_target(view: Option<ViewMode>, preview_selected: bool) -> Target {
+    match view {
+        Some(ViewMode::Preview | ViewMode::Split) if preview_selected => Target::Preview,
+        Some(ViewMode::Preview) => Target::Nothing,
+        _ => Target::Editor,
+    }
+}
+
+/// Select All selects the rendered text in the Preview view, the editor's otherwise.
+fn select_all_target(view: Option<ViewMode>) -> Target {
+    match view {
+        Some(ViewMode::Preview) => Target::Preview,
+        _ => Target::Editor,
+    }
+}
+
+/// The view a header button switches to: none for the view that is already active.
+pub(crate) fn header_target(mode: ViewMode, current: ViewMode) -> Option<ViewMode> {
+    (mode != current).then_some(mode)
+}
+
+impl App {
+    /// With synchronized views and a Markdown preview in both, the other view's preview follows
+    /// this one by the same fraction of its height.
+    fn follow_preview_scroll(&self, entity: Entity) -> Task<AppMessage> {
+        if !self.config.sync_scroll_views {
+            return Task::none();
+        }
+        let Some(split) = &self.split else {
+            return Task::none();
+        };
+        let Some(side) = split
+            .side_of(entity)
+            .filter(|side| split.shown(*side) == Some(entity))
+        else {
+            return Task::none();
+        };
+        let preview = |tab: Entity| match self.tab_model.data::<Tab>(tab) {
+            Some(Tab::Editor(tab)) => tab
+                .markdown
+                .as_ref()
+                .filter(|preview| preview.mode == ViewMode::Preview),
+            _ => None,
+        };
+        let (Some(this), Some(other)) =
+            (preview(entity), split.shown(side.other()).and_then(preview))
+        else {
+            return Task::none();
+        };
+        match follow_fraction(this.scroll_fraction(), other.scroll_fraction()) {
+            Some(y) => iced::widget::operation::snap_to(
+                other.scroll_id.clone(),
+                RelativeOffset { x: 0.0, y },
+            ),
+            None => Task::none(),
+        }
+    }
+    fn active_editor_tab_mut(&mut self) -> Option<&mut EditorTab> {
+        match self.active_tab_mut() {
+            Some(Tab::Editor(tab)) => Some(tab),
+            _ => None,
+        }
+    }
+
+    pub fn active_markdown_view(&self) -> Option<ViewMode> {
+        match self.active_tab() {
+            Some(Tab::Editor(tab)) => tab.markdown_view(),
+            _ => None,
+        }
+    }
+
+    fn active_preview(&self) -> Option<&Preview> {
+        match self.active_tab() {
+            Some(Tab::Editor(tab)) => tab.markdown.as_ref(),
+            _ => None,
+        }
+    }
+
+    /// Put the preview of the active tab back where it was scrolled to.
+    ///
+    /// Sent as a message, so the scroll runs on the tree the next view built: an operation
+    /// returned right away would only find the scrollable of the previous tab.
+    pub fn markdown_restore_scroll(&mut self) -> Task<AppMessage> {
+        let outline = self.config.markdown_outline;
+        match self
+            .active_editor_tab_mut()
+            .and_then(|tab| tab.markdown.as_mut())
+        {
+            Some(preview) if preview.mode.shows_preview() || outline => {
+                preview.restoring = preview.mode.shows_preview();
+                cosmic::task::message(action::app(Message::RestoreScroll.into()))
+            }
+            _ => Task::none(),
+        }
+    }
+
+    /// Typing or selecting in the editor of the Split view clears the preview's selection.
+    pub fn markdown_editor_acted(&mut self) {
+        if let Some(tab) = self.active_editor_tab_mut()
+            && let Some(preview) = tab.markdown.as_mut()
+            && preview.selection.is_some()
+        {
+            let editor = tab.editor.lock().unwrap();
+            preview.editor_now((editor.cursor(), editor.selection()));
+        }
+    }
+
+    /// Copy and Select All on the preview's selection; `None` when they go to the editor.
+    pub fn markdown_intercept(&mut self, message: &AppMessage) -> Option<Task<AppMessage>> {
+        let view = self.active_markdown_view();
+        match message {
+            AppMessage::Copy => {
+                let text = match self.active_tab() {
+                    Some(Tab::Editor(tab)) => tab.markdown.as_ref().and_then(|preview| {
+                        preview.selected_text(
+                            settings(
+                                self.config.font_size_adjusted(tab.zoom_adj()),
+                                code_font(&self.config.font_name),
+                            ),
+                            self.config.syntax_theme(),
+                        )
+                    }),
+                    _ => None,
+                };
+                match (copy_target(view, text.is_some()), text) {
+                    (Target::Preview, Some(text)) => Some(iced::clipboard::write(text)),
+                    (Target::Editor, _) => None,
+                    _ => Some(Task::none()),
+                }
+            }
+            AppMessage::SelectAll if select_all_target(view) == Target::Preview => {
+                if let Some(preview) = self
+                    .active_editor_tab_mut()
+                    .and_then(|tab| tab.markdown.as_mut())
+                {
+                    preview.selection = Some(select::select_all());
+                    preview.editor_at = None;
+                }
+                Some(Task::none())
+            }
+            _ => None,
+        }
+    }
+
+    /// The preview is read-only: drop editing messages while the editor is hidden.
+    pub fn markdown_blocks(&self, message: &AppMessage) -> bool {
+        blocks(self.active_markdown_view(), message)
+    }
+
+    /// The text of `entity` may have changed: reparse after a short pause.
+    pub fn markdown_changed(&mut self, entity: Entity) -> Task<AppMessage> {
+        let outline = self.config.markdown_outline;
+        let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) else {
+            return Task::none();
+        };
+        let Some(preview) = tab
+            .markdown
+            .as_mut()
+            .filter(|p| outline || p.mode.shows_preview())
+        else {
+            return Task::none();
+        };
+        preview.generation = preview.generation.wrapping_add(1);
+        let generation = preview.generation;
+        Task::perform(tokio::time::sleep(preview.reparse_delay()), move |()| {
+            action::app(Message::Reparse(entity, generation).into())
+        })
+    }
+
+    pub fn update_markdown(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::DefaultView(mode) => match &self.config_handler {
+                Some(config_handler) => {
+                    if let Err(err) = self.config.set_markdown_view(config_handler, mode) {
+                        log::warn!("failed to save config \"markdown_view\": {}", err);
+                    }
+                }
+                None => {
+                    self.config.markdown_view = mode;
+                    log::warn!("failed to save config \"markdown_view\": no config handler");
+                }
+            },
+            Message::RemoteImages(value) => {
+                match &self.config_handler {
+                    Some(config_handler) => {
+                        if let Err(err) = self
+                            .config
+                            .set_markdown_remote_images(config_handler, value)
+                        {
+                            log::warn!("failed to save config \"markdown_remote_images\": {}", err);
+                        }
+                    }
+                    None => {
+                        self.config.markdown_remote_images = value;
+                        log::warn!(
+                            "failed to save config \"markdown_remote_images\": no config handler"
+                        );
+                    }
+                }
+                self.markdown_reload_images();
+            }
+            Message::SlashMenu(value) => match &self.config_handler {
+                Some(config_handler) => {
+                    if let Err(err) = self.config.set_markdown_slash_menu(config_handler, value) {
+                        log::warn!("failed to save config \"markdown_slash_menu\": {}", err);
+                    }
+                }
+                None => {
+                    self.config.markdown_slash_menu = value;
+                    log::warn!("failed to save config \"markdown_slash_menu\": no config handler");
+                }
+            },
+            Message::RemoteImagesCheck => {
+                if remote::take_finished() {
+                    self.markdown_reload_images();
+                }
+            }
+            Message::Edited => {
+                if self.edits_tracked() {
+                    return Task::batch([
+                        self.markdown_changed(self.tab_model.active()),
+                        self.update_markdown(Message::SyncScroll),
+                    ]);
+                }
+            }
+            Message::LinkClicked(uri) => {
+                let base_dir = match self.active_tab() {
+                    Some(Tab::Editor(tab)) => tab.path_opt.as_deref().and_then(Path::parent),
+                    _ => None,
+                };
+                match link_action(&uri, base_dir) {
+                    LinkAction::Launch(target) => {
+                        return self.update(AppMessage::LaunchUrl(target));
+                    }
+                    LinkAction::Edit(path) => return self.update(AppMessage::OpenFile(path)),
+                    LinkAction::Ignore => {}
+                }
+            }
+            Message::Reparse(entity, generation) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && tab.markdown.as_ref().map(|p| p.generation) == Some(generation)
+                {
+                    tab.markdown_refresh();
+                    let measure = match tab.markdown.as_mut() {
+                        Some(preview) => preview.measure(entity),
+                        None => Task::none(),
+                    };
+                    if entity == self.tab_model.active() {
+                        return Task::batch([measure, self.outline_reveal()]);
+                    }
+                    return measure;
+                }
+            }
+            Message::ScrollKey(key) => {
+                if let Some(preview) = self.active_preview()
+                    && preview.mode.shows_preview()
+                {
+                    return scroll_key(preview.scroll_id.clone(), &key);
+                }
+            }
+            Message::Type(text) => {
+                // In Vim mode the keys are commands, not text
+                if self.config.vim_bindings {
+                    return Task::none();
+                }
+                let entity = self.tab_model.active();
+                let Some(tab) = self.active_editor_tab_mut() else {
+                    return Task::none();
+                };
+                let Some(preview) = tab.markdown.as_mut() else {
+                    return Task::none();
+                };
+                // Keys typed right after the switch, before the text box has focus, follow
+                let follow_up = preview.mode.shows_editor()
+                    && preview
+                        .typed_at
+                        .is_some_and(|at| at.elapsed() < TYPE_FOCUS_DELAY);
+                let line = match preview.mode {
+                    ViewMode::Preview => Some(preview.first_line_in_view()),
+                    _ if follow_up => None,
+                    _ => return Task::none(),
+                };
+                preview.typed_at = Some(Instant::now());
+                tab.markdown_type(line, &text);
+                // Switched first: the preview about to hide is not parsed again for the edit
+                let view = match line {
+                    Some(_) => {
+                        self.update_markdown(Message::SetView(ViewMode::Preview.toggle_preview()))
+                    }
+                    None => widget::text_input::focus(self.text_box_id.clone()),
+                };
+                let changed = self.update(AppMessage::TabChanged(entity));
+                return Task::batch([view, changed]);
+            }
+            Message::FollowKey(key, shift) => {
+                let entity = self.tab_model.active();
+                let follow_up = !self.config.vim_bindings
+                    && self.active_preview().is_some_and(|preview| {
+                        preview.mode.shows_editor()
+                            && preview
+                                .typed_at
+                                .is_some_and(|at| at.elapsed() < TYPE_FOCUS_DELAY)
+                    });
+                let Some(tab) = self.active_editor_tab_mut().filter(|_| follow_up) else {
+                    return self.update_markdown(Message::ScrollKey(key));
+                };
+                if let Some(preview) = tab.markdown.as_mut() {
+                    preview.typed_at = Some(Instant::now());
+                }
+                if !tab.markdown_follow_key(&key, shift) {
+                    return Task::none();
+                }
+                return Task::batch([
+                    self.update(AppMessage::TabChanged(entity)),
+                    widget::text_input::focus(self.text_box_id.clone()),
+                ]);
+            }
+            Message::RestoreScroll => {
+                let outline = self.config.markdown_outline;
+                // A tab left before its restore ran would ignore its scroll events for good
+                let tabs: Vec<Entity> = self.tab_model.iter().collect();
+                for entity in tabs {
+                    if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                        && let Some(preview) = tab.markdown.as_mut()
+                    {
+                        preview.restoring = false;
+                    }
+                }
+                let Some(preview) = self
+                    .active_editor_tab_mut()
+                    .and_then(|tab| tab.markdown.as_mut())
+                else {
+                    return Task::none();
+                };
+                let mut tasks = Vec::with_capacity(2);
+                preview.restoring = false;
+                if let Some((id, offset)) = preview.scroll_target() {
+                    preview.expected_offset = None;
+                    tasks.push(iced::widget::operation::scroll_to(id, offset));
+                }
+                if outline && let Some(viewport) = preview.outline_viewport {
+                    tasks.push(iced::widget::operation::scroll_to(
+                        preview.outline_id.clone(),
+                        viewport.offset,
+                    ));
+                }
+                return Task::batch(tasks);
+            }
+            Message::OutlineScrolled(entity, viewport) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && let Some(preview) = tab.markdown.as_mut()
+                {
+                    preview.outline_viewport = Some(viewport);
+                }
+                if entity == self.tab_model.active() {
+                    return self.outline_reveal();
+                }
+            }
+            Message::Scrolled(entity, viewport) => {
+                let active = entity == self.tab_model.active();
+                let config = &self.config;
+                let space_l = f32::from(theme::spacing().space_l);
+                let mut mode = None;
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                    let text_size = text_size(config.font_size_adjusted(tab.zoom_adj()));
+                    let columns = preview_columns(viewport.width, text_size, space_l);
+                    let mut lead = None;
+                    if let Some(preview) = tab.markdown.as_mut() {
+                        mode = Some(preview.mode);
+                        let unit = text_size * LINE_HEIGHT;
+                        if (unit - preview.unit).abs() > 0.01 {
+                            preview.unit = unit;
+                            if !preview.sizes.is_empty() {
+                                preview.sum_sizes();
+                                preview.remeasure = true;
+                            }
+                        }
+                        // In Split the editor follows the preview the user scrolled
+                        if preview.scrolled(viewport, columns)
+                            && active
+                            && config.markdown_sync_scroll
+                            && preview.mode == ViewMode::Split
+                        {
+                            lead = Some(preview.first_line_in_view());
+                        }
+                    }
+                    if let Some(line) = lead {
+                        let line = tab.markdown_scroll_editor(line);
+                        // The editor's own scroll sync would only scroll the preview back
+                        if let Some(preview) = tab.markdown.as_mut() {
+                            preview.synced_line = Some(line);
+                        }
+                    }
+                }
+                let measure = match self.tab_model.data_mut::<Tab>(entity) {
+                    Some(Tab::Editor(tab)) => match tab.markdown.as_mut() {
+                        Some(preview) => preview.measure(entity),
+                        None => Task::none(),
+                    },
+                    _ => Task::none(),
+                };
+                let follow = self.follow_preview_scroll(entity);
+                if active && mode == Some(ViewMode::Preview) {
+                    return Task::batch([measure, follow, self.outline_reveal()]);
+                }
+                return Task::batch([measure, follow]);
+            }
+            Message::Measured(entity, parsed, tops, height) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && let Some(preview) = tab.markdown.as_mut()
+                {
+                    let grown = preview.measured(parsed, &tops, height);
+                    // Keep what is in view in place as the content above it changes height
+                    if grown.abs() > 0.5 {
+                        // From where an earlier compensation still on its way puts it
+                        let base = preview.expected_offset.unwrap_or(preview.scroll_offset.y);
+                        let y = (base + grown).max(0.0);
+                        preview.expected_offset = Some(y);
+                        let scroll = iced::widget::operation::scroll_to(
+                            preview.scroll_id.clone(),
+                            AbsoluteOffset { x: 0.0, y },
+                        );
+                        if entity == self.tab_model.active() {
+                            return Task::batch([scroll, self.outline_reveal()]);
+                        }
+                        return scroll;
+                    }
+                }
+                if entity == self.tab_model.active() {
+                    return self.outline_reveal();
+                }
+            }
+            Message::SyncScroll => {
+                let enabled = self.config.markdown_sync_scroll;
+                let entity = self.tab_model.active();
+                if let Some(tab) = self.active_editor_tab_mut()
+                    && let Some(preview) = tab.markdown.as_mut()
+                    && enabled
+                    && preview.mode == ViewMode::Split
+                    && !preview.sync_pending
+                {
+                    preview.sync_pending = true;
+                    return Task::perform(tokio::time::sleep(SYNC_DELAY), move |()| {
+                        action::app(Message::SyncScrollNow(entity).into())
+                    });
+                }
+            }
+            Message::SyncScrollNow(entity) => {
+                let enabled = self.config.markdown_sync_scroll;
+                let active = entity == self.tab_model.active();
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && let Some(preview) = tab.markdown.as_mut()
+                {
+                    preview.sync_pending = false;
+                    let line = tab
+                        .editor
+                        .lock()
+                        .unwrap()
+                        .with_buffer(|buffer| buffer.scroll().line);
+                    if active && should_sync(enabled, preview.mode, preview.synced_line, line) {
+                        preview.synced_line = Some(line);
+                        return preview.scroll_to_line(line);
+                    }
+                }
+            }
+            Message::ToggleSyncScroll => {
+                let value = !self.config.markdown_sync_scroll;
+                match &self.config_handler {
+                    Some(config_handler) => {
+                        if let Err(err) =
+                            self.config.set_markdown_sync_scroll(config_handler, value)
+                        {
+                            log::warn!("failed to save config \"markdown_sync_scroll\": {}", err);
+                        }
+                    }
+                    None => {
+                        self.config.markdown_sync_scroll = value;
+                        log::warn!(
+                            "failed to save config \"markdown_sync_scroll\": no config handler"
+                        );
+                    }
+                }
+                if value {
+                    return self.update_markdown(Message::SyncScroll);
+                }
+            }
+            Message::ToggleOutline => {
+                let value = !self.config.markdown_outline;
+                match &self.config_handler {
+                    Some(config_handler) => {
+                        if let Err(err) = self.config.set_markdown_outline(config_handler, value) {
+                            log::warn!("failed to save config \"markdown_outline\": {}", err);
+                        }
+                    }
+                    None => {
+                        self.config.markdown_outline = value;
+                        log::warn!("failed to save config \"markdown_outline\": no config handler");
+                    }
+                }
+                if let Some(tab) = self.active_editor_tab_mut() {
+                    tab.markdown_refresh();
+                }
+                if value {
+                    return self.markdown_restore_scroll();
+                }
+            }
+            Message::OutlineGoTo(line) => {
+                let Some(tab) = self.active_editor_tab_mut() else {
+                    return Task::none();
+                };
+                tab.markdown_go_to(line);
+                let Some(preview) = tab.markdown.as_mut() else {
+                    return Task::none();
+                };
+                let mut tasks = Vec::with_capacity(2);
+                if preview.mode.shows_preview() {
+                    // The sync would only scroll there again
+                    preview.synced_line = Some(line);
+                    preview.went_to = Some(line);
+                    tasks.push(preview.scroll_to_line(line));
+                }
+                if preview.mode.shows_editor() {
+                    tasks.push(widget::text_input::focus(self.text_box_id.clone()));
+                }
+                return Task::batch(tasks);
+            }
+            Message::SetView(mode) => {
+                if let Some(tab) = self.active_editor_tab_mut()
+                    && tab.set_markdown_view(mode)
+                {
+                    let restore = self.markdown_restore_scroll();
+                    if mode.shows_editor() {
+                        return Task::batch([
+                            restore,
+                            widget::text_input::focus(self.text_box_id.clone()),
+                        ]);
+                    }
+                    // Find and replace work on the hidden editor
+                    self.close_find();
+                    return restore;
+                }
+            }
+            Message::JobCheck => {
+                let active = self.tab_model.active();
+                let entities: Vec<Entity> = self.tab_model.iter().collect();
+                let mut tasks = Vec::new();
+                for entity in entities {
+                    if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                        && tab.markdown_job_done()
+                        && let Some(preview) = tab.markdown.as_mut()
+                    {
+                        tasks.push(preview.measure(entity));
+                        if entity == active {
+                            tasks.push(self.outline_reveal());
+                        }
+                    }
+                }
+                return Task::batch(tasks);
+            }
+            Message::ShowHeldPreview => {
+                // The notice told about the colours too
+                if let Some(tab) = self.active_editor_tab_mut() {
+                    tab.plain_notice = None;
+                }
+                if let Some(mode) = self
+                    .active_editor_tab_mut()
+                    .and_then(|tab| tab.markdown.as_ref())
+                    .and_then(|preview| preview.held)
+                    .map(|(mode, _)| mode)
+                {
+                    return self.update_markdown(Message::SetView(mode));
+                }
+            }
+            Message::DismissHeld => {
+                if let Some(tab) = self.active_editor_tab_mut() {
+                    tab.plain_notice = None;
+                    if let Some(preview) = tab.markdown.as_mut() {
+                        preview.held = None;
+                    }
+                }
+            }
+            Message::DragEdge(entity, edge) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && let Some(preview) = tab.markdown.as_mut()
+                {
+                    match edge {
+                        select::Edge::Scroll(scroll) => {
+                            if scroll.is_none() {
+                                preview.pinned = false;
+                            }
+                            preview.scroll_speed = scroll;
+                        }
+                        select::Edge::Release => preview.select(select::Action::Release),
+                    }
+                }
+            }
+            Message::DragScrollTick => {
+                let entities: Vec<Entity> = self.tab_model.iter().collect();
+                let mut tasks = Vec::new();
+                for entity in entities {
+                    if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                        && let Some(preview) = tab.markdown.as_mut()
+                        && let Some(task) = preview.drag_scroll()
+                    {
+                        tasks.push(task);
+                    }
+                }
+                return Task::batch(tasks);
+            }
+            Message::Select(entity, action) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && let Some(preview) = tab.markdown.as_mut()
+                {
+                    preview.select(action);
+                    // Where the editor is as the selection starts
+                    let editor = tab.editor.lock().unwrap();
+                    preview.editor_now((editor.cursor(), editor.selection()));
+                }
+            }
+            Message::ToggleDetails(key) => {
+                let entity = self.tab_model.active();
+                if let Some(tab) = self.active_editor_tab_mut()
+                    && let Some(preview) = tab.markdown.as_mut()
+                {
+                    preview.toggle_details(key);
+                    return preview.measure(entity);
+                }
+            }
+            Message::TogglePreview => {
+                if let Some(mode) = self.active_markdown_view() {
+                    return self.update_markdown(Message::SetView(mode.toggle_preview()));
+                }
+            }
+            Message::ToggleSplit => {
+                if let Some(mode) = self.active_markdown_view() {
+                    return self.update_markdown(Message::SetView(mode.toggle_split()));
+                }
+            }
+        }
+        Task::none()
+    }
+
+    /// When the current heading changed (above the cursor, or in the Preview view the one in
+    /// view), scroll the outline so it is in view. Only a change scrolls: the outline can be
+    /// scrolled away by hand in between.
+    fn outline_reveal(&mut self) -> Task<AppMessage> {
+        if !self.config.markdown_outline {
+            return Task::none();
+        }
+        let space_xxs = f32::from(theme::spacing().space_xxs);
+        let Some(tab) = self.active_editor_tab_mut() else {
+            return Task::none();
+        };
+        let cursor_line = tab.editor.lock().unwrap().cursor().line;
+        let Some(preview) = tab.markdown.as_mut() else {
+            return Task::none();
+        };
+        let current = preview.current_heading(cursor_line);
+        if current == preview.outline_current {
+            return Task::none();
+        }
+        // Not drawn yet: try again once it reports its size
+        let Some(viewport) = preview.outline_viewport else {
+            return Task::none();
+        };
+        preview.outline_current = current;
+        match current
+            .and_then(|index| outline_scroll(index, preview.headings.len(), space_xxs, &viewport))
+        {
+            Some(y) => iced::widget::operation::scroll_to(
+                preview.outline_id.clone(),
+                AbsoluteOffset { x: 0.0, y },
+            ),
+            None => Task::none(),
+        }
+    }
+
+    /// Wrap the editor in the active Markdown view.
+    pub fn markdown_layout<'a>(
+        &'a self,
+        entity: Entity,
+        tab: &'a EditorTab,
+        editor: Element<'a, AppMessage>,
+    ) -> Element<'a, AppMessage> {
+        let Some(preview) = &tab.markdown else {
+            return editor;
+        };
+        let mut view = self.markdown_view_layout(entity, tab, preview, editor);
+        if let Some((_, len)) = preview.held
+            && preview.mode == ViewMode::Source
+        {
+            view = widget::column::with_capacity(2)
+                .push(self.markdown_held_bar(len, tab.plain))
+                .push(view)
+                .height(Length::Fill)
+                .into();
+        }
+        if !self.config.markdown_outline {
+            return view;
+        }
+        widget::row::with_capacity(3)
+            .push(self.markdown_outline(entity, tab, preview))
+            .push(widget::divider::vertical::default())
+            .push(view)
+            .height(Length::Fill)
+            .into()
+    }
+
+    /// The notice that a large file opened in Source, with a button to show the preview anyway.
+    fn markdown_held_bar(&self, len: usize, plain: bool) -> Element<'_, AppMessage> {
+        let megabytes = megabytes(len as u64);
+        large_file_bar(
+            if plain {
+                fl!("markdown-large-file-plain", megabytes = megabytes)
+            } else {
+                fl!("markdown-large-file", megabytes = megabytes)
+            },
+            Some(Message::ShowHeldPreview.into()),
+            Message::DismissHeld.into(),
+        )
+    }

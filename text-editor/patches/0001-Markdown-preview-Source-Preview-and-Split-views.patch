+const EXTENSIONS: &[&str] = &["md", "markdown", "mdown", "mkd", "mkdn"];
+/// The preview's parser options without front matter, for callers that find it themselves.
+pub(crate) const PARSE_OPTIONS: pulldown_cmark::Options = html::OPTIONS
+    .difference(pulldown_cmark::Options::ENABLE_YAML_STYLE_METADATA_BLOCKS)
+    .difference(pulldown_cmark::Options::ENABLE_PLUSES_DELIMITED_METADATA_BLOCKS);
+const REPARSE_DELAY: Duration = Duration::from_millis(150);
+const REPARSE_DELAY_LARGE: Duration = Duration::from_millis(300);
+const LARGE_FILE: usize = 100_000;
+/// A Markdown file larger than this opens in Source, with a notice offering the preview: the
+/// preview of a file this size takes a moment to build and much memory.
+const LARGE_PREVIEW: usize = 1_000_000;
+/// Text larger than this is parsed on another thread, so typing and scrolling go on meanwhile.
+const BACKGROUND_PARSE: usize = 256 * 1024;
+/// How often to look for a parse on another thread that finished.
+const JOB_CHECK: Duration = Duration::from_millis(50);
+/// A preview of more top-level elements than this draws only those near the viewport: drawing
+/// them all takes longer than a frame.
+const WINDOW_ELEMENTS: usize = 1000;
+/// The most elements a windowed preview draws at a time.
+const WINDOW_MAX: usize = 300;
+/// A windowed preview draws this far above and below the viewport, in viewport heights.
+const WINDOW_MARGIN: f32 = 1.0;
+/// Leaves of top-level element `n` of a windowed preview are numbered from `n` times this.
+const LEAF_STRIDE: usize = 1 << 24;
+/// Estimated height of an element whose source line is unknown (the footnotes), in lines.
+const UNKNOWN_SIZE: f32 = 3.0;
+/// Text is drawn this many times its size high; see `markdown_map`.
+const LINE_HEIGHT: f32 = 1.3;
+/// How often a selection dragged at a preview's edge scrolls it a step.
+const DRAG_SCROLL_TICK: Duration = Duration::from_millis(16);
+const MAX_WIDTH: f32 = 860.0;
+const LINE_SCROLL: f32 = 40.0;
+const PAGE_SCROLL: f32 = 400.0;
+/// How often to check for images from the web that finished loading.
+const REMOTE_CHECK: Duration = Duration::from_millis(250);
+/// The preview follows the editor at most this often.
+const SYNC_DELAY: Duration = Duration::from_millis(50);
+const OUTLINE_WIDTH: f32 = 220.0;
+/// Characters per preview line before the preview reports its width, and the fewest after.
+const DEFAULT_COLUMNS: usize = 80;
+const MIN_COLUMNS: usize = 20;
+const OUTLINE_INDENT: f32 = 12.0;
+/// Pixels of the text of an outline row, without its padding, in an outline of more than
+/// [`WINDOW_ELEMENTS`] headings: its rows have this height and do not wrap, so that only the
+/// rows near the view are drawn. 24,000 headings drawn in full took 15 ms and more a frame.
+const OUTLINE_LINE: f32 = 20.0;
+/// How long after a key typed in the Preview view switched to Source the next keys still go to
+/// the editor while its text box takes focus.
+const TYPE_FOCUS_DELAY: Duration = Duration::from_millis(500);

+/// Where the other preview scrolls to follow one at `this`, as a fraction; `None` when it
+/// already is there (so its own scroll event does not echo back) or either has nothing to scroll.
+fn follow_fraction(this: Option<f32>, other: Option<f32>) -> Option<f32> {
+    let (this, other) = (this?, other?);
+    ((this - other).abs() > 0.001).then_some(this)
+}
+
+/// Where the outline scrolls to show row `index` of `count` rows, below `padding` at the top;
+/// `None` when the row is already in view, so a manual scroll is not undone.
+fn outline_scroll(index: usize, count: usize, padding: f32, viewport: &Viewport) -> Option<f32> {
+    if count == 0 || index >= count || viewport.content_height <= 0.0 {
+        return None;
+    }
+    // The rows all have the same height
+    let row = (viewport.content_height - 2.0 * padding) / count as f32;
+    let top = if index == 0 {
+        0.0
+    } else {
+        padding + index as f32 * row
+    };
+    let bottom = if index + 1 == count {
+        viewport.content_height
+    } else {
+        padding + (index + 1) as f32 * row
+    };
+    let offset = viewport.offset.y;
+    if top < offset {
+        Some(top)
+    } else if bottom > offset + viewport.height {
+        Some((bottom - viewport.height).max(0.0))
+    } else {
+        None
+    }
+}
+
+/// The rows to draw of an outline of `count` rows of `row` pixels between `padding` at the top
+/// and bottom, scrolled as `viewport` says: those in view and a view's height above and below.
+/// `None`: up to [`WINDOW_ELEMENTS`] rows are all drawn.
+fn outline_window(
+    count: usize,
+    row: f32,
+    padding: f32,
+    viewport: Option<&Viewport>,
+) -> Option<std::ops::Range<usize>> {
+    if count <= WINDOW_ELEMENTS {
+        return None;
+    }
+    // Before the first draw: the top, as high as a tall window
+    let (offset, height) = viewport.map_or((0.0, 1500.0), |viewport| {
+        (viewport.offset.y, viewport.height.max(row))
+    });
+    let overscan = (height / row).ceil() as usize;
+    let first = (((offset - padding).max(0.0) / row) as usize).saturating_sub(overscan);
+    let end =
+        ((((offset + height - padding).max(0.0)) / row).ceil() as usize + overscan).min(count);
+    Some(first.min(end)..end)
+}
+
+/// Messages that change the text or need the editor; ignored while only the preview shows.
+fn needs_editor(message: &AppMessage) -> bool {
+    matches!(
+        message,
+        AppMessage::Cut
+            | AppMessage::Paste
+            | AppMessage::PasteValue(_)
+            | AppMessage::Undo
+            | AppMessage::Redo
+            | AppMessage::Find(Some(_))
+            | AppMessage::FindReplace
+            | AppMessage::FindReplaceAll
+            | AppMessage::SelectAll
+    )
+}
+
+/// The preview is read-only: editing messages are dropped while only the preview shows.
+fn blocks(view: Option<ViewMode>, message: &AppMessage) -> bool {
+    view == Some(ViewMode::Preview) && needs_editor(message)
+}

+    #[test]
+    fn windowed_preview_follows_the_scroll() {
+        let mut tab = large_tab("window", 8000, ViewMode::Preview);
+        // Shown while the headings are still read: the preview is parsed next
+        assert!(tab.set_markdown_view(ViewMode::Preview));
+        assert!(tab.markdown.as_ref().unwrap().preparing());
+        while tab.markdown.as_ref().unwrap().parsed.is_none() {
+            finish_job(&mut tab);
+        }
+        let preview = tab.markdown.as_mut().unwrap();
+        let viewport = |y: f32, content_height: f32| Viewport {
+            offset: AbsoluteOffset { x: 0.0, y },
+            content_height,
+            height: 800.0,
+            width: 800.0,
+        };
+        let total = preview.tops.last().copied().unwrap() * preview.unit;
+        preview.scrolled(viewport(0.0, total), DEFAULT_COLUMNS);
+        let first = preview.drawn().unwrap();
+        assert_eq!(first.range.start, 0);
+        assert_eq!(first.above, 0.0);
+        // A small scroll keeps the window: nothing is drawn anew
+        preview.scrolled(viewport(100.0, total), DEFAULT_COLUMNS);
+        assert_eq!(preview.drawn().unwrap().range, first.range);
+        // Halfway down: the elements there are drawn, the space above stands in for the rest
+        let y = total / 2.0;
+        preview.scrolled(viewport(y, total), DEFAULT_COLUMNS);
+        let middle = preview.drawn().unwrap();
+        assert!(middle.above <= y && middle.above > 0.0);
+        let shown = preview.tops[middle.range.end] * preview.unit;
+        assert!(shown >= y + 800.0, "{shown} {y}");
+
+        // Measured heights replace the estimate; growth above the viewport is reported so the
+        // view can stay in place
+        let parsed = preview.parsed.unwrap();
+        let mut tops = vec![None; preview.anchor_lines.len()];
+        // Drawn twice as high as estimated, below 16 px of padding and the space above
+        let padding = 16.0;
+        let mut top = padding + middle.above;
+        let doubled: Vec<f32> = middle
+            .range
+            .clone()
+            .map(|index| preview.sizes[index] * 2.0)
+            .collect();
+        for (index, size) in middle.range.clone().zip(&doubled) {
+            tops[index] = Some(top);
+            top += size * preview.unit;
+        }
+        let height = top + middle.below + padding;
+        let above_view = middle
+            .range
+            .clone()
+            .filter(|&index| preview.tops[index + 1] * preview.unit <= y)
+            .count();
+        let grown = preview.measured(parsed, &tops, height);
+        assert_eq!(grown > 0.0, above_view > 1);
+        // Every element drawn is measured, the last one too
+        for (index, size) in middle.range.clone().zip(&doubled) {
+            assert!((preview.sizes[index] - size).abs() < 0.01, "{index}");
+        }
+    }

+    #[test]
+    fn typing_in_preview_goes_to_end_of_top_block() {
+        let lines = [
+            "# Title",     // 0
+            "Body text",   // 1
+            "more body",   // 2
+            "- item a",    // 3
+            "  more of a", // 4
+            "1. item b",   // 5
+            "",            // 6
+            "```rust",     // 7
+            "code",        // 8
+            "",            // 9
+            "more",        // 10
+            "```",         // 11
+            "",            // 12
+            "---",         // 13
+            "> quote",     // 14
+        ];
+        let at = |line| type_position(&lines, line);
+        // A heading is a block of its own, also right above text
+        assert_eq!(at(0), ((0, 7), ""));
+        assert_eq!(at(1), ((2, 9), ""));
+        // A list item ends before the next one
+        assert_eq!(at(3), ((4, 11), ""));
+        assert_eq!(at(5), ((5, 9), ""));
+        // A blank line at the top: the block below it
+        assert_eq!(at(6), ((10, 4), ""));
+        // Code ends before its closing fence, also from inside the block
+        assert_eq!(at(7), ((10, 4), ""));
+        assert_eq!(at(9), ((10, 4), ""));
+        // A closing fence or a rule at the top: the block after it
+        assert_eq!(at(11), ((14, 7), ""));
+        assert_eq!(at(13), ((14, 7), ""));
+        // Past the end: the last line
+        assert_eq!(at(40), ((14, 7), ""));
+
+        // An empty code block gets a line of code, a closing fence at the end a paragraph after
+        assert_eq!(type_position(&["```rust", "```"], 0), ((0, 7), "\n"));
+        assert_eq!(type_position(&["```rust", "```"], 1), ((1, 3), "\n\n"));
+        assert_eq!(type_position(&["```"], 0), ((0, 3), "\n"));
+        // A code block not closed runs to the end; another fence character is code
+        assert_eq!(type_position(&["~~~", "x"], 0), ((1, 1), ""));
+        assert_eq!(type_position(&["~~~", "x", "```"], 0), ((2, 3), ""));
+        assert_eq!(type_position(&["````", "```", "````"], 0), ((1, 3), ""));
+        // A setext heading underline is not typed on
+        assert_eq!(type_position(&["Title", "====="], 0), ((0, 5), ""));
+        assert_eq!(type_position(&["", ""], 0), ((1, 0), ""));
+        assert_eq!(type_position(&[], 3), ((0, 0), ""));
+        assert_eq!(after_insert((2, 3), "ab"), (2, 5));
+        assert_eq!(after_insert((2, 3), "\n\nx"), (4, 1));
+    }

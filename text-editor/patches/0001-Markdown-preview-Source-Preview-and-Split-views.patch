+    /// Whether edits of the active tab update a visible preview or outline.
+    fn edits_tracked(&self) -> bool {
+        match self.active_markdown_view() {
+            Some(ViewMode::Split) => true,
+            Some(_) => self.config.markdown_outline,
+            None => false,
+        }
+    }
+
+    /// Edits in the split view or with the outline open: keys and clicks, as the editor reports
+    /// only its saved state.
+    pub fn markdown_subscription(&self) -> Subscription<AppMessage> {
+        // Images from the web load in the background: check back for them while any are pending
+        let remote = if remote::pending() {
+            iced::time::every(REMOTE_CHECK).map(|_| Message::RemoteImagesCheck.into())
+        } else {
+            Subscription::none()
+        };
+        // A selection dragged at a preview's edge scrolls it, only while it is
+        let drag_scroll = if self.tab_model.iter().any(|entity| {
+            matches!(self.tab_model.data::<Tab>(entity), Some(Tab::Editor(tab))
+                if tab.markdown.as_ref().is_some_and(|preview| preview.scroll_speed.is_some()))
+        }) {
+            iced::time::every(DRAG_SCROLL_TICK).map(|_| Message::DragScrollTick.into())
+        } else {
+            Subscription::none()
+        };
+        // A parse on another thread is looked for until it is done
+        let jobs = if self.tab_model.iter().any(|entity| {
+            matches!(self.tab_model.data::<Tab>(entity), Some(Tab::Editor(tab))
+                if tab.markdown.as_ref().is_some_and(|preview| preview.job.is_some()))
+        }) {
+            iced::time::every(JOB_CHECK).map(|_| Message::JobCheck.into())
+        } else {
+            Subscription::none()
+        };
+        let remote = Subscription::batch([remote, drag_scroll, jobs]);
+        if !self.edits_tracked() {
+            return remote;
+        }
+        let edits = event::listen_with(|event, _status, _window| match event {
+            event::Event::Keyboard(keyboard::Event::KeyPressed { .. })
+            | event::Event::Mouse(mouse::Event::ButtonReleased(_))
+            | event::Event::InputMethod(input_method::Event::Commit(_)) => {
+                Some(Message::Edited.into())
+            }
+            event::Event::Mouse(mouse::Event::WheelScrolled { .. }) => {
+                Some(Message::SyncScroll.into())
+            }
+            _ => None,
+        });
+        Subscription::batch([edits, remote])
+    }
+}

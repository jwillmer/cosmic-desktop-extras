+fn load_image(uri: &str, base_dir: Option<&Path>) -> Option<Image> {
+    if remote::is_fetchable(uri) {
+        return remote::image(uri).map(|bytes| {
+            if remote::is_svg(&bytes) {
+                Image::Vector(widget::svg::Handle::from_memory(bytes.to_vec()))
+            } else {
+                Image::Raster(widget::image::Handle::from_bytes(bytes.to_vec()))
+            }
+        });
+    }
+    let LinkTarget::File(path) = resolve_link(uri, base_dir) else {
+        return None;
+    };
+    if !path.is_file() {
+        return None;
+    }
+    let svg = path
+        .extension()
+        .is_some_and(|ext| ext.eq_ignore_ascii_case("svg"));
+    Some(if svg {
+        Image::Vector(widget::svg::Handle::from_path(path))
+    } else {
+        Image::Raster(widget::image::Handle::from_path(path))
+    })
+}

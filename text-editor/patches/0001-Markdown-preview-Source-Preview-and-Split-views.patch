+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Markdown preview: Source, Preview and Split views for Markdown tabs.
+
+use cosmic::{
+    Application, Element, action,
+    app::Task,
+    cosmic_theme,
+    font::Font,
+    iced::{
+        self, Alignment, Color, ContentFit, Length, Padding, Subscription,
+        advanced::input_method,
+        border, event,
+        keyboard::{self, Key, key::Named},
+        mouse,
+        widget::{
+            rich_text,
+            scrollable::{AbsoluteOffset, Direction, RelativeOffset, Scrollbar},
+        },
+    },
+    theme,
+    widget::{
+        self, button,
+        markdown::{self, Settings, Text, Uri, Viewer},
+        menu::Item as MenuItem,
+        segmented_button::Entity,
+    },
+};
+use cosmic_files::mime_icon::mime_for_path;
+use cosmic_text::Edit;
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::HashMap,
+    fs,
+    hash::{DefaultHasher, Hash, Hasher},
+    path::{Component, Path, PathBuf},
+    sync::Mutex,
+    time::Duration,
+};
+
+use crate::{
+    Action, App, Message as AppMessage, fl,
+    tab::{EditorTab, Tab},
+};
+
+const EXTENSIONS: &[&str] = &["md", "markdown", "mdown", "mkd", "mkdn"];
+const REPARSE_DELAY: Duration = Duration::from_millis(150);
+const REPARSE_DELAY_LARGE: Duration = Duration::from_millis(300);
+const LARGE_FILE: usize = 100_000;
+const MAX_WIDTH: f32 = 860.0;
+const LINE_SCROLL: f32 = 40.0;
+const PAGE_SCROLL: f32 = 400.0;
+
+#[derive(
+    Clone, Copy, Debug, Default, Deserialize, Eq, Hash, Ord, PartialEq, PartialOrd, Serialize,
+)]
+pub enum ViewMode {
+    Source,
+    #[default]
+    Preview,
+    Split,
+}
+
+impl ViewMode {
+    const ALL: [Self; 3] = [Self::Source, Self::Split, Self::Preview];
+
+    /// The mode a Markdown file opens in: an empty file has nothing to preview.
+    pub fn initial(default: Self, empty: bool) -> Self {
+        if empty { Self::Source } else { default }
+    }
+
+    /// Ctrl+Shift+V: Preview <-> Source, Split -> Preview.
+    pub fn toggle_preview(self) -> Self {
+        match self {
+            Self::Preview => Self::Source,
+            Self::Source | Self::Split => Self::Preview,
+        }
+    }
+
+    /// Ctrl+Alt+V: Split <-> Source, Preview -> Split.
+    pub fn toggle_split(self) -> Self {
+        match self {
+            Self::Split => Self::Source,
+            Self::Source | Self::Preview => Self::Split,
+        }
+    }
+
+    pub fn shows_editor(self) -> bool {
+        self != Self::Preview
+    }
+
+    pub fn shows_preview(self) -> bool {
+        self != Self::Source
+    }
+
+    fn label(self) -> String {
+        match self {
+            Self::Source => fl!("markdown-source"),
+            Self::Split => fl!("markdown-split"),
+            Self::Preview => fl!("markdown-preview"),
+        }
+    }
+
+    fn icon(self) -> &'static str {
+        match self {
+            Self::Source => "accessories-text-editor-symbolic",
+            Self::Split => "view-dual-symbolic",
+            Self::Preview => "document-print-preview-symbolic",
+        }
+    }
+}
+
+pub fn is_markdown(path: &Path) -> bool {
+    path.extension()
+        .and_then(|ext| ext.to_str())
+        .is_some_and(|ext| EXTENSIONS.iter().any(|md| ext.eq_ignore_ascii_case(md)))
+}
+
+#[derive(Debug, PartialEq)]
+pub enum LinkTarget {
+    /// Opened by the default handler (web browser, mail client).
+    Url(String),
+    File(PathBuf),
+    /// In-document `#anchor` or an unsupported scheme: ignored.
+    None,
+}
+
+/// Resolve a link from a Markdown file in `base_dir`.
+pub fn resolve_link(uri: &str, base_dir: Option<&Path>) -> LinkTarget {
+    let uri = uri.trim();
+    if uri.is_empty() || uri.starts_with('#') {
+        return LinkTarget::None;
+    }
+    if let Some((scheme, rest)) = uri.split_once(':')
+        && is_scheme(scheme)
+    {
+        return match scheme.to_ascii_lowercase().as_str() {
+            "http" | "https" => LinkTarget::Url(uri.to_string()),
+            "mailto" if mailto_is_plain(rest) => LinkTarget::Url(uri.to_string()),
+            "mailto" => {
+                log::warn!(
+                    "link {:?} ignored: mailto supports only subject, body, cc and bcc",
+                    uri
+                );
+                LinkTarget::None
+            }
+            "file" => {
+                let path = rest.strip_prefix("//").unwrap_or(rest);
+                // file://host/path: only the local host is supported
+                let path = match path.find('/') {
+                    Some(start) if matches!(&path[..start], "" | "localhost") => &path[start..],
+                    _ => return LinkTarget::None,
+                };
+                LinkTarget::File(normalize(&PathBuf::from(percent_decode(strip_suffix(
+                    path,
+                )))))
+            }
+            _ => {
+                log::warn!(
+                    "link {:?} ignored: scheme {:?} is not supported",
+                    uri,
+                    scheme
+                );
+                LinkTarget::None
+            }
+        };
+    }
+    let path = PathBuf::from(percent_decode(strip_suffix(uri)));
+    if path.is_absolute() {
+        return LinkTarget::File(normalize(&path));
+    }
+    match base_dir {
+        Some(base_dir) => LinkTarget::File(normalize(&base_dir.join(path))),
+        None => LinkTarget::None,
+    }
+}
+
+/// A mail link may only fill in the address, subject, body, cc and bcc: mail clients accept more
+/// (attach, attachment) that would send local files.
+fn mailto_is_plain(rest: &str) -> bool {
+    let Some((_, query)) = rest.split_once('?') else {
+        return true;
+    };
+    query
+        .split('&')
+        .filter(|field| !field.is_empty())
+        .all(|field| {
+            let key = percent_decode(field.split('=').next().unwrap_or_default());
+            ["subject", "body", "cc", "bcc"]
+                .iter()
+                .any(|allowed| key.eq_ignore_ascii_case(allowed))
+        })
+}
+
+#[derive(Debug, PartialEq)]
+pub enum LinkAction {
+    /// Hand to the system opener: a web or mail link, or a passive media file.
+    Launch(String),
+    /// Open in the editor.
+    Edit(PathBuf),
+    Ignore,
+}
+
+/// What a click on a link does. A Markdown file may come from anywhere, so a click never runs
+/// anything: only http, https and mailto links and image, audio, video and PDF files go to the
+/// system opener, text files open in the editor, everything else is ignored.
+pub fn link_action(uri: &str, base_dir: Option<&Path>) -> LinkAction {
+    let path = match resolve_link(uri, base_dir) {
+        LinkTarget::Url(url) => return LinkAction::Launch(url),
+        LinkTarget::File(path) => path,
+        LinkTarget::None => return LinkAction::Ignore,
+    };
+    let path = match fs::canonicalize(&path) {
+        Ok(path) if path.is_file() => path,
+        Ok(path) => {
+            log::warn!("link {:?} ignored: {:?} is not a regular file", uri, path);
+            return LinkAction::Ignore;
+        }
+        Err(err) => {
+            log::warn!("link {:?} ignored: {:?}: {}", uri, path, err);
+            return LinkAction::Ignore;
+        }
+    };
+    let mime = mime_for_path(&path, None, false);
+    if is_markdown(&path) || mime.type_() == "text" {
+        return LinkAction::Edit(path);
+    }
+    let passive = matches!(mime.type_().as_str(), "image" | "audio" | "video")
+        || mime.essence_str() == "application/pdf";
+    if passive && !is_executable(&path) {
+        LinkAction::Launch(path.to_string_lossy().into_owned())
+    } else {
+        log::warn!("link {:?} ignored: {:?} is {}", uri, path, mime);
+        LinkAction::Ignore
+    }
+}
+
+#[cfg(unix)]
+fn is_executable(path: &Path) -> bool {
+    use std::os::unix::fs::PermissionsExt;
+    fs::metadata(path).is_ok_and(|metadata| metadata.permissions().mode() & 0o111 != 0)
+}
+
+#[cfg(not(unix))]
+fn is_executable(_path: &Path) -> bool {
+    false
+}
+
+fn is_scheme(value: &str) -> bool {
+    // Two characters at least, so a Windows drive letter is not a scheme
+    value.len() > 1
+        && value.starts_with(|c: char| c.is_ascii_alphabetic())
+        && value
+            .chars()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, '+' | '-' | '.'))
+}
+
+fn strip_suffix(uri: &str) -> &str {
+    uri.split(['#', '?']).next().unwrap_or(uri)
+}
+
+fn percent_decode(value: &str) -> String {
+    let bytes = value.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        if bytes[i] == b'%'
+            && let Some(byte) = value
+                .get(i + 1..i + 3)
+                .and_then(|hex| u8::from_str_radix(hex, 16).ok())
+        {
+            out.push(byte);
+            i += 3;
+        } else {
+            out.push(bytes[i]);
+            i += 1;
+        }
+    }
+    String::from_utf8_lossy(&out).into_owned()
+}
+
+/// Resolve `.` and `..` without touching the file system.
+fn normalize(path: &Path) -> PathBuf {
+    let mut out = PathBuf::new();
+    for component in path.components() {
+        match component {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                out.pop();
+            }
+            other => out.push(other),
+        }
+    }
+    out
+}
+
+enum Image {
+    Raster(widget::image::Handle),
+    Vector(widget::svg::Handle),
+}
+
+/// Per tab state of a Markdown file.
+pub struct Preview {
+    pub mode: ViewMode,
+    content: markdown::Content,
+    /// Hash of the text `content` was parsed from, `None` before the first parse.
+    parsed: Option<u64>,
+    /// Debounce counter: only the newest scheduled reparse runs.
+    generation: u64,
+    /// Local images by link, `None` when missing or remote.
+    images: HashMap<Uri, Option<Image>>,
+    /// Length of the parsed text, to debounce large files longer.
+    parsed_len: usize,
+    scroll_id: widget::Id,
+    scroll_offset: AbsoluteOffset,
+}
+
+impl Preview {
+    fn new(mode: ViewMode) -> Self {
+        Self {
+            mode,
+            content: markdown::Content::new(),
+            parsed: None,
+            generation: 0,
+            images: HashMap::new(),
+            parsed_len: 0,
+            scroll_id: widget::Id::unique(),
+            scroll_offset: AbsoluteOffset::default(),
+        }
+    }
+
+    fn reparse_delay(&self) -> Duration {
+        if self.parsed_len > LARGE_FILE {
+            REPARSE_DELAY_LARGE
+        } else {
+            REPARSE_DELAY
+        }
+    }
+}
+
+impl EditorTab {
+    /// Start the preview of a file just opened, in the configured view.
+    pub fn markdown_init(&mut self, default: ViewMode) {
+        if !self.path_opt.as_deref().is_some_and(is_markdown) {
+            return;
+        }
+        let empty = self
+            .editor
+            .lock()
+            .unwrap()
+            .with_buffer(|buffer| buffer.lines.iter().all(|line| line.text().is_empty()));
+        self.markdown = Some(Preview::new(ViewMode::initial(default, empty)));
+        self.markdown_refresh();
+    }
+
+    /// The tab was saved under a new path: keep the current view, resolve images again.
+    pub fn markdown_path_changed(&mut self) {
+        if !self.path_opt.as_deref().is_some_and(is_markdown) {
+            self.markdown = None;
+            return;
+        }
+        let preview = self
+            .markdown
+            .get_or_insert_with(|| Preview::new(ViewMode::Source));
+        preview.parsed = None;
+        preview.images.clear();
+        self.markdown_refresh();
+    }
+
+    pub fn markdown_view(&self) -> Option<ViewMode> {
+        self.markdown.as_ref().map(|preview| preview.mode)
+    }
+
+    /// Parse the text again if the preview is visible and the text changed.
+    pub fn markdown_refresh(&mut self) {
+        let Some(preview) = self.markdown.as_mut().filter(|p| p.mode.shows_preview()) else {
+            return;
+        };
+        let text = crate::tab::editor_text(&self.editor.lock().unwrap());
+        let mut hasher = DefaultHasher::new();
+        text.hash(&mut hasher);
+        let hash = hasher.finish();
+        if preview.parsed == Some(hash) {
+            return;
+        }
+        preview.parsed = Some(hash);
+        preview.parsed_len = text.len();
+        preview.content = markdown::Content::parse(&text);
+
+        let base_dir = self.path_opt.as_deref().and_then(Path::parent);
+        let links = preview.content.images();
+        // Missing images are looked up again, so one added later shows up
+        preview
+            .images
+            .retain(|uri, image| image.is_some() && links.contains(uri));
+        for uri in links {
+            preview
+                .images
+                .entry(uri.clone())
+                .or_insert_with(|| load_image(uri, base_dir));
+        }
+    }
+}
+
+fn load_image(uri: &str, base_dir: Option<&Path>) -> Option<Image> {
+    let LinkTarget::File(path) = resolve_link(uri, base_dir) else {
+        return None;
+    };
+    if !path.is_file() {
+        return None;
+    }
+    let svg = path
+        .extension()
+        .is_some_and(|ext| ext.eq_ignore_ascii_case("svg"));
+    Some(if svg {
+        Image::Vector(widget::svg::Handle::from_path(path))
+    } else {
+        Image::Raster(widget::image::Handle::from_path(path))
+    })
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    DefaultView(ViewMode),
+    Edited,
+    LinkClicked(Uri),
+    Reparse(Entity, u64),
+    ScrollKey(Key),
+    RestoreScroll,
+    Scrolled(Entity, AbsoluteOffset),
+    SetView(ViewMode),
+    TogglePreview,
+    ToggleSplit,
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::Markdown(message)
+    }
+}
+
+/// Messages that change the text or need the editor; ignored while only the preview shows.
+fn needs_editor(message: &AppMessage) -> bool {
+    matches!(
+        message,
+        AppMessage::Cut
+            | AppMessage::Paste
+            | AppMessage::PasteValue(_)
+            | AppMessage::Undo
+            | AppMessage::Redo
+            | AppMessage::Find(Some(_))
+            | AppMessage::FindReplace
+            | AppMessage::FindReplaceAll
+            | AppMessage::SelectAll
+    )
+}
+
+impl App {
+    fn active_editor_tab_mut(&mut self) -> Option<&mut EditorTab> {
+        match self.active_tab_mut() {
+            Some(Tab::Editor(tab)) => Some(tab),
+            _ => None,
+        }
+    }
+
+    pub fn active_markdown_view(&self) -> Option<ViewMode> {
+        match self.active_tab() {
+            Some(Tab::Editor(tab)) => tab.markdown_view(),
+            _ => None,
+        }
+    }
+
+    fn active_preview(&self) -> Option<&Preview> {
+        match self.active_tab() {
+            Some(Tab::Editor(tab)) => tab.markdown.as_ref(),
+            _ => None,
+        }
+    }
+
+    /// Put the preview of the active tab back where it was scrolled to.
+    ///
+    /// Sent as a message, so the scroll runs on the tree the next view built: an operation
+    /// returned right away would only find the scrollable of the previous tab.
+    pub fn markdown_restore_scroll(&self) -> Task<AppMessage> {
+        match self.active_preview() {
+            Some(preview) if preview.mode.shows_preview() => {
+                cosmic::task::message(action::app(Message::RestoreScroll.into()))
+            }
+            _ => Task::none(),
+        }
+    }
+
+    /// The preview is read-only: drop editing messages while the editor is hidden.
+    pub fn markdown_blocks(&self, message: &AppMessage) -> bool {
+        self.active_markdown_view() == Some(ViewMode::Preview) && needs_editor(message)
+    }
+
+    /// The text of `entity` may have changed: reparse after a short pause.
+    pub fn markdown_changed(&mut self, entity: Entity) -> Task<AppMessage> {
+        let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) else {
+            return Task::none();
+        };
+        let Some(preview) = tab.markdown.as_mut().filter(|p| p.mode.shows_preview()) else {
+            return Task::none();
+        };
+        preview.generation = preview.generation.wrapping_add(1);
+        let generation = preview.generation;
+        Task::perform(tokio::time::sleep(preview.reparse_delay()), move |()| {
+            action::app(Message::Reparse(entity, generation).into())
+        })
+    }
+
+    pub fn update_markdown(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::DefaultView(mode) => match &self.config_handler {
+                Some(config_handler) => {
+                    if let Err(err) = self.config.set_markdown_view(config_handler, mode) {
+                        log::warn!("failed to save config \"markdown_view\": {}", err);
+                    }
+                }
+                None => {
+                    self.config.markdown_view = mode;
+                    log::warn!("failed to save config \"markdown_view\": no config handler");
+                }
+            },
+            Message::Edited => {
+                if self.active_markdown_view() == Some(ViewMode::Split) {
+                    return self.markdown_changed(self.tab_model.active());
+                }
+            }
+            Message::LinkClicked(uri) => {
+                let base_dir = match self.active_tab() {
+                    Some(Tab::Editor(tab)) => tab.path_opt.as_deref().and_then(Path::parent),
+                    _ => None,
+                };
+                match link_action(&uri, base_dir) {
+                    LinkAction::Launch(target) => {
+                        return self.update(AppMessage::LaunchUrl(target));
+                    }
+                    LinkAction::Edit(path) => return self.update(AppMessage::OpenFile(path)),
+                    LinkAction::Ignore => {}
+                }
+            }
+            Message::Reparse(entity, generation) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && tab.markdown.as_ref().map(|p| p.generation) == Some(generation)
+                {
+                    tab.markdown_refresh();
+                }
+            }
+            Message::ScrollKey(key) => {
+                if let Some(preview) = self.active_preview()
+                    && preview.mode.shows_preview()
+                {
+                    return scroll_key(preview.scroll_id.clone(), &key);
+                }
+            }
+            Message::RestoreScroll => {
+                if let Some(preview) = self.active_preview()
+                    && preview.mode.shows_preview()
+                {
+                    return iced::widget::operation::scroll_to(
+                        preview.scroll_id.clone(),
+                        preview.scroll_offset,
+                    );
+                }
+            }
+            Message::Scrolled(entity, offset) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && let Some(preview) = tab.markdown.as_mut()
+                {
+                    preview.scroll_offset = offset;
+                }
+            }
+            Message::SetView(mode) => {
+                if let Some(tab) = self.active_editor_tab_mut()
+                    && let Some(preview) = tab.markdown.as_mut()
+                {
+                    preview.mode = mode;
+                    tab.markdown_refresh();
+                    // Force redraw when the editor comes back
+                    tab.editor.lock().unwrap().set_redraw(true);
+                    let restore = self.markdown_restore_scroll();
+                    if mode.shows_editor() {
+                        return Task::batch([
+                            restore,
+                            widget::text_input::focus(self.text_box_id.clone()),
+                        ]);
+                    }
+                    // Find and replace work on the hidden editor
+                    self.find_opt = None;
+                    return restore;
+                }
+            }
+            Message::TogglePreview => {
+                if let Some(mode) = self.active_markdown_view() {
+                    return self.update_markdown(Message::SetView(mode.toggle_preview()));
+                }
+            }
+            Message::ToggleSplit => {
+                if let Some(mode) = self.active_markdown_view() {
+                    return self.update_markdown(Message::SetView(mode.toggle_split()));
+                }
+            }
+        }
+        Task::none()
+    }
+
+    /// Wrap the editor in the active Markdown view.
+    pub fn markdown_layout<'a>(
+        &'a self,
+        tab: &'a EditorTab,
+        editor: Element<'a, AppMessage>,
+    ) -> Element<'a, AppMessage> {
+        let Some(preview) = &tab.markdown else {
+            return editor;
+        };
+        match preview.mode {
+            ViewMode::Source => editor,
+            ViewMode::Preview => self.markdown_preview(tab, preview),
+            ViewMode::Split => widget::row::with_capacity(3)
+                .push(widget::container(editor).width(Length::FillPortion(1)))
+                .push(widget::divider::vertical::default())
+                .push(
+                    widget::container(self.markdown_preview(tab, preview))
+                        .width(Length::FillPortion(1)),
+                )
+                .height(Length::Fill)
+                .into(),
+        }
+    }
+
+    fn markdown_preview<'a>(
+        &'a self,
+        tab: &'a EditorTab,
+        preview: &'a Preview,
+    ) -> Element<'a, AppMessage> {
+        let cosmic_theme::Spacing {
+            space_m, space_l, ..
+        } = theme::spacing();
+        let viewer = PreviewViewer {
+            images: &preview.images,
+        };
+        let content = markdown::view_with(
+            preview.content.items(),
+            settings(
+                self.config.font_size_adjusted(tab.zoom_adj()),
+                code_font(&self.config.font_name),
+            ),
+            &viewer,
+        );
+        let entity = self.tab_model.active();
+        let scrollable = widget::scrollable(
+            widget::container(
+                widget::container(content)
+                    .max_width(MAX_WIDTH)
+                    .padding([space_m, space_l]),
+            )
+            .center_x(Length::Fill),
+        )
+        .id(preview.scroll_id.clone())
+        .on_scroll(move |viewport| Message::Scrolled(entity, viewport.absolute_offset()).into())
+        .width(Length::Fill)
+        .height(Length::Fill);
+        // Keyed by tab: otherwise the next tab inherits this scroll position
+        iced::widget::keyed_column([(entity, scrollable.into())])
+            .height(Length::Fill)
+            .into()
+    }
+
+    /// Source / Split / Preview buttons in the header bar of a Markdown tab.
+    pub fn markdown_header(&self) -> Vec<Element<'_, AppMessage>> {
+        let Some(current) = self.active_markdown_view() else {
+            return Vec::new();
+        };
+        let buttons = ViewMode::ALL
+            .into_iter()
+            .map(|mode| -> Element<'_, AppMessage> {
+                widget::tooltip(
+                    button::icon(widget::icon::from_name(mode.icon()))
+                        .selected(mode == current)
+                        .on_press(AppMessage::from(Message::SetView(mode))),
+                    widget::text::body(mode.label()),
+                    widget::tooltip::Position::Bottom,
+                )
+                .into()
+            });
+        vec![
+            widget::row::with_children(buttons)
+                .align_y(Alignment::Center)
+                .into(),
+        ]
+    }
+
+    pub fn markdown_settings(&self) -> Element<'_, AppMessage> {
+        let labels: Vec<String> = ViewMode::ALL.iter().map(|mode| mode.label()).collect();
+        let selected = ViewMode::ALL
+            .iter()
+            .position(|mode| *mode == self.config.markdown_view);
+        widget::settings::section()
+            .title(fl!("markdown"))
+            .add(
+                widget::settings::item::builder(fl!("markdown-open-in")).control(widget::dropdown(
+                    labels,
+                    selected,
+                    |index| Message::DefaultView(ViewMode::ALL[index]).into(),
+                )),
+            )
+            .into()
+    }
+
+    /// Edits in the split view: keys and clicks, as the editor reports only its saved state.
+    pub fn markdown_subscription(&self) -> Subscription<AppMessage> {
+        if self.active_markdown_view() != Some(ViewMode::Split) {
+            return Subscription::none();
+        }
+        event::listen_with(|event, _status, _window| match event {
+            event::Event::Keyboard(keyboard::Event::KeyPressed { .. })
+            | event::Event::Mouse(mouse::Event::ButtonReleased(_))
+            | event::Event::InputMethod(input_method::Event::Commit(_)) => {
+                Some(Message::Edited.into())
+            }
+            _ => None,
+        })
+    }
+}
+
+/// Adds the Markdown views to the top of the View menu of a Markdown tab.
+pub trait ViewMenu {
+    fn with_markdown(self, current: Option<ViewMode>) -> Self;
+}
+
+impl ViewMenu for Vec<MenuItem<Action, String>> {
+    fn with_markdown(self, current: Option<ViewMode>) -> Self {
+        let Some(current) = current else {
+            return self;
+        };
+        ViewMode::ALL
+            .into_iter()
+            .map(|mode| {
+                MenuItem::CheckBox(
+                    mode.label(),
+                    None,
+                    mode == current,
+                    Action::MarkdownView(mode),
+                )
+            })
+            .chain([MenuItem::Divider])
+            .chain(self)
+            .collect()
+    }
+}
+
+fn scroll_key(id: widget::Id, key: &Key) -> Task<AppMessage> {
+    let by = |y| iced::widget::operation::scroll_by(id.clone(), AbsoluteOffset { x: 0.0, y });
+    match key {
+        Key::Named(Named::ArrowUp) => by(-LINE_SCROLL),
+        Key::Named(Named::ArrowDown) => by(LINE_SCROLL),
+        Key::Named(Named::PageUp) => by(-PAGE_SCROLL),
+        Key::Named(Named::PageDown) => by(PAGE_SCROLL),
+        Key::Named(Named::Home) => iced::widget::operation::snap_to(id, RelativeOffset::START),
+        Key::Named(Named::End) => iced::widget::operation::snap_to(id, RelativeOffset::END),
+        _ => Task::none(),
+    }
+}
+
+/// The editor's monospace font, so code looks as in the Source view.
+fn code_font(name: &str) -> Font {
+    // Font names must be 'static: keep one copy of each name ever configured
+    static NAMES: Mutex<Vec<&'static str>> = Mutex::new(Vec::new());
+    let mut names = NAMES.lock().unwrap();
+    let name = match names.iter().find(|known| **known == name) {
+        Some(known) => *known,
+        None => {
+            let leaked: &'static str = Box::leak(name.to_owned().into_boxed_str());
+            names.push(leaked);
+            leaked
+        }
+    };
+    Font::with_name(name)
+}
+
+fn settings(font_size: f32, code_font: Font) -> Settings {
+    // Prose reads better a bit larger than code: the default 14 px editor gives 16 px text
+    let text_size = (font_size * 8.0 / 7.0).round();
+    let mut settings = Settings::with_text_size(text_size, style(&theme::active(), code_font));
+    settings.code_size = (text_size * 0.875).round().into();
+    settings
+}
+
+fn style(theme: &theme::Theme, code_font: Font) -> markdown::Style {
+    let cosmic = theme.cosmic();
+    markdown::Style {
+        font: Font::default(),
+        inline_code_highlight: iced::advanced::text::Highlight {
+            background: Color::from(cosmic.bg_component_color()).into(),
+            border: border::rounded(cosmic.corner_radii.radius_xs[0]),
+        },
+        inline_code_padding: Padding::from([0, 2]),
+        inline_code_color: Color::from(cosmic.on_bg_component_color()),
+        inline_code_font: code_font,
+        code_block_font: code_font,
+        link_color: Color::from(cosmic.accent_text_color()),
+    }
+}
+
+/// A code block or image placeholder on the theme's component surface.
+fn surface_class<'a>() -> theme::Container<'a> {
+    theme::Container::custom(|theme| {
+        let cosmic = theme.cosmic();
+        widget::container::Style {
+            background: Some(Color::from(cosmic.bg_component_color()).into()),
+            text_color: Some(Color::from(cosmic.on_bg_component_color())),
+            border: border::rounded(cosmic.corner_radii.radius_s[0]),
+            ..Default::default()
+        }
+    })
+}
+
+struct PreviewViewer<'a> {
+    images: &'a HashMap<Uri, Option<Image>>,
+}
+
+impl<'a> Viewer<'a, AppMessage, theme::Theme, cosmic::Renderer> for PreviewViewer<'a> {
+    fn on_link_click(url: Uri) -> AppMessage {
+        Message::LinkClicked(url).into()
+    }
+
+    fn image(
+        &self,
+        settings: Settings,
+        url: &'a Uri,
+        _title: &'a str,
+        alt: &Text,
+    ) -> Element<'a, AppMessage> {
+        match self.images.get(url) {
+            // Shrink to the content width, never scale up
+            Some(Some(Image::Raster(handle))) => widget::image(handle.clone())
+                .content_fit(ContentFit::ScaleDown)
+                .into(),
+            Some(Some(Image::Vector(handle))) => widget::svg(handle.clone())
+                .width(Length::Shrink)
+                .content_fit(ContentFit::ScaleDown)
+                .into(),
+            _ => widget::container(
+                rich_text(alt.spans(settings.style)).on_link_click(Self::on_link_click),
+            )
+            .padding(settings.spacing.0)
+            .class(surface_class())
+            .into(),
+        }
+    }
+
+    fn code_block(
+        &self,
+        settings: Settings,
+        _language: Option<&'a str>,
+        _code: &'a str,
+        lines: &'a [Text],
+    ) -> Element<'a, AppMessage> {
+        // Spans carry the body font: give them the code font instead
+        let style = markdown::Style {
+            font: settings.style.code_block_font,
+            ..settings.style
+        };
+        let lines = lines.iter().map(move |line| -> Element<'a, AppMessage> {
+            rich_text(line.spans(style))
+                .on_link_click(Self::on_link_click)
+                .font(settings.style.code_block_font)
+                .size(settings.code_size)
+                .into()
+        });
+        widget::container(
+            widget::scrollable(
+                widget::container(widget::column::with_children(lines))
+                    .padding(settings.code_size.0),
+            )
+            .direction(Direction::Horizontal(Scrollbar::default())),
+        )
+        .width(Length::Fill)
+        .class(surface_class())
+        .into()
+    }
+}

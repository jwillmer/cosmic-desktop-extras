+    #[test]
+    fn keys_typed_in_preview() {
+        use keyboard::Modifiers;
+        let none = Modifiers::empty();
+        // The key's text counts, as Shift, AltGr and dead keys make it
+        let typed = |modifiers, key: &str, text: &str| {
+            typed_text(modifiers, &Key::Character(key.into()), Some(text))
+        };
+        assert_eq!(typed(none, "a", "a"), Some("a".into()));
+        assert_eq!(typed(Modifiers::SHIFT, "a", "A"), Some("A".into()));
+        assert_eq!(typed(Modifiers::SHIFT, "3", "#"), Some("#".into()));
+        assert_eq!(typed(none, "e", "é"), Some("é".into()));
+        assert_eq!(typed(none, " ", " "), Some(" ".into()));
+        let enter = Key::Named(Named::Enter);
+        assert_eq!(typed_text(none, &enter, Some("\r")), Some("\n".into()));
+        for modifiers in [Modifiers::CTRL, Modifiers::ALT, Modifiers::LOGO] {
+            assert_eq!(typed(modifiers, "f", "f"), None);
+            assert_eq!(typed_text(modifiers, &enter, None), None);
+        }
+        // Scrolling and other keys type nothing
+        for named in [
+            Named::ArrowDown,
+            Named::PageDown,
+            Named::Home,
+            Named::End,
+            Named::Backspace,
+            Named::Delete,
+            Named::Tab,
+            Named::Escape,
+        ] {
+            assert_eq!(
+                typed_text(none, &Key::Named(named), Some("\t")),
+                None,
+                "{named:?}"
+            );
+        }
+        assert_eq!(typed(none, "a", ""), None);
+        assert_eq!(typed(none, "h", "\u{8}"), None);
+        assert_eq!(typed_text(none, &Key::Character("a".into()), None), None);
+    }

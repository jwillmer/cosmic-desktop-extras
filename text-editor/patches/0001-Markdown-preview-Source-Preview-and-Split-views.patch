+    /// The outline of a Markdown tab: its headings, indented by level; the current one (above
+    /// the cursor, or in view in the Preview view) is highlighted.
+    fn markdown_outline<'a>(
+        &'a self,
+        entity: Entity,
+        tab: &'a EditorTab,
+        preview: &'a Preview,
+    ) -> Element<'a, AppMessage> {
+        let cosmic_theme::Spacing {
+            space_xxs, space_s, ..
+        } = theme::spacing();
+        let cursor_line = tab.editor.lock().unwrap().cursor().line;
+        let current = preview.current_heading(cursor_line);
+        let content: Element<'a, AppMessage> = if preview.headings.is_empty() {
+            widget::container(widget::text::caption(fl!("markdown-outline-empty")))
+                .padding(space_s)
+                .into()
+        } else {
+            let row_height = OUTLINE_LINE + 2.0 * f32::from(space_xxs);
+            let window = outline_window(
+                preview.headings.len(),
+                row_height,
+                f32::from(space_xxs),
+                preview.outline_viewport.as_ref(),
+            );
+            let range = window.clone().unwrap_or(0..preview.headings.len());
+            let rows = preview.headings[range.clone()]
+                .iter()
+                .zip(range.clone())
+                .map(|(heading, index)| -> Element<'a, AppMessage> {
+                    let indent = f32::from(heading.level - 1) * OUTLINE_INDENT;
+                    let mut text = widget::text::body(heading.text.as_str());
+                    if window.is_some() {
+                        text = text.wrapping(iced::widget::text::Wrapping::None);
+                    }
+                    let button = widget::button::custom(text)
+                        .padding(Padding {
+                            top: f32::from(space_xxs),
+                            bottom: f32::from(space_xxs),
+                            left: f32::from(space_s) + indent,
+                            right: f32::from(space_s),
+                        })
+                        .width(Length::Fill)
+                        .class(if current == Some(index) {
+                            theme::Button::Suggested
+                        } else {
+                            theme::Button::Text
+                        })
+                        .on_press(Message::OutlineGoTo(heading.line).into());
+                    if window.is_some() {
+                        button.height(Length::Fixed(row_height)).into()
+                    } else {
+                        button.into()
+                    }
+                });
+            let mut column = widget::column::with_capacity(range.len() + 2);
+            // The rows not drawn keep their space
+            if range.start > 0 {
+                column = column.push(widget::Space::new().height(range.start as f32 * row_height));
+            }
+            column = column.extend(rows);
+            let below = preview.headings.len() - range.end;
+            if below > 0 {
+                column = column.push(widget::Space::new().height(below as f32 * row_height));
+            }
+            column.padding([space_xxs, 0]).into()
+        };
+        let scrollable = widget::scrollable(content)
+            .id(preview.outline_id.clone())
+            .on_scroll(move |viewport| {
+                Message::OutlineScrolled(
+                    entity,
+                    Viewport {
+                        offset: viewport.absolute_offset(),
+                        content_height: viewport.content_bounds().height,
+                        height: viewport.bounds().height,
+                        width: viewport.bounds().width,
+                    },
+                )
+                .into()
+            })
+            .height(Length::Fill);
+        // Keyed by tab: otherwise the next tab inherits this scroll position
+        widget::container(iced::widget::keyed_column([(entity, scrollable.into())]))
+            .width(Length::Fixed(OUTLINE_WIDTH))
+            .height(Length::Fill)
+            .into()
+    }
+
+    /// The editor, the preview or both, as the view of the tab says.
+    fn markdown_view_layout<'a>(
+        &'a self,
+        entity: Entity,
+        tab: &'a EditorTab,
+        preview: &'a Preview,
+        editor: Element<'a, AppMessage>,
+    ) -> Element<'a, AppMessage> {
+        match preview.mode {
+            ViewMode::Source => editor,
+            ViewMode::Preview => self.markdown_preview(entity, tab, preview),
+            ViewMode::Split => widget::row::with_capacity(3)
+                .push(widget::container(editor).width(Length::FillPortion(1)))
+                .push(widget::divider::vertical::default())
+                .push(
+                    widget::container(self.markdown_preview(entity, tab, preview))
+                        .width(Length::FillPortion(1)),
+                )
+                .height(Length::Fill)
+                .into(),
+        }
+    }
+
+    fn markdown_preview<'a>(
+        &'a self,
+        entity: Entity,
+        tab: &'a EditorTab,
+        preview: &'a Preview,
+    ) -> Element<'a, AppMessage> {
+        let cosmic_theme::Spacing {
+            space_m, space_l, ..
+        } = theme::spacing();
+        let viewer = PreviewViewer {
+            images: &preview.images,
+            highlights: &preview.highlights,
+            diagrams: &preview.diagrams,
+            syntax_theme: self.config.syntax_theme(),
+            entity,
+            selection: preview.selection,
+            leaves: RefCell::new(LeafLog::default()),
+        };
+        let content = if preview.preparing() {
+            widget::text::body(fl!("markdown-preparing")).into()
+        } else {
+            html::view_document(
+                &preview.document,
+                settings(
+                    self.config.font_size_adjusted(tab.zoom_adj()),
+                    code_font(&self.config.font_name),
+                ),
+                &viewer,
+                &preview.open_details,
+                &preview.anchor_ids,
+                preview.drawn(),
+            )
+        };
+        let scrollable = widget::scrollable(
+            widget::container(
+                widget::container(content)
+                    .max_width(MAX_WIDTH)
+                    .padding([space_m, space_l]),
+            )
+            .center_x(Length::Fill),
+        )
+        .id(preview.scroll_id.clone())
+        .on_scroll(move |viewport| {
+            Message::Scrolled(
+                entity,
+                Viewport {
+                    offset: viewport.absolute_offset(),
+                    content_height: viewport.content_bounds().height,
+                    height: viewport.bounds().height,
+                    width: viewport.bounds().width,
+                },
+            )
+            .into()
+        })
+        .width(Length::Fill)
+        .height(Length::Fill);
+        let dragging = preview
+            .selection
+            .is_some_and(|selection| selection.dragging);
+        let scrollable = select::DragEdge::new(
+            scrollable,
+            dragging,
+            preview.scroll_speed.map(|(_, pointer)| pointer),
+            move |edge| Message::DragEdge(entity, edge).into(),
+        );
+        // Keyed by tab: otherwise the next tab inherits this scroll position
+        iced::widget::keyed_column([(entity, scrollable.into())])
+            .height(Length::Fill)
+            .into()
+    }
+
+    /// Source / Split / Preview buttons in the header bar of a Markdown tab.

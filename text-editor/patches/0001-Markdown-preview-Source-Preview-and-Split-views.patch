+struct PreviewViewer<'a> {
+    images: &'a HashMap<Uri, Option<Image>>,
+    highlights: &'a highlight::Cache,
+    diagrams: &'a mermaid::Cache,
+    /// The editor's syntax theme, so code blocks are coloured as in the Source view.
+    syntax_theme: &'a str,
+    /// The tab, for the selection messages.
+    entity: Entity,
+    selection: Option<Selection>,
+    leaves: RefCell<LeafLog>,
+}
+
+/// Numbers the selectable text runs ("leaves") of the preview in the order they are drawn, and
+/// records their text for copying while there is a selection.
+#[derive(Default)]
+struct LeafLog {
+    next: usize,
+    record: bool,
+    leaves: Vec<Leaf>,
+    /// The number of each recorded leaf.
+    numbers: Vec<usize>,
+    /// How the next leaf joins the one before, when not the default.
+    joint: Option<Joint>,
+    /// Inside a list or code block: leaves go on their own lines.
+    depth: usize,
+    /// The last leaf was a list marker: the item's text follows on its line.
+    after_marker: bool,
+    /// Leaves are drawn on a code block's surface.
+    surface: bool,
+}
+
+impl LeafLog {
+    /// Number the leaves of top-level element `index` of a windowed preview from
+    /// `index * LEAF_STRIDE`: the same whichever elements are drawn, so a selection holds while
+    /// the window moves.
+    fn start_element(&mut self, index: usize) {
+        self.next = index * LEAF_STRIDE;
+    }
+
+    /// Number the next leaf, which shows `text`.
+    fn push(&mut self, text: impl FnOnce() -> String) -> usize {
+        self.push_leaf(false, text)
+    }
+
+    /// Number the next leaf; a `whole` one is copied whole when any of it is selected.
+    fn push_leaf(&mut self, whole: bool, text: impl FnOnce() -> String) -> usize {
+        let leaf = self.next;
+        self.next += 1;
+        let joint = if std::mem::take(&mut self.after_marker) {
+            Joint::Inline
+        } else {
+            self.joint.take().unwrap_or(if self.depth > 0 {
+                Joint::Line
+            } else {
+                Joint::Paragraph
+            })
+        };
+        if self.record {
+            self.numbers.push(leaf);
+            self.leaves.push(Leaf {
+                text: text(),
+                joint,
+                whole,
+            });
+        }
+        leaf
+    }
+
+    /// Number a list marker, copied as `copied`; the item's text follows on its line.
+    fn push_marker(&mut self, copied: String) -> usize {
+        self.after_marker = false;
+        let leaf = self.push_leaf(true, || copied);
+        self.after_marker = true;
+        leaf
+    }
+}
+
+/// See [`PreviewViewer::lines`].
+struct Lines<'v>(&'v RefCell<LeafLog>);
+
+impl Drop for Lines<'_> {
+    fn drop(&mut self) {
+        let mut log = self.0.borrow_mut();
+        log.depth -= 1;
+        // An item without text: its marker joins nothing after the list
+        log.after_marker = false;
+    }
+}
+
+impl<'a> PreviewViewer<'a> {
+    /// Top-level element `index` of a windowed preview is drawn next.
+    pub fn start_element(&self, index: usize) {
+        self.leaves.borrow_mut().start_element(index);
+    }
+
+    /// A run of text the mouse can select, the next leaf of the preview.
+    fn leaf(
+        &self,
+        spans: impl AsRef<[iced::widget::text::Span<'a, Uri>]> + 'a,
+        size: iced::Pixels,
+        font: Option<Font>,
+    ) -> Element<'a, AppMessage> {
+        let leaf = self.leaves.borrow_mut().push(|| {
+            spans
+                .as_ref()
+                .iter()
+                .map(|span| span.text.as_ref())
+                .collect()
+        });
+        let entity = self.entity;
+        let text = SelectableRich::new(spans)
+            .size(size)
+            .on_link_click(Self::on_link_click)
+            .background(self.background())
+            .selectable(leaf, self.selection, move |action| {
+                Message::Select(entity, action).into()
+            });
+        match font {
+            Some(font) => text.font(font).into(),
+            None => text.into(),
+        }
+    }
+
+    /// A list marker drawn as `shown` and copied as `copied` ("•" as "- "), selectable as a leaf.
+    fn marker(&self, shown: String, copied: String, size: iced::Pixels) -> Element<'a, AppMessage> {
+        let leaf = self.leaves.borrow_mut().push_marker(copied);
+        let entity = self.entity;
+        SelectableRich::new(vec![iced::widget::span(shown)])
+            .size(size)
+            .on_link_click(Self::on_link_click)
+            .background(self.background())
+            .selectable(leaf, self.selection, move |action| {
+                Message::Select(entity, action).into()
+            })
+            .into()
+    }
+
+    /// What leaves are drawn on: the page, or a code block's surface.
+    fn background(&self) -> Color {
+        let cosmic = theme::active();
+        let cosmic = cosmic.cosmic();
+        Color::from(if self.leaves.borrow().surface {
+            cosmic.bg_component_color()
+        } else {
+            cosmic.bg_color()
+        })
+    }
+
+    /// A task checkbox: copied as "- [ ] " or "- [x] ", drawn by the checkbox itself.
+    fn task_marker(&self, done: bool, size: iced::Pixels) -> Element<'a, AppMessage> {
+        self.leaves
+            .borrow_mut()
+            .push_marker(if done { "- [x] " } else { "- [ ] " }.to_string());
+        widget::container(iced::widget::checkbox(done).size(size))
+            .center_y(iced::widget::text::LineHeight::default().to_absolute(size))
+            .into()
+    }
+
+    /// The next leaf joins the one before with `joint`.
+    fn joint(&self, joint: Joint) {
+        self.leaves.borrow_mut().joint = Some(joint);
+    }
+
+    /// Until the guard drops, leaves after the first go on their own lines: list items, code
+    /// lines.
+    fn lines(&self) -> Lines<'_> {
+        let mut log = self.leaves.borrow_mut();
+        if log.depth == 0 {
+            log.joint.get_or_insert(Joint::Paragraph);
+        }
+        log.depth += 1;
+        Lines(&self.leaves)
+    }
+
+    /// Cell `index` of a table of `columns` columns, counted by rows from the header; an empty
+    /// cell still counts, so the copied cells stay in their columns.
+    fn cell<R>(&self, index: usize, columns: usize, draw: impl FnOnce() -> R) -> R {
+        self.leaves.borrow_mut().joint = Some(if index == 0 {
+            Joint::Paragraph
+        } else if index.is_multiple_of(columns.max(1)) {
+            Joint::Line
+        } else {
+            Joint::Tab
+        });
+        let drawn = draw();
+        let mut log = self.leaves.borrow_mut();
+        if log.joint.is_some() {
+            log.push(String::new);
+        }
+        drawn
+    }
+}
+
+impl<'a> Viewer<'a, AppMessage, theme::Theme, cosmic::Renderer> for PreviewViewer<'a> {
+    fn on_link_click(url: Uri) -> AppMessage {
+        Message::LinkClicked(url).into()
+    }
+
+    fn heading(
+        &self,
+        settings: Settings,
+        level: &'a pulldown_cmark::HeadingLevel,
+        text: &'a Text,
+        index: usize,
+    ) -> Element<'a, AppMessage> {
+        use pulldown_cmark::HeadingLevel;
+        let size = match level {
+            HeadingLevel::H1 => settings.h1_size,
+            HeadingLevel::H2 => settings.h2_size,
+            HeadingLevel::H3 => settings.h3_size,
+            HeadingLevel::H4 => settings.h4_size,
+            HeadingLevel::H5 => settings.h5_size,
+            HeadingLevel::H6 => settings.h6_size,
+        };
+        // As the widget draws its headings
+        widget::container(self.leaf(text.spans(settings.style), size, None))
+            .padding(iced::padding::top(if index > 0 {
+                settings.text_size.0 / 2.0
+            } else {
+                0.0
+            }))
+            .into()
+    }
+
+    fn paragraph(&self, settings: Settings, text: &Text) -> Element<'a, AppMessage> {
+        self.leaf(text.spans(settings.style), settings.text_size, None)
+    }
+
+    /// As the widget draws its lists, with the markers selectable and copied.
+    fn unordered_list(
+        &self,
+        settings: Settings,
+        bullets: &'a [markdown::Bullet],
+    ) -> Element<'a, AppMessage> {
+        let _lines = self.lines();
+        let size = settings.text_size;
+        widget::column::with_children(bullets.iter().map(|bullet| {
+            let (marker, items) = match bullet {
+                markdown::Bullet::Point { items } => {
+                    (self.marker("•".into(), "- ".into(), size), items)
+                }
+                markdown::Bullet::Task { items, done } => (self.task_marker(*done, size), items),
+            };
+            widget::row::with_capacity(2)
+                .push(marker)
+                .push(markdown::view_with(items, list_settings(settings), self))
+                .spacing(settings.spacing)
+                .into()
+        }))
+        .spacing(settings.spacing * 0.75)
+        .padding([0.0, settings.spacing.0])
+        .into()
+    }
+
+    fn ordered_list(
+        &self,
+        settings: Settings,
+        start: u64,
+        bullets: &'a [markdown::Bullet],
+    ) -> Element<'a, AppMessage> {
+        let _lines = self.lines();
+        let size = settings.text_size;
+        let digits = (start.saturating_add(bullets.len() as u64).max(1) as f32)
+            .log10()
+            .ceil();
+        widget::column::with_children(bullets.iter().enumerate().map(|(index, bullet)| {
+            let items = match bullet {
+                markdown::Bullet::Point { items } | markdown::Bullet::Task { items, .. } => items,
+            };
+            let number = start.saturating_add(index as u64);
+            let marker =
+                widget::container(self.marker(format!("{number}."), format!("{number}. "), size))
+                    .width(size * ((digits / 2.0).ceil() + 1.0))
+                    .align_x(iced::alignment::Horizontal::Right);
+            widget::row::with_capacity(2)
+                .push(marker)
+                .push(markdown::view_with(items, list_settings(settings), self))
+                .spacing(settings.spacing)
+                .into()
+        }))
+        .spacing(settings.spacing * 0.75)
+        .into()
+    }
+
+    /// As the widget draws its tables, with the cells numbered for copying.
+    fn table(
+        &self,
+        settings: Settings,
+        columns: &'a [markdown::Column],
+        rows: &'a [markdown::Row],
+    ) -> Element<'a, AppMessage> {
+        let count = columns.len();
+        let cells = std::cell::Cell::new(0);
+        let cell = |items: Option<&'a Vec<markdown::Item>>| -> Element<'a, AppMessage> {
+            let index = cells.get();
+            cells.set(index + 1);
+            self.cell(index, count, || match items {
+                Some(items) => markdown::items(self, settings, items),
+                None => widget::text("").into(),
+            })
+        };
+        let table = iced::widget::table(
+            columns.iter().enumerate().map(|(index, column)| {
+                iced::widget::table::column(
+                    cell(Some(&column.header)),
+                    move |row: &'a markdown::Row| cell(row.cells.get(index)),
+                )
+                .align_x(match column.alignment {
+                    pulldown_cmark::Alignment::None | pulldown_cmark::Alignment::Left => {
+                        iced::alignment::Horizontal::Left
+                    }
+                    pulldown_cmark::Alignment::Center => iced::alignment::Horizontal::Center,
+                    pulldown_cmark::Alignment::Right => iced::alignment::Horizontal::Right,
+                })
+            }),
+            rows,
+        )
+        .padding_x(settings.spacing.0)
+        .padding_y(settings.spacing.0 / 2.0)
+        .separator_x(0);
+        widget::scrollable(table)
+            .direction(Direction::Horizontal(Scrollbar::default()))
+            .spacing(settings.spacing.0 / 2.0)
+            .into()
+    }
+
+    fn image(
+        &self,
+        settings: Settings,
+        url: &'a Uri,
+        _title: &'a str,
+        alt: &Text,
+    ) -> Element<'a, AppMessage> {
+        match self.images.get(url) {
+            // Shrink to the content width, never scale up
+            Some(Some(Image::Raster(handle))) => widget::image(handle.clone())
+                .content_fit(ContentFit::ScaleDown)
+                .into(),
+            Some(Some(Image::Vector(handle))) => widget::svg(handle.clone())
+                .width(Length::Shrink)
+                .content_fit(ContentFit::ScaleDown)
+                .into(),
+            // Missing or remote: never fetched, a badge-size chip with the alt text
+            _ => html::chip(
+                rich_text(alt.spans(settings.style))
+                    .size(html::chip_size(settings))
+                    .on_link_click(Self::on_link_click)
+                    .into(),
+            ),
+        }
+    }
+
+    fn code_block(
+        &self,
+        settings: Settings,
+        language: Option<&'a str>,
+        code: &'a str,
+        lines: &'a [Text],
+    ) -> Element<'a, AppMessage> {
+        // A diagram that renders replaces its code; the others stay code blocks
+        if let Some(language) = language
+            && mermaid::is_mermaid(language)
+            && let Some(diagram) = self.diagrams.get(theme::active().cosmic().is_dark, code)
+        {
+            return widget::container(
+                widget::svg(diagram)
+                    .width(Length::Shrink)
+                    .content_fit(ContentFit::ScaleDown),
+            )
+            .center_x(Length::Fill)
+            .into();
+        }
+        let font = settings.style.code_block_font;
+        let coloured = language
+            .zip(crate::SYNTAX_SYSTEM.get())
+            .and_then(|(language, system)| {
+                self.highlights
+                    .get(system, self.syntax_theme, language, code)
+            });
+        let _lines = self.lines();
+        self.leaves.borrow_mut().surface = true;
+        let lines: Vec<Element<'a, AppMessage>> = match coloured {
+            Some(coloured) => coloured
+                .iter()
+                .map(|runs| {
+                    let mut spans: Vec<iced::widget::text::Span<'a, Uri>> = runs
+                        .iter()
+                        .map(|(color, text)| iced::widget::span(text.clone()).color(*color))
+                        .collect();
+                    // An empty line still takes a line's height
+                    if spans.is_empty() {
+                        spans.push(iced::widget::span(""));
+                    }
+                    self.leaf(spans, settings.code_size, Some(font))
+                })
+                .collect(),
+            None => {
+                // Spans carry the body font: give them the code font instead
+                let style = markdown::Style {
+                    font,
+                    ..settings.style
+                };
+                lines
+                    .iter()
+                    .map(|line| self.leaf(line.spans(style), settings.code_size, Some(font)))
+                    .collect()
+            }
+        };
+        self.leaves.borrow_mut().surface = false;
+        widget::container(
+            widget::scrollable(
+                widget::container(widget::column::with_children(lines))
+                    .padding(settings.code_size.0),
+            )
+            .direction(Direction::Horizontal(Scrollbar::default())),
+        )
+        .width(Length::Fill)
+        .class(surface_class())
+        .into()
+    }
+}

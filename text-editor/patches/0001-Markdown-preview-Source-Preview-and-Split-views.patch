+/// The length in bytes of the text of `editor`, line endings included, without copying it.
+fn buffer_len(editor: &cosmic_text::ViEditor<'static, 'static>) -> usize {
+    editor.with_buffer(|buffer| {
+        buffer
+            .lines
+            .iter()
+            .map(|line| line.text().len() + line.ending().as_str().len())
+            .sum()
+    })
+}

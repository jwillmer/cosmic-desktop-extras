+// SPDX-License-Identifier: GPL-3.0-only
+
+//! What the iced Markdown widget leaves out of the preview, for GitHub style READMEs: images inside
+//! a paragraph (badge rows), a heading, a list or a table, HTML blocks (`align="center"`, `<img>`,
+//! `<details>`), GFM alerts and footnotes.
+//!
+//! One pass over the pulldown-cmark events splits the document into blocks: plain Markdown goes to
+//! the widget as before, the rest becomes [`Block`]s drawn here. A document with none of these is
+//! handed to the widget whole, with no extra work. HTML is never run: tags are read for layout,
+//! unknown tags are dropped and their text kept, no CSS, no script, and images stay local.
+
+use cosmic::{
+    Element,
+    iced::{
+        Alignment, Color, ContentFit, Length, Pixels,
+        alignment::Horizontal,
+        font::{self, Font},
+        mouse,
+        widget::{
+            scrollable::{Direction, Scrollbar},
+            span,
+            text::Span,
+        },
+    },
+    theme,
+    widget::{
+        self,
+        markdown::{self, Content, Settings, Uri},
+    },
+};
+use pulldown_cmark::{BlockQuoteKind, CowStr, Event, Options, Parser, Tag, TagEnd};
+use std::{
+    collections::{HashMap, HashSet},
+    ops::Range,
+};
+
+use super::{Image, Joint, Message, PreviewViewer, surface_class};
+use crate::Message as AppMessage;
+
+pub(super) const OPTIONS: Options = Options::ENABLE_TABLES
+    .union(Options::ENABLE_STRIKETHROUGH)
+    .union(Options::ENABLE_TASKLISTS)
+    .union(Options::ENABLE_FOOTNOTES)
+    .union(Options::ENABLE_GFM)
+    .union(Options::ENABLE_YAML_STYLE_METADATA_BLOCKS)
+    .union(Options::ENABLE_PLUSES_DELIMITED_METADATA_BLOCKS);
+
+/// A parsed document, ready to draw.
+#[derive(Default)]
+pub struct Document {
+    pub blocks: Vec<Block>,
+    /// Source byte offsets of each block: for plain Markdown one per top-level item when known,
+    /// else where the block starts; empty when unknown (the footnotes).
+    pub starts: Vec<Vec<usize>>,
+    /// Every image link, to load the local ones.
+    pub images: HashSet<Uri>,
+}
+
+/// Whether the top-level items of `content` are drawn one by one, each with its own start: only
+/// when there is a start for each.
+fn split_items(content: &Content, starts: &[usize]) -> bool {
+    !starts.is_empty() && starts.len() == content.items().len()
+}
+
+/// Source byte offset of each element the top level of the preview is drawn as, in order, `None`
+/// when unknown: the elements [`view_document`] measures.
+pub fn anchors(document: &Document) -> Vec<Option<usize>> {
+    let mut anchors = Vec::new();
+    for (block, starts) in document.blocks.iter().zip(&document.starts) {
+        match block {
+            Block::Markdown(content) if split_items(content, starts) => {
+                anchors.extend(starts.iter().copied().map(Some));
+            }
+            _ => anchors.push(starts.first().copied()),
+        }
+    }
+    anchors
+}
+
+pub enum Block {
+    /// Plain Markdown, drawn by the widget.
+    Markdown(Content),
+    /// Text and images flowing in wrapped lines; a heading of that level when set.
+    Inline {
+        pieces: Vec<Piece>,
+        heading: Option<u8>,
+    },
+    Center(Vec<Block>),
+    /// `<details>`: only the summary shows until it is opened.
+    Details {
+        key: DetailsKey,
+        summary: Vec<Piece>,
+        body: Vec<Block>,
+    },
+    Alert(BlockQuoteKind, Vec<Block>),
+    /// A list with images in it; numbered from `start` when set.
+    List {
+        start: Option<u64>,
+        items: Vec<ListItem>,
+    },
+    /// A table with images in it: cells by row, then by column.
+    Table {
+        alignments: Vec<pulldown_cmark::Alignment>,
+        header: Vec<Vec<Piece>>,
+        rows: Vec<Vec<Vec<Piece>>>,
+    },
+    /// Footnote bodies by number, at the end of the document.
+    Footnotes(Vec<(usize, Vec<Block>)>),
+}
+
+pub struct ListItem {
+    /// A task list item, checked or not.
+    pub task: Option<bool>,
+    pub blocks: Vec<Block>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Style {
+    pub strong: bool,
+    pub emphasis: bool,
+    pub code: bool,
+    pub strikethrough: bool,
+    pub link: Option<Uri>,
+}
+
+#[derive(Debug, PartialEq)]
+pub enum Piece {
+    Text(String, Style),
+    Image(Picture),
+    Break,
+}
+
+#[derive(Debug, Default, PartialEq)]
+pub struct Picture {
+    pub url: Uri,
+    pub alt: String,
+    /// A click goes to this link, through the same rules as a text link.
+    pub link: Option<Uri>,
+    pub width: Option<f32>,
+    pub height: Option<f32>,
+}
+
+/// Which `<details>` it is, so its open state stays with it when blocks are added or removed
+/// above: the heading it sits under, the text of its summary, a hash of its source and, only for
+/// blocks that are the same in all of these, how many come before it. A `<details>` added above
+/// does not move the open state unless it is a copy; editing the block closes it.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct DetailsKey {
+    /// Text of the nearest Markdown heading above, empty above the first.
+    pub heading: String,
+    pub summary: String,
+    /// Hash of the block's source, from `<details>` to `</details>`.
+    pub body: u64,
+    pub occurrence: usize,
+}
+
+/// Parse `text` for the preview.
+pub fn parse(text: &str) -> Document {
+    if !needs_pass(text) {
+        if text.len() <= CHUNK_BYTES {
+            let content = Content::parse(text);
+            return Document {
+                images: content.images().clone(),
+                blocks: vec![Block::Markdown(content)],
+                starts: vec![item_starts(text)],
+            };
+        }
+        return parse_chunked(text);
+    }
+    let mut pass = Pass::new(text);
+    let (mut blocks, mut starts) = pass.blocks_with_starts(text);
+    if !pass.footnotes.is_empty() {
+        pass.footnotes.sort_by_key(|(number, _)| *number);
+        blocks.push(Block::Footnotes(std::mem::take(&mut pass.footnotes)));
+        starts.push(Vec::new());
+    }
+    Document {
+        blocks,
+        starts,
+        images: pass.images,
+    }
+}
+
+/// Plain Markdown longer than this goes to the widget in parts of about this size, split where a
+/// top-level item starts. The widget copies the rest of its input after each top-level item, so
+/// one parse of the whole text takes time and memory by the square of its length: a 5 MB file
+/// took minutes.
+const CHUNK_BYTES: usize = 32 * 1024;
+
+/// Ranges of `text` of about `max` bytes, split only where an item in `starts` begins; the
+/// first starts at 0 and the last ends at the end of `text`.
+fn chunk_ranges(text: &str, starts: &[usize], max: usize) -> Vec<Range<usize>> {
+    let mut ranges = Vec::new();
+    let mut from = 0;
+    for &start in starts {
+        if start - from >= max && may_split_at(text, start) {
+            ranges.push(from..start);
+            from = start;
+        }
+    }
+    ranges.push(from..text.len());
+    ranges
+}
+
+/// Whether a part may start at `start`: not at a `---` or `+++` line, which would read as front
+/// matter at the start of a part.
+fn may_split_at(text: &str, start: usize) -> bool {
+    !text[start..].starts_with("---") && !text[start..].starts_with("+++")
+}
+
+/// Parse plain Markdown (no HTML, images, footnotes or alerts) in parts, each its own block of
+/// items, drawn the same as one block.
+fn parse_chunked(text: &str) -> Document {
+    let starts = item_starts(text);
+    // Reference links resolve against the definitions anywhere in the document
+    let references = if text.contains("]:") {
+        Pass::new(text).reference_source
+    } else {
+        String::new()
+    };
+    let mut document = Document::default();
+    let mut item = 0;
+    for range in chunk_ranges(text, &starts, CHUNK_BYTES) {
+        let chunk = &text[range.clone()];
+        let content = if references.is_empty() || !chunk.contains('[') {
+            Content::parse(chunk)
+        } else {
+            Content::parse(&format!("{chunk}\n\n{references}"))
+        };
+        let first = item;
+        while item < starts.len() && starts[item] < range.end {
+            item += 1;
+        }
+        document.images.extend(content.images().iter().cloned());
+        document.blocks.push(Block::Markdown(content));
+        document.starts.push(starts[first..item].to_vec());
+    }
+    document
+}
+
+/// Where each top-level block the widget draws as an item starts in `text`.
+fn item_starts(text: &str) -> Vec<usize> {
+    let mut starts = Vec::new();
+    let mut depth = 0usize;
+    for (event, range) in Parser::new_ext(text, OPTIONS).into_offset_iter() {
+        match event {
+            Event::Start(tag) => {
+                if depth == 0 && makes_item(&tag) {
+                    starts.push(range.start);
+                }
+                depth += 1;
+            }
+            Event::End(_) => depth = depth.saturating_sub(1),
+            Event::Rule if depth == 0 => starts.push(range.start),
+            _ => {}
+        }
+    }
+    starts
+}
+
+/// Whether a top-level block is drawn by the widget as an item of its own.
+fn makes_item(tag: &Tag) -> bool {
+    !matches!(
+        tag,
+        Tag::HtmlBlock | Tag::MetadataBlock(_) | Tag::FootnoteDefinition(_)
+    )
+}
+
+/// Only documents with HTML, images, footnotes or alerts need more than the widget.
+fn needs_pass(text: &str) -> bool {
+    text.contains('<') || text.contains("![") || text.contains("[^") || text.contains("[!")
+}
+
+/// State shared by the document and the nested parts (alert and footnote bodies).
+struct Pass {
+    /// Link reference definitions by lower case label, for links in nested parts.
+    references: HashMap<String, String>,
+    /// The definitions' source, appended to Markdown chunks so their reference links resolve.
+    reference_source: String,
+    footnote_numbers: HashMap<String, usize>,
+    footnotes: Vec<(usize, Vec<Block>)>,
+    /// `<details>` read so far by heading, summary text and source hash.
+    details: HashMap<(String, String, u64), usize>,
+    /// Text of the last Markdown heading read.
+    heading: String,
+    images: HashSet<Uri>,
+}
+
+struct Frame {
+    /// The HTML tag that opened it, closed by the matching end tag; empty for the root.
+    tag: String,
+    kind: FrameKind,
+    /// Source offset where it was opened.
+    start: usize,
+    blocks: Vec<Block>,
+    /// Source offsets of `blocks`, see [`Document::starts`].
+    starts: Vec<Vec<usize>>,
+    pieces: Vec<Piece>,
+}
+
+enum FrameKind {
+    Root,
+    Plain,
+    Center,
+    Details {
+        /// The heading it sits under, when it was opened.
+        heading: String,
+        summary: Vec<Piece>,
+        in_summary: bool,
+    },
+}
+
+impl Frame {
+    fn new(tag: &str, kind: FrameKind, start: usize) -> Self {
+        Self {
+            tag: tag.to_string(),
+            kind,
+            start,
+            blocks: Vec::new(),
+            starts: Vec::new(),
+            pieces: Vec::new(),
+        }
+    }
+}
+
+/// The blocks of one part of the document.
+struct Builder<'p> {
+    pass: &'p mut Pass,
+    /// The text being read.
+    source: &'p str,
+    frames: Vec<Frame>,
+    /// Inline style from HTML tags (`<b>`, `<a href>`) and Markdown emphasis.
+    style: Style,
+    heading: Option<u8>,
+    in_image: bool,
+    /// Source range of the plain Markdown not handed to the widget yet.
+    chunk: Option<Range<usize>>,
+    /// Where each item of the chunk starts.
+    chunk_starts: Vec<usize>,
+    /// Source range of the top-level event being read.
+    at: usize,
+    at_end: usize,
+    /// Source offset of the event the pending pieces started in, when that was an earlier one.
+    pieces_at: Option<usize>,
+    /// Text replaced inside the chunk: footnote markers, `<br/>` spellings.
+    replacements: Vec<(Range<usize>, String)>,
+}
+
+impl Pass {
+    fn new(text: &str) -> Self {
+        let parser = Parser::new_ext(text, OPTIONS);
+        let mut references = HashMap::new();
+        let mut reference_source = String::new();
+        for (label, definition) in parser.reference_definitions().iter() {
+            references.insert(label.to_lowercase(), definition.dest.to_string());
+            reference_source.push_str(&text[definition.span.clone()]);
+            reference_source.push('\n');
+        }
+        Self {
+            references,
+            reference_source,
+            footnote_numbers: HashMap::new(),
+            footnotes: Vec::new(),
+            details: HashMap::new(),
+            heading: String::new(),
+            images: HashSet::new(),
+        }
+    }
+
+    /// The key of the next `<details>` with this summary and `source` under `heading`.
+    fn details_key(&mut self, heading: String, summary: &[Piece], source: &str) -> DetailsKey {
+        let summary = summary_text(summary);
+        let mut hasher = std::hash::DefaultHasher::new();
+        std::hash::Hash::hash(source, &mut hasher);
+        let body = std::hash::Hasher::finish(&hasher);
+        let count = self
+            .details
+            .entry((heading.clone(), summary.clone(), body))
+            .or_default();
+        let occurrence = *count;
+        *count += 1;
+        DetailsKey {
+            heading,
+            summary,
+            body,
+            occurrence,
+        }
+    }
+
+    fn footnote_number(&mut self, label: &str) -> usize {
+        let next = self.footnote_numbers.len() + 1;
+        *self
+            .footnote_numbers
+            .entry(label.to_lowercase())
+            .or_insert(next)
+    }
+
+    fn blocks(&mut self, text: &str) -> Vec<Block> {
+        self.blocks_with_starts(text).0
+    }
+
+    /// The blocks of `text` and their source offsets, see [`Document::starts`].
+    fn blocks_with_starts(&mut self, text: &str) -> (Vec<Block>, Vec<Vec<usize>>) {
+        let references = std::mem::take(&mut self.references);
+        let events: Vec<(Event, Range<usize>)> = Parser::new_with_broken_link_callback(
+            text,
+            OPTIONS,
+            Some(|link: pulldown_cmark::BrokenLink| {
+                references
+                    .get(&link.reference.to_lowercase())
+                    .map(|dest| (CowStr::from(dest.clone()), CowStr::from("")))
+            }),
+        )
+        .into_offset_iter()
+        .collect();
+        // Back before the nested parts (alert and footnote bodies) are parsed: they need it too
+        self.references = references;
+        let mut builder = Builder {
+            pass: self,
+            source: text,
+            frames: vec![Frame::new("", FrameKind::Root, 0)],
+            style: Style::default(),
+            heading: None,
+            in_image: false,
+            chunk: None,
+            chunk_starts: Vec::new(),
+            at: 0,
+            at_end: 0,
+            pieces_at: None,
+            replacements: Vec::new(),
+        };
+        builder.events(text, &events);
+        builder.finish(text)
+    }
+}
+
+/// Index of the event that ends the one at `start`.
+fn end_of(events: &[(Event, Range<usize>)], start: usize) -> usize {
+    let mut depth = 0usize;
+    for (index, (event, _)) in events.iter().enumerate().skip(start) {
+        match event {
+            Event::Start(_) => depth += 1,
+            Event::End(_) => depth = depth.saturating_sub(1),
+            _ => {}
+        }
+        if depth == 0 {
+            return index;
+        }
+    }
+    events.len() - 1
+}
+
+/// The text of a heading's events, white space collapsed.
+fn heading_text(events: &[(Event, Range<usize>)]) -> String {
+    let text: String = events
+        .iter()
+        .filter_map(|(event, _)| match event {
+            Event::Text(text) | Event::Code(text) => Some(text.as_ref()),
+            _ => None,
+        })
+        .collect();
+    collapse(&text).trim().to_string()
+}
+
+/// Whether the events hold a Markdown image or an `<img>` tag.
+fn has_image(events: &[(Event, Range<usize>)]) -> bool {
+    events.iter().any(|(event, _)| match event {
+        Event::Start(Tag::Image { .. }) => true,
+        Event::InlineHtml(html) | Event::Html(html) => is_tag(html, "img"),
+        _ => false,
+    })
+}
+
+/// The Markdown of a list item whose content starts at `start`, continuation lines unindented by
+/// up to `indent` spaces.
+fn item_body(text: &str, item: Range<usize>, start: usize, indent: usize) -> String {
+    text[start.clamp(item.start, item.end)..item.end]
+        .lines()
+        .enumerate()
+        .map(|(index, line)| {
+            if index == 0 {
+                line.trim_start()
+            } else {
+                let spaces = line.len() - line.trim_start_matches(' ').len();
+                &line[spaces.min(indent)..]
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn is_tag(html: &str, name: &str) -> bool {
+    html.get(1..=name.len())
+        .is_some_and(|tag| tag.eq_ignore_ascii_case(name))
+        && html[name.len() + 1..].starts_with(|c: char| c.is_whitespace() || c == '>' || c == '/')
+}
+
+impl Builder<'_> {
+    fn events(&mut self, text: &str, events: &[(Event, Range<usize>)]) {
+        let mut index = 0;
+        while index < events.len() {
+            let end = end_of(events, index);
+            let (event, range) = &events[index];
+            self.at = range.start;
+            self.at_end = range.end;
+            if let Event::Start(Tag::Heading { .. }) = event {
+                self.pass.heading = heading_text(&events[index..=end]);
+            }
+            match event {
+                Event::Start(Tag::Paragraph) if has_image(&events[index..=end]) => {
+                    self.flush_chunk(text);
+                    for (event, _) in &events[index + 1..end] {
+                        self.inline_event(event);
+                    }
+                    self.flush_pieces();
+                }
+                Event::Start(Tag::Heading { level, .. }) if has_image(&events[index..=end]) => {
+                    self.flush_chunk(text);
+                    self.heading = Some(*level as u8);
+                    for (event, _) in &events[index + 1..end] {
+                        self.inline_event(event);
+                    }
+                    self.flush_pieces();
+                    self.heading = None;
+                }
+                Event::Start(Tag::List(start)) if has_image(&events[index..=end]) => {
+                    self.flush_chunk(text);
+                    let items = self.list_items(text, &events[index + 1..end]);
+                    self.push_block(Block::List {
+                        start: *start,
+                        items,
+                    });
+                }
+                Event::Start(Tag::Table(alignments)) if has_image(&events[index..=end]) => {
+                    self.flush_chunk(text);
+                    let (header, rows) = self.table(&events[index + 1..end]);
+                    self.push_block(Block::Table {
+                        alignments: alignments.clone(),
+                        header,
+                        rows,
+                    });
+                }
+                Event::Start(Tag::HtmlBlock) => {
+                    self.flush_chunk(text);
+                    let html: String = events[index..=end]
+                        .iter()
+                        .filter_map(|(event, _)| match event {
+                            Event::Html(html) => Some(html.as_ref()),
+                            _ => None,
+                        })
+                        .collect();
+                    self.html(&html);
+                }
+                Event::Start(Tag::BlockQuote(Some(kind))) => {
+                    self.flush_chunk(text);
+                    let body = self.pass.blocks(&alert_body(&text[range.clone()]));
+                    self.push_block(Block::Alert(*kind, body));
+                }
+                Event::Start(Tag::FootnoteDefinition(label)) => {
+                    self.flush_chunk(text);
+                    let number = self.pass.footnote_number(label);
+                    let body = self.pass.blocks(&footnote_body(&text[range.clone()]));
+                    self.pass.footnotes.push((number, body));
+                }
+                Event::Start(Tag::MetadataBlock(_)) => self.flush_chunk(text),
+                _ => {
+                    self.flush_pieces();
+                    // A long run of plain Markdown goes to the widget in parts, see CHUNK_BYTES
+                    if self
+                        .chunk
+                        .as_ref()
+                        .is_some_and(|chunk| chunk.len() >= CHUNK_BYTES)
+                        && !matches!(event, Event::Start(tag) if !makes_item(tag))
+                        && may_split_at(text, range.start)
+                    {
+                        self.flush_chunk(text);
+                    }
+                    let chunk = self.chunk.get_or_insert(range.clone());
+                    chunk.end = range.end;
+                    if !matches!(event, Event::Start(tag) if !makes_item(tag)) {
+                        self.chunk_starts.push(range.start);
+                    }
+                    for (event, range) in &events[index..=end] {
+                        match event {
+                            Event::FootnoteReference(label) => {
+                                let marker = superscript(self.pass.footnote_number(label));
+                                self.replacements.push((range.clone(), marker));
+                            }
+                            Event::InlineHtml(html) if is_tag(html, "br") => {
+                                self.replacements.push((range.clone(), "<br>".to_string()));
+                            }
+                            _ => {}
+                        }
+                    }
+                }
+            }
+            // Text and images still pending started here, not where they will be flushed
+            if self.pieces_at.is_none() && !self.top().pieces.is_empty() {
+                self.pieces_at = Some(range.start);
+            }
+            index = end + 1;
+        }
+    }
+
+    /// One event inside a paragraph drawn here.
+    fn inline_event(&mut self, event: &Event) {
+        // Text inside an image is its alt text
+        if self.in_image {
+            match event {
+                Event::Text(text) | Event::Code(text) => {
+                    if let Some(Piece::Image(picture)) = self.top().pieces.last_mut() {
+                        picture.alt.push_str(text);
+                    }
+                }
+                Event::End(TagEnd::Image) => self.in_image = false,
+                _ => {}
+            }
+            return;
+        }
+        match event {
+            Event::Text(text) => self.text(text, false),
+            Event::Code(code) => {
+                let style = Style {
+                    code: true,
+                    ..self.style.clone()
+                };
+                self.top().pieces.push(Piece::Text(code.to_string(), style));
+            }
+            Event::SoftBreak => self.text(" ", false),
+            Event::HardBreak => self.top().pieces.push(Piece::Break),
+            Event::FootnoteReference(label) => {
+                let marker = superscript(self.pass.footnote_number(label));
+                self.text(&marker, false);
+            }
+            Event::InlineHtml(html) | Event::Html(html) => self.html(html),
+            Event::Start(Tag::Emphasis) => self.style.emphasis = true,
+            Event::End(TagEnd::Emphasis) => self.style.emphasis = false,
+            Event::Start(Tag::Strong) => self.style.strong = true,
+            Event::End(TagEnd::Strong) => self.style.strong = false,
+            Event::Start(Tag::Strikethrough) => self.style.strikethrough = true,
+            Event::End(TagEnd::Strikethrough) => self.style.strikethrough = false,
+            Event::Start(Tag::Link { dest_url, .. }) => {
+                self.style.link = Some(dest_url.to_string());
+            }
+            Event::End(TagEnd::Link) => self.style.link = None,
+            Event::Start(Tag::Image { dest_url, .. }) => {
+                let picture = Picture {
+                    url: dest_url.to_string(),
+                    link: self.style.link.clone(),
+                    ..Picture::default()
+                };
+                self.image(picture);
+                self.in_image = true;
+            }
+            _ => {}
+        }
+    }
+
+    /// The items of a list, each parsed again as a document of its own.
+    fn list_items(&mut self, text: &str, events: &[(Event, Range<usize>)]) -> Vec<ListItem> {
+        let mut items = Vec::new();
+        let mut index = 0;
+        while index < events.len() {
+            let end = end_of(events, index);
+            if let (Event::Start(Tag::Item), item) = &events[index] {
+                let first = (index + 1 < end).then(|| &events[index + 1]);
+                // Continuation lines are indented to where the content of the first line starts
+                let content = first.map_or(item.end, |(_, range)| range.start);
+                let line_start = text[..item.start].rfind('\n').map_or(0, |at| at + 1);
+                let indent = content.saturating_sub(line_start);
+                let (task, start) = match first {
+                    Some((Event::TaskListMarker(done), marker)) => (Some(*done), marker.end),
+                    _ => (None, content),
+                };
+                let body = item_body(text, item.clone(), start, indent);
+                items.push(ListItem {
+                    task,
+                    blocks: self.pass.blocks(&body),
+                });
+            }
+            index = end + 1;
+        }
+        items
+    }
+
+    /// The header cells and the rows of a table.
+    #[allow(clippy::type_complexity)]
+    fn table(
+        &mut self,
+        events: &[(Event, Range<usize>)],
+    ) -> (Vec<Vec<Piece>>, Vec<Vec<Vec<Piece>>>) {
+        let mut header = Vec::new();
+        let mut rows: Vec<Vec<Vec<Piece>>> = Vec::new();
+        let mut in_header = false;
+        let mut index = 0;
+        while index < events.len() {
+            match &events[index].0 {
+                Event::Start(Tag::TableHead) => in_header = true,
+                Event::End(TagEnd::TableHead) => in_header = false,
+                Event::Start(Tag::TableRow) => rows.push(Vec::new()),
+                Event::Start(Tag::TableCell) => {
+                    let end = end_of(events, index);
+                    for (event, _) in &events[index + 1..end] {
+                        self.inline_event(event);
+                    }
+                    let cell = std::mem::take(&mut self.top().pieces);
+                    match rows.last_mut() {
+                        Some(row) if !in_header => row.push(cell),
+                        _ => header.push(cell),
+                    }
+                    index = end;
+                }
+                _ => {}
+            }
+            index += 1;
+        }
+        (header, rows)
+    }
+
+    fn top(&mut self) -> &mut Frame {
+        self.frames.last_mut().expect("root frame")
+    }
+
+    fn push_block(&mut self, block: Block) {
+        let at = self.at;
+        self.push_block_at(block, vec![at]);
+    }
+
+    fn push_block_at(&mut self, block: Block, starts: Vec<usize>) {
+        let frame = self.top();
+        frame.blocks.push(block);
+        frame.starts.push(starts);
+    }
+
+    fn image(&mut self, picture: Picture) {
+        self.pass.images.insert(picture.url.clone());
+        self.top().pieces.push(Piece::Image(picture));
+    }
+
+    /// Add text; HTML text has its white space collapsed.
+    fn text(&mut self, text: &str, html: bool) {
+        let text = if html {
+            collapse(text)
+        } else {
+            text.to_string()
+        };
+        if text.is_empty() {
+            return;
+        }
+        let style = self.style.clone();
+        let pieces = &mut self.top().pieces;
+        if text == " " && matches!(pieces.last(), None | Some(Piece::Break)) {
+            return;
+        }
+        match pieces.last_mut() {
+            Some(Piece::Text(last, last_style)) if *last_style == style => last.push_str(&text),
+            _ => pieces.push(Piece::Text(text, style)),
+        }
+    }
+
+    /// End the current run of text and images as a block.
+    fn flush_pieces(&mut self) {
+        let heading = self.heading;
+        let at = self.pieces_at.take().unwrap_or(self.at);
+        let frame = self.top();
+        let mut pieces = std::mem::take(&mut frame.pieces);
+        while matches!(pieces.last(), Some(Piece::Break)) || is_blank(pieces.last()) {
+            pieces.pop();
+        }
+        if pieces.is_empty() {
+            return;
+        }
+        // HTML white space at the edges of a line does not show
+        if let Some(Piece::Text(text, _)) = pieces.last_mut() {
+            text.truncate(text.trim_end().len());
+        }
+        if let Some(Piece::Text(text, _)) = pieces.first_mut()
+            && text.starts_with(' ')
+        {
+            text.remove(0);
+        }
+        if let FrameKind::Details {
+            summary,
+            in_summary: true,
+            ..
+        } = &mut frame.kind
+        {
+            summary.extend(pieces);
+        } else {
+            frame.blocks.push(Block::Inline { pieces, heading });
+            frame.starts.push(vec![at]);
+        }
+    }
+
+    /// Hand the pending Markdown to the widget.
+    fn flush_chunk(&mut self, text: &str) {
+        let Some(range) = self.chunk.take() else {
+            return;
+        };
+        let mut markdown = String::with_capacity(range.len());
+        let mut at = range.start;
+        for (replaced, with) in self.replacements.drain(..) {
+            markdown.push_str(&text[at..replaced.start]);
+            markdown.push_str(&with);
+            at = replaced.end;
+        }
+        markdown.push_str(&text[at..range.end]);
+        if !self.pass.reference_source.is_empty() && markdown.contains('[') {
+            markdown.push_str("\n\n");
+            markdown.push_str(&self.pass.reference_source);
+        }
+        let content = Content::parse(&markdown);
+        self.pass.images.extend(content.images().iter().cloned());
+        let starts = std::mem::take(&mut self.chunk_starts);
+        self.push_block_at(Block::Markdown(content), starts);
+    }
+
+    fn finish(mut self, text: &str) -> (Vec<Block>, Vec<Vec<usize>>) {
+        self.flush_chunk(text);
+        while self.frames.len() > 1 {
+            self.close_frame();
+        }
+        self.flush_pieces();
+        self.frames
+            .pop()
+            .map(|frame| (frame.blocks, frame.starts))
+            .unwrap_or_default()
+    }
+
+    /// Close the innermost HTML element and add it to its parent.
+    fn close_frame(&mut self) {
+        self.flush_pieces();
+        let Some(frame) = self.frames.pop() else {
+            return;
+        };
+        match frame.kind {
+            FrameKind::Root => self.frames.push(frame),
+            FrameKind::Plain => {
+                let top = self.top();
+                top.blocks.extend(frame.blocks);
+                top.starts.extend(frame.starts);
+            }
+            FrameKind::Center => self.push_block_at(Block::Center(frame.blocks), vec![frame.start]),
+            FrameKind::Details {
+                heading, summary, ..
+            } => {
+                let source = self
+                    .source
+                    .get(frame.start..self.at_end.max(frame.start))
+                    .unwrap_or_default();
+                let key = self.pass.details_key(heading, &summary, source);
+                let block = Block::Details {
+                    key,
+                    summary,
+                    body: frame.blocks,
+                };
+                self.push_block_at(block, vec![frame.start]);
+            }
+        }
+    }
+
+    fn open_frame(&mut self, tag: &str, kind: FrameKind) {
+        self.flush_pieces();
+        let at = self.at;
+        self.frames.push(Frame::new(tag, kind, at));
+    }
+
+    /// Read HTML for layout: known tags shape the blocks, the others are dropped, text is kept.
+    fn html(&mut self, html: &str) {
+        let mut rest = html;
+        while !rest.is_empty() {
+            if let Some(comment) = rest.strip_prefix("<!--") {
+                rest = comment.find("-->").map_or("", |end| &comment[end + 3..]);
+                continue;
+            }
+            if rest.starts_with('<')
+                && rest[1..].starts_with(|c: char| c.is_ascii_alphabetic() || c == '/')
+                && let Some(end) = rest.find('>')
+            {
+                self.html_tag(&HtmlTag::parse(&rest[1..end]));
+                rest = &rest[end + 1..];
+                continue;
+            }
+            let first = rest.chars().next().map_or(1, char::len_utf8);
+            let next = rest[first..]
+                .find('<')
+                .map_or(rest.len(), |next| next + first);
+            self.text(&decode_entities(&rest[..next]), true);
+            rest = &rest[next..];
+        }
+    }
+
+    fn html_tag(&mut self, tag: &HtmlTag) {
+        let name = tag.name.as_str();
+        match (name, tag.closing) {
+            ("p" | "div" | "center" | "section" | "article" | "header" | "footer", false) => {
+                let center = name == "center" || tag.centered();
+                self.open_frame(
+                    name,
+                    if center {
+                        FrameKind::Center
+                    } else {
+                        FrameKind::Plain
+                    },
+                );
+            }
+            ("details", false) => {
+                self.open_frame(
+                    name,
+                    FrameKind::Details {
+                        heading: self.pass.heading.clone(),
+                        summary: Vec::new(),
+                        in_summary: false,
+                    },
+                );
+            }
+            ("summary", closing) => {
+                self.flush_pieces();
+                if let FrameKind::Details { in_summary, .. } = &mut self.top().kind {
+                    *in_summary = !closing;
+                }
+            }
+            (_, true) if self.frames.iter().skip(1).any(|frame| frame.tag == name) => {
+                while self.frames.last().is_some_and(|frame| frame.tag != name) {
+                    self.close_frame();
+                }
+                self.close_frame();
+                // A centred heading is a frame of its own
+                if is_heading(name) {
+                    self.heading = None;
+                }
+            }
+            (name, closing) if is_heading(name) => {
+                if !closing && tag.centered() {
+                    self.open_frame(name, FrameKind::Center);
+                } else {
+                    self.flush_pieces();
+                }
+                self.heading = (!closing).then(|| name.as_bytes()[1] - b'0');
+            }
+            ("img", false) => {
+                if let Some(src) = tag.attribute("src").filter(|src| !src.is_empty()) {
+                    let size = |name| tag.attribute(name).and_then(parse_size);
+                    let picture = Picture {
+                        url: src.to_string(),
+                        alt: tag.attribute("alt").unwrap_or_default().to_string(),
+                        link: self.style.link.clone(),
+                        width: size("width"),
+                        height: size("height"),
+                    };
+                    self.image(picture);
+                }
+            }
+            ("a", closing) => {
+                self.style.link = if closing {
+                    None
+                } else {
+                    tag.attribute("href").map(str::to_string)
+                };
+            }
+            ("br", _) => self.top().pieces.push(Piece::Break),
+            ("b" | "strong", closing) => self.style.strong = !closing,
+            ("i" | "em", closing) => self.style.emphasis = !closing,
+            ("code" | "tt", closing) => self.style.code = !closing,
+            ("s" | "del" | "strike", closing) => self.style.strikethrough = !closing,
+            ("td" | "th", true) => self.text(" ", false),
+            ("tr" | "li" | "ul" | "ol" | "table" | "hr" | "blockquote" | "pre", _) => {
+                self.flush_pieces();
+            }
+            // Anything else (kbd, sub, sup, span, picture, ...) is dropped, its text kept
+            _ => {}
+        }
+    }
+}
+
+struct HtmlTag {
+    name: String,
+    closing: bool,
+    attributes: Vec<(String, String)>,
+}
+
+fn is_heading(name: &str) -> bool {
+    matches!(name, "h1" | "h2" | "h3" | "h4" | "h5" | "h6")
+}
+
+impl HtmlTag {
+    /// `align="center"`, as old READMEs centre a logo or a title.
+    fn centered(&self) -> bool {
+        self.attribute("align")
+            .is_some_and(|align| align.eq_ignore_ascii_case("center"))
+    }
+
+    /// Parse the inside of `<...>`.
+    fn parse(inner: &str) -> Self {
+        let inner = inner.trim().trim_end_matches('/');
+        let (closing, inner) = match inner.strip_prefix('/') {
+            Some(inner) => (true, inner),
+            None => (false, inner),
+        };
+        let name_end = inner
+            .find(|c: char| c.is_whitespace() || c == '/')
+            .unwrap_or(inner.len());
+        let mut attributes = Vec::new();
+        let mut rest = inner[name_end..].trim_start();
+        while !rest.is_empty() {
+            let key_end = rest
+                .find(|c: char| c.is_whitespace() || c == '=')
+                .unwrap_or(rest.len());
+            let key = rest[..key_end].to_ascii_lowercase();
+            rest = rest[key_end..].trim_start();
+            let mut value = String::new();
+            if let Some(after) = rest.strip_prefix('=') {
+                let after = after.trim_start();
+                let (raw, next) = match after.chars().next() {
+                    Some(quote @ ('"' | '\'')) => {
+                        let body = &after[1..];
+                        let end = body.find(quote).unwrap_or(body.len());
+                        (&body[..end], body.get(end + 1..).unwrap_or(""))
+                    }
+                    _ => {
+                        let end = after.find(char::is_whitespace).unwrap_or(after.len());
+                        (&after[..end], &after[end..])
+                    }
+                };
+                value = decode_entities(raw);
+                rest = next.trim_start();
+            }
+            if key.is_empty() {
+                // Stray character: skip it
+                let first = rest.chars().next().map_or(1, char::len_utf8);
+                rest = rest[first..].trim_start();
+                continue;
+            }
+            attributes.push((key, value));
+        }
+        Self {
+            name: inner[..name_end].to_ascii_lowercase(),
+            closing,
+            attributes,
+        }
+    }
+
+    fn attribute(&self, name: &str) -> Option<&str> {
+        self.attributes
+            .iter()
+            .find(|(key, _)| key == name)
+            .map(|(_, value)| value.as_str())
+    }
+}
+
+/// `96`, `96px`; percentages and other units are ignored.
+fn parse_size(value: &str) -> Option<f32> {
+    let value = value.trim();
+    let value = value.strip_suffix("px").unwrap_or(value);
+    value.parse::<f32>().ok().filter(|size| *size > 0.0)
+}
+
+fn decode_entities(text: &str) -> String {
+    if !text.contains('&') {
+        return text.to_string();
+    }
+    let mut out = String::with_capacity(text.len());
+    let mut rest = text;
+    while let Some(start) = rest.find('&') {
+        out.push_str(&rest[..start]);
+        rest = &rest[start..];
+        let decoded = rest.find(';').filter(|end| *end <= 10).and_then(|end| {
+            let entity = &rest[1..end];
+            let c = match entity {
+                "amp" => Some('&'),
+                "lt" => Some('<'),
+                "gt" => Some('>'),
+                "quot" => Some('"'),
+                "apos" => Some('\''),
+                "nbsp" => Some('\u{a0}'),
+                _ => entity.strip_prefix('#').and_then(|number| {
+                    match number.strip_prefix(['x', 'X']) {
+                        Some(hex) => u32::from_str_radix(hex, 16).ok(),
+                        None => number.parse().ok(),
+                    }
+                    .and_then(char::from_u32)
+                }),
+            };
+            c.map(|c| (c, end))
+        });
+        match decoded {
+            Some((c, end)) => {
+                out.push(c);
+                rest = &rest[end + 1..];
+            }
+            None => {
+                out.push('&');
+                rest = &rest[1..];
+            }
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+/// HTML white space: runs become one space.
+fn collapse(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut space = false;
+    for c in text.chars() {
+        if c.is_whitespace() && c != '\u{a0}' {
+            space = true;
+        } else {
+            if space {
+                out.push(' ');
+                space = false;
+            }
+            out.push(c);
+        }
+    }
+    if space {
+        out.push(' ');
+    }
+    out
+}
+
+fn is_blank(piece: Option<&Piece>) -> bool {
+    matches!(piece, Some(Piece::Text(text, _)) if text.trim().is_empty())
+}
+
+fn superscript(number: usize) -> String {
+    const DIGITS: [char; 10] = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
+    number
+        .to_string()
+        .bytes()
+        .map(|digit| DIGITS[usize::from(digit - b'0')])
+        .collect()
+}
+
+/// The Markdown inside `> [!NOTE]`: quote markers and the marker line removed.
+fn alert_body(source: &str) -> String {
+    source
+        .lines()
+        .skip(1)
+        .map(|line| {
+            let trimmed = line.trim_start();
+            match trimmed.strip_prefix('>') {
+                Some(rest) => rest.strip_prefix(' ').unwrap_or(rest),
+                // A lazy continuation line
+                None => line,
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+/// The Markdown of `[^label]: text`, continuation lines unindented.
+fn footnote_body(source: &str) -> String {
+    let body = source.split_once("]:").map_or(source, |(_, body)| body);
+    body.lines()
+        .enumerate()
+        .map(|(index, line)| {
+            if index == 0 {
+                line.trim_start()
+            } else {
+                let indent = line.len() - line.trim_start_matches(' ').len();
+                &line[indent.min(4)..]
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn alert_title(kind: BlockQuoteKind) -> &'static str {
+    match kind {
+        BlockQuoteKind::Note => "Note",
+        BlockQuoteKind::Tip => "Tip",
+        BlockQuoteKind::Important => "Important",
+        BlockQuoteKind::Warning => "Warning",
+        BlockQuoteKind::Caution => "Caution",
+    }
+}
+
+fn alert_color(kind: BlockQuoteKind, theme: &theme::Theme) -> Color {
+    let cosmic = theme.cosmic();
+    Color::from(match kind {
+        BlockQuoteKind::Note => cosmic.accent_text_color(),
+        BlockQuoteKind::Tip => cosmic.success_text_color(),
+        BlockQuoteKind::Important => cosmic.palette.accent_purple,
+        BlockQuoteKind::Warning => cosmic.warning_text_color(),
+        BlockQuoteKind::Caution => cosmic.destructive_text_color(),
+    })
+}
+
+/// Add the keys of every `<details>` in `blocks`, nested ones too, to `keys`.
+pub fn details_keys<'a>(blocks: &'a [Block], keys: &mut Vec<&'a DetailsKey>) {
+    for block in blocks {
+        match block {
+            Block::Details { key, body, .. } => {
+                keys.push(key);
+                details_keys(body, keys);
+            }
+            Block::Center(body) | Block::Alert(_, body) => details_keys(body, keys),
+            Block::Footnotes(notes) => {
+                for (_, body) in notes {
+                    details_keys(body, keys);
+                }
+            }
+            Block::List { items, .. } => {
+                for item in items {
+                    details_keys(&item.blocks, keys);
+                }
+            }
+            Block::Markdown(_) | Block::Inline { .. } | Block::Table { .. } => {}
+        }
+    }
+}
+
+/// The `<details>` still open after a parse turned the keys `old` into `new`, both in document
+/// order: those whose key is still there, and those whose source changed (edited while open), by
+/// their place among the blocks with that heading and summary.
+pub fn carry_open(
+    open: &HashSet<DetailsKey>,
+    old: &[DetailsKey],
+    new: &[&DetailsKey],
+) -> HashSet<DetailsKey> {
+    let same = |a: &DetailsKey, b: &DetailsKey| a.heading == b.heading && a.summary == b.summary;
+    let mut kept = HashSet::new();
+    for key in open {
+        if new.contains(&key) {
+            kept.insert(key.clone());
+            continue;
+        }
+        let Some(place) = old
+            .iter()
+            .filter(|other| same(other, key))
+            .position(|other| other == key)
+        else {
+            continue;
+        };
+        // The block now at that place, unless it is another block that was there before
+        if let Some(edited) = new.iter().filter(|other| same(other, key)).nth(place)
+            && !old
+                .iter()
+                .any(|other| same(other, key) && other.body == edited.body)
+        {
+            kept.insert((*edited).clone());
+        }
+    }
+    kept
+}
+
+/// The text of a summary, white space collapsed; images count by their alt text.
+fn summary_text(pieces: &[Piece]) -> String {
+    let mut text = String::new();
+    for piece in pieces {
+        match piece {
+            Piece::Text(value, _) => text.push_str(value),
+            Piece::Image(picture) => text.push_str(&picture.alt),
+            Piece::Break => text.push(' '),
+        }
+    }
+    text.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+/// Draw the document; each top-level element (see [`anchors`]) is wrapped in a container with
+/// the next of `ids`, so its position can be measured. With `window`, only its elements are
+/// drawn, the space of the others kept.
+pub fn view_document<'a>(
+    document: &'a Document,
+    settings: Settings,
+    viewer: &PreviewViewer<'a>,
+    open: &HashSet<DetailsKey>,
+    ids: &[widget::Id],
+    window: Option<Window>,
+) -> Element<'a, AppMessage> {
+    let drawn = window
+        .as_ref()
+        .map_or(0..usize::MAX, |window| window.range.clone());
+    // The leaves of a windowed preview are numbered by element, see `LEAF_STRIDE`
+    let numbered = window.is_some();
+    let mut elements = Vec::new();
+    // Index of the next top-level element
+    let mut at = 0;
+    for (block, starts) in document.blocks.iter().zip(&document.starts) {
+        if at >= drawn.end {
+            break;
+        }
+        match block {
+            Block::Markdown(content) if split_items(content, starts) => {
+                let count = content.items().len();
+                let from = drawn.start.clamp(at, at + count) - at;
+                let to = drawn.end.clamp(at, at + count) - at;
+                // Numbered across blocks: a long document is parsed in parts, and the first
+                // heading of each part keeps the space above it
+                elements.extend(content.items()[from..to].iter().zip(from..to).map(
+                    |(item, index)| {
+                        if numbered {
+                            viewer.start_element(at + index);
+                        }
+                        (
+                            at + index,
+                            markdown::item(viewer, settings, item, at + index),
+                        )
+                    },
+                ));
+                at += count;
+            }
+            _ => {
+                if drawn.contains(&at) {
+                    if numbered {
+                        viewer.start_element(at);
+                    }
+                    elements.push((at, view_block(block, settings, viewer, open)));
+                }
+                at += 1;
+            }
+        }
+    }
+    let elements = elements
+        .into_iter()
+        .map(|(index, element)| match ids.get(index) {
+            Some(id) => widget::container(element).id(id.clone()).into(),
+            None => element,
+        });
+    let Some(window) = window else {
+        return widget::column::with_children(elements)
+            .spacing(settings.spacing)
+            .into();
+    };
+    // The elements not drawn take their estimated space
+    widget::column::with_capacity(3)
+        .push(widget::Space::new().height(Length::Fixed(window.above)))
+        .push(widget::column::with_children(elements).spacing(settings.spacing))
+        .push(widget::Space::new().height(Length::Fixed(window.below)))
+        .into()
+}
+
+/// The top-level elements a long preview draws, see [`view_document`], and the space the ones
+/// above and below them take, in pixels.
+pub struct Window {
+    pub range: Range<usize>,
+    pub above: f32,
+    pub below: f32,
+}
+
+/// Draw the blocks; `open` holds the keys of the opened `<details>`.
+pub fn view<'a>(
+    blocks: &'a [Block],
+    settings: Settings,
+    viewer: &PreviewViewer<'a>,
+    open: &HashSet<DetailsKey>,
+) -> Element<'a, AppMessage> {
+    widget::column::with_children(
+        blocks
+            .iter()
+            .map(|block| view_block(block, settings, viewer, open)),
+    )
+    .spacing(settings.spacing)
+    .into()
+}
+
+fn view_block<'a>(
+    block: &'a Block,
+    settings: Settings,
+    viewer: &PreviewViewer<'a>,
+    open: &HashSet<DetailsKey>,
+) -> Element<'a, AppMessage> {
+    match block {
+        Block::Markdown(content) => markdown::view_with(content.items(), settings, viewer),
+        Block::Inline { pieces, heading } => view_pieces(pieces, *heading, settings, viewer),
+        Block::Center(blocks) => widget::container(
+            widget::column::with_children(
+                blocks
+                    .iter()
+                    .map(|block| view_block(block, settings, viewer, open)),
+            )
+            .spacing(settings.spacing)
+            .align_x(Alignment::Center),
+        )
+        .center_x(Length::Fill)
+        .into(),
+        Block::Details { key, summary, body } => {
+            let is_open = open.contains(key);
+            let icon = if is_open {
+                "pan-down-symbolic"
+            } else {
+                "pan-end-symbolic"
+            };
+            let header = widget::mouse_area(
+                widget::row::with_capacity(2)
+                    .push(widget::icon::from_name(icon).size(16))
+                    .push(view_pieces(summary, None, settings, viewer))
+                    .spacing(4)
+                    .align_y(Alignment::Center),
+            )
+            .on_press(Message::ToggleDetails(key.clone()).into())
+            .interaction(mouse::Interaction::Pointer);
+            let mut column = widget::column::with_capacity(2)
+                .push(header)
+                .spacing(settings.spacing);
+            if is_open {
+                column = column.push(
+                    widget::container(view(body, settings, viewer, open)).padding([
+                        0.0,
+                        0.0,
+                        0.0,
+                        settings.text_size.0,
+                    ]),
+                );
+            }
+            column.into()
+        }
+        Block::Alert(kind, body) => {
+            let color = alert_color(*kind, &theme::active());
+            let bar = widget::container(widget::Space::new().width(4).height(Length::Fill)).class(
+                theme::Container::custom(move |_| widget::container::Style {
+                    background: Some(color.into()),
+                    ..Default::default()
+                }),
+            );
+            let title = viewer.leaf(
+                vec![
+                    span(alert_title(*kind))
+                        .font(Font {
+                            weight: font::Weight::Bold,
+                            ..settings.style.font
+                        })
+                        .color(color),
+                ],
+                settings.text_size,
+                None,
+            );
+            widget::row::with_capacity(2)
+                .push(bar)
+                .push(
+                    widget::column::with_capacity(2)
+                        .push(title)
+                        .push(view(body, settings, viewer, open))
+                        .spacing(settings.spacing.0 / 2.0),
+                )
+                .spacing(settings.text_size.0 * 0.75)
+                .height(Length::Shrink)
+                .into()
+        }
+        Block::List { start, items } => {
+            let _lines = viewer.lines();
+            let inner = Settings {
+                spacing: settings.spacing * 0.6,
+                ..settings
+            };
+            // As the widget draws its lists
+            let digits = (start.unwrap_or(1) + items.len() as u64).max(1) as f32;
+            let number_width = settings.text_size * ((digits.log10().ceil() / 2.0).ceil() + 1.0);
+            widget::column::with_children(items.iter().enumerate().map(
+                |(number, item)| -> Element<'a, AppMessage> {
+                    let marker: Element<'a, AppMessage> = match (item.task, start) {
+                        (Some(done), _) => viewer.task_marker(done, settings.text_size),
+                        (None, Some(start)) => {
+                            let number = start + number as u64;
+                            widget::container(viewer.marker(
+                                format!("{number}."),
+                                format!("{number}. "),
+                                settings.text_size,
+                            ))
+                            .align_x(Horizontal::Right)
+                            .width(number_width)
+                            .into()
+                        }
+                        (None, None) => viewer.marker("•".into(), "- ".into(), settings.text_size),
+                    };
+                    let marker_width = match (item.task, start) {
+                        (None, Some(_)) => number_width,
+                        _ => settings.text_size,
+                    };
+                    let marker = widget::container(marker).width(marker_width);
+                    // Text and images first: the marker is centred on that first line, not
+                    // the top of a tall image; the rest of the item goes below, indented
+                    let (first, rest) = match item.blocks.split_first() {
+                        Some((first @ Block::Inline { .. }, rest)) => (Some(first), rest),
+                        _ => (None, item.blocks.as_slice()),
+                    };
+                    let Some(first) = first else {
+                        return widget::row::with_capacity(2)
+                            .push(marker)
+                            .push(view(rest, inner, viewer, open))
+                            .spacing(settings.spacing)
+                            .into();
+                    };
+                    let first = widget::row::with_capacity(2)
+                        .push(marker)
+                        .push(view_block(first, inner, viewer, open))
+                        .spacing(settings.spacing)
+                        .align_y(Alignment::Center);
+                    if rest.is_empty() {
+                        return first.into();
+                    }
+                    widget::column::with_capacity(2)
+                        .push(first)
+                        .push(widget::container(view(rest, inner, viewer, open)).padding([
+                            0.0,
+                            0.0,
+                            0.0,
+                            marker_width.0 + settings.spacing.0,
+                        ]))
+                        .spacing(inner.spacing)
+                        .into()
+                },
+            ))
+            .spacing(settings.spacing * 0.75)
+            .padding([
+                0.0,
+                if start.is_none() {
+                    settings.spacing.0
+                } else {
+                    0.0
+                },
+            ])
+            .into()
+        }
+        Block::Table {
+            alignments,
+            header,
+            rows,
+        } => {
+            let count = alignments.len();
+            let cells = std::cell::Cell::new(0);
+            let cell = |pieces: Option<&'a Vec<Piece>>| -> Element<'a, AppMessage> {
+                let index = cells.get();
+                cells.set(index + 1);
+                viewer.cell(index, count, || match pieces {
+                    Some(pieces) => view_pieces(pieces, None, settings, viewer),
+                    None => widget::text("").into(),
+                })
+            };
+            let columns = alignments.iter().enumerate().map(|(index, alignment)| {
+                cosmic::iced::widget::table::column(
+                    cell(header.get(index)),
+                    move |row: &'a Vec<Vec<Piece>>| cell(row.get(index)),
+                )
+                .align_x(match alignment {
+                    pulldown_cmark::Alignment::None | pulldown_cmark::Alignment::Left => {
+                        Horizontal::Left
+                    }
+                    pulldown_cmark::Alignment::Center => Horizontal::Center,
+                    pulldown_cmark::Alignment::Right => Horizontal::Right,
+                })
+            });
+            let table = cosmic::iced::widget::table(columns, rows)
+                .padding_x(settings.spacing.0)
+                .padding_y(settings.spacing.0 / 2.0)
+                .separator_x(0);
+            widget::scrollable(table)
+                .direction(Direction::Horizontal(Scrollbar::default()))
+                .into()
+        }
+        Block::Footnotes(notes) => widget::column::with_children(
+            std::iter::once(widget::divider::horizontal::default().into()).chain(notes.iter().map(
+                |(number, body)| -> Element<'a, AppMessage> {
+                    widget::row::with_capacity(2)
+                        .push(widget::text(format!("{number}.")).size(settings.text_size))
+                        .push(view(body, settings, viewer, open))
+                        .spacing(settings.text_size.0 / 2.0)
+                        .into()
+                },
+            )),
+        )
+        .spacing(settings.spacing.0 / 2.0)
+        .into(),
+    }
+}
+
+/// Text and images in lines that wrap: a badge row stays a row.
+fn view_pieces<'a>(
+    pieces: &'a [Piece],
+    heading: Option<u8>,
+    settings: Settings,
+    viewer: &PreviewViewer<'a>,
+) -> Element<'a, AppMessage> {
+    let size = match heading {
+        Some(1) => settings.h1_size,
+        Some(2) => settings.h2_size,
+        Some(3) => settings.h3_size,
+        Some(4) => settings.h4_size,
+        Some(5) => settings.h5_size,
+        Some(_) => settings.h6_size,
+        None => settings.text_size,
+    };
+    let mut first = true;
+    let lines = pieces.split(|piece| *piece == Piece::Break).map(|line| {
+        // A line after a hard break is copied on its own line; one with no text has no leaf
+        let has_text = line.iter().any(|piece| matches!(piece, Piece::Text(..)));
+        if !std::mem::replace(&mut first, false) && has_text {
+            viewer.joint(Joint::Line);
+        }
+        let mut row = widget::row::with_capacity(line.len());
+        let mut spans: Vec<Span<'a, Uri>> = Vec::new();
+        let mut inline = false;
+        for piece in line {
+            match piece {
+                Piece::Text(text, style) => {
+                    spans.push(text_span(text, style, settings.style, heading.is_some()));
+                }
+                Piece::Image(picture) => {
+                    if !spans.is_empty() {
+                        row = row.push(viewer.leaf(std::mem::take(&mut spans), size, None));
+                        // Text after the image goes on in the same line
+                        inline = true;
+                    }
+                    let image = viewer.picture(picture, settings);
+                    row = row.push(match &picture.link {
+                        Some(link) => widget::mouse_area(image)
+                            .on_press(Message::LinkClicked(link.clone()).into())
+                            .interaction(mouse::Interaction::Pointer)
+                            .into(),
+                        None => image,
+                    });
+                }
+                Piece::Break => {}
+            }
+        }
+        if !spans.is_empty() {
+            if inline {
+                viewer.joint(Joint::Inline);
+            }
+            row = row.push(viewer.leaf(spans, size, None));
+        }
+        Element::from(row.spacing(4).align_y(Alignment::Center).wrap())
+    });
+    widget::column::with_children(lines).into()
+}
+
+fn text_span<'a>(
+    text: &'a str,
+    style: &Style,
+    markdown: markdown::Style,
+    bold: bool,
+) -> Span<'a, Uri> {
+    let span = span(text).strikethrough(style.strikethrough);
+    let span = if style.code {
+        span.font(markdown.inline_code_font)
+            .color(markdown.inline_code_color)
+            .background(markdown.inline_code_highlight.background)
+            .border(markdown.inline_code_highlight.border)
+            .padding(markdown.inline_code_padding)
+    } else {
+        span.font(Font {
+            weight: if style.strong || bold {
+                font::Weight::Bold
+            } else {
+                font::Weight::Normal
+            },
+            style: if style.emphasis {
+                font::Style::Italic
+            } else {
+                font::Style::Normal
+            },
+            ..markdown.font
+        })
+    };
+    match &style.link {
+        Some(link) => span.color(markdown.link_color).link(link.clone()),
+        None => span,
+    }
+}
+
+impl<'a> PreviewViewer<'a> {
+    /// A local image at its size (or the size the HTML asks for), scaled down to fit; anything
+    /// else a small chip with the alt text. Remote images are never fetched.
+    pub(super) fn picture(
+        &self,
+        picture: &'a Picture,
+        settings: Settings,
+    ) -> Element<'a, AppMessage> {
+        let width = picture.width.map_or(Length::Shrink, Length::Fixed);
+        let height = picture.height.map_or(Length::Shrink, Length::Fixed);
+        let fit = if picture.width.is_some() || picture.height.is_some() {
+            ContentFit::Contain
+        } else {
+            ContentFit::ScaleDown
+        };
+        match self.images.get(&picture.url) {
+            Some(Some(Image::Raster(handle))) => widget::image(handle.clone())
+                .width(width)
+                .height(height)
+                .content_fit(fit)
+                .into(),
+            Some(Some(Image::Vector(handle))) => widget::svg(handle.clone())
+                .width(width)
+                .height(height)
+                .content_fit(fit)
+                .into(),
+            _ => {
+                let alt = if picture.alt.is_empty() {
+                    picture.url.rsplit('/').next().unwrap_or_default()
+                } else {
+                    picture.alt.as_str()
+                };
+                chip(widget::text(alt).size(chip_size(settings)).into())
+            }
+        }
+    }
+}
+
+/// Text size inside an image placeholder chip: badge size.
+pub(super) fn chip_size(settings: Settings) -> Pixels {
+    Pixels((settings.text_size.0 * 0.8).round())
+}
+
+/// A badge-size placeholder for an image that is not shown.
+pub(super) fn chip<'a>(content: Element<'a, AppMessage>) -> Element<'a, AppMessage> {
+    widget::container(content)
+        .padding([1, 6])
+        .class(surface_class())
+        .into()
+}

@@ -0,0 +1,1372 @@
+//! Rich text in the Markdown preview that the mouse can select, also across paragraphs.
+//!
+//! A port of iced's `rich_text` (spans, colours, fonts, links) that draws a selection. The
+//! selection is not kept in the widget but in the preview, shared by all its text runs
+//! ("leaves", numbered in document order): a drag from one leaf into another selects everything
+//! in between, as in a browser. Only the leaf under the pointer hit-tests.
+
+use cosmic::iced::advanced::layout;
+use cosmic::iced::advanced::mouse::click;
+use cosmic::iced::advanced::renderer;
+use cosmic::iced::advanced::text::{self as core_text, Paragraph, Span};
+use cosmic::iced::advanced::widget::tree::{self, Tree};
+use cosmic::iced::advanced::widget::{Id, Operation};
+use cosmic::iced::advanced::{Clipboard, Layout, Shell, Widget, overlay};
+use cosmic::iced::widget::text::{Alignment, Catalog, LineHeight, Shaping, Wrapping};
+use cosmic::iced::{
+    Color, Element, Event, Length, Pixels, Point, Rectangle, Size, Vector, alignment, keyboard,
+    mouse,
+};
+use std::ops::Range;
+use unicode_segmentation::UnicodeSegmentation;
+
+/// A place in the rendered text: a grapheme boundary in a leaf.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
+pub struct Spot {
+    pub leaf: usize,
+    pub grapheme: usize,
+}
+
+/// The preview's selection, from where the press was to where the pointer is.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Selection {
+    pub anchor: Spot,
+    pub focus: Spot,
+    /// The left button is still down: moving extends the selection.
+    pub dragging: bool,
+}
+
+impl Selection {
+    /// The start and end in document order, whichever way the drag went.
+    pub fn ordered(&self) -> (Spot, Spot) {
+        if self.anchor <= self.focus {
+            (self.anchor, self.focus)
+        } else {
+            (self.focus, self.anchor)
+        }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.anchor == self.focus
+    }
+
+    /// The selected graphemes of `leaf`, `usize::MAX` for "to its end"; `None` when none are.
+    pub fn in_leaf(&self, leaf: usize) -> Option<(usize, usize)> {
+        let (start, end) = self.ordered();
+        if self.is_empty() || leaf < start.leaf || leaf > end.leaf {
+            return None;
+        }
+        let from = if leaf == start.leaf {
+            start.grapheme
+        } else {
+            0
+        };
+        let to = if leaf == end.leaf {
+            end.grapheme
+        } else {
+            usize::MAX
+        };
+        (from < to).then_some((from, to))
+    }
+}
+
+/// How a leaf is separated from the one before it in copied text.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Joint {
+    /// A new block: a blank line.
+    Paragraph,
+    /// A list item or code line: a line break.
+    Line,
+    /// The next cell of a table row.
+    Tab,
+    /// More of the same line, after an image.
+    Inline,
+}
+
+/// The plain text of one rendered text run, as copied.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Leaf {
+    pub text: String,
+    pub joint: Joint,
+    /// Copied whole when any of it is selected: a list marker, drawn as "•" and copied as "- ".
+    pub whole: bool,
+}
+
+/// The selected rendered text as plain text: blocks apart by a blank line, list items and code
+/// lines on their own lines, table cells tab-separated per row.
+#[cfg(test)]
+pub fn copied_text(leaves: &[Leaf], selection: &Selection) -> String {
+    copied(leaves.iter().enumerate(), selection)
+}
+
+/// [`copied_text`] of leaves with their numbers, which need not follow one another.
+pub fn copied_numbered(leaves: &[(usize, Leaf)], selection: &Selection) -> String {
+    copied(leaves.iter().map(|(index, leaf)| (*index, leaf)), selection)
+}
+
+fn copied<'a>(leaves: impl Iterator<Item = (usize, &'a Leaf)>, selection: &Selection) -> String {
+    let mut copied = String::new();
+    let mut first = true;
+    for (index, leaf) in leaves {
+        let Some((from, to)) = selection.in_leaf(index) else {
+            continue;
+        };
+        // A marker counts when the selection takes it from its start
+        if leaf.whole && from > 0 {
+            continue;
+        }
+        if !first {
+            copied.push_str(match leaf.joint {
+                Joint::Paragraph => "\n\n",
+                Joint::Line => "\n",
+                Joint::Tab => "\t",
+                Joint::Inline => "",
+            });
+        }
+        first = false;
+        if leaf.whole {
+            copied.push_str(&leaf.text);
+        } else {
+            copied.extend(leaf.text.graphemes(true).skip(from).take(to - from));
+        }
+    }
+    copied
+}
+
+/// Where select all ends: past the last leaf, however many the preview draws.
+pub const END: Spot = Spot {
+    leaf: usize::MAX,
+    grapheme: usize::MAX,
+};
+
+/// Everything rendered selected.
+pub fn select_all() -> Selection {
+    Selection {
+        anchor: Spot::default(),
+        focus: END,
+        dragging: false,
+    }
+}
+
+/// Leaves farther than this above or below the pointer ignore it.
+const REACH: f32 = 48.0;
+
+/// How near the pointer is to a leaf, for the leaves near it to agree which one it is at: the
+/// pointer's position in the window, and how far it is above or below the leaf, then beside it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Near {
+    pub pointer: Point,
+    pub off: (f32, f32),
+}
+
+impl Near {
+    /// The pointer at `pointer` is near the leaf drawn in `bounds`; `None` when out of reach.
+    pub fn of(bounds: Rectangle, pointer: Point) -> Option<Self> {
+        let below = pointer.y - (bounds.y + bounds.height);
+        let dy = (bounds.y - pointer.y).max(below).max(0.0);
+        let dx = (bounds.x - pointer.x)
+            .max(pointer.x - (bounds.x + bounds.width))
+            .max(0.0);
+        (dy <= REACH).then_some(Self {
+            pointer,
+            off: (dy, dx),
+        })
+    }
+
+    /// Keyed by the pointer's position in the window, when known: the same for all leaves.
+    pub fn in_window(self, window: Option<Point>) -> Self {
+        Self {
+            pointer: window.unwrap_or(self.pointer),
+            ..self
+        }
+    }
+
+    pub fn is_over(&self) -> bool {
+        self.off == (0.0, 0.0)
+    }
+
+    /// Of two leaves near the pointer at the same place, `self` is not nearer than `other`.
+    pub fn loses_to(&self, other: &Near) -> bool {
+        self.pointer == other.pointer && self.off >= other.off
+    }
+}
+
+/// How far the selection fill stands out from the background it is drawn on, as a contrast
+/// ratio: clearly visible, while the text on it keeps its own colours.
+const FILL_CONTRAST: f32 = 1.8;
+
+/// How far `text` must stand out from the selection behind it (WCAG AA).
+const TEXT_CONTRAST: f32 = 4.5;
+
+/// The selection fill behind text that keeps its colours (links, inline code, syntax colours):
+/// the theme's selection colour over `background`, strong enough to stand out from it while
+/// `text` on it stays readable. Only the default text colour is checked: links and syntax
+/// colours are made to read on the same backgrounds, and the fill stays light.
+pub fn selection_fill(selected: Color, background: Color, text: Color) -> Color {
+    let shown = |alpha| blend(selected, background, alpha);
+    let mut alpha: f32 = 0.3;
+    while alpha < 0.6 && contrast(shown(alpha), background) < FILL_CONTRAST {
+        if contrast(text, shown(alpha + 0.05)) < TEXT_CONTRAST {
+            break;
+        }
+        alpha += 0.05;
+    }
+    // Lighter where the text would not stand out, but never so light the selection goes
+    while alpha > 0.25 && contrast(text, shown(alpha)) < TEXT_CONTRAST {
+        alpha -= 0.05;
+    }
+    Color {
+        a: selected.a * alpha,
+        ..selected
+    }
+}
+
+/// `color` at `alpha` over `background`.
+fn blend(color: Color, background: Color, alpha: f32) -> Color {
+    let mix = |over: f32, under: f32| over * alpha + under * (1.0 - alpha);
+    Color::from_rgb(
+        mix(color.r, background.r),
+        mix(color.g, background.g),
+        mix(color.b, background.b),
+    )
+}
+
+/// The WCAG contrast ratio of two colours.
+fn contrast(a: Color, b: Color) -> f32 {
+    let luminance = |color: Color| {
+        let channel = |c: f32| {
+            if c <= 0.03928 {
+                c / 12.92
+            } else {
+                ((c + 0.055) / 1.055).powf(2.4)
+            }
+        };
+        0.2126 * channel(color.r) + 0.7152 * channel(color.g) + 0.0722 * channel(color.b)
+    };
+    let (a, b) = (luminance(a), luminance(b));
+    (a.max(b) + 0.05) / (a.min(b) + 0.05)
+}
+
+/// The graphemes of the word at `grapheme` of `text`, by Unicode word boundaries as the
+/// editor's: a run of spaces or a punctuation mark counts as a word.
+pub fn word_at(text: &str, grapheme: usize) -> (usize, usize) {
+    let mut start = 0;
+    let mut last = (0, 0);
+    for word in text.split_word_bounds() {
+        let end = start + word.graphemes(true).count();
+        if grapheme < end {
+            return (start, end);
+        }
+        last = (start, end);
+        start = end;
+    }
+    // Past the end: the last word
+    last
+}
+
+/// What the pointer did to the preview selection.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Action {
+    /// The left button went down on or near a leaf: start a selection there. Each leaf near
+    /// the pointer sends one; the nearest counts.
+    Press(Spot, Near),
+    /// A double or triple click selected from the first spot to the second.
+    PressRange(Spot, Spot, Near),
+    /// Shift+click: the selection now ends here.
+    Extend(Spot, Near),
+    /// A drag reached this spot; as for a press, the nearest leaf counts.
+    Drag(Spot, Near),
+    /// The left button went up.
+    Release,
+    /// Escape, or a press outside the preview.
+    Clear,
+}
+
+/// Selectable rich text: leaf number `leaf` of the preview.
+pub struct SelectableRich<'a, Link, Message, Theme, Renderer>
+where
+    Link: Clone + 'static,
+    Theme: Catalog,
+    Renderer: core_text::Renderer,
+{
+    spans: Box<dyn AsRef<[Span<'a, Link, Renderer::Font>]> + 'a>,
+    size: Option<Pixels>,
+    line_height: LineHeight,
+    font: Option<Renderer::Font>,
+    class: Theme::Class<'a>,
+    hovered_link: Option<usize>,
+    on_link_click: Option<Box<dyn Fn(Link) -> Message + 'a>>,
+    leaf: usize,
+    /// The preview's selection, when there is one.
+    selection: Option<Selection>,
+    on_select: Option<Box<dyn Fn(Action) -> Message + 'a>>,
+    /// What the text is drawn on, for a selection fill that stands out from it.
+    background: Color,
+}
+
+impl<'a, Link, Message, Theme, Renderer> SelectableRich<'a, Link, Message, Theme, Renderer>
+where
+    Link: Clone + 'static,
+    Theme: Catalog,
+    Renderer: core_text::Renderer,
+    Renderer::Font: 'a,
+{
+    pub fn new(spans: impl AsRef<[Span<'a, Link, Renderer::Font>]> + 'a) -> Self {
+        Self {
+            spans: Box::new(spans),
+            size: None,
+            line_height: LineHeight::default(),
+            font: None,
+            class: Theme::default(),
+            hovered_link: None,
+            on_link_click: None,
+            leaf: 0,
+            selection: None,
+            on_select: None,
+            background: Color::WHITE,
+        }
+    }
+
+    pub fn size(mut self, size: impl Into<Pixels>) -> Self {
+        self.size = Some(size.into());
+        self
+    }
+
+    pub fn font(mut self, font: impl Into<Renderer::Font>) -> Self {
+        self.font = Some(font.into());
+        self
+    }
+
+    pub fn on_link_click(mut self, on_link_click: impl Fn(Link) -> Message + 'a) -> Self {
+        self.on_link_click = Some(Box::new(on_link_click));
+        self
+    }
+
+    /// The colour the text is drawn on.
+    pub fn background(mut self, background: Color) -> Self {
+        self.background = background;
+        self
+    }
+
+    /// Make this leaf `leaf` of the preview, sharing `selection` and reporting to `on_select`.
+    pub fn selectable(
+        mut self,
+        leaf: usize,
+        selection: Option<Selection>,
+        on_select: impl Fn(Action) -> Message + 'a,
+    ) -> Self {
+        self.leaf = leaf;
+        self.selection = selection;
+        self.on_select = Some(Box::new(on_select));
+        self
+    }
+}
+
+struct State<Link, P: Paragraph> {
+    spans: Vec<Span<'static, Link, P::Font>>,
+    /// The spans' text joined, what grapheme offsets count in.
+    content: String,
+    span_pressed: Option<usize>,
+    /// A selection started here and the button is still down.
+    pressed: bool,
+    /// The last press on this leaf, to tell a double or triple click.
+    last_click: Option<click::Click>,
+    modifiers: keyboard::Modifiers,
+    /// The pointer's last position in the window.
+    window_pointer: Option<Point>,
+    paragraph: P,
+}
+
+impl<Link, P: Paragraph> State<Link, P> {
+    /// The grapheme boundary nearest to `position`, relative to the widget.
+    fn grapheme_at(&self, position: Point) -> usize {
+        match self.paragraph.hit_test(position) {
+            Some(hit) => {
+                // The hit counts in its line: a hard break starts a new one
+                let line = self.line_at(position.y);
+                let byte = line.start + hit.cursor().min(line.len());
+                // A hit inside a cluster counts as before it
+                self.content
+                    .grapheme_indices(true)
+                    .take_while(|(start, grapheme)| start + grapheme.len() <= byte)
+                    .count()
+            }
+            None => self.content.graphemes(true).count(),
+        }
+    }
+
+    /// The grapheme nearest to `pointer`, in absolute coordinates, for a leaf drawn in
+    /// `bounds`: above the leaf its start, below its end, beside a line that line's start or end.
+    fn grapheme_near(&self, bounds: Rectangle, pointer: Point) -> usize {
+        if pointer.y < bounds.y {
+            0
+        } else if pointer.y >= bounds.y + bounds.height {
+            self.content.graphemes(true).count()
+        } else {
+            let x = (pointer.x - bounds.x).clamp(0.0, bounds.width);
+            self.grapheme_at(Point::new(x, pointer.y - bounds.y))
+        }
+    }
+
+    /// The bytes of the line drawn at `y`: the first that reaches below it.
+    fn line_at(&self, y: f32) -> Range<usize> {
+        let mut lines = line_ranges(&self.content);
+        if !self.content.contains('\n') {
+            return lines.next().unwrap_or_default();
+        }
+        let mut last = 0..0;
+        for (index, line) in lines.enumerate() {
+            let bottom = self
+                .paragraph
+                .highlight(
+                    index,
+                    (0, core_text::Affinity::After),
+                    (line.len(), core_text::Affinity::Before),
+                )
+                .iter()
+                .map(|bounds| bounds.y + bounds.height)
+                .reduce(f32::max);
+            if bottom.is_some_and(|bottom| y < bottom) {
+                return line;
+            }
+            last = line;
+        }
+        last
+    }
+}
+
+/// The bytes of each line of `text`, as the paragraph breaks it at `\n`.
+fn line_ranges(text: &str) -> impl Iterator<Item = Range<usize>> + '_ {
+    let mut start = 0;
+    text.split('\n').map(move |line| {
+        let range = start..start + line.len();
+        start = range.end + 1;
+        range
+    })
+}
+
+fn grapheme_to_byte(text: &str, grapheme: usize) -> usize {
+    text.grapheme_indices(true)
+        .nth(grapheme)
+        .map_or(text.len(), |(byte, _)| byte)
+}
+
+impl<Link, Message, Theme, Renderer> Widget<Message, Theme, Renderer>
+    for SelectableRich<'_, Link, Message, Theme, Renderer>
+where
+    Link: Clone + 'static,
+    Theme: Catalog,
+    Renderer: core_text::Renderer,
+{
+    fn tag(&self) -> tree::Tag {
+        tree::Tag::of::<State<Link, Renderer::Paragraph>>()
+    }
+
+    fn state(&self) -> tree::State {
+        tree::State::new(State::<Link, Renderer::Paragraph> {
+            spans: Vec::new(),
+            content: String::new(),
+            span_pressed: None,
+            pressed: false,
+            last_click: None,
+            modifiers: keyboard::Modifiers::default(),
+            window_pointer: None,
+            paragraph: Renderer::Paragraph::default(),
+        })
+    }
+
+    fn size(&self) -> Size<Length> {
+        Size {
+            width: Length::Shrink,
+            height: Length::Shrink,
+        }
+    }
+
+    fn layout(
+        &mut self,
+        tree: &mut Tree,
+        renderer: &Renderer,
+        limits: &layout::Limits,
+    ) -> layout::Node {
+        let state = tree
+            .state
+            .downcast_mut::<State<Link, Renderer::Paragraph>>();
+        let spans = self.spans.as_ref().as_ref();
+        let line_height = self.line_height;
+        let size = self.size;
+        let font = self.font;
+        layout::sized(limits, Length::Shrink, Length::Shrink, |limits| {
+            let bounds = limits.max();
+            let size = size.unwrap_or_else(|| renderer.default_size());
+            let font = font.unwrap_or_else(|| renderer.default_font());
+            fn text<C, F>(
+                content: C,
+                bounds: Size,
+                size: Pixels,
+                line_height: LineHeight,
+                font: F,
+            ) -> core_text::Text<C, F> {
+                core_text::Text {
+                    content,
+                    bounds,
+                    size,
+                    line_height,
+                    font,
+                    align_x: Alignment::Default,
+                    align_y: alignment::Vertical::Top,
+                    shaping: Shaping::Advanced,
+                    wrapping: Wrapping::default(),
+                    ellipsize: core_text::Ellipsize::default(),
+                }
+            }
+            if state.spans != spans {
+                state.paragraph =
+                    Renderer::Paragraph::with_spans(text(spans, bounds, size, line_height, font));
+                state.spans = spans.iter().cloned().map(Span::to_static).collect();
+                state.content = spans.iter().map(|span| span.text.as_ref()).collect();
+            } else {
+                match state
+                    .paragraph
+                    .compare(text((), bounds, size, line_height, font))
+                {
+                    core_text::Difference::None => {}
+                    core_text::Difference::Bounds => state.paragraph.resize(bounds),
+                    core_text::Difference::Shape => {
+                        state.paragraph = Renderer::Paragraph::with_spans(text(
+                            spans,
+                            bounds,
+                            size,
+                            line_height,
+                            font,
+                        ));
+                    }
+                }
+            }
+            state.paragraph.min_bounds()
+        })
+    }
+
+    fn draw(
+        &self,
+        tree: &Tree,
+        renderer: &mut Renderer,
+        theme: &Theme,
+        defaults: &renderer::Style,
+        layout: Layout<'_>,
+        _cursor: mouse::Cursor,
+        viewport: &Rectangle,
+    ) {
+        if !layout.bounds().intersects(viewport) {
+            return;
+        }
+        let state = tree
+            .state
+            .downcast_ref::<State<Link, Renderer::Paragraph>>();
+        let style = theme.style(&self.class);
+        let translation = layout.position() - Point::ORIGIN;
+
+        for (index, span) in self.spans.as_ref().as_ref().iter().enumerate() {
+            let is_hovered_link = self.on_link_click.is_some() && Some(index) == self.hovered_link;
+            if span.highlight.is_none()
+                && !span.underline
+                && !span.strikethrough
+                && !is_hovered_link
+            {
+                continue;
+            }
+            let regions = state.paragraph.span_bounds(index);
+            if let Some(highlight) = span.highlight {
+                for bounds in &regions {
+                    let bounds = Rectangle::new(
+                        bounds.position() - Vector::new(span.padding.left, span.padding.top),
+                        bounds.size() + Size::new(span.padding.x(), span.padding.y()),
+                    );
+                    renderer.fill_quad(
+                        renderer::Quad {
+                            bounds: bounds + translation,
+                            border: highlight.border,
+                            ..Default::default()
+                        },
+                        highlight.background,
+                    );
+                }
+            }
+            if span.underline || span.strikethrough || is_hovered_link {
+                let size = span.size.or(self.size).unwrap_or(renderer.default_size());
+                let line_height = span
+                    .line_height
+                    .unwrap_or(self.line_height)
+                    .to_absolute(size);
+                let color = span.color.or(style.color).unwrap_or(defaults.text_color);
+                let baseline =
+                    translation + Vector::new(0.0, size.0 + (line_height.0 - size.0) / 2.0);
+                let offsets = (span.underline || is_hovered_link)
+                    .then_some(size.0 * 0.08)
+                    .into_iter()
+                    .chain(span.strikethrough.then_some(size.0 / 2.0));
+                for offset in offsets {
+                    for bounds in &regions {
+                        renderer.fill_quad(
+                            renderer::Quad {
+                                bounds: Rectangle::new(
+                                    bounds.position() + baseline - Vector::new(0.0, offset),
+                                    Size::new(bounds.width, 1.0),
+                                ),
+                                ..Default::default()
+                            },
+                            color,
+                        );
+                    }
+                }
+            }
+        }
+
+        // The selected part of this leaf, as in the editor: filled behind the text
+        let selected: Vec<Rectangle> = self
+            .selection
+            .and_then(|selection| selection.in_leaf(self.leaf))
+            .map(|(from, to)| {
+                let from = grapheme_to_byte(&state.content, from);
+                let to = grapheme_to_byte(&state.content, to);
+                line_ranges(&state.content)
+                    .enumerate()
+                    .filter(|(_, line)| line.start < to && from <= line.end)
+                    .flat_map(|(index, line)| {
+                        state.paragraph.highlight(
+                            index,
+                            (
+                                from.max(line.start) - line.start,
+                                core_text::Affinity::After,
+                            ),
+                            (to.min(line.end) - line.start, core_text::Affinity::Before),
+                        )
+                    })
+                    .map(|bounds| bounds + translation)
+                    .collect()
+            })
+            .unwrap_or_default();
+        // As in the editor: a light fill behind, the text keeps its own colours
+        for bounds in &selected {
+            renderer.fill_quad(
+                renderer::Quad {
+                    bounds: *bounds,
+                    ..Default::default()
+                },
+                selection_fill(
+                    style.selected_fill,
+                    self.background,
+                    style.color.unwrap_or(defaults.text_color),
+                ),
+            );
+        }
+
+        cosmic::iced::widget::text::draw(
+            renderer,
+            defaults,
+            layout.bounds(),
+            &state.paragraph,
+            style,
+            viewport,
+        );
+    }
+
+    fn update(
+        &mut self,
+        tree: &mut Tree,
+        event: &Event,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        _renderer: &Renderer,
+        _clipboard: &mut dyn Clipboard,
+        shell: &mut Shell<'_, Message>,
+        viewport: &Rectangle,
+    ) {
+        let bounds = layout.bounds();
+        let state = tree
+            .state
+            .downcast_mut::<State<Link, Renderer::Paragraph>>();
+
+        if self.on_link_click.is_some() {
+            let was_hovered = self.hovered_link.is_some();
+            self.hovered_link = cursor
+                .position_in(bounds)
+                .and_then(|position| state.paragraph.hit_span(position))
+                .filter(|span| {
+                    self.spans
+                        .as_ref()
+                        .as_ref()
+                        .get(*span)
+                        .is_some_and(|span| span.link.is_some())
+                });
+            if was_hovered != self.hovered_link.is_some() {
+                shell.request_redraw();
+            }
+        }
+
+        let selection = self.selection;
+        // The leaf the drag is at answers for the whole preview: one message, not one per leaf
+        // (the first leaf for select all, which ends past every leaf)
+        let is_focus = selection.is_some_and(|selection| {
+            selection.focus.leaf == self.leaf || (selection.focus == END && self.leaf == 0)
+        });
+        let select = |action| self.on_select.as_ref().map(|on_select| on_select(action));
+        // Where the pointer is in the window, the same for every leaf: inside a scrolled code
+        // block or table the cursor is shifted, so the leaves would not compare alike
+        if let Event::Mouse(mouse::Event::CursorMoved { position }) = event {
+            state.window_pointer = Some(*position);
+        }
+        let window_pointer = state.window_pointer;
+        let in_window = |near: Near| near.in_window(window_pointer);
+
+        match event {
+            Event::Mouse(mouse::Event::ButtonPressed(mouse::Button::Left)) => {
+                // On the text, or beside it in the preview: in its margin, or between blocks
+                let near = cursor
+                    .position()
+                    .and_then(|pointer| Near::of(bounds, pointer))
+                    .filter(|near| near.is_over() || cursor.is_over(*viewport));
+                if let Some(near) = near {
+                    let grapheme = state.grapheme_near(bounds, near.pointer);
+                    let spot = |grapheme| Spot {
+                        leaf: self.leaf,
+                        grapheme,
+                    };
+                    // A double click on the text selects a word, a triple click the leaf
+                    let kind = if near.is_over() {
+                        let click = click::Click::new(
+                            near.pointer,
+                            mouse::Button::Left,
+                            state.last_click.take(),
+                        );
+                        state.last_click = Some(click);
+                        click.kind()
+                    } else {
+                        click::Kind::Single
+                    };
+                    let near = in_window(near);
+                    let action = match kind {
+                        click::Kind::Single if state.modifiers.shift() => {
+                            Action::Extend(spot(grapheme), near)
+                        }
+                        click::Kind::Single => Action::Press(spot(grapheme), near),
+                        click::Kind::Double => {
+                            let (start, end) = word_at(&state.content, grapheme);
+                            Action::PressRange(spot(start), spot(end), near)
+                        }
+                        click::Kind::Triple => Action::PressRange(
+                            spot(0),
+                            spot(state.content.graphemes(true).count()),
+                            near,
+                        ),
+                    };
+                    if let Some(message) = select(action) {
+                        shell.publish(message);
+                    }
+                    state.pressed = true;
+                }
+                if near.is_some_and(|near| near.is_over()) {
+                    // Only a link takes the press, as in rich text: the summary of a
+                    // `<details>` still toggles
+                    state.span_pressed = self.hovered_link;
+                    if state.span_pressed.is_some() {
+                        shell.capture_event();
+                    }
+                } else if is_focus && !state.modifiers.shift() {
+                    // Pressed elsewhere: beside the text, or in the editor of the Split view;
+                    // not Shift+click, which extends the selection from its anchor
+                    if let Some(message) = select(Action::Clear) {
+                        shell.publish(message);
+                    }
+                }
+            }
+            Event::Mouse(mouse::Event::CursorMoved { .. }) => {
+                // Past the end of a line or between blocks the drag still reaches the nearest
+                // text, as in a browser
+                if selection.is_some_and(|selection| selection.dragging)
+                    && let Some(near) = cursor
+                        .land()
+                        .position()
+                        .and_then(|pointer| Near::of(bounds, pointer))
+                {
+                    let spot = Spot {
+                        leaf: self.leaf,
+                        grapheme: state.grapheme_near(bounds, near.pointer),
+                    };
+                    // Only a new spot, or the leaf under the pointer, which outranks the rest
+                    if (near.is_over()
+                        || selection.is_some_and(|selection| selection.focus != spot))
+                        && let Some(message) = select(Action::Drag(spot, in_window(near)))
+                    {
+                        shell.publish(message);
+                    }
+                }
+            }
+            Event::Mouse(mouse::Event::ButtonReleased(mouse::Button::Left)) => {
+                // The leaf pressed also ends the drag: a quick click may release before the
+                // view shows the new selection
+                let pressed = std::mem::take(&mut state.pressed);
+                if (pressed || is_focus && selection.is_some_and(|selection| selection.dragging))
+                    && let Some(message) = select(Action::Release)
+                {
+                    shell.publish(message);
+                }
+                // A click without a drag follows the link
+                if let Some(span) = state.span_pressed.take()
+                    && Some(span) == self.hovered_link
+                    && selection.is_none_or(|selection| selection.is_empty())
+                    && let Some(on_link_click) = &self.on_link_click
+                    && let Some(link) = self
+                        .spans
+                        .as_ref()
+                        .as_ref()
+                        .get(span)
+                        .and_then(|span| span.link.clone())
+                {
+                    shell.publish(on_link_click(link));
+                }
+            }
+            Event::Keyboard(keyboard::Event::ModifiersChanged(modifiers)) => {
+                state.modifiers = *modifiers;
+            }
+            Event::Keyboard(keyboard::Event::KeyPressed {
+                key: keyboard::Key::Named(keyboard::key::Named::Escape),
+                ..
+            }) => {
+                if is_focus
+                    && selection.is_some_and(|selection| !selection.is_empty())
+                    && let Some(message) = select(Action::Clear)
+                {
+                    shell.publish(message);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn mouse_interaction(
+        &self,
+        _tree: &Tree,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        _viewport: &Rectangle,
+        _renderer: &Renderer,
+    ) -> mouse::Interaction {
+        if self.hovered_link.is_some() {
+            mouse::Interaction::Pointer
+        } else if self.on_select.is_some() && cursor.is_over(layout.bounds()) {
+            mouse::Interaction::Text
+        } else {
+            mouse::Interaction::None
+        }
+    }
+}
+
+impl<'a, Link, Message, Theme, Renderer> From<SelectableRich<'a, Link, Message, Theme, Renderer>>
+    for Element<'a, Message, Theme, Renderer>
+where
+    Message: 'a,
+    Link: Clone + 'a,
+    Theme: Catalog + 'a,
+    Renderer: core_text::Renderer + 'a,
+{
+    fn from(text: SelectableRich<'a, Link, Message, Theme, Renderer>) -> Self {
+        Element::new(text)
+    }
+}
+
+/// Pixels the preview scrolls per frame for each pixel the pointer is past its edge, and the
+/// least and most per frame.
+const SCROLL_RATE: f32 = 0.2;
+const SCROLL_MIN: f32 = 2.0;
+const SCROLL_MAX: f32 = 40.0;
+
+/// Within this of the preview's top or bottom a drag scrolls it already: with the window
+/// maximised the pointer cannot leave it downwards.
+const SCROLL_ZONE: f32 = 24.0;
+
+/// How far the preview, showing `top` to `bottom`, scrolls per tick with a drag at `y`:
+/// nothing away from its edges, faster the farther into the edge zone or past it.
+pub fn edge_scroll(top: f32, bottom: f32, y: f32) -> f32 {
+    let speed = |past: f32| (past * SCROLL_RATE).clamp(SCROLL_MIN, SCROLL_MAX);
+    if y < top + SCROLL_ZONE {
+        -speed(top + SCROLL_ZONE - y)
+    } else if y > bottom - SCROLL_ZONE {
+        speed(y - (bottom - SCROLL_ZONE))
+    } else {
+        0.0
+    }
+}
+
+/// Whether a preview scrolled to `offset`, with `content` and `view` heights, can scroll by `dy`.
+pub fn can_scroll(offset: f32, content: f32, view: f32, dy: f32) -> bool {
+    (dy < 0.0 && offset > 0.0) || (dy > 0.0 && offset + view < content - 0.5)
+}
+
+/// What the drag did at the preview's edges.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Edge {
+    /// Scroll by this much per tick with the pointer here, in the window, or stop.
+    Scroll(Option<(f32, Point)>),
+    /// The button went up, or the window lost the pointer: the drag ends wherever it is.
+    Release,
+}
+
+/// Around the preview's scrollable: while a selection is dragged near or past its top or
+/// bottom, it asks to scroll (on a timer, not every frame), and on each redraw the selection
+/// follows to the text at that edge. It also ends a drag released anywhere in the window. Shares
+/// its content's state, as a container does, so the preview keeps its widget tree.
+pub struct DragEdge<'a, Message, Theme, Renderer> {
+    content: Element<'a, Message, Theme, Renderer>,
+    dragging: bool,
+    /// Scrolling, with the pointer last here: once out of the window it is not known.
+    scrolling: Option<Point>,
+    on_edge: Box<dyn Fn(Edge) -> Message + 'a>,
+}
+
+impl<'a, Message, Theme, Renderer> DragEdge<'a, Message, Theme, Renderer> {
+    pub fn new(
+        content: impl Into<Element<'a, Message, Theme, Renderer>>,
+        dragging: bool,
+        scrolling: Option<Point>,
+        on_edge: impl Fn(Edge) -> Message + 'a,
+    ) -> Self {
+        Self {
+            content: content.into(),
+            dragging,
+            scrolling,
+            on_edge: Box::new(on_edge),
+        }
+    }
+}
+
+impl<Message, Theme, Renderer> Widget<Message, Theme, Renderer>
+    for DragEdge<'_, Message, Theme, Renderer>
+where
+    Renderer: cosmic::iced::advanced::Renderer,
+{
+    fn tag(&self) -> tree::Tag {
+        self.content.as_widget().tag()
+    }
+
+    fn state(&self) -> tree::State {
+        self.content.as_widget().state()
+    }
+
+    fn children(&self) -> Vec<Tree> {
+        self.content.as_widget().children()
+    }
+
+    fn diff(&mut self, tree: &mut Tree) {
+        self.content.as_widget_mut().diff(tree);
+    }
+
+    fn size(&self) -> Size<Length> {
+        self.content.as_widget().size()
+    }
+
+    fn size_hint(&self) -> Size<Length> {
+        self.content.as_widget().size_hint()
+    }
+
+    fn layout(
+        &mut self,
+        tree: &mut Tree,
+        renderer: &Renderer,
+        limits: &layout::Limits,
+    ) -> layout::Node {
+        self.content.as_widget_mut().layout(tree, renderer, limits)
+    }
+
+    fn draw(
+        &self,
+        tree: &Tree,
+        renderer: &mut Renderer,
+        theme: &Theme,
+        style: &renderer::Style,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        viewport: &Rectangle,
+    ) {
+        self.content
+            .as_widget()
+            .draw(tree, renderer, theme, style, layout, cursor, viewport);
+    }
+
+    fn operate(
+        &mut self,
+        tree: &mut Tree,
+        layout: Layout<'_>,
+        renderer: &Renderer,
+        operation: &mut dyn Operation,
+    ) {
+        self.content
+            .as_widget_mut()
+            .operate(tree, layout, renderer, operation);
+    }
+
+    fn update(
+        &mut self,
+        tree: &mut Tree,
+        event: &Event,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        renderer: &Renderer,
+        clipboard: &mut dyn Clipboard,
+        shell: &mut Shell<'_, Message>,
+        viewport: &Rectangle,
+    ) {
+        if !self.dragging {
+            self.content.as_widget_mut().update(
+                tree, event, layout, cursor, renderer, clipboard, shell, viewport,
+            );
+            return;
+        }
+        let bounds = layout.bounds();
+        let pointer = cursor.land().position().or(self.scrolling);
+        // The text at the edge, for a pointer past it: the selection follows to it
+        let edge = pointer.map(|pointer| {
+            Point::new(
+                pointer.x.max(bounds.x).min(bounds.x + bounds.width - 1.0),
+                pointer.y.max(bounds.y).min(bounds.y + bounds.height - 1.0),
+            )
+        });
+        let moved = edge.map(|edge| Event::Mouse(mouse::Event::CursorMoved { position: edge }));
+        match event {
+            Event::Mouse(mouse::Event::ButtonReleased(mouse::Button::Left))
+            | Event::Window(cosmic::iced::window::Event::Unfocused) => {
+                shell.publish((self.on_edge)(Edge::Release));
+            }
+            Event::Mouse(mouse::Event::CursorMoved { .. }) => {
+                let speed = pointer
+                    .map(|pointer| {
+                        (
+                            edge_scroll(bounds.y, bounds.y + bounds.height, pointer.y),
+                            pointer,
+                        )
+                    })
+                    .filter(|(speed, _)| *speed != 0.0);
+                if speed.is_some() || self.scrolling.is_some() {
+                    shell.publish((self.on_edge)(Edge::Scroll(speed)));
+                }
+            }
+            Event::Window(cosmic::iced::window::Event::RedrawRequested(_)) => {
+                // Scrolled since: the text at the pointer changed
+                if self.scrolling.is_some()
+                    && let (Some(edge), Some(moved)) = (edge, &moved)
+                {
+                    self.content.as_widget_mut().update(
+                        tree,
+                        moved,
+                        layout,
+                        mouse::Cursor::Available(edge),
+                        renderer,
+                        clipboard,
+                        shell,
+                        viewport,
+                    );
+                }
+            }
+            _ => {}
+        }
+        match (event, edge, &moved) {
+            (Event::Mouse(mouse::Event::CursorMoved { .. }), Some(edge), Some(moved)) => {
+                self.content.as_widget_mut().update(
+                    tree,
+                    moved,
+                    layout,
+                    mouse::Cursor::Available(edge),
+                    renderer,
+                    clipboard,
+                    shell,
+                    viewport,
+                );
+            }
+            _ => self.content.as_widget_mut().update(
+                tree, event, layout, cursor, renderer, clipboard, shell, viewport,
+            ),
+        }
+    }
+
+    fn mouse_interaction(
+        &self,
+        tree: &Tree,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        viewport: &Rectangle,
+        renderer: &Renderer,
+    ) -> mouse::Interaction {
+        self.content
+            .as_widget()
+            .mouse_interaction(tree, layout, cursor, viewport, renderer)
+    }
+
+    fn overlay<'b>(
+        &'b mut self,
+        tree: &'b mut Tree,
+        layout: Layout<'b>,
+        renderer: &Renderer,
+        viewport: &Rectangle,
+        translation: Vector,
+    ) -> Option<overlay::Element<'b, Message, Theme, Renderer>> {
+        self.content
+            .as_widget_mut()
+            .overlay(tree, layout, renderer, viewport, translation)
+    }
+
+    fn id(&self) -> Option<Id> {
+        self.content.as_widget().id()
+    }
+
+    fn set_id(&mut self, id: Id) {
+        self.content.as_widget_mut().set_id(id);
+    }
+}
+
+impl<'a, Message, Theme, Renderer> From<DragEdge<'a, Message, Theme, Renderer>>
+    for Element<'a, Message, Theme, Renderer>
+where
+    Message: 'a,
+    Theme: 'a,
+    Renderer: cosmic::iced::advanced::Renderer + 'a,
+{
+    fn from(edge: DragEdge<'a, Message, Theme, Renderer>) -> Self {
+        Element::new(edge)
+    }
+}

+/// What a key can change, taken before the key: the number of lines and a hash of the lines
+/// of the cursor, the selection and the column block. Keys and input method text edit there
+/// (typing, Enter, Backspace, Tab over a selection, the Markdown and column keys), so the same
+/// lines after the key tell whether it edited, without reading the whole text. Vim commands
+/// that edit away from the cursor and keep the line count (`u` on a far line) are not seen;
+/// the app's own edits (paste, undo, replace) report themselves.
+struct EditPrint {
+    len: usize,
+    /// The lines hashed; `None` when they are more than [`EditPrint::MAX_LINES`]: then every
+    /// key counts as an edit.
+    lines: Option<(usize, usize, u64)>,
+}
+
+impl EditPrint {
+    const MAX_LINES: usize = 10_000;
+
+    fn new(editor: &ViEditor<'static, 'static>, block: Option<&Block>) -> Self {
+        let cursor = editor.cursor().line;
+        let (mut first, mut last) = (cursor, cursor);
+        if let Some((start, end)) = editor.selection_bounds() {
+            first = first.min(start.line);
+            last = last.max(end.line);
+        }
+        if let Some(block) = block {
+            first = first.min(block.top());
+            last = last.max(block.bottom());
+        }
+        editor.with_buffer(|buffer| Self {
+            len: buffer.lines.len(),
+            lines: (last - first < Self::MAX_LINES)
+                .then(|| (first, last, Self::hash(&buffer.lines, first, last))),
+        })
+    }
+
+    fn hash(lines: &[cosmic_text::BufferLine], first: usize, last: usize) -> u64 {
+        let mut hasher = std::hash::DefaultHasher::new();
+        for line in lines.iter().take(last + 1).skip(first) {
+            std::hash::Hash::hash(line.text(), &mut hasher);
+        }
+        std::hash::Hasher::finish(&hasher)
+    }
+
+    fn edited(&self, editor: &ViEditor<'static, 'static>) -> bool {
+        let Some((first, last, hash)) = self.lines else {
+            return true;
+        };
+        editor.with_buffer(|buffer| {
+            buffer.lines.len() != self.len || Self::hash(&buffer.lines, first, last) != hash
+        })
+    }
+}

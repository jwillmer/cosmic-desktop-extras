+    #[test]
+    fn window_size_is_saved_and_restored() {
+        let dir = temp_dir("window");
+        let mut store = Store::open(dir.clone()).unwrap();
+        let window = WindowGeometry {
+            width: 1280.0,
+            height: 900.5,
+            maximized: false,
+        };
+        let session = SessionFile {
+            window: Some(window),
+            ..sample()
+        };
+        store.save(session.clone()).unwrap();
+        assert_eq!(read_window(&dir), Some(window));
+        assert_eq!(window.size(), Some(Size::new(1280.0, 900.5)));
+        drop(store);
+        let mut store = Store::open(dir.clone()).unwrap();
+        assert_eq!(store.load().unwrap(), session);
+        fs::remove_dir_all(dir).unwrap();
+    }
+
+    #[test]
+    fn old_session_without_size_uses_default() {
+        let dir = temp_dir("window-old");
+        let mut store = Store::open(dir.clone()).unwrap();
+        fs::write(dir.join(SESSION_FILE), "(version: 1, active: 0, tabs: [])").unwrap();
+        assert_eq!(read_window(&dir), None);
+        assert_eq!(
+            store.load().unwrap(),
+            SessionFile {
+                version: VERSION,
+                ..Default::default()
+            }
+        );
+        assert!(dir.join(SESSION_FILE).exists());
+        fs::remove_dir_all(&dir).unwrap();
+        assert_eq!(read_window(&dir), None);
+    }
+
+    #[test]
+    fn absurd_sizes_are_clamped() {
+        let size = |width, height| {
+            WindowGeometry {
+                width,
+                height,
+                maximized: false,
+            }
+            .size()
+        };
+        assert_eq!(size(10.0, -5.0), Some(Size::new(360.0, 240.0)));
+        assert_eq!(size(1e9, 1e9), Some(Size::new(8192.0, 8192.0)));
+        assert_eq!(size(800.0, 600.0), Some(Size::new(800.0, 600.0)));
+        assert_eq!(size(f32::NAN, 600.0), None);
+        assert_eq!(size(800.0, f32::INFINITY), None);
+    }
+
+    #[test]
+    fn maximized_state_is_restored() {
+        let normal = WindowGeometry::resized(None, Size::new(1000.0, 700.0), false);
+        // Maximizing keeps the size to return to
+        let maximized = WindowGeometry::resized(Some(normal), Size::new(2560.0, 1400.0), true);
+        assert_eq!(
+            maximized,
+            WindowGeometry {
+                width: 1000.0,
+                height: 700.0,
+                maximized: true,
+            }
+        );
+        let dir = temp_dir("window-max");
+        let mut store = Store::open(dir.clone()).unwrap();
+        store
+            .save(SessionFile {
+                window: Some(maximized),
+                ..sample()
+            })
+            .unwrap();
+        assert_eq!(read_window(&dir), Some(maximized));
+        fs::remove_dir_all(dir).unwrap();
+        // Unmaximized again: the new size counts
+        let restored = WindowGeometry::resized(Some(maximized), Size::new(900.0, 650.0), false);
+        assert_eq!(restored.size(), Some(Size::new(900.0, 650.0)));
+        assert!(!restored.maximized);
+    }

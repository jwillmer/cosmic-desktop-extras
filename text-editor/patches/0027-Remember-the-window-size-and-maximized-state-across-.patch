+
+/// The main window's size in logical pixels and whether it was maximized. Its position is not
+/// kept: a Wayland client cannot place its window.
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Serialize)]
+pub struct WindowGeometry {
+    pub width: f32,
+    pub height: f32,
+    pub maximized: bool,
+}
+
+impl WindowGeometry {
+    /// A resize was seen. A maximized window keeps the size it had before, so it comes back to
+    /// that size when unmaximized after the next start.
+    pub fn resized(previous: Option<Self>, size: Size, maximized: bool) -> Self {
+        match previous {
+            Some(previous) if maximized => Self {
+                maximized,
+                ..previous
+            },
+            _ => Self {
+                width: size.width,
+                height: size.height,
+                maximized,
+            },
+        }
+    }
+
+    /// The size to open the window with, within sane bounds; `None` when it is not a number.
+    pub fn size(&self) -> Option<Size> {
+        (self.width.is_finite() && self.height.is_finite()).then(|| {
+            Size::new(
+                self.width.clamp(WINDOW_MIN.width, WINDOW_MAX.width),
+                self.height.clamp(WINDOW_MIN.height, WINDOW_MAX.height),
+            )
+        })
+    }
+}
+
+/// The window of the last session, read before the window opens. Read only: the session is
+/// loaded, and owned, later by `session_restore`.
+pub fn saved_window() -> Option<WindowGeometry> {
+    read_window(&session_dir()?)
+}
+
+fn read_window(dir: &Path) -> Option<WindowGeometry> {
+    let data = fs::read_to_string(dir.join(SESSION_FILE)).ok()?;
+    ron::from_str::<SessionFile>(&data)
+        .ok()
+        .filter(|session| session.version == VERSION)?
+        .window
 }
 

+    #[test]
+    fn a_drag_at_the_edge_follows_the_scroll_and_stops_at_the_end() {
+        use select::{Action, Near, Spot};
+        let mut preview = Preview::new(ViewMode::Preview);
+        preview.parse("one\n\ntwo\n\nthree\n", None);
+        preview.content_height = 2000.0;
+        preview.viewport_height = 500.0;
+        let spot = |leaf, grapheme| Spot { leaf, grapheme };
+        let edge = Near {
+            pointer: iced::Point::new(50.0, 499.0),
+            off: (0.0, 0.0),
+        };
+        preview.select(Action::Press(spot(0, 0), over(1.0)));
+        preview.select(Action::Drag(spot(1, 1), edge));
+        preview.scroll_speed = Some((10.0, edge.pointer));
+        assert!(preview.drag_scroll().is_some());
+        // After the step the text at the same pointer counts, though it did not move
+        preview.select(Action::Drag(spot(2, 2), edge));
+        assert_eq!(preview.selection.map(|s| s.focus), Some(spot(2, 2)));
+        // At the end of the document the ticks stop
+        preview.scroll_offset.y = 1500.0;
+        assert!(preview.drag_scroll().is_none());
+        assert_eq!(preview.scroll_speed, None);
+        // Released, nothing scrolls
+        preview.scroll_offset.y = 0.0;
+        preview.scroll_speed = Some((10.0, edge.pointer));
+        preview.select(Action::Release);
+        assert!(preview.drag_scroll().is_none());
+    }
+
     fn test_settings() -> Settings {
         settings(14.0, Font::MONOSPACE)
     }

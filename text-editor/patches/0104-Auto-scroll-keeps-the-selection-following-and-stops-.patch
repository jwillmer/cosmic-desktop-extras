+    if y < top + SCROLL_ZONE {
+        -speed(top + SCROLL_ZONE - y)
+    } else if y > bottom - SCROLL_ZONE {
+        speed(y - (bottom - SCROLL_ZONE))
     } else {
         0.0
     }
 }
 

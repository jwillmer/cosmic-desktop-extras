+    /// A step of scrolling while a selection is dragged at an edge; `None` at the end of the
+    /// document, which stops the ticks until the pointer moves again.
+    fn drag_scroll(&mut self) -> Option<Task<AppMessage>> {
+        let (speed, _) = self.scroll_speed?;
+        if !self.selection.is_some_and(|selection| selection.dragging)
+            || !select::can_scroll(
+                self.scroll_offset.y,
+                self.content_height,
+                self.viewport_height,
+                speed,
+            )
+        {
+            self.scroll_speed = None;
+            return None;
+        }
+        // The text at the edge after this step is a new place: its leaves compare afresh
+        self.near = None;
+        // Scrolls as the user does: its scroll event syncs the editor
+        Some(iced::widget::scrollable::scroll_by(
+            self.scroll_id.clone(),
+            AbsoluteOffset { x: 0.0, y: speed },
+        ))
+    }

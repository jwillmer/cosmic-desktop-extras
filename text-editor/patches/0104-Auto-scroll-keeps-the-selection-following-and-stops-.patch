+/// How far the preview, showing `top` to `bottom`, scrolls per tick with a drag at `y`:
+/// nothing away from its edges, faster the farther into the edge zone or past it.
 pub fn edge_scroll(top: f32, bottom: f32, y: f32) -> f32 {
     let speed = |past: f32| (past * SCROLL_RATE).clamp(SCROLL_MIN, SCROLL_MAX);
-    if y < top {
-        -speed(top - y)
-    } else if y > bottom {

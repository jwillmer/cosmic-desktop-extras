+    /// Replace all for a query searched line by line: every non-empty match of each line, as one
+    /// undo step. The cursor ends after the last replacement. Returns how many were replaced.
+    pub fn replace_all(&self, regex: &Regex, replacement: &Replacement) -> usize {
+        let ending = self.new_line_ending();
+        let mut editor = self.editor.lock().unwrap();
+        // Each line's matches with their replacement, found before any change
+        let found: Vec<(usize, Vec<(usize, usize, String)>)> = editor.with_buffer(|buffer| {
+            buffer
+                .lines
+                .iter()
+                .enumerate()
+                .filter_map(|(line, buffer_line)| {
+                    let text = buffer_line.text();
+                    let matches: Vec<_> = crate::find_count::line_matches(regex, text)
+                        .map(|(start, end)| {
+                            (start, end, replacement.text_at(regex, text, start, ending))
+                        })
+                        .collect();
+                    (!matches.is_empty()).then_some((line, matches))
+                })
+                .collect()
+        });
+        let (Some((first, _)), Some((last, _))) = (found.first(), found.last()) else {
+            return 0;
+        };
+        // Never change hidden text
+        editor.with_buffer_mut(|buffer| crate::folding::unfold_lines(buffer, *first, *last));
+        editor.start_change();
+        // From the first match on; a replacement with line breaks moves the lines after it,
+        // `added` counts how many
+        let mut added = 0;
+        let mut cursor = Cursor::new(0, 0);
+        let mut count = 0;
+        for (line, matches) in &found {
+            // Where the text after the previous match on this line now starts
+            let mut after = Cursor::new(line + added, 0);
+            let mut previous_end = 0;
+            for (start, end, replace) in matches {
+                let start_cursor = Cursor::new(after.line, after.index + start - previous_end);
+                let end_cursor = Cursor::new(after.line, after.index + end - previous_end);
+                editor.delete_range(start_cursor, end_cursor);
+                after = editor.insert_at(start_cursor, replace, None);
+                previous_end = *end;
+                count += 1;
+            }
+            added = after.line - line;
+            cursor = after;
+        }
+        editor.set_cursor(cursor);
+        editor.set_selection(Selection::None);
+        editor.finish_change();
+        count
+    }
+

diff --git a/src/markdown_map.rs b/src/markdown_map.rs
index e404344..e7f5759 100644
--- a/src/markdown_map.rs
+++ b/src/markdown_map.rs
@@ -289,6 +289,25 @@ pub fn current_heading(headings: &[Heading], line: usize) -> Option<usize> {
         .checked_sub(1)
 }
 
+/// Index of the heading to show as current for a preview that shows source lines `top` to
+/// `bottom`: the top-most heading in view, else the one the top line sits under. At the end of
+/// the scroll range the last one in view, as the headings further down can never reach the top.
+pub fn visible_heading(
+    headings: &[Heading],
+    top: usize,
+    bottom: usize,
+    at_end: bool,
+) -> Option<usize> {
+    if at_end {
+        return current_heading(headings, bottom);
+    }
+    let first = headings.partition_point(|heading| heading.line < top);
+    match headings.get(first) {
+        Some(heading) if heading.line < bottom => Some(first),
+        _ => current_heading(headings, top),
+    }
+}

+    #[test]
+    fn outline_in_preview_follows_the_preview_scroll() {
+        // Headings on lines 0, 4, 8, 12, each over a paragraph
+        let text = "# One\n\nText\n\n# Two\n\nText\n\n# Three\n\nText\n\n# Four\n\nText\n";
+        let mut preview = Preview::new(ViewMode::Preview);
+        preview.parse(text, None);
+        preview.outline(text);
+        // Before the first draw: the first heading
+        assert_eq!(preview.current_heading(14), Some(0));
+        // 16 lines high in 800 px, 50 px each; 300 px (6 lines) in view
+        let viewport = |y| Viewport {
+            content_height: 800.0,
+            ..preview_viewport(y)
+        };
+        preview.scrolled(viewport(0.0), 80);
+        // "One" at the top, whatever the cursor
+        assert_eq!(preview.current_heading(14), Some(0));
+        // Scrolled to "Three" ... "Four" at the top: "Two" is out of view above
+        preview.scrolled(viewport(410.0), 80);
+        assert_eq!(preview.current_heading(0), Some(2));
+        // At the end (Ctrl+End): the last heading, though "Three" is still in view
+        preview.scrolled(viewport(500.0), 80);
+        assert_eq!(preview.current_heading(0), Some(3));
+        // In Split and Source the cursor decides
+        preview.mode = ViewMode::Split;
+        assert_eq!(preview.current_heading(5), Some(1));
+    }

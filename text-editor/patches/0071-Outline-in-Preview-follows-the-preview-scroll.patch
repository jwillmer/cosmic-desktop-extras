+    #[test]
+    fn preview_highlights_top_most_visible_heading() {
+        // Headings on lines 0, 4, 7, 15, 18
+        let outline = headings(OUTLINE);
+        // A heading in view wins over the one above the top
+        assert_eq!(visible_heading(&outline, 1, 6, false), Some(1));
+        assert_eq!(visible_heading(&outline, 4, 10, false), Some(1));
+        // None in view: the section the top line is in
+        assert_eq!(visible_heading(&outline, 8, 14, false), Some(2));
+        assert_eq!(visible_heading(&outline, 0, 3, false), Some(0));
+        // The heading on the bottom edge is not in view yet
+        assert_eq!(visible_heading(&outline, 8, 15, false), Some(2));
+        // Scrolled to the end: the last heading in view, even below the first one in view
+        assert_eq!(visible_heading(&outline, 14, 19, true), Some(4));
+        assert_eq!(visible_heading(&outline, 14, 16, true), Some(3));
+        assert_eq!(visible_heading(&[], 0, 10, false), None);
+        assert_eq!(
+            visible_heading(&headings("Text\n\n# Later\n"), 0, 1, false),
+            None
+        );
+    }

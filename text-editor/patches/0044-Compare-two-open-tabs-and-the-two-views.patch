+    fn editor(text: &str, path: &str) -> Option<Tab> {
+        crate::SYNTAX_SYSTEM.get_or_init(cosmic_text::SyntaxSystem::new);
+        let mut config = crate::Config::default();
+        let theme = crate::SYNTAX_SYSTEM
+            .get()
+            .unwrap()
+            .theme_set
+            .themes
+            .keys()
+            .next()
+            .unwrap();
+        config.syntax_theme_dark = theme.clone();
+        config.syntax_theme_light = theme.clone();
+        let mut tab = crate::tab::EditorTab::new(&config);
+        tab.path_opt = Some(PathBuf::from(path));
+        tab.editor.lock().unwrap().insert_string(text, None);
+        Some(Tab::Editor(tab))
+    }
+
+    #[test]
+    fn compare_two_tabs_shows_differences() {
+        let mut model = segmented_button::SingleSelectModel::builder().build();
+        let a = insert(&mut model, editor("one\ntwo\nthree", "/srv/demo/a.md"));
+        let b = insert(&mut model, editor("one\nTWO\nthree", "/srv/demo/b.md"));
+        let diff_tab = insert(&mut model, diff_tab(None));
+        let tab = compare_tabs_diff(&model, a, b).unwrap();
+        // Fluent may wrap the names in isolation marks
+        let title = tab.title.replace(['\u{2068}', '\u{2069}'], "");
+        assert_eq!(title, "a.md \u{2194} b.md");
+        assert_eq!(tab.compare_of, None);
+        assert_eq!(rendered(&tab.diff), ["  one", "- two", "+ TWO", "  three"]);
+        // Same text, or a diff tab on either side: nothing to compare
+        assert!(compare_tabs_diff(&model, a, a).is_none());
+        assert!(compare_tabs_diff(&model, a, diff_tab).is_none());
+        // The submenu lists the other editor tabs only
+        assert_eq!(compare_targets(&model, a), [(1, "b.md".to_string())]);
+    }
+
+    #[test]
+    fn compare_uses_unsaved_text() {
+        let dir = std::env::temp_dir().join(format!("compare-unsaved-{}", std::process::id()));
+        fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("saved.txt");
+        fs::write(&path, "same\n").unwrap();
+        let mut model = segmented_button::SingleSelectModel::builder().build();
+        let a = insert(&mut model, editor("same\n", "/srv/demo/a.txt"));
+        let b = insert(&mut model, editor("", "/srv/demo/b.txt"));
+        if let Some(Tab::Editor(tab)) = model.data_mut::<Tab>(b) {
+            tab.open(path.clone());
+            // Typed but not saved: the file on disk still says "same"
+            tab.editor.lock().unwrap().insert_string("edited ", None);
+        }
+        assert_eq!(fs::read_to_string(&path).unwrap(), "same\n");
+        let tab = compare_tabs_diff(&model, a, b).unwrap();
+        assert!(rendered(&tab.diff).contains(&"+ edited same".to_string()));
+        fs::remove_dir_all(&dir).ok();
+    }

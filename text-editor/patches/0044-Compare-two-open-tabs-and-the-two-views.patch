+/// The compare tab of two editor tabs, from the text of `left` to the text of `right` (unsaved
+/// text included). `None` when one is not an editor tab or no line differs.
+pub fn compare_tabs_diff(
+    model: &segmented_button::SingleSelectModel,
+    left: segmented_button::Entity,
+    right: segmented_button::Entity,
+) -> Option<GitDiffTab> {
+    let (Some(Tab::Editor(a)), Some(Tab::Editor(b))) =
+        (model.data::<Tab>(left), model.data::<Tab>(right))
+    else {
+        return None;
+    };
+    let text_a = editor_text(&a.editor.lock().unwrap());
+    let text_b = editor_text(&b.editor.lock().unwrap());
+    let path = b.path_opt.clone().unwrap_or_default();
+    Some(GitDiffTab {
+        title: fl!("compare-tabs-title", left = a.title(), right = b.title()),
+        diff: compare(path, &text_a, &text_b)?,
+        compare_of: None,
+    })
+}
+
+/// The editor tabs another tab can be compared with: position in the tab bar and title.
+pub fn compare_targets(
+    model: &segmented_button::SingleSelectModel,
+    source: segmented_button::Entity,
+) -> Vec<(usize, String)> {
+    model
+        .iter()
+        .enumerate()
+        .filter(|(_, entity)| *entity != source)
+        .filter_map(|(pos, entity)| match model.data::<Tab>(entity) {
+            Some(Tab::Editor(tab)) => Some((pos, tab.title())),
+            _ => None,
+        })
+        .collect()
+}
+
 impl App {
+    /// Compare the editor tab `left` (or the active one) with the tab at position `right`; with
+    /// `None`, the tabs shown by the two views. Refreshes and focuses an open compare tab of the
+    /// same two names. Does nothing when no line differs.
+    pub fn compare_tabs(
+        &mut self,
+        left: Option<segmented_button::Entity>,
+        right: Option<usize>,
+    ) -> Task<Message> {
+        let (left, right) = match right {
+            Some(pos) => (
+                left.unwrap_or_else(|| self.tab_model.active()),
+                self.tab_model.iter().nth(pos),
+            ),
+            None => match &self.split {
+                Some(split) => match (
+                    split.shown(crate::views::Side::Left),
+                    split.shown(crate::views::Side::Right),
+                ) {
+                    (Some(left), right) => (left, right),
+                    _ => return Task::none(),
+                },
+                None => return Task::none(),
+            },
+        };
+        let Some(right) = right else {
+            return Task::none();
+        };
+        let Some(compare_tab) = compare_tabs_diff(&self.tab_model, left, right) else {
+            log::info!("compare: the two tabs have the same text");
+            return Task::none();
+        };
+        let title = compare_tab.title.clone();
+        let existing = self.tab_model.iter().find(|entity| {
+            matches!(
+                self.tab_model.data::<Tab>(*entity),
+                Some(Tab::GitDiff(GitDiffTab { compare_of: None, title: t, .. })) if *t == title
+            )
+        });
+        match existing {
+            Some(entity) => {
+                self.tab_model
+                    .data_set::<Tab>(entity, Tab::GitDiff(compare_tab));
+                self.tab_model.activate(entity);
+            }
+            None => {
+                let icon = self.tab_model.icon(left).cloned();
+                let mut item = self
+                    .tab_model
+                    .insert()
+                    .text(title)
+                    .data::<Tab>(Tab::GitDiff(compare_tab))
+                    .closable();
+                if let Some(icon) = icon {
+                    item = item.icon(icon);
+                }
+                item.activate();
+            }
+        }
+        self.update_tab()
+    }

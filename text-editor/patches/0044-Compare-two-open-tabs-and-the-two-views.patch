+/// "Compare with" and the open tabs, with "Compare the two views" first when split; `action`
+/// gets the tab's position, or `None` for the two views.
+fn compare_menu<A: MenuAction>(
+    views: &crate::views::MenuState,
+    action: impl Fn(Option<usize>) -> A,
+) -> MenuItem<A, String> {
+    let mut items = Vec::new();
+    if views.split {
+        items.push(MenuItem::Button(fl!("compare-views"), None, action(None)));
+        if !views.compare.is_empty() {
+            items.push(MenuItem::Divider);
+        }
+    }
+    for (pos, title) in &views.compare {
+        items.push(MenuItem::Button(title.clone(), None, action(Some(*pos))));
+    }
+    if items.is_empty() {
+        return MenuItem::ButtonDisabled(fl!("compare-with"), None, action(None));
+    }
+    MenuItem::Folder(fl!("compare-with"), items)
+}
+

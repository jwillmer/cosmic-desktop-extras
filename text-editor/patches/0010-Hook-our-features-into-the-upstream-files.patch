 wgpu = ["libcosmic/wgpu", "cosmic-files/wgpu"]
 wayland = ["libcosmic/wayland", "cosmic-files/wayland"]
 
@@ -73,3 +85,7 @@ debug = true
 
 # [patch."https://github.com/pop-os/cosmic-files.git"]
 # cosmic-files = { git = "https://github.com/pop-os/cosmic-files//", branch = "theme-v2" }

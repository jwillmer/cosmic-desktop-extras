From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Fri, 20 Nov 2026 04:02:26 +0100
Subject: [PATCH 10/10] Hook our features into the upstream files

The only patch that changes upstream files: module lines, struct fields, one-line calls into our modules, menu entries, key bindings, strings and dependencies. Everything else lives in our own files, so an upstream release conflicts here alone.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/Cargo.toml b/Cargo.toml
index 955992c..48a4161 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -31,6 +31,18 @@ i18n-embed = { version = "0.16", features = [
 ] }
 i18n-embed-fl = "0.10"
 rust-embed = "8"
+# The regex crate's own parser, to tell whether a find query can match a line break
+regex-syntax = "0.8"
+ron = "0.12"
+# Already in the tree through other crates: the same version, only a new edge in Cargo.lock
+unicode-width = "0.2.3"
+similar = { version = "3", default-features = false, features = ["std"] }
+# Same parser as the Markdown widget, for the preview's HTML, inline image and alert pass
+pulldown-cmark = { version = "0.12", default-features = false }
+# Mermaid diagrams in the preview, rendered to SVG in process (MIT, pure Rust)
+mermaid-rs-renderer = { version = "0.3.1", default-features = false }
+# Images from the web in the preview, through the gvfs HTTP backend (already in the tree)
+gio = { version = "0.21", optional = true }
 

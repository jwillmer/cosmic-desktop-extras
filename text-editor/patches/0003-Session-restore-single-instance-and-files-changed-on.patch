+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Changed on disk: when the file of a tab with unsaved changes changes or goes away on disk,
+//! a bar above the editor offers Reload (take the disk version), Compare (with saved) and Keep
+//! mine (the next save overwrites the file). A tab without unsaved changes reloads silently, as
+//! upstream does.
+//!
+//! Each tab remembers the base: a content hash of the file as it last loaded or saved it. The
+//! file watcher, switching to a tab, saving and session restore compare the file against it, so
+//! our own saves never trigger the bar, and a save never overwrites a change nobody has seen.
+//! The base goes into the session with the draft, so an unanswered bar survives a restart.
+
+use cosmic::{
+    Application, Element,
+    app::Task,
+    iced::{Alignment, Length},
+    theme,
+    widget::{self, button, segmented_button::Entity},
+};
+use notify::{
+    EventKind, RecursiveMode, Watcher,
+    event::{ModifyKind, RemoveKind},
+};
+use serde::{Deserialize, Serialize};
+use std::{
+    fs,
+    hash::{DefaultHasher, Hash, Hasher},
+    io,
+    path::Path,
+    time::SystemTime,
+};
+
+use crate::{
+    App, Message as AppMessage, fl,
+    tab::{EditorTab, Tab},
+};
+
+/// The file contents as a hash; `None` when there is no file on disk.
+pub type Fingerprint = Option<u64>;
+
+pub fn hash_bytes(bytes: &[u8]) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    bytes.hash(&mut hasher);
+    hasher.finish()
+}
+
+/// The file a tab's text is based on.
+#[derive(Clone, Copy, Debug, Default, Deserialize, PartialEq, Serialize)]
+pub enum Base {
+    /// Not known: a restored draft over a file that changed since, or an unreadable file.
+    #[default]
+    Unknown,
+    Missing,
+    Hash(u64),
+}
+
+impl Base {
+    fn of(disk: Fingerprint) -> Self {
+        disk.map_or(Self::Missing, Self::Hash)
+    }
+}
+
+/// What the bar above the editor says.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Bar {
+    /// Reload, Compare and Keep mine.
+    Changed,
+    /// Keep mine only: saving recreates the file.
+    Deleted,
+}
+
+impl Bar {
+    fn for_disk(disk: Fingerprint) -> Self {
+        if disk.is_some() {
+            Self::Changed
+        } else {
+            Self::Deleted
+        }
+    }
+}
+
+#[derive(Debug, PartialEq)]
+pub enum Action {
+    Nothing,
+    SilentReload,
+    ShowBar(Bar),
+}
+
+/// Decide what a change on disk does to a tab.
+pub fn decide(dirty: bool, base: Base, disk: Fingerprint) -> Action {
+    if base == Base::of(disk) {
+        return Action::Nothing;
+    }
+    match (dirty, disk) {
+        (true, disk) => Action::ShowBar(Bar::for_disk(disk)),
+        (false, Some(_)) => Action::SilentReload,
+        // Upstream keeps the text of a clean tab whose file is gone
+        (false, None) => Action::Nothing,
+    }
+}
+
+/// Watcher events after which the watch on a file may be gone: a program that saves by
+/// writing a new file and renaming it over the old one replaces the watched inode.
+pub fn needs_rewatch(kind: &EventKind) -> bool {
+    matches!(
+        kind,
+        EventKind::Remove(RemoveKind::Any | RemoveKind::File)
+            | EventKind::Modify(ModifyKind::Name(_))
+    )
+}
+
+/// Per tab: the file the text is based on, and the bar shown for it.
+#[derive(Debug, Default)]
+pub struct DiskWatch {
+    base: Base,
+    pub bar: Option<Bar>,
+    /// The disk version the bar was shown for: Keep mine and Save accept this one only.
+    shown_for: Fingerprint,
+    /// A save was refused for `shown_for`: the next save writes over it.
+    save_refused: bool,
+    /// Modification time, length and hash of the last read, to skip hashing an unchanged file.
+    stat: Option<(Stat, u64)>,
+}
+
+/// What identifies a version of a file without reading it: modification time, length and
+/// inode, as a file replaced by rename can keep the time and length.
+#[derive(Clone, Copy, Debug, PartialEq)]
+struct Stat(SystemTime, u64, u64);
+
+impl Stat {
+    fn of(metadata: &fs::Metadata) -> io::Result<Self> {
+        #[cfg(unix)]
+        let inode = std::os::unix::fs::MetadataExt::ino(metadata);
+        #[cfg(not(unix))]
+        let inode = 0;
+        Ok(Self(metadata.modified()?, metadata.len(), inode))
+    }
+}
+
+impl DiskWatch {
+    /// Read the file's fingerprint; the file is hashed only when its time or length changed.
+    /// An unreadable file is an error, not a deleted one.
+    pub fn read(&mut self, path: &Path) -> io::Result<Fingerprint> {
+        let metadata = match fs::metadata(path) {
+            Ok(metadata) => metadata,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                self.stat = None;
+                return Ok(None);
+            }
+            Err(err) => return Err(err),
+        };
+        let stat = Stat::of(&metadata)?;
+        if let Some((cached, hash)) = self.stat
+            && cached == stat
+        {
+            return Ok(Some(hash));
+        }
+        let bytes = match fs::read(path) {
+            Ok(bytes) => bytes,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                self.stat = None;
+                return Ok(None);
+            }
+            Err(err) => return Err(err),
+        };
+        let hash = hash_bytes(&bytes);
+        // The file may have changed between the stat and the read: cache only a matching length
+        self.stat = Some((stat, hash)).filter(|_| stat.1 == bytes.len() as u64);
+        Ok(Some(hash))
+    }
+
+    /// The base, as the session keeps it with a draft.
+    pub fn base(&self) -> Base {
+        self.base
+    }
+
+    /// The tab took the file's text (open, reload).
+    pub fn loaded(&mut self, disk: Fingerprint) {
+        self.base = Base::of(disk);
+        self.bar = None;
+    }
+
+    /// The tab and the file at `path` hold `text`: after a reload or our own save.
+    pub fn took(&mut self, path: &Path, text: &str) {
+        let hash = hash_bytes(text.as_bytes());
+        self.loaded(Some(hash));
+        self.stat = fs::metadata(path)
+            .and_then(|metadata| Stat::of(&metadata))
+            .ok()
+            .filter(|stat| stat.1 == text.len() as u64)
+            .map(|stat| (stat, hash));
+    }
+
+    /// The tab writes to another file now (Save as): base it on what is there.
+    pub fn retarget(&mut self, path: &Path) {
+        self.stat = None;
+        match self.read(path) {
+            Ok(disk) => self.loaded(disk),
+            Err(err) => log::warn!("failed to read {:?}: {}", path, err),
+        }
+    }
+
+    fn show(&mut self, disk: Fingerprint) {
+        if self.bar.is_none() || self.shown_for != disk {
+            self.save_refused = false;
+        }
+        self.bar = Some(Bar::for_disk(disk));
+        self.shown_for = disk;
+    }
+
+    /// Keep the unsaved text over the disk version the bar was shown for; the bar comes back
+    /// when the file changes again, also when it changed again before the click.
+    pub fn keep_mine(&mut self) {
+        if self.bar.take().is_some() {
+            self.base = Base::of(self.shown_for);
+        }
+    }
+
+    /// A restored draft whose file changed on disk since the draft was written, by modification
+    /// time: a session from before the base was kept.
+    pub fn restored_over_change(&mut self, disk: Fingerprint) {
+        self.base = Base::Unknown;
+        self.show(disk);
+    }
+
+    /// A restored draft with the base the session kept for it.
+    pub fn restored(&mut self, base: Base, disk: Fingerprint) {
+        self.base = base;
+        self.check(true, disk);
+    }
+
+    /// Compare the file on disk with the base and show or hide the bar.
+    pub fn check(&mut self, dirty: bool, disk: Fingerprint) -> Action {
+        let action = decide(dirty, self.base, disk);
+        match action {
+            Action::ShowBar(_) => self.show(disk),
+            Action::Nothing | Action::SilentReload => self.bar = None,
+        }
+        action
+    }
+
+    /// Whether a save may write over the file on disk: when it is the base, or the version a
+    /// save was already refused for (the second save answers the bar like Keep mine). Otherwise
+    /// the first save only shows the bar, also when the bar is up already: the watcher can show
+    /// it a moment before the save, too late for anyone to have read it.
+    pub fn may_write(&mut self, disk: Fingerprint) -> bool {
+        if self.base == Base::of(disk)
+            || (self.bar.is_some() && self.shown_for == disk && self.save_refused)
+        {
+            return true;
+        }
+        self.show(disk);
+        self.save_refused = true;
+        false
+    }
+}
+
+impl EditorTab {
+    fn disk_now(&mut self) -> Option<Fingerprint> {
+        let path = self.path_opt.as_ref()?;
+        self.disk
+            .read(path)
+            .inspect_err(|err| log::warn!("failed to read {:?}: {}", path, err))
+            .ok()
+    }
+
+    /// Session restore, for a session without the draft's base.
+    pub fn disk_restored_over_change(&mut self) {
+        if let Some(disk) = self.disk_now() {
+            self.disk.restored_over_change(disk);
+        }
+    }
+
+    /// Session restore: the draft is in, compare the file with the base the session kept.
+    pub fn disk_restored(&mut self, base: Option<Base>) {
+        if let Some(base) = base
+            && let Some(disk) = self.disk_now()
+        {
+            self.disk.restored(base, disk);
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    Reload(Entity),
+    KeepMine(Entity),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::DiskChange(message)
+    }
+}
+
+impl App {
+    /// Compare a tab's file with what the tab is based on: after a watcher event, when the tab
+    /// is activated.
+    pub fn disk_check(&mut self, entity: Entity) {
+        let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) else {
+            return;
+        };
+        let Some(path) = tab.path_opt.clone() else {
+            return;
+        };
+        let disk = match tab.disk.read(&path) {
+            Ok(disk) => disk,
+            Err(err) => {
+                log::warn!("failed to check {:?} for changes on disk: {}", path, err);
+                return;
+            }
+        };
+        match tab.disk.check(tab.changed(), disk) {
+            Action::SilentReload => {
+                tab.reload();
+                tab.markdown_refresh();
+            }
+            Action::ShowBar(bar) => {
+                log::warn!("{:?} {:?} on disk before being saved", path, bar);
+            }
+            Action::Nothing => {}
+        }
+    }
+
+    /// Watch a tab's file again after it was replaced on disk.
+    pub fn disk_rewatch(&mut self, path: &Path) {
+        let Some((watcher, paths)) = self.watcher_opt.as_mut() else {
+            return;
+        };
+        // Files in a project are covered by the project's watch
+        if !paths.contains(&(path.to_path_buf(), RecursiveMode::NonRecursive)) {
+            return;
+        }
+        let _ = watcher.unwatch(path);
+        if let Err(err) = watcher.watch(path, RecursiveMode::NonRecursive) {
+            log::debug!("failed to watch {:?} again: {}", path, err);
+        }
+    }
+
+    pub fn update_disk_change(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            // Clones reload together: one alone would mirror the file over their edits
+            Message::Reload(entity) => return self.reload_clones(entity),
+            Message::KeepMine(entity) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                    tab.disk.keep_mine();
+                }
+            }
+        }
+        Task::none()
+    }
+
+    /// The bar above the editor of a tab whose file changed on disk.
+    pub fn disk_bar(&self, entity: Entity, tab: &EditorTab) -> Option<Element<'_, AppMessage>> {
+        let bar = tab.disk.bar?;
+        let spacing = self.core().system_theme().cosmic().spacing;
+        let name = tab.title();
+        let mut row = widget::row::with_capacity(4)
+            .align_y(Alignment::Center)
+            .spacing(spacing.space_xs);
+        row = match bar {
+            Bar::Changed => row
+                .push(widget::text::body(fl!("disk-changed", name = name)).width(Length::Fill))
+                .push(button::standard(fl!("disk-reload")).on_press(Message::Reload(entity).into()))
+                .push(
+                    button::standard(fl!("disk-compare"))
+                        .on_press(AppMessage::CompareWithSaved(Some(entity))),
+                ),
+            Bar::Deleted => {
+                row.push(widget::text::body(fl!("disk-deleted", name = name)).width(Length::Fill))
+            }
+        };
+        row = row.push(
+            button::suggested(fl!("disk-keep-mine")).on_press(Message::KeepMine(entity).into()),
+        );
+        Some(
+            widget::container(row)
+                .padding([spacing.space_xxs, spacing.space_s])
+                .width(Length::Fill)
+                .class(theme::Container::Card)
+                .into(),
+        )
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    //! Behaviours:
+    //! - a tab without unsaved changes reloads silently when its file changes on disk
+    //! - a tab with unsaved changes shows the bar instead (Reload, Compare, Keep mine)
+    //! - a restored draft over a file that changed on disk shows the bar
+    //! - an unanswered bar survives a restart: the session keeps the draft's base
+    //! - Keep mine hides the bar until the file changes on disk again, and accepts only the
+    //!   disk version the bar was shown for
+    //! - Reload takes the disk text and hides the bar
+    //! - a save never overwrites a disk change on its own: the first save shows the bar, also
+    //!   when it is up already; the second save overwrites the file and hides the bar
+    //! - a file replaced by rename is caught also when its time and length stay the same
+    //! - a deleted file offers Keep mine only; saving recreates it
+    //! - our own save never shows the bar
+    //! - a file replaced by rename is watched again
+
+    use super::*;
+    use notify::event::{CreateKind, DataChange, RenameMode};
+    use std::path::PathBuf;
+
+    struct TempFile(PathBuf);
+
+    impl TempFile {
+        fn new(name: &str, text: &str) -> Self {
+            let path =
+                std::env::temp_dir().join(format!("disk-change-{name}-{}.txt", std::process::id()));
+            fs::write(&path, text).unwrap();
+            Self(path)
+        }
+
+        fn write(&self, text: &str) {
+            fs::write(&self.0, text).unwrap();
+        }
+
+        fn disk(&self) -> Fingerprint {
+            DiskWatch::default().read(&self.0).unwrap()
+        }
+    }
+
+    impl Drop for TempFile {
+        fn drop(&mut self) {
+            let _ = fs::remove_file(&self.0);
+        }
+    }
+
+    /// A tab that opened `file`, as `EditorTab::open` records it.
+    fn opened(file: &TempFile) -> DiskWatch {
+        let mut watch = DiskWatch::default();
+        let disk = watch.read(&file.0).unwrap();
+        watch.loaded(disk);
+        watch
+    }
+
+    /// `EditorTab::save`: write only when allowed, then record it.
+    fn save(watch: &mut DiskWatch, file: &TempFile, text: &str) -> bool {
+        let disk = watch.read(&file.0).unwrap();
+        if !watch.may_write(disk) {
+            return false;
+        }
+        file.write(text);
+        watch.took(&file.0, text);
+        true
+    }
+
+    #[test]
+    fn clean_tab_reloads_silently_when_disk_changes() {
+        let file = TempFile::new("clean", "one\n");
+        let mut watch = opened(&file);
+        file.write("two\n");
+        assert_eq!(watch.check(false, file.disk()), Action::SilentReload);
+        assert_eq!(watch.bar, None);
+    }
+
+    #[test]
+    fn dirty_tab_shows_bar_when_disk_changes() {
+        let file = TempFile::new("dirty", "one\n");
+        let mut watch = opened(&file);
+        file.write("two\n");
+        assert_eq!(
+            watch.check(true, file.disk()),
+            Action::ShowBar(Bar::Changed)
+        );
+        assert_eq!(watch.bar, Some(Bar::Changed));
+        // A second event for the same change keeps the bar
+        assert_eq!(
+            watch.check(true, file.disk()),
+            Action::ShowBar(Bar::Changed)
+        );
+    }
+
+    #[test]
+    fn restored_draft_over_changed_file_shows_bar() {
+        let file = TempFile::new("restored", "changed since the draft\n");
+        // Session restore opens the file, then puts the draft in
+        let mut watch = opened(&file);
+        watch.restored_over_change(file.disk());
+        assert_eq!(watch.bar, Some(Bar::Changed));
+        // Switching to the tab keeps the bar: the draft's base is unknown
+        assert_eq!(
+            watch.check(true, file.disk()),
+            Action::ShowBar(Bar::Changed)
+        );
+    }
+
+    #[test]
+    fn unanswered_disk_change_survives_restart() {
+        let file = TempFile::new("restart", "one\n");
+        let mut watch = opened(&file);
+        file.write("two\n");
+        watch.check(true, file.disk());
+        // The session keeps the base with the draft; typing on does not change it
+        let kept = watch.base();
+        let ron = ron::to_string(&kept).unwrap();
+        // Next start: the file opens fresh, then the draft comes back with its base
+        let mut restarted = opened(&file);
+        restarted.restored(ron::from_str(&ron).unwrap(), file.disk());
+        assert_eq!(restarted.bar, Some(Bar::Changed));
+        assert!(!restarted.may_write(None), "a save must not pass unseen");
+        // A draft whose base is still on disk comes back without a bar
+        let mut answered = opened(&file);
+        answered.restored(Base::of(file.disk()), file.disk());
+        assert_eq!(answered.bar, None);
+    }
+
+    #[test]
+    fn keep_mine_hides_bar_until_next_disk_change() {
+        let file = TempFile::new("keep", "one\n");
+        let mut watch = opened(&file);
+        file.write("two\n");
+        watch.check(true, file.disk());
+        watch.keep_mine();
+        assert_eq!(watch.bar, None);
+        assert_eq!(watch.check(true, file.disk()), Action::Nothing);
+        assert_eq!(watch.bar, None);
+        file.write("three\n");
+        assert_eq!(
+            watch.check(true, file.disk()),
+            Action::ShowBar(Bar::Changed)
+        );
+    }
+
+    #[test]
+    fn keep_mine_accepts_only_the_version_shown() {
+        let file = TempFile::new("keep-shown", "one\n");
+        let mut watch = opened(&file);
+        file.write("two\n");
+        watch.check(true, file.disk());
+        // Another write lands before the click
+        file.write("three!\n");
+        watch.keep_mine();
+        assert_eq!(
+            watch.check(true, file.disk()),
+            Action::ShowBar(Bar::Changed)
+        );
+    }
+
+    #[test]
+    fn reload_takes_disk_text() {
+        let file = TempFile::new("reload", "one\n");
+        let mut watch = opened(&file);
+        file.write("two\n");
+        watch.check(true, file.disk());
+        // `EditorTab::reload` reads the file and records what it read
+        let text = fs::read_to_string(&file.0).unwrap();
+        assert_eq!(text, "two\n");
+        watch.took(&file.0, &text);
+        assert_eq!(watch.bar, None);
+        assert_eq!(watch.check(false, file.disk()), Action::Nothing);
+    }
+
+    #[test]
+    fn second_save_while_bar_shown_overwrites_and_hides_bar() {
+        let file = TempFile::new("save", "one\n");
+        let mut watch = opened(&file);
+        file.write("two\n");
+        watch.check(true, file.disk());
+        // The bar may have come up just before the save: the first save only shows it
+        assert!(!save(&mut watch, &file, "mine\n"));
+        assert_eq!(fs::read_to_string(&file.0).unwrap(), "two\n");
+        // A repeated watcher event for the same change keeps the refusal
+        watch.check(true, file.disk());
+        assert!(save(&mut watch, &file, "mine\n"));
+        assert_eq!(fs::read_to_string(&file.0).unwrap(), "mine\n");
+        assert_eq!(watch.bar, None);
+        assert_eq!(watch.check(false, file.disk()), Action::Nothing);
+    }
+
+    #[test]
+    fn save_refuses_to_overwrite_unseen_disk_change() {
+        let file = TempFile::new("unseen", "one\n");
+        let mut watch = opened(&file);
+        // No watcher event arrives (the watch is gone)
+        file.write("theirs\n");
+        assert!(!save(&mut watch, &file, "mine\n"));
+        assert_eq!(fs::read_to_string(&file.0).unwrap(), "theirs\n");
+        assert_eq!(watch.bar, Some(Bar::Changed));
+        // Save again, now that the bar was shown, writes
+        assert!(save(&mut watch, &file, "mine\n"));
+        assert_eq!(fs::read_to_string(&file.0).unwrap(), "mine\n");
+        // A change after the bar was shown is unseen again
+        file.write("theirs\n");
+        watch.check(true, file.disk());
+        file.write("theirs again\n");
+        assert!(!save(&mut watch, &file, "mine\n"));
+    }
+
+    /// Another program saves by writing a temp file and renaming it over ours.
+    fn replace_by_rename(file: &TempFile, text: &str) {
+        let tmp = file.0.with_extension("tmp");
+        fs::write(&tmp, text).unwrap();
+        // The worst case for a stat cache: the same modification time as before
+        let modified = fs::metadata(&file.0).unwrap().modified().unwrap();
+        fs::File::options()
+            .write(true)
+            .open(&tmp)
+            .unwrap()
+            .set_modified(modified)
+            .unwrap();
+        fs::rename(&tmp, &file.0).unwrap();
+    }
+
+    #[test]
+    fn save_after_rename_replace_shows_bar_first() {
+        for (name, theirs) in [("same-size", "two!\n"), ("longer", "two\nthree\n")] {
+            for watcher_first in [false, true] {
+                let file = TempFile::new(&format!("rename-{name}-{watcher_first}"), "one\n");
+                let mut watch = opened(&file);
+                // Our own save fills the stat cache, as before the outside replace
+                assert!(save(&mut watch, &file, "mine\n"));
+                replace_by_rename(&file, theirs);
+                if watcher_first {
+                    let disk = watch.read(&file.0).unwrap();
+                    watch.check(true, disk);
+                    assert_eq!(watch.bar, Some(Bar::Changed), "{name}");
+                }
+                assert!(
+                    !save(&mut watch, &file, "mine 2\n"),
+                    "{name} {watcher_first}"
+                );
+                assert_eq!(fs::read_to_string(&file.0).unwrap(), theirs);
+                assert_eq!(watch.bar, Some(Bar::Changed));
+                assert!(save(&mut watch, &file, "mine 2\n"));
+                assert_eq!(fs::read_to_string(&file.0).unwrap(), "mine 2\n");
+            }
+        }
+    }
+
+    #[test]
+    fn deleted_file_offers_keep_mine_only() {
+        let file = TempFile::new("deleted", "one\n");
+        let mut watch = opened(&file);
+        fs::remove_file(&file.0).unwrap();
+        assert_eq!(file.disk(), None);
+        assert_eq!(
+            watch.check(true, file.disk()),
+            Action::ShowBar(Bar::Deleted)
+        );
+        watch.keep_mine();
+        assert_eq!(watch.check(true, file.disk()), Action::Nothing);
+        // A clean tab keeps its text, as upstream does
+        let mut clean = opened(&TempFile::new("deleted-clean", "one\n"));
+        assert_eq!(clean.check(false, None), Action::Nothing);
+        // Saving recreates the file without a bar
+        assert!(save(&mut watch, &file, "mine\n"));
+        assert_eq!(watch.check(false, file.disk()), Action::Nothing);
+    }
+
+    #[test]
+    fn own_save_does_not_trigger_bar() {
+        let file = TempFile::new("own", "one\n");
+        let mut watch = opened(&file);
+        assert!(save(&mut watch, &file, "one\ntwo\n"));
+        // The watcher reports our own write; more typing since makes the tab dirty
+        assert_eq!(watch.check(true, file.disk()), Action::Nothing);
+        assert_eq!(watch.bar, None);
+    }
+
+    #[test]
+    fn rewatch_after_atomic_replace() {
+        // Rename over the file, or delete it: the inode under the watch is gone
+        assert!(needs_rewatch(&EventKind::Remove(RemoveKind::File)));
+        assert!(needs_rewatch(&EventKind::Modify(ModifyKind::Name(
+            RenameMode::To
+        ))));
+        // Writes in place keep the watch
+        assert!(!needs_rewatch(&EventKind::Modify(ModifyKind::Data(
+            DataChange::Any
+        ))));
+        assert!(!needs_rewatch(&EventKind::Create(CreateKind::File)));
+    }
+}

+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Single instance: a second launch hands its files to the running editor.
+
+use cosmic::{
+    Application,
+    app::{CosmicFlags, Task},
+    dbus_activation, iced,
+};
+use std::path::{Path, PathBuf};
+
+use crate::{App, Flags, Message};
+
+const OPEN: &str = "open";
+
+impl CosmicFlags for Flags {
+    type SubCommand = &'static str;
+    type Args = Vec<String>;
+
+    fn action(&self) -> Option<&Self::SubCommand> {
+        (!self.files.is_empty()).then_some(&OPEN)
+    }
+
+    fn args(&self) -> Vec<&str> {
+        self.files.iter().map(String::as_str).collect()
+    }
+}
+
+/// Command line arguments as absolute paths: the running editor has its own working directory.
+pub fn absolute_args(args: impl IntoIterator<Item = String>, cwd: &Path) -> Vec<String> {
+    args.into_iter()
+        .map(|arg| {
+            let path = PathBuf::from(&arg);
+            if path.is_absolute() {
+                arg
+            } else {
+                cwd.join(path).to_string_lossy().into_owned()
+            }
+        })
+        .collect()
+}
+
+/// Whether an activation should bring the window forward. Every launch that reaches the
+/// running editor should, files or not. libcosmic only does it when the launcher passed an
+/// activation token, and it takes that token before the message reaches us, so the editor
+/// always raises itself as well.
+pub fn raises_window(details: &dbus_activation::Details) -> bool {
+    match details {
+        dbus_activation::Details::Activate | dbus_activation::Details::Open { .. } => true,
+        dbus_activation::Details::ActivateAction { action, .. } => action == OPEN,
+    }
+}
+
+/// The tab that already shows `canonical`, so opening it again focuses that tab.
+pub fn existing_tab<'a, E>(
+    tabs: impl IntoIterator<Item = (E, Option<&'a Path>)>,
+    canonical: &Path,
+) -> Option<E> {
+    tabs.into_iter()
+        .find(|(_, path)| *path == Some(canonical))
+        .map(|(entity, _)| entity)
+}
+
+impl App {
+    /// Opens files as tabs (an open file gets its tab focused) and folders as projects.
+    fn open_paths(&mut self, paths: impl IntoIterator<Item = PathBuf>) -> Task<Message> {
+        for path in paths {
+            if path.is_dir() {
+                self.open_project(path);
+            } else {
+                self.open_tab(Some(path));
+            }
+        }
+        self.update_nav_bar_placeholder();
+        self.update_tab()
+    }
+
+    /// Unminimizes the main window and activates it with a token of our own. cosmic-comp gives
+    /// an unsandboxed client a token that takes focus; a sandboxed one only gets the attention
+    /// flag. Activating the window that a launcher's token already focused changes nothing.
+    fn raise_main_window(&self) -> Task<Message> {
+        let Some(id) = self.core().main_window_id() else {
+            return Task::none();
+        };
+        let unminimize = iced::window::minimize(id, false);
+
+        #[cfg(feature = "wayland")]
+        {
+            use iced::platform_specific::shell::commands::activation;
+            unminimize.chain(
+                activation::request_token(Some(Self::APP_ID.to_string()), Some(id)).then(
+                    move |token| {
+                        token.map_or_else(Task::none, |token| activation::activate(id, token))
+                    },
+                ),
+            )
+        }
+
+        #[cfg(not(feature = "wayland"))]
+        {
+            unminimize.chain(iced::window::gain_focus(id))
+        }
+    }
+
+    /// Another launch of the editor: open its files and bring this window forward.
+    pub fn single_instance_activation(&mut self, msg: dbus_activation::Message) -> Task<Message> {
+        let raise = if raises_window(&msg.msg) {
+            self.raise_main_window()
+        } else {
+            Task::none()
+        };
+        let open = match msg.msg {
+            dbus_activation::Details::ActivateAction { action, args } if action == OPEN => {
+                self.open_paths(args.into_iter().map(PathBuf::from))
+            }
+            dbus_activation::Details::Open { url } => {
+                self.open_paths(url.iter().filter_map(|url| url.to_file_path().ok()))
+            }
+            _ => Task::none(),
+        };
+        Task::batch([open, raise])
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    // Behaviours covered:
+    // - relative arguments resolve against the launching process's working directory
+    // - a launch with files hands them to the running editor; one without only raises its window
+    // - a second launch with an already open file focuses its tab instead of opening a duplicate
+    // - every launch that reaches the running editor brings its window forward, token or not
+
+    use super::*;
+    use crate::{Config, ConfigState};
+    use std::fs;
+
+    fn flags(files: &[&str]) -> Flags {
+        Flags {
+            config_handler: None,
+            config: Config::default(),
+            config_state_handler: None,
+            config_state: ConfigState::default(),
+            files: files.iter().map(|file| file.to_string()).collect(),
+        }
+    }
+
+    #[test]
+    fn single_instance_args_become_absolute() {
+        let args = ["notes.md", "../b.txt", "/etc/hosts", "sub dir/c.md"].map(String::from);
+        assert_eq!(
+            absolute_args(args, Path::new("/srv/demo")),
+            [
+                "/srv/demo/notes.md",
+                "/srv/demo/../b.txt",
+                "/etc/hosts",
+                "/srv/demo/sub dir/c.md"
+            ]
+        );
+    }
+
+    #[test]
+    fn launch_with_files_sends_them_to_the_running_editor() {
+        let flags = flags(&["/srv/demo/notes.md", "/srv/demo/b.txt"]);
+        assert_eq!(flags.action(), Some(&OPEN));
+        assert_eq!(flags.args(), ["/srv/demo/notes.md", "/srv/demo/b.txt"]);
+    }
+
+    #[test]
+    fn launch_without_files_only_raises_the_window() {
+        let flags = flags(&[]);
+        assert_eq!(flags.action(), None);
+        assert!(flags.args().is_empty());
+    }
+
+    #[test]
+    fn activation_without_token_raises_the_window() {
+        // libcosmic takes the token before the editor sees the message, so these carry none
+        let open = dbus_activation::Details::ActivateAction {
+            action: OPEN.to_string(),
+            args: vec!["/srv/demo/notes.md".to_string()],
+        };
+        assert!(raises_window(&open));
+        assert!(raises_window(&dbus_activation::Details::Activate));
+        assert!(raises_window(&dbus_activation::Details::Open {
+            url: Vec::new()
+        }));
+    }
+
+    #[test]
+    fn unknown_action_does_not_raise_the_window() {
+        let other = dbus_activation::Details::ActivateAction {
+            action: "other".to_string(),
+            args: Vec::new(),
+        };
+        assert!(!raises_window(&other));
+    }
+
+    #[test]
+    fn second_launch_with_open_file_focuses_its_tab() {
+        let dir = std::env::temp_dir().join(format!("single-instance-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(dir.join("sub")).unwrap();
+        fs::write(dir.join("notes.md"), "# Notes\n").unwrap();
+        fs::write(dir.join("other.md"), "# Other\n").unwrap();
+        let dir = fs::canonicalize(dir).unwrap();
+        let notes = dir.join("notes.md");
+        let other = dir.join("other.md");
+        let tabs = [
+            ("untitled", None),
+            ("notes", Some(notes.as_path())),
+            ("other", Some(other.as_path())),
+        ];
+
+        // The second launch runs in another folder and names the file relative to it
+        for (cwd, arg) in [
+            (dir.clone(), "notes.md"),
+            (dir.join("sub"), "../notes.md"),
+            (dir.join("sub"), "./../sub/../notes.md"),
+        ] {
+            let args = absolute_args([arg.to_string()], &cwd);
+            // The editor canonicalizes a path before looking for its tab
+            let canonical = fs::canonicalize(&args[0]).unwrap();
+            assert_eq!(existing_tab(tabs, &canonical), Some("notes"), "{arg}");
+        }
+        assert_eq!(existing_tab(tabs, &dir.join("new.md")), None);
+        fs::remove_dir_all(dir).unwrap();
+    }
+}

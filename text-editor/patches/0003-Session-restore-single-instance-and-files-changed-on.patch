+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Session restore: open tabs, and the unsaved text in them, come back on the next start.
+//!
+//! `~/.local/state/cosmic-edit/session/session.ron` lists the tabs; the text of modified and
+//! untitled tabs goes to `backups/<id>.txt`. While edits come in, a snapshot is taken 2 s after
+//! typing pauses and at the latest every 15 s, plus on tab changes and on quit, so a crash loses
+//! about 2 s of typing, 15 s at worst. The text is copied on the UI thread; hashing and writing run
+//! in the background, one snapshot at a time.
+
+use cosmic::iced::advanced::graphics::text::font_system;
+use cosmic::{
+    action,
+    app::Task,
+    iced::{Size, Subscription, advanced::input_method, event, keyboard, mouse, window},
+    widget::{self, segmented_button::Entity},
+};
+use cosmic_text::{Cursor, Edit, FontSystem, Scroll};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{HashMap, HashSet},
+    fs::{self, File, OpenOptions},
+    hash::{DefaultHasher, Hash, Hasher},
+    io::{self, Write},
+    path::{Path, PathBuf},
+    process,
+    sync::{Arc, Mutex, MutexGuard},
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+use crate::{
+    App, Message as AppMessage, fl,
+    markdown::ViewMode,
+    tab::{EditorTab, Tab, editor_text},
+};
+
+const VERSION: u32 = 1;
+/// A snapshot follows this long after the last edit...
+const IDLE_DELAY: Duration = Duration::from_secs(2);
+/// ...or this long after the first edit not yet in a snapshot, while typing goes on.
+const MAX_WAIT: Duration = Duration::from_secs(15);
+const SESSION_FILE: &str = "session.ron";
+/// Bounds for a restored window size, so a damaged session cannot open an unusable window.
+const WINDOW_MIN: Size = Size::new(360.0, 240.0);
+const WINDOW_MAX: Size = Size::new(8192.0, 8192.0);
+const BACKUPS: &str = "backups";
+
+#[derive(Clone, Debug, Default, Deserialize, PartialEq, Serialize)]
+pub struct SessionFile {
+    pub version: u32,
+    pub active: usize,
+    pub tabs: Vec<SessionTab>,
+    /// The main window; `None` in sessions from before it was kept.
+    #[serde(default)]
+    pub window: Option<WindowGeometry>,
+    /// With two views, the tab shown in the view that is not active; `None` with one view and
+    /// in sessions from before two views.
+    #[serde(default)]
+    pub other_active: Option<usize>,
+    /// With two views, the left view's share of the width; `None` with one view and in
+    /// sessions from before the divider could be dragged.
+    #[serde(default)]
+    pub split_ratio: Option<f32>,
+    /// The sidebar's width after it was dragged; `None` before that and in sessions from before
+    /// it could be dragged.
+    #[serde(default)]
+    pub sidebar_width: Option<f32>,
+}
+
+/// The main window's size in logical pixels and whether it was maximized. Its position is not
+/// kept: a Wayland client cannot place its window.
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Serialize)]
+pub struct WindowGeometry {
+    pub width: f32,
+    pub height: f32,
+    pub maximized: bool,
+}
+
+impl WindowGeometry {
+    /// A resize was seen. A maximized window keeps the size it had before, so it comes back to
+    /// that size when unmaximized after the next start.
+    pub fn resized(previous: Option<Self>, size: Size, maximized: bool) -> Self {
+        match previous {
+            Some(previous) if maximized => Self {
+                maximized,
+                ..previous
+            },
+            _ => Self {
+                width: size.width,
+                height: size.height,
+                maximized,
+            },
+        }
+    }
+
+    /// The size to open the window with, within sane bounds; `None` when it is not a number.
+    pub fn size(&self) -> Option<Size> {
+        (self.width.is_finite() && self.height.is_finite()).then(|| {
+            Size::new(
+                self.width.clamp(WINDOW_MIN.width, WINDOW_MAX.width),
+                self.height.clamp(WINDOW_MIN.height, WINDOW_MAX.height),
+            )
+        })
+    }
+}
+
+/// The window of the last session, read before the window opens. Read only: the session is
+/// loaded, and owned, later by `session_restore`.
+pub fn saved_window() -> Option<WindowGeometry> {
+    read_window(&session_dir()?)
+}
+
+fn read_window(dir: &Path) -> Option<WindowGeometry> {
+    let data = fs::read_to_string(dir.join(SESSION_FILE)).ok()?;
+    ron::from_str::<SessionFile>(&data)
+        .ok()
+        .filter(|session| session.version == VERSION)?
+        .window
+}
+
+#[derive(Clone, Debug, Default, Deserialize, PartialEq, Serialize)]
+pub struct SessionTab {
+    /// `None` for an untitled document.
+    pub path: Option<PathBuf>,
+    /// Backup of the unsaved text, `backups/<id>.txt`.
+    pub backup: Option<String>,
+    /// Modification time of the file when the backup was written, in seconds.
+    pub file_modified: Option<u64>,
+    pub cursor: (usize, usize),
+    pub scroll: (usize, f32),
+    pub markdown_view: Option<ViewMode>,
+    /// The file the draft is based on; `None` in sessions from before it was kept.
+    #[serde(default)]
+    pub disk_base: Option<crate::disk_change::Base>,
+    /// The view: 0 left (or the only one), 1 right; 0 in sessions from before two views.
+    #[serde(default)]
+    pub view: u8,
+    /// Folded blocks: header line and its text, dropped on restore when the text no longer
+    /// matches; empty in sessions from before folds were kept.
+    #[serde(default)]
+    pub folds: Vec<(usize, String)>,
+    /// Tabs with the same number are clones of one document (Clone to other view); `None` in
+    /// sessions from before untitled clones, where tabs of one file pair by its path.
+    #[serde(default)]
+    pub clone: Option<u64>,
+}
+
+/// The restored tabs that are clones of one document, from the session's clone numbers; in a
+/// session from before they were kept, the tabs of one file.
+pub fn restored_clones(tabs: &[SessionTab], entities: &[Option<Entity>]) -> Vec<Vec<Entity>> {
+    let mut groups: Vec<((Option<u64>, Option<&Path>), Vec<Entity>)> = Vec::new();
+    for (tab, entity) in tabs.iter().zip(entities) {
+        let clone = match (tab.clone, &tab.path) {
+            (Some(clone), _) => (Some(clone), None),
+            (None, Some(path)) => (None, Some(path.as_path())),
+            (None, None) => continue,
+        };
+        let Some(entity) = entity else {
+            continue;
+        };
+        match groups.iter_mut().find(|(id, _)| *id == clone) {
+            Some((_, group)) => group.push(*entity),
+            None => groups.push((clone, vec![*entity])),
+        }
+    }
+    groups
+        .into_iter()
+        .map(|(_, group)| group)
+        .filter(|group| group.len() > 1)
+        .collect()
+}
+
+/// The session folder and what was last written to it.
+#[derive(Debug)]
+pub struct Store {
+    dir: PathBuf,
+    /// Held while this process owns the session; a second process leaves it alone.
+    lock: File,
+    last_session: Option<SessionFile>,
+    /// Deleting unused drafts is safe only after the session was read cleanly.
+    cleanup: bool,
+    /// Generation of the newest snapshot written; an older one arriving late is dropped.
+    generation: u64,
+    /// Restore was switched off: a snapshot still queued writes nothing.
+    cleared: bool,
+    /// Drafts the running snapshot writes: cleanup never deletes them.
+    writing: HashSet<String>,
+    /// What this process last wrote to each draft: its hash (`None` after a failed write, as the
+    /// file may then hold either text) and the file's modification time.
+    on_disk: HashMap<String, OnDisk>,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct OnDisk {
+    hash: Option<u64>,
+    file_modified: Option<u64>,
+}
+
+impl Store {
+    pub fn open(dir: PathBuf) -> io::Result<Self> {
+        create_private_dir(&dir)?;
+        create_private_dir(&dir.join(BACKUPS))?;
+        let lock = OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .write(true)
+            .open(dir.join("lock"))?;
+        lock.try_lock().map_err(|err| match err {
+            fs::TryLockError::WouldBlock => io::Error::new(
+                io::ErrorKind::WouldBlock,
+                "session in use by another editor",
+            ),
+            fs::TryLockError::Error(err) => err,
+        })?;
+        Ok(Self {
+            dir,
+            lock,
+            last_session: None,
+            cleanup: true,
+            generation: 0,
+            cleared: false,
+            writing: HashSet::new(),
+            on_disk: HashMap::new(),
+        })
+    }
+
+    /// Open and read the session. An error means it must not be written in this process:
+    /// writing would replace a session that could not be read.
+    pub fn open_and_load(dir: PathBuf) -> io::Result<(Self, SessionFile)> {
+        let mut store = Self::open(dir)?;
+        let saved = store.load()?;
+        Ok((store, saved))
+    }
+
+    fn backup_path(&self, id: &str) -> PathBuf {
+        self.dir.join(BACKUPS).join(format!("{id}.txt"))
+    }
+
+    /// Read the session. A session that cannot be read is an error: the caller must not write
+    /// over it. A corrupt or newer file is kept as `.bad`, its drafts move to
+    /// `backups.bad-<time>`, and no draft is deleted for the rest of this process.
+    pub fn load(&mut self) -> io::Result<SessionFile> {
+        let path = self.dir.join(SESSION_FILE);
+        let data = match fs::read_to_string(&path) {
+            Ok(data) => data,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => {
+                return Ok(SessionFile::default());
+            }
+            Err(err) => return Err(err),
+        };
+        match ron::from_str::<SessionFile>(&data) {
+            Ok(session) if session.version == VERSION => {
+                self.last_session = Some(session.clone());
+                Ok(session)
+            }
+            result => {
+                let reason = match result {
+                    Ok(session) => format!("unsupported version {}", session.version),
+                    Err(err) => err.to_string(),
+                };
+                self.cleanup = false;
+                self.on_disk.clear();
+                let bad = path.with_extension("ron.bad");
+                let secs = SystemTime::now()
+                    .duration_since(UNIX_EPOCH)
+                    .map_or(0, |time| time.as_nanos());
+                let bad_backups = self.dir.join(format!("{BACKUPS}.bad-{secs}"));
+                log::warn!(
+                    "ignoring session {:?} ({}), kept as {:?} with drafts in {:?}",
+                    path,
+                    reason,
+                    bad,
+                    bad_backups
+                );
+                // Drafts first: if this fails the session file still lists them
+                fs::rename(self.dir.join(BACKUPS), &bad_backups)?;
+                fs::rename(&path, &bad)?;
+                create_private_dir(&self.dir.join(BACKUPS))?;
+                Ok(SessionFile::default())
+            }
+        }
+    }
+
+    /// `Ok(None)` when the draft file does not exist.
+    pub fn read_backup(&self, id: &str) -> io::Result<Option<String>> {
+        match fs::read_to_string(self.backup_path(id)) {
+            Ok(text) => Ok(Some(text)),
+            Err(err) if err.kind() == io::ErrorKind::NotFound => Ok(None),
+            Err(err) => Err(err),
+        }
+    }
+
+    pub fn write_backup(&self, id: &str, text: &str) -> io::Result<()> {
+        write_private(&self.backup_path(id), text.as_bytes())
+    }
+
+    /// Write the session if it changed, then delete drafts it no longer uses.
+    pub fn save(&mut self, session: SessionFile) -> io::Result<()> {
+        if self.last_session.as_ref() == Some(&session) {
+            return Ok(());
+        }
+        let data = ron::ser::to_string_pretty(&session, ron::ser::PrettyConfig::default())
+            .map_err(io::Error::other)?;
+        write_private(&self.dir.join(SESSION_FILE), data.as_bytes())?;
+        self.last_session = Some(session);
+        if self.cleanup {
+            self.remove_unused_backups()?;
+        }
+        Ok(())
+    }
+
+    fn remove_unused_backups(&mut self) -> io::Result<()> {
+        let used: HashSet<PathBuf> = self
+            .last_session
+            .iter()
+            .flat_map(|session| &session.tabs)
+            .filter_map(|tab| tab.backup.as_deref())
+            .map(|id| self.backup_path(id))
+            .chain(self.writing.iter().flat_map(|id| {
+                let path = self.backup_path(id);
+                [path.with_extension("tmp"), path]
+            }))
+            .collect();
+        for entry in fs::read_dir(self.dir.join(BACKUPS))?.flatten() {
+            let path = entry.path();
+            if !used.contains(&path)
+                && let Err(err) = fs::remove_file(&path)
+            {
+                log::warn!("failed to remove backup {:?}: {}", path, err);
+            }
+        }
+        let dir = self.dir.join(BACKUPS);
+        self.on_disk
+            .retain(|id, _| used.contains(&dir.join(format!("{id}.txt"))));
+        Ok(())
+    }
+
+    /// Restore is switched off: forget everything.
+    pub fn clear(&mut self) {
+        let _ = fs::remove_file(self.dir.join(SESSION_FILE));
+        let _ = fs::remove_dir_all(self.dir.join(BACKUPS));
+        self.last_session = None;
+        self.cleared = true;
+        self.on_disk.clear();
+        // A snapshot still running may hold this store a moment longer: let a new one open
+        let _ = self.lock.unlock();
+    }
+}
+
+fn create_private_dir(dir: &Path) -> io::Result<()> {
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::{DirBuilderExt, PermissionsExt};
+        fs::DirBuilder::new()
+            .recursive(true)
+            .mode(0o700)
+            .create(dir)?;
+        fs::set_permissions(dir, fs::Permissions::from_mode(0o700))
+    }
+    #[cfg(not(unix))]
+    fs::create_dir_all(dir)
+}
+
+/// Write to a temporary file and rename it over `path`, so a crash never leaves half a file.
+/// The folder is synced too, so the rename itself survives a crash.
+fn write_private(path: &Path, data: &[u8]) -> io::Result<()> {
+    let tmp = path.with_extension("tmp");
+    let mut options = OpenOptions::new();
+    options.write(true).create(true).truncate(true);
+    #[cfg(unix)]
+    std::os::unix::fs::OpenOptionsExt::mode(&mut options, 0o600);
+    let mut file = options.open(&tmp)?;
+    file.write_all(data)?;
+    file.sync_all()?;
+    fs::rename(&tmp, path)?;
+    #[cfg(unix)]
+    if let Some(dir) = path.parent() {
+        File::open(dir)?.sync_all()?;
+    }
+    Ok(())
+}
+
+fn modified_secs(path: &Path) -> Option<u64> {
+    let modified = fs::metadata(path).ok()?.modified().ok()?;
+    Some(modified.duration_since(UNIX_EPOCH).ok()?.as_secs())
+}
+
+fn text_hash(text: &str) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    text.hash(&mut hasher);
+    hasher.finish()
+}
+
+fn new_id() -> String {
+    static COUNTER: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|time| time.as_nanos())
+        .unwrap_or_default();
+    let count = COUNTER.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    format!("{nanos:x}-{}-{count}", process::id())
+}
+
+/// What happens to a message that closes something.
+#[derive(Debug, PartialEq)]
+pub enum CloseAction {
+    /// Upstream behaviour: closing a window or tab with unsaved changes asks first.
+    Upstream,
+    /// Window closed with restore on: unsaved text stays in the drafts, no question.
+    KeepDraftsAndExit,
+    /// The last tab closed: record the now empty session, then quit as upstream.
+    SnapshotThenUpstream,
+}
+
+pub fn close_action(message: &AppMessage, restore_on: bool) -> CloseAction {
+    match message {
+        AppMessage::Quit if restore_on => CloseAction::KeepDraftsAndExit,
+        AppMessage::QuitForce if restore_on => CloseAction::SnapshotThenUpstream,
+        _ => CloseAction::Upstream,
+    }
+}
+
+/// How one saved tab comes back.
+#[derive(Debug, PartialEq)]
+pub enum Restore {
+    /// Nothing to restore: an untitled tab without draft, or a missing file without draft.
+    Skip,
+    /// The draft could not be read: keep the entry and its draft for a later start.
+    Keep,
+    /// Open the file; with a draft the tab shows the draft as unsaved changes.
+    File {
+        path: PathBuf,
+        draft: Option<String>,
+        changed_on_disk: bool,
+    },
+    Untitled {
+        draft: String,
+    },
+}
+
+/// Decide how each saved tab is restored, and which of them is active.
+/// `file` gives `None` for a missing file, else its modification time.
+pub fn plan_restore(
+    session: &SessionFile,
+    read_draft: impl Fn(&str) -> io::Result<Option<String>>,
+    file: impl Fn(&Path) -> Option<Option<u64>>,
+) -> (Vec<Restore>, Option<usize>) {
+    let plans: Vec<Restore> = session
+        .tabs
+        .iter()
+        .map(|tab| {
+            let draft = match tab.backup.as_deref().map(&read_draft) {
+                None => None,
+                Some(Ok(draft)) => draft,
+                Some(Err(err)) => {
+                    log::warn!("session: draft of {:?} unreadable, kept: {}", tab.path, err);
+                    return Restore::Keep;
+                }
+            };
+            match (&tab.path, draft) {
+                (Some(path), draft) => match file(path) {
+                    Some(modified) => Restore::File {
+                        path: path.clone(),
+                        changed_on_disk: draft.is_some() && modified != tab.file_modified,
+                        draft,
+                    },
+                    // Missing file: the draft comes back under the old name, as unsaved
+                    None if draft.is_some() => Restore::File {
+                        path: path.clone(),
+                        draft,
+                        changed_on_disk: false,
+                    },
+                    None => Restore::Skip,
+                },
+                (None, Some(draft)) => Restore::Untitled { draft },
+                (None, None) => Restore::Skip,
+            }
+        })
+        .collect();
+    let opens = |plan: &Restore| !matches!(plan, Restore::Skip | Restore::Keep);
+    let active = plans
+        .get(session.active)
+        .is_some_and(opens)
+        .then_some(session.active)
+        .or_else(|| plans.iter().position(opens));
+    (plans, active)
+}
+
+/// Quitting without a question is only safe once every draft is on disk.
+pub fn quit_outcome(snapshot: &io::Result<()>) -> CloseAction {
+    match snapshot {
+        Ok(()) => CloseAction::KeepDraftsAndExit,
+        Err(err) => {
+            log::warn!("session not saved ({}), asking to save instead", err);
+            CloseAction::Upstream
+        }
+    }
+}
+
+/// Whether the text read must be written: only when it differs from the draft on disk.
+pub fn needs_write(saved_hash: Option<u64>, hash: u64) -> bool {
+    saved_hash != Some(hash)
+}
+
+/// Edits not in a snapshot yet: when the first and the last of them happened.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Unsaved {
+    first: Instant,
+    last: Instant,
+}
+
+impl Unsaved {
+    pub fn edited(unsaved: Option<Self>, now: Instant) -> Self {
+        Self {
+            first: unsaved.map_or(now, |unsaved| unsaved.first),
+            last: now,
+        }
+    }
+}
+
+/// How long until the next snapshot is due: `IDLE_DELAY` after typing pauses, but no later than
+/// `MAX_WAIT` after the first unsaved edit, so typing without pause is still saved. `None` when
+/// nothing changed since the last snapshot.
+pub fn snapshot_wait(now: Instant, unsaved: Option<Unsaved>) -> Option<Duration> {
+    let unsaved = unsaved?;
+    let due = (unsaved.last + IDLE_DELAY).min(unsaved.first + MAX_WAIT);
+    Some(due.saturating_duration_since(now))
+}
+
+pub fn snapshot_due(now: Instant, unsaved: Option<Unsaved>) -> bool {
+    snapshot_wait(now, unsaved) == Some(Duration::ZERO)
+}
+
+/// Backup state of one tab.
+#[derive(Debug)]
+struct Record {
+    id: String,
+    /// Hash of the text in the backup file. Updated only after a successful write, so a failed
+    /// write is retried, and quit (which writes again) asks to save if it still fails.
+    hash: Option<u64>,
+    file_modified: Option<u64>,
+}
+
+/// One unsaved text, copied on the UI thread, to hash and write in the background.
+#[derive(Debug)]
+struct Draft {
+    entity: Entity,
+    /// Index of its tab in the session file.
+    tab: usize,
+    id: String,
+    text: String,
+    saved_hash: Option<u64>,
+    saved_modified: Option<u64>,
+    path: Option<PathBuf>,
+}
+
+/// A snapshot: the session file and the drafts it needs.
+#[derive(Debug)]
+pub struct Job {
+    generation: u64,
+    session: SessionFile,
+    drafts: Vec<Draft>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum DraftOutcome {
+    Unchanged,
+    Written {
+        hash: u64,
+        file_modified: Option<u64>,
+    },
+    Failed,
+}
+
+#[derive(Clone, Debug)]
+pub struct JobResult {
+    generation: u64,
+    /// A newer snapshot was written first, or restore was switched off: nothing written.
+    stale: bool,
+    drafts: Vec<(Entity, String, DraftOutcome)>,
+    error: Option<String>,
+}
+
+impl Job {
+    /// Write the changed drafts, then the session file, which lists a draft only once it is on
+    /// disk. Runs under the store's lock, so there is never more than one writer.
+    pub fn run(self, store: &mut Store) -> JobResult {
+        let mut result = JobResult {
+            generation: self.generation,
+            stale: false,
+            drafts: Vec::with_capacity(self.drafts.len()),
+            error: None,
+        };
+        if store.cleared || self.generation <= store.generation {
+            result.stale = true;
+            return result;
+        }
+        store.generation = self.generation;
+        store.writing = self.drafts.iter().map(|draft| draft.id.clone()).collect();
+        let mut session = self.session;
+        for draft in self.drafts {
+            let hash = text_hash(&draft.text);
+            // Compare with the file, not with the tab's record: a background write may have
+            // changed the file since the record was copied (undo during a write)
+            let saved = store
+                .on_disk
+                .get(&draft.id)
+                .copied()
+                .or(draft.saved_hash.map(|hash| OnDisk {
+                    hash: Some(hash),
+                    file_modified: draft.saved_modified,
+                }));
+            let (outcome, on_disk) = if !needs_write(saved.and_then(|saved| saved.hash), hash) {
+                (
+                    DraftOutcome::Unchanged,
+                    saved.map(|saved| saved.file_modified),
+                )
+            } else {
+                match store.write_backup(&draft.id, &draft.text) {
+                    Ok(()) => {
+                        let file_modified = draft.path.as_deref().and_then(modified_secs);
+                        store.on_disk.insert(
+                            draft.id.clone(),
+                            OnDisk {
+                                hash: Some(hash),
+                                file_modified,
+                            },
+                        );
+                        (
+                            DraftOutcome::Written {
+                                hash,
+                                file_modified,
+                            },
+                            Some(file_modified),
+                        )
+                    }
+                    Err(err) => {
+                        log::warn!("failed to write backup of {:?}: {}", draft.path, err);
+                        result.error = Some(err.to_string());
+                        // The older draft, if any, stays listed: better than none. Its text is
+                        // unknown now, so the next snapshot writes again
+                        if let Some(saved) = saved {
+                            store.on_disk.insert(
+                                draft.id.clone(),
+                                OnDisk {
+                                    hash: None,
+                                    ..saved
+                                },
+                            );
+                        }
+                        (DraftOutcome::Failed, saved.map(|saved| saved.file_modified))
+                    }
+                }
+            };
+            if let (Some(file_modified), Some(tab)) = (on_disk, session.tabs.get_mut(draft.tab)) {
+                tab.backup = Some(draft.id.clone());
+                tab.file_modified = file_modified;
+            }
+            result.drafts.push((draft.entity, draft.id, outcome));
+        }
+        if let Err(err) = store.save(session) {
+            log::warn!("failed to save session: {}", err);
+            result.error = Some(err.to_string());
+        }
+        store.writing.clear();
+        result
+    }
+}
+
+/// A snapshot that must be on disk: a skipped one counts as failed, so quit asks to save.
+fn sync_outcome(result: &JobResult) -> io::Result<()> {
+    match &result.error {
+        Some(err) => Err(io::Error::other(err.clone())),
+        None if result.stale => Err(io::Error::other("snapshot skipped")),
+        None => Ok(()),
+    }
+}
+
+fn lock(store: &Mutex<Store>) -> MutexGuard<'_, Store> {
+    store
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+#[derive(Debug, Default)]
+pub struct Session {
+    store: Option<Arc<Mutex<Store>>>,
+    records: HashMap<Entity, Record>,
+    /// Saved tabs that could not be restored (unreadable draft or file): written back as they
+    /// were, so their drafts are never deleted.
+    kept: Vec<SessionTab>,
+    unsaved: Option<Unsaved>,
+    /// A wake-up to check `snapshot_wait` is scheduled.
+    timer: bool,
+    /// A background snapshot runs; `again` asks for another one when it ends.
+    writing: bool,
+    again: bool,
+    /// Generation of the last snapshot started, and of the last result applied.
+    generation: u64,
+    applied: u64,
+    /// The main window, saved with every snapshot.
+    window: Option<WindowGeometry>,
+}
+
+impl Session {
+    /// Take in a finished snapshot. A result older than one already applied is ignored. A draft
+    /// that failed counts as a new edit, so the timer tries again.
+    fn finish(&mut self, result: &JobResult, now: Instant) -> bool {
+        if result.stale || result.generation <= self.applied {
+            return false;
+        }
+        self.applied = result.generation;
+        for (entity, id, outcome) in &result.drafts {
+            if let DraftOutcome::Written {
+                hash,
+                file_modified,
+            } = outcome
+                && let Some(record) = self.records.get_mut(entity)
+                && record.id == *id
+            {
+                record.hash = Some(*hash);
+                record.file_modified = *file_modified;
+            }
+        }
+        if result
+            .drafts
+            .iter()
+            .any(|(_, _, outcome)| *outcome == DraftOutcome::Failed)
+        {
+            self.unsaved = Some(Unsaved::edited(self.unsaved, now));
+        }
+        true
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    Edited,
+    Enabled(bool),
+    /// Wake-up: take a snapshot if one is due.
+    Tick,
+    Written(JobResult),
+    /// A window was resized; the main window's state is then queried.
+    Resized(window::Id, Size),
+    /// The main window's size and maximized state.
+    Window(Size, bool),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::Session(message)
+    }
+}
+
+/// The editor tab to save in the session; git diff and compare tabs are views, not documents.
+fn restorable(tab: &Tab) -> Option<&EditorTab> {
+    match tab {
+        Tab::Editor(tab) => Some(tab),
+        Tab::GitDiff(_) => None,
+    }
+}
+
+fn session_dir() -> Option<PathBuf> {
+    Some(dirs::state_dir()?.join("cosmic-edit").join("session"))
+}
+
+/// Put `text` into the editor as one undoable change, so it shows as modified.
+fn replace_text(tab: &EditorTab, text: &str) {
+    let mut editor = tab.editor.lock().unwrap();
+    if editor_text(&editor) == text {
+        return;
+    }
+    editor.start_change();
+    let end = editor.with_buffer(|buffer| {
+        let last = buffer.lines.len().saturating_sub(1);
+        Cursor::new(last, buffer.lines.get(last).map_or(0, |l| l.text().len()))
+    });
+    crate::tab::delete_in_pieces(&mut *editor, Cursor::new(0, 0), end);
+    crate::tab::insert_in_pieces(&mut *editor, Cursor::new(0, 0), text);
+    editor.finish_change();
+    editor.set_changed(true);
+}
+
+fn restore_position(tab: &EditorTab, saved: &SessionTab) {
+    let mut editor = tab.editor.lock().unwrap();
+    let mut font_system = font_system().write().unwrap();
+    set_position(&mut *editor, font_system.raw(), saved.cursor, saved.scroll);
+}
+
+fn set_position(
+    editor: &mut impl Edit<'static>,
+    font_system: &mut FontSystem,
+    (line, index): (usize, usize),
+    (scroll_line, vertical): (usize, f32),
+) {
+    let cursor = editor.with_buffer(|buffer| {
+        let line = line.min(buffer.lines.len().saturating_sub(1));
+        let len = buffer.lines.get(line).map_or(0, |l| l.text().len());
+        let index = index.min(len);
+        let text = buffer.lines.get(line).map_or("", |l| l.text());
+        // Never inside a multi-byte character
+        let index = (0..=index)
+            .rev()
+            .find(|i| text.is_char_boundary(*i))
+            .unwrap_or(0);
+        Cursor::new(line, index)
+    });
+    editor.set_cursor(cursor);
+    // Shape now: the moved cursor would otherwise scroll to itself on the first layout, before
+    // the editor knows its height, and lose the saved scroll (and the other view's alignment)
+    editor.shape_as_needed(font_system, false);
+    editor.with_buffer_mut(|buffer| {
+        let mut scroll = Scroll::new(scroll_line, vertical, 0.0);
+        scroll.line = scroll.line.min(buffer.lines.len().saturating_sub(1));
+        buffer.set_scroll(scroll);
+    });
+}
+
+impl App {
+    fn session_enabled(&self) -> bool {
+        self.config.restore_session && self.session.store.is_some()
+    }
+
+    /// Reopen the tabs of the last session. Called once at startup, before file arguments.
+    pub fn session_restore(&mut self) {
+        if !self.config.restore_session {
+            return;
+        }
+        let Some(dir) = session_dir() else {
+            return;
+        };
+        let (store, saved) = match Store::open_and_load(dir) {
+            Ok(opened) => opened,
+            Err(err) => {
+                log::warn!("session restore off for this window: {}", err);
+                return;
+            }
+        };
+        // The size was applied when the window was built; maximizing follows in `session_window`
+        self.session.window = saved.window;
+        self.sidebar.width = crate::sidebar::restored_width(saved.sidebar_width);
+        let (plans, active) = plan_restore(
+            &saved,
+            |id| store.read_backup(id),
+            |path| {
+                fs::exists(path)
+                    .unwrap_or(false)
+                    .then(|| modified_secs(path))
+            },
+        );
+        let mut entities = Vec::new();
+        for (saved_tab, plan) in saved.tabs.iter().zip(plans) {
+            let entity = match &plan {
+                Restore::Skip => {
+                    if let Some(path) = &saved_tab.path {
+                        log::info!("session: {:?} no longer exists, skipped", path);
+                    }
+                    None
+                }
+                Restore::Keep => None,
+                Restore::File { path, .. } => {
+                    // A second tab of one file (Clone to other view) opens it again
+                    match self.open_tab(Some(path.clone())) {
+                        Some(entity) if entities.contains(&Some(entity)) => {
+                            self.open_tab_again(Some(path.clone()), saved_tab.markdown_view)
+                        }
+                        entity => entity,
+                    }
+                }
+                Restore::Untitled { .. } => self.open_tab(None),
+            };
+            // A file that failed to open (not just missing) keeps its entry for a later start
+            let opened = entity.filter(|entity| match self.tab_model.data::<Tab>(*entity) {
+                Some(Tab::Editor(tab)) => saved_tab.path.is_none() || tab.path_opt.is_some(),
+                _ => false,
+            });
+            if opened.is_none() && plan != Restore::Skip {
+                if let Some(entity) = entity {
+                    self.tab_model.remove(entity);
+                }
+                log::warn!("session: {:?} could not be restored, kept", saved_tab.path);
+                self.session.kept.push(saved_tab.clone());
+            }
+            entities.push(opened);
+            let Some(entity) = opened else { continue };
+            let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) else {
+                continue;
+            };
+            let draft = match plan {
+                Restore::File {
+                    path,
+                    draft,
+                    changed_on_disk,
+                } => {
+                    if changed_on_disk {
+                        tab.disk_restored_over_change();
+                        log::warn!(
+                            "session: {:?} changed on disk since its draft; showing the draft",
+                            path
+                        );
+                    }
+                    draft
+                }
+                Restore::Untitled { draft } => Some(draft),
+                Restore::Skip | Restore::Keep => None,
+            };
+            if let (Some(text), Some(id)) = (draft, &saved_tab.backup) {
+                replace_text(tab, &text);
+                tab.disk_restored(saved_tab.disk_base);
+                self.session.records.insert(
+                    entity,
+                    Record {
+                        id: id.clone(),
+                        hash: Some(text_hash(&text)),
+                        file_modified: saved_tab.file_modified,
+                    },
+                );
+            }
+            if !saved_tab.folds.is_empty() {
+                let kind = tab.fold_kind();
+                let mut editor = tab.editor.lock().unwrap();
+                editor.with_buffer_mut(|buffer| {
+                    crate::folding::restore_folds(buffer, &saved_tab.folds, kind)
+                });
+            }
+            restore_position(tab, saved_tab);
+            if let (Some(mode), Some(preview)) = (saved_tab.markdown_view, tab.markdown.as_mut()) {
+                preview.mode = mode;
+            }
+            tab.markdown_refresh();
+            let title = tab.title();
+            let title = if tab.changed() {
+                format!("{title} \u{2022}")
+            } else {
+                title
+            };
+            self.tab_model.text_set(entity, title);
+        }
+        let active = active.and_then(|i| entities.get(i).copied().flatten());
+        if let Some(entity) = active {
+            self.tab_model.activate(entity);
+        }
+        for group in restored_clones(&saved.tabs, &entities) {
+            if let Some((clone, rest)) = group.split_last() {
+                self.mirror.link(rest, *clone, None);
+            }
+        }
+        let views: Vec<(Entity, u8)> = saved
+            .tabs
+            .iter()
+            .zip(&entities)
+            .filter_map(|(saved_tab, entity)| entity.map(|entity| (entity, saved_tab.view)))
+            .collect();
+        let other = saved
+            .other_active
+            .and_then(|i| entities.get(i).copied().flatten());
+        self.split = crate::views::restore_split(&views, active, other);
+        if let Some(split) = &mut self.split {
+            split.sync(&self.tab_model);
+            if let Some(ratio) = saved.split_ratio.filter(|ratio| ratio.is_finite()) {
+                split.ratio = ratio.clamp(0.0, 1.0);
+            }
+        }
+        self.session.store = Some(Arc::new(Mutex::new(store)));
+    }
+
+    /// Copy the current tabs and the unsaved text of every modified tab: edits can come from
+    /// anywhere (paste results, other tabs, touch input). Hashing and writing happen in `Job::run`.
+    fn session_job(&mut self) -> Job {
+        self.session.generation += 1;
+        let mut job = Job {
+            generation: self.session.generation,
+            session: SessionFile {
+                version: VERSION,
+                window: self.session.window,
+                split_ratio: self.split.as_ref().map(|split| split.ratio),
+                sidebar_width: self.sidebar.width,
+                ..Default::default()
+            },
+            drafts: Vec::new(),
+        };
+        let entities: Vec<Entity> = self.tab_model.iter().collect();
+        let active = self.tab_model.active();
+        let (views, other_active) = crate::views::session_views(self.split.as_ref(), &entities);
+        for (entity, view) in entities.iter().zip(views) {
+            let Some(tab) = self.tab_model.data::<Tab>(*entity).and_then(restorable) else {
+                continue;
+            };
+            let changed = tab.changed();
+            // An empty untitled tab has nothing worth restoring
+            if tab.path_opt.is_none() && !changed {
+                continue;
+            }
+            let saved = {
+                let editor = tab.editor.lock().unwrap();
+                let cursor = editor.cursor();
+                let scroll = editor.with_buffer(|buffer| buffer.scroll());
+                let folds = editor.with_buffer(crate::folding::saved_folds);
+                SessionTab {
+                    path: tab.path_opt.clone(),
+                    cursor: (cursor.line, cursor.index),
+                    scroll: (scroll.line, scroll.vertical),
+                    markdown_view: tab.markdown_view(),
+                    disk_base: Some(tab.disk.base()),
+                    view,
+                    folds,
+                    clone: self.mirror.link_of(*entity),
+                    ..Default::default()
+                }
+            };
+            if changed {
+                let record = self
+                    .session
+                    .records
+                    .entry(*entity)
+                    .or_insert_with(|| Record {
+                        id: new_id(),
+                        hash: None,
+                        file_modified: None,
+                    });
+                job.drafts.push(Draft {
+                    entity: *entity,
+                    tab: job.session.tabs.len(),
+                    id: record.id.clone(),
+                    text: editor_text(&tab.editor.lock().unwrap()),
+                    saved_hash: record.hash,
+                    saved_modified: record.file_modified,
+                    path: tab.path_opt.clone(),
+                });
+            } else {
+                // Saved or discarded: the backup goes with the next cleanup
+                self.session.records.remove(entity);
+            }
+            if *entity == active {
+                job.session.active = job.session.tabs.len();
+            }
+            if Some(*entity) == other_active {
+                job.session.other_active = Some(job.session.tabs.len());
+            }
+            job.session.tabs.push(saved);
+        }
+        job.session.tabs.extend(self.session.kept.iter().cloned());
+        self.session
+            .records
+            .retain(|entity, _| entities.contains(entity));
+        job
+    }
+
+    /// Snapshot now and wait for it: quit must know that every draft is on disk before exiting.
+    pub fn session_snapshot(&mut self) -> io::Result<()> {
+        if !self.session_enabled() {
+            return Ok(());
+        }
+        let job = self.session_job();
+        self.session.unsaved = None;
+        let store = Arc::clone(self.session.store.as_ref().unwrap());
+        // Waits for a background snapshot still running, then writes after it
+        let result = job.run(&mut lock(&store));
+        self.session.finish(&result, Instant::now());
+        sync_outcome(&result)
+    }
+
+    /// Snapshot in the background, one at a time; a request while one runs follows after it.
+    pub fn session_snapshot_task(&mut self) -> Task<AppMessage> {
+        if !self.session_enabled() {
+            return Task::none();
+        }
+        self.session.unsaved = None;
+        if self.session.writing {
+            self.session.again = true;
+            return Task::none();
+        }
+        let job = self.session_job();
+        let generation = job.generation;
+        let store = Arc::clone(self.session.store.as_ref().unwrap());
+        self.session.writing = true;
+        Task::perform(
+            tokio::task::spawn_blocking(move || job.run(&mut lock(&store))),
+            move |res| {
+                let result = res.unwrap_or_else(|err| {
+                    log::warn!("session snapshot failed: {}", err);
+                    JobResult {
+                        generation,
+                        stale: true,
+                        drafts: Vec::new(),
+                        error: Some(err.to_string()),
+                    }
+                });
+                action::app(Message::Written(result).into())
+            },
+        )
+    }
+
+    /// Maximize the main window at startup when it was maximized last time.
+    pub fn session_window(&self) -> Task<AppMessage> {
+        match self.session.window {
+            Some(window) if window.maximized && self.session_enabled() => {
+                self.core.maximize(None, true)
+            }
+            _ => Task::none(),
+        }
+    }
+
+    /// Check again when the next snapshot is due.
+    fn session_timer(&mut self) -> Task<AppMessage> {
+        let now = Instant::now();
+        if snapshot_due(now, self.session.unsaved) {
+            return self.session_snapshot_task();
+        }
+        match snapshot_wait(now, self.session.unsaved) {
+            Some(wait) if !self.session.timer => {
+                self.session.timer = true;
+                Task::perform(tokio::time::sleep(wait), |()| {
+                    action::app(Message::Tick.into())
+                })
+            }
+            _ => Task::none(),
+        }
+    }
+
+    /// Quitting keeps unsaved work in the session instead of asking.
+    pub fn session_intercept(&mut self, message: &AppMessage) -> Option<Task<AppMessage>> {
+        match close_action(message, self.session_enabled()) {
+            CloseAction::Upstream => None,
+            CloseAction::KeepDraftsAndExit => match quit_outcome(&self.session_snapshot()) {
+                CloseAction::KeepDraftsAndExit => process::exit(0),
+                // Not all drafts are safe: ask to save, as without session restore
+                _ => None,
+            },
+            CloseAction::SnapshotThenUpstream => {
+                let _ = self.session_snapshot();
+                None
+            }
+        }
+    }
+
+    pub fn update_session(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Edited => {
+                if !self.session_enabled() {
+                    return Task::none();
+                }
+                self.session.unsaved = Some(Unsaved::edited(self.session.unsaved, Instant::now()));
+                return self.session_timer();
+            }
+            Message::Enabled(enabled) => {
+                match &self.config_handler {
+                    Some(config_handler) => {
+                        if let Err(err) = self.config.set_restore_session(config_handler, enabled) {
+                            log::warn!("failed to save config \"restore_session\": {}", err);
+                        }
+                    }
+                    None => self.config.restore_session = enabled,
+                }
+                if enabled {
+                    if self.session.store.is_none()
+                        && let Some(dir) = session_dir()
+                    {
+                        match Store::open_and_load(dir) {
+                            Ok((store, saved)) => {
+                                // Tabs of an older session are not open now: keep their drafts
+                                self.session.kept.extend(saved.tabs);
+                                self.session.store = Some(Arc::new(Mutex::new(store)));
+                            }
+                            Err(err) => log::warn!("session restore unavailable: {}", err),
+                        }
+                    }
+                    let _ = self.session_snapshot();
+                } else if let Some(store) = self.session.store.take() {
+                    lock(&store).clear();
+                    self.session.records.clear();
+                    self.session.unsaved = None;
+                }
+            }
+            Message::Resized(id, size) => {
+                // Only the editor that owns the session keeps the size of its main window
+                if self.session_enabled() && self.core.main_window_is(id) {
+                    return window::is_maximized(id).map(move |maximized| {
+                        action::app(Message::Window(size, maximized).into())
+                    });
+                }
+            }
+            Message::Window(size, maximized) => {
+                self.session.window = Some(WindowGeometry::resized(
+                    self.session.window,
+                    size,
+                    maximized,
+                ));
+            }
+            Message::Tick => {
+                self.session.timer = false;
+                return self.session_timer();
+            }
+            Message::Written(result) => {
+                self.session.writing = false;
+                if self.session.finish(&result, Instant::now())
+                    && let Some(err) = &result.error
+                {
+                    log::warn!("session snapshot incomplete: {}", err);
+                }
+                if std::mem::take(&mut self.session.again) {
+                    return self.session_snapshot_task();
+                }
+                // A failed draft waits for the next due snapshot
+                return self.session_timer();
+            }
+        }
+        Task::none()
+    }
+
+    pub fn session_settings(&self) -> cosmic::Element<'_, AppMessage> {
+        widget::settings::section()
+            .title(fl!("session"))
+            .add(
+                widget::settings::item::builder(fl!("restore-session"))
+                    .toggler(self.config.restore_session, |enabled| {
+                        Message::Enabled(enabled).into()
+                    }),
+            )
+            .into()
+    }
+
+    /// Edits: keys, clicks and input method text, as the editor reports only its saved state.
+    /// Window resizes, for the window size.
+    pub fn session_subscription(&self) -> Subscription<AppMessage> {
+        if !self.session_enabled() {
+            return Subscription::none();
+        }
+        event::listen_with(|event, _status, window| match event {
+            event::Event::Window(window::Event::Resized(size)) => {
+                Some(Message::Resized(window, size).into())
+            }
+            event::Event::Keyboard(keyboard::Event::KeyPressed { .. })
+            | event::Event::Mouse(mouse::Event::ButtonReleased(_))
+            | event::Event::InputMethod(input_method::Event::Commit(_)) => {
+                Some(Message::Edited.into())
+            }
+            _ => None,
+        })
+    }
+}
+
+/// Behaviours covered:
+/// - closing the window with restore on keeps unsaved text as drafts, without a question
+/// - closing a single unsaved tab still asks; restore off behaves like upstream everywhere
+/// - discarding or saving a tab deletes its draft; switching restore off deletes the session
+/// - tabs come back in order with the active tab; untitled drafts come back untitled
+/// - a missing file with a draft comes back as unsaved; without a draft it is skipped
+/// - a file changed on disk after its draft keeps the draft and shows as unsaved
+/// - snapshots read every modified tab and write only buffers that changed
+/// - continuous typing snapshots at least every 15 s; a pause snapshots after 2 s
+/// - no snapshot is due without edits, and unchanged text is never rewritten
+/// - drafts are hashed and written off the UI thread, one snapshot at a time
+/// - a background write that fails keeps the old hash, so quit writes again and asks if it fails
+/// - a snapshot result older than one already applied is ignored; an older job writes nothing
+/// - cleanup never deletes a draft that the running snapshot writes
+/// - "unchanged" means unchanged against the file, so an undo during a write is still written
+/// - a skipped quit snapshot asks to save; a failed draft is tried again at the next due time
+/// - quitting asks to save when a draft could not be written
+/// - an unreadable session is never overwritten; a corrupt one keeps its drafts aside
+/// - switching restore on later reads the old session first and keeps its drafts
+/// - an unreadable draft keeps its tab entry and its file
+/// - a corrupt or newer session file starts empty and is kept as `.bad`
+/// - session files are private (0600, folders 0700) and owned by one editor at a time
+/// - git diff and compare tabs are views and are never saved as documents
+/// - the main window's size and maximized state are saved and restored, within sane bounds

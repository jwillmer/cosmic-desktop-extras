+/// Whether `text` starts a list item, after its quote markers and indentation. With
+/// `in_paragraph` only one that may interrupt a paragraph: a bullet or the number 1, with text.
+pub fn starts_item(text: &str, in_paragraph: bool) -> bool {
+    let Some(marker) = parse(text).marker else {

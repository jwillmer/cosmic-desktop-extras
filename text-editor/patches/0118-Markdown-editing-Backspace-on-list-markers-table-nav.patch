+/// Enter at `cursor` (no selection) in a fenced code block, or on its fences, that is indented
+/// or quoted, as in a list item: the new line starts with the fence's indentation and quote
+/// markers, so the code stays in the item, also without automatic indentation. With `keep`
+/// (automatic indentation) a line indented further keeps its own indentation. `None`: not in
+/// such a block, or the cursor is in the indentation, and Enter is a plain new line.
+pub fn code_enter(lines: &[&str], cursor: Pos, keep: bool) -> Option<Outcome> {
+    let (l, at) = cursor;
+    let text = *lines.get(l)?;
+    let code = fenced(lines, l);
+    if code[l] == Fenced::Text {
+        return None;
+    }
+    // The fence that opened the block; a closing fence is `Inside` too
+    let open = (0..=l).rev().find(|i| code[*i] == Fenced::Open)?;
+    let fence = parse(lines[open]);
+    let mut prefix = &lines[open][..fence.indent_end];
+    if prefix.is_empty() {
+        return None;
+    }
+    let own = &text[..text.len() - text.trim_start_matches([' ', '\t', '>']).len()];
+    if keep && own.len() > prefix.len() && own.starts_with(prefix) {
+        prefix = own;
+    }
+    if at > text.len() || at < prefix.len().min(own.len()) || !text.is_char_boundary(at) {
+        return None;
+    }
+    let mut new = owned(lines);
+    new[l].truncate(at);
+    new.insert(l + 1, format!("{prefix}{}", &text[at..]));
+    Some(Outcome {
+        changes: changes(lines, &new, Some(l)),
+        cursor: (l + 1, prefix.len()),
+        anchor: None,
+    })
+}
+
+/// Backspace at `cursor` (no selection). `None`: the cursor is not right after a list marker,
+/// and Backspace deletes a character as usual.
+pub fn backspace(lines: &[&str], cursor: Pos) -> Option<Outcome> {
+    let (l, at) = cursor;
+    let text = *lines.get(l)?;
+    let line = parse(text);
+    let marker = line.marker?;
+    if at != marker.text || !allowed(lines, l, line.indent_end) {
+        return None;
+    }
+    // `2024. text` in a paragraph is text
+    if matches!(marker.kind, Kind::Ordered { number, .. } if number != 1)
+        && in_paragraph(lines, l, &line)
+    {
+        return None;
+    }
+    let mut new = owned(lines);
+    let cursor = if marker.task.is_some() {
+        // The task box goes first, the item stays
+        new[l].replace_range(marker.content..marker.text, "");
+        (l, marker.content)
+    } else if parent(lines, l).is_some() {
+        return indent(lines, cursor, None, true);
+    } else {
+        new[l].replace_range(marker.start..marker.text, "");
+        // An emptied item: the items below close the gap, as with Enter
+        if crate::md_edit::after_quotes(&new[l]).trim().is_empty()
+            && let Some(next) = (l + 1..lines.len()).find(|i| !parse(lines[*i]).blank)
+            && let next_line = parse(lines[next])
+            && next_line.quotes == line.quotes
+            && next_line.indent == line.indent
+        {
+            renumber(&mut new, next);
+        }
+        (l, marker.start)
+    };
+    Some(Outcome {
+        changes: changes(lines, &new, None),
+        cursor,
+        anchor: None,
+    })
+}

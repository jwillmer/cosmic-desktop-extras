+    /// Apply `edit` to `text`, where `|` is a pipe, `‸` marks the cursor and `^` the selection
+    /// anchor; the text after it with the cursor and anchor marked the same way, or "plain"
+    /// when the edit does not apply.
+    fn run_on(
+        text: &str,
+        edit: impl FnOnce(&[&str], Pos, Option<Pos>) -> Option<Outcome>,
+    ) -> String {
+        let mut cursor = None;
+        let mut anchor = None;
+        let mut lines: Vec<String> = Vec::new();
+        for (n, line) in text.split('\n').enumerate() {
+            let mut plain = String::new();
+            for c in line.chars() {
+                match c {
+                    '‸' => cursor = Some((n, plain.len())),
+                    '^' => anchor = Some((n, plain.len())),
+                    _ => plain.push(c),
+                }
+            }
+            lines.push(plain);
+        }
+        let refs: Vec<&str> = lines.iter().map(String::as_str).collect();
+        let Some(outcome) = edit(&refs, cursor.unwrap(), anchor) else {
+            return "plain".into();
+        };
+        for change in &outcome.changes {
+            lines[change.line].replace_range(change.start..change.end, &change.text);
+        }
+        let mut lines: Vec<String> = lines.join("\n").split('\n').map(str::to_string).collect();
+        let mut marks = vec![(outcome.cursor, '‸')];
+        if let Some(anchor) = outcome.anchor {
+            marks.push((anchor, '^'));
+        }
+        marks.sort();
+        for ((line, index), mark) in marks.into_iter().rev() {
+            lines[line].insert(index, mark);
+        }
+        lines.join("\n")
+    }
+
+    fn tab_on(text: &str) -> String {
+        run_on(text, |lines, cursor, anchor| {

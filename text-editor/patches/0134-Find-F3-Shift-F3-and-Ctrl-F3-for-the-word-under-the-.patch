@@ -493,6 +502,10 @@ pub enum Message {
     DialogCancel,
     DialogMessage(DialogMessage),
     Find(Option<bool>),
+    /// F3 / Shift+F3: the last query forwards or backwards, or open the find bar without one
+    FindAgain(bool),
+    /// Ctrl+F3 / Ctrl+Shift+F3: search the selection or the word under the cursor
+    FindWord(bool),

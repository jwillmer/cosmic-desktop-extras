@@ -2391,6 +2404,67 @@ impl App {
                 // Focus correct input
                 return self.update_focus();
             }
+            Message::FindAgain(forwards) => {
+                // The query outlives the find bar, so this works with the bar closed
+                if self.find_search_value.is_empty() {
+                    return self.update(Message::Find(Some(false)));
+                }
+                return self.update(if forwards {
+                    Message::FindNext
+                } else {
+                    Message::FindPrevious
+                });
+            }
+            Message::FindWord(forwards) => {
+                let Some(Tab::Editor(tab)) = self.active_tab() else {
+                    return Task::none();
+                };
+                let query = {
+                    let mut editor = tab.editor.lock().unwrap();
+                    let range = match editor.selection_bounds() {
+                        Some((start, end)) if start.line == end.line && start.index < end.index => {
+                            Some((start.line, start.index..end.index))
+                        }
+                        _ => {
+                            let cursor = editor.cursor();
+                            editor.with_buffer(|buffer| {
+                                buffer.lines.get(cursor.line).and_then(|line| {
+                                    find_word::word_at(line.text(), cursor.index)
+                                        .map(|range| (cursor.line, range))
+                                })
+                            })
+                        }
+                    };
+                    range.map(|(line, range)| {
+                        // Select it the way a search does (cursor at the start), so the search
+                        // skips it and moves on to the next or previous occurrence
+                        editor.set_cursor(Cursor::new(line, range.start));
+                        editor.set_selection(Selection::Normal(Cursor::new(line, range.end)));
+                        editor.with_buffer(|buffer| buffer.lines[line].text()[range].to_string())
+                    })
+                };
+                let Some(query) = query else {
+                    return Task::none();
+                };
+                self.find_search_value = if self.config.find_use_regex {
+                    regex::escape(&query)
+                } else {
+                    query
+                };
+                if self.find_opt.is_none() {
+                    // Keep typing in the text; F3 and Escape work from there
+                    self.find_opt = Some(FindField {
+                        replace: false,
+                        has_focus: false,
+                    });
+                    self.goto_line_opt = None;
+                }
+                return self.update(if forwards {
+                    Message::FindNext
+                } else {
+                    Message::FindPrevious
+                });
+            }
             Message::FindCaseSensitive(find_case_sensitive) => {
                 config_set!(find_case_sensitive, find_case_sensitive);
                 return self.update_config();

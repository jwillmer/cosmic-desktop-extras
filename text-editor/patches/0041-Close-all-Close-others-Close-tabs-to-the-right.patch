+/// The tab bar's right-click menu; its entries act on the tab it was opened on.
+pub fn tab_bar_context_menu(
+    key_binds: &HashMap<KeyBind, Action>,
+) -> Vec<widget::menu::Tree<Message>> {
+    let item = |label: String, scope: Scope| MenuItem::Button(label, None, TabBarAction(scope));
+    let key_binds: HashMap<KeyBind, TabBarAction> = key_binds
+        .iter()
+        .filter_map(|(key_bind, action)| {
+            let scope = match action {
+                Action::CloseAllTabs => Scope::All,
+                Action::CloseOtherTabs => Scope::Others,
+                Action::CloseTabsToRight => Scope::ToTheRight,
+                _ => return None,
+            };
+            Some((key_bind.clone(), TabBarAction(scope)))
+        })
+        .collect();
+    widget::menu::items(
+        &key_binds,
+        vec![
+            item(fl!("close-all"), Scope::All),
+            item(fl!("close-others"), Scope::Others),
+            item(fl!("close-tabs-to-right"), Scope::ToTheRight),
+        ],
+    )
+}
+
+/// A tab bar context menu entry.

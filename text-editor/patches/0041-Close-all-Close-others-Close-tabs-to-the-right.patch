diff --git a/src/close_tabs.rs b/src/close_tabs.rs
new file mode 100644
index 0000000..9f8e3b0
--- /dev/null
+++ b/src/close_tabs.rs
@@ -0,0 +1,371 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Close all, Close others, Close tabs to the right (File menu and the tab's right-click menu).
+//!
+//! Clean tabs, compare and git diff tabs close without asking. Tabs with unsaved changes get one
+//! prompt for the whole action: Save all, Discard all or Cancel. Cancel closes nothing, not even
+//! the clean tabs. Save all saves the tabs with a file and asks Save As for each untitled one in
+//! turn; cancelling a Save As stops there and keeps the remaining tabs open. Discard all closes
+//! them like Discard on a single tab, so their drafts leave the session. Closing every tab leaves
+//! one new empty tab instead of quitting.
+
+use cosmic::{Application, app::Task, widget::segmented_button::Entity};
+use std::fs;
+
+use crate::{App, DialogPage, Message as AppMessage, fl, tab::Tab};
+
+/// Which tabs an action closes, relative to the tab it was started on.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Scope {
+    All,
+    Others,
+    ToTheRight,
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    /// Close tabs relative to the given tab, or the active tab.
+    Request(Scope, Option<Entity>),
+    /// The tab bar's right-click menu was opened on this tab.
+    TabBarContext(Entity),
+    /// An entry of the tab bar's right-click menu.
+    TabBar(Scope),
+    /// A button of the prompt.
+    Answer(Answer),
+    /// Close these tabs without asking.
+    Force(Vec<Entity>),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::CloseTabs(message)
+    }
+}
+
+/// The tabs an action closes, and those of them with unsaved changes.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Plan<E> {
+    pub close: Vec<E>,
+    pub unsaved: Vec<E>,
+}
+
+/// Plan an action over `tabs` (in tab bar order, each with "has unsaved changes"), started on
+/// `anchor`. An anchor that is no longer open closes nothing for Others and To the right.
+pub fn plan<E: Copy + PartialEq>(tabs: &[(E, bool)], scope: Scope, anchor: E) -> Plan<E> {
+    let anchor_pos = tabs.iter().position(|(entity, _)| *entity == anchor);
+    let closes = |pos: usize| match (scope, anchor_pos) {
+        (Scope::All, _) => true,
+        (Scope::Others, Some(anchor_pos)) => pos != anchor_pos,
+        (Scope::ToTheRight, Some(anchor_pos)) => pos > anchor_pos,
+        (_, None) => false,
+    };
+    let closing: Vec<(E, bool)> = tabs
+        .iter()
+        .enumerate()
+        .filter(|(pos, _)| closes(*pos))
+        .map(|(_, tab)| *tab)
+        .collect();
+    Plan {
+        close: closing.iter().map(|(entity, _)| *entity).collect(),
+        unsaved: closing
+            .iter()
+            .filter(|(_, unsaved)| *unsaved)
+            .map(|(entity, _)| *entity)
+            .collect(),
+    }
+}
+
+/// The prompt's answer.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Answer {
+    SaveAll,
+    DiscardAll,
+    Cancel,
+}
+
+/// The tabs that close right away for an answer. Save all closes them once every one is saved.
+pub fn close_now<E: Copy>(plan: &Plan<E>, answer: Answer) -> Vec<E> {
+    match answer {
+        Answer::DiscardAll => plan.close.clone(),
+        Answer::SaveAll | Answer::Cancel => Vec::new(),
+    }
+}
+
+/// The tab to activate when the active tab closes: the nearest kept tab to its left, else to
+/// its right. `None` when every tab closes (a new empty tab takes over).
+pub fn next_active<E: Copy + PartialEq>(tabs: &[E], close: &[E], active: E) -> Option<E> {
+    let pos = tabs.iter().position(|entity| *entity == active)?;
+    let kept = |entity: &&E| !close.contains(entity);
+    tabs[..pos]
+        .iter()
+        .rev()
+        .find(kept)
+        .or_else(|| tabs[pos..].iter().find(kept))
+        .copied()
+}
+
+impl App {
+    fn has_unsaved(&self, entity: Entity) -> bool {
+        matches!(self.tab_model.data::<Tab>(entity), Some(Tab::Editor(tab)) if tab.changed())
+    }
+
+    /// The prompt's text: how many tabs have unsaved changes, and their names.
+    pub fn close_tabs_prompt(&self, unsaved: &[Entity]) -> String {
+        let names: Vec<String> = unsaved
+            .iter()
+            .filter_map(|entity| self.tab_model.data::<Tab>(*entity))
+            .map(Tab::title)
+            .collect();
+        fl!(
+            "prompt-unsaved-tabs",
+            count = names.len(),
+            names = names.join(", ")
+        )
+    }
+
+    /// Keep the prompt in step with saves: close once nothing is unsaved, else ask Save As for
+    /// the next untitled tab while Save all is running.
+    pub fn close_tabs_dialog(&mut self) -> Task<AppMessage> {
+        let Some(DialogPage::CloseTabs { plan, saving }) = &self.dialog_page_opt else {
+            return Task::none();
+        };
+        let (close, saving) = (plan.close.clone(), *saving);
+        let unsaved: Vec<Entity> = close
+            .iter()
+            .copied()
+            .filter(|entity| self.has_unsaved(*entity))
+            .collect();
+        if unsaved.is_empty() {
+            self.dialog_page_opt = None;
+            return self.update_close_tabs(Message::Force(close));
+        }
+        let untitled = unsaved.iter().copied().find(|entity| {
+            matches!(self.tab_model.data::<Tab>(*entity), Some(Tab::Editor(tab)) if tab.path_opt.is_none())
+        });
+        self.dialog_page_opt = Some(DialogPage::CloseTabs {
+            plan: Plan { close, unsaved },
+            saving,
+        });
+        match untitled {
+            Some(entity) if saving && self.dialog_opt.is_none() => {
+                // Show the untitled tab being named. Not `TabActivate`: it closes this prompt.
+                self.tab_model.activate(entity);
+                Task::batch([
+                    self.update_tab(),
+                    self.update(AppMessage::SaveAsDialog(Some(entity))),
+                ])
+            }
+            _ => Task::none(),
+        }
+    }
+
+    /// A Save As was cancelled: while Save all runs, stop and keep the remaining tabs open.
+    pub fn close_tabs_save_as_cancelled(&mut self) {
+        if let Some(DialogPage::CloseTabs { saving: true, .. }) = self.dialog_page_opt {
+            self.dialog_page_opt = None;
+        }
+    }
+
+    pub fn update_close_tabs(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Request(scope, anchor) => {
+                let anchor = anchor.unwrap_or_else(|| self.tab_model.active());
+                let tabs: Vec<(Entity, bool)> = self
+                    .tab_model
+                    .iter()
+                    .map(|entity| (entity, self.has_unsaved(entity)))
+                    .collect();
+                let plan = plan(&tabs, scope, anchor);
+                if plan.close.is_empty() {
+                    return Task::none();
+                }
+                if plan.unsaved.is_empty() {
+                    return self.update_close_tabs(Message::Force(plan.close));
+                }
+                self.dialog_page_opt = Some(DialogPage::CloseTabs {
+                    plan,
+                    saving: false,
+                });
+            }
+            Message::TabBarContext(entity) => {
+                self.tab_bar_context = Some(entity);
+            }
+            Message::TabBar(scope) => {
+                let anchor = self.tab_bar_context.take();
+                return self.update_close_tabs(Message::Request(scope, anchor));
+            }
+            Message::Answer(answer) => {
+                let Some(DialogPage::CloseTabs { plan, saving }) = &mut self.dialog_page_opt else {
+                    return Task::none();
+                };
+                if answer != Answer::SaveAll {
+                    // Cancel closes nothing; Discard all closes every tab of the action
+                    let close = close_now(plan, answer);
+                    self.dialog_page_opt = None;
+                    return self.update_close_tabs(Message::Force(close));
+                }
+                *saving = true;
+                let unsaved = plan.unsaved.clone();
+                let mut tasks = Vec::new();
+                for entity in unsaved {
+                    // Untitled tabs get their Save As one at a time from `close_tabs_dialog`
+                    let mut saved = None;
+                    if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                        && let Some(path) = tab.path_opt.clone()
+                    {
+                        tab.save();
+                        // A refused or failed save keeps the tab unsaved and in the prompt
+                        if !tab.changed() {
+                            saved = Some((tab.title(), path));
+                        }
+                    }
+                    if let Some((title, path)) = saved {
+                        self.tab_model.text_set(entity, title);
+                        if let Ok(canonical) = fs::canonicalize(&path) {
+                            self.add_to_recents(&canonical);
+                        }
+                        tasks.push(self.change_history_changed(entity));
+                    }
+                }
+                tasks.push(self.close_tabs_dialog());
+                return Task::batch(tasks);
+            }
+            Message::Force(close) => {
+                let tabs: Vec<Entity> = self.tab_model.iter().collect();
+                let close: Vec<Entity> = close.into_iter().filter(|e| tabs.contains(e)).collect();
+                if close.is_empty() {
+                    return Task::none();
+                }
+                let active = self.tab_model.active();
+                if close.contains(&active) {
+                    match next_active(&tabs, &close, active) {
+                        Some(entity) => {
+                            self.tab_model.activate(entity);
+                            self.disk_check(entity);
+                        }
+                        // Every tab closes: an empty editor shows one new empty tab
+                        None => {
+                            if self.open_tab(None).is_none() {
+                                log::error!("close tabs: no new empty tab, nothing closed");
+                                return Task::none();
+                            }
+                        }
+                    }
+                }
+                for entity in &close {
+                    self.tab_model.remove(*entity);
+                }
+                self.update_watcher();
+                if let Some(DialogPage::PromptSaveClose(entity)) = self.dialog_page_opt
+                    && close.contains(&entity)
+                {
+                    self.dialog_page_opt = None;
+                }
+                // Also records the session: the closed tabs and their drafts are gone from it
+                return self.update_tab();
+            }
+        }
+        Task::none()
+    }
+}
+
+/// Scenarios covered (logic level; the dialog itself is not driven):
+/// - clean tabs close at once, compare and git diff tabs count as clean
+/// - unsaved tabs give one prompt listing all of them
+/// - Cancel closes nothing, Discard all closes everything; a session without the closed tabs
+///   drops their drafts (the snapshot `Force` triggers through `update_tab` is not driven)
+/// - Close others keeps the tab it was started on, Close to the right keeps the left tabs
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::session::{SessionFile, SessionTab, Store};
+    use std::{path::PathBuf, process};
+
+    // Tabs 1..=4 in tab bar order; `true` has unsaved changes
+    const CLEAN: [(u32, bool); 4] = [(1, false), (2, false), (3, false), (4, false)];
+    const MIXED: [(u32, bool); 4] = [(1, true), (2, false), (3, true), (4, true)];
+
+    #[test]
+    fn close_all_closes_clean_tabs_without_asking() {
+        let plan = plan(&CLEAN, Scope::All, 2);
+        assert_eq!(plan.close, vec![1, 2, 3, 4]);
+        assert!(plan.unsaved.is_empty());
+        // Every tab closes: no tab is left to activate, a new empty one opens
+        assert_eq!(next_active(&[1, 2, 3, 4], &plan.close, 2), None);
+    }
+
+    #[test]
+    fn close_all_with_unsaved_asks_once() {
+        let plan = plan(&MIXED, Scope::All, 2);
+        assert_eq!(plan.close, vec![1, 2, 3, 4]);
+        // One prompt for the whole action, listing every unsaved tab
+        assert_eq!(plan.unsaved, vec![1, 3, 4]);
+        // Save all closes only once everything is saved
+        assert!(close_now(&plan, Answer::SaveAll).is_empty());
+    }
+
+    #[test]
+    fn cancel_closes_nothing() {
+        let plan = plan(&MIXED, Scope::All, 2);
+        // Not even the clean tab 2
+        assert!(close_now(&plan, Answer::Cancel).is_empty());
+    }
+
+    #[test]
+    fn discard_all_deletes_drafts() {
+        let plan = plan(&MIXED, Scope::All, 1);
+        assert_eq!(close_now(&plan, Answer::DiscardAll), vec![1, 2, 3, 4]);
+
+        // The closed tabs leave the session, and the next snapshot deletes their drafts
+        let dir = std::env::temp_dir().join(format!("close-tabs-discard-{}", process::id()));
+        let _ = fs::remove_dir_all(&dir);
+        let mut store = Store::open(dir.clone()).unwrap();
+        let ids = ["a", "c", "d"];
+        for id in ids {
+            store.write_backup(id, id).unwrap();
+        }
+        let tab = |id: &str| SessionTab {
+            path: Some(PathBuf::from(format!("/srv/{id}.md"))),
+            backup: Some(id.to_string()),
+            ..Default::default()
+        };
+        let mut session = SessionFile {
+            tabs: ids.iter().map(|id| tab(id)).collect(),
+            ..Default::default()
+        };
+        store.save(session.clone()).unwrap();
+        for id in ids {
+            assert!(store.read_backup(id).unwrap().is_some());
+        }
+        session.tabs.clear();
+        store.save(session).unwrap();
+        for id in ids {
+            assert_eq!(store.read_backup(id).unwrap(), None);
+        }
+        fs::remove_dir_all(dir).unwrap();
+    }
+
+    #[test]
+    fn close_others_keeps_active() {
+        let plan = plan(&MIXED, Scope::Others, 3);
+        assert_eq!(plan.close, vec![1, 2, 4]);
+        assert_eq!(plan.unsaved, vec![1, 4]);
+        // Started on tab 3 while tab 1 was active: 3 becomes active
+        assert_eq!(next_active(&[1, 2, 3, 4], &plan.close, 1), Some(3));
+    }
+
+    #[test]
+    fn close_to_the_right_keeps_left_tabs() {
+        let plan = plan(&MIXED, Scope::ToTheRight, 2);
+        assert_eq!(plan.close, vec![3, 4]);
+        assert_eq!(plan.unsaved, vec![3, 4]);
+        // The active tab 4 closes: the nearest kept tab to its left takes over
+        assert_eq!(next_active(&[1, 2, 3, 4], &plan.close, 4), Some(2));
+        // Nothing to the right of the last tab
+        assert!(plan_is_empty(Scope::ToTheRight, 4));
+    }
+
+    fn plan_is_empty(scope: Scope, anchor: u32) -> bool {
+        plan(&MIXED, scope, anchor).close.is_empty()
+    }
+}

index 0000000..1117976
--- /dev/null
+++ b/src/markdown_highlight.rs
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Syntax colours for fenced code blocks in the preview, from the editor's own syntaxes and theme.
+
+use cosmic::iced::Color;
+use cosmic_text::SyntaxSystem;
+use std::{
+    collections::HashMap,
+    hash::{DefaultHasher, Hash, Hasher},
+    sync::{Arc, Mutex},
+};
+use syntect::easy::HighlightLines;
+
+/// Longer blocks stay plain: highlighting them would stall typing in Split.
+const MAX_LINES: usize = 2000;
+
+/// One coloured run of text.
+pub type Run = (Color, String);
+/// The runs of each line of a block.
+pub type Lines = Vec<Vec<Run>>;
+
+/// Highlighted blocks by theme, language and code, so a re-parse while typing in Split only
+/// highlights the blocks that changed.
+#[derive(Default)]
+pub struct Cache {
+    entries: Mutex<HashMap<u64, Entry>>,
+}
+
+struct Entry {
+    /// `None` for an unknown language or a block too long to highlight.
+    lines: Option<Arc<Lines>>,
+    /// Shown since the last sweep.
+    used: bool,
+}
+
+impl Cache {
+    /// The coloured lines of `code`, `None` when it stays plain.
+    pub fn get(
+        &self,
+        system: &SyntaxSystem,
+        theme: &str,
+        language: &str,
+        code: &str,
+    ) -> Option<Arc<Lines>> {
+        let mut hasher = DefaultHasher::new();
+        (theme, language, code).hash(&mut hasher);
+        let mut entries = self.entries.lock().unwrap();
+        let entry = entries.entry(hasher.finish()).or_insert_with(|| Entry {
+            lines: highlight(system, theme, language, code).map(Arc::new),
+            used: false,
+        });
+        entry.used = true;
+        entry.lines.clone()
+    }
+
+    /// After a parse: forget the blocks not shown since the previous parse.
+    pub fn sweep(&mut self) {
+        let entries = self.entries.get_mut().unwrap();
+        entries.retain(|_, entry| entry.used);
+        for entry in entries.values_mut() {
+            entry.used = false;
+        }
+    }
+}
+
+/// Colour `code` as the editor would with `theme`. `None` for no or an unknown language, an
+/// unknown theme, or a block over `MAX_LINES` lines.
+pub fn highlight(system: &SyntaxSystem, theme: &str, language: &str, code: &str) -> Option<Lines> {
+    // The info string may carry more after the language: "rust,ignore", "json {.class}"
+    let token = language
+        .split(|c: char| c == ',' || c == '{' || c.is_whitespace())
+        .next()
+        .filter(|token| !token.is_empty())?;
+    let syntax = system.syntax_set.find_syntax_by_token(token)?;
+    let theme = system.theme_set.themes.get(theme)?;
+    if code.lines().nth(MAX_LINES).is_some() {
+        return None;
+    }
+    let mut highlighter = HighlightLines::new(syntax, theme);
+    // The syntax set is built without newlines, as in the editor: feed lines without them
+    code.lines()
+        .map(|line| {
+            let ranges = highlighter.highlight_line(line, &system.syntax_set).ok()?;
+            Some(
+                ranges
+                    .into_iter()
+                    .map(|(style, text)| {
+                        let c = style.foreground;
+                        (
+                            Color::from_rgba8(c.r, c.g, c.b, f32::from(c.a) / 255.0),
+                            text.to_owned(),
+                        )
+                    })
+                    .collect(),
+            )
+        })
+        .collect()
+}
+

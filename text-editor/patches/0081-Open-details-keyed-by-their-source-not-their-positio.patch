+        let mut preview = Preview::new(ViewMode::Preview);
+        preview.parse(text, None);
+        let second = details_keys(text)[1].clone();
+        preview.toggle_details(second.clone());
+        // Another "Example" above both, in the same section
+        let added = "# Install\n\n<details><summary>Example</summary>new</details>\n\n\
+                     <details><summary>Example</summary>first</details>\n\n\

-    /// The key of the next `<details>` with this summary under `heading`.
-    fn details_key(&mut self, heading: String, summary: &[Piece]) -> DetailsKey {
+    /// The key of the next `<details>` with this summary and `source` under `heading`.
+    fn details_key(&mut self, heading: String, summary: &[Piece], source: &str) -> DetailsKey {
         let summary = summary_text(summary);
+        let mut hasher = std::hash::DefaultHasher::new();
+        std::hash::Hash::hash(source, &mut hasher);
+        let body = std::hash::Hasher::finish(&hasher);
         let count = self
             .details
-            .entry((heading.clone(), summary.clone()))
+            .entry((heading.clone(), summary.clone(), body))
             .or_default();
         let occurrence = *count;
         *count += 1;
         DetailsKey {
             heading,
             summary,
+            body,
             occurrence,
         }
     }

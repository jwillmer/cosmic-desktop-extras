+
+    fn lines(text: &str) -> Vec<&str> {
+        text.lines().collect()
+    }
+
+    #[test]
+    fn json_object_fold_range() {
+        let json = lines("{\n  \"a\": \"}{\",\n  \"b\": [\n    1,\n    2\n  ],\n  \"c\": {}\n}");
+        assert_eq!(fold_range(&json, 0, FoldKind::Brackets), Some((1, 6)));
+        assert_eq!(fold_range(&json, 2, FoldKind::Brackets), Some((3, 4)));
+        // Opened and closed on the same line, or not opened at all
+        assert_eq!(fold_range(&json, 6, FoldKind::Brackets), None);
+        assert_eq!(fold_range(&json, 1, FoldKind::Brackets), None);
+        // An empty block hides nothing
+        assert_eq!(fold_range(&lines("{\n}"), 0, FoldKind::Brackets), None);
+        // Unclosed: nothing to fold
+        assert_eq!(fold_range(&lines("[\n1"), 0, FoldKind::Brackets), None);
+        assert_eq!(
+            FoldKind::for_path(Some(Path::new("a.JSON"))),
+            FoldKind::Brackets
+        );
+    }
+
+    #[test]
+    fn indent_block_fold_range() {
+        let py = lines("def f():\n    a = 1\n\n    if a:\n        b\nc\n");
+        assert_eq!(fold_range(&py, 0, FoldKind::Indent), Some((1, 4)));
+        assert_eq!(fold_range(&py, 3, FoldKind::Indent), Some((4, 4)));
+        assert_eq!(fold_range(&py, 1, FoldKind::Indent), None);
+        // A blank header heads nothing
+        assert_eq!(fold_range(&py, 2, FoldKind::Indent), None);
+        assert_eq!(
+            FoldKind::for_path(Some(Path::new("a.py"))),
+            FoldKind::Indent
+        );
+        assert_eq!(FoldKind::for_path(None), FoldKind::Indent);
+    }
+
+    #[test]
+    fn markdown_section_fold_range() {
+        let md = lines("# A\ntext\n## B\n```\n# not a heading\n```\n\n# C\nend");
+        assert_eq!(fold_range(&md, 0, FoldKind::Markdown), Some((1, 5)));
+        assert_eq!(fold_range(&md, 2, FoldKind::Markdown), Some((3, 5)));
+        assert_eq!(fold_range(&md, 7, FoldKind::Markdown), Some((8, 8)));
+        assert_eq!(fold_range(&md, 1, FoldKind::Markdown), None);
+        assert_eq!(fold_range(&lines("#tag"), 0, FoldKind::Markdown), None);
+        assert_eq!(
+            FoldKind::for_path(Some(Path::new("README.md"))),
+            FoldKind::Markdown
+        );
+    }
+
+    #[test]
+    fn edit_inside_fold_unfolds() {
+        let mut editor = editor(RUST, "rs");
+        editor.with_buffer_mut(|buffer| {
+            assert_eq!(fold(buffer, 2, FoldKind::Brackets), Some(0));
+            assert_eq!(folded_after(buffer, 0), Some((1, 3)));
+        });
+        // A find hit or a programmatic cursor inside reveals the fold
+        editor.set_cursor(cosmic_text::Cursor::new(2, 4));
+        let cursor = editor.cursor();
+        editor.with_buffer_mut(|buffer| assert!(reveal(buffer, cursor.line)));
+        editor.with_buffer(|buffer| assert!(buffer.lines.iter().all(|line| !is_hidden(line))));
+        assert_eq!(text(&editor), RUST);
+        // Toggle on the header folds and unfolds
+        editor.with_buffer_mut(|buffer| {
+            assert!(toggle(buffer, 0, FoldKind::Brackets));
+            assert!(is_hidden(&buffer.lines[3]));
+            assert!(toggle(buffer, 0, FoldKind::Brackets));
+            assert!(!is_hidden(&buffer.lines[3]));
+            fold_all(buffer, FoldKind::Brackets);
+            assert_eq!(folded_after(buffer, 0), Some((1, 3)));
+            unfold_all(buffer);
+            assert_eq!(folded_after(buffer, 0), None);
+        });
+    }
+
+    #[test]
+    fn cursor_down_skips_fold() {
+        let mut editor = editor(RUST, "rs");
+        editor.with_buffer_mut(|buffer| {
+            fold(buffer, 0, FoldKind::Brackets);
+        });
+        shape(&mut editor);
+        editor.set_cursor(cosmic_text::Cursor::new(0, 3));
+        let mut font_system = font_system().lock().unwrap();
+        let mut down = |editor: &mut ViEditor<'static, 'static>, motion| {
+            let from = editor.cursor();
+            editor.action(&mut font_system, cosmic_text::Action::Motion(motion));
+            let to = editor.cursor();
+            let to = editor.with_buffer(|buffer| skip_fold(buffer, from, to));
+            editor.set_cursor(to);
+            to.line
+        };
+        assert_eq!(down(&mut editor, cosmic_text::Motion::Down), 4);
+        assert_eq!(down(&mut editor, cosmic_text::Motion::Up), 0);
+    }
+
+    #[test]
+    fn copy_across_fold_includes_hidden_text() {
+        let mut editor = editor(RUST, "rs");
+        editor.with_buffer_mut(|buffer| {
+            fold(buffer, 0, FoldKind::Brackets);
+        });
+        editor.set_selection(cosmic_text::Selection::Normal(cosmic_text::Cursor::new(
+            0, 0,
+        )));
+        editor.set_cursor(cosmic_text::Cursor::new(4, 1));
+        assert_eq!(
+            editor.copy_selection().unwrap(),
+            RUST[..RUST.find("}\n").unwrap() + 1]
+        );
+    }
 }

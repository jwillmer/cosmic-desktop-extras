-
-/// The scope for the "In selection" range `range` (if one was set), which `holds` while it is
-/// for the active tab and the text as it is now. A range that no longer holds gives way to
-/// `selection` (the active tab's, when not empty), as in Notepad++; without one the scope is
-/// the whole text, and the option shows off, so the scope never widens behind a ticked box.
-pub fn scope(range: Option<(Pos, Pos)>, holds: bool, selection: Option<(Pos, Pos)>) -> Scope {
-    match range {
-        None => Scope::Whole,
-        Some(range) if holds => Scope::Range(range),
-        Some(_) => selection.map_or(Scope::Whole, Scope::Range),

+    #[test]
+    fn leaves_in_a_scrolled_block_compare_with_the_rest() {
+        // A code line in a block scrolled 120 px to the right sees the pointer 120 px further
+        let window = Some(Point::new(300.0, 200.0));
+        let paragraph = Rectangle::new(Point::new(0.0, 150.0), Size::new(100.0, 20.0));
+        let code_line = Rectangle::new(Point::new(0.0, 190.0), Size::new(600.0, 20.0));
+        let beside = Near::of(paragraph, Point::new(300.0, 200.0))
+            .unwrap()
+            .in_window(window);
+        let over = Near::of(code_line, Point::new(420.0, 200.0))
+            .unwrap()
+            .in_window(window);
+        assert!(beside.loses_to(&over));
+        assert!(!over.loses_to(&beside));
+    }

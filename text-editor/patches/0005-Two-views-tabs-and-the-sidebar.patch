+
+    #[test]
+    fn save_as_onto_an_open_file_pairs_nothing() {
+        // Tab a is saved as the file tab b has open: one path, but not clones
+        let mut model = SingleSelectModel::default();
+        let (ea, eb) = (model.insert().id(), model.insert().id());
+        assert!(Mirror::default().groups([ea, eb]).is_empty());
+        // Tabs of one file in a session from before links were kept are clones
+        let old = |path: &str| crate::session::SessionTab {
+            path: Some(PathBuf::from(path)),
+            ..Default::default()
+        };
+        let session = [old("/a"), old("/b"), old("/a")];
+        let ec = model.insert().id();
+        let groups = crate::session::restored_clones(&session, &[Some(ea), Some(eb), Some(ec)]);
+        assert_eq!(groups, vec![vec![ea, ec]]);
+    }
+
+    #[test]
+    fn save_as_in_untitled_clone_saves_both() {
+        let mut a = EditorTab::new(&config());
+        type_at(&a, Cursor::new(0, 0), "milk\n");
+        let (mut b, synced) = clone_of(&a);
+        let path = dir("save-as").join("list.txt");
+        // Save As in a: the group takes the new path, then a saves
+        rename(&mut a, &path);
+        rename(&mut b, &path);
+        a.save();
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), "milk\n");
+        assert_eq!(sync(&mut [&mut a, &mut b], Some(synced), 0).saved, vec![1]);
+        assert!(!a.changed() && !b.changed());
+        assert_eq!(b.path_opt.as_deref(), Some(path.as_path()));
+        // b knows the file it would write is the one on disk
+        let disk = b.disk.read(&path).unwrap();
+        assert!(b.disk.may_write(disk));
+        let _ = std::fs::remove_dir_all(path.parent().unwrap());
+    }
+
+    #[test]
+    fn restored_unsaved_clones_stay_paired() {
+        // Two untitled clones and one file tab, as the session lists them
+        let saved = |clone| crate::session::SessionTab {
+            clone,
+            ..Default::default()
+        };
+        let session = [saved(Some(7)), saved(None), saved(Some(7))];
+        let mut model = SingleSelectModel::default();
+        let (ea, eb, ec) = (
+            model.insert().id(),
+            model.insert().id(),
+            model.insert().id(),
+        );
+        let groups = crate::session::restored_clones(&session, &[Some(ea), Some(eb), Some(ec)]);
+        assert_eq!(groups, vec![vec![ea, ec]]);
+        let mut mirror = Mirror::default();
+        let key = mirror.link(&groups[0][..1], groups[0][1], None);
+        assert_eq!(mirror.groups([ea, eb, ec])[&key], vec![ea, ec]);
+        // Both come back with the same draft: a new group that mirrors, not two drafts apart
+        let draft = |text: &str| {
+            let tab = EditorTab::new(&config());
+            type_at(&tab, Cursor::new(0, 0), text);
+            tab
+        };
+        let (mut a, mut c) = (draft("milk\n"), draft("milk\n"));
+        let outcome = sync(&mut [&mut a, &mut c], None, 0);
+        assert!(!outcome.diverged);
+        type_at(&c, Cursor::new(0, 4), " and honey");
+        sync(&mut [&mut a, &mut c], Some(outcome.hash), 1);
+        assert_eq!(text(&a), "milk and honey\n");
+    }
+}

+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Opening a file in a new tab.
+
+use cosmic::widget::segmented_button;
+use std::path::PathBuf;
+
+use crate::{
+    App, markdown,
+    tab::{EditorTab, Tab},
+};
+
+impl App {
+    /// Open a file in a new tab even when it is open already (Clone to other view, and the
+    /// restore of such a clone).
+    pub fn open_tab_again(
+        &mut self,
+        path: Option<PathBuf>,
+        markdown_view: Option<markdown::ViewMode>,
+    ) -> Option<segmented_button::Entity> {
+        let path = path?;
+        let mut tab = EditorTab::new(&self.config);
+        tab.open(path);
+        tab.path_opt.as_ref()?;
+        tab.markdown_init(markdown_view.unwrap_or(self.config.markdown_view));
+        Some(self.insert_tab(tab))
+    }
+
+    pub fn insert_tab(&mut self, tab: EditorTab) -> segmented_button::Entity {
+        let entity = self
+            .tab_model
+            .insert()
+            .text(tab.title())
+            .icon(tab.icon(16))
+            .data::<Tab>(Tab::Editor(tab))
+            .closable()
+            .activate()
+            .id();
+        self.update_watcher();
+        entity
+    }
+}
diff --git a/src/close_tabs.rs b/src/close_tabs.rs
new file mode 100644
index 0000000..cf4ab1c
--- /dev/null
+++ b/src/close_tabs.rs
@@ -0,0 +1,389 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Close all, Close others, Close tabs to the right (File menu and the tab's right-click menu).
+//!
+//! Clean tabs, compare and git diff tabs close without asking. Tabs with unsaved changes get one
+//! prompt for the whole action: Save all, Discard all or Cancel. Cancel closes nothing, not even
+//! the clean tabs. Save all saves the tabs with a file and asks Save As for each untitled one in
+//! turn; cancelling a Save As stops there and keeps the remaining tabs open. Discard all closes
+//! them like Discard on a single tab, so their drafts leave the session. Closing every tab leaves
+//! one new empty tab instead of quitting.
+
+use cosmic::{app::Task, widget::segmented_button::Entity};
+use std::fs;
+
+use crate::{App, DialogPage, Message as AppMessage, fl, tab::Tab};
+
+/// Which tabs an action closes, relative to the tab it was started on.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Scope {
+    All,
+    Others,
+    ToTheRight,
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    /// Close tabs relative to the given tab, or the active tab.
+    Request(Scope, Option<Entity>),
+    /// The tab bar's right-click menu was opened on this tab.
+    TabBarContext(Entity),
+    /// An entry of the tab bar's right-click menu.
+    TabBar(Scope),
+    /// A button of the prompt.
+    Answer(Answer),
+    /// Close these tabs without asking.
+    Force(Vec<Entity>),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::CloseTabs(message)
+    }
+}
+
+/// The tabs an action closes, and those of them with unsaved changes.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Plan<E> {
+    pub close: Vec<E>,
+    pub unsaved: Vec<E>,
+}
+
+/// Plan an action over `tabs` (in tab bar order, each with "has unsaved changes"), started on
+/// `anchor`. An anchor that is no longer open closes nothing for Others and To the right.
+pub fn plan<E: Copy + PartialEq>(tabs: &[(E, bool)], scope: Scope, anchor: E) -> Plan<E> {
+    let anchor_pos = tabs.iter().position(|(entity, _)| *entity == anchor);
+    let closes = |pos: usize| match (scope, anchor_pos) {
+        (Scope::All, _) => true,
+        (Scope::Others, Some(anchor_pos)) => pos != anchor_pos,
+        (Scope::ToTheRight, Some(anchor_pos)) => pos > anchor_pos,
+        (_, None) => false,
+    };
+    let closing: Vec<(E, bool)> = tabs
+        .iter()
+        .enumerate()
+        .filter(|(pos, _)| closes(*pos))
+        .map(|(_, tab)| *tab)
+        .collect();
+    Plan {
+        close: closing.iter().map(|(entity, _)| *entity).collect(),
+        unsaved: closing
+            .iter()
+            .filter(|(_, unsaved)| *unsaved)
+            .map(|(entity, _)| *entity)
+            .collect(),
+    }
+}
+
+/// The prompt's answer.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Answer {
+    SaveAll,
+    DiscardAll,
+    Cancel,
+}
+
+/// The tabs that close right away for an answer. Save all closes them once every one is saved.
+pub fn close_now<E: Copy>(plan: &Plan<E>, answer: Answer) -> Vec<E> {
+    match answer {
+        Answer::DiscardAll => plan.close.clone(),
+        Answer::SaveAll | Answer::Cancel => Vec::new(),
+    }
+}
+
+/// The tab to activate when the active tab closes: the nearest kept tab to its left, else to
+/// its right. `None` when every tab closes (a new empty tab takes over).
+pub fn next_active<E: Copy + PartialEq>(tabs: &[E], close: &[E], active: E) -> Option<E> {
+    let pos = tabs.iter().position(|entity| *entity == active)?;
+    let kept = |entity: &&E| !close.contains(entity);
+    tabs[..pos]
+        .iter()
+        .rev()
+        .find(kept)
+        .or_else(|| tabs[pos..].iter().find(kept))
+        .copied()
+}
+
+impl App {
+    fn has_unsaved(&self, entity: Entity) -> bool {
+        matches!(self.tab_model.data::<Tab>(entity), Some(Tab::Editor(tab)) if tab.changed())
+    }
+
+    /// Unsaved changes that closing `close` would lose: a tab whose clone (same text) stays
+    /// open loses nothing (the clone is in the other view).
+    fn loses_changes(&self, entity: Entity, close: &[Entity]) -> bool {
+        self.has_unsaved(entity)
+            && !self.clone_group(entity).into_iter().any(|clone| {
+                clone != entity && !close.contains(&clone) && self.same_text(entity, clone)
+            })
+    }
+
+    /// The prompt's text: how many tabs have unsaved changes, and their names.
+    pub fn close_tabs_prompt(&self, unsaved: &[Entity]) -> String {
+        let names: Vec<String> = unsaved
+            .iter()
+            .filter_map(|entity| self.tab_model.data::<Tab>(*entity))
+            .map(Tab::title)
+            .collect();
+        fl!(
+            "prompt-unsaved-tabs",
+            count = names.len(),
+            names = names.join(", ")
+        )
+    }
+
+    /// Keep the prompt in step with saves: close once nothing is unsaved, else ask Save As for
+    /// the next untitled tab while Save all is running.
+    pub fn close_tabs_dialog(&mut self) -> Task<AppMessage> {
+        let Some(DialogPage::CloseTabs { plan, saving }) = &self.dialog_page_opt else {
+            return Task::none();
+        };
+        let (close, saving) = (plan.close.clone(), *saving);
+        let unsaved: Vec<Entity> = close
+            .iter()
+            .copied()
+            .filter(|entity| self.loses_changes(*entity, &close))
+            .collect();
+        if unsaved.is_empty() {
+            self.dialog_page_opt = None;
+            return self.update_close_tabs(Message::Force(close));
+        }
+        let untitled = unsaved.iter().copied().find(|entity| {
+            matches!(self.tab_model.data::<Tab>(*entity), Some(Tab::Editor(tab)) if tab.path_opt.is_none())
+        });
+        self.dialog_page_opt = Some(DialogPage::CloseTabs {
+            plan: Plan { close, unsaved },
+            saving,
+        });
+        match untitled {
+            Some(entity) if saving && self.dialog_opt.is_none() => {
+                // Show the untitled tab being named. Not `TabActivate`: it closes this prompt.
+                self.tab_model.activate(entity);
+                Task::batch([
+                    self.update_tab(),
+                    self.update(AppMessage::SaveAsDialog(Some(entity))),
+                ])
+            }
+            _ => Task::none(),
+        }
+    }
+
+    /// A Save As was cancelled: while Save all runs, stop and keep the remaining tabs open.
+    pub fn close_tabs_save_as_cancelled(&mut self) {
+        if let Some(DialogPage::CloseTabs { saving: true, .. }) = self.dialog_page_opt {
+            self.dialog_page_opt = None;
+        }
+    }
+
+    pub fn update_close_tabs(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Request(scope, anchor) => {
+                let anchor = anchor.unwrap_or_else(|| self.tab_model.active());
+                // With two views, only the tabs of the anchor's view
+                let tabs: Vec<(Entity, bool)> = self
+                    .view_tabs_with(anchor)
+                    .into_iter()
+                    .map(|entity| (entity, self.has_unsaved(entity)))
+                    .collect();
+                let mut plan = plan(&tabs, scope, anchor);
+                let close = plan.close.clone();
+                plan.unsaved
+                    .retain(|entity| self.loses_changes(*entity, &close));
+                if plan.close.is_empty() {
+                    return Task::none();
+                }
+                if plan.unsaved.is_empty() {
+                    return self.update_close_tabs(Message::Force(plan.close));
+                }
+                self.dialog_page_opt = Some(DialogPage::CloseTabs {
+                    plan,
+                    saving: false,
+                });
+            }
+            Message::TabBarContext(entity) => {
+                self.tab_bar_context = Some(entity);
+            }
+            Message::TabBar(scope) => {
+                let anchor = self.tab_bar_context.take();
+                return self.update_close_tabs(Message::Request(scope, anchor));
+            }
+            Message::Answer(answer) => {
+                let Some(DialogPage::CloseTabs { plan, saving }) = &mut self.dialog_page_opt else {
+                    return Task::none();
+                };
+                if answer != Answer::SaveAll {
+                    // Cancel closes nothing; Discard all closes every tab of the action
+                    let close = close_now(plan, answer);
+                    self.dialog_page_opt = None;
+                    return self.update_close_tabs(Message::Force(close));
+                }
+                *saving = true;
+                let unsaved = plan.unsaved.clone();
+                let mut tasks = Vec::new();
+                for entity in unsaved {
+                    // Untitled tabs get their Save As one at a time from `close_tabs_dialog`
+                    let mut saved = None;
+                    if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                        && let Some(path) = tab.path_opt.clone()
+                    {
+                        tab.save();
+                        // A refused or failed save keeps the tab unsaved and in the prompt
+                        if !tab.changed() {
+                            saved = Some((tab.title(), path));
+                        }
+                    }
+                    if let Some((title, path)) = saved {
+                        self.tab_model.text_set(entity, title);
+                        if let Ok(canonical) = fs::canonicalize(&path) {
+                            self.add_to_recents(&canonical);
+                        }
+                        tasks.push(self.change_history_changed(entity));
+                    }
+                }
+                tasks.push(self.close_tabs_dialog());
+                return Task::batch(tasks);
+            }
+            Message::Force(close) => {
+                let tabs: Vec<Entity> = self.tab_model.iter().collect();
+                let close: Vec<Entity> = close.into_iter().filter(|e| tabs.contains(e)).collect();
+                if close.is_empty() {
+                    return Task::none();
+                }
+                let active = self.tab_model.active();
+                // Closing a whole view: the other view's tab stays in front
+                let kept = self
+                    .split
+                    .as_ref()
+                    .and_then(|split| split.shown_after_closing(active, &close));
+                if close.contains(&active) {
+                    match kept.or_else(|| next_active(&tabs, &close, active)) {
+                        Some(entity) => {
+                            self.tab_model.activate(entity);
+                            self.disk_check(entity);
+                        }
+                        // Every tab closes: an empty editor shows one new empty tab
+                        None => {
+                            if self.open_tab(None).is_none() {
+                                log::error!("close tabs: no new empty tab, nothing closed");
+                                return Task::none();
+                            }
+                        }
+                    }
+                }
+                for entity in &close {
+                    self.tab_model.remove(*entity);
+                }
+                self.update_watcher();
+                if let Some(DialogPage::PromptSaveClose(entity)) = self.dialog_page_opt
+                    && close.contains(&entity)
+                {
+                    self.dialog_page_opt = None;
+                }
+                // Also records the session: the closed tabs and their drafts are gone from it
+                return self.update_tab();
+            }
+        }
+        Task::none()
+    }
+}
+
+/// Scenarios covered (logic level; the dialog itself is not driven):
+/// - clean tabs close at once, compare and git diff tabs count as clean
+/// - unsaved tabs give one prompt listing all of them
+/// - Cancel closes nothing, Discard all closes everything; a session without the closed tabs
+///   drops their drafts (the snapshot `Force` triggers through `update_tab` is not driven)
+/// - Close others keeps the tab it was started on, Close to the right keeps the left tabs
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::session::{SessionFile, SessionTab, Store};
+    use std::{path::PathBuf, process};
+
+    // Tabs 1..=4 in tab bar order; `true` has unsaved changes
+    const CLEAN: [(u32, bool); 4] = [(1, false), (2, false), (3, false), (4, false)];
+    const MIXED: [(u32, bool); 4] = [(1, true), (2, false), (3, true), (4, true)];
+
+    #[test]
+    fn close_all_closes_clean_tabs_without_asking() {
+        let plan = plan(&CLEAN, Scope::All, 2);
+        assert_eq!(plan.close, vec![1, 2, 3, 4]);
+        assert!(plan.unsaved.is_empty());
+        // Every tab closes: no tab is left to activate, a new empty one opens
+        assert_eq!(next_active(&[1, 2, 3, 4], &plan.close, 2), None);
+    }
+
+    #[test]
+    fn close_all_with_unsaved_asks_once() {
+        let plan = plan(&MIXED, Scope::All, 2);
+        assert_eq!(plan.close, vec![1, 2, 3, 4]);
+        // One prompt for the whole action, listing every unsaved tab
+        assert_eq!(plan.unsaved, vec![1, 3, 4]);
+        // Save all closes only once everything is saved
+        assert!(close_now(&plan, Answer::SaveAll).is_empty());
+    }
+
+    #[test]
+    fn cancel_closes_nothing() {
+        let plan = plan(&MIXED, Scope::All, 2);
+        // Not even the clean tab 2
+        assert!(close_now(&plan, Answer::Cancel).is_empty());
+    }
+
+    #[test]
+    fn discard_all_deletes_drafts() {
+        let plan = plan(&MIXED, Scope::All, 1);
+        assert_eq!(close_now(&plan, Answer::DiscardAll), vec![1, 2, 3, 4]);
+
+        // The closed tabs leave the session, and the next snapshot deletes their drafts
+        let dir = std::env::temp_dir().join(format!("close-tabs-discard-{}", process::id()));
+        let _ = fs::remove_dir_all(&dir);
+        let mut store = Store::open(dir.clone()).unwrap();
+        let ids = ["a", "c", "d"];
+        for id in ids {
+            store.write_backup(id, id).unwrap();
+        }
+        let tab = |id: &str| SessionTab {
+            path: Some(PathBuf::from(format!("/srv/{id}.md"))),
+            backup: Some(id.to_string()),
+            ..Default::default()
+        };
+        let mut session = SessionFile {
+            tabs: ids.iter().map(|id| tab(id)).collect(),
+            ..Default::default()
+        };
+        store.save(session.clone()).unwrap();
+        for id in ids {
+            assert!(store.read_backup(id).unwrap().is_some());
+        }
+        session.tabs.clear();
+        store.save(session).unwrap();
+        for id in ids {
+            assert_eq!(store.read_backup(id).unwrap(), None);
+        }
+        fs::remove_dir_all(dir).unwrap();
+    }
+
+    #[test]
+    fn close_others_keeps_active() {
+        let plan = plan(&MIXED, Scope::Others, 3);
+        assert_eq!(plan.close, vec![1, 2, 4]);
+        assert_eq!(plan.unsaved, vec![1, 4]);
+        // Started on tab 3 while tab 1 was active: 3 becomes active
+        assert_eq!(next_active(&[1, 2, 3, 4], &plan.close, 1), Some(3));
+    }
+
+    #[test]
+    fn close_to_the_right_keeps_left_tabs() {
+        let plan = plan(&MIXED, Scope::ToTheRight, 2);
+        assert_eq!(plan.close, vec![3, 4]);
+        assert_eq!(plan.unsaved, vec![3, 4]);
+        // The active tab 4 closes: the nearest kept tab to its left takes over
+        assert_eq!(next_active(&[1, 2, 3, 4], &plan.close, 4), Some(2));
+        // Nothing to the right of the last tab
+        assert!(plan_is_empty(Scope::ToTheRight, 4));
+    }
+
+    fn plan_is_empty(scope: Scope, anchor: u32) -> bool {
+        plan(&MIXED, scope, anchor).close.is_empty()
+    }
+}
diff --git a/src/mirror.rs b/src/mirror.rs
new file mode 100644
index 0000000..277cb54
--- /dev/null
+++ b/src/mirror.rs
@@ -0,0 +1,763 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! A clone ("Clone to other view") mirrors its document: the tabs of a group hold the same
+//! text. Clone pairs a tab with a new one by a link, which also pairs untitled tabs. Tabs of one
+//! file are not clones by their path alone (Save As onto a file open in another tab). cosmic-text keeps the buffer, cursor and undo history together in one editor per tab,
+//! so the tabs cannot share a buffer. Instead, after every message an edit in one tab is applied
+//! to the others as one change of their own: each tab keeps its own cursor, scroll and undo
+//! history, and the text stays identical. A clone starts with the text of its tab, unsaved edits
+//! included. Saving one marks the others saved, Save As gives all of them the new path, and
+//! reloading or reverting one reloads all. A mirrored change makes the texts equal, so it is never mirrored
+//! back. Clones that hold different unsaved text (drafts of a restored session) are not
+//! mirrored: they stay apart, each with its own text, until one is closed.
+
+use cosmic::{app::Task, widget::segmented_button::Entity};
+use cosmic_text::{Cursor, Edit};
+use std::{
+    collections::{HashMap, HashSet, hash_map::DefaultHasher},
+    hash::{Hash, Hasher},
+    path::Path,
+};
+
+use crate::{
+    App, Message as AppMessage,
+    tab::{EditorTab, Tab, editor_text},
+};
+
+/// What pairs the tabs of a group of clones.
+#[derive(Clone, Debug, Eq, Hash, PartialEq)]
+pub enum Key {
+    /// Clone to other view, or a restored group of clones.
+    Link(u64),
+}
+
+/// The groups of clones and the text each last agreed on, by hash.
+#[derive(Debug, Default)]
+pub struct Mirror {
+    synced: HashMap<Key, u64>,
+    /// Groups whose tabs held different unsaved text: they stay apart until one is closed.
+    unpaired: HashSet<Key>,
+    links: HashMap<Entity, u64>,
+    next_link: u64,
+}
+
+impl Mirror {
+    /// The groups of more than one tab, from every editor tab.
+    pub fn groups(&self, tabs: impl IntoIterator<Item = Entity>) -> HashMap<Key, Vec<Entity>> {
+        let mut groups: HashMap<Key, Vec<Entity>> = HashMap::new();
+        for entity in tabs {
+            if let Some(link) = self.links.get(&entity) {
+                groups.entry(Key::Link(*link)).or_default().push(entity);
+            }
+        }
+        groups.retain(|_, tabs| tabs.len() > 1);
+        groups
+    }
+
+    /// Pair `clone` with `group` (a tab and the clones it has already). `synced` is the hash of
+    /// the text they share, when known: they start identical, so neither counts as edited.
+    /// A tab of an unpaired group takes a new link: the others keep their own text.
+    pub fn link(&mut self, group: &[Entity], clone: Entity, synced: Option<u64>) -> Key {
+        let link = group
+            .iter()
+            .filter_map(|entity| self.links.get(entity).copied())
+            .find(|link| !self.unpaired.contains(&Key::Link(*link)))
+            .unwrap_or_else(|| {
+                self.next_link += 1;
+                self.next_link
+            });
+        for entity in group.iter().chain([&clone]) {
+            self.links.insert(*entity, link);
+        }
+        let key = Key::Link(link);
+        self.unpaired.remove(&key);
+        match synced {
+            Some(hash) => self.synced.insert(key.clone(), hash),
+            None => self.synced.remove(&key),
+        };
+        key
+    }
+
+    /// The link of a tab paired with others, for the session.
+    pub fn link_of(&self, entity: Entity) -> Option<u64> {
+        self.links.get(&entity).copied()
+    }
+}
+
+pub fn text_hash(text: &str) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    text.hash(&mut hasher);
+    hasher.finish()
+}
+
+/// The byte range of `old` that differs from `new`, and what replaces it; `None` when equal.
+fn difference<'a>(old: &str, new: &'a str) -> Option<(usize, usize, &'a str)> {
+    if old == new {
+        return None;
+    }
+    let mut prefix = old
+        .bytes()
+        .zip(new.bytes())
+        .take_while(|(a, b)| a == b)
+        .count();
+    while !old.is_char_boundary(prefix) || !new.is_char_boundary(prefix) {
+        prefix -= 1;
+    }
+    let max_suffix = old.len().min(new.len()) - prefix;
+    let mut suffix = old
+        .bytes()
+        .rev()
+        .zip(new.bytes().rev())
+        .take(max_suffix)
+        .take_while(|(a, b)| a == b)
+        .count();
+    while !old.is_char_boundary(old.len() - suffix) || !new.is_char_boundary(new.len() - suffix) {
+        suffix -= 1;
+    }
+    Some((prefix, old.len() - suffix, &new[prefix..new.len() - suffix]))
+}
+
+/// The cursor at byte `offset` of the editor's text (lines with their endings).
+fn cursor_at<'buffer, E: Edit<'buffer>>(editor: &E, offset: usize) -> Cursor {
+    editor.with_buffer(|buffer| {
+        let mut start = 0;
+        for (line, buffer_line) in buffer.lines.iter().enumerate() {
+            let len = buffer_line.text().len();
+            if offset <= start + len {
+                return Cursor::new(line, offset - start);
+            }
+            start += len + buffer_line.ending().as_str().len();
+        }
+        let last = buffer.lines.len().saturating_sub(1);
+        Cursor::new(last, buffer.lines.get(last).map_or(0, |l| l.text().len()))
+    })
+}
+
+/// The byte offset of `cursor` in the editor's text.
+fn offset_of<'buffer, E: Edit<'buffer>>(editor: &E, cursor: Cursor) -> usize {
+    editor.with_buffer(|buffer| {
+        let before: usize = buffer.lines[..cursor.line.min(buffer.lines.len())]
+            .iter()
+            .map(|line| line.text().len() + line.ending().as_str().len())
+            .sum();
+        before + cursor.index
+    })
+}
+
+/// Turn the text of `editor` into `text` with one undoable change over the range that differs.
+/// Its cursor stays on the same text. Returns false when the texts were equal already.
+pub fn mirror_into<'buffer, E: Edit<'buffer>>(editor: &mut E, text: &str) -> bool {
+    let old = {
+        let mut old = String::new();
+        editor.with_buffer(|buffer| {
+            for line in &buffer.lines {
+                old.push_str(line.text());
+                old.push_str(line.ending().as_str());
+            }
+        });
+        old
+    };
+    let Some((start, end, insert)) = difference(&old, text) else {
+        return false;
+    };
+    let cursor = offset_of(editor, editor.cursor());
+    let cursor = if cursor >= end {
+        cursor - end + start + insert.len()
+    } else if cursor > start {
+        start + insert.len()
+    } else {
+        cursor
+    };
+    editor.set_selection(cosmic_text::Selection::None);
+    let (from, to) = (cursor_at(editor, start), cursor_at(editor, end));
+    // Never change hidden text: unfold what the change touches, as an edit in the tab does
+    editor.with_buffer_mut(|buffer| crate::folding::unfold_lines(buffer, from.line, to.line));
+    editor.start_change();
+    if from != to {
+        crate::tab::delete_in_pieces(editor, from, to);
+    }
+    if !insert.is_empty() {
+        crate::tab::insert_in_pieces(editor, from, insert);
+    }
+    editor.finish_change();
+    let cursor = cursor_at(editor, cursor);
+    editor.set_cursor(cursor);
+    true
+}
+
+/// What [`mirror_group`] did.
+#[derive(Debug, Default, PartialEq)]
+pub struct Outcome {
+    /// The text the tabs agree on now, by hash.
+    pub hash: u64,
+    /// The tabs whose text changed.
+    pub mirrored: Vec<usize>,
+    /// The tabs to mark saved with [`mark_saved`]: another one with the same text is saved.
+    pub saved: Vec<usize>,
+    /// Two tabs hold different unsaved text (drafts of a restored session, say): nothing was
+    /// mirrored, and the tabs are no longer clones of each other.
+    pub diverged: bool,
+}
+
+/// Bring a group of clones into line. `synced` is the hash they last agreed on; the tab whose
+/// text differs from it was edited (the first one, or `prefer`, when several did).
+pub fn mirror_group(tabs: &[&EditorTab], synced: Option<u64>, prefer: Option<usize>) -> Outcome {
+    let texts: Vec<String> = tabs
+        .iter()
+        .map(|tab| editor_text(&tab.editor.lock().unwrap()))
+        .collect();
+    let hashes: Vec<u64> = texts.iter().map(|text| text_hash(text)).collect();
+    let mut mirrored = Vec::new();
+    // The edited tabs: those that left the agreed text, or in a new group (a restored session)
+    // those with unsaved text, which wins over the file
+    let sources: Vec<usize> = match synced {
+        Some(synced) => (0..tabs.len()).filter(|i| hashes[*i] != synced).collect(),
+        None => (0..tabs.len()).filter(|i| tabs[*i].changed()).collect(),
+    };
+    // Different unsaved texts: mirroring either would lose the other
+    if sources.iter().any(|i| hashes[*i] != hashes[sources[0]]) {
+        return Outcome {
+            hash: synced.unwrap_or(hashes[0]),
+            diverged: true,
+            ..Outcome::default()
+        };
+    }
+    let edited = sources.first().copied().or(prefer).unwrap_or(0);
+    for (i, tab) in tabs.iter().enumerate() {
+        if i != edited && hashes[i] != hashes[edited] {
+            mirror_into(&mut *tab.editor.lock().unwrap(), &texts[edited]);
+            mirrored.push(i);
+        }
+    }
+    // One of them was saved (or undone to its saved state): the same text is saved in all
+    let saved = if tabs.iter().any(|tab| !tab.changed()) {
+        (0..tabs.len()).filter(|i| tabs[*i].changed()).collect()
+    } else {
+        Vec::new()
+    };
+    Outcome {
+        hash: hashes[edited],
+        mirrored,
+        saved,
+        diverged: false,
+    }
+}
+
+/// A new tab with the document of `source`: its file, or none for an untitled tab, and its
+/// text with unsaved edits, as one undo step (as a restored draft): undoing it in the clone
+/// takes the group back to the file.
+pub fn clone_tab(source: &EditorTab, config: &crate::Config) -> EditorTab {
+    let mut clone = EditorTab::new(config);
+    if let Some(path) = &source.path_opt {
+        clone.open(path.clone());
+    }
+    if source.language.chosen.is_some() {
+        clone.set_language(source.language.chosen.clone());
+    }
+    if source.changed() {
+        let text = editor_text(&source.editor.lock().unwrap());
+        let mut editor = clone.editor.lock().unwrap();
+        mirror_into(&mut *editor, &text);
+        // The file may hold this text already: it is unsaved in its tab all the same
+        editor.set_changed(true);
+        drop(editor);
+        // The file the unsaved text is based on, not the one on disk now
+        clone.disk_restored(Some(source.disk.base()));
+    }
+    clone
+}
+
+/// Give a clone the path its group was saved as (Save As in another clone).
+pub fn rename(tab: &mut EditorTab, path: &Path) {
+    tab.disk.retarget(path);
+    tab.path_opt = Some(path.to_path_buf());
+    tab.markdown_path_changed();
+}
+
+/// Reload every tab of a clone group from the file, as one action: reloading only one would
+/// mirror the file's text over the others' unsaved edits.
+pub fn reload_group(tabs: &mut [&mut EditorTab]) {
+    for tab in tabs {
+        tab.reload();
+        tab.markdown_refresh();
+    }
+}
+
+/// Mark a clone saved: its text is in the file, as another clone just saved it.
+pub fn mark_saved(tab: &mut EditorTab, base: Option<std::sync::Arc<str>>) {
+    let text = {
+        let mut editor = tab.editor.lock().unwrap();
+        editor.save_point();
+        editor_text(&editor)
+    };
+    tab.history.saved_as_clone(&text, base);
+    if let Some(path) = tab.path_opt.clone() {
+        tab.disk.took(&path, &text);
+    }
+}
+
+impl App {
+    /// Every group of clones.
+    fn clone_groups(&self) -> HashMap<Key, Vec<Entity>> {
+        self.mirror.groups(
+            self.tab_model.iter().filter(|entity| {
+                matches!(self.tab_model.data::<Tab>(*entity), Some(Tab::Editor(_)))
+            }),
+        )
+    }
+
+    /// `entity` and the clones that mirror it.
+    pub fn clone_group(&self, entity: Entity) -> Vec<Entity> {
+        self.clone_groups()
+            .into_iter()
+            .find(|(key, tabs)| tabs.contains(&entity) && !self.mirror.unpaired.contains(key))
+            .map_or_else(|| vec![entity], |(_, tabs)| tabs)
+    }
+
+    /// Give the clones of `entity` the path it was saved as: they are one document.
+    pub fn rename_clones(&mut self, entity: Entity, group: &[Entity], path: &Path) {
+        for clone in group.iter().filter(|clone| **clone != entity) {
+            if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(*clone) {
+                rename(tab, path);
+                let title = tab.title();
+                self.tab_model.text_set(*clone, title);
+            }
+        }
+    }
+
+    /// Reload a tab and its clones from the file (see [`reload_group`]).
+    pub fn reload_clones(&mut self, entity: Entity) -> Task<AppMessage> {
+        let group = self.clone_group(entity);
+        for entity in &group {
+            if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(*entity) {
+                reload_group(&mut [tab]);
+            }
+        }
+        Task::batch(
+            group
+                .into_iter()
+                .map(|entity| self.update(AppMessage::TabChanged(entity))),
+        )
+    }
+
+    /// Mirror the edits of every tab into its clones, after each message.
+    pub fn mirror_clones(&mut self) -> Task<AppMessage> {
+        let mut groups = self.clone_groups();
+        // A clone closed: the other is a normal tab again
+        self.mirror.synced.retain(|key, _| groups.contains_key(key));
+        self.mirror.unpaired.retain(|key| groups.contains_key(key));
+        self.mirror
+            .links
+            .retain(|_, link| groups.contains_key(&Key::Link(*link)));
+        groups.retain(|key, _| !self.mirror.unpaired.contains(key));
+        let active = self.tab_model.active();
+        let mut changed = Vec::new();
+        for (key, entities) in groups {
+            let tabs: Vec<&EditorTab> = entities
+                .iter()
+                .filter_map(|entity| match self.tab_model.data::<Tab>(*entity) {
+                    Some(Tab::Editor(tab)) => Some(tab),
+                    _ => None,
+                })
+                .collect();
+            let prefer = entities.iter().position(|entity| *entity == active);
+            let outcome = mirror_group(&tabs, self.mirror.synced.get(&key).copied(), prefer);
+            if outcome.diverged {
+                log::warn!(
+                    "{:?} is open in {} tabs with different unsaved text; they no longer mirror \
+                     each other",
+                    tabs.first().and_then(|tab| tab.path_opt.as_deref()),
+                    entities.len()
+                );
+                self.mirror.synced.remove(&key);
+                self.mirror.unpaired.insert(key);
+                continue;
+            }
+            self.mirror.synced.insert(key, outcome.hash);
+            // The tab that saved read its base before the write; its clones may not have
+            let base = tabs.iter().find_map(|tab| tab.history.base_for_clone());
+            for i in &outcome.saved {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entities[*i]) {
+                    mark_saved(tab, base.clone());
+                }
+            }
+            for i in outcome.mirrored.iter().chain(&outcome.saved) {
+                if !changed.contains(&entities[*i]) {
+                    changed.push(entities[*i]);
+                }
+            }
+        }
+        Task::batch(
+            changed
+                .into_iter()
+                .map(|entity| self.update(AppMessage::TabChanged(entity))),
+        )
+    }
+}

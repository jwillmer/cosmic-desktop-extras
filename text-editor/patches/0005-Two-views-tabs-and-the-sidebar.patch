index 0000000..7822540
--- /dev/null
+++ b/src/sidebar.rs
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The sidebar (the project file tree) can be made wider or narrower by dragging its right edge,
+//! like the divider between two views. A resize pointer shows over a strip at the edge.
+//!
+//! Until it is dragged the sidebar keeps the upstream width: as wide as its items, at most 280
+//! px. A dragged width stays between [`MIN_WIDTH`] and half the window and is kept in the
+//! session. A condensed window (the sidebar over the whole window) has no strip.
+
+use cosmic::{
+    app::Task,
+    iced::{Subscription, event, mouse, window},
+};
+
+use crate::{App, Message as AppMessage};
+
+/// The narrowest the sidebar gets when dragged, in pixels.
+pub const MIN_WIDTH: f32 = 160.0;
+/// The widest a saved width is taken as, before the window's half applies.
+const MAX_SAVED_WIDTH: f32 = 8192.0;
+/// The strip at the sidebar's right edge to grab it by, in pixels.
+pub const HANDLE_WIDTH: u16 = 8;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Message {
+    /// The strip was pressed.
+    Press,
+    /// While dragging: the pointer is at this x in the window.
+    Drag(f32),
+    /// The mouse button was let go, or the pointer left the window.
+    Release,
+    /// A window opened or was resized to this width.
+    WindowWidth(window::Id, f32),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::Sidebar(message)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Sidebar {
+    /// The dragged width; `None` keeps the upstream width.
+    pub width: Option<f32>,
+    pub dragging: bool,
+    /// The main window's width; 0 until known.
+    window_width: f32,
+}
+
+impl Sidebar {
+    /// The width to draw the sidebar with; `None` for the upstream width.
+    pub fn shown_width(&self) -> Option<f32> {
+        self.width.map(|width| clamp_width(width, self.window_width))
+    }
+}
+
+/// `width` kept between [`MIN_WIDTH`] and half of `window_width` (when known). A window too
+/// narrow for that gets [`MIN_WIDTH`].
+pub fn clamp_width(width: f32, window_width: f32) -> f32 {
+    let max = if window_width.is_finite() && window_width > 0.0 {
+        window_width / 2.0
+    } else {
+        MAX_SAVED_WIDTH
+    };
+    if !width.is_finite() {
+        return MIN_WIDTH;
+    }
+    width.clamp(MIN_WIDTH, max.max(MIN_WIDTH))
+}
+
+/// The sidebar width for the pointer at `x` in the window: the sidebar starts `left` pixels
+/// from the window's edge and the pointer stays in the middle of the strip.
+pub fn drag_width(x: f32, left: f32) -> f32 {
+    x - left + f32::from(HANDLE_WIDTH) / 2.0
+}
+
+/// A width read from the session; `None` when it is not a usable number.
+pub fn restored_width(saved: Option<f32>) -> Option<f32> {
+    saved
+        .filter(|width| width.is_finite() && *width > 0.0)
+        .map(|width| width.clamp(MIN_WIDTH, MAX_SAVED_WIDTH))
+}
+
+impl App {
+    pub fn update_sidebar(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Press => self.sidebar.dragging = true,
+            Message::Drag(x) => {
+                if self.sidebar.dragging {
+                    // libcosmic puts the sidebar this far from the window's left edge
+                    let left = self.core.window.border_padding.unwrap_or(
+                        if self.core.window.is_maximized { 8 } else { 7 },
+                    );
+                    self.sidebar.width = Some(clamp_width(
+                        drag_width(x, f32::from(left)),
+                        self.sidebar.window_width,
+                    ));
+                }
+            }
+            Message::Release => self.sidebar.dragging = false,
+            Message::WindowWidth(id, width) => {
+                if self.core.main_window_is(id) {
+                    self.sidebar.window_width = width;
+                }
+            }
+        }
+        Task::none()
+    }
+
+    /// The main window's width, for the limit of half of it, and while dragging: the pointer,
+    /// and the button let go anywhere in the window or the pointer leaving it to end the drag.
+    pub fn sidebar_subscription(&self) -> Subscription<AppMessage> {
+        let window_width = event::listen_with(|event, _status, id| match event {
+            event::Event::Window(
+                window::Event::Opened { size, .. } | window::Event::Resized(size),
+            ) => Some(Message::WindowWidth(id, size.width).into()),
+            _ => None,
+        });
+        if !self.sidebar.dragging {
+            return window_width;
+        }
+        let drag = event::listen_with(|event, _status, _window| match event {
+            event::Event::Mouse(mouse::Event::CursorMoved { position }) => {
+                Some(Message::Drag(position.x).into())
+            }
+            event::Event::Mouse(
+                mouse::Event::ButtonReleased(mouse::Button::Left) | mouse::Event::CursorLeft,
+            ) => Some(Message::Release.into()),
+            _ => None,
+        });
+        Subscription::batch([window_width, drag])
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn width_stays_between_minimum_and_half_the_window() {
+        assert_eq!(clamp_width(300.0, 1200.0), 300.0);
+        assert_eq!(clamp_width(90.0, 1200.0), MIN_WIDTH);
+        assert_eq!(clamp_width(900.0, 1200.0), 600.0);
+        // A window too narrow for the minimum on half of it
+        assert_eq!(clamp_width(250.0, 280.0), MIN_WIDTH);
+        // Window width not known yet: only the minimum and the saved limit
+        assert_eq!(clamp_width(700.0, 0.0), 700.0);
+        assert_eq!(clamp_width(20_000.0, 0.0), MAX_SAVED_WIDTH);
+        assert_eq!(clamp_width(f32::NAN, 1200.0), MIN_WIDTH);
+        assert_eq!(clamp_width(300.0, f32::INFINITY), 300.0);
+    }
+
+    #[test]
+    fn pointer_stays_in_the_middle_of_the_strip() {
+        assert_eq!(drag_width(250.0, 7.0), 247.0);
+    }
+
+    #[test]
+    fn shown_width_follows_the_window() {
+        let mut sidebar = Sidebar::default();
+        assert_eq!(sidebar.shown_width(), None);
+        sidebar.width = Some(500.0);
+        assert_eq!(sidebar.shown_width(), Some(500.0));
+        // A smaller window narrows it without losing the dragged width
+        sidebar.window_width = 800.0;
+        assert_eq!(sidebar.shown_width(), Some(400.0));
+        assert_eq!(sidebar.width, Some(500.0));
+    }
+
+    #[test]
+    fn saved_width_is_checked() {
+        assert_eq!(restored_width(None), None);
+        assert_eq!(restored_width(Some(320.5)), Some(320.5));
+        assert_eq!(restored_width(Some(40.0)), Some(MIN_WIDTH));
+        assert_eq!(restored_width(Some(1e9)), Some(MAX_SAVED_WIDTH));
+        assert_eq!(restored_width(Some(f32::NAN)), None);
+        assert_eq!(restored_width(Some(-5.0)), None);
+        assert_eq!(restored_width(Some(0.0)), None);
+    }
+}
diff --git a/src/tab_view.rs b/src/tab_view.rs
new file mode 100644
index 0000000..f26cabb
--- /dev/null
+++ b/src/tab_view.rs
@@ -0,0 +1,415 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! What a tab shows: the tab bar of every tab or of one view, and a tab's bars, editor or diff.
+
+use cosmic::{
+    Application, Element, cosmic_theme,
+    font::Font,
+    iced::{self, Alignment, Length, mouse},
+    style, theme,
+    widget::{self, button, segmented_button, segmented_button::Entity},
+};
+use cosmic_text::{Edit, Selection};
+
+use crate::{
+    App, Message, close_tabs, compare, fl, icon_cache_get, markdown, menu, menu_ext, slash_menu,
+    tab::{EditorTab, Tab},
+    views,
+};
+
+// Through the crate root's imports, which nothing else there uses now
+use crate::{Background, Color, GitDiffLine, ViMode, text_box};
+
+impl App {
+    /// The tab bar and the active tab, or the two views side by side when split.
+    pub(crate) fn tab_views(&self) -> Element<'_, Message> {
+        let Some(split) = &self.split else {
+            return widget::column::with_capacity(2)
+                .push(self.tab_bar(&self.tab_model, None))
+                .push(self.tab_content(self.tab_model.active(), None))
+                .into();
+        };
+        let pane = |side: views::Side| -> Element<'_, Message> {
+            // An accent line above the tab bar marks the active view
+            let active = split.active == side;
+            let marker = widget::container(widget::Space::new().width(Length::Fill).height(2))
+                .class(theme::Container::custom(move |theme| {
+                    widget::container::Style {
+                        background: active
+                            .then(|| Color::from(theme.cosmic().accent_color()).into()),
+                        ..Default::default()
+                    }
+                }));
+            let mut pane = widget::column::with_capacity(3)
+                .push(marker)
+                .push(self.tab_bar(split.model(side), Some(side)));
+            if let Some(tab_id) = split.shown(side) {
+                pane = pane.push(self.tab_content(tab_id, Some(side)));
+            }
+            // A tab dragged over the view a drop moves it to: an accent outline
+            let target = split.drop_highlight() == Some(side);
+            let pane = widget::container(pane).class(theme::Container::custom(move |theme| {
+                widget::container::Style {
+                    border: iced::Border {
+                        color: Color::from(theme.cosmic().accent_color()),
+                        width: if target { 2.0 } else { 0.0 },
+                        radius: 4.0.into(),
+                    },
+                    ..Default::default()
+                }
+            }));
+            // The whole view takes a tab dragged from the other one
+            let pane =
+                widget::dnd_destination::dnd_destination_for_data::<views::TabDrag, Message>(
+                    pane,
+                    move |_, _| views::Message::ViewDrop(side).into(),
+                )
+                .drag_id(views::drop_id(side))
+                .on_enter(move |_, _, _| views::Message::DragOver(side, true).into())
+                .on_leave(move || views::Message::DragOver(side, false).into());
+            if split.active == side {
+                pane.into()
+            } else {
+                widget::mouse_area(pane)
+                    .on_press(views::Message::Focus(side).into())
+                    .into()
+            }
+        };
+        let (ratio, dragging) = (split.ratio, split.dragging);
+        widget::responsive(move |size| {
+            let left = views::divider_ratio(ratio, size.width);
+            let portion = |share: f32| Length::FillPortion((share * 1000.0).round() as u16);
+            // A strip wider than the line to grab it by
+            let divider = widget::mouse_area(
+                widget::container(widget::divider::vertical::default())
+                    .padding([0, 4])
+                    .height(Length::Fill),
+            )
+            .interaction(mouse::Interaction::ResizingHorizontally)
+            .on_press(views::Message::DividerPress.into());
+            let row = widget::row::with_capacity(3)
+                .push(widget::container(pane(views::Side::Left)).width(portion(left)))
+                .push(divider)
+                .push(widget::container(pane(views::Side::Right)).width(portion(1.0 - left)))
+                // Room on both sides of the divider, so the right view's line numbers
+                // never sit under the left view's edge
+                .spacing(4)
+                .height(Length::Fill);
+            // Always wrapped, so the editors keep their widget state when a drag starts
+            let area = widget::mouse_area(row);
+            if dragging {
+                area.interaction(mouse::Interaction::ResizingHorizontally)
+                    .on_move(move |point| views::Message::DividerDrag(point.x, size.width).into())
+                    .into()
+            } else {
+                area.into()
+            }
+        })
+        .into()
+    }
+
+    /// The notice that a large file opened without syntax colours; a Markdown file that
+    /// opened in Source instead of the preview has its own notice, which says so too.
+    pub(crate) fn plain_bar(
+        &self,
+        entity: Entity,
+        tab: &EditorTab,
+    ) -> Option<Element<'_, Message>> {
+        let len = tab.plain_notice?;
+        if tab
+            .markdown
+            .as_ref()
+            .is_some_and(|preview| preview.held_notice())
+        {
+            return None;
+        }
+        Some(markdown::large_file_bar(
+            fl!("large-file-plain", megabytes = markdown::megabytes(len)),
+            None,
+            Message::DismissPlain(entity),
+        ))
+    }
+
+    /// A tab bar: the one of every tab, or of one view (`side`) whose items point at tabs.
+    pub(crate) fn tab_bar<'a>(
+        &'a self,
+        model: &'a segmented_button::SingleSelectModel,
+        side: Option<views::Side>,
+    ) -> Element<'a, Message> {
+        let cosmic_theme::Spacing { space_xxs, .. } = self.core().system_theme().cosmic().spacing;
+        let mut tab_bar = widget::tab_bar::horizontal(model)
+            .button_height(32)
+            .button_spacing(space_xxs)
+            .close_icon(icon_cache_get("window-close-symbolic", 16))
+            //TODO: this causes issues with small window sizes .minimum_button_width(240)
+            .context_menu(Some(menu_ext::tab_bar_context_menu(
+                &self.key_binds,
+                model.iter().map(|item| {
+                    let tab = match (side, &self.split) {
+                        (Some(side), Some(split)) => split.tab(side, item).unwrap_or(item),
+                        _ => item,
+                    };
+                    self.views_menu_state(tab)
+                }),
+            )))
+            .width(Length::Shrink);
+        let new_file = match side {
+            None => {
+                tab_bar = tab_bar
+                    .enable_tab_drag(String::from("x-cosmic-edit/tab"))
+                    .on_reorder(Message::ReorderTab)
+                    .tab_drag_threshold(25.)
+                    .on_activate(Message::TabActivate)
+                    .on_close(Message::TabClose)
+                    .on_context(|entity| close_tabs::Message::TabBarContext(entity).into());
+                Message::NewFile
+            }
+            // Items of a view are its own entities; a tab dragged onto the other view's bar moves
+            // there, see `views::Split::drag_source`
+            Some(side) => {
+                tab_bar = tab_bar
+                    .enable_tab_drag(String::from(views::TAB_MIME))
+                    .on_reorder(move |event| views::Message::Reorder(side, event).into())
+                    .on_drop_hint(move |hint| {
+                        views::Message::DropHint(side, hint.map(|(display, _)| display)).into()
+                    })
+                    .on_dnd_drop::<views::TabDrag>(move |display, _, _| {
+                        views::Message::TabDrop(side, display).into()
+                    })
+                    .on_activate(move |entity| views::Message::Activate(side, entity).into())
+                    .on_close(move |entity| views::Message::Close(side, entity).into())
+                    .on_context(move |entity| views::Message::Context(side, entity).into());
+                views::Message::NewFile(side).into()
+            }
+        };
+        // Where a tab dragged from the other view lands: after the last tab
+        let drop_marker = side
+            .filter(|side| self.split.as_ref().and_then(|s| s.drop_highlight()) == Some(*side))
+            .map(|_| {
+                widget::container(widget::Space::new().width(3).height(24)).class(
+                    theme::Container::custom(|theme| widget::container::Style {
+                        background: Some(Color::from(theme.cosmic().accent_color()).into()),
+                        ..Default::default()
+                    }),
+                )
+            });
+        widget::row::with_capacity(3)
+            .align_y(Alignment::Center)
+            .push(tab_bar)
+            .push_maybe(drop_marker)
+            .push(
+                button::custom(icon_cache_get("list-add-symbolic", 16))
+                    .on_press(new_file)
+                    .padding(space_xxs)
+                    .class(style::Button::Icon),
+            )
+            .into()
+    }
+
+    /// The content of a tab: its bars and editor, or a diff. `side` is its view when split.
+    pub(crate) fn tab_content(
+        &self,
+        tab_id: segmented_button::Entity,
+        side: Option<views::Side>,
+    ) -> Element<'_, Message> {
+        let active = side.is_none_or(|side| self.split.as_ref().is_some_and(|s| s.active == side));
+        let focus = match side {
+            Some(side) if !active => views::Message::Focus(side).into(),
+            _ => Message::FindFocused(false),
+        };
+        let mut column = widget::column::with_capacity(4).height(Length::Fill);
+        match self.tab_model.data::<Tab>(tab_id) {
+            Some(Tab::Editor(tab)) => {
+                let mut text_box = text_box(&tab.editor, self.config.metrics(tab.zoom_adj()))
+                    .id(if active {
+                        self.text_box_id.clone()
+                    } else {
+                        self.other_text_box_id.clone()
+                    })
+                    .on_focus(focus)
+                    .on_auto_scroll(Message::AutoScroll)
+                    .on_changed(Message::TabChanged(tab_id))
+                    // The status bar shows the mode; the text, its counts and the find
+                    // bar's "In selection" range stay as they are
+                    .on_mode_changed(Message::StatusBarRefresh)
+                    .on_edit(Message::TabEdited(tab_id))
+                    .tab(tab_id)
+                    .folding(tab.fold_kind())
+                    .has_context_menu(tab.context_menu_open)
+                    .on_context_menu(move |open| Message::TabContextMenu(tab_id, open));
+                if self.config.highlight_current_line {
+                    text_box = text_box.highlight_current_line();
+                }
+                if let Some(side) = side
+                    && self.config.sync_scroll_views
+                {
+                    text_box = text_box.on_scroll(views::Message::Scrolled(side).into());
+                }
+                if self.config.line_numbers {
+                    text_box = text_box.line_numbers();
+                }
+                text_box = text_box
+                    .on_link(|url| markdown::Message::LinkClicked(url).into())
+                    .show_whitespace(self.config.show_whitespace)
+                    .show_line_endings(self.config.show_line_endings);
+                if !self.config.vim_bindings {
+                    text_box = text_box
+                        .new_line_ending(tab.new_line_ending())
+                        .column_block(&tab.column)
+                        .escape_to_app(true)
+                        .bar_open(self.goto_line_opt.is_some());
+                }
+                text_box = text_box.slash_menu(slash_menu::enabled(
+                    self.config.markdown_slash_menu,
+                    tab.is_markdown_language(),
+                    self.config.vim_bindings,
+                ));
+                if tab.is_markdown_language() {
+                    text_box = text_box.markdown_lists(!self.config.vim_bindings);
+                }
+                if let Some(marks) = tab.change_marks(self.config.change_history) {
+                    text_box = text_box
+                        .change_marks(marks)
+                        .on_change_mark(Message::CompareWithSaved(Some(tab_id)));
+                }
+                if let Some(tints) = tab.change_tints(&self.config) {
+                    text_box = text_box.change_tints(tints);
+                }
+                if self.find_opt.is_some()
+                    && let Some(Ok(regex)) = &self.find_regex
+                {
+                    text_box = text_box.find_matches(regex, self.find_joined());
+                }
+                // The same range as the count and Replace all; only the active tab has one
+                if self.find_opt.is_some()
+                    && tab_id == self.tab_model.active()
+                    && let Some(range) = self.find_range()
+                {
+                    text_box = text_box.find_range(range);
+                }
+                let has_selection = tab.editor.lock().unwrap().selection() != Selection::None
+                    || tab
+                        .column
+                        .lock()
+                        .unwrap()
+                        .is_some_and(|block| !block.is_empty());
+                let mut context_menu = widget::context_menu(
+                    text_box,
+                    Some(menu::context_menu(
+                        &self.key_binds,
+                        tab_id,
+                        has_selection,
+                        tab.changed(),
+                    )),
+                )
+                .on_close(Message::TabContextMenu(tab_id, false))
+                .on_surface_action(Message::Surface);
+                if let Some(window_id) = self.core().main_window_id() {
+                    context_menu = context_menu.window_id(window_id);
+                }
+                if let Some(bar) = self.disk_bar(tab_id, tab) {
+                    column = column.push(bar);
+                }
+                if let Some(bar) = self.json_bar(tab_id) {
+                    column = column.push(bar);
+                }
+                if let Some(bar) = self.plain_bar(tab_id, tab) {
+                    column = column.push(bar);
+                }
+                column = column.push(self.markdown_layout(tab_id, tab, context_menu.into()));
+                if self.config.vim_bindings {
+                    let status = {
+                        let editor = tab.editor.lock().unwrap();
+                        let parser = editor.parser();
+                        match &parser.mode {
+                            ViMode::Normal => {
+                                format!("{}", parser.cmd)
+                            }
+                            ViMode::Insert => "-- INSERT --".to_string(),
+                            ViMode::Extra(extra) => {
+                                format!("{}{}", parser.cmd, extra)
+                            }
+                            ViMode::Replace => "-- REPLACE --".to_string(),
+                            ViMode::Visual => {
+                                format!("-- VISUAL -- {}", parser.cmd)
+                            }
+                            ViMode::VisualLine => {
+                                format!("-- VISUAL LINE -- {}", parser.cmd)
+                            }
+                            ViMode::Command { value } => {
+                                format!(":{value}|")
+                            }
+                            ViMode::Search { value, forwards } => {
+                                if *forwards {
+                                    format!("/{value}|")
+                                } else {
+                                    format!("?{value}|")
+                                }
+                            }
+                        }
+                    };
+                    column = column.push(widget::text(status).font(Font::MONOSPACE));
+                }
+            }
+            Some(Tab::GitDiff(tab)) => {
+                let mut diff_widget = widget::column::with_capacity(tab.diff.hunks.len());
+                for hunk in tab.diff.hunks.iter() {
+                    let mut hunk_widget = widget::column::with_capacity(hunk.lines.len() + 1);
+                    hunk_widget = hunk_widget.push(
+                        widget::text::monotext(compare::hunk_header(hunk))
+                            .class(cosmic::style::Text::Accent),
+                    );
+                    for line in hunk.lines.iter() {
+                        let line_widget = match line {
+                            GitDiffLine::Context {
+                                old_line,
+                                new_line,
+                                text,
+                            } => widget::container(widget::text::monotext(format!(
+                                "{:4} {:4}   {}",
+                                old_line, new_line, text
+                            ))),
+                            GitDiffLine::Added { new_line, text } => {
+                                widget::container(widget::text::monotext(format!(
+                                    "{:4} {:4} + {}",
+                                    "", new_line, text
+                                )))
+                                .style(|_theme| {
+                                    //TODO: theme this color
+                                    widget::container::Style {
+                                        background: Some(Background::Color(Color::from_rgb8(
+                                            0x00, 0x40, 0x00,
+                                        ))),
+                                        ..Default::default()
+                                    }
+                                })
+                            }
+                            GitDiffLine::Deleted { old_line, text } => {
+                                widget::container(widget::text::monotext(format!(
+                                    "{:4} {:4} - {}",
+                                    old_line, "", text
+                                )))
+                                .style(|_theme| {
+                                    //TODO: theme this color
+                                    widget::container::Style {
+                                        background: Some(Background::Color(Color::from_rgb8(
+                                            0x40, 0x00, 0x00,
+                                        ))),
+                                        ..Default::default()
+                                    }
+                                })
+                            }
+                        };
+                        hunk_widget = hunk_widget.push(line_widget.width(Length::Fill));
+                    }
+                    diff_widget = diff_widget.push(hunk_widget);
+                }
+                column = column.push(widget::scrollable(
+                    widget::layer_container(diff_widget).layer(cosmic_theme::Layer::Primary),
+                ));
+            }
+            None => {}
+        }
+        column.into()
+    }
+}

+    fn tab_dragged_to_other_view_is_the_one_under_the_pointer() {
+        let (_, t) = tabs(4);
+        let mut split = Split::new(&t, t[3], Some(t[1]));
+        split.move_tab(t[2]);
+        let display = |split: &Split, side, tab| split.display(side, tab).unwrap();
+        // The source bar reports the dragged tab first, then whatever it passes over
+        split.drag_hint(Side::Left, Some(display(&split, Side::Left, t[0])));
+        split.drag_hint(Side::Left, Some(display(&split, Side::Left, t[1])));
+        // Anywhere in the other view: it goes after that view's last tab
+        assert_eq!(split.drop_into(Side::Right), Some((t[0], Some(t[2]))));
+        // A drop is used once
+        assert_eq!(split.drop_into(Side::Right), None);
+        // A drop in the view it came from is a reorder (its own bar) or nothing, not a move
+        split.drag_hint(Side::Left, Some(display(&split, Side::Left, t[0])));
+        assert_eq!(split.drop_into(Side::Left), None);
+    }

+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Two views side by side, like Notepad++: View, "Move to other view" and "Clone to other view"
+//! (also in the tab's right-click menu) split the window into a left and a right view, each with
+//! its own tab bar and shown tab.
+//!
+//! Every tab stays in `App::tab_model`, so everything keyed by its entity (drafts, diffs, disk
+//! checks) works unchanged. A [`Split`] adds one display model per view whose items point at
+//! those tabs. The active tab of `tab_model` is the shown tab of the active view, so menus and
+//! shortcuts act on it; `App::views_after_update` keeps the display models in step after every
+//! message. A view left without tabs closes the split.
+//!
+//! Clone opens the document a second time, unsaved edits included, for a file or an untitled
+//! tab: the two tabs have separate buffers whose edits mirror each other (see `mirror`), and
+//! both follow changes on disk.
+
+use cosmic::{
+    app::Task,
+    iced::{Subscription, clipboard::mime::AllowedMimeTypes, event, keyboard, mouse},
+    widget::segmented_button::{Entity, InsertPosition, ReorderEvent, SingleSelectModel},
+};
+use cosmic_text::Edit;
+use std::borrow::Cow;
+use std::collections::HashSet;
+
+use crate::{App, Message as AppMessage, tab::Tab};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Side {
+    Left,
+    Right,
+}
+
+impl Side {
+    pub fn other(self) -> Self {
+        match self {
+            Self::Left => Self::Right,
+            Self::Right => Self::Left,
+        }
+    }
+
+    fn index(self) -> usize {
+        match self {
+            Self::Left => 0,
+            Self::Right => 1,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    /// Move the tab, or the active tab, to the other view.
+    Move(Option<Entity>),
+    /// Open the tab's file, or the active tab's, again in the other view.
+    Clone(Option<Entity>),
+    /// The tab bar's right-click menu entries; they act on `App::tab_bar_context`.
+    TabBarMove,
+    TabBarClone,
+    /// Compare with the tab at this position, or the two views with `None`.
+    TabBarCompare(Option<usize>),
+    /// A view's tab bar, with its display entity.
+    Activate(Side, Entity),
+    Close(Side, Entity),
+    Context(Side, Entity),
+    /// The "+" button of a view's tab bar.
+    NewFile(Side),
+    /// A click into a view.
+    Focus(Side),
+    /// The editor shown in a view scrolled.
+    Scrolled(Side),
+    /// The divider between the views was pressed, dragged to x in a row this wide, or let go.
+    DividerPress,
+    DividerDrag(f32, f32),
+    DividerRelease,
+    /// A tab of a view's tab bar is dragged over this tab (display entity) of the same bar.
+    DropHint(Side, Option<Entity>),
+    /// A tab drag was dropped on this tab (display entity) of a view's tab bar.
+    TabDrop(Side, Entity),
+    /// A drag entered (true) or left (false) a view.
+    DragOver(Side, bool),
+    /// A drag was dropped anywhere in a view.
+    ViewDrop(Side),
+    /// A tab was dragged to another place in the same view's tab bar.
+    Reorder(Side, ReorderEvent),
+    /// A press anywhere or Esc: a tab drag that ended outside the views is over.
+    ForgetTabDrag,
+}
+
+/// The drag-and-drop type of a view's tab. Its data says nothing: the dragged tab is the one
+/// under the pointer when the drag started, see `Split::drag_source`.
+pub const TAB_MIME: &str = "x-cosmic-edit/view-tab";
+
+#[derive(Clone, Debug)]
+pub struct TabDrag;
+
+impl AllowedMimeTypes for TabDrag {
+    fn allowed() -> Cow<'static, [String]> {
+        Cow::Owned(vec![TAB_MIME.to_string()])
+    }
+}
+
+impl TryFrom<(Vec<u8>, String)> for TabDrag {
+    type Error = ();
+    fn try_from((_, mime): (Vec<u8>, String)) -> Result<Self, ()> {
+        (mime == TAB_MIME).then_some(TabDrag).ok_or(())
+    }
+}
+
+/// The narrowest a view gets when the divider is dragged, in pixels.
+pub const MIN_VIEW_WIDTH: f32 = 240.0;
+
+/// The left view's share of `width` when the divider is at `ratio`, so that both views keep
+/// [`MIN_VIEW_WIDTH`]; an even split when the width cannot hold two such views.
+pub fn divider_ratio(ratio: f32, width: f32) -> f32 {
+    if !ratio.is_finite() || width < 2.0 * MIN_VIEW_WIDTH {
+        return 0.5;
+    }
+    let min = MIN_VIEW_WIDTH / width;
+    ratio.clamp(min, 1.0 - min)
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::Views(message)
+    }
+}
+
+/// The drag-and-drop id of a whole view: the same in every frame, so the offer of a drag that
+/// entered in one frame reaches it in the next. Far above libcosmic's counted widget ids.
+pub fn drop_id(side: Side) -> u64 {
+    u64::MAX - 0xED17 - side.index() as u64
+}
+
+/// The two views. Items of `left` and `right` carry the [`Entity`] of their tab in
+/// `App::tab_model`.
+pub struct Split {
+    pub left: SingleSelectModel,
+    pub right: SingleSelectModel,
+    pub active: Side,
+    /// The left view's share of the width, 0 to 1; see [`divider_ratio`].
+    pub ratio: f32,
+    /// The divider is being dragged.
+    pub dragging: bool,
+    /// The view and tab a tab drag started from. libcosmic's tab bar does not say which tab it
+    /// drags, but only the bar it started in reports drop hints, and the first one is the tab
+    /// under the pointer as the drag starts. Cleared by a drop, Esc or the next press.
+    drag_source: Option<(Side, Entity)>,
+    /// The view a drag is over, and the first one it was over: the view it started in, whose
+    /// shown tab it drags when its bar reported no hint (the pointer left the bar too fast).
+    drag_over: Option<Side>,
+    drag_from: Option<Side>,
+    /// The shown tabs and their scroll positions when the last scroll was followed.
+    scroll_base: Option<([Option<Entity>; 2], [ScrollPosition; 2])>,
+}
+
+/// A view's top line and horizontal scroll in pixels.
+type ScrollPosition = (usize, f32);
+
+impl Split {
+    /// Split `tabs` (in tab bar order): `moving` goes to the right view and is active there, the
+    /// rest stays left with `left_shown` shown.
+    pub fn new(tabs: &[Entity], moving: Entity, left_shown: Option<Entity>) -> Self {
+        let mut split = Self {
+            left: SingleSelectModel::default(),
+            right: SingleSelectModel::default(),
+            active: Side::Right,
+            ratio: 0.5,
+            dragging: false,
+            drag_source: None,
+            drag_over: None,
+            drag_from: None,
+            scroll_base: None,
+        };
+        for tab in tabs.iter().copied().filter(|tab| *tab != moving) {
+            split.insert(Side::Left, tab);
+        }
+        if let Some(shown) = left_shown.and_then(|tab| split.display(Side::Left, tab)) {
+            split.left.activate(shown);
+        }
+        split.insert(Side::Right, moving);
+        split
+    }
+
+    pub fn model(&self, side: Side) -> &SingleSelectModel {
+        match side {
+            Side::Left => &self.left,
+            Side::Right => &self.right,
+        }
+    }
+
+    fn model_mut(&mut self, side: Side) -> &mut SingleSelectModel {
+        match side {
+            Side::Left => &mut self.left,
+            Side::Right => &mut self.right,
+        }
+    }
+
+    /// Add a tab at the end of a view and show it there.
+    pub fn insert(&mut self, side: Side, tab: Entity) {
+        self.model_mut(side)
+            .insert()
+            .data::<Entity>(tab)
+            .closable()
+            .activate();
+    }
+
+    /// The tab a display item of a view points at.
+    pub fn tab(&self, side: Side, display: Entity) -> Option<Entity> {
+        self.model(side).data::<Entity>(display).copied()
+    }
+
+    /// The display item of a tab in a view.
+    fn display(&self, side: Side, tab: Entity) -> Option<Entity> {
+        let model = self.model(side);
+        model
+            .iter()
+            .find(|display| model.data::<Entity>(*display) == Some(&tab))
+    }
+
+    pub fn side_of(&self, tab: Entity) -> Option<Side> {
+        [Side::Left, Side::Right]
+            .into_iter()
+            .find(|side| self.display(*side, tab).is_some())
+    }
+
+    /// The tab shown in a view.
+    pub fn shown(&self, side: Side) -> Option<Entity> {
+        let model = self.model(side);
+        self.tab(side, model.active())
+    }
+
+    /// The tabs of a view, in tab bar order.
+    pub fn tabs(&self, side: Side) -> Vec<Entity> {
+        let model = self.model(side);
+        model
+            .iter()
+            .filter_map(|display| model.data::<Entity>(display).copied())
+            .collect()
+    }
+
+    /// A tab drag reported a drop hint over `display` in `side`: the first one names the tab
+    /// being dragged.
+    pub fn drag_hint(&mut self, side: Side, display: Option<Entity>) {
+        if self.drag_source.is_none()
+            && let Some(tab) = display.and_then(|display| self.tab(side, display))
+        {
+            self.drag_source = Some((side, tab));
+        }
+    }
+
+    /// The tab a drop in `side` moves there: one dragged from the other view.
+    fn moves_to(&self, side: Side) -> Option<Entity> {
+        let (from, tab) = self.drag_source.or_else(|| {
+            let from = self.drag_from?;
+            Some((from, self.shown(from)?))
+        })?;
+        (from != side && self.side_of(tab) == Some(from)).then_some(tab)
+    }
+
+    /// A drag entered or left a view.
+    pub fn drag_over(&mut self, side: Side, inside: bool) {
+        if inside {
+            self.drag_over = Some(side);
+            self.drag_from.get_or_insert(side);
+        } else if self.drag_over == Some(side) {
+            self.drag_over = None;
+        }
+    }
+
+    /// The view to highlight while a tab is dragged: the one a drop moves it to.
+    pub fn drop_highlight(&self) -> Option<Side> {
+        self.drag_over.filter(|side| self.moves_to(*side).is_some())
+    }
+
+    /// The drag is over (a drop, Esc, a drop outside the views).
+    pub fn forget_drag(&mut self) {
+        self.drag_source = None;
+        self.drag_over = None;
+        self.drag_from = None;
+    }
+
+    /// A tab drag ended anywhere in `side`: the dragged tab, when it came from the other view,
+    /// and the last tab of `side`, which it goes after.
+    pub fn drop_into(&mut self, side: Side) -> Option<(Entity, Option<Entity>)> {
+        let tab = self.moves_to(side);
+        self.forget_drag();
+        Some((tab?, self.tabs(side).last().copied()))
+    }
+
+    /// The tab to show when closing `close` empties the view of `active`: the one the other
+    /// view shows, so it stays in front when the split closes.
+    pub fn shown_after_closing(&self, active: Entity, close: &[Entity]) -> Option<Entity> {
+        let side = self.side_of(active)?;
+        if !self.tabs(side).iter().all(|tab| close.contains(tab)) {
+            return None;
+        }
+        self.shown(side.other()).filter(|tab| !close.contains(tab))
+    }
+
+    /// The first of `clones` (other than `tab`) that sits in `side`.
+    pub fn twin_in(&self, side: Side, tab: Entity, clones: &[Entity]) -> Option<Entity> {
+        clones
+            .iter()
+            .copied()
+            .find(|clone| *clone != tab && self.side_of(*clone) == Some(side))
+    }
+
+    /// Move a tab to the other view, show it there and make that view active.
+    pub fn move_tab(&mut self, tab: Entity) {
+        let Some(from) = self.side_of(tab) else {
+            return;
+        };
+        self.remove(from, tab);
+        self.insert(from.other(), tab);
+        self.active = from.other();
+    }
+
+    /// Remove a tab from a view; the tab next to it is shown if it was.
+    fn remove(&mut self, side: Side, tab: Entity) {
+        let Some(display) = self.display(side, tab) else {
+            return;
+        };
+        let model = self.model_mut(side);
+        let shown = model.is_active(display);
+        let pos = model.position(display).unwrap_or(0);
+        model.remove(display);
+        if shown {
+            let len = model.len() as u16;
+            if len > 0 {
+                model.activate_position(pos.min(len - 1));
+            }
+        }
+    }
+
+    /// Both views have tabs; otherwise the split closes.
+    pub fn is_complete(&self) -> bool {
+        self.left.len() > 0 && self.right.len() > 0
+    }
+
+    /// Follow `tabs` (the app's tab model): drop closed tabs, add new ones to the active view,
+    /// keep tab bar order, titles and icons, and make the view of its active tab active. Returns
+    /// a tab to activate when closing the shown tab of the active view moved `tabs` to the other
+    /// view while this one still has tabs.
+    pub fn sync(&mut self, tabs: &SingleSelectModel) -> Option<Entity> {
+        let open: HashSet<Entity> = tabs.iter().collect();
+        let mut lost_shown = [false; 2];
+        for side in [Side::Left, Side::Right] {
+            let gone: Vec<Entity> = self
+                .tabs(side)
+                .into_iter()
+                .filter(|tab| !open.contains(tab))
+                .collect();
+            for tab in gone {
+                if self.shown(side) == Some(tab) {
+                    lost_shown[side.index()] = true;
+                }
+                self.remove(side, tab);
+            }
+        }
+        for tab in tabs.iter() {
+            if self.side_of(tab).is_none() {
+                self.insert(self.active, tab);
+            }
+        }
+        for side in [Side::Left, Side::Right] {
+            let mut pos = 0;
+            for tab in tabs.iter() {
+                if let Some(display) = self.display(side, tab) {
+                    let model = self.model_mut(side);
+                    model.position_set(display, pos);
+                    model.text_set(display, tabs.text(tab).unwrap_or_default().to_string());
+                    if let Some(icon) = tabs.icon(tab) {
+                        model.icon_set(display, icon.clone());
+                    }
+                    pos += 1;
+                }
+            }
+        }
+        let active = tabs.active();
+        let side = self.side_of(active)?;
+        if side != self.active
+            && lost_shown[self.active.index()]
+            && self.model(self.active).len() > 0
+        {
+            return self.shown(self.active);
+        }
+        self.active = side;
+        if let Some(display) = self.display(side, active) {
+            self.model_mut(side).activate(display);
+        }
+        None
+    }
+}
+
+/// The other view's new top line when one view's top line went from `from` to `to`: moved by
+/// the same number of lines, within `0..lines`.
+pub fn follow_scroll(other_top: usize, from: usize, to: usize, lines: usize) -> usize {
+    let top = if to >= from {
+        other_top.saturating_add(to - from)
+    } else {
+        other_top.saturating_sub(from - to)
+    };
+    top.min(lines.saturating_sub(1))
+}
+
+/// The other view's new horizontal scroll when one view's went from `from` to `to`: moved by
+/// the same distance, within `0..=max`.
+pub fn follow_horizontal(other: f32, from: f32, to: f32, max: f32) -> f32 {
+    (other + to - from).min(max).max(0.0)
+}
+
+/// What the menus need to know about the views, for one tab.
+#[derive(Clone, Debug, Default)]
+pub struct MenuState {
+    /// The tabs it can be compared with: position and title.
+    pub compare: Vec<(usize, String)>,
+    pub split: bool,
+    /// The active tab can move: there is another tab to stay behind.
+    pub can_move: bool,
+    /// The active tab is an editor tab.
+    pub can_clone: bool,
+    /// The tab has a file: Copy file path and Open containing folder.
+    pub has_file: bool,
+    /// The language of an editor tab and whether it was chosen (View > Language).
+    pub language: Option<(String, bool)>,
+}
+
+impl App {
+    /// The view state for the menus of `tab`.
+    pub fn views_menu_state(&self, tab: Entity) -> MenuState {
+        MenuState {
+            compare: crate::compare::compare_targets(&self.tab_model, tab),
+            split: self.split.is_some(),
+            can_move: self.tab_model.len() > 1,
+            can_clone: self.can_clone(tab),
+            has_file: self.tab_file_path(tab).is_some(),
+            language: match self.tab_model.data::<Tab>(tab) {
+                Some(Tab::Editor(tab)) => {
+                    Some((tab.language_name(), tab.language.chosen.is_some()))
+                }
+                _ => None,
+            },
+        }
+    }
+
+    fn can_clone(&self, tab: Entity) -> bool {
+        matches!(self.tab_model.data::<Tab>(tab), Some(Tab::Editor(_)))
+    }
+
+    /// A clone of `tab` in `side` that mirrors it and holds the same text. Like Notepad++, a
+    /// view shows a document once: moving or cloning `tab` there shows this clone instead.
+    /// Clones whose drafts drifted apart are not paired and never count.
+    fn twin_in(&self, side: Side, tab: Entity) -> Option<Entity> {
+        let twin = self
+            .split
+            .as_ref()?
+            .twin_in(side, tab, &self.clone_group(tab))?;
+        self.same_text(tab, twin).then_some(twin)
+    }
+
+    /// Any clone of `tab` that mirrors it and holds the same text: while one is open, closing
+    /// `tab` loses nothing, so it closes without the save prompt, as in Notepad++.
+    pub fn twin(&self, tab: Entity) -> Option<Entity> {
+        self.clone_group(tab)
+            .into_iter()
+            .find(|clone| *clone != tab && self.same_text(tab, *clone))
+    }
+
+    pub fn same_text(&self, a: Entity, b: Entity) -> bool {
+        let text = |entity| match self.tab_model.data::<Tab>(entity) {
+            Some(Tab::Editor(tab)) => Some(crate::tab::editor_text(&tab.editor.lock().unwrap())),
+            _ => None,
+        };
+        matches!((text(a), text(b)), (Some(a), Some(b)) if a == b)
+    }
+
+    /// `tab` would join `twin` in one view: close `tab` (its twin holds the same text) and show
+    /// `twin`.
+    fn merge_into_twin(&mut self, tab: Entity, twin: Entity) -> Task<AppMessage> {
+        Task::batch([
+            self.update(AppMessage::TabCloseForce(tab)),
+            self.update(AppMessage::TabActivate(twin)),
+        ])
+    }
+
+    /// The tabs of the view that holds `tab` (every tab without a split), in tab bar order.
+    pub fn view_tabs_with(&self, tab: Entity) -> Vec<Entity> {
+        match &self.split {
+            Some(split) => match split.side_of(tab) {
+                Some(side) => split.tabs(side),
+                None => self.tab_model.iter().collect(),
+            },
+            None => self.tab_model.iter().collect(),
+        }
+    }
+
+    /// Keep the views in step with the tabs after a message.
+    pub fn views_after_update(&mut self, task: Task<AppMessage>) -> Task<AppMessage> {
+        let task = Task::batch([task, self.mirror_clones()]);
+        let Some(split) = &mut self.split else {
+            return task;
+        };
+        let activate = split.sync(&self.tab_model);
+        if !split.is_complete() {
+            self.split = None;
+            return task;
+        }
+        if !self.config.sync_scroll_views {
+            split.scroll_base = None;
+        } else {
+            let shown = [split.shown(Side::Left), split.shown(Side::Right)];
+            if split.scroll_base.is_none_or(|(base, _)| base != shown) {
+                let tops = shown
+                    .map(|tab| tab.map_or((0, 0.0), |tab| scroll_position(&self.tab_model, tab)));
+                split.scroll_base = Some((shown, tops));
+            }
+        }
+        match activate {
+            Some(tab) => Task::batch([task, self.update(AppMessage::TabActivate(tab))]),
+            None => task,
+        }
+    }
+
+    pub fn update_views(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Move(tab) => {
+                let tab = tab.unwrap_or_else(|| self.tab_model.active());
+                let to = self
+                    .split
+                    .as_ref()
+                    .and_then(|split| split.side_of(tab))
+                    .map(Side::other);
+                if let Some(twin) = to.and_then(|side| self.twin_in(side, tab)) {
+                    return self.merge_into_twin(tab, twin);
+                }
+                match &mut self.split {
+                    Some(split) => split.move_tab(tab),
+                    None => {
+                        if self.tab_model.len() < 2 || !self.tab_model.contains_item(tab) {
+                            return Task::none();
+                        }
+                        let tabs: Vec<Entity> = self.tab_model.iter().collect();
+                        let left_shown = self.left_shown_after_move(&tabs, tab);
+                        self.split = Some(Split::new(&tabs, tab, left_shown));
+                    }
+                }
+                return self.update(AppMessage::TabActivate(tab));
+            }
+            Message::Clone(tab) => {
+                let tab = tab.unwrap_or_else(|| self.tab_model.active());
+                if !self.can_clone(tab) {
+                    return Task::none();
+                }
+                let other = self
+                    .split
+                    .as_ref()
+                    .and_then(|split| split.side_of(tab))
+                    .map(Side::other);
+                if let Some(twin) = other.and_then(|side| self.twin_in(side, tab)) {
+                    return self.update(AppMessage::TabActivate(twin));
+                }
+                let Some(Tab::Editor(source)) = self.tab_model.data::<Tab>(tab) else {
+                    return Task::none();
+                };
+                let mut clone = crate::mirror::clone_tab(source, &self.config);
+                if source.path_opt.is_some() && clone.path_opt.is_none() {
+                    return Task::none();
+                }
+                let hash = crate::mirror::text_hash(&crate::tab::editor_text(
+                    &clone.editor.lock().unwrap(),
+                ));
+                clone.markdown_init(source.markdown_view().unwrap_or(self.config.markdown_view));
+                let group = self.clone_group(tab);
+                let clone = self.insert_tab(clone);
+                self.mirror.link(&group, clone, Some(hash));
+                let side = match &mut self.split {
+                    Some(split) => split.side_of(tab).unwrap_or(split.active).other(),
+                    None => {
+                        let tabs: Vec<Entity> = self.tab_model.iter().collect();
+                        self.split = Some(Split::new(&tabs, clone, Some(tab)));
+                        Side::Right
+                    }
+                };
+                if let Some(split) = &mut self.split
+                    && split.side_of(clone).is_none()
+                {
+                    split.insert(side, clone);
+                }
+                return Task::batch([
+                    self.update(AppMessage::TabActivate(clone)),
+                    self.update(AppMessage::TabChanged(clone)),
+                ]);
+            }
+            Message::TabBarMove => {
+                let tab = self.tab_bar_context.take();
+                return self.update_views(Message::Move(tab));
+            }
+            Message::TabBarClone => {
+                let tab = self.tab_bar_context.take();
+                return self.update_views(Message::Clone(tab));
+            }
+            Message::TabBarCompare(other) => {
+                let tab = self.tab_bar_context.take();
+                return self.compare_tabs(tab, other);
+            }
+            Message::Activate(side, display) => {
+                if let Some(tab) = self.split.as_ref().and_then(|s| s.tab(side, display)) {
+                    return self.update(AppMessage::TabActivate(tab));
+                }
+            }
+            Message::Close(side, display) => {
+                if let Some(tab) = self.split.as_ref().and_then(|s| s.tab(side, display)) {
+                    return self.update(AppMessage::TabClose(tab));
+                }
+            }
+            Message::Context(side, display) => {
+                if let Some(tab) = self.split.as_ref().and_then(|s| s.tab(side, display)) {
+                    self.tab_bar_context = Some(tab);
+                }
+            }
+            Message::NewFile(side) => {
+                let focus = self.update_views(Message::Focus(side));
+                return Task::batch([focus, self.update(AppMessage::NewFile)]);
+            }
+            Message::Focus(side) => {
+                if let Some(split) = &self.split
+                    && split.active != side
+                    && let Some(tab) = split.shown(side)
+                {
+                    return self.update(AppMessage::TabActivate(tab));
+                }
+            }
+            Message::Scrolled(side) => self.follow_scroll(side),
+            Message::DividerPress => {
+                if let Some(split) = &mut self.split {
+                    split.dragging = true;
+                }
+            }
+            Message::DividerDrag(x, width) => {
+                if let Some(split) = &mut self.split
+                    && split.dragging
+                    && width > 0.0
+                {
+                    split.ratio = divider_ratio(x / width, width);
+                }
+            }
+            Message::DividerRelease => {
+                if let Some(split) = &mut self.split {
+                    split.dragging = false;
+                }
+            }
+            Message::ForgetTabDrag => {
+                if let Some(split) = &mut self.split {
+                    split.forget_drag();
+                }
+            }
+            Message::DragOver(side, inside) => {
+                if let Some(split) = &mut self.split {
+                    split.drag_over(side, inside);
+                }
+            }
+            Message::DropHint(side, display) => {
+                if let Some(split) = &mut self.split {
+                    split.drag_hint(side, display);
+                }
+            }
+            // On a tab of the other bar too: the tab goes to the end, where the marker is
+            Message::TabDrop(side, _) | Message::ViewDrop(side) => {
+                let Some((tab, last)) = self.split.as_mut().and_then(|split| split.drop_into(side))
+                else {
+                    return Task::none();
+                };
+                if let Some(twin) = self.twin_in(side, tab) {
+                    return self.merge_into_twin(tab, twin);
+                }
+                if let Some(split) = &mut self.split {
+                    split.move_tab(tab);
+                }
+                // A view's tabs follow the order of all tabs: put it right after the last one
+                if let Some(last) = last {
+                    _ = self.tab_model.reorder(tab, last, InsertPosition::After);
+                }
+                return self.update(AppMessage::TabActivate(tab));
+            }
+            Message::Reorder(side, event) => {
+                if let Some(split) = &self.split
+                    && let (Some(dragged), Some(target)) = (
+                        split.tab(side, event.dragged),
+                        split.tab(side, event.target),
+                    )
+                {
+                    _ = self.tab_model.reorder(dragged, target, event.position);
+                }
+            }
+        }
+        Task::none()
+    }
+
+    /// While the divider is dragged: the mouse button let go anywhere in the window, or the
+    /// pointer leaving the window, ends it.
+    /// A tab drag that ended outside the tab bars is forgotten on the next press.
+    pub fn views_subscription(&self) -> Subscription<AppMessage> {
+        let Some(split) = &self.split else {
+            return Subscription::none();
+        };
+        let divider = if split.dragging {
+            event::listen_with(|event, _status, _window| match event {
+                event::Event::Mouse(
+                    mouse::Event::ButtonReleased(mouse::Button::Left) | mouse::Event::CursorLeft,
+                ) => Some(Message::DividerRelease.into()),
+                _ => None,
+            })
+        } else {
+            Subscription::none()
+        };
+        let tab_drag = if split.drag_source.is_some() || split.drag_from.is_some() {
+            event::listen_with(|event, _status, _window| match event {
+                event::Event::Mouse(mouse::Event::ButtonPressed(mouse::Button::Left))
+                | event::Event::Keyboard(keyboard::Event::KeyPressed {
+                    key: keyboard::Key::Named(keyboard::key::Named::Escape),
+                    ..
+                }) => Some(Message::ForgetTabDrag.into()),
+                _ => None,
+            })
+        } else {
+            Subscription::none()
+        };
+        Subscription::batch([divider, tab_drag])
+    }
+
+    /// The tab the left view shows after `moving` leaves it: the active tab, or its neighbour
+    /// when the active tab is the one moving.
+    fn left_shown_after_move(&self, tabs: &[Entity], moving: Entity) -> Option<Entity> {
+        let active = self.tab_model.active();
+        if active != moving {
+            return Some(active);
+        }
+        crate::close_tabs::next_active(tabs, &[moving], moving)
+    }
+
+    /// Scroll the other view by as many lines, and as far sideways, as this one moved.
+    fn follow_scroll(&mut self, side: Side) {
+        if !self.config.sync_scroll_views {
+            return;
+        }
+        let Some(split) = &mut self.split else {
+            return;
+        };
+        let (Some(this), Some(other)) = (split.shown(side), split.shown(side.other())) else {
+            return;
+        };
+        let Some((_, tops)) = &mut split.scroll_base else {
+            return;
+        };
+        let to = scroll_position(&self.tab_model, this);
+        let from = tops[side.index()];
+        if to == from {
+            return;
+        }
+        let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(other) else {
+            return;
+        };
+        let other_top = {
+            let mut editor = tab.editor.lock().unwrap();
+            editor.with_buffer_mut(|buffer| {
+                let mut scroll = buffer.scroll();
+                scroll.line = follow_scroll(scroll.line, from.0, to.0, buffer.lines.len());
+                // As far right as the widest visible line allows, as the scrollbar does
+                let widest = buffer
+                    .layout_runs()
+                    .map(|run| run.line_w)
+                    .fold(0.0, f32::max);
+                let max = widest - buffer.size().0.unwrap_or(0.0);
+                scroll.horizontal = follow_horizontal(scroll.horizontal, from.1, to.1, max);
+                buffer.set_scroll(scroll);
+                (scroll.line, scroll.horizontal)
+            })
+        };
+        tops[side.index()] = to;
+        tops[side.other().index()] = other_top;
+    }
+}
+
+fn scroll_position(tabs: &SingleSelectModel, tab: Entity) -> ScrollPosition {
+    match tabs.data::<Tab>(tab) {
+        Some(Tab::Editor(tab)) => tab.editor.lock().unwrap().with_buffer(|buffer| {
+            let scroll = buffer.scroll();
+            (scroll.line, scroll.horizontal)
+        }),
+        _ => (0, 0.0),
+    }
+}
+
+/// The view of each saved tab and the shown tab of the inactive view, for the session.
+pub fn session_views(split: Option<&Split>, tabs: &[Entity]) -> (Vec<u8>, Option<Entity>) {
+    let Some(split) = split else {
+        return (vec![0; tabs.len()], None);
+    };
+    let views = tabs
+        .iter()
+        .map(|tab| u8::from(split.side_of(*tab) == Some(Side::Right)))
+        .collect();
+    (views, split.shown(split.active.other()))
+}
+
+/// The split a restored session asks for: tabs with view 1 go right. `None` when one view would
+/// be empty (old sessions have every tab in view 0).
+pub fn restore_split(
+    tabs: &[(Entity, u8)],
+    active: Option<Entity>,
+    other_shown: Option<Entity>,
+) -> Option<Split> {
+    let right: Vec<Entity> = tabs
+        .iter()
+        .filter(|(_, v)| *v == 1)
+        .map(|(t, _)| *t)
+        .collect();
+    if right.is_empty() || right.len() == tabs.len() {
+        return None;
+    }
+    let mut split = Split {
+        left: SingleSelectModel::default(),
+        right: SingleSelectModel::default(),
+        active: Side::Left,
+        ratio: 0.5,
+        dragging: false,
+        drag_source: None,
+        drag_over: None,
+        drag_from: None,
+        scroll_base: None,
+    };
+    for (tab, view) in tabs {
+        split.insert(if *view == 1 { Side::Right } else { Side::Left }, *tab);
+    }
+    for shown in [other_shown, active].into_iter().flatten() {
+        if let Some(side) = split.side_of(shown) {
+            let display = split.display(side, shown).unwrap();
+            split.model_mut(side).activate(display);
+            split.active = side;
+        }
+    }
+    Some(split)
+}

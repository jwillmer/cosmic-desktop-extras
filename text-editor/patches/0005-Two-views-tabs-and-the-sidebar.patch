+        split.drag_over(Side::Right, true);
+        assert_eq!(split.drop_highlight(), Some(Side::Right));
+        assert_eq!(split.drop_into(Side::Right), Some((t[1], Some(t[2]))));
+        // Esc or a drop outside: the drag is over, nothing stays highlighted
+        split.drag_hint(Side::Left, Some(display(&split, Side::Left, t[0])));
+        split.drag_over(Side::Right, true);
+        split.forget_drag();

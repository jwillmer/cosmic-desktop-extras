+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Where the keyboard focus goes: the editor, or an open context drawer page.
+
+use cosmic::{app::Task, widget};
+
+use crate::{App, Message};
+
+impl App {
+    /// Focus the editor of the active tab, e.g. after a menu action: without it the first key
+    /// typed after the menu closes does not reach the editor.
+    pub fn focus_text_box(&self) -> Task<Message> {
+        widget::text_input::focus(self.text_box_id.clone())
+    }
+
+    /// Whether an open context drawer page takes the focus and the typed keys from the editor.
+    pub(crate) fn context_page_modal(&self) -> bool {
+        self.core.window.show_context && self.context_page.modal()
+    }
+}

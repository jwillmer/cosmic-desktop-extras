@@ -0,0 +1,1162 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Code folding without changing the text.
+//!
+//! cosmic-text has no fold API, but it honours per-line metrics: a hidden line
+//! gets default attributes with a near-zero font size and a zero line height,
+//! so it takes no space in the layout and is never hit by a click. The text
+//! itself is never touched. `SyntaxEditor` rebuilds the highlight spans from the
+//! line's default attributes, so the hidden metrics survive re-highlighting.
+
+use cosmic_text::{AttrsList, Buffer, BufferLine, Cursor, Edit, LayoutRun, Metrics};
+use std::path::Path;
+
+use crate::{App, Message as AppMessage, tab::Tab};
+use cosmic::app::Task;
+
+/// Metrics of a hidden line: no height, glyphs too small to see.
+const HIDDEN: Metrics = Metrics::new(0.01, 0.0);
+
+/// Whether `line` is hidden by a fold.
+pub fn is_hidden(line: &BufferLine) -> bool {
+    line.attrs_list()
+        .defaults()
+        .metrics_opt
+        .is_some_and(|metrics| Metrics::from(metrics).line_height == 0.0)
+}
+
+/// Hide or show one line. The line is reset so the syntax highlighter
+/// rebuilds its spans from the new defaults.
+pub fn set_hidden(line: &mut BufferLine, hidden: bool) {
+    if is_hidden(line) == hidden {
+        return;
+    }
+    let mut defaults = line.attrs_list().defaults();
+    defaults.metrics_opt = hidden.then(|| HIDDEN.into());
+    line.set_attrs_list(AttrsList::new(&defaults));
+    line.reset();
+}
+
+/// Whether a layout row belongs to a hidden line; the gutter and the
+/// overlays skip those rows.
+pub fn is_folded_run(run: &LayoutRun) -> bool {
+    run.line_height == 0.0
+}
+
+/// How the blocks of a file are found.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum FoldKind {
+    /// From `{` or `[` to the matching close: JSON and C-like languages.
+    Brackets,
+    /// Following lines indented deeper than the header.
+    Indent,
+    /// From a heading to the next heading of the same or a higher level.
+    Markdown,
+}
+
+impl FoldKind {
+    pub fn for_path(path: Option<&Path>) -> Self {
+        let extension = path
+            .and_then(|path| path.extension())
+            .and_then(|extension| extension.to_str())
+            .map(str::to_ascii_lowercase);
+        match extension.as_deref() {
+            Some("md" | "markdown") => Self::Markdown,
+            Some(
+                "json" | "jsonc" | "rs" | "c" | "h" | "cc" | "cpp" | "hpp" | "cs" | "java" | "js"
+                | "mjs" | "jsx" | "ts" | "tsx" | "go" | "css" | "scss" | "kt" | "swift" | "php"
+                | "dart" | "scala" | "zig",
+            ) => Self::Brackets,
+            _ => Self::Indent,
+        }
+    }
+}
+
+/// The lines (first, last) a fold with its header at `line` hides, if any.
+pub fn fold_range<S: AsRef<str>>(
+    lines: &[S],
+    line: usize,
+    kind: FoldKind,
+) -> Option<(usize, usize)> {
+    let range = match kind {
+        FoldKind::Brackets => bracket_range(lines, line),
+        FoldKind::Indent => indent_range(lines, line),
+        FoldKind::Markdown => markdown_range(lines, line),
+    }?;
+    (range.0 <= range.1).then_some(range)
+}
+
+/// Calls `on_change` with the depth after each bracket of `text`, skipping
+/// strings, until it returns true.
+fn bracket_depths(text: &str, mut on_change: impl FnMut(i32) -> bool) {
+    let mut depth = 0;
+    let mut quote = None;
+    let mut escaped = false;
+    for c in text.chars() {
+        if let Some(q) = quote {
+            if escaped {
+                escaped = false;
+            } else if c == '\\' {
+                escaped = true;
+            } else if c == q {
+                quote = None;
+            }
+            continue;
+        }
+        match c {
+            '"' | '`' => quote = Some(c),
+            '{' | '[' | '(' => depth += 1,
+            '}' | ']' | ')' => depth -= 1,
+            _ => continue,
+        }
+        if on_change(depth) {
+            return;
+        }
+    }
+}
+
+/// How many bracket levels `header` leaves open.
+fn opened(header: &str) -> i32 {
+    let mut open = 0;
+    let mut lowest = 0;
+    bracket_depths(header, |depth| {
+        open = depth;
+        lowest = lowest.min(depth);
+        false
+    });
+    open - lowest
+}
+
+/// A header opens a block when a bracket on it stays open; the fold hides the
+/// lines up to the one holding the matching close, which stays visible.
+fn bracket_range<S: AsRef<str>>(lines: &[S], line: usize) -> Option<(usize, usize)> {
+    let open = opened(lines.get(line)?.as_ref());
+    if open <= 0 {
+        return None;
+    }
+    // The outermost open bracket closes when the depth drops by `open`
+    let mut depth = 0;
+    for (i, text) in lines.iter().enumerate().skip(line + 1) {
+        let base = depth;
+        let mut closed = false;
+        bracket_depths(text.as_ref(), |change| {
+            depth = base + change;
+            closed = depth <= -open;
+            closed
+        });
+        if closed {
+            return Some((line + 1, i - 1));
+        }
+    }
+    None
+}
+
+fn indent_of(text: &str) -> Option<usize> {
+    let mut width = 0;
+    for c in text.chars() {
+        match c {
+            ' ' => width += 1,
+            '\t' => width += 4,
+            _ => return Some(width),
+        }
+    }
+    // A blank line has no indentation of its own
+    None
+}
+
+fn indent_range<S: AsRef<str>>(lines: &[S], line: usize) -> Option<(usize, usize)> {
+    let header = indent_of(lines.get(line)?.as_ref())?;
+    let mut last = None;
+    for (i, text) in lines.iter().enumerate().skip(line + 1) {
+        match indent_of(text.as_ref()) {
+            Some(indent) if indent > header => last = Some(i),
+            Some(_) => break,
+            None => {}
+        }
+    }
+    Some((line + 1, last?))
+}
+
+fn heading_level(text: &str) -> Option<usize> {
+    let level = text.chars().take_while(|&c| c == '#').count();
+    let rest = &text[level..];
+    ((1..=6).contains(&level) && (rest.is_empty() || rest.starts_with([' ', '\t'])))
+        .then_some(level)
+}
+
+fn markdown_range<S: AsRef<str>>(lines: &[S], line: usize) -> Option<(usize, usize)> {
+    let level = heading_level(lines.get(line)?.as_ref())?;
+    let mut fence = false;
+    let mut end = lines.len() - 1;
+    for (i, text) in lines.iter().enumerate().skip(line + 1) {
+        let text = text.as_ref();
+        if text.trim_start().starts_with("```") || text.trim_start().starts_with("~~~") {
+            fence = !fence;
+        } else if !fence && heading_level(text).is_some_and(|other| other <= level) {
+            end = i - 1;
+            break;
+        }
+    }
+    // Blank lines before the next heading stay visible
+    while end > line && lines[end].as_ref().trim().is_empty() {
+        end -= 1;
+    }
+    Some((line + 1, end))
+}
+
+/// Whether `line` heads a block, for the gutter chevrons. Cheap enough for
+/// every visible row: it reads the header and the first non-blank line below.
+/// An unclosed bracket still counts; toggling it then does nothing.
+pub fn is_foldable<'a>(
+    text: impl Fn(usize) -> Option<&'a str>,
+    line: usize,
+    kind: FoldKind,
+) -> bool {
+    let Some(header) = text(line) else {
+        return false;
+    };
+    let mut below = (line + 1..).map_while(&text);
+    match kind {
+        FoldKind::Brackets => {
+            let open = opened(header);
+            // An empty block closes on the next line
+            open > 0
+                && below.take(1).any(|next| {
+                    let mut closed = false;
+                    bracket_depths(next, |depth| {
+                        closed = depth <= -open;
+                        closed
+                    });
+                    !closed
+                })
+        }
+        FoldKind::Indent => indent_of(header).is_some_and(|header| {
+            below
+                .filter_map(indent_of)
+                .next()
+                .is_some_and(|indent| indent > header)
+        }),
+        FoldKind::Markdown => heading_level(header).is_some_and(|level| {
+            below
+                .find(|text| !text.trim().is_empty())
+                .is_some_and(|text| heading_level(text).is_none_or(|other| other > level))
+        }),
+    }
+}
+
+fn texts(buffer: &Buffer) -> Vec<&str> {
+    buffer.lines.iter().map(BufferLine::text).collect()
+}
+
+/// Whether `header` heads a fold. O(1), unlike [`folded_after`], for the
+/// per-frame drawing and hit tests (`layout_runs` still visits every
+/// zero-height row of a fold; accepted).
+pub fn is_fold_header(buffer: &Buffer, header: usize) -> bool {
+    buffer
+        .lines
+        .get(header)
+        .is_some_and(|line| !is_hidden(line))
+        && buffer.lines.get(header + 1).is_some_and(is_hidden)
+}
+
+/// The hidden lines right below `header`, if it heads a fold.
+pub fn folded_after(buffer: &Buffer, header: usize) -> Option<(usize, usize)> {
+    let first = header + 1;
+    let count = buffer
+        .lines
+        .get(first..)?
+        .iter()
+        .take_while(|line| is_hidden(line))
+        .count();
+    (count > 0 && !buffer.lines.get(header).is_some_and(is_hidden))
+        .then(|| (first, first + count - 1))
+}
+
+/// The run of hidden lines holding `line`.
+fn hidden_run(buffer: &Buffer, line: usize) -> Option<(usize, usize)> {
+    if !buffer.lines.get(line).is_some_and(is_hidden) {
+        return None;
+    }
+    let mut first = line;
+    while first > 0 && is_hidden(&buffer.lines[first - 1]) {
+        first -= 1;
+    }
+    let mut last = line;
+    while last + 1 < buffer.lines.len() && is_hidden(&buffer.lines[last + 1]) {
+        last += 1;
+    }
+    Some((first, last))
+}
+
+fn set_range(buffer: &mut Buffer, (first, last): (usize, usize), hidden: bool) {
+    for line in &mut buffer.lines[first..=last] {
+        set_hidden(line, hidden);
+    }
+    buffer.set_redraw(true);
+}
+
+/// Fold the block headed by `line`, or else the innermost block holding it.
+/// Returns the header of the new fold.
+pub fn fold(buffer: &mut Buffer, line: usize, kind: FoldKind) -> Option<usize> {
+    let lines = texts(buffer);
+    // Look a bounded way up, so a huge file never stalls the key press
+    let header = (line.saturating_sub(2000)..=line).rev().find(|&header| {
+        fold_range(&lines, header, kind).is_some_and(|(_, last)| last >= line)
+            && !is_fold_header(buffer, header)
+    })?;
+    let range = fold_range(&lines, header, kind)?;
+    set_range(buffer, range, true);
+    Some(header)
+}
+
+/// Unfold the fold headed by or holding `line`.
+pub fn unfold(buffer: &mut Buffer, line: usize) -> bool {
+    match folded_after(buffer, line).or_else(|| hidden_run(buffer, line)) {
+        Some(range) => {
+            set_range(buffer, range, false);
+            true
+        }
+        None => false,
+    }
+}
+
+/// Fold or unfold the block headed by `header`, as a click on its chevron
+/// does. Returns false when `header` heads no block.
+pub fn toggle(buffer: &mut Buffer, header: usize, kind: FoldKind) -> bool {
+    if let Some(range) = folded_after(buffer, header) {
+        set_range(buffer, range, false);
+        return true;
+    }
+    match fold_range(&texts(buffer), header, kind) {
+        Some(range) => {
+            set_range(buffer, range, true);
+            true
+        }
+        None => false,
+    }
+}
+
+/// Unfold every fold that hides one of the lines `first..=last`, e.g. before a
+/// column selection over them edits each line.
+pub fn unfold_lines(buffer: &mut Buffer, first: usize, last: usize) -> bool {
+    let mut unfolded = false;
+    let mut line = first;
+    while line <= last && line < buffer.lines.len() {
+        match hidden_run(buffer, line) {
+            Some(range) => {
+                set_range(buffer, range, false);
+                unfolded = true;
+                line = range.1 + 1;
+            }
+            None => line += 1,
+        }
+    }
+    unfolded
+}
+
+/// After an edit: unfold what hides `cursor_line` (where the edit, an undo or a
+/// paste left the cursor) and every fold that no longer is exactly the block
+/// of the line above it. Typing on a header keeps its fold while the block
+/// stays the same; deleting the bracket, a selection over the fold or a line
+/// break around it drops the fold, so no edited text stays hidden. Costs a
+/// scan of the lines only while something is folded.
+pub fn reconcile(buffer: &mut Buffer, kind: FoldKind, cursor_line: usize) -> bool {
+    if !buffer.lines.iter().any(is_hidden) {
+        return false;
+    }
+    let mut unfolded = reveal(buffer, cursor_line);
+    let stale = {
+        let lines = texts(buffer);
+        let mut stale = Vec::new();
+        let mut line = 0;
+        while line < lines.len() {
+            if !is_hidden(&buffer.lines[line]) {
+                line += 1;
+                continue;
+            }
+            let first = line;
+            while line + 1 < lines.len() && is_hidden(&buffer.lines[line + 1]) {
+                line += 1;
+            }
+            let range = (first, line);
+            if first == 0 || fold_range(&lines, first - 1, kind) != Some(range) {
+                stale.push(range);
+            }
+            line += 1;
+        }
+        stale
+    };
+    for range in stale {
+        set_range(buffer, range, false);
+        unfolded = true;
+    }
+    unfolded
+}
+
+/// Fold every outermost block.
+pub fn fold_all(buffer: &mut Buffer, kind: FoldKind) {
+    let ranges = {
+        let lines = texts(buffer);
+        let mut ranges = Vec::new();
+        let mut line = 0;
+        while line < lines.len() {
+            match fold_range(&lines, line, kind) {
+                Some(range) => {
+                    ranges.push(range);
+                    line = range.1 + 1;
+                }
+                None => line += 1,
+            }
+        }
+        ranges
+    };
+    for range in ranges {
+        set_range(buffer, range, true);
+    }
+}
+
+pub fn unfold_all(buffer: &mut Buffer) {
+    if buffer.lines.iter().any(is_hidden) {
+        let last = buffer.lines.len() - 1;
+        set_range(buffer, (0, last), false);
+    }
+}
+
+/// The folds to keep in the session: each fold's header line and its text.
+pub fn saved_folds(buffer: &Buffer) -> Vec<(usize, String)> {
+    (0..buffer.lines.len())
+        .filter(|&line| is_fold_header(buffer, line))
+        .map(|line| (line, buffer.lines[line].text().to_string()))
+        .collect()
+}
+
+/// Fold again the blocks of [`saved_folds`]. A fold whose header line no longer holds the
+/// saved text (the file changed since) is dropped.
+pub fn restore_folds(buffer: &mut Buffer, folds: &[(usize, String)], kind: FoldKind) {
+    let ranges: Vec<(usize, usize)> = {
+        let lines = texts(buffer);
+        folds
+            .iter()
+            .filter(|(line, text)| lines.get(*line) == Some(&text.as_str()))
+            .filter_map(|(line, _)| fold_range(&lines, *line, kind))
+            .collect()
+    };
+    for range in ranges {
+        set_range(buffer, range, true);
+    }
+}
+
+/// Unfold whatever hides `line`, so a find hit or an edit is never hidden.
+pub fn reveal(buffer: &mut Buffer, line: usize) -> bool {
+    match hidden_run(buffer, line) {
+        Some(range) => {
+            set_range(buffer, range, false);
+            true
+        }
+        None => false,
+    }
+}
+
+/// After a vertical motion: step over a fold instead of landing inside it.
+/// Moving down goes to the line after the fold, moving up to its header.
+pub fn skip_fold(buffer: &Buffer, from: Cursor, to: Cursor) -> Cursor {
+    let Some((first, last)) = hidden_run(buffer, to.line) else {
+        return to;
+    };
+    let line = if to.line > from.line && last + 1 < buffer.lines.len() {
+        last + 1
+    } else if first > 0 {
+        first - 1
+    } else {
+        last + 1
+    };
+    let text = buffer.lines.get(line).map_or("", BufferLine::text);
+    let mut index = to.index.min(text.len());
+    while !text.is_char_boundary(index) {
+        index -= 1;
+    }
+    Cursor::new(line, index)
+}
+
+/// After folding: a cursor or selection that reaches into hidden lines leaves them, so the
+/// next key press never edits text the user cannot see. The selection is dropped and a hidden
+/// cursor goes to the end of its fold header, as in VS Code.
+pub fn leave_folds<'buffer, E: Edit<'buffer>>(editor: &mut E) {
+    let cursor = editor.cursor();
+    let (start, end) = editor.selection_bounds().unwrap_or((cursor, cursor));
+    let touches = editor.with_buffer(|buffer| {
+        (start.line..=end.line).any(|line| buffer.lines.get(line).is_some_and(is_hidden))
+    });
+    if !touches {
+        return;
+    }
+    editor.set_selection(cosmic_text::Selection::None);
+    let to = editor.with_buffer(|buffer| match hidden_run(buffer, cursor.line) {
+        Some((first, _)) if first > 0 => {
+            Some(Cursor::new(first - 1, buffer.lines[first - 1].text().len()))
+        }
+        Some(_) => Some(skip_fold(buffer, cursor, cursor)),
+        None => None,
+    });
+    if let Some(to) = to {
+        editor.set_cursor(to);
+    }
+    editor.set_redraw(true);
+}
+
+/// Before an edit: unfold every fold the selection (or the cursor) reaches into, so an edit
+/// is never applied to hidden text. Returns whether something was unfolded.
+pub fn reveal_selection<'buffer, E: Edit<'buffer>>(editor: &mut E) -> bool {
+    let cursor = editor.cursor();
+    let (start, end) = editor.selection_bounds().unwrap_or((cursor, cursor));
+    editor.with_buffer_mut(|buffer| unfold_lines(buffer, start.line, end.line))
+}
+
+/// Before Backspace (`forward` false) or Delete (`forward` true) without a selection: unfold
+/// the line the key would join the cursor's line with, when that line is hidden. A plain key
+/// joins at the start or end of the line; with `word` (Ctrl) it also does when only blanks
+/// lie between the cursor and the line's start or end.
+pub fn reveal_join<'buffer, E: Edit<'buffer>>(editor: &mut E, forward: bool, word: bool) -> bool {
+    if editor.selection_bounds().is_some() {
+        return false;
+    }
+    let cursor = editor.cursor();
+    editor.with_buffer_mut(|buffer| {
+        let Some(text) = buffer.lines.get(cursor.line).map(BufferLine::text) else {
+            return false;
+        };
+        let index = cursor.index.min(text.len());
+        let (rest, at_edge) = if forward {
+            (&text[index..], index == text.len())
+        } else {
+            (&text[..index], index == 0)
+        };
+        if !(at_edge || word && rest.trim().is_empty()) {
+            return false;
+        }
+        let line = if forward {
+            cursor.line + 1
+        } else {
+            match cursor.line.checked_sub(1) {
+                Some(line) => line,
+                None => return false,
+            }
+        };
+        reveal(buffer, line)
+    })
+}
+
+#[derive(Clone, Copy, Debug)]
+pub enum Message {
+    Fold,
+    Unfold,
+    FoldAll,
+    UnfoldAll,
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::Folding(message)
+    }
+}
+
+impl crate::tab::EditorTab {
+    pub fn fold_kind(&self) -> FoldKind {
+        if self.is_json() {
+            FoldKind::Brackets
+        } else {
+            FoldKind::for_path(self.path_opt.as_deref())
+        }
+    }
+
+    /// After an edit: unfold the folds it touched (see [`reconcile`]).
+    pub fn reconcile_folds(&self) {
+        let kind = self.fold_kind();
+        let mut editor = self.editor.lock().unwrap();
+        let line = editor.cursor().line;
+        editor.with_buffer_mut(|buffer| reconcile(buffer, kind, line));
+    }
+
+    /// Unfold whatever hides the cursor, e.g. after a find hit.
+    pub fn reveal_cursor(&self) {
+        let mut editor = self.editor.lock().unwrap();
+        let line = editor.cursor().line;
+        editor.with_buffer_mut(|buffer| reveal(buffer, line));
+    }
+}
+
+impl App {
+    pub fn update_folding(&mut self, message: Message) -> Task<AppMessage> {
+        let Some(Tab::Editor(tab)) = self.active_tab() else {
+            return Task::none();
+        };
+        let kind = tab.fold_kind();
+        // A column block must not span a new fold
+        *tab.column.lock().unwrap() = None;
+        let mut editor = tab.editor.lock().unwrap();
+        let line = editor.cursor().line;
+        editor.with_buffer_mut(|buffer| match message {
+            Message::Fold => {
+                fold(buffer, line, kind);
+            }
+            Message::Unfold => {
+                unfold(buffer, line);
+            }
+            Message::FoldAll => fold_all(buffer, kind),
+            Message::UnfoldAll => unfold_all(buffer),
+        });
+        // Folding the block around the cursor or selection moves it to the header
+        leave_folds(&mut *editor);
+        // From the View menu the first key would otherwise not reach the editor
+        self.focus_text_box()
+    }
+}

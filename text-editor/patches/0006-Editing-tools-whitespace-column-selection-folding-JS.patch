+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Column (block, rectangular) selection like Notepad++: Alt+drag or Alt+Shift+arrows select
+//! the same visual columns on every line between two points, and typing, deleting, copying
+//! and pasting then act on every line of the block at once.
+//!
+//! Columns are visual columns of the logical line: one per character, a tab reaches the next
+//! multiple of the tab width. Wrapping is ignored, so a wrapped line uses the columns of its
+//! whole logical line. A character belongs to the block when it starts inside it, and a line
+//! that ends left of the block contributes nothing. A tab cut by an edge of the block is
+//! replaced by spaces of the same width before the block is edited, so text goes in and out at
+//! the same visual columns on every line; a copy gives the columns of such a tab inside the
+//! block as spaces, and keeps whole tabs.
+
+use cosmic_text::{Cursor, Edit};
+use std::ops::Range;
+
+/// A line and a visual column on it
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Pos {
+    pub line: usize,
+    pub col: usize,
+}
+
+impl Pos {
+    pub fn new(line: usize, col: usize) -> Self {
+        Self { line, col }
+    }
+}
+
+/// A rectangle between the point where the selection started and the moving point
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Block {
+    pub anchor: Pos,
+    pub head: Pos,
+}
+
+impl Block {
+    pub fn new(anchor: Pos, head: Pos) -> Self {
+        Self { anchor, head }
+    }
+
+    /// A zero-width block on the lines `lines` at `col`: a cursor on every line
+    fn cursors(lines: Range<usize>, col: usize) -> Self {
+        let last = lines.end.saturating_sub(1).max(lines.start);
+        Self::new(Pos::new(lines.start, col), Pos::new(last, col))
+    }
+
+    pub fn top(&self) -> usize {
+        self.anchor.line.min(self.head.line)
+    }
+
+    pub fn bottom(&self) -> usize {
+        self.anchor.line.max(self.head.line)
+    }
+
+    pub fn left(&self) -> usize {
+        self.anchor.col.min(self.head.col)
+    }
+
+    pub fn right(&self) -> usize {
+        self.anchor.col.max(self.head.col)
+    }
+
+    pub fn height(&self) -> usize {
+        self.bottom() - self.top() + 1
+    }
+
+    /// The block has no width: typing inserts on every line
+    pub fn is_empty(&self) -> bool {
+        self.left() == self.right()
+    }
+}
+
+/// Width of `c` when it starts at visual column `col`
+fn char_width(c: char, col: usize, tab_width: usize) -> usize {
+    if c == '\t' {
+        let tab_width = tab_width.max(1);
+        tab_width - col % tab_width
+    } else {
+        1
+    }
+}
+
+/// Visual width of `text` starting at column 0
+pub fn width(text: &str, tab_width: usize) -> usize {
+    width_from(text, 0, tab_width)
+}
+
+/// Visual width of `text` starting at column `start`, where a tab reaches the next tab stop
+fn width_from(text: &str, start: usize, tab_width: usize) -> usize {
+    text.chars()
+        .fold(start, |col, c| col + char_width(c, col, tab_width))
+        - start
+}
+
+/// Visual column where the character at byte `index` of `text` starts
+pub fn col_of(text: &str, index: usize, tab_width: usize) -> usize {
+    width(&text[..index.min(text.len())], tab_width)
+}
+
+/// Byte index of the first character boundary at or right of visual column `col`
+fn index_at(text: &str, col: usize, tab_width: usize) -> usize {
+    let mut c_col = 0;
+    for (i, c) in text.char_indices() {
+        if c_col >= col {
+            return i;
+        }
+        c_col += char_width(c, c_col, tab_width);
+    }
+    text.len()
+}
+
+/// The tab of `text` that reaches across visual column `col` (starts left of it and ends right
+/// of it), as its byte index and visual width
+pub fn tab_across(text: &str, col: usize, tab_width: usize) -> Option<(usize, usize)> {
+    let mut c_col = 0;
+    for (i, c) in text.char_indices() {
+        if c_col >= col {
+            return None;
+        }
+        let w = char_width(c, c_col, tab_width);
+        if c == '\t' && c_col + w > col {
+            return Some((i, w));
+        }
+        c_col += w;
+    }
+    None
+}
+
+/// `text` with the tabs reaching across any of `cols` replaced by spaces of the same width
+fn split_tabs(text: &str, cols: &[usize], tab_width: usize) -> String {
+    let mut text = text.to_string();
+    for &col in cols {
+        if let Some((i, w)) = tab_across(&text, col, tab_width) {
+            text.replace_range(i..i + 1, &" ".repeat(w));
+        }
+    }
+    text
+}
+
+/// Replace the tabs of `line` reaching across any of `cols` by spaces of the same width, as
+/// part of the current change, so an edit at those columns lands exactly there
+fn split_tabs_at<'buffer, E: Edit<'buffer>>(editor: &mut E, line: usize, cols: &[usize]) {
+    let tab_width = editor.tab_width() as usize;
+    for &col in cols {
+        let tab =
+            editor.with_buffer(|buffer| tab_across(buffer.lines.get(line)?.text(), col, tab_width));
+        if let Some((i, w)) = tab {
+            editor.delete_range(Cursor::new(line, i), Cursor::new(line, i + 1));
+            editor.insert_at(Cursor::new(line, i), &" ".repeat(w), None);
+        }
+    }
+}
+
+/// Byte range of `text` inside the columns `left..right`, or `None` when the line ends left
+/// of `left`
+pub fn line_range(text: &str, left: usize, right: usize, tab_width: usize) -> Option<Range<usize>> {
+    if width(text, tab_width) < left {
+        return None;
+    }
+    Some(index_at(text, left, tab_width)..index_at(text, right, tab_width))
+}
+
+/// The byte range of every line of `block` that exists in the buffer, `None` for short lines
+pub fn ranges<'buffer, E: Edit<'buffer>>(
+    editor: &E,
+    block: &Block,
+) -> Vec<(usize, Option<Range<usize>>)> {
+    let tab_width = editor.tab_width() as usize;
+    editor.with_buffer(|buffer| {
+        (block.top()..=block.bottom())
+            .filter_map(|line| {
+                let text = buffer.lines.get(line)?.text();
+                Some((
+                    line,
+                    line_range(text, block.left(), block.right(), tab_width),
+                ))
+            })
+            .collect()
+    })
+}
+
+/// The text of the block, one line per line of the block (empty for short lines). A tab cut by
+/// an edge of the block gives the columns it covers inside the block as spaces.
+pub fn copy<'buffer, E: Edit<'buffer>>(editor: &E, block: &Block) -> String {
+    let tab_width = editor.tab_width() as usize;
+    let (left, right) = (block.left(), block.right());
+    let rows: Vec<String> = editor.with_buffer(|buffer| {
+        (block.top()..=block.bottom())
+            .filter_map(|line| buffer.lines.get(line))
+            .map(|line| {
+                let text = split_tabs(line.text(), &[left, right], tab_width);
+                line_range(&text, left, right, tab_width)
+                    .map_or_else(String::new, |range| text[range].to_string())
+            })
+            .collect()
+    });
+    rows.join("\n")
+}
+
+/// Put the cursor of `editor` at the moving point of `block`
+pub fn place_cursor<'buffer, E: Edit<'buffer>>(editor: &mut E, block: &Block) {
+    let tab_width = editor.tab_width() as usize;
+    let cursor = editor.with_buffer(|buffer| {
+        let line = block.head.line.min(buffer.lines.len().saturating_sub(1));
+        let text = buffer.lines.get(line).map_or("", |l| l.text());
+        Cursor::new(line, index_at(text, block.head.col, tab_width))
+    });
+    editor.set_cursor(cursor);
+    editor.set_redraw(true);
+}
+
+/// Start a block at the cursor of `editor`, or move the head of `block` by `lines` and `cols`
+pub fn extend<'buffer, E: Edit<'buffer>>(
+    editor: &mut E,
+    block: Option<Block>,
+    lines: isize,
+    cols: isize,
+) -> Block {
+    let tab_width = editor.tab_width() as usize;
+    let mut block = block.unwrap_or_else(|| {
+        let cursor = editor.cursor();
+        let col = editor.with_buffer(|buffer| {
+            col_of(buffer.lines[cursor.line].text(), cursor.index, tab_width)
+        });
+        let pos = Pos::new(cursor.line, col);
+        Block::new(pos, pos)
+    });
+    let last = editor.with_buffer(|buffer| buffer.lines.len().saturating_sub(1));
+    block.head.line = block.head.line.saturating_add_signed(lines).min(last);
+    block.head.col = block.head.col.saturating_add_signed(cols);
+    place_cursor(editor, &block);
+    block
+}
+
+/// Replace the block on every line with `text` (without line breaks), as part of the current
+/// change. Lines are edited from the bottom up, so the indices of the others stay valid. A tab
+/// cut by an edge of the block becomes spaces first, so every line is edited at the same
+/// visual columns.
+fn replace_each<'buffer, E: Edit<'buffer>>(editor: &mut E, block: &Block, text: &str) {
+    split_tabs_each(editor, block);
+    for (line, range) in ranges(editor, block).into_iter().rev() {
+        let Some(range) = range else { continue };
+        if !range.is_empty() {
+            editor.delete_range(Cursor::new(line, range.start), Cursor::new(line, range.end));
+        }
+        if !text.is_empty() {
+            editor.insert_at(Cursor::new(line, range.start), text, None);
+        }
+    }
+}
+
+/// Replace the tabs cut by an edge of `block` on its lines by spaces, as part of the current
+/// change
+fn split_tabs_each<'buffer, E: Edit<'buffer>>(editor: &mut E, block: &Block) {
+    for line in block.top()..=block.bottom() {
+        split_tabs_at(editor, line, &[block.left(), block.right()]);
+    }
+}
+
+/// Type `text` on every line of the block, replacing what it selects, as one undo step.
+/// Returns the zero-width block after the inserted text.
+pub fn insert<'buffer, E: Edit<'buffer>>(editor: &mut E, block: &Block, text: &str) -> Block {
+    let tab_width = editor.tab_width() as usize;
+    editor.start_change();
+    replace_each(editor, block, text);
+    editor.finish_change();
+    let block = Block::cursors(
+        block.top()..block.bottom() + 1,
+        block.left() + width_from(text, block.left(), tab_width),
+    );
+    place_cursor(editor, &block);
+    block
+}
+
+/// Backspace (`forward` false) or Delete (`forward` true): remove the block, or with a
+/// zero-width block one character before or after it on every line, as one undo step.
+pub fn delete<'buffer, E: Edit<'buffer>>(editor: &mut E, block: &Block, forward: bool) -> Block {
+    if !block.is_empty() {
+        return insert(editor, block, "");
+    }
+    let tab_width = editor.tab_width() as usize;
+    let mut new_col = block.left();
+    editor.start_change();
+    split_tabs_each(editor, block);
+    for (line, range) in ranges(editor, block).into_iter().rev() {
+        let Some(range) = range else { continue };
+        let text = editor.with_buffer(|buffer| buffer.lines[line].text().to_string());
+        let at = range.start;
+        let span = if forward {
+            text[at..].chars().next().map(|c| at..at + c.len_utf8())
+        } else {
+            text[..at]
+                .chars()
+                .next_back()
+                .map(|c| at - c.len_utf8()..at)
+        };
+        if let Some(span) = span {
+            if !forward {
+                new_col = new_col.min(col_of(&text, span.start, tab_width));
+            }
+            editor.delete_range(Cursor::new(line, span.start), Cursor::new(line, span.end));
+        }
+    }
+    editor.finish_change();
+    let block = Block::cursors(block.top()..block.bottom() + 1, new_col);
+    place_cursor(editor, &block);
+    block
+}
+
+/// Paste `text` into the block as one undo step. One line of text replaces the block on every
+/// line. Several lines (a block copied before, or any other) go in line by line from the top
+/// line down, continuing below the block when there are more; rows that would land past the
+/// end of the file or on a line ending left of the block are dropped. Returns the block to
+/// keep for one line of text, `None` for line by line.
+pub fn paste<'buffer, E: Edit<'buffer>>(
+    editor: &mut E,
+    block: &Block,
+    text: &str,
+) -> Option<Block> {
+    let text = text.replace("\r\n", "\n");
+    let rows: Vec<&str> = text.split('\n').collect();
+    if rows.len() == 1 {
+        return Some(insert(editor, block, &text));
+    }
+    let line_count = editor.with_buffer(|buffer| buffer.lines.len());
+    if block.top() >= line_count {
+        return Some(*block);
+    }
+    // The rows below the block go to lines that may be folded: never edit hidden text
+    editor.with_buffer_mut(|buffer| {
+        crate::folding::unfold_lines(buffer, block.top(), block.top() + rows.len() - 1)
+    });
+    editor.start_change();
+    for (i, row) in rows.iter().enumerate().rev() {
+        let line = block.top() + i;
+        if line >= line_count {
+            continue;
+        }
+        // Below the block the paste replaces nothing
+        let right = if line <= block.bottom() {
+            block.right()
+        } else {
+            block.left()
+        };
+        let one = Block::new(Pos::new(line, block.left()), Pos::new(line, right));
+        replace_each(editor, &one, row);
+    }
+    editor.finish_change();
+    let last = (block.top() + rows.len()).min(line_count).saturating_sub(1);
+    let tab_width = editor.tab_width() as usize;
+    let col = block.left() + width_from(rows[last - block.top()], block.left(), tab_width);
+    place_cursor(editor, &Block::cursors(last..last + 1, col));
+    None
+}
+
+/// Remembers the text of the last copy or cut when it came from a column block, so pasting
+/// that text again (and not something copied elsewhere since) pastes it as a block.
+#[derive(Debug, Default)]
+pub struct BlockClipboard(Option<String>);
+
+impl BlockClipboard {
+    /// A copy or cut put `text` on the clipboard, from a column block or not
+    pub fn copied(&mut self, text: &str, from_block: bool) {
+        self.0 = from_block.then(|| text.to_string());
+    }
+
+    /// Whether `text` read from the clipboard is the last column block copied
+    pub fn is_block(&self, text: &str) -> bool {
+        self.0
+            .as_deref()
+            .is_some_and(|copied| copied == text.replace("\r\n", "\n"))
+    }
+}
+
+/// Paste `text` copied from a column block as a block at the cursor, as Notepad++ does, as
+/// one undo step: row `i` goes in at the cursor's visual column on the `i`th line from the
+/// cursor down. A line ending left of that column is padded with spaces, and rows past the end
+/// of the file go on new lines. A selection is replaced first.
+pub fn paste_block<'buffer, E: Edit<'buffer>>(editor: &mut E, text: &str) {
+    let text = text.replace("\r\n", "\n");
+    let rows: Vec<&str> = text.split('\n').collect();
+    let tab_width = editor.tab_width() as usize;
+    // A selection reaching into a fold is unfolded before it is replaced
+    crate::folding::reveal_selection(editor);
+    editor.start_change();
+    editor.delete_selection();
+    let cursor = editor.cursor();
+    let col = editor
+        .with_buffer(|buffer| col_of(buffer.lines[cursor.line].text(), cursor.index, tab_width));
+    // Never edit hidden text: the rows go to lines that may be folded
+    editor.with_buffer_mut(|buffer| {
+        crate::folding::unfold_lines(buffer, cursor.line, cursor.line + rows.len() - 1)
+    });
+    let mut end = cursor;
+    // Top down: each row edits one line, or appends one at the end of the file
+    for (i, row) in rows.iter().enumerate() {
+        let line = cursor.line + i;
+        let (line_count, line_text) = editor.with_buffer(|buffer| {
+            let text = buffer.lines.get(line).map(|l| l.text().to_string());
+            (buffer.lines.len(), text)
+        });
+        end = match line_text {
+            Some(line_text) => {
+                let line_width = width(&line_text, tab_width);
+                let (at, insert) = if line_width < col {
+                    (
+                        line_text.len(),
+                        format!("{}{row}", " ".repeat(col - line_width)),
+                    )
+                } else {
+                    // A tab reaching across the column becomes spaces, so the row lands on it
+                    split_tabs_at(editor, line, &[col]);
+                    let line_text =
+                        editor.with_buffer(|buffer| buffer.lines[line].text().to_string());
+                    (index_at(&line_text, col, tab_width), row.to_string())
+                };
+                editor.insert_at(Cursor::new(line, at), &insert, None)
+            }
+            None => {
+                let last = line_count - 1;
+                let at = editor.with_buffer(|buffer| buffer.lines[last].text().len());
+                let insert = format!("\n{}{row}", " ".repeat(col));
+                editor.insert_at(Cursor::new(last, at), &insert, None)
+            }
+        };
+    }
+    editor.finish_change();
+    editor.set_cursor(end);
+    editor.set_redraw(true);
+}
+
+/// Behaviours under test:
+/// - a block from two points covers the same visual columns on every line between them
+/// - short lines are skipped, a tab counts as reaching the next tab stop
+/// - typing, Backspace and Delete act on every line, each as one undo step
+/// - copy joins the lines with `\n`; pasting a block distributes it line by line
+#[cfg(test)]
+pub(crate) mod tests {
+    use super::*;
+    use crate::tab::editor_text;
+    use cosmic_text::{Attrs, Buffer, Metrics, Shaping, SyntaxEditor, ViEditor};
+    use std::sync::Arc;
+
+    pub(crate) fn editor(text: &str) -> ViEditor<'static, 'static> {
+        let system = crate::SYNTAX_SYSTEM.get_or_init(crate::tab_plain::syntax_system);
+        let mut buffer = Buffer::new_empty(Metrics::new(14.0, 20.0));
+        buffer.set_text(text, &Attrs::new(), Shaping::Advanced, None);
+        let theme = system.theme_set.themes.keys().next().unwrap();
+        let mut editor = ViEditor::new(SyntaxEditor::new(Arc::new(buffer), system, theme).unwrap());
+        editor.set_tab_width(4);
+        editor
+    }
+
+    fn block(a: (usize, usize), b: (usize, usize)) -> Block {
+        Block::new(Pos::new(a.0, a.1), Pos::new(b.0, b.1))
+    }
+
+    #[test]
+    fn alt_drag_selects_a_rectangle() {
+        let editor = editor("abcdef\nghijkl\nmnopqr\n");
+        // Dragged from bottom right to top left: the same rectangle
+        let b = block((2, 4), (0, 1));
+        assert_eq!((b.top(), b.bottom(), b.left(), b.right()), (0, 2, 1, 4));
+        assert_eq!(
+            ranges(&editor, &b),
+            vec![(0, Some(1..4)), (1, Some(1..4)), (2, Some(1..4))]
+        );
+    }
+
+    #[test]
+    fn short_lines_are_skipped() {
+        let editor = editor("abcdef\nab\n\tx\nabcdef");
+        let b = block((0, 3), (3, 5));
+        assert_eq!(
+            ranges(&editor, &b),
+            vec![
+                (0, Some(3..5)),
+                // Ends left of the block
+                (1, None),
+                // The tab covers columns 0..4; `x` is at column 4
+                (2, Some(1..2)),
+                (3, Some(3..5)),
+            ]
+        );
+        // A tab partly inside the block starts left of it, so it is not selected
+        assert_eq!(line_range("\tx", 2, 5, 4), Some(1..2));
+        assert_eq!(line_range("\tx", 0, 2, 4), Some(0..1));
+        assert_eq!(width("a\tb", 4), 5);
+        assert_eq!(col_of("a\tb", 2, 4), 4);
+    }
+
+    #[test]
+    fn typing_inserts_on_every_line() {
+        let mut editor = editor("abc\nd\nefg\n");
+        // Zero width: a cursor at column 1 on lines 0..=2
+        let b = insert(&mut editor, &block((0, 1), (2, 1)), "X");
+        assert_eq!(editor_text(&editor), "aXbc\ndX\neXfg\n");
+        assert_eq!(b, block((0, 2), (2, 2)));
+        insert(&mut editor, &b, "Y");
+        assert_eq!(editor_text(&editor), "aXYbc\ndXY\neXYfg\n");
+        // Typing over a block replaces it
+        let b = insert(&mut editor, &block((0, 1), (2, 3)), "-");
+        assert_eq!(editor_text(&editor), "a-bc\nd-\ne-fg\n");
+        assert_eq!(b.left(), 2);
+        assert_eq!(editor.cursor(), Cursor::new(2, 2));
+    }
+
+    #[test]
+    fn backspace_deletes_on_every_line() {
+        let mut editor = editor("abcd\nefgh\nij\n");
+        let b = delete(&mut editor, &block((0, 2), (2, 2)), false);
+        assert_eq!(editor_text(&editor), "acd\negh\ni\n");
+        assert_eq!(b, block((0, 1), (2, 1)));
+        let b = delete(&mut editor, &b, true);
+        assert_eq!(editor_text(&editor), "ad\neh\ni\n");
+        assert_eq!(b, block((0, 1), (2, 1)));
+        // A block with width is removed
+        let b = delete(&mut editor, &block((0, 0), (1, 1)), false);
+        assert_eq!(editor_text(&editor), "d\nh\ni\n");
+        assert!(b.is_empty());
+    }
+
+    #[test]
+    fn copy_joins_lines() {
+        let editor = editor("abcd\ne\nfghi\n");
+        assert_eq!(copy(&editor, &block((0, 1), (2, 3))), "bc\n\ngh");
+    }
+
+    #[test]
+    fn column_paste_below_block_unfolds_target_lines() {
+        let mut editor = editor("a {\n  b\n  c\n}\n");
+        editor.with_buffer_mut(|buffer| {
+            crate::folding::fold(buffer, 0, crate::folding::FoldKind::Brackets)
+        });
+        assert!(editor.with_buffer(|buffer| crate::folding::is_hidden(&buffer.lines[1])));
+        // A zero-width block on the header: the rows go to the folded lines below
+        assert_eq!(
+            paste(&mut editor, &block((0, 0), (0, 0)), "X\nY\nZ\nW"),
+            None
+        );
+        assert_eq!(editor_text(&editor), "Xa {\nY  b\nZ  c\nW}\n");
+        assert!(editor.with_buffer(|buffer| !buffer.lines.iter().any(crate::folding::is_hidden)));
+    }
+
+    #[test]
+    fn paste_block_distributes_lines() {
+        let mut editor = editor("abcd\nefgh\nijkl\nmnop\n");
+        let copied = copy(&editor, &block((0, 0), (1, 1)));
+        assert_eq!(copied, "a\ne");
+        // Several lines go in line by line, even into a single cursor
+        assert_eq!(paste(&mut editor, &block((2, 2), (2, 2)), &copied), None);
+        assert_eq!(editor_text(&editor), "abcd\nefgh\nijakl\nmneop\n");
+        assert_eq!(editor.cursor(), Cursor::new(3, 3));
+        // N lines into an N-line block replace it line by line
+        paste(&mut editor, &block((0, 0), (1, 1)), "1\r\n2");
+        assert_eq!(editor_text(&editor), "1bcd\n2fgh\nijakl\nmneop\n");
+        // One line goes on every line
+        let b = paste(&mut editor, &block((0, 0), (1, 0)), "#");
+        assert_eq!(editor_text(&editor), "#1bcd\n#2fgh\nijakl\nmneop\n");
+        assert_eq!(b, Some(block((0, 1), (1, 1))));
+        // A tab in the pasted text reaches the next tab stop from where it lands
+        let b = paste(&mut editor, &block((0, 2), (1, 2)), "\tX");
+        assert_eq!(b, Some(block((0, 5), (1, 5))));
+    }
+
+    #[test]
+    fn column_copy_pastes_as_block_at_cursor() {
+        let mut editor = editor("abcdef\nghijkl\nmnopqr\n\nstu\nvwx\nyz\n");
+        let copied = copy(&editor, &block((0, 0), (2, 3)));
+        assert_eq!(copied, "abc\nghi\nmno");
+        let mut clipboard = BlockClipboard::default();
+        clipboard.copied(&copied, true);
+        assert!(clipboard.is_block(&copied));
+        // Each row goes in at the cursor's column on the lines below, no line is split
+        editor.set_cursor(Cursor::new(4, 1));
+        paste_block(&mut editor, &copied);
+        assert_eq!(
+            editor_text(&editor),
+            "abcdef\nghijkl\nmnopqr\n\nsabctu\nvghiwx\nymnoz\n"
+        );
+        assert_eq!(editor.cursor(), Cursor::new(6, 4));
+        // One undo step
+        editor.undo();
+        assert_eq!(
+            editor_text(&editor),
+            "abcdef\nghijkl\nmnopqr\n\nstu\nvwx\nyz\n"
+        );
+    }
+
+    #[test]
+    fn block_paste_pads_short_lines() {
+        let mut editor = editor("abcd\nx\nabcd");
+        editor.set_cursor(Cursor::new(0, 3));
+        paste_block(&mut editor, "1\n2\n3\n4");
+        // A short line is padded to the column, rows past the end of the file get new lines
+        assert_eq!(editor_text(&editor), "abc1d\nx  2\nabc3d\n   4");
+        assert_eq!(editor.cursor(), Cursor::new(3, 4));
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abcd\nx\nabcd");
+    }
+
+    #[test]
+    fn normal_copy_still_pastes_normally() {
+        let mut clipboard = BlockClipboard::default();
+        clipboard.copied("abc\nghi", true);
+        // The clipboard may hand it back with CRLF: still the block
+        assert!(clipboard.is_block("abc\r\nghi"));
+        // Something else on the clipboard since: not a block
+        assert!(!clipboard.is_block("other"));
+        // The same text copied as a normal selection: not a block either
+        clipboard.copied("abc\nghi", false);
+        assert!(!clipboard.is_block("abc\nghi"));
+    }
+
+    #[test]
+    fn block_edit_is_one_undo_step() {
+        let mut editor = editor("abc\ndef\nghi\n");
+        let b = insert(&mut editor, &block((0, 1), (2, 1)), "X");
+        delete(&mut editor, &b, false);
+        paste(&mut editor, &block((0, 0), (2, 0)), "1\n2\n3");
+        assert_eq!(editor_text(&editor), "1abc\n2def\n3ghi\n");
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abc\ndef\nghi\n");
+        editor.undo();
+        assert_eq!(editor_text(&editor), "aXbc\ndXef\ngXhi\n");
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abc\ndef\nghi\n");
+    }
+
+    #[test]
+    fn block_paste_lands_at_visual_column_after_tabs() {
+        let mut editor = editor("abcdefg\n\tab\nab\tcd\nx\tyz");
+        editor.set_cursor(Cursor::new(0, 3));
+        paste_block(&mut editor, "1\n2\n3\n4");
+        // Every row starts at column 3; a tab reaching across it becomes spaces first
+        assert_eq!(editor_text(&editor), "abc1defg\n   2 ab\nab 3 cd\nx  4 yz");
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abcdefg\n\tab\nab\tcd\nx\tyz");
+    }
+
+    #[test]
+    fn typing_in_block_with_tabs_lines_up() {
+        let mut editor = editor("abcdef\n\tx\nab\tcd\n");
+        let b = insert(&mut editor, &block((0, 2), (2, 2)), "|");
+        // Inside a tab it is split; at the start of a tab the text goes in before it
+        assert_eq!(editor_text(&editor), "ab|cdef\n  |  x\nab|\tcd\n");
+        assert_eq!(b, block((0, 3), (2, 3)));
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abcdef\n\tx\nab\tcd\n");
+    }
+
+    #[test]
+    fn block_copy_with_tabs_copies_visual_columns() {
+        let editor = editor("abcdefgh\n\tx\nab\tcd\n");
+        // The covered part of a tab cut by an edge is copied as spaces, a whole tab as a tab
+        assert_eq!(copy(&editor, &block((0, 2), (2, 5))), "cde\n  x\n\tc");
+        assert_eq!(copy(&editor, &block((2, 0), (2, 3))), "ab ");
+        // Copying leaves the text alone
+        assert_eq!(editor_text(&editor), "abcdefgh\n\tx\nab\tcd\n");
+    }
+
+    #[test]
+    fn delete_block_across_tab() {
+        let mut editor = editor("abcdefgh\n\tabcd\nab\tcd\n");
+        delete(&mut editor, &block((0, 2), (2, 5)), false);
+        // Columns 2..5 go on every line, what was at column 5 is now at column 2
+        assert_eq!(editor_text(&editor), "abfgh\n  bcd\nabd\n");
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abcdefgh\n\tabcd\nab\tcd\n");
+    }
+
+    #[test]
+    fn extend_starts_at_the_cursor_and_moves_the_head() {
+        let mut editor = editor("a\tb\ncd\nef\n");
+        editor.set_cursor(Cursor::new(0, 2));
+        let b = extend(&mut editor, None, 1, 0);
+        assert_eq!(b, block((0, 4), (1, 4)));
+        let b = extend(&mut editor, Some(b), 5, -9);
+        assert_eq!(b, block((0, 4), (3, 0)));
+        assert_eq!(editor.cursor(), Cursor::new(3, 0));
+    }
+}

new file mode 100644
index 0000000..b2f12f0
--- /dev/null
+++ b/src/tab_pieces.rs
@@ -0,0 +1,335 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Large edits in pieces: cosmic-text inserts and deletes many lines in time with the square of
+//! their number, so Paste, Reload, Replace all and our whole-text rewrites go through these.
+
+use cosmic_text::{AttrsList, Cursor, Edit, LineIter, Selection};
+
+use crate::find_range::Pos;
+
+/// Lines inserted or deleted at a time by [`insert_in_pieces`] and [`delete_in_pieces`].
+pub(crate) const INSERT_LINES: usize = 256;
+
+/// Run `edit` with the lines behind line `line` taken out of the buffer when it is `large`:
+/// cosmic-text moves every line behind an edit for each line it adds or removes. Taking them
+/// out and back costs two moves, too much for each of many small edits.
+fn without_lines_behind<'buffer, E: Edit<'buffer>, T>(
+    editor: &mut E,
+    line: usize,
+    large: bool,
+    edit: impl FnOnce(&mut E) -> T,
+) -> T {
+    if !large {
+        return edit(editor);
+    }
+    let behind = editor.with_buffer_mut(|buffer| {
+        let at = (line + 1).min(buffer.lines.len());
+        buffer.lines.split_off(at)
+    });
+    let result = edit(editor);
+    editor.with_buffer_mut(|buffer| buffer.lines.extend(behind));
+    result
+}
+
+/// Insert `text` at `cursor` like `insert_at`, in pieces of [`INSERT_LINES`] lines. cosmic-text
+/// puts the lines of one insert in place one by one at the same index, which takes time with
+/// the square of their number: 90 s for a 1.3 MB file. The pieces are one undo step with the
+/// change around them, and undo puts them back in pieces too. The cursor after the text.
+pub fn insert_in_pieces<'buffer, E: Edit<'buffer>>(
+    editor: &mut E,
+    cursor: Cursor,
+    text: &str,
+) -> Cursor {
+    // Every piece takes the attributes at `cursor`, as one insert would
+    let attrs = editor.with_buffer(|buffer| {
+        buffer
+            .lines
+            .get(cursor.line)
+            .map(|line| AttrsList::new(&line.attrs_list().get_span(cursor.index.saturating_sub(1))))
+    });
+    let large = LineIter::new(text).nth(INSERT_LINES).is_some();
+    without_lines_behind(editor, cursor.line, large, |editor| {
+        let mut cursor = cursor;
+        let mut rest = text;
+        while !rest.is_empty() {
+            // Cut after a line ending as cosmic-text reads them: CR LF and LF CR stay in one piece
+            let cut = LineIter::new(rest)
+                .nth(INSERT_LINES - 1)
+                .map_or(rest.len(), |(line, ending)| {
+                    line.end + ending.as_str().len()
+                });
+            cursor = editor.insert_at(cursor, &rest[..cut], attrs.clone());
+            rest = &rest[cut..];
+        }
+        cursor
+    })
+}
+
+/// Delete `start..end` like `delete_range`, in pieces of [`INSERT_LINES`] lines from the bottom
+/// up: cosmic-text collects the deleted lines at the front of a list, which takes time with the
+/// square of their number, and undo would put them back in one insert.
+pub fn delete_in_pieces<'buffer, E: Edit<'buffer>>(editor: &mut E, start: Cursor, end: Cursor) {
+    let large = end.line > start.line + INSERT_LINES;
+    without_lines_behind(editor, end.line, large, |editor| {
+        let mut end = end;
+        while end.line > start.line + INSERT_LINES {
+            let from = Cursor::new(end.line - INSERT_LINES, 0);
+            editor.delete_range(from, end);
+            end = from;
+        }
+        editor.delete_range(start, end);
+    })
+}
+
+/// `insert_string` in pieces (see [`insert_in_pieces`]): replace the selection with `text`,
+/// the cursor after it. What Paste does.
+pub fn insert_string_in_pieces<'buffer, E: Edit<'buffer>>(editor: &mut E, text: &str) {
+    if let Some((start, end)) = editor.selection_bounds() {
+        editor.set_selection(Selection::None);
+        delete_in_pieces(editor, start, end);
+        editor.set_cursor(start);
+    }
+    let cursor = insert_in_pieces(editor, editor.cursor(), text);
+    editor.set_cursor(cursor);
+}
+
+/// How many lines cosmic-text may move per line of the edited span before [`apply_edits`]
+/// rewrites the span in one go instead: moving a line is cheaper than writing it anew.
+const REWRITE_MOVES_PER_LINE: usize = 16;
+
+/// Make the edits `edits` (each: the start and end of the replaced text and the text put
+/// there; in order, not overlapping), within the caller's change. One by one from the last back,
+/// unless that moves too many lines: cosmic-text moves every line behind an edit that adds or
+/// removes line breaks, which took minutes for 50,000 of them in a 5 MB file. Then the lines
+/// from the first edit to the last are rewritten with all edits made, deleted and inserted in
+/// pieces (see [`insert_in_pieces`]), keeping each line's own ending.
+pub(crate) fn apply_edits<'buffer, E: Edit<'buffer>>(editor: &mut E, edits: &[(Pos, Pos, &str)]) {
+    let (Some(&(first, _, _)), Some(&(_, last, _))) = (edits.first(), edits.last()) else {
+        return;
+    };
+    let total = editor.with_buffer(|buffer| buffer.lines.len());
+    let moves: usize = edits
+        .iter()
+        .filter(|(start, end, text)| start.0 != end.0 || text.contains(['\n', '\r']))
+        .map(|(_, end, _)| total.saturating_sub(end.0))
+        .sum();
+    if moves <= REWRITE_MOVES_PER_LINE * (last.0 - first.0 + 1) {
+        for &(start, end, text) in edits.iter().rev() {
+            let start = Cursor::new(start.0, start.1);
+            editor.delete_range(start, Cursor::new(end.0, end.1));
+            editor.insert_at(start, text, None);
+        }
+        return;
+    }
+    let start = Cursor::new(first.0, 0);
+    let (end, text) = editor.with_buffer(|buffer| {
+        // The span's text, its last line without its ending, and where each line starts in it
+        let mut old = String::new();
+        let mut starts = Vec::with_capacity(last.0 - first.0 + 1);
+        for (line, buffer_line) in buffer.lines[first.0..=last.0].iter().enumerate() {
+            starts.push(old.len());
+            old.push_str(buffer_line.text());
+            if first.0 + line < last.0 {
+                old.push_str(buffer_line.ending().as_str());
+            }
+        }
+        let offset = |pos: Pos| starts[pos.0 - first.0] + pos.1;
+        let mut text = String::with_capacity(old.len());
+        let mut done = 0;
+        for &(start, end, replace) in edits {
+            text.push_str(&old[done..offset(start)]);
+            text.push_str(replace);
+            done = offset(end);
+        }
+        text.push_str(&old[done..]);
+        let end = Cursor::new(last.0, buffer.lines[last.0].text().len());
+        (end, text)
+    });
+    delete_in_pieces(editor, start, end);
+    insert_in_pieces(editor, start, &text);
+}
+
+#[cfg(test)]
+pub(crate) mod tests {
+    use cosmic_text::Edit;
+
+    /// An editor that counts the lines cosmic-text moves to insert and delete lines: each line
+    /// of an insert goes in at the same index and moves all lines behind it, each deleted line
+    /// moves them back.
+    pub(crate) struct Counted<'a> {
+        pub editor: &'a mut cosmic_text::ViEditor<'static, 'static>,
+        pub moved: usize,
+    }
+
+    impl<'a> Edit<'static> for Counted<'a> {
+        fn buffer_ref(&self) -> &cosmic_text::BufferRef<'static> {
+            self.editor.buffer_ref()
+        }
+        fn buffer_ref_mut(&mut self) -> &mut cosmic_text::BufferRef<'static> {
+            self.editor.buffer_ref_mut()
+        }
+        fn cursor(&self) -> cosmic_text::Cursor {
+            self.editor.cursor()
+        }
+        fn set_cursor(&mut self, cursor: cosmic_text::Cursor) {
+            self.editor.set_cursor(cursor)
+        }
+        fn selection(&self) -> cosmic_text::Selection {
+            self.editor.selection()
+        }
+        fn set_selection(&mut self, selection: cosmic_text::Selection) {
+            self.editor.set_selection(selection)
+        }
+        fn auto_indent(&self) -> bool {
+            self.editor.auto_indent()
+        }
+        fn set_auto_indent(&mut self, auto_indent: bool) {
+            self.editor.set_auto_indent(auto_indent)
+        }
+        fn tab_width(&self) -> u16 {
+            self.editor.tab_width()
+        }
+        fn set_tab_width(&mut self, tab_width: u16) {
+            self.editor.set_tab_width(tab_width)
+        }
+        fn shape_as_needed(&mut self, font_system: &mut cosmic_text::FontSystem, prune: bool) {
+            self.editor.shape_as_needed(font_system, prune)
+        }
+        fn delete_range(&mut self, start: cosmic_text::Cursor, end: cosmic_text::Cursor) {
+            // Each removed line moves the lines behind it, and goes in at the front of a list
+            let after = self
+                .editor
+                .with_buffer(|buffer| buffer.lines.len().saturating_sub(end.line + 1));
+            let lines = end.line - start.line;
+            self.moved += lines * after + lines * (lines + 1) / 2;
+            self.editor.delete_range(start, end)
+        }
+        fn insert_at(
+            &mut self,
+            cursor: cosmic_text::Cursor,
+            data: &str,
+            attrs_list: Option<cosmic_text::AttrsList>,
+        ) -> cosmic_text::Cursor {
+            let after = self
+                .editor
+                .with_buffer(|buffer| buffer.lines.len().saturating_sub(cursor.line + 1));
+            let lines = data.matches('\n').count();
+            self.moved += lines * after + lines * lines.saturating_sub(1) / 2;
+            self.editor.insert_at(cursor, data, attrs_list)
+        }
+        fn copy_selection(&self) -> Option<String> {
+            self.editor.copy_selection()
+        }
+        fn delete_selection(&mut self) -> bool {
+            self.editor.delete_selection()
+        }
+        fn apply_change(&mut self, change: &cosmic_text::Change) -> bool {
+            self.editor.apply_change(change)
+        }
+        fn start_change(&mut self) {
+            self.editor.start_change()
+        }
+        fn finish_change(&mut self) -> Option<cosmic_text::Change> {
+            self.editor.finish_change()
+        }
+        fn action(
+            &mut self,
+            font_system: &mut cosmic_text::FontSystem,
+            action: cosmic_text::Action,
+        ) {
+            self.editor.action(font_system, action)
+        }
+        fn cursor_position(&self) -> Option<(i32, i32)> {
+            self.editor.cursor_position()
+        }
+    }
+
+    /// 2 MB, 25,000 lines with Windows line endings.
+    fn large_text() -> String {
+        format!("{}\r\n", "x".repeat(78)).repeat(25_000)
+    }
+
+    #[test]
+    fn large_paste_goes_in_pieces_as_one_undo_step() {
+        // Lines behind the paste: without taking them out, each pasted line would move them
+        let behind = "y\r\n".repeat(2_000);
+        let mut editor =
+            crate::column_select::tests::editor(&format!("head\r\nold tail\r\n{behind}"));
+        // "old" selected: the paste replaces it
+        editor.set_selection(cosmic_text::Selection::Normal(cosmic_text::Cursor::new(
+            1, 0,
+        )));
+        editor.set_cursor(cosmic_text::Cursor::new(1, 3));
+        let before = crate::tab::editor_text(&editor);
+        let value = large_text();
+        let mut counted = Counted {
+            editor: &mut editor,
+            moved: 0,
+        };
+        counted.start_change();
+        super::insert_string_in_pieces(&mut counted, &value);
+        counted.finish_change();
+        let moved = counted.moved;
+        eprintln!("paste of {} bytes: {moved} lines moved", value.len());
+        assert_eq!(
+            crate::tab::editor_text(&editor),
+            format!("head\r\n{value} tail\r\n{behind}")
+        );
+        assert_eq!(editor.cursor(), cosmic_text::Cursor::new(25_001, 0));
+        assert_eq!(editor.selection(), cosmic_text::Selection::None);
+        // Linear: at most a piece's worth of lines moved per line pasted
+        assert!(moved <= 25_000 * super::INSERT_LINES, "{moved} lines moved");
+        editor.undo();
+        assert_eq!(crate::tab::editor_text(&editor), before);
+        editor.redo();
+        assert_eq!(
+            crate::tab::editor_text(&editor),
+            format!("head\r\n{value} tail\r\n{behind}")
+        );
+    }
+
+    #[test]
+    fn paste_over_a_large_selection_goes_in_pieces() {
+        let old = large_text();
+        let mut editor = crate::column_select::tests::editor(&old);
+        editor.set_selection(cosmic_text::Selection::Normal(cosmic_text::Cursor::new(
+            0, 0,
+        )));
+        editor.set_cursor(cosmic_text::Cursor::new(25_000, 0));
+        let value = old.replace('x', "z");
+        let mut counted = Counted {
+            editor: &mut editor,
+            moved: 0,
+        };
+        counted.start_change();
+        super::insert_string_in_pieces(&mut counted, &value);
+        counted.finish_change();
+        let moved = counted.moved;
+        eprintln!("paste over {} bytes: {moved} lines moved", old.len());
+        assert_eq!(crate::tab::editor_text(&editor), value);
+        assert_eq!(editor.cursor(), cosmic_text::Cursor::new(25_000, 0));
+        assert!(
+            moved <= 2 * 25_000 * super::INSERT_LINES,
+            "{moved} lines moved"
+        );
+        editor.undo();
+        assert_eq!(crate::tab::editor_text(&editor), old);
+    }
+
+    #[test]
+    fn pieces_keep_lf_cr_and_cr_line_endings() {
+        for ending in ["\n\r", "\r"] {
+            let value = format!("line{ending}").repeat(1000);
+            let mut editor = crate::column_select::tests::editor("");
+            editor.start_change();
+            super::insert_string_in_pieces(&mut editor, &value);
+            editor.finish_change();
+            assert_eq!(crate::tab::editor_text(&editor), value, "{ending:?}");
+            assert_eq!(
+                editor.cursor(),
+                cosmic_text::Cursor::new(1000, 0),
+                "{ending:?}"
+            );
+        }
+    }
+}

+        // Delete at the end of the header
+        editor.with_buffer_mut(|buffer| fold(buffer, 0, FoldKind::Brackets));
+        editor.set_cursor(cosmic_text::Cursor::new(0, "fn main() {".len()));
+        assert!(reveal_join(&mut editor, true, false));
+        assert_eq!(hidden(&editor), Vec::<usize>::new());
+    }
+
+    #[test]
+    fn undo_unfolds_restored_lines() {
+        let mut editor = editor(RUST, "rs");
+        // Delete a line inside the block, fold it, undo: the line comes back visible
+        editor.start_change();
+        editor.delete_range(
+            cosmic_text::Cursor::new(2, 0),
+            cosmic_text::Cursor::new(3, 0),
+        );
+        editor.finish_change();
+        editor.with_buffer_mut(|buffer| fold(buffer, 0, FoldKind::Brackets));
+        assert_eq!(hidden(&editor), vec![1, 2]);
+        editor.undo();
+        let line = editor.cursor().line;
+        editor.with_buffer_mut(|buffer| reconcile(buffer, FoldKind::Brackets, line));
+        assert_eq!(hidden(&editor), Vec::<usize>::new());
+        assert_eq!(text(&editor), RUST);
+        // Redo deletes it again, and nothing is left folded
+        editor.redo();
+        let line = editor.cursor().line;
+        editor.with_buffer_mut(|buffer| reconcile(buffer, FoldKind::Brackets, line));
+        assert_eq!(hidden(&editor), Vec::<usize>::new());
+    }
+
+    #[test]
+    fn own_save_keeps_folds() {
+        let dir = std::env::temp_dir().join(format!("folding-own-save-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("main.rs");
+        std::fs::write(&path, RUST).unwrap();
+        let mut config = crate::Config::default();
+        let system = crate::SYNTAX_SYSTEM.get_or_init(crate::tab_plain::syntax_system);
+        let theme = system.theme_set.themes.keys().next().unwrap();
+        config.syntax_theme_dark = theme.clone();
+        config.syntax_theme_light = theme.clone();
+        let mut tab = crate::tab::EditorTab::new(&config);
+        tab.open(path.clone());
+        let folded = |tab: &crate::tab::EditorTab| {
+            tab.editor
+                .lock()
+                .unwrap()
+                .with_buffer(|buffer| is_fold_header(buffer, 0))
+        };
+        tab.editor
+            .lock()
+            .unwrap()
+            .with_buffer_mut(|buffer| fold(buffer, 0, FoldKind::Brackets));
+        // The file watcher reloads after every own save: the text is the same, the fold stays
+        tab.save();
+        tab.reload();
+        assert!(folded(&tab));
+        // A change from outside drops it
+        std::fs::write(&path, format!("// new\n{RUST}")).unwrap();
+        tab.reload();
+        assert!(!folded(&tab));
+        assert!(
+            tab.editor
+                .lock()
+                .unwrap()
+                .with_buffer(|buffer| !buffer.lines.iter().any(is_hidden))
+        );
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn save_with_folds_writes_hidden_text() {
+        let dir = std::env::temp_dir().join(format!("folding-save-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("main.rs");
+        std::fs::write(&path, RUST).unwrap();
+        let mut config = crate::Config::default();
+        let system = crate::SYNTAX_SYSTEM.get_or_init(crate::tab_plain::syntax_system);
+        let theme = system.theme_set.themes.keys().next().unwrap();
+        config.syntax_theme_dark = theme.clone();
+        config.syntax_theme_light = theme.clone();
+        let mut tab = crate::tab::EditorTab::new(&config);
+        tab.open(path.clone());
+        {
+            let mut editor = tab.editor.lock().unwrap();
+            editor.set_cursor(cosmic_text::Cursor::new(6, 0));
+            editor.insert_string("// end\n", None);
+            editor.with_buffer_mut(|buffer| fold_all(buffer, FoldKind::Brackets));
+            assert!(editor.with_buffer(|buffer| is_hidden(&buffer.lines[2])));
+            // The session draft takes the same full text
+            assert_eq!(crate::tab::editor_text(&editor), format!("{RUST}// end\n"));
+        }
+        tab.save();
+        assert_eq!(
+            std::fs::read_to_string(&path).unwrap(),
+            format!("{RUST}// end\n")
+        );
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn folds_restore_by_header_text() {
+        let text = "a {\n  b\n}\nc {\n  d\n}\n";
+        let mut folded = editor(text, "rs");
+        folded.with_buffer_mut(|buffer| fold_all(buffer, FoldKind::Brackets));
+        let saved = folded.with_buffer(saved_folds);
+        assert_eq!(saved, vec![(0, "a {".to_string()), (3, "c {".to_string())]);
+
+        let mut restored = editor(text, "rs");
+        restored.with_buffer_mut(|buffer| restore_folds(buffer, &saved, FoldKind::Brackets));
+        assert_eq!(restored.with_buffer(saved_folds), saved);
+        assert!(restored.with_buffer(|buffer| is_hidden(&buffer.lines[4])));
+
+        // The first header changed on disk: only the second fold comes back
+        let mut changed = editor("x {\n  b\n}\nc {\n  d\n}\n", "rs");
+        changed.with_buffer_mut(|buffer| restore_folds(buffer, &saved, FoldKind::Brackets));
+        assert_eq!(
+            changed.with_buffer(saved_folds),
+            vec![(3, "c {".to_string())]
+        );
+        assert!(!changed.with_buffer(|buffer| is_hidden(&buffer.lines[1])));
+    }
+}

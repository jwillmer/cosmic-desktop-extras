+++ b/src/whitespace.rs
@@ -0,0 +1,516 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Show whitespace and line endings (like Notepad++ "Show symbol"), and the line ending of a
+//! file with its conversion. The markers are overlays computed from the laid out glyphs: they
+//! never change the text, the layout or the cursor positions.
+
+use cosmic_text::{Buffer, BufferLine, Cursor, Edit, LayoutRun, LineEnding};
+use std::cell::Cell;
+
+/// What a marker stands for.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum MarkerKind {
+    Space,
+    Tab,
+    LineEnd(LineEnding),
+}
+
+/// A marker to draw over one visible character (or after the end of a line), in buffer
+/// coordinates: `x` and `w` along the visual row, `line_top` the top of that row.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Marker {
+    pub kind: MarkerKind,
+    pub x: f32,
+    pub w: f32,
+    pub line_top: f32,
+    /// Whitespace after the last other character of its line
+    pub trailing: bool,
+}
+
+/// The markers of one visible row. `line_ending` is the ending of the row's line; it is only
+/// shown after the last row of that line.
+fn run_markers(
+    run: &LayoutRun,
+    show_whitespace: bool,
+    line_ending: Option<LineEnding>,
+    out: &mut Vec<Marker>,
+) {
+    let text = run.text;
+    if show_whitespace {
+        let trailing_from = text.trim_end_matches([' ', '\t']).len();
+        for glyph in run.glyphs {
+            let kind = match text.get(glyph.start..glyph.end) {
+                Some(" ") => MarkerKind::Space,
+                Some("\t") => MarkerKind::Tab,
+                _ => continue,
+            };
+            out.push(Marker {
+                kind,
+                x: glyph.x,
+                w: glyph.w,
+                line_top: run.line_top,
+                trailing: glyph.start >= trailing_from,
+            });
+        }
+    }
+    if let Some(ending) = line_ending {
+        // The row that holds the end of the line text (an empty line has no glyphs)
+        let ends_line = run.glyphs.iter().map(|g| g.end).max().unwrap_or(0) >= text.len();
+        if ending != LineEnding::None && ends_line {
+            let x = if run.rtl { 0.0 } else { run.line_w };
+            out.push(Marker {
+                kind: MarkerKind::LineEnd(ending),
+                x,
+                w: 0.0,
+                line_top: run.line_top,
+                trailing: false,
+            });
+        }
+    }
+}
+
+/// The markers of the visible rows of `buffer`. Nothing is scanned when both are off.
+pub fn visible_markers(
+    buffer: &Buffer,
+    show_whitespace: bool,
+    show_line_endings: bool,
+) -> Vec<Marker> {
+    let mut markers = Vec::new();
+    if !show_whitespace && !show_line_endings {
+        return markers;
+    }
+    for run in buffer.layout_runs() {
+        if crate::folding::is_folded_run(&run) {
+            continue;
+        }
+        let ending = show_line_endings
+            .then(|| buffer.lines.get(run.line_i).map(BufferLine::ending))
+            .flatten();
+        run_markers(&run, show_whitespace, ending, &mut markers);
+    }
+    markers
+}
+
+/// The line endings used in a file.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FileEndings {
+    /// No line has an ending (a single line)
+    None,
+    One(LineEnding),
+    Mixed,
+}
+
+impl FileEndings {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::None => "-",
+            Self::One(ending) => ending_label(ending),
+            Self::Mixed => "Mixed",
+        }
+    }
+}
+
+pub fn ending_label(ending: LineEnding) -> &'static str {
+    match ending {
+        LineEnding::Lf => "LF",
+        LineEnding::CrLf => "CRLF",
+        LineEnding::Cr => "CR",
+        LineEnding::LfCr => "LFCR",
+        LineEnding::None => "-",
+    }
+}
+
+/// How many lines end with each kind of line ending; a line without one does not count.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct EndingCounts {
+    pub lf: usize,
+    pub crlf: usize,
+    pub cr: usize,
+    pub lfcr: usize,
+}
+
+impl EndingCounts {
+    pub fn of(lines: &[BufferLine]) -> Self {
+        let mut counts = Self::default();
+        for line in lines {
+            match line.ending() {
+                LineEnding::Lf => counts.lf += 1,
+                LineEnding::CrLf => counts.crlf += 1,
+                LineEnding::Cr => counts.cr += 1,
+                LineEnding::LfCr => counts.lfcr += 1,
+                LineEnding::None => {}
+            }
+        }
+        counts
+    }
+
+    /// The kinds that occur, with their counts, always in the order LF, CRLF, CR, LFCR.
+    pub fn present(self) -> impl Iterator<Item = (LineEnding, usize)> {
+        [
+            (LineEnding::Lf, self.lf),
+            (LineEnding::CrLf, self.crlf),
+            (LineEnding::Cr, self.cr),
+            (LineEnding::LfCr, self.lfcr),
+        ]
+        .into_iter()
+        .filter(|(_, count)| *count > 0)
+    }
+
+    pub fn endings(self) -> FileEndings {
+        let mut present = self.present();
+        match (present.next(), present.next()) {
+            (None, _) => FileEndings::None,
+            (Some((ending, _)), None) => FileEndings::One(ending),
+            (Some(_), Some(_)) => FileEndings::Mixed,
+        }
+    }
+}
+
+/// The line endings of `lines`; the last line usually has none and does not count.
+#[cfg(test)]
+pub fn file_endings(lines: &[BufferLine]) -> FileEndings {
+    EndingCounts::of(lines).endings()
+}
+
+/// The ending a new line gets in a file with `endings`: the file's own, the first line's when
+/// mixed, LF when there is none yet.
+pub fn new_line_ending(endings: FileEndings, lines: &[BufferLine]) -> LineEnding {
+    match endings {
+        FileEndings::One(ending) => ending,
+        FileEndings::Mixed => lines
+            .iter()
+            .map(BufferLine::ending)
+            .find(|ending| *ending != LineEnding::None)
+            .unwrap_or_default(),
+        FileEndings::None => LineEnding::default(),
+    }
+}
+
+/// The detected line endings of one tab, kept until the text may have changed them. Scanning
+/// is linear in the file, and the menu asks on every redraw. The line count is part of the key:
+/// adding or joining lines changes it; `clear` covers the rest (open, reload, undo, convert).
+#[derive(Debug, Default)]
+pub struct EndingsCache {
+    cached: Cell<Option<(usize, EndingCounts)>>,
+    scans: Cell<usize>,
+}
+
+impl EndingsCache {
+    pub fn get(&self, lines: &[BufferLine]) -> FileEndings {
+        self.counts(lines).endings()
+    }
+
+    /// How many lines end with each kind, for the line ending menu of a mixed file.
+    pub fn counts(&self, lines: &[BufferLine]) -> EndingCounts {
+        if let Some((len, counts)) = self.cached.get()
+            && len == lines.len()
+        {
+            return counts;
+        }
+        let counts = EndingCounts::of(lines);
+        self.scans.set(self.scans.get() + 1);
+        self.cached.set(Some((lines.len(), counts)));
+        counts
+    }
+
+    pub fn clear(&self) {
+        self.cached.set(None);
+    }
+}
+
+/// Enter with the new line ending `ending` instead of LF, as one undo step, keeping the
+/// indentation of the line like `Action::Enter` does with automatic indentation.
+pub fn insert_new_line<'buffer, E: Edit<'buffer>>(editor: &mut E, ending: LineEnding) {
+    let mut text = String::from(ending.as_str());
+    if editor.auto_indent() {
+        let line = editor.cursor().line;
+        editor.with_buffer(|buffer| {
+            if let Some(line) = buffer.lines.get(line) {
+                text.extend(line.text().chars().take_while(|c| c.is_whitespace()));
+            }
+        });
+    }
+    editor.start_change();
+    editor.insert_string(&text, None);
+    editor.finish_change();
+    editor.set_redraw(true);
+}
+
+/// Give every line that has an ending the ending `target`, as one undo step. The text itself
+/// does not change; the cursor stays on its line and column. Returns false when nothing had
+/// to change.
+pub fn convert_line_endings<'buffer, E: Edit<'buffer>>(editor: &mut E, target: LineEnding) -> bool {
+    let converted = editor.with_buffer(|buffer| {
+        if !buffer
+            .lines
+            .iter()
+            .any(|line| line.ending() != LineEnding::None && line.ending() != target)
+        {
+            return None;
+        }
+        let mut text = String::new();
+        for line in &buffer.lines {
+            text.push_str(line.text());
+            if line.ending() != LineEnding::None {
+                text.push_str(target.as_str());
+            }
+        }
+        let last = buffer.lines.len().saturating_sub(1);
+        let end = Cursor::new(last, buffer.lines.get(last).map_or(0, |l| l.text().len()));
+        Some((text, end))
+    });
+    let Some((text, end)) = converted else {
+        return false;
+    };
+    let cursor = editor.cursor();
+    // Replacing the whole text in one change keeps it one undo step and linear in the size of
+    // the file (removing line endings one by one shifts every following line each time); in
+    // pieces, as cosmic-text takes time with the square of the lines of one edit.
+    editor.start_change();
+    crate::tab::delete_in_pieces(editor, Cursor::new(0, 0), end);
+    crate::tab::insert_in_pieces(editor, Cursor::new(0, 0), &text);
+    editor.finish_change();
+    editor.set_cursor(cursor);
+    editor.set_redraw(true);
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::tab::editor_text;
+    use cosmic_text::{
+        Attrs, Buffer, FontSystem, Metrics, Shaping, SyntaxEditor, SyntaxSystem, ViEditor,
+    };
+    use std::sync::{Arc, Mutex, OnceLock};
+
+    fn font_system() -> &'static Mutex<FontSystem> {
+        static FONT_SYSTEM: OnceLock<Mutex<FontSystem>> = OnceLock::new();
+        FONT_SYSTEM.get_or_init(|| Mutex::new(FontSystem::new()))
+    }
+
+    fn shaped(text: &str) -> Buffer {
+        let mut font_system = font_system().lock().unwrap();
+        let mut buffer = Buffer::new(&mut font_system, Metrics::new(14.0, 20.0));
+        buffer.set_size(Some(800.0), Some(400.0));
+        buffer.set_text(
+            text,
+            &Attrs::new().family(cosmic_text::Family::Monospace),
+            Shaping::Advanced,
+            None,
+        );
+        buffer.shape_until_scroll(&mut font_system, false);
+        buffer
+    }
+
+    fn glyph_xs(buffer: &Buffer) -> Vec<(usize, usize, f32)> {
+        buffer
+            .layout_runs()
+            .flat_map(|run| run.glyphs.iter().map(move |g| (run.line_i, g.start, g.x)))
+            .collect()
+    }
+
+    fn editor(text: &str) -> ViEditor<'static, 'static> {
+        let system = crate::SYNTAX_SYSTEM.get_or_init(SyntaxSystem::new);
+        let mut buffer = Buffer::new_empty(Metrics::new(14.0, 20.0));
+        buffer.set_text(text, &Attrs::new(), Shaping::Advanced, None);
+        let theme = system.theme_set.themes.keys().next().unwrap();
+        ViEditor::new(SyntaxEditor::new(Arc::new(buffer), system, theme).unwrap())
+    }
+
+    fn lines(text: &str) -> Vec<BufferLine> {
+        let mut buffer = Buffer::new_empty(Metrics::new(14.0, 20.0));
+        buffer.set_text(text, &Attrs::new(), Shaping::Advanced, None);
+        buffer.lines
+    }
+
+    #[test]
+    fn spaces_and_tabs_get_markers_without_moving_text() {
+        let text = "a b\tc  \nx";
+        let buffer = shaped(text);
+        let before = glyph_xs(&buffer);
+        let markers = visible_markers(&buffer, true, false);
+
+        // The buffer and its layout are untouched
+        assert_eq!(editor_text_of(&buffer), text);
+        assert_eq!(glyph_xs(&buffer), before);
+
+        let kinds: Vec<_> = markers.iter().map(|m| (m.kind, m.trailing)).collect();
+        assert_eq!(
+            kinds,
+            vec![
+                (MarkerKind::Space, false),
+                (MarkerKind::Tab, false),
+                (MarkerKind::Space, true),
+                (MarkerKind::Space, true),
+            ]
+        );
+        // Each marker sits exactly on its character
+        let run = buffer.layout_runs().next().unwrap();
+        let at = |start: usize| run.glyphs.iter().find(|g| g.start == start).unwrap();
+        assert_eq!((markers[0].x, markers[0].w), (at(1).x, at(1).w));
+        assert_eq!((markers[1].x, markers[1].w), (at(3).x, at(3).w));
+        // The tab spans the tab stop, wider than a space
+        assert!(markers[1].w > markers[0].w);
+    }
+
+    fn editor_text_of(buffer: &Buffer) -> String {
+        buffer
+            .lines
+            .iter()
+            .map(|l| format!("{}{}", l.text(), l.ending().as_str()))
+            .collect()
+    }
+
+    #[test]
+    fn line_end_markers_follow_each_line() {
+        let buffer = shaped("ab\r\n\ncd");
+        let ends: Vec<_> = visible_markers(&buffer, false, true)
+            .iter()
+            .map(|m| m.kind)
+            .collect();
+        assert_eq!(
+            ends,
+            vec![
+                MarkerKind::LineEnd(LineEnding::CrLf),
+                MarkerKind::LineEnd(LineEnding::Lf),
+            ]
+        );
+    }
+
+    #[test]
+    fn markers_off_draws_nothing() {
+        let buffer = shaped("a b\tc \r\nd\n");
+        assert!(visible_markers(&buffer, false, false).is_empty());
+        assert!(!visible_markers(&buffer, true, true).is_empty());
+    }
+
+    #[test]
+    fn line_ending_detection_lf_crlf_mixed() {
+        assert_eq!(
+            file_endings(&lines("a\nb\n")),
+            FileEndings::One(LineEnding::Lf)
+        );
+        assert_eq!(
+            file_endings(&lines("a\r\nb\r\n")),
+            FileEndings::One(LineEnding::CrLf)
+        );
+        assert_eq!(file_endings(&lines("a\r\nb\nc")), FileEndings::Mixed);
+        assert_eq!(file_endings(&lines("single")), FileEndings::None);
+        assert_eq!(file_endings(&lines("a\rb\r")), FileEndings::One(LineEnding::Cr));
+        assert_eq!(FileEndings::Mixed.label(), "Mixed");
+        assert_eq!(FileEndings::One(LineEnding::CrLf).label(), "CRLF");
+    }
+
+    #[test]
+    fn convert_to_lf_is_one_undo_step() {
+        let mut editor = editor("a\r\nb\nc\r\n");
+        editor.set_cursor(Cursor::new(1, 1));
+        assert!(convert_line_endings(&mut editor, LineEnding::Lf));
+        assert_eq!(editor_text(&editor), "a\nb\nc\n");
+        assert_eq!(editor.cursor(), Cursor::new(1, 1));
+        assert!(editor.changed());
+        // Nothing left to convert
+        assert!(!convert_line_endings(&mut editor, LineEnding::Lf));
+
+        editor.undo();
+        assert_eq!(editor_text(&editor), "a\r\nb\nc\r\n");
+        editor.redo();
+        assert_eq!(editor_text(&editor), "a\nb\nc\n");
+
+        assert!(convert_line_endings(&mut editor, LineEnding::CrLf));
+        assert_eq!(editor_text(&editor), "a\r\nb\r\nc\r\n");
+    }
+
+    #[test]
+    fn enter_in_crlf_file_inserts_crlf() {
+        let mut editor = editor("  one\r\ntwo\r\n");
+        editor.set_auto_indent(true);
+        editor.set_cursor(Cursor::new(0, 5));
+        let ending = editor.with_buffer(|b| new_line_ending(file_endings(&b.lines), &b.lines));
+        assert_eq!(ending, LineEnding::CrLf);
+        insert_new_line(&mut editor, ending);
+        assert_eq!(editor_text(&editor), "  one\r\n  \r\ntwo\r\n");
+        assert_eq!(editor.cursor(), Cursor::new(1, 2));
+        editor.undo();
+        assert_eq!(editor_text(&editor), "  one\r\ntwo\r\n");
+        editor.redo();
+        assert_eq!(editor_text(&editor), "  one\r\n  \r\ntwo\r\n");
+
+        // Mixed takes the first line's ending; no ending yet gives LF
+        let mixed = lines("a\r\nb\nc\n");
+        assert_eq!(
+            new_line_ending(file_endings(&mixed), &mixed),
+            LineEnding::CrLf
+        );
+        let single = lines("a");
+        assert_eq!(
+            new_line_ending(file_endings(&single), &single),
+            LineEnding::Lf
+        );
+    }
+
+    #[test]
+    fn endings_are_not_rescanned_on_redraw() {
+        let mut big = lines(&"line\r\n".repeat(100_000));
+        let cache = EndingsCache::default();
+        for _ in 0..10 {
+            assert_eq!(cache.get(&big), FileEndings::One(LineEnding::CrLf));
+        }
+        assert_eq!(cache.scans.get(), 1);
+
+        // A new line changes the count and is scanned again
+        let mut extra = big[0].clone();
+        extra.set_ending(LineEnding::Lf);
+        big.insert(0, extra);
+        assert_eq!(cache.get(&big), FileEndings::Mixed);
+        assert_eq!(
+            cache.counts(&big),
+            EndingCounts {
+                lf: 1,
+                crlf: 100_000,
+                ..Default::default()
+            }
+        );
+        assert_eq!(cache.scans.get(), 2);
+        cache.clear();
+        cache.get(&big);
+        assert_eq!(cache.scans.get(), 3);
+    }
+
+    #[test]
+    fn crlf_file_saves_as_crlf() {
+        crate::SYNTAX_SYSTEM.get_or_init(SyntaxSystem::new);
+        let dir = std::env::temp_dir().join(format!("whitespace-crlf-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("crlf.txt");
+        std::fs::write(&path, "one\r\ntwo\r\n").unwrap();
+
+        let mut config = crate::Config::default();
+        let theme = crate::SYNTAX_SYSTEM
+            .get()
+            .unwrap()
+            .theme_set
+            .themes
+            .keys()
+            .next()
+            .unwrap();
+        config.syntax_theme_dark = theme.clone();
+        config.syntax_theme_light = theme.clone();
+        let mut tab = crate::tab::EditorTab::new(&config);
+        tab.open(path.clone());
+        {
+            let mut editor = tab.editor.lock().unwrap();
+            editor.set_cursor(Cursor::new(1, 3));
+            editor.insert_string("!", None);
+        }
+        tab.save();
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), "one\r\ntwo!\r\n");
+
+        // Converted to LF, it saves as LF
+        convert_line_endings(&mut *tab.editor.lock().unwrap(), LineEnding::Lf);
+        tab.save();
+        assert_eq!(std::fs::read_to_string(&path).unwrap(), "one\ntwo!\n");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}

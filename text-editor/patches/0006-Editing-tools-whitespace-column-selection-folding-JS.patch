@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! What our features keep per editor tab next to upstream's state (the edit generation for the
+//! status bar, the line endings cache, the disk fingerprint), and the hooks upstream's `open`,
+//! `reload` and `save` call to keep it current.
+
+use cosmic_text::Edit;
+use std::path::Path;
+
+use crate::{disk_change::DiskWatch, tab::EditorTab};
+
+impl EditorTab {
+    /// The text was edited. Returns the generation to hand to `Generations::paused` once
+    /// editing pauses, for the status bar to count the text again.
+    pub fn edited(&mut self) -> u64 {
+        self.generation.edited()
+    }
+
+    /// How many lines end with each kind of line ending (and so the file's line endings), from
+    /// the cache when it is still valid.
+    pub fn ending_counts(&self) -> crate::whitespace::EndingCounts {
+        let editor = self.editor.lock().unwrap();
+        editor.with_buffer(|buffer| self.line_endings.counts(&buffer.lines))
+    }
+
+    /// The ending Enter inserts: the file's own (see `whitespace::new_line_ending`).
+    pub fn new_line_ending(&self) -> cosmic_text::LineEnding {
+        let editor = self.editor.lock().unwrap();
+        editor.with_buffer(|buffer| {
+            let endings = self.line_endings.get(&buffer.lines);
+            crate::whitespace::new_line_ending(endings, &buffer.lines)
+        })
+    }
+
+    /// The text is about to be loaded from the file: the caches of the old text go.
+    pub(crate) fn text_loading(&mut self) {
+        self.line_endings.clear();
+        self.generation.loaded();
+    }
+
+    /// Before Reload reads the file: see `plain_before_reload` and `text_loading`.
+    pub(crate) fn reloading(&mut self) {
+        self.plain_before_reload();
+        self.text_loading();
+    }
+}
+
+impl DiskWatch {
+    /// The file at `path` was opened: take its fingerprint as the one the tab has seen.
+    pub(crate) fn opened(&mut self, path: &Path) {
+        match self.read(path) {
+            Ok(disk) => self.loaded(disk),
+            Err(err) => log::warn!("failed to fingerprint {:?}: {}", path, err),
+        }
+    }
+
+    /// Whether Save may write `path`: never over a change on disk nobody has seen (the bar
+    /// shows first).
+    pub(crate) fn may_save(&mut self, path: &Path) -> bool {
+        match self.read(path) {
+            Ok(disk) if !self.may_write(disk) => {
+                log::warn!(
+                    "not saving {:?}: it changed on disk since it was opened",
+                    path
+                );
+                false
+            }
+            Ok(_) => true,
+            Err(err) => {
+                log::warn!("failed to check {:?} before saving: {}", path, err);
+                true
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use cosmic_text::Edit;
+
+    #[test]
+    fn redo_of_reload_shows_tab_saved() {
+        let dir = std::env::temp_dir().join(format!("tab-reload-redo-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("notes.md");
+        std::fs::write(&path, "one\n").unwrap();
+        let mut config = crate::Config::default();
+        let system = crate::SYNTAX_SYSTEM.get_or_init(crate::tab_plain::syntax_system);
+        let theme = system.theme_set.themes.keys().next().unwrap();
+        config.syntax_theme_dark = theme.clone();
+        config.syntax_theme_light = theme.clone();
+        let mut tab = crate::tab::EditorTab::new(&config);
+        tab.open(path.clone());
+        {
+            let mut editor = tab.editor.lock().unwrap();
+            editor.start_change();
+            editor.insert_string("mine ", None);
+            editor.finish_change();
+        }
+        assert!(tab.changed());
+        // Reload takes the file changed on disk
+        std::fs::write(&path, "theirs\n").unwrap();
+        tab.reload();
+        assert!(!tab.changed());
+        tab.editor.lock().unwrap().undo();
+        assert!(
+            tab.changed(),
+            "undo of the reload brings the unsaved text back"
+        );
+        tab.editor.lock().unwrap().redo();
+        assert!(!tab.changed(), "redo of the reload is the disk text again");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}

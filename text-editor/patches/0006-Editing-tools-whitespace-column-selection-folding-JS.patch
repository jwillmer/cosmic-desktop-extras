new file mode 100644
index 0000000..6d8a878
--- /dev/null
+++ b/src/tab_file.rs
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Copy file path and Open containing folder in the tab's right-click menu. Both act on the tab
+//! the menu was opened on and are disabled for a tab without a file.
+//!
+//! Open containing folder asks the file manager to show the file selected
+//! (`org.freedesktop.FileManager1.ShowItems` over D-Bus). Without an answer it opens the folder
+//! with the default app instead.
+
+use cosmic::{app::Task, iced::clipboard, widget::segmented_button::Entity};
+use std::path::{Path, PathBuf};
+
+use crate::{App, Message as AppMessage, tab::Tab};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Message {
+    /// Copy the tab bar menu's tab's file path to the clipboard.
+    CopyPath,
+    /// Show the tab bar menu's tab's file in the file manager.
+    OpenFolder,
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::TabFile(message)
+    }
+}
+
+/// The text Copy file path puts on the clipboard; `None` for a tab without a file.
+pub fn path_text(path: Option<&Path>) -> Option<String> {
+    path.map(|path| path.to_string_lossy().into_owned())
+}
+
+/// The folder Open containing folder opens; `None` for a tab without a file.
+pub fn containing_folder(path: Option<&Path>) -> Option<PathBuf> {
+    path?.parent().map(Path::to_path_buf)
+}
+
+/// A `file://` URI for an absolute path, percent-encoding every byte but the unreserved ones and
+/// `/` (RFC 8089 and RFC 3986).
+pub fn file_uri(path: &Path) -> String {
+    use std::os::unix::ffi::OsStrExt;
+
+    let mut uri = String::from("file://");
+    for &byte in path.as_os_str().as_bytes() {
+        if byte.is_ascii_alphanumeric() || b"-._~/".contains(&byte) {
+            uri.push(byte as char);
+        } else {
+            uri.push_str(&format!("%{byte:02X}"));
+        }
+    }
+    uri
+}
+
+impl App {
+    /// The file of `tab`, if it is an editor tab with one.
+    pub fn tab_file_path(&self, tab: Entity) -> Option<&Path> {
+        match self.tab_model.data::<Tab>(tab) {
+            Some(Tab::Editor(tab)) => tab.path_opt.as_deref(),
+            _ => None,
+        }
+    }
+
+    pub fn update_tab_file(&mut self, message: Message) -> Task<AppMessage> {
+        let tab = self
+            .tab_bar_context
+            .take()
+            .unwrap_or_else(|| self.tab_model.active());
+        let path = self.tab_file_path(tab);
+        match message {
+            Message::CopyPath => match path_text(path) {
+                Some(text) => clipboard::write(text),
+                None => Task::none(),
+            },
+            Message::OpenFolder => {
+                if let (Some(path), Some(folder)) = (path, containing_folder(path)) {
+                    let uri = file_uri(path);
+                    // A D-Bus call can wait for the file manager to start: keep it off the UI
+                    std::thread::spawn(move || show_item(&uri, &folder));
+                }
+                Task::none()
+            }
+        }
+    }
+}
+
+fn show_item(uri: &str, folder: &Path) {
+    if let Err(err) = show_items_dbus(uri) {
+        log::info!(
+            "file manager did not show {:?} ({}), opening {:?}",
+            uri,
+            err,
+            folder
+        );
+        if let Err(err) = open::that_detached(folder) {
+            log::warn!("failed to open {:?}: {}", folder, err);
+        }
+    }
+}
+
+#[cfg(feature = "gvfs")]
+fn show_items_dbus(uri: &str) -> Result<(), String> {
+    use gio::prelude::*;
+
+    let bus = gio::bus_get_sync(gio::BusType::Session, None::<&gio::Cancellable>)
+        .map_err(|err| err.to_string())?;
+    bus.call_sync(
+        Some("org.freedesktop.FileManager1"),
+        "/org/freedesktop/FileManager1",
+        "org.freedesktop.FileManager1",
+        "ShowItems",
+        Some(&(vec![uri.to_string()], "").to_variant()),
+        None,
+        gio::DBusCallFlags::NONE,
+        5000,
+        None::<&gio::Cancellable>,
+    )
+    .map(|_| ())
+    .map_err(|err| err.to_string())
+}
+
+#[cfg(not(feature = "gvfs"))]
+fn show_items_dbus(_uri: &str) -> Result<(), String> {
+    Err("built without gvfs".to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn copy_path_needs_a_file() {
+        assert_eq!(path_text(None), None);
+        assert_eq!(
+            path_text(Some(Path::new("/home/user/notes/todo.md"))),
+            Some("/home/user/notes/todo.md".to_string())
+        );
+    }
+
+    #[test]
+    fn containing_folder_is_the_parent() {
+        assert_eq!(containing_folder(None), None);
+        assert_eq!(
+            containing_folder(Some(Path::new("/home/user/notes/todo.md"))),
+            Some(PathBuf::from("/home/user/notes"))
+        );
+        assert_eq!(containing_folder(Some(Path::new("/"))), None);
+    }
+
+    #[test]
+    fn file_uri_encodes_reserved_bytes() {
+        assert_eq!(
+            file_uri(Path::new("/home/user/notes/todo.md")),
+            "file:///home/user/notes/todo.md"
+        );
+        assert_eq!(
+            file_uri(Path::new("/home/user/my notes/a#b%c.md")),
+            "file:///home/user/my%20notes/a%23b%25c.md"
+        );
+        assert_eq!(
+            file_uri(Path::new("/home/user/Notizen/Größe.md")),
+            "file:///home/user/Notizen/Gr%C3%B6%C3%9Fe.md"
+        );
+    }
+}

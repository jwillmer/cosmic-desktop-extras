@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Large files open without syntax colours, as colouring them would take seconds.
+
+use cosmic::iced::advanced::graphics::text::font_system;
+use cosmic_text::{Buffer, Edit, SyntaxEditor, ViEditor};
+use std::{fs, path::PathBuf, sync::Arc};
+
+use crate::{SYNTAX_SYSTEM, tab::EditorTab};
+
+/// A file larger than this opens without syntax colours: cosmic-text colours the whole file
+/// before the first frame, which took 6 s for 5 MB of Markdown (0.3 s as plain text).
+pub const PLAIN_SYNTAX_BYTES: u64 = 1_000_000;
+
+impl EditorTab {
+    /// Open `path` like [`Self::open`]; a file over [`PLAIN_SYNTAX_BYTES`] without syntax colours.
+    pub fn open(&mut self, path: PathBuf) {
+        self.open_text(path);
+        if self.plain {
+            self.use_plain_syntax();
+        }
+    }
+
+    /// Show the text without syntax colours: the editor is made anew around its buffer, with
+    /// the same settings, as cosmic-text has no way to change the syntax of an editor.
+    pub(crate) fn use_plain_syntax(&mut self) {
+        let mut editor = self.editor.lock().unwrap();
+        let (auto_indent, tab_width, changed) =
+            (editor.auto_indent(), editor.tab_width(), editor.changed());
+        let buffer = editor.with_buffer_mut(|buffer| {
+            let metrics = buffer.metrics();
+            std::mem::replace(buffer, Buffer::new_empty(metrics))
+        });
+        // A new editor has plain text syntax
+        let Some(syntax) = SyntaxEditor::new(
+            Arc::new(buffer),
+            SYNTAX_SYSTEM.get().unwrap(),
+            &self.syntax_theme,
+        ) else {
+            log::error!(
+                "failed to make a plain editor, theme {:?}",
+                self.syntax_theme
+            );
+            return;
+        };
+        let mut plain = ViEditor::new(syntax);
+        plain.set_passthrough(self.passthrough);
+        plain.set_changed(changed);
+        let mut font_system = font_system().write().unwrap();
+        let mut borrowed = plain.borrow_with(font_system.raw());
+        borrowed.set_auto_indent(auto_indent);
+        borrowed.set_tab_width(tab_width);
+        drop(borrowed);
+        *editor = plain;
+    }
+
+    /// Before the file is read again: one that grew past [`PLAIN_SYNTAX_BYTES`] loses its syntax
+    /// colours first, as colouring it would take seconds (one that shrank keeps them off until
+    /// it is opened again).
+    pub(crate) fn plain_before_reload(&mut self) {
+        if !self.plain
+            && let Some(path) = &self.path_opt
+            && let Ok(metadata) = fs::metadata(path)
+            && metadata.len() > PLAIN_SYNTAX_BYTES
+        {
+            self.plain = true;
+            self.plain_notice = Some(metadata.len());
+            self.use_plain_syntax();
+        }
+    }
+}
+
+/// The syntaxes and themes of the editor as `fn main` loads them, COSMIC themes included, for
+/// tests that run without it.
+#[cfg(test)]
+pub(crate) fn syntax_system() -> cosmic_text::SyntaxSystem {
+    let lazy_theme_set = two_face::theme::LazyThemeSet::from(two_face::theme::extra());
+    let mut theme_set = syntect::highlighting::ThemeSet::from(&lazy_theme_set);
+    // Hardcoded COSMIC themes
+    for (theme_name, theme_data) in &[
+        ("COSMIC Dark", cosmic_syntax_theme::COSMIC_DARK_TM_THEME),
+        ("COSMIC Light", cosmic_syntax_theme::COSMIC_LIGHT_TM_THEME),
+    ] {
+        let mut cursor = std::io::Cursor::new(theme_data);
+        match syntect::highlighting::ThemeSet::load_from_reader(&mut cursor) {
+            Ok(mut theme) => {
+                // Use libcosmic theme for background and gutter
+                theme.settings.background = Some(syntect::highlighting::Color {
+                    r: 0,
+                    g: 0,
+                    b: 0,
+                    a: 0,
+                });
+                theme.settings.gutter = Some(syntect::highlighting::Color {
+                    r: 0,
+                    g: 0,
+                    b: 0,
+                    a: 0,
+                });
+                theme_set.themes.insert(theme_name.to_string(), theme);
+            }
+            Err(err) => {
+                eprintln!("failed to load {:?} syntax theme: {}", theme_name, err);
+            }
+        }
+    }
+    cosmic_text::SyntaxSystem {
+        //TODO: store newlines in buffer
+        syntax_set: two_face::syntax::extra_no_newlines(),
+        theme_set,
+    }
+}

+/// Draw a chevron in the fold area (`x`, `w`, physical pixels) of each visible fold header:
+/// `▸` on a folded block always, `▾` on a foldable one only while the pointer is over the
+/// gutter or on the cursor line, fainter.
+fn draw_fold_chevrons(
+    pixels: &mut [u32],
+    canvas: Canvas,
+    editor: &ViEditor<'static, 'static>,
+    kind: folding::FoldKind,
+    (area_x, area_w): (i32, i32),
+    hover: bool,
+    color: cosmic_text::Color,
+) {
+    let cursor_line = editor.cursor().line;
+    let tint = |alpha: u8| cosmic_text::Color::rgba(color.r(), color.g(), color.b(), alpha);
+    editor.with_buffer(|buffer| {
+        let line_height = buffer.metrics().line_height;
+        // Half the chevron's long side
+        let half = ((area_w as f32 * 0.25).round() as i32).max(2);
+        let cx = area_x + area_w / 2;
+        let mut last_line = None;
+        for run in buffer.layout_runs() {
+            if folding::is_folded_run(&run) || last_line == Some(run.line_i) {
+                continue;
+            }
+            last_line = Some(run.line_i);
+            let line = run.line_i;
+            let cy = (run.line_top + line_height / 2.0) as i32;
+            if folding::folded_after(buffer, line).is_some() {
+                // ▸: columns shrinking to the right
+                for i in 0..=half {
+                    draw_rect(
+                        pixels,
+                        canvas,
+                        Canvas {
+                            w: 1,
+                            h: 2 * (half - i) + 1,
+                        },
+                        Offset {
+                            x: cx - half / 2 + i,
+                            y: cy - (half - i),
+                        },
+                        tint(220),
+                    );
+                }
+            } else if (hover || line == cursor_line)
+                && folding::is_foldable(|i| buffer.lines.get(i).map(|l| l.text()), line, kind)
+            {
+                // ▾: rows shrinking downwards
+                for i in 0..=half {
+                    draw_rect(
+                        pixels,
+                        canvas,
+                        Canvas {
+                            w: 2 * (half - i) + 1,
+                            h: 1,
+                        },
+                        Offset {
+                            x: cx - (half - i),
+                            y: cy - half / 2 + i,
+                        },
+                        tint(130),
+                    );
+                }
+            }
+        }
+    });
+}

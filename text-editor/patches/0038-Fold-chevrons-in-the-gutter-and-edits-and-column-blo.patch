+/// Whether `line` heads a block, for the gutter chevrons. Cheap enough for
+/// every visible row: it reads the header and the first non-blank line below.
+/// An unclosed bracket still counts; toggling it then does nothing.
+pub fn is_foldable<'a>(
+    text: impl Fn(usize) -> Option<&'a str>,
+    line: usize,
+    kind: FoldKind,
+) -> bool {
+    let Some(header) = text(line) else {
+        return false;
+    };
+    let mut below = (line + 1..).map_while(&text);
+    match kind {
+        FoldKind::Brackets => {
+            let open = opened(header);
+            // An empty block closes on the next line
+            open > 0
+                && below.take(1).any(|next| {
+                    let mut closed = false;
+                    bracket_depths(next, |depth| {
+                        closed = depth <= -open;
+                        closed
+                    });
+                    !closed
+                })
+        }
+        FoldKind::Indent => indent_of(header).is_some_and(|header| {
+            below
+                .filter_map(indent_of)
+                .next()
+                .is_some_and(|indent| indent > header)
+        }),
+        FoldKind::Markdown => heading_level(header).is_some_and(|level| {
+            below
+                .find(|text| !text.trim().is_empty())
+                .is_some_and(|text| heading_level(text).is_none_or(|other| other > level))
+        }),
+    }
+}

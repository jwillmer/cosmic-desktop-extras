+/// Fold or unfold the block headed by `header`, as a click on its chevron
+/// does. Returns false when `header` heads no block.
+pub fn toggle(buffer: &mut Buffer, header: usize, kind: FoldKind) -> bool {
+    if let Some(range) = folded_after(buffer, header) {
+        set_range(buffer, range, false);
+        return true;
+    }
+    match fold_range(&texts(buffer), header, kind) {
+        Some(range) => {
+            set_range(buffer, range, true);
+            true
+        }
+        None => false,
+    }
+}
+
+/// Unfold every fold that hides one of the lines `first..=last`, e.g. before a
+/// column selection over them edits each line.
+pub fn unfold_lines(buffer: &mut Buffer, first: usize, last: usize) -> bool {
+    let mut unfolded = false;
+    let mut line = first;
+    while line <= last && line < buffer.lines.len() {
+        match hidden_run(buffer, line) {
+            Some(range) => {
+                set_range(buffer, range, false);
+                unfolded = true;
+                line = range.1 + 1;
+            }
+            None => line += 1,
+        }
+    }
+    unfolded
+}
+
+/// After an edit: unfold what hides `cursor_line` (where the edit, an undo or a
+/// paste left the cursor) and every fold that no longer is exactly the block
+/// of the line above it. Typing on a header keeps its fold while the block
+/// stays the same; deleting the bracket, a selection over the fold or a line
+/// break around it drops the fold, so no edited text stays hidden. Costs a
+/// scan of the lines only while something is folded.
+pub fn reconcile(buffer: &mut Buffer, kind: FoldKind, cursor_line: usize) -> bool {
+    if !buffer.lines.iter().any(is_hidden) {
+        return false;
+    }
+    let mut unfolded = reveal(buffer, cursor_line);
+    let stale = {
+        let lines = texts(buffer);
+        let mut stale = Vec::new();
+        let mut line = 0;
+        while line < lines.len() {
+            if !is_hidden(&buffer.lines[line]) {
+                line += 1;
+                continue;
+            }
+            let first = line;
+            while line + 1 < lines.len() && is_hidden(&buffer.lines[line + 1]) {
+                line += 1;
+            }
+            let range = (first, line);
+            if first == 0 || fold_range(&lines, first - 1, kind) != Some(range) {
+                stale.push(range);
+            }
+            line += 1;
+        }
+        stale
+    };
+    for range in stale {
+        set_range(buffer, range, false);
+        unfolded = true;
+    }
+    unfolded
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Fri, 13 Nov 2026 11:43:15 +0100
Subject: [PATCH 060/111] Folds are kept across restarts

The session stores each tab's folded blocks as the header line and its text.
On restore a block is folded again only when that line still holds the same
text; a fold whose header changed or moved since (the file was edited
elsewhere) is dropped. Nested folds inside a folded block come back as part
of the outer one. Sessions from before keep loading with no folds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/folding.rs b/src/folding.rs
index 7cf13b5..b53d9c1 100644
--- a/src/folding.rs
+++ b/src/folding.rs
@@ -422,6 +422,30 @@ pub fn unfold_all(buffer: &mut Buffer) {
     }
 }
 
+/// The folds to keep in the session: each fold's header line and its text.
+pub fn saved_folds(buffer: &Buffer) -> Vec<(usize, String)> {
+    (0..buffer.lines.len())
+        .filter(|&line| is_fold_header(buffer, line))
+        .map(|line| (line, buffer.lines[line].text().to_string()))
+        .collect()
+}
+
+/// Fold again the blocks of [`saved_folds`]. A fold whose header line no longer holds the
+/// saved text (the file changed since) is dropped.
+pub fn restore_folds(buffer: &mut Buffer, folds: &[(usize, String)], kind: FoldKind) {
+    let ranges: Vec<(usize, usize)> = {
+        let lines = texts(buffer);
+        folds
+            .iter()
+            .filter(|(line, text)| lines.get(*line) == Some(&text.as_str()))
+            .filter_map(|(line, _)| fold_range(&lines, *line, kind))
+            .collect()
+    };
+    for range in ranges {
+        set_range(buffer, range, true);
+    }
+}
+
 /// Unfold whatever hides `line`, so a find hit or an edit is never hidden.
 pub fn reveal(buffer: &mut Buffer, line: usize) -> bool {
     match hidden_run(buffer, line) {
@@ -1112,4 +1136,27 @@ pub(crate) mod tests {
         );
         let _ = std::fs::remove_dir_all(&dir);
     }
+
+    #[test]
+    fn folds_restore_by_header_text() {
+        let text = "a {\n  b\n}\nc {\n  d\n}\n";
+        let mut folded = editor(text, "rs");
+        folded.with_buffer_mut(|buffer| fold_all(buffer, FoldKind::Brackets));
+        let saved = folded.with_buffer(saved_folds);
+        assert_eq!(saved, vec![(0, "a {".to_string()), (3, "c {".to_string())]);
+
+        let mut restored = editor(text, "rs");
+        restored.with_buffer_mut(|buffer| restore_folds(buffer, &saved, FoldKind::Brackets));
+        assert_eq!(restored.with_buffer(saved_folds), saved);
+        assert!(restored.with_buffer(|buffer| is_hidden(&buffer.lines[4])));
+
+        // The first header changed on disk: only the second fold comes back
+        let mut changed = editor("x {\n  b\n}\nc {\n  d\n}\n", "rs");
+        changed.with_buffer_mut(|buffer| restore_folds(buffer, &saved, FoldKind::Brackets));
+        assert_eq!(
+            changed.with_buffer(saved_folds),
+            vec![(3, "c {".to_string())]
+        );
+        assert!(!changed.with_buffer(|buffer| is_hidden(&buffer.lines[1])));
+    }
 }

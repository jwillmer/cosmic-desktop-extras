-/// Draw the blocks; `open` holds the indices of the opened `<details>`.
+/// The text of a summary, white space collapsed; images count by their alt text.
+fn summary_text(pieces: &[Piece]) -> String {
+    let mut text = String::new();
+    for piece in pieces {
+        match piece {
+            Piece::Text(value, _) => text.push_str(value),
+            Piece::Image(picture) => text.push_str(&picture.alt),
+            Piece::Break => text.push(' '),
+        }
+    }
+    text.split_whitespace().collect::<Vec<_>>().join(" ")
+}

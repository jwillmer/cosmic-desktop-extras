+        }
+    }
+
+    fn details_keys(text: &str) -> Vec<DetailsKey> {
+        parse(text)
+            .blocks
+            .into_iter()
+            .filter_map(|block| match block {
+                Block::Details { key, .. } => Some(key),
+                _ => None,
+            })
+            .collect()
+    }
+
+    #[test]
+    fn details_keep_their_key_when_a_block_is_added_above() {
+        let text = "<details><summary>Setup</summary>a</details>\n\n\
+                    <details><summary>Usage</summary>b</details>\n";
+        let keys = details_keys(text);
+        assert_eq!(keys, vec![key("Setup", 0), key("Usage", 0)]);
+        // A new <details> above does not take over the open state of the ones below
+        let added = format!("<details><summary>Intro</summary>c</details>\n\n{text}");
+        assert_eq!(
+            details_keys(&added),
+            vec![key("Intro", 0), key("Setup", 0), key("Usage", 0)]
+        );
+    }
+
+    #[test]
+    fn repeated_summaries_count_from_the_top() {
+        let text = "<details><summary>More</summary>a</details>\n\n\
+                    <details><summary> More\n</summary>b</details>\n\n\
+                    <details><summary>Other</summary>c</details>\n";
+        assert_eq!(
+            details_keys(text),
+            vec![key("More", 0), key("More", 1), key("Other", 0)]
+        );
     }
 

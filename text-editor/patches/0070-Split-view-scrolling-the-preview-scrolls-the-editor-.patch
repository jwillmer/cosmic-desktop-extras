+    #[test]
+    fn preview_position_maps_back_to_the_line_drawn_there() {
+        let heights = Layout::new(DOC).heights(80);
+        for line in [0, 2, 3, 5, 6, 7, 8, 10, 11] {
+            assert_eq!(heights.line(heights.fraction(line)), line, "line {line}");
+        }
+        // The blank line before a block is not drawn: its position is the block's
+        assert_eq!(heights.line(heights.fraction(4)), 5);
+        // Half way into the second line of the paragraph (2..3 of 13) stays on it
+        assert_eq!(heights.line(3.5 / 13.0), 3);
+        assert_eq!(heights.line(0.0), 0);
+        assert_eq!(heights.line(1.0), 12);
+        assert_eq!(heights.line(-1.0), 0);
+    }
+
+    #[test]
+    fn long_lines_count_the_lines_they_wrap_to() {
+        // One 400 character line wraps to 5 lines at 80 columns, 10 at 40
+        let text = format!("{}\n\nAfter\n", "word ".repeat(80).trim_end());
+        let heights = Layout::new(&text).heights(80);
+        // 5 + 1 spacing, then 1 + 1: "After" starts 6/8 down
+        assert_eq!(heights.fraction(2), 6.0 / 8.0);
+        assert_eq!(Layout::new(&text).heights(40).fraction(2), 11.0 / 13.0);
+        // A position inside the wrapped line maps to it, not past it
+        assert_eq!(heights.line(4.0 / 8.0), 0);
+    }
+
+    #[test]
+    fn tables_map_row_by_row_and_code_does_not_wrap() {
+        let long = "x".repeat(200);
+        let text = format!("| a | b |\n|---|---|\n| 1 | 2 |\n| 3 | 4 |\n\n```\n{long}\n```\n");
+        let heights = Layout::new(&text).heights(80);
+        // Header 1, rule 0, rows 1 and 1, spacing 1; fence 1, code 1 (not 3), fence 1, spacing 1:
+        // 8 in all
+        assert_eq!(heights.fraction(1), 1.0 / 8.0);
+        assert_eq!(heights.fraction(2), 1.0 / 8.0);
+        assert_eq!(heights.fraction(3), 2.0 / 8.0);
+        assert_eq!(heights.fraction(5), 4.0 / 8.0);
+        assert_eq!(heights.fraction(7), 6.0 / 8.0);
+        // The rule is not drawn: its position is the first row's
+        assert_eq!(heights.line(1.0 / 8.0), 2);
     }
 

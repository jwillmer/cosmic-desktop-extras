+impl Layout {
+    pub fn new(text: &str) -> Self {
+        let lines_of = Lines::new(text);
+        let mut lines: Vec<(Kind, bool)> =
+            text.split('\n').map(|_| (Kind::Outside, false)).collect();
+        let blocks = block_lines(text);
+        let source: Vec<&str> = text.split('\n').collect();
+        for block in &blocks {
+            for line in block.clone() {
+                lines[line].0 = Kind::Text(source[line].trim().chars().count());
+            }
+            if let Some(last) = block.end.checked_sub(1) {
+                lines[last].1 = true;
+            }
+        }
+        let mut depth = 0usize;
+        for (event, range) in Parser::new_ext(text, OPTIONS).into_offset_iter() {
+            match event {
+                Event::Start(tag) => {
+                    if depth == 0 {
+                        let block = lines_of.range(&range);
+                        match tag {
+                            Tag::CodeBlock(_) => {
+                                for line in block {
+                                    lines[line].0 = Kind::Code;
+                                }
+                            }
+                            Tag::Table(_) if block.len() > 1 => {
+                                lines[block.start + 1].0 = Kind::Rule;
+                            }
+                            _ => {}
+                        }
+                    }
+                    depth += 1;
+                }
+                Event::End(_) => depth = depth.saturating_sub(1),
+                _ => {}
+            }
+        }
+        Self { lines }
+    }
+
+    /// Estimated heights for a preview that fits `columns` characters per line.
+    pub fn heights(&self, columns: usize) -> Heights {
+        let columns = columns.max(1);
+        let mut above = Vec::with_capacity(self.lines.len() + 1);
+        let mut sum = 0.0;
+        above.push(sum);
+        for (kind, last) in &self.lines {
+            sum += match kind {
+                Kind::Outside | Kind::Rule => 0.0,
+                Kind::Code => 1.0,
+                Kind::Text(chars) => chars.div_ceil(columns).max(1) as f32,
+            };
+            if *last {
+                sum += BLOCK_GAP;
+            }
+            above.push(sum);
+        }
+        Heights(above)
+    }
+}

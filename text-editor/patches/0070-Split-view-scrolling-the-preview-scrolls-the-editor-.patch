+/// Estimated preview height above each source line, in preview text lines; one more entry than
+/// lines, the last being the total.
+#[derive(Debug, Default)]
+pub struct Heights(Vec<f32>);
+
+impl Heights {
+    fn total(&self) -> f32 {
+        self.0.last().copied().unwrap_or(0.0)
+    }
+
+    /// How far down the preview `line` of the source is drawn, from 0 (top) to 1 (end). A line
+    /// between blocks is drawn where the next block starts.
+    pub fn fraction(&self, line: usize) -> f32 {
+        let total = self.total();
+        match self.0.get(line) {
+            Some(above) if total > 0.0 => above / total,
+            _ => 1.0,
+        }
+    }
+
+    /// The source line drawn at `fraction` of the preview's height: the inverse of
+    /// [`Self::fraction`], to the line.
+    pub fn line(&self, fraction: f32) -> usize {
+        let lines = self.0.len().saturating_sub(1);
+        let target = fraction.clamp(0.0, 1.0) * self.total();
+        // The last line that starts at or above the target; a line of no height (blank, a table
+        // rule) shares its start with the next line, so this lands on the line drawn there
+        self.0[..lines]
+            .partition_point(|above| *above <= target)
+            .saturating_sub(1)
+    }
 }
 

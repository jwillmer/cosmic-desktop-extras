+    /// The preview reports its scroll position and size; it fits `columns` characters per line.
+    /// `true` when the user scrolled it: not a scroll the app started, not a change of size.
+    fn scrolled(&mut self, viewport: Viewport, columns: usize) -> bool {
+        if columns != self.columns {
+            self.columns = columns;
+            self.heights = self.layout.heights(columns);
+        }
+        // Scrolled back by `RestoreScroll`, which reads the offset kept from before
+        if self.restoring {
+            return false;
+        }
+        let moved = (viewport.offset.y - self.scroll_offset.y).abs() > 0.5;
+        let resized = (viewport.content_height - self.content_height).abs() > 0.5
+            || (viewport.height - self.viewport_height).abs() > 0.5;
+        self.scroll_offset = viewport.offset;
+        self.content_height = viewport.content_height;
+        self.viewport_height = viewport.height;
+        if !moved {
+            return false;
+        }
+        let echo = self
+            .expected_offset
+            .take()
+            .is_some_and(|y| (y - viewport.offset.y).abs() <= 1.0);
+        !echo && !resized
+    }
+
+    /// The source line drawn at the top of the preview.
+    fn top_line(&self) -> usize {
+        self.line_at(self.scroll_offset.y)
+    }
+
+    /// The source line drawn `y` pixels down the preview's content.
+    fn line_at(&self, y: f32) -> usize {
+        if self.content_height <= 0.0 {
+            return 0;
+        }
+        self.heights.line(y / self.content_height)
+    }

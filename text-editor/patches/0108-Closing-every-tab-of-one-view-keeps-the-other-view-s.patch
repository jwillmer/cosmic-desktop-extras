+    /// The tab to show when closing `close` empties the view of `active`: the one the other
+    /// view shows, so it stays in front when the split closes.
+    pub fn shown_after_closing(&self, active: Entity, close: &[Entity]) -> Option<Entity> {
+        let side = self.side_of(active)?;
+        if !self.tabs(side).iter().all(|tab| close.contains(tab)) {
+            return None;
+        }
+        self.shown(side.other()).filter(|tab| !close.contains(tab))
+    }

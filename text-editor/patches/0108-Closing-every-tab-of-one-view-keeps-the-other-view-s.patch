+    #[test]
+    fn closing_a_whole_view_keeps_the_other_views_tab() {
+        let (_, t) = tabs(4);
+        // Left: t[0] shown, t[1]; right: t[2], t[3]
+        let mut split = Split::new(&t, t[3], Some(t[0]));
+        split.move_tab(t[2]);
+        assert_eq!(split.tabs(Side::Right), vec![t[3], t[2]]);
+        assert_eq!(split.shown(Side::Left), Some(t[0]));
+        // Every right tab closes: the left keeps showing t[0], not its neighbour in tab order
+        assert_eq!(split.shown_after_closing(t[3], &[t[2], t[3]]), Some(t[0]));
+        // Only some right tabs close: the usual neighbour rule applies
+        assert_eq!(split.shown_after_closing(t[3], &[t[3]]), None);
+    }
+

@@ -18,6 +18,38 @@ pub type Pos = (usize, usize);
 /// bar opens, as one that spans lines does: it is a range to search, not a query
 pub const AUTO_BYTES: usize = 1024;
 
+/// What find, replace, replace all, the count and the highlights act on
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Scope {
+    /// "In selection" is off: the whole text
+    Whole,
+    /// Only inside this range
+    Range((Pos, Pos)),
+    /// "In selection" was on, but its range no longer holds (an edit, or another tab): nothing,
+    /// until the option is turned on again or the find bar closes. The whole text would widen
+    /// the scope behind the user's back, so the next Replace could change text outside it.
+    Stale,
+}
+
+/// The scope for the "In selection" range `range` (if one was set), which `holds` while it is
+/// for the active tab and the text as it is now
+pub fn scope(range: Option<(Pos, Pos)>, holds: bool) -> Scope {
+    match range {
+        None => Scope::Whole,
+        Some(range) if holds => Scope::Range(range),
+        Some(_) => Scope::Stale,
+    }
+}
+
+/// Whether opening the find bar turns "In selection" on for the selection `start` to `end`: only
+/// when the bar was closed (Ctrl+H with the bar open only shows the replace field), for a
+/// selection that spans lines or is at least [`AUTO_BYTES`] long, and never for the match the
+/// last find selected (it is a result, not a range to search).
+pub fn auto(start: Pos, end: Pos, bar_was_open: bool, last_hit: bool) -> bool {
+    let long = start.0 != end.0 || end.1.saturating_sub(start.1) >= AUTO_BYTES;
+    start != end && long && !bar_was_open && !last_hit
+}
+
 /// Whether the match from `start` to `end` lies wholly inside the range `from` to `to`
 pub fn inside(start: Pos, end: Pos, (from, to): (Pos, Pos)) -> bool {
     start >= from && end <= to
@@ -124,6 +156,30 @@ mod tests {
         }
     }
 
+    #[test]
+    fn a_stale_range_is_no_scope_at_all() {
+        let range = ((1, 0), (3, 4));
+        assert_eq!(scope(None, true), Scope::Whole);
+        assert_eq!(scope(None, false), Scope::Whole);
+        assert_eq!(scope(Some(range), true), Scope::Range(range));
+        // Never the whole text: the next replace would change text outside the range
+        assert_eq!(scope(Some(range), false), Scope::Stale);
+    }
+
+    #[test]
+    fn opening_the_bar_sets_the_range_only_from_a_real_selection() {
+        // Over lines, the bar closed: on
+        assert!(auto((1, 2), (3, 0), false, false));
+        // Short on one line: a query, not a range
+        assert!(!auto((1, 2), (1, 5), false, false));
+        assert!(auto((1, 0), (1, AUTO_BYTES), false, false));
+        assert!(!auto((1, 2), (1, 2), false, false));
+        // Ctrl+H with the bar open: the range stays as it is
+        assert!(!auto((1, 2), (3, 0), true, false));
+        // The match Find next selected (a query over lines)
+        assert!(!auto((1, 2), (3, 0), false, true));
+    }
+

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Fri, 13 Nov 2026 15:55:11 +0100
Subject: [PATCH 097/110] An alert's title can be selected and copied

The "Note", "Tip" and other titles of GitHub alerts in the preview are
text runs like the rest, so a copied alert keeps its title.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/markdown.rs b/src/markdown.rs
index a553c58..ff8afba 100644
--- a/src/markdown.rs
+++ b/src/markdown.rs
@@ -3131,6 +3131,11 @@ mod tests {
             preview.selected_text(test_settings(), "").as_deref(),
             Some("ne\n- t")
         );
+        // An alert's title is copied too
+        assert_eq!(
+            copied_all("> [!TIP]\n> Water early.\n"),
+            "Tip\n\nWater early."
+        );
         // An image inside a line keeps the text around it on that line
         assert_eq!(
             copied_all("<p>before <img src=\"missing.png\"> after</p>\n\nnext\n"),
diff --git a/src/markdown_html.rs b/src/markdown_html.rs
index 25d4000..69ea008 100644
--- a/src/markdown_html.rs
+++ b/src/markdown_html.rs
@@ -1297,13 +1297,18 @@ fn view_block<'a>(
                     ..Default::default()
                 }),
             );
-            let title = widget::text(alert_title(*kind))
-                .size(settings.text_size)
-                .font(Font {
-                    weight: font::Weight::Bold,
-                    ..settings.style.font
-                })
-                .class(theme::Text::Color(color));
+            let title = viewer.leaf(
+                vec![
+                    span(alert_title(*kind))
+                        .font(Font {
+                            weight: font::Weight::Bold,
+                            ..settings.style.font
+                        })
+                        .color(color),
+                ],
+                settings.text_size,
+                None,
+            );
             widget::row::with_capacity(2)
                 .push(bar)
                 .push(

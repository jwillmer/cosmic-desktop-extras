+/// After folding: a cursor or selection that reaches into hidden lines leaves them, so the
+/// next key press never edits text the user cannot see. The selection is dropped and a hidden
+/// cursor goes to the end of its fold header, as in VS Code.
+pub fn leave_folds<'buffer, E: Edit<'buffer>>(editor: &mut E) {
+    let cursor = editor.cursor();
+    let (start, end) = editor.selection_bounds().unwrap_or((cursor, cursor));
+    let touches = editor.with_buffer(|buffer| {
+        (start.line..=end.line).any(|line| buffer.lines.get(line).is_some_and(is_hidden))
+    });
+    if !touches {
+        return;
+    }
+    editor.set_selection(cosmic_text::Selection::None);
+    let to = editor.with_buffer(|buffer| match hidden_run(buffer, cursor.line) {
+        Some((first, _)) if first > 0 => {
+            Some(Cursor::new(first - 1, buffer.lines[first - 1].text().len()))
+        }
+        Some(_) => Some(skip_fold(buffer, cursor, cursor)),
+        None => None,
+    });
+    if let Some(to) = to {
+        editor.set_cursor(to);
+    }
+    editor.set_redraw(true);
+}
+
+/// Before an edit: unfold every fold the selection (or the cursor) reaches into, so an edit
+/// is never applied to hidden text. Returns whether something was unfolded.
+pub fn reveal_selection<'buffer, E: Edit<'buffer>>(editor: &mut E) -> bool {
+    let cursor = editor.cursor();
+    let (start, end) = editor.selection_bounds().unwrap_or((cursor, cursor));
+    editor.with_buffer_mut(|buffer| unfold_lines(buffer, start.line, end.line))
+}
+
+/// Before Backspace (`forward` false) or Delete (`forward` true) without a selection: unfold
+/// the line the key would join the cursor's line with, when that line is hidden. A plain key
+/// joins at the start or end of the line; with `word` (Ctrl) it also does when only blanks
+/// lie between the cursor and the line's start or end.
+pub fn reveal_join<'buffer, E: Edit<'buffer>>(editor: &mut E, forward: bool, word: bool) -> bool {
+    if editor.selection_bounds().is_some() {
+        return false;
+    }
+    let cursor = editor.cursor();
+    editor.with_buffer_mut(|buffer| {
+        let Some(text) = buffer.lines.get(cursor.line).map(BufferLine::text) else {
+            return false;
+        };
+        let index = cursor.index.min(text.len());
+        let (rest, at_edge) = if forward {
+            (&text[index..], index == text.len())
+        } else {
+            (&text[..index], index == 0)
+        };
+        if !(at_edge || word && rest.trim().is_empty()) {
+            return false;
+        }
+        let line = if forward {
+            cursor.line + 1
+        } else {
+            match cursor.line.checked_sub(1) {
+                Some(line) => line,
+                None => return false,
+            }
+        };
+        reveal(buffer, line)
+    })
+}

+/// Whether `event` changes the text in the text box's `update`, as typing, Enter, Backspace,
+/// Delete, Tab or an input method commit do.
+fn is_edit(event: &Event, state_modifiers: Modifiers) -> bool {
+    match event {
+        Event::Keyboard(KeyEvent::KeyPressed {
+            modified_key: Key::Named(Named::Enter | Named::Backspace | Named::Delete),
+            ..
+        }) => true,
+        Event::Keyboard(KeyEvent::KeyPressed {
+            modified_key: Key::Named(Named::Tab),
+            modifiers,
+            ..
+        }) => !modifiers.control() && !modifiers.alt(),
+        Event::Keyboard(KeyEvent::KeyPressed { text, .. }) => {
+            !state_modifiers.logo()
+                && !state_modifiers.control()
+                && !state_modifiers.alt()
+                && text
+                    .as_deref()
+                    .and_then(|text| text.chars().next())
+                    .is_some_and(|c| !c.is_control())
+        }
+        Event::InputMethod(InputMethodEvent::Commit(_)) => true,
+        _ => false,
+    }
+}

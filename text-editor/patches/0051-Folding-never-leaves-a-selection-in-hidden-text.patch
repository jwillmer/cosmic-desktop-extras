+    #[test]
+    fn folding_moves_selection_out_of_the_fold() {
+        // `let b = 2;` selected as Shift+End does, then the block around it folds
+        let mut editor = editor(RUST, "rs");
+        select(&mut editor, (2, 4), (2, 14));
+        let line = editor.cursor().line;
+        editor.with_buffer_mut(|buffer| fold(buffer, line, FoldKind::Brackets));
+        leave_folds(&mut editor);
+        assert_eq!(editor.selection(), cosmic_text::Selection::None);
+        assert_eq!(
+            editor.cursor(),
+            cosmic_text::Cursor::new(0, "fn main() {".len())
+        );
+        // Typing goes to the end of the header, the hidden text stays as it was
+        act(&mut editor, cosmic_text::Action::Insert('q'));
+        assert_eq!(text(&editor), RUST.replacen("{\n", "{q\n", 1));
+        assert_eq!(hidden(&editor), vec![1, 2, 3]);
+    }
+
+    #[test]
+    fn fold_all_clears_selection_inside_folds() {
+        // The cursor stays visible below, but the selection reaches into the block
+        let mut editor = editor(RUST, "rs");
+        select(&mut editor, (2, 8), (5, 3));
+        editor.with_buffer_mut(|buffer| fold_all(buffer, FoldKind::Brackets));
+        leave_folds(&mut editor);
+        assert_eq!(editor.selection(), cosmic_text::Selection::None);
+        assert_eq!(editor.cursor(), cosmic_text::Cursor::new(5, 3));
+        // A selection outside every fold is kept
+        let mut editor = self::editor(RUST, "rs");
+        select(&mut editor, (5, 0), (5, 3));
+        editor.with_buffer_mut(|buffer| fold_all(buffer, FoldKind::Brackets));
+        leave_folds(&mut editor);
+        assert_eq!(
+            editor.selection(),
+            cosmic_text::Selection::Normal(cosmic_text::Cursor::new(5, 0))
+        );
+    }
+
+    #[test]
+    fn typing_after_fold_never_edits_hidden_text() {
+        // However a selection ends up in hidden lines, the edit unfolds them first
+        let mut editor = editor(RUST, "rs");
+        editor.with_buffer_mut(|buffer| fold(buffer, 0, FoldKind::Brackets));
+        select(&mut editor, (2, 4), (2, 14));
+        assert!(reveal_selection(&mut editor));
+        assert_eq!(hidden(&editor), Vec::<usize>::new());
+        act(&mut editor, cosmic_text::Action::Insert('q'));
+        assert_eq!(text(&editor), RUST.replacen("let b = 2;", "q", 1));
+        // Nothing to unfold when the selection is visible
+        editor.with_buffer_mut(|buffer| fold(buffer, 0, FoldKind::Brackets));
+        select(&mut editor, (5, 0), (5, 3));
+        assert!(!reveal_selection(&mut editor));
+        assert_eq!(hidden(&editor), vec![1, 2, 3]);
+    }
+
+    #[test]
+    fn backspace_or_delete_next_to_a_fold_unfolds_it() {
+        // Backspace at the start of the line below a fold would join it with a hidden line
+        let mut editor = editor(RUST, "rs");
+        editor.with_buffer_mut(|buffer| fold(buffer, 0, FoldKind::Brackets));
+        // Mid-line, Backspace and Ctrl+Backspace join nothing
+        editor.set_cursor(cosmic_text::Cursor::new(4, 1));
+        assert!(!reveal_join(&mut editor, false, false));
+        assert!(!reveal_join(&mut editor, false, true));
+        assert_eq!(hidden(&editor), vec![1, 2, 3]);
+        editor.set_cursor(cosmic_text::Cursor::new(4, 0));
+        assert!(reveal_join(&mut editor, false, false));
+        assert_eq!(hidden(&editor), Vec::<usize>::new());
+        // Delete at the end of the header
+        editor.with_buffer_mut(|buffer| fold(buffer, 0, FoldKind::Brackets));
+        editor.set_cursor(cosmic_text::Cursor::new(0, "fn main() {".len()));
+        assert!(reveal_join(&mut editor, true, false));
+        assert_eq!(hidden(&editor), Vec::<usize>::new());
+    }

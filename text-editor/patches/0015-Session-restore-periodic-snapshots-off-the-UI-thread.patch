 /// Backup state of one tab.
 #[derive(Debug)]
 struct Record {
     id: String,
-    /// Hash of the text in the backup file.
+    /// Hash of the text in the backup file. Updated only after a successful write, so a failed
+    /// write is retried, and quit (which writes again) asks to save if it still fails.
     hash: Option<u64>,
     file_modified: Option<u64>,
 }
 
+/// One unsaved text, copied on the UI thread, to hash and write in the background.
+#[derive(Debug)]
+struct Draft {
+    entity: Entity,
+    /// Index of its tab in the session file.
+    tab: usize,
+    id: String,
+    text: String,
+    saved_hash: Option<u64>,
+    saved_modified: Option<u64>,
+    path: Option<PathBuf>,
+}
+
+/// A snapshot: the session file and the drafts it needs.
+#[derive(Debug)]
+pub struct Job {
+    generation: u64,
+    session: SessionFile,
+    drafts: Vec<Draft>,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum DraftOutcome {
+    Unchanged,
+    Written {
+        hash: u64,
+        file_modified: Option<u64>,
+    },
+    Failed,
+}
+
+#[derive(Clone, Debug)]
+pub struct JobResult {
+    generation: u64,
+    /// A newer snapshot was written first, or restore was switched off: nothing written.
+    stale: bool,
+    drafts: Vec<(Entity, String, DraftOutcome)>,
+    error: Option<String>,
+}
+
+impl Job {
+    /// Write the changed drafts, then the session file, which lists a draft only once it is on
+    /// disk. Runs under the store's lock, so there is never more than one writer.
+    pub fn run(self, store: &mut Store) -> JobResult {
+        let mut result = JobResult {
+            generation: self.generation,
+            stale: false,
+            drafts: Vec::with_capacity(self.drafts.len()),
+            error: None,
+        };
+        if store.cleared || self.generation <= store.generation {
+            result.stale = true;
+            return result;
+        }
+        store.generation = self.generation;
+        store.writing = self.drafts.iter().map(|draft| draft.id.clone()).collect();
+        let mut session = self.session;
+        for draft in self.drafts {
+            let hash = text_hash(&draft.text);
+            // Compare with the file, not with the tab's record: a background write may have
+            // changed the file since the record was copied (undo during a write)
+            let saved = store
+                .on_disk
+                .get(&draft.id)
+                .copied()
+                .or(draft.saved_hash.map(|hash| OnDisk {
+                    hash: Some(hash),
+                    file_modified: draft.saved_modified,
+                }));
+            let (outcome, on_disk) = if !needs_write(saved.and_then(|saved| saved.hash), hash) {
+                (
+                    DraftOutcome::Unchanged,
+                    saved.map(|saved| saved.file_modified),
+                )
+            } else {
+                match store.write_backup(&draft.id, &draft.text) {
+                    Ok(()) => {
+                        let file_modified = draft.path.as_deref().and_then(modified_secs);
+                        store.on_disk.insert(
+                            draft.id.clone(),
+                            OnDisk {
+                                hash: Some(hash),
+                                file_modified,
+                            },
+                        );
+                        (
+                            DraftOutcome::Written {
+                                hash,
+                                file_modified,
+                            },
+                            Some(file_modified),
+                        )
+                    }
+                    Err(err) => {
+                        log::warn!("failed to write backup of {:?}: {}", draft.path, err);
+                        result.error = Some(err.to_string());
+                        // The older draft, if any, stays listed: better than none. Its text is
+                        // unknown now, so the next snapshot writes again
+                        if let Some(saved) = saved {
+                            store.on_disk.insert(
+                                draft.id.clone(),
+                                OnDisk {
+                                    hash: None,
+                                    ..saved
+                                },
+                            );
+                        }
+                        (DraftOutcome::Failed, saved.map(|saved| saved.file_modified))
+                    }
+                }
+            };
+            if let (Some(file_modified), Some(tab)) = (on_disk, session.tabs.get_mut(draft.tab)) {
+                tab.backup = Some(draft.id.clone());
+                tab.file_modified = file_modified;
+            }
+            result.drafts.push((draft.entity, draft.id, outcome));
+        }
+        if let Err(err) = store.save(session) {
+            log::warn!("failed to save session: {}", err);
+            result.error = Some(err.to_string());
+        }
+        store.writing.clear();
+        result
+    }
+}
+
+/// A snapshot that must be on disk: a skipped one counts as failed, so quit asks to save.
+fn sync_outcome(result: &JobResult) -> io::Result<()> {
+    match &result.error {
+        Some(err) => Err(io::Error::other(err.clone())),
+        None if result.stale => Err(io::Error::other("snapshot skipped")),
+        None => Ok(()),
+    }
+}
+
+fn lock(store: &Mutex<Store>) -> MutexGuard<'_, Store> {
+    store
+        .lock()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+}

+    /// Snapshot now and wait for it: quit must know that every draft is on disk before exiting.
+    pub fn session_snapshot(&mut self) -> io::Result<()> {
+        if !self.session_enabled() {
+            return Ok(());
+        }
+        let job = self.session_job();
+        self.session.unsaved = None;
+        let store = Arc::clone(self.session.store.as_ref().unwrap());
+        // Waits for a background snapshot still running, then writes after it
+        let result = job.run(&mut lock(&store));
+        self.session.finish(&result, Instant::now());
+        sync_outcome(&result)
+    }
+
+    /// Snapshot in the background, one at a time; a request while one runs follows after it.
+    pub fn session_snapshot_task(&mut self) -> Task<AppMessage> {
+        if !self.session_enabled() {
+            return Task::none();
+        }
+        self.session.unsaved = None;
+        if self.session.writing {
+            self.session.again = true;
+            return Task::none();
+        }
+        let job = self.session_job();
+        let generation = job.generation;
+        let store = Arc::clone(self.session.store.as_ref().unwrap());
+        self.session.writing = true;
+        Task::perform(
+            tokio::task::spawn_blocking(move || job.run(&mut lock(&store))),
+            move |res| {
+                let result = res.unwrap_or_else(|err| {
+                    log::warn!("session snapshot failed: {}", err);
+                    JobResult {
+                        generation,
+                        stale: true,
+                        drafts: Vec::new(),
+                        error: Some(err.to_string()),
+                    }
+                });
+                action::app(Message::Written(result).into())
+            },
+        )
+    }
+
+    /// Check again when the next snapshot is due.
+    fn session_timer(&mut self) -> Task<AppMessage> {
+        let now = Instant::now();
+        if snapshot_due(now, self.session.unsaved) {
+            return self.session_snapshot_task();
+        }
+        match snapshot_wait(now, self.session.unsaved) {
+            Some(wait) if !self.session.timer => {
+                self.session.timer = true;
+                Task::perform(tokio::time::sleep(wait), |()| {
+                    action::app(Message::Tick.into())
+                })
+            }
+            _ => Task::none(),
         }

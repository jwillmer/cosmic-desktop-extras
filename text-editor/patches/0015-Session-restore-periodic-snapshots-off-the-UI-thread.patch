+/// Edits not in a snapshot yet: when the first and the last of them happened.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Unsaved {
+    first: Instant,
+    last: Instant,
+}
+
+impl Unsaved {
+    pub fn edited(unsaved: Option<Self>, now: Instant) -> Self {
+        Self {
+            first: unsaved.map_or(now, |unsaved| unsaved.first),
+            last: now,
+        }
+    }
+}
+
+/// How long until the next snapshot is due: `IDLE_DELAY` after typing pauses, but no later than
+/// `MAX_WAIT` after the first unsaved edit, so typing without pause is still saved. `None` when
+/// nothing changed since the last snapshot.
+pub fn snapshot_wait(now: Instant, unsaved: Option<Unsaved>) -> Option<Duration> {
+    let unsaved = unsaved?;
+    let due = (unsaved.last + IDLE_DELAY).min(unsaved.first + MAX_WAIT);
+    Some(due.saturating_duration_since(now))
+}
+
+pub fn snapshot_due(now: Instant, unsaved: Option<Unsaved>) -> bool {
+    snapshot_wait(now, unsaved) == Some(Duration::ZERO)
+}

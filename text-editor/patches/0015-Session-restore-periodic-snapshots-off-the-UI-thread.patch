     /// were, so their drafts are never deleted.
     kept: Vec<SessionTab>,
-    pending: bool,
+    unsaved: Option<Unsaved>,
+    /// A wake-up to check `snapshot_wait` is scheduled.
+    timer: bool,
+    /// A background snapshot runs; `again` asks for another one when it ends.
+    writing: bool,
+    again: bool,
+    /// Generation of the last snapshot started, and of the last result applied.
+    generation: u64,
+    applied: u64,
+}
+
+impl Session {
+    /// Take in a finished snapshot. A result older than one already applied is ignored. A draft
+    /// that failed counts as a new edit, so the timer tries again.
+    fn finish(&mut self, result: &JobResult, now: Instant) -> bool {
+        if result.stale || result.generation <= self.applied {
+            return false;
+        }
+        self.applied = result.generation;
+        for (entity, id, outcome) in &result.drafts {
+            if let DraftOutcome::Written {
+                hash,
+                file_modified,
+            } = outcome
+                && let Some(record) = self.records.get_mut(entity)
+                && record.id == *id
+            {
+                record.hash = Some(*hash);
+                record.file_modified = *file_modified;
+            }
+        }
+        if result
+            .drafts
+            .iter()
+            .any(|(_, _, outcome)| *outcome == DraftOutcome::Failed)
+        {
+            self.unsaved = Some(Unsaved::edited(self.unsaved, now));
+        }
+        true
+    }
 }
 

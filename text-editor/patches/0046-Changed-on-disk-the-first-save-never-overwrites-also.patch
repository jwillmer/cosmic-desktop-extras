             }
             Err(err) => return Err(err),
         };
-        let modified = metadata.modified()?;
-        if let Some((cached_modified, len, hash)) = self.stat
-            && cached_modified == modified
-            && len == metadata.len()
+        let stat = Stat::of(&metadata)?;
+        if let Some((cached, hash)) = self.stat
+            && cached == stat
         {
             return Ok(Some(hash));
         }
@@ -148,7 +164,8 @@ impl DiskWatch {
             Err(err) => return Err(err),
         };
         let hash = hash_bytes(&bytes);
-        self.stat = Some((modified, bytes.len() as u64, hash));
+        // The file may have changed between the stat and the read: cache only a matching length
+        self.stat = Some((stat, hash)).filter(|_| stat.1 == bytes.len() as u64);
         Ok(Some(hash))
     }
 
@@ -168,9 +185,10 @@ impl DiskWatch {
         let hash = hash_bytes(text.as_bytes());
         self.loaded(Some(hash));
         self.stat = fs::metadata(path)
-            .and_then(|metadata| Ok((metadata.modified()?, metadata.len(), hash)))
+            .and_then(|metadata| Stat::of(&metadata))
             .ok()
-            .filter(|(_, len, _)| *len == text.len() as u64);
+            .filter(|stat| stat.1 == text.len() as u64)
+            .map(|stat| (stat, hash));
     }
 
     /// The tab writes to another file now (Save as): base it on what is there.
@@ -183,6 +201,9 @@ impl DiskWatch {
     }
 
     fn show(&mut self, disk: Fingerprint) {
+        if self.bar.is_none() || self.shown_for != disk {
+            self.save_refused = false;
+        }
         self.bar = Some(Bar::for_disk(disk));
         self.shown_for = disk;
     }
@@ -218,13 +239,18 @@ impl DiskWatch {
         action
     }
 
-    /// Whether a save may write over the file on disk: when it is the base, or the version the
-    /// bar is shown for (saving answers the bar like Keep mine). Otherwise the bar shows first.
+    /// Whether a save may write over the file on disk: when it is the base, or the version a
+    /// save was already refused for (the second save answers the bar like Keep mine). Otherwise
+    /// the first save only shows the bar, also when the bar is up already: the watcher can show
+    /// it a moment before the save, too late for anyone to have read it.
     pub fn may_write(&mut self, disk: Fingerprint) -> bool {
-        if self.base == Base::of(disk) || (self.bar.is_some() && self.shown_for == disk) {
+        if self.base == Base::of(disk)
+            || (self.bar.is_some() && self.shown_for == disk && self.save_refused)
+        {
             return true;
         }
         self.show(disk);
+        self.save_refused = true;
         false
     }
 }
@@ -372,8 +398,9 @@ mod tests {

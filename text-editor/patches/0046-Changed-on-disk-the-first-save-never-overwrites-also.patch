+    /// Another program saves by writing a temp file and renaming it over ours.
+    fn replace_by_rename(file: &TempFile, text: &str) {
+        let tmp = file.0.with_extension("tmp");
+        fs::write(&tmp, text).unwrap();
+        // The worst case for a stat cache: the same modification time as before
+        let modified = fs::metadata(&file.0).unwrap().modified().unwrap();
+        fs::File::options()
+            .write(true)
+            .open(&tmp)
+            .unwrap()
+            .set_modified(modified)
+            .unwrap();
+        fs::rename(&tmp, &file.0).unwrap();
+    }
+
+    #[test]
+    fn save_after_rename_replace_shows_bar_first() {
+        for (name, theirs) in [("same-size", "two!\n"), ("longer", "two\nthree\n")] {
+            for watcher_first in [false, true] {
+                let file = TempFile::new(&format!("rename-{name}-{watcher_first}"), "one\n");
+                let mut watch = opened(&file);
+                // Our own save fills the stat cache, as before the outside replace
+                assert!(save(&mut watch, &file, "mine\n"));
+                replace_by_rename(&file, theirs);
+                if watcher_first {
+                    let disk = watch.read(&file.0).unwrap();
+                    watch.check(true, disk);
+                    assert_eq!(watch.bar, Some(Bar::Changed), "{name}");
+                }
+                assert!(
+                    !save(&mut watch, &file, "mine 2\n"),
+                    "{name} {watcher_first}"
+                );
+                assert_eq!(fs::read_to_string(&file.0).unwrap(), theirs);
+                assert_eq!(watch.bar, Some(Bar::Changed));
+                assert!(save(&mut watch, &file, "mine 2\n"));
+                assert_eq!(fs::read_to_string(&file.0).unwrap(), "mine 2\n");
+            }
+        }
+    }
+

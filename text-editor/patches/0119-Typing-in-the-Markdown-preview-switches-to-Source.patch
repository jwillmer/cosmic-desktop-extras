+/// The text a key typed in the Preview view inserts: the key's text, or a new line for Enter,
+/// typed without Ctrl, Alt or Super. Keys without text (arrows, Page Up/Down, Home/End) scroll
+/// the preview.
+pub fn typed_text(modifiers: keyboard::Modifiers, key: &Key, text: Option<&str>) -> Option<String> {
+    if modifiers.control() || modifiers.alt() || modifiers.logo() {
+        return None;
+    }
+    match (key, text) {
+        (Key::Named(Named::Enter), _) => Some("\n".to_string()),
+        (Key::Named(_), _) => None,
+        (_, Some(text)) if !text.is_empty() && !text.chars().any(char::is_control) => {
+            Some(text.to_string())
+        }
+        _ => None,
+    }
+}
+
+/// Where typing in the Preview view goes, and what goes before the text: the end of the block
+/// at the top of the preview, which starts at or after `line` (blank lines skipped). A heading
+/// and a list item are blocks of their own. In a code block it is the end of the code, so the
+/// fences stay as they are: a new line in an empty block, a new paragraph after a closing fence
+/// at the end.
+fn type_position(lines: &[&str], line: usize) -> (crate::md_edit::Pos, &'static str) {
+    use crate::md_edit::{Fenced, after_quotes, fenced};
+    let Some(last) = lines.len().checked_sub(1) else {
+        return ((0, 0), "");
+    };
+    let blank = |line: usize| lines[line].trim().is_empty();
+    let end_of = |line: usize| (line, lines[line].len());
+    let fences = fenced(lines, last);
+    let mut start = line.min(last);
+    while start < last && blank(start) && fences[start] == Fenced::Text {
+        start += 1;
+    }
+    if fences[start] == Fenced::Text {
+        if is_rule(lines[start]) {
+            return match start < last {
+                true => type_position(lines, start + 1),
+                false => (end_of(start), "\n\n"),
+            };
+        }
+        let mut end = start;
+        if !is_heading(lines[start]) {
+            while end < last
+                && !blank(end + 1)
+                && fences[end + 1] == Fenced::Text
+                && !starts_block(lines[end + 1])
+            {
+                end += 1;
+            }
+        }
+        return (end_of(end), "");
+    }
+    // The fence that opened this code block: its character and length
+    let open = (0..=start)
+        .rev()
+        .find(|line| fences[*line] == Fenced::Open)
+        .unwrap_or(start);
+    let opening = after_quotes(lines[open]);
+    let fence = opening.chars().next().unwrap_or('`');
+    let fence_len = opening.len() - opening.trim_start_matches(fence).len();
+    let mut end = start;
+    while end < last && fences[end + 1] == Fenced::Inside {
+        end += 1;
+    }
+    let closing = after_quotes(lines[end]);
+    let closing_len = closing.len() - closing.trim_start_matches(fence).len();
+    let closed = end > open && closing_len >= fence_len && closing[closing_len..].trim().is_empty();
+    match closed {
+        // The closing fence at the top: the block after it
+        true if start == end && end < last => type_position(lines, end + 1),
+        true if start == end => (end_of(end), "\n\n"),
+        true if end - 1 > open => (end_of(end - 1), ""),
+        false if end > open => (end_of(end), ""),
+        // No code yet
+        _ => (end_of(open), "\n"),
+    }
+}
+
+/// A thematic break (`---`, `***`, `___`), or the underline of a setext heading (`===`).
+fn is_rule(text: &str) -> bool {
+    let text: String = text.chars().filter(|c| !c.is_whitespace()).collect();
+    text.len() >= 3
+        && ['-', '*', '_', '=']
+            .iter()
+            .any(|c| text.chars().all(|t| t == *c))
+}
+
+/// A line that starts a block of its own after a line of paragraph text: a heading, a list
+/// item that may interrupt a paragraph, a rule, or a setext underline (`-` or `=` alone).
+fn starts_block(text: &str) -> bool {
+    let underline = text.trim();
+    is_heading(text)
+        || crate::md_lists::starts_item(text, true)
+        || is_rule(text)
+        || (!underline.is_empty() && underline.chars().all(|c| c == '-' || c == '='))
+}
+
+/// The cursor after inserting `text` at `at`.
+fn after_insert(at: crate::md_edit::Pos, text: &str) -> crate::md_edit::Pos {
+    match text.rsplit_once('\n') {
+        Some((before, after)) => (at.0 + before.matches('\n').count() + 1, after.len()),
+        None => (at.0, at.1 + text.len()),
+    }
+}

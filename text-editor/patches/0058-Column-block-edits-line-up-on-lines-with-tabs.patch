+        let mut editor = editor("abcdefgh\n\tabcd\nab\tcd\n");
+        delete(&mut editor, &block((0, 2), (2, 5)), false);
+        // Columns 2..5 go on every line, what was at column 5 is now at column 2
+        assert_eq!(editor_text(&editor), "abfgh\n  bcd\nabd\n");
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abcdefgh\n\tabcd\nab\tcd\n");
+    }

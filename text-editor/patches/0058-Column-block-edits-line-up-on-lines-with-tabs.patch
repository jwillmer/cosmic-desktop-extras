+/// The tab of `text` that reaches across visual column `col` (starts left of it and ends right
+/// of it), as its byte index and visual width
+fn tab_across(text: &str, col: usize, tab_width: usize) -> Option<(usize, usize)> {
+    let mut c_col = 0;
+    for (i, c) in text.char_indices() {
+        if c_col >= col {
+            return None;
+        }
+        let w = char_width(c, c_col, tab_width);
+        if c == '\t' && c_col + w > col {
+            return Some((i, w));
+        }
+        c_col += w;
+    }
+    None
+}
+
+/// `text` with the tabs reaching across any of `cols` replaced by spaces of the same width
+fn split_tabs(text: &str, cols: &[usize], tab_width: usize) -> String {
+    let mut text = text.to_string();
+    for &col in cols {
+        if let Some((i, w)) = tab_across(&text, col, tab_width) {
+            text.replace_range(i..i + 1, &" ".repeat(w));
+        }
+    }
+    text
+}
+
+/// Replace the tabs of `line` reaching across any of `cols` by spaces of the same width, as
+/// part of the current change, so an edit at those columns lands exactly there
+fn split_tabs_at<'buffer, E: Edit<'buffer>>(editor: &mut E, line: usize, cols: &[usize]) {
+    let tab_width = editor.tab_width() as usize;
+    for &col in cols {
+        let tab =
+            editor.with_buffer(|buffer| tab_across(buffer.lines.get(line)?.text(), col, tab_width));
+        if let Some((i, w)) = tab {
+            editor.delete_range(Cursor::new(line, i), Cursor::new(line, i + 1));
+            editor.insert_at(Cursor::new(line, i), &" ".repeat(w), None);
+        }
+    }
+}

+    #[test]
+    fn block_paste_lands_at_visual_column_after_tabs() {
+        let mut editor = editor("abcdefg\n\tab\nab\tcd\nx\tyz");
+        editor.set_cursor(Cursor::new(0, 3));
+        paste_block(&mut editor, "1\n2\n3\n4");
+        // Every row starts at column 3; a tab reaching across it becomes spaces first
+        assert_eq!(editor_text(&editor), "abc1defg\n   2 ab\nab 3 cd\nx  4 yz");
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abcdefg\n\tab\nab\tcd\nx\tyz");
+    }
+
+    #[test]
+    fn typing_in_block_with_tabs_lines_up() {
+        let mut editor = editor("abcdef\n\tx\nab\tcd\n");
+        let b = insert(&mut editor, &block((0, 2), (2, 2)), "|");
+        // Inside a tab it is split; at the start of a tab the text goes in before it
+        assert_eq!(editor_text(&editor), "ab|cdef\n  |  x\nab|\tcd\n");
+        assert_eq!(b, block((0, 3), (2, 3)));
+        editor.undo();
+        assert_eq!(editor_text(&editor), "abcdef\n\tx\nab\tcd\n");
+    }
+
+    #[test]
+    fn block_copy_with_tabs_copies_visual_columns() {
+        let editor = editor("abcdefgh\n\tx\nab\tcd\n");
+        // The covered part of a tab cut by an edge is copied as spaces, a whole tab as a tab
+        assert_eq!(copy(&editor, &block((0, 2), (2, 5))), "cde\n  x\n\tc");
+        assert_eq!(copy(&editor, &block((2, 0), (2, 3))), "ab ");
+        // Copying leaves the text alone
+        assert_eq!(editor_text(&editor), "abcdefgh\n\tx\nab\tcd\n");
+    }
+

+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Mermaid diagrams (```` ```mermaid ```` blocks) drawn in the preview, rendered to SVG in process
+//! by `mermaid-rs-renderer`; nothing is fetched and no script runs. A block that does not render
+//! stays a code block.
+
+use cosmic::widget::svg;
+use std::{
+    collections::HashMap,
+    hash::{DefaultHasher, Hash, Hasher},
+    panic::{AssertUnwindSafe, catch_unwind},
+    sync::Mutex,
+};
+
+/// Longer blocks stay code: laying them out would stall typing in Split.
+const MAX_LEN: usize = 50_000;
+
+/// Rendered diagrams by colour scheme and code, so a re-parse while typing in Split only renders
+/// the diagrams that changed.
+#[derive(Default)]
+pub struct Cache {
+    entries: Mutex<HashMap<u64, Entry>>,
+}
+
+struct Entry {
+    /// `None` when the code does not render.
+    svg: Option<svg::Handle>,
+    /// Shown since the last sweep.
+    used: bool,
+}
+
+impl Cache {
+    /// The diagram of `code`, `None` when it stays a code block.
+    pub fn get(&self, dark: bool, code: &str) -> Option<svg::Handle> {
+        let mut hasher = DefaultHasher::new();
+        (dark, code).hash(&mut hasher);
+        let mut entries = self.entries.lock().unwrap();
+        let entry = entries.entry(hasher.finish()).or_insert_with(|| Entry {
+            svg: render(code, dark).map(|svg| svg::Handle::from_memory(svg.into_bytes())),
+            used: false,
+        });
+        entry.used = true;
+        entry.svg.clone()
+    }
+
+    /// After a parse: forget the diagrams not shown since the previous parse.
+    pub fn sweep(&mut self) {
+        let entries = self.entries.get_mut().unwrap();
+        entries.retain(|_, entry| entry.used);
+        for entry in entries.values_mut() {
+            entry.used = false;
+        }
+    }
+}
+
+/// Whether a fenced block's info string names Mermaid.
+pub fn is_mermaid(language: &str) -> bool {
+    language
+        .split(|c: char| c == ',' || c == '{' || c.is_whitespace())
+        .next()
+        .is_some_and(|token| token.eq_ignore_ascii_case("mermaid"))
+}
+
+/// The SVG of a diagram, in colours for a dark or light background; `None` for code that does
+/// not parse, is too long, or makes the renderer panic.
+pub fn render(code: &str, dark: bool) -> Option<String> {
+    if code.trim().is_empty() || code.len() > MAX_LEN {
+        return None;
+    }
+    let options = mermaid_rs_renderer::RenderOptions {
+        theme: if dark {
+            mermaid_rs_renderer::Theme::dark()
+        } else {
+            mermaid_rs_renderer::Theme::modern()
+        },
+        ..Default::default()
+    };
+    match catch_unwind(AssertUnwindSafe(|| {
+        mermaid_rs_renderer::render_strict(code, options)
+    })) {
+        Ok(Ok(svg)) => Some(svg),
+        Ok(Err(err)) => {
+            log::info!("Mermaid diagram shown as code: {err}");
+            None
+        }
+        Err(_) => {
+            log::warn!("Mermaid diagram shown as code: the renderer panicked");
+            None
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    // Behaviours covered:
+    // - flowcharts and sequence diagrams render to SVG, in light and dark colours
+    // - code that is not a diagram stays a code block
+    // - the info string may carry more after the language
+
+    use super::*;
+
+    #[test]
+    fn flowchart_renders() {
+        let svg = render(
+            "flowchart LR\n    A[Start] --> B{Check}\n    B -->|yes| C[Done]\n",
+            false,
+        )
+        .expect("a flowchart renders");
+        assert!(svg.contains("<svg") && svg.contains("Start"));
+        let dark = render("flowchart LR\n    A --> B\n", true).expect("dark renders");
+        assert_ne!(dark, render("flowchart LR\n    A --> B\n", false).unwrap());
+    }
+
+    #[test]
+    fn sequence_diagram_renders() {
+        let svg = render(
+            "sequenceDiagram\n    Alice->>Bob: Hello\n    Bob-->>Alice: Hi\n",
+            false,
+        )
+        .expect("a sequence diagram renders");
+        assert!(svg.contains("<svg") && svg.contains("Hello"));
+    }
+
+    #[test]
+    fn invalid_code_stays_code() {
+        assert!(render("this is not a diagram {{{", false).is_none());
+        assert!(render("   \n", false).is_none());
+        let cache = Cache::default();
+        assert!(cache.get(false, "not a diagram at all").is_none());
+    }
+
+    #[test]
+    fn mermaid_info_string() {
+        assert!(is_mermaid("mermaid"));
+        assert!(is_mermaid("Mermaid {.diagram}"));
+        assert!(!is_mermaid("rust"));
+        assert!(!is_mermaid("mermaidx"));
+    }
+}

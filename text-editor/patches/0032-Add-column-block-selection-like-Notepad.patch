index 0000000..90881b7
--- /dev/null
+++ b/src/column_select.rs
@@ -0,0 +1,293 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Column (block, rectangular) selection like Notepad++: Alt+drag or Alt+Shift+arrows select
+//! the same visual columns on every line between two points, and typing, deleting, copying
+//! and pasting then act on every line of the block at once.
+//!
+//! Columns are visual columns of the logical line: one per character, a tab reaches the next
+//! multiple of the tab width. Wrapping is ignored, so a wrapped line uses the columns of its
+//! whole logical line. A character belongs to the block when it starts inside it, and a line
+//! that ends left of the block contributes nothing.
+
+use cosmic_text::{Cursor, Edit};
+use std::{cell::RefCell, ops::Range};
+
+/// A line and a visual column on it
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Pos {
+    pub line: usize,
+    pub col: usize,
+}
+
+impl Pos {
+    pub fn new(line: usize, col: usize) -> Self {
+        Self { line, col }
+    }
+}
+
+/// A rectangle between the point where the selection started and the moving point
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Block {
+    pub anchor: Pos,
+    pub head: Pos,
+}
+
+impl Block {
+    pub fn new(anchor: Pos, head: Pos) -> Self {
+        Self { anchor, head }
+    }
+
+    /// A zero-width block on the lines `lines` at `col`: a cursor on every line
+    fn cursors(lines: Range<usize>, col: usize) -> Self {
+        let last = lines.end.saturating_sub(1).max(lines.start);
+        Self::new(Pos::new(lines.start, col), Pos::new(last, col))
+    }
+
+    pub fn top(&self) -> usize {
+        self.anchor.line.min(self.head.line)
+    }
+
+    pub fn bottom(&self) -> usize {
+        self.anchor.line.max(self.head.line)
+    }
+
+    pub fn left(&self) -> usize {
+        self.anchor.col.min(self.head.col)
+    }
+
+    pub fn right(&self) -> usize {
+        self.anchor.col.max(self.head.col)
+    }
+
+    pub fn height(&self) -> usize {
+        self.bottom() - self.top() + 1
+    }
+
+    /// The block has no width: typing inserts on every line
+    pub fn is_empty(&self) -> bool {
+        self.left() == self.right()
+    }
+}
+
+thread_local! {
+    /// The text of the last block copied, so pasting it is recognised as a block paste
+    static LAST_COPY: RefCell<Option<String>> = const { RefCell::new(None) };
+}
+
+/// Width of `c` when it starts at visual column `col`
+fn char_width(c: char, col: usize, tab_width: usize) -> usize {
+    if c == '\t' {
+        let tab_width = tab_width.max(1);
+        tab_width - col % tab_width
+    } else {
+        1
+    }
+}
+
+/// Visual width of `text` starting at column 0
+pub fn width(text: &str, tab_width: usize) -> usize {
+    text.chars()
+        .fold(0, |col, c| col + char_width(c, col, tab_width))
+}
+
+/// Visual column where the character at byte `index` of `text` starts
+pub fn col_of(text: &str, index: usize, tab_width: usize) -> usize {
+    width(&text[..index.min(text.len())], tab_width)
+}
+
+/// Byte index of the first character boundary at or right of visual column `col`
+fn index_at(text: &str, col: usize, tab_width: usize) -> usize {
+    let mut c_col = 0;
+    for (i, c) in text.char_indices() {
+        if c_col >= col {
+            return i;
+        }
+        c_col += char_width(c, c_col, tab_width);
+    }
+    text.len()
+}
+
+/// Byte range of `text` inside the columns `left..right`, or `None` when the line ends left
+/// of `left`
+pub fn line_range(text: &str, left: usize, right: usize, tab_width: usize) -> Option<Range<usize>> {
+    if width(text, tab_width) < left {
+        return None;
+    }
+    Some(index_at(text, left, tab_width)..index_at(text, right, tab_width))
+}
+
+/// The byte range of every line of `block` that exists in the buffer, `None` for short lines
+pub fn ranges<'buffer, E: Edit<'buffer>>(
+    editor: &E,
+    block: &Block,
+) -> Vec<(usize, Option<Range<usize>>)> {
+    let tab_width = editor.tab_width() as usize;
+    editor.with_buffer(|buffer| {
+        (block.top()..=block.bottom())
+            .filter_map(|line| {
+                let text = buffer.lines.get(line)?.text();
+                Some((
+                    line,
+                    line_range(text, block.left(), block.right(), tab_width),
+                ))
+            })
+            .collect()
+    })
+}
+
+/// The text of the block, one line per line of the block (empty for short lines)
+pub fn copy<'buffer, E: Edit<'buffer>>(editor: &E, block: &Block) -> String {
+    let ranges = ranges(editor, block);
+    let rows: Vec<String> = editor.with_buffer(|buffer| {
+        ranges
+            .into_iter()
+            .map(|(line, range)| match range {
+                Some(range) => buffer.lines[line].text()[range].to_string(),
+                None => String::new(),
+            })
+            .collect()
+    });
+    let text = rows.join("\n");
+    LAST_COPY.with(|last| *last.borrow_mut() = Some(text.clone()));
+    text
+}
+
+/// Put the cursor of `editor` at the moving point of `block`
+pub fn place_cursor<'buffer, E: Edit<'buffer>>(editor: &mut E, block: &Block) {
+    let tab_width = editor.tab_width() as usize;
+    let cursor = editor.with_buffer(|buffer| {
+        let line = block.head.line.min(buffer.lines.len().saturating_sub(1));
+        let text = buffer.lines.get(line).map_or("", |l| l.text());
+        Cursor::new(line, index_at(text, block.head.col, tab_width))
+    });
+    editor.set_cursor(cursor);
+    editor.set_redraw(true);
+}
+
+/// Start a block at the cursor of `editor`, or move the head of `block` by `lines` and `cols`
+pub fn extend<'buffer, E: Edit<'buffer>>(
+    editor: &mut E,
+    block: Option<Block>,
+    lines: isize,
+    cols: isize,
+) -> Block {
+    let tab_width = editor.tab_width() as usize;
+    let mut block = block.unwrap_or_else(|| {
+        let cursor = editor.cursor();
+        let col = editor.with_buffer(|buffer| {
+            col_of(buffer.lines[cursor.line].text(), cursor.index, tab_width)
+        });
+        let pos = Pos::new(cursor.line, col);
+        Block::new(pos, pos)
+    });
+    let last = editor.with_buffer(|buffer| buffer.lines.len().saturating_sub(1));
+    block.head.line = block.head.line.saturating_add_signed(lines).min(last);
+    block.head.col = block.head.col.saturating_add_signed(cols);
+    place_cursor(editor, &block);
+    block
+}
+
+/// Replace the block on every line with `text` (without line breaks), as part of the current
+/// change. Lines are edited from the bottom up, so the indices of the others stay valid.
+fn replace_each<'buffer, E: Edit<'buffer>>(editor: &mut E, block: &Block, text: &str) {
+    for (line, range) in ranges(editor, block).into_iter().rev() {
+        let Some(range) = range else { continue };
+        if !range.is_empty() {
+            editor.delete_range(Cursor::new(line, range.start), Cursor::new(line, range.end));
+        }
+        if !text.is_empty() {
+            editor.insert_at(Cursor::new(line, range.start), text, None);
+        }
+    }
+}
+
+/// Type `text` on every line of the block, replacing what it selects, as one undo step.
+/// Returns the zero-width block after the inserted text.
+pub fn insert<'buffer, E: Edit<'buffer>>(editor: &mut E, block: &Block, text: &str) -> Block {
+    let tab_width = editor.tab_width() as usize;
+    editor.start_change();
+    replace_each(editor, block, text);
+    editor.finish_change();
+    let block = Block::cursors(
+        block.top()..block.bottom() + 1,
+        block.left() + width(text, tab_width),
+    );
+    place_cursor(editor, &block);
+    block
+}
+
+/// Backspace (`forward` false) or Delete (`forward` true): remove the block, or with a
+/// zero-width block one character before or after it on every line, as one undo step.
+pub fn delete<'buffer, E: Edit<'buffer>>(editor: &mut E, block: &Block, forward: bool) -> Block {
+    if !block.is_empty() {
+        return insert(editor, block, "");
+    }
+    let tab_width = editor.tab_width() as usize;
+    let mut new_col = block.left();
+    editor.start_change();
+    for (line, range) in ranges(editor, block).into_iter().rev() {
+        let Some(range) = range else { continue };
+        let text = editor.with_buffer(|buffer| buffer.lines[line].text().to_string());
+        let at = range.start;
+        let span = if forward {
+            text[at..].chars().next().map(|c| at..at + c.len_utf8())
+        } else {
+            text[..at]
+                .chars()
+                .next_back()
+                .map(|c| at - c.len_utf8()..at)
+        };
+        if let Some(span) = span {
+            if !forward {
+                new_col = new_col.min(col_of(&text, span.start, tab_width));
+            }
+            editor.delete_range(Cursor::new(line, span.start), Cursor::new(line, span.end));
+        }
+    }
+    editor.finish_change();
+    let block = Block::cursors(block.top()..block.bottom() + 1, new_col);
+    place_cursor(editor, &block);
+    block
+}
+
+/// Paste `text` into the block as one undo step. A block copied before, or as many lines as
+/// the block has, goes in line by line from the top line down (continuing below the block when
+/// there are more); any other text replaces the block on every line. Returns the block to keep
+/// for one line of text, `None` for line by line.
+pub fn paste<'buffer, E: Edit<'buffer>>(
+    editor: &mut E,
+    block: &Block,
+    text: &str,
+) -> Option<Block> {
+    let text = text.replace("\r\n", "\n");
+    let rows: Vec<&str> = text.split('\n').collect();
+    let is_block = LAST_COPY.with(|last| last.borrow().as_deref() == Some(text.as_str()));
+    if rows.len() == 1 || !(is_block || rows.len() == block.height()) {
+        return Some(insert(editor, block, &text));
+    }
+    let line_count = editor.with_buffer(|buffer| buffer.lines.len());
+    if block.top() >= line_count {
+        return Some(*block);
+    }
+    editor.start_change();
+    for (i, row) in rows.iter().enumerate().rev() {
+        let line = block.top() + i;
+        if line >= line_count {
+            continue;
+        }
+        // Below the block the paste replaces nothing
+        let right = if line <= block.bottom() {
+            block.right()
+        } else {
+            block.left()
+        };
+        let one = Block::new(Pos::new(line, block.left()), Pos::new(line, right));
+        replace_each(editor, &one, row);
+    }
+    editor.finish_change();
+    let last = (block.top() + rows.len()).min(line_count).saturating_sub(1);
+    let tab_width = editor.tab_width() as usize;
+    let col = block.left() + width(rows[last - block.top()], tab_width);
+    place_cursor(editor, &Block::cursors(last..last + 1, col));
+    None
+}

+/// Draw a column selection in the selection colour: the selected characters of every line, or a
+/// thin bar where typing inserts on a zero-width block. A wrapped line is drawn on every row
+/// that holds part of the range.
+fn draw_column_block(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    block: &Block,
+    line_height: f32,
+) {
+    let color = editor.selection_color();
+    let ranges = column_select::ranges(editor, block);
+    let bar_w = (line_height / 10.0).round().max(1.0);
+    editor.with_buffer(|buffer| {
+        for run in buffer.layout_runs() {
+            let Some(range) = run
+                .line_i
+                .checked_sub(block.top())
+                .and_then(|i| ranges.get(i))
+                .and_then(|(_, range)| range.clone())
+            else {
+                continue;
+            };
+            let start = Cursor::new(run.line_i, range.start);
+            if range.is_empty() {
+                if let Some(x) = run.cursor_position(&start) {
+                    renderer.rectangle(
+                        x as i32,
+                        run.line_top as i32,
+                        bar_w as u32,
+                        line_height as u32,
+                        color,
+                    );
+                }
+                continue;
+            }
+            for (x, w) in run.highlight(start, Cursor::new(run.line_i, range.end)) {
+                let left = x.floor();
+                renderer.rectangle(
+                    left as i32,
+                    run.line_top as i32,
+                    (x + w - left).ceil() as u32,
+                    line_height as u32,
+                    color,
+                );
+            }
+        }
+    });
+}
+
+/// The line and visual column at `x`, `y` (buffer pixels). Right of the end of a line the
+/// empty columns count too, so a block can reach past short lines.
+fn column_pos(editor: &ViEditor<'static, 'static>, x: f32, y: f32) -> Option<Pos> {
+    let tab_width = editor.tab_width() as usize;
+    editor.with_buffer(|buffer| {
+        let cursor = buffer.hit(x, y)?;
+        let text = buffer.lines.get(cursor.line)?.text();
+        let mut col = column_select::col_of(text, cursor.index, tab_width);
+        if cursor.index == text.len() {
+            let char_w = buffer
+                .layout_runs()
+                .find_map(|run| run.glyphs.first().map(|glyph| glyph.w))
+                .unwrap_or(buffer.metrics().font_size * 0.6)
+                .max(1.0);
+            let end_x = buffer
+                .layout_runs()
+                .filter(|run| run.line_i == cursor.line)
+                .find_map(|run| run.cursor_position(&cursor));
+            if let Some(end_x) = end_x
+                && x > end_x
+            {
+                col += ((x - end_x) / char_w).round() as usize;
+            }
+        }
+        Some(Pos::new(cursor.line, col))
+    })
+}
+
+/// Start (`drag` false) or extend a column selection to `x`, `y` (buffer pixels).
+fn column_press(
+    column: &Mutex<Option<Block>>,
+    editor: &mut ViEditor<'static, 'static>,
+    x: f32,
+    y: f32,
+    drag: bool,
+) {
+    let Some(pos) = column_pos(editor, x, y) else {
+        return;
+    };
+    let mut column = column.lock().unwrap();
+    let block = match *column {
+        Some(block) if drag => Block::new(block.anchor, pos),
+        _ => Block::new(pos, pos),
+    };
+    editor.set_selection(Selection::None);
+    column_select::place_cursor(editor, &block);
+    *column = Some(block);
+}
+
+/// Handle a key for column selection: Alt+Shift+arrows start or extend it, and while it is
+/// active typing, Backspace and Delete act on every line. Navigation keys leave it and go on
+/// to their usual action. Returns true when the key was used up.
+fn column_key(
+    column: &Mutex<Option<Block>>,
+    editor: &mut ViEditor<'static, 'static>,
+    event: &Event,
+) -> bool {
+    let Event::Keyboard(KeyEvent::KeyPressed {
+        modified_key,
+        modifiers,
+        text,
+        ..
+    }) = event
+    else {
+        return false;
+    };
+    let mut column = column.lock().unwrap();
+    if modifiers.alt() && modifiers.shift() {
+        let step = match modified_key {
+            Key::Named(Named::ArrowUp) => Some((-1, 0)),
+            Key::Named(Named::ArrowDown) => Some((1, 0)),
+            Key::Named(Named::ArrowLeft) => Some((0, -1)),
+            Key::Named(Named::ArrowRight) => Some((0, 1)),
+            _ => None,
+        };
+        if let Some((lines, cols)) = step {
+            editor.set_selection(Selection::None);
+            *column = Some(column_select::extend(editor, *column, lines, cols));
+            return true;
+        }
+    }
+    let Some(block) = *column else {
+        return false;
+    };
+    let shortcut = modifiers.control() || modifiers.alt() || modifiers.logo();

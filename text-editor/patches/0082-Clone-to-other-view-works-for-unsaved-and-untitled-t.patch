+impl Mirror {
+    /// The groups of more than one tab, from every editor tab and its path.
+    pub fn groups(
+        &self,
+        tabs: impl IntoIterator<Item = (Entity, Option<PathBuf>)>,
+    ) -> HashMap<Key, Vec<Entity>> {
+        let mut groups: HashMap<Key, Vec<Entity>> = HashMap::new();
+        for (entity, path) in tabs {
+            let key = match (self.links.get(&entity), path) {
+                (Some(link), _) => Key::Link(*link),
+                (None, Some(path)) => Key::Path(path),
+                (None, None) => continue,
+            };
+            groups.entry(key).or_default().push(entity);
+        }
+        groups.retain(|_, tabs| tabs.len() > 1);
+        groups
+    }
+
+    /// Pair `clone` with `group` (a tab and the clones it has already). `synced` is the hash of
+    /// the text they share, when known: they start identical, so neither counts as edited.
+    pub fn link(&mut self, group: &[Entity], clone: Entity, synced: Option<u64>) -> Key {
+        let link = group
+            .iter()
+            .find_map(|entity| self.links.get(entity).copied())
+            .unwrap_or_else(|| {
+                self.next_link += 1;
+                self.next_link
+            });
+        for entity in group.iter().chain([&clone]) {
+            self.links.insert(*entity, link);
+        }
+        let key = Key::Link(link);
+        self.unpaired.remove(&key);
+        match synced {
+            Some(hash) => self.synced.insert(key.clone(), hash),
+            None => self.synced.remove(&key),
+        };
+        key
+    }
+
+    /// The link of a tab paired with others, for the session.
+    pub fn link_of(&self, entity: Entity) -> Option<u64> {
+        self.links.get(&entity).copied()
+    }
 }
 

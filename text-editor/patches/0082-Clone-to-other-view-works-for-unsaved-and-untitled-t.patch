+/// A new tab with the document of `source`: its file, or none for an untitled tab, and its
+/// text with unsaved edits, as one undo step (as a restored draft): undoing it in the clone
+/// takes the group back to the file.
+pub fn clone_tab(source: &EditorTab, config: &crate::Config) -> EditorTab {
+    let mut clone = EditorTab::new(config);
+    if let Some(path) = &source.path_opt {
+        clone.open(path.clone());
+    }
+    if source.changed() {
+        let text = editor_text(&source.editor.lock().unwrap());
+        let mut editor = clone.editor.lock().unwrap();
+        mirror_into(&mut *editor, &text);
+        // The file may hold this text already: it is unsaved in its tab all the same
+        editor.set_changed(true);
+        drop(editor);
+        // The file the unsaved text is based on, not the one on disk now
+        clone.disk_restored(Some(source.disk.base()));
+    }
+    clone
+}
+
+/// Give a clone the path its group was saved as (Save As in another clone).
+pub fn rename(tab: &mut EditorTab, path: &Path) {
+    tab.disk.retarget(path);
+    tab.path_opt = Some(path.to_path_buf());
+    tab.markdown_path_changed();
+}

+/// The restored tabs that are clones of one document, from the session's clone numbers.
+pub fn restored_clones(tabs: &[SessionTab], entities: &[Option<Entity>]) -> Vec<Vec<Entity>> {
+    let mut groups: Vec<(u64, Vec<Entity>)> = Vec::new();
+    for (tab, entity) in tabs.iter().zip(entities) {
+        let (Some(clone), Some(entity)) = (tab.clone, entity) else {
+            continue;
+        };
+        match groups.iter_mut().find(|(id, _)| *id == clone) {
+            Some((_, group)) => group.push(*entity),
+            None => groups.push((clone, vec![*entity])),
+        }
+    }
+    groups
+        .into_iter()
+        .map(|(_, group)| group)
+        .filter(|group| group.len() > 1)
+        .collect()
 }
 

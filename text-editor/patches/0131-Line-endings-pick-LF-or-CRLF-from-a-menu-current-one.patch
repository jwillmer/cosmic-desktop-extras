+/// One entry of the line ending menu: LF or CRLF, checked when the whole file already has
+/// it, disabled when picking it can do nothing.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct LineEndingChoice {
+    pub ending: LineEnding,
+    pub checked: bool,
+    pub enabled: bool,
+}
+
+/// The line ending menu of the status bar and Edit > Line endings: an optional disabled first
+/// line, then LF and CRLF. A file with LF or CRLF throughout has that one checked, and picking
+/// it changes nothing. Mixed, CR and LFCR files get a first line with the counts of the kinds
+/// present (`Mixed: 120 LF, 3 CRLF`) and neither checked; picking one converts every line.
+/// A text without any line break has LF checked, the ending its new lines get; CRLF is
+/// disabled there, as there is no line to convert and new lines follow the file's own ending.
+pub fn line_ending_choices(
+    counts: crate::whitespace::EndingCounts,
+) -> (Option<String>, [LineEndingChoice; 2]) {
+    let endings = counts.endings();
+    let choice = |ending| LineEndingChoice {
+        ending,
+        checked: match endings {
+            FileEndings::None => ending == LineEnding::default(),
+            _ => endings == FileEndings::One(ending),
+        },
+        enabled: endings != FileEndings::None || ending == LineEnding::default(),
+    };
+    let list = |counts: crate::whitespace::EndingCounts| {
+        counts
+            .present()
+            .map(|(ending, count)| format!("{} {}", thousands(count), ending_label(ending)))
+            .collect::<Vec<_>>()
+            .join(", ")
+    };
+    let header = match endings {
+        FileEndings::None => Some(fl!("no-line-breaks")),
+        FileEndings::One(LineEnding::Lf | LineEnding::CrLf) => None,
+        _ => Some(format!("{}: {}", endings.label(), list(counts))),
+    };
+    (header, [choice(LineEnding::Lf), choice(LineEnding::CrLf)])
 }
 

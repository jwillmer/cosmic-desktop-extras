From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Thu, 19 Nov 2026 15:58:52 +0100
Subject: [PATCH 123/151] Go to line in a Preview-only Markdown tab switches to
 Split

In the Preview view the cursor is hidden, so a jump moved it in a source
nobody could see. The tab now switches to Split first, through the same
SetView message as Ctrl+Alt+2, and the source scrolls the line to its
top as the outline does: the editor that comes back does not scroll to
its cursor by itself. The preview follows through the scroll sync.
Source and Split tabs jump as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/goto_line.rs b/src/goto_line.rs
index c17fb92..1169b7c 100644
--- a/src/goto_line.rs
+++ b/src/goto_line.rs
@@ -2,6 +2,8 @@
 
 //! "Go to line": the bar under the text that takes `42` or `42:7` and moves the cursor there.
 
+use crate::markdown::ViewMode;
+
 /// Where to go, 1-based as typed: a line and, after a colon, a column.
 #[derive(Clone, Copy, Debug, Eq, PartialEq)]
 pub struct Target {
@@ -55,10 +57,24 @@ pub fn byte_index(text: &str, column: usize) -> usize {
         .map_or(text.len(), |(index, _)| index)
 }
 
+/// The view to switch a tab to before the jump, `None` to keep it: a Markdown tab that shows
+/// only the Preview gets Split, so the cursor lands where it can be seen.
+pub fn view_for_jump(view: Option<ViewMode>) -> Option<ViewMode> {
+    (view == Some(ViewMode::Preview)).then_some(ViewMode::Split)
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
 
+    #[test]
+    fn preview_only_switches_to_split() {
+        assert_eq!(view_for_jump(Some(ViewMode::Preview)), Some(ViewMode::Split));
+        assert_eq!(view_for_jump(Some(ViewMode::Split)), None);
+        assert_eq!(view_for_jump(Some(ViewMode::Source)), None);
+        assert_eq!(view_for_jump(None), None);
+    }
+
     fn target(line: usize, column: Option<usize>) -> Option<Target> {
         Some(Target { line, column })
     }

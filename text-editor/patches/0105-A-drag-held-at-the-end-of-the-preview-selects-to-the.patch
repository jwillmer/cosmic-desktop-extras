+    #[test]
+    fn a_drag_held_at_the_end_selects_to_the_last_block() {
+        use select::{Action, Spot};
+        let pointer = iced::Point::new(50.0, 499.0);
+        for (markdown, end) in [
+            (
+                "Intro\n\n```\n110\n}\n```\n\n| A | B |\n|---|---|\n| 1 | 2 |\n",
+                "1\t2",
+            ),
+            ("Intro\n\nLast paragraph.\n", "Last paragraph."),
+            ("Intro\n\n- one\n- two\n", "- two"),
+            ("Intro\n\n```\nlet a;\n}\n```\n", "let a;\n}"),
+        ] {
+            let mut preview = Preview::new(ViewMode::Preview);
+            preview.parse(markdown, None);
+            preview.content_height = 2000.0;
+            preview.viewport_height = 500.0;
+            preview.scroll_offset.y = 1500.0;
+            preview.select(Action::Press(Spot::default(), over(1.0)));
+            preview.select(Action::Drag(
+                Spot {
+                    leaf: 1,
+                    grapheme: 1,
+                },
+                over(2.0),
+            ));
+            preview.scroll_speed = Some((10.0, pointer));
+            assert!(preview.drag_scroll().is_none());
+            // Text runs near the pointer do not take it back while it stays at the edge
+            preview.select(Action::Drag(
+                Spot {
+                    leaf: 1,
+                    grapheme: 2,
+                },
+                over(3.0),
+            ));
+            let copied = preview.selected_text(test_settings(), "").unwrap();
+            assert!(copied.ends_with(end), "{copied:?}");
+            assert!(copied.starts_with("Intro"), "{copied:?}");
+            // Back from the edge (its message unpins), the drag follows the pointer again
+            preview.pinned = false;
+            preview.select(Action::Drag(
+                Spot {
+                    leaf: 1,
+                    grapheme: 2,
+                },
+                over(4.0),
+            ));
+            assert_eq!(
+                preview.selection.map(|s| s.focus),
+                Some(Spot {
+                    leaf: 1,
+                    grapheme: 2
+                })
+            );
+        }
+    }
+
     fn test_settings() -> Settings {
         settings(14.0, Font::MONOSPACE)
     }

+    #[test]
+    fn image_in_heading_stays_inline() {
+        let doc = parse("## Logo ![logo](logo.png) here\n\nText.\n");
+        let Block::Inline { pieces, heading } = &doc.blocks[0] else {
+            panic!("expected an inline heading");
+        };
+        assert_eq!(*heading, Some(2));
+        assert_eq!(texts(pieces), "Logo [img] here");
+        assert!(doc.images.contains("logo.png"));
+    }

+    /// The items of a list, each parsed again as a document of its own.
+    fn list_items(&mut self, text: &str, events: &[(Event, Range<usize>)]) -> Vec<ListItem> {
+        let mut items = Vec::new();
+        let mut index = 0;
+        while index < events.len() {
+            let end = end_of(events, index);
+            if let (Event::Start(Tag::Item), item) = &events[index] {
+                let first = (index + 1 < end).then(|| &events[index + 1]);
+                // Continuation lines are indented to where the content of the first line starts
+                let content = first.map_or(item.end, |(_, range)| range.start);
+                let line_start = text[..item.start].rfind('\n').map_or(0, |at| at + 1);
+                let indent = content.saturating_sub(line_start);
+                let (task, start) = match first {
+                    Some((Event::TaskListMarker(done), marker)) => (Some(*done), marker.end),
+                    _ => (None, content),
+                };
+                let body = item_body(text, item.clone(), start, indent);
+                items.push(ListItem {
+                    task,
+                    blocks: self.pass.blocks(&body),
+                });
+            }
+            index = end + 1;
+        }
+        items
+    }
+
+    /// The header cells and the rows of a table.
+    #[allow(clippy::type_complexity)]
+    fn table(
+        &mut self,
+        events: &[(Event, Range<usize>)],
+    ) -> (Vec<Vec<Piece>>, Vec<Vec<Vec<Piece>>>) {
+        let mut header = Vec::new();
+        let mut rows: Vec<Vec<Vec<Piece>>> = Vec::new();
+        let mut in_header = false;
+        let mut index = 0;
+        while index < events.len() {
+            match &events[index].0 {
+                Event::Start(Tag::TableHead) => in_header = true,
+                Event::End(TagEnd::TableHead) => in_header = false,
+                Event::Start(Tag::TableRow) => rows.push(Vec::new()),
+                Event::Start(Tag::TableCell) => {
+                    let end = end_of(events, index);
+                    for (event, _) in &events[index + 1..end] {
+                        self.inline_event(event);
+                    }
+                    let cell = std::mem::take(&mut self.top().pieces);
+                    match rows.last_mut() {
+                        Some(row) if !in_header => row.push(cell),
+                        _ => header.push(cell),
+                    }
+                    index = end;
+                }
+                _ => {}
+            }
+            index += 1;
+        }
+        (header, rows)
+    }

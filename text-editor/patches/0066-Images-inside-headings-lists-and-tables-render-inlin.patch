+    #[test]
+    fn image_in_list_item_stays_inline() {
+        let doc =
+            parse("3. First ![a](a.png) item\n4. Second item\n   - nested ![b](b.png)\n\nAfter.\n");
+        let [Block::List { start, items }, Block::Markdown(_)] = doc.blocks.as_slice() else {
+            panic!("expected a list, then Markdown");
+        };
+        assert_eq!(*start, Some(3));
+        assert_eq!(items.len(), 2);
+        assert_eq!(texts(inline(&items[0].blocks[0])), "First [img] item");
+        // The nested list is unindented and parsed as a list of its own
+        let [
+            Block::Markdown(_),
+            Block::List {
+                start: None,
+                items: nested,
+            },
+        ] = items[1].blocks.as_slice()
+        else {
+            panic!("expected text, then a nested list");
+        };
+        assert_eq!(texts(inline(&nested[0].blocks[0])), "nested [img]");
+        assert!(doc.images.contains("a.png") && doc.images.contains("b.png"));
+    }

+/// Whether the events hold a Markdown image or an `<img>` tag.
+fn has_image(events: &[(Event, Range<usize>)]) -> bool {
+    events.iter().any(|(event, _)| match event {
+        Event::Start(Tag::Image { .. }) => true,
+        Event::InlineHtml(html) | Event::Html(html) => is_tag(html, "img"),
+        _ => false,
+    })
+}
+
+/// The Markdown of a list item whose content starts at `start`, continuation lines unindented by
+/// up to `indent` spaces.
+fn item_body(text: &str, item: Range<usize>, start: usize, indent: usize) -> String {
+    text[start.clamp(item.start, item.end)..item.end]
+        .lines()
+        .enumerate()
+        .map(|(index, line)| {
+            if index == 0 {
+                line.trim_start()
+            } else {
+                let spaces = line.len() - line.trim_start_matches(' ').len();
+                &line[spaces.min(indent)..]
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
 fn is_tag(html: &str, name: &str) -> bool {
     html.get(1..=name.len())
         .is_some_and(|tag| tag.eq_ignore_ascii_case(name))

+/// Draw `…` after the header of each fold, as three dots in the editor's text colour.
+fn draw_fold_markers(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    metrics: Metrics,
+) {
+    let mut color = editor.foreground_color();
+    color = cosmic_text::Color::rgba(color.r(), color.g(), color.b(), 160);
+    let dot = (metrics.font_size / 7.0).ceil().max(2.0) as u32;
+    editor.with_buffer(|buffer| {
+        let mut runs = buffer.layout_runs().peekable();
+        while let Some(run) = runs.next() {
+            // The last row of a line followed by a hidden line
+            let next = runs.peek();
+            if folding::is_folded_run(&run)
+                || next.is_some_and(|next| next.line_i == run.line_i)
+                || folding::folded_after(buffer, run.line_i).is_none()
+            {
+                continue;
+            }
+            let x = run.line_w + metrics.font_size / 2.0;
+            let y = run.line_top + metrics.line_height * 0.6;
+            for i in 0..3 {
+                renderer.rectangle(
+                    (x + i as f32 * dot as f32 * 2.0) as i32,
+                    y as i32,
+                    dot,
+                    dot,
+                    color,
+                );
+            }
+        }
+    });
+}
+
+/// After a cursor motion: step over a fold instead of landing inside it.
+fn skip_fold(editor: &mut BorrowedWithFontSystem<'_, ViEditor<'static, 'static>>, from: Cursor) {
+    let to = editor.cursor();
+    let skipped = editor.with_buffer(|buffer| folding::skip_fold(buffer, from, to));
+    if skipped != to {
+        editor.set_cursor(skipped);
+    }
+}

+#[derive(Clone, Copy, Debug)]
+pub enum Message {
+    Fold,
+    Unfold,
+    FoldAll,
+    UnfoldAll,
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::Folding(message)
+    }
+}
+
+impl crate::tab::EditorTab {
+    pub fn fold_kind(&self) -> FoldKind {
+        if self.is_json() {
+            FoldKind::Brackets
+        } else {
+            FoldKind::for_path(self.path_opt.as_deref())
+        }
+    }
+
+    /// Unfold whatever hides the cursor, e.g. after a find hit.
+    pub fn reveal_cursor(&self) {
+        let mut editor = self.editor.lock().unwrap();
+        let line = editor.cursor().line;
+        editor.with_buffer_mut(|buffer| reveal(buffer, line));
+    }
+}
+
+impl App {
+    pub fn update_folding(&mut self, message: Message) -> Task<AppMessage> {
+        let Some(Tab::Editor(tab)) = self.active_tab() else {
+            return Task::none();
+        };
+        let kind = tab.fold_kind();
+        let mut editor = tab.editor.lock().unwrap();
+        let line = editor.cursor().line;
+        editor.with_buffer_mut(|buffer| match message {
+            Message::Fold => {
+                fold(buffer, line, kind);
+            }
+            Message::Unfold => {
+                unfold(buffer, line);
+            }
+            Message::FoldAll => fold_all(buffer, kind),
+            Message::UnfoldAll => unfold_all(buffer),
+        });
+        // Folding the block around the cursor moves it to the header
+        let cursor = editor.cursor();
+        let header = editor.with_buffer(|buffer| skip_fold(buffer, cursor, cursor));
+        editor.set_cursor(header);
+        Task::none()
+    }
+}

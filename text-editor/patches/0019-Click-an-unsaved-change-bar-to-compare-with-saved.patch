+    /// The line whose unsaved change mark is at `p` (in logical pixels relative to the widget).
+    fn change_mark_at(&self, state: &State, p: Point) -> Option<usize> {
+        let marks = self.change_marks?;
+        let scale_factor = state.scale_factor.get();
+        let x = (p.x - self.padding.left) * scale_factor;
+        let y = (p.y - self.padding.top) * scale_factor;
+        let editor = self.editor.lock().unwrap();
+        editor.with_buffer(|buffer| {
+            let line_height = buffer.metrics().line_height;
+            let rows = buffer.layout_runs().map(|run| (run.line_i, run.line_top));
+            change_mark_hit(x, y, state.change_area_w.get(), line_height, rows, marks)
+        })
+    }

+/// Behaviours under test:
+/// - a left click on an unsaved (orange) bar or an unsaved deletion tick opens compare with saved
+/// - a click on a saved (green) bar, or right of the change area, keeps the upstream behaviour
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const AREA_W: i32 = 5;
+    const LINE_H: f32 = 20.0;
+
+    fn mark(line: Mark, deleted_above: Mark) -> LineMark {
+        LineMark {
+            line,
+            deleted_above,
+        }
+    }
+
+    /// Lines 0..3, one row each; line 1 wraps into a second row.
+    fn rows() -> Vec<(usize, f32)> {
+        vec![(0, 0.0), (1, 20.0), (1, 40.0), (2, 60.0)]
+    }
+
+    fn hit(x: f32, y: f32, marks: &[LineMark]) -> Option<usize> {
+        change_mark_hit(x, y, AREA_W, LINE_H, rows(), marks)
+    }
+
+    #[test]
+    fn click_on_orange_bar_opens_compare() {
+        let marks = [
+            LineMark::default(),
+            mark(Mark::Unsaved, Mark::None),
+            LineMark::default(),
+        ];
+        assert_eq!(hit(1.0, 25.0, &marks), Some(1));
+        // The wrapped row of the line is part of its bar
+        assert_eq!(hit(4.0, 45.0, &marks), Some(1));
+        assert_eq!(hit(1.0, 5.0, &marks), None);
+    }
+
+    #[test]
+    fn click_on_green_bar_does_nothing() {
+        let marks = [
+            mark(Mark::Saved, Mark::Saved),
+            LineMark::default(),
+            LineMark::default(),
+        ];
+        assert_eq!(hit(1.0, 1.0, &marks), None);
+        assert_eq!(hit(1.0, 10.0, &marks), None);
+    }
+
+    #[test]
+    fn click_on_line_number_keeps_upstream_behaviour() {
+        let marks = [mark(Mark::Unsaved, Mark::Unsaved); 3];
+        // Right of the change area: the line numbers and the text
+        assert_eq!(hit(AREA_W as f32, 5.0, &marks), None);
+        assert_eq!(hit(40.0, 5.0, &marks), None);
+        // Below the last row
+        assert_eq!(hit(1.0, 85.0, &marks), None);
+    }
+
+    #[test]
+    fn click_on_deletion_tick_opens_compare() {
+        let marks = [
+            LineMark::default(),
+            LineMark::default(),
+            mark(Mark::None, Mark::Unsaved),
+        ];
+        assert_eq!(hit(1.0, 61.0, &marks), Some(2));
+        // Lower in the line, away from the tick
+        assert_eq!(hit(1.0, 75.0, &marks), None);
+        // A wrapped row has no tick
+        let marks = [
+            LineMark::default(),
+            mark(Mark::None, Mark::Unsaved),
+            LineMark::default(),
+        ];
+        assert_eq!(hit(1.0, 21.0, &marks), Some(1));
+        assert_eq!(hit(1.0, 41.0, &marks), None);
+    }
+}

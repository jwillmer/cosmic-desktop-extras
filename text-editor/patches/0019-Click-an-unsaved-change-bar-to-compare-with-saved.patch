+/// The line whose clickable change mark is at `x`, `y` (physical pixels from the left of the
+/// change area and the top of the view), given the visible rows as `(line, top)` in order.
+/// Clickable: the bar of an unsaved line, and the top third of the first row of a line with an
+/// unsaved deletion tick. Saved (green) marks are not clickable.
+fn change_mark_hit(
+    x: f32,
+    y: f32,
+    area_w: i32,
+    line_height: f32,
+    rows: impl IntoIterator<Item = (usize, f32)>,
+    marks: &[LineMark],
+) -> Option<usize> {
+    if x < 0.0 || x >= area_w as f32 {
+        return None;
+    }
+    let mut last_line = None;
+    for (line_i, top) in rows {
+        let first_row = last_line != Some(line_i);
+        last_line = Some(line_i);
+        if y < top || y >= top + line_height {
+            continue;
+        }
+        let mark = marks.get(line_i)?;
+        let on_tick = first_row
+            && mark.deleted_above == Mark::Unsaved
+            && y < top + (line_height / 3.0).max(1.0);
+        return (mark.line == Mark::Unsaved || on_tick).then_some(line_i);
+    }
+    None
+}

+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A fresh folder under the system temp folder, removed when dropped
+    struct TempDir(PathBuf);
+
+    impl TempDir {
+        fn new(name: &str) -> Self {
+            let dir = std::env::temp_dir().join(format!(
+                "cosmic-edit-find-files-{name}-{}",
+                std::process::id()
+            ));
+            let _ = fs::remove_dir_all(&dir);
+            fs::create_dir_all(&dir).unwrap();
+            Self(dir)
+        }
+
+        fn file(&self, rel: &str, contents: impl AsRef<[u8]>) -> PathBuf {
+            let path = self.0.join(rel);
+            fs::create_dir_all(path.parent().unwrap()).unwrap();
+            fs::write(&path, contents).unwrap();
+            path
+        }
+    }
+
+    impl Drop for TempDir {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    fn names(dir: &Path, paths: &[PathBuf]) -> Vec<String> {
+        paths
+            .iter()
+            .map(|path| path.strip_prefix(dir).unwrap().display().to_string())
+            .collect()
+    }
+
+    fn query(dir: &Path, pattern: &str, filters: &str, options: WalkOptions) -> Query {
+        Query {
+            text: pattern.to_string(),
+            regex: Regex::new(pattern).unwrap(),
+            joined: None,
+            dir: dir.to_path_buf(),
+            filters: Filters::parse(filters),
+            options,
+        }
+    }
+
+    const ALL: WalkOptions = WalkOptions {
+        sub_folders: true,
+        hidden: false,
+    };
+
+    #[test]
+    fn filters_as_in_notepad_plus_plus() {
+        let every = Filters::parse("*.*");
+        assert!(every.wanted("a.txt") && every.wanted("Makefile") && every.wanted(".env"));
+        assert_eq!(Filters::parse(""), Filters::default());
+        assert_eq!(Filters::parse("*"), Filters::default());
+
+        let some = Filters::parse("*.txt; *.MD  !skip*");
+        assert!(some.wanted("a.txt") && some.wanted("B.md") && some.wanted("c.TXT"));
+        assert!(!some.wanted("a.rs") && !some.wanted("Makefile"));
+        assert!(!some.wanted("skipped.txt"), "an exclude wins");
+        assert!(some.excluded("skip") && !some.excluded("keep"));
+
+        // Excludes only: every other file
+        let excludes = Filters::parse("!node_modules;!*.log");
+        assert!(excludes.wanted("a.rs") && !excludes.wanted("x.log"));
+        assert!(excludes.excluded("node_modules"));
+        // `*.*` with others still means every file
+        assert!(Filters::parse("*.txt *.*").wanted("a.rs"));
+        // A lone `!` is nothing
+        assert_eq!(Filters::parse("!"), Filters::default());
+    }
+
+    #[test]
+    fn globs_match_stars_and_question_marks() {
+        assert!(glob_match("*.txt", "a.txt"));
+        assert!(glob_match("*.txt", ".txt"));
+        assert!(!glob_match("*.txt", "a.txt.bak"));
+        assert!(glob_match("a?c", "abc") && !glob_match("a?c", "ac"));
+        assert!(glob_match("*a*b*", "xxaYYbzz"));
+        assert!(glob_match("*", "") && !glob_match("?", ""));
+        assert!(glob_match("ä*", "äöü"));
+    }
+
+    #[test]
+    fn walk_follows_sub_folder_hidden_and_exclude_options() {
+        let dir = TempDir::new("walk");
+        dir.file("a.txt", "x");
+        dir.file("b.rs", "x");
+        dir.file(".dot.txt", "x");
+        dir.file("sub/c.txt", "x");
+        dir.file("sub/deep/d.txt", "x");
+        dir.file(".hidden/e.txt", "x");
+        dir.file("skip/f.txt", "x");
+        let txt = Filters::parse("*.txt !skip");
+        assert_eq!(
+            names(&dir.0, &walk(&dir.0, &txt, ALL)),
+            [".dot.txt", "a.txt", "sub/c.txt", "sub/deep/d.txt"]
+        );
+        let flat = WalkOptions {
+            sub_folders: false,
+            hidden: false,
+        };
+        assert_eq!(
+            names(&dir.0, &walk(&dir.0, &txt, flat)),
+            [".dot.txt", "a.txt"]
+        );
+        let hidden = WalkOptions {
+            sub_folders: true,
+            hidden: true,
+        };
+        assert_eq!(
+            names(&dir.0, &walk(&dir.0, &txt, hidden)),
+            [
+                ".dot.txt",
+                ".hidden/e.txt",
+                "a.txt",
+                "sub/c.txt",
+                "sub/deep/d.txt"
+            ]
+        );
+        // `.gitignore` rules do not apply, as in Notepad++
+        dir.file(".gitignore", "a.txt\n");
+        assert!(names(&dir.0, &walk(&dir.0, &txt, ALL)).contains(&"a.txt".to_string()));
+    }
+
+    #[test]
+    fn binary_large_and_non_utf8_files() {
+        let dir = TempDir::new("read");
+        let text = dir.file("t.txt", "héllo");
+        let binary = dir.file("b.bin", b"abc\0def");
+        let latin1 = dir.file("l.txt", b"caf\xe9");
+        assert_eq!(read_text(&text, true), Content::Text("héllo".into()));
+        assert_eq!(read_text(&binary, false), Content::Binary);
+        assert_eq!(read_text(&latin1, true), Content::NotUtf8);
+        assert_eq!(
+            read_text(&latin1, false),
+            Content::Text("caf\u{fffd}".into())
+        );
+        // A NUL past the first 8 KB: still text
+        let late = dir.file("late.txt", format!("{}\0", "a".repeat(BINARY_SNIFF_BYTES)));
+        assert!(matches!(read_text(&late, false), Content::Text(_)));
+        // Over the limit: not read at all (a sparse file, so the test stays cheap)
+        let large = dir.0.join("large.txt");
+        fs::File::create(&large)
+            .unwrap()
+            .set_len(MAX_FILE_BYTES + 1)
+            .unwrap();
+        assert_eq!(read_text(&large, false), Content::TooLarge);
+        assert_eq!(
+            read_text(&dir.0.join("missing"), false),
+            Content::Unreadable
+        );
+    }
+
+    #[test]
+    fn search_lists_files_lines_and_counts() {
+        let dir = TempDir::new("search");
+        dir.file("a.txt", "one cat\nno\ncat cat\n");
+        dir.file("b.txt", "nothing");
+        dir.file("c.bin", b"cat\0");
+        dir.file("skip/d.txt", "cat");
+        let current = AtomicU64::new(1);
+        let query = query(&dir.0, "cat", "*.* !skip", ALL);
+        let search = search(&query, &HashMap::new(), 1, &current).unwrap();
+        // The binary file is not searched
+        assert_eq!(search.searched, 2);
+        assert_eq!(search.files.len(), 1);
+        let file = &search.files[0];
+        assert_eq!(file.source, Source::Path(dir.0.join("a.txt")));
+        assert_eq!(file.hits, 3);
+        assert_eq!(
+            file.lines.iter().map(|line| line.line).collect::<Vec<_>>(),
+            [0, 2]
+        );
+        assert_eq!(file.lines[1].marks, [(0, 3), (4, 7)]);
+
+        // An open tab's unsaved text is searched instead of the file
+        let open = HashMap::from([(
+            fs::canonicalize(dir.0.join("b.txt")).unwrap(),
+            "a cat".to_string(),
+        )]);
+        let search = super::search(&query, &open, 1, &current).unwrap();
+        assert_eq!(search.hits(), 4);
+
+        // A newer search started: this one stops
+        current.store(2, Ordering::Relaxed);
+        assert!(super::search(&query, &open, 1, &current).is_none());
+    }
+
+    #[test]
+    fn replace_keeps_line_endings() {
+        let replacement = Replacement::new("dog", false, false);
+        let regex = Regex::new("cat").unwrap();
+        let (text, count) = replace_text("cat\r\na cat\ncat", &regex, None, &replacement);
+        assert_eq!((text.as_str(), count), ("dog\r\na dog\ndog", 3));
+
+        // A replacement with a line break takes the file's ending
+        let two = Replacement::new(r"a\nb", false, true);
+        let (text, _) = replace_text("x cat\r\ny\r\n", &regex, None, &two);
+        assert_eq!(text, "x a\r\nb\r\ny\r\n");
+
+        // Over lines: `\n` in the query stands for the file's line break
+        let over = Regex::new(r"cat\ny").unwrap();
+        let (text, count) = replace_text("cat\r\ny\r\n", &over, Some(false), &replacement);
+        assert_eq!((text.as_str(), count), ("dog\r\n", 1));
+        // Naming `\r` edits the real endings
+        let cr = Regex::new(r"\r").unwrap();
+        let (text, count) = replace_text(
+            "a\r\nb\r\n",
+            &cr,
+            Some(true),
+            &Replacement::new("", false, false),
+        );
+        assert_eq!((text.as_str(), count), ("a\nb\n", 2));
+
+        // `^` and `$`: once per line, the empty last line too, as a document has it
+        let start = Regex::new("^").unwrap();
+        let (text, count) = replace_text(
+            "a\nb\n",
+            &start,
+            None,
+            &Replacement::new("> ", false, false),
+        );
+        assert_eq!((text.as_str(), count), ("> a\n> b\n> ", 3));
+    }
+
+    #[test]
+    fn replace_in_files_writes_atomically_and_skips() {
+        let dir = TempDir::new("replace");
+        let crlf = dir.file("crlf.txt", "cat\r\ncat\r\n");
+        let latin1 = dir.file("latin1.txt", b"cat caf\xe9");
+        let open = dir.file("open.txt", "cat");
+        let none = dir.file("none.txt", "dog");
+        let current = AtomicU64::new(7);
+        let query = query(&dir.0, "cat", "*.txt", ALL);
+        let in_tabs = HashSet::from([fs::canonicalize(&open).unwrap()]);
+        let outcome = replace_in_files(
+            &query,
+            &Replacement::new("lion", false, false),
+            &in_tabs,
+            7,
+            &current,
+        )
+        .unwrap();
+        assert_eq!(fs::read_to_string(&crlf).unwrap(), "lion\r\nlion\r\n");
+        assert_eq!(
+            fs::read(&latin1).unwrap(),
+            b"cat caf\xe9",
+            "not UTF-8: untouched"
+        );
+        assert_eq!(
+            fs::read_to_string(&open).unwrap(),
+            "cat",
+            "the tab replaces it"
+        );
+        assert_eq!(fs::read_to_string(&none).unwrap(), "dog");
+        assert_eq!(
+            outcome,
+            ReplaceOutcome {
+                occurrences: 2,
+                files: 1,
+                not_utf8: 1,
+                failed: Vec::new(),
+                in_tabs: vec![fs::canonicalize(&open).unwrap()],
+            }
+        );
+        // No temporary file is left beside them
+        let mut left: Vec<_> = fs::read_dir(&dir.0)
+            .unwrap()
+            .map(|entry| entry.unwrap().file_name().to_string_lossy().into_owned())
+            .collect();
+        left.sort();
+        assert_eq!(left, ["crlf.txt", "latin1.txt", "none.txt", "open.txt"]);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_file_reached_twice_is_replaced_once() {
+        let dir = TempDir::new("twice");
+        let file = dir.file("a.txt", "cat");
+        std::os::unix::fs::symlink(&file, dir.0.join("b.txt")).unwrap();
+        let current = AtomicU64::new(1);
+        let outcome = replace_in_files(
+            &query(&dir.0, "cat", "*.*", ALL),
+            &Replacement::new("cats", false, false),
+            &HashSet::new(),
+            1,
+            &current,
+        )
+        .unwrap();
+        assert_eq!(fs::read_to_string(&file).unwrap(), "cats");
+        assert_eq!((outcome.occurrences, outcome.files), (1, 1));
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn atomic_write_leaves_files_a_rename_would_harm() {
+        use std::os::unix::fs::PermissionsExt;
+        let dir = TempDir::new("refuse");
+        let changed = dir.file("changed.txt", "now");
+        let err = write_atomic(&changed, "then", "new").unwrap_err();
+        assert_eq!(err.to_string(), "changed while replacing");
+        assert_eq!(fs::read_to_string(&changed).unwrap(), "now");
+
+        let read_only = dir.file("ro.txt", "old");
+        fs::set_permissions(&read_only, fs::Permissions::from_mode(0o444)).unwrap();
+        assert!(write_atomic(&read_only, "old", "new").is_err());
+        assert_eq!(fs::read_to_string(&read_only).unwrap(), "old");
+
+        let linked = dir.file("a.txt", "old");
+        fs::hard_link(&linked, dir.0.join("b.txt")).unwrap();
+        assert!(write_atomic(&linked, "old", "new").is_err());
+        assert_eq!(fs::read_to_string(dir.0.join("b.txt")).unwrap(), "old");
+
+        // No temporary file is left behind
+        let mut left: Vec<_> = fs::read_dir(&dir.0)
+            .unwrap()
+            .map(|entry| entry.unwrap().file_name().to_string_lossy().into_owned())
+            .collect();
+        left.sort();
+        assert_eq!(left, ["a.txt", "b.txt", "changed.txt", "ro.txt"]);
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn a_tab_with_unsaved_changes_is_listed_without_a_disk_match() {
+        let dir = TempDir::new("tabs");
+        let file = dir.file("t.txt", "dog");
+        let current = AtomicU64::new(1);
+        let in_tabs = HashSet::from([fs::canonicalize(&file).unwrap()]);
+        let outcome = replace_in_files(
+            &query(&dir.0, "cat", "*.*", ALL),
+            &Replacement::new("lion", false, false),
+            &in_tabs,
+            1,
+            &current,
+        )
+        .unwrap();
+        assert_eq!(outcome.in_tabs, [fs::canonicalize(&file).unwrap()]);
+        assert_eq!(fs::read_to_string(&file).unwrap(), "dog");
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn atomic_write_keeps_permissions_and_symlinks() {
+        use std::os::unix::fs::PermissionsExt;
+        let dir = TempDir::new("atomic");
+        let file = dir.file("f.sh", "old");
+        fs::set_permissions(&file, fs::Permissions::from_mode(0o750)).unwrap();
+        let link = dir.0.join("link.sh");
+        std::os::unix::fs::symlink(&file, &link).unwrap();
+        write_atomic(&link, "old", "new").unwrap();
+        assert_eq!(fs::read_to_string(&file).unwrap(), "new");
+        assert!(
+            fs::symlink_metadata(&link)
+                .unwrap()
+                .file_type()
+                .is_symlink()
+        );
+        assert_eq!(
+            fs::metadata(&file).unwrap().permissions().mode() & 0o777,
+            0o750
+        );
+    }
+}

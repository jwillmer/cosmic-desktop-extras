index 0000000..8abda86
--- /dev/null
+++ b/src/find_ui.rs
@@ -0,0 +1,1006 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Find and replace on `App`: its query, "In selection" range, replace text and match count; its
+//! dialog in a window of its own, and the "Go to line" bar under the text.
+
+use cosmic::{
+    Application, ApplicationExt, Element, action,
+    app::Task,
+    cosmic_theme,
+    iced::{Alignment, Length, Size, keyboard, window},
+    style,
+    widget::{self, button},
+};
+use cosmic_text::{Edit, Selection};
+use tokio::time;
+
+use crate::{
+    App, Message, find_count, find_files, find_range, find_text, fl, icon_cache_get, tab::Tab,
+};
+
+/// How long typing in the find field pauses before the match count scans again
+const FIND_COUNT_DELAY: time::Duration = time::Duration::from_millis(150);
+
+/// The Find/Replace dialog's fixed size. A fixed size (min = max) makes COSMIC and sway float it
+/// over the tiled editor: Wayland gives no way to name a parent window here.
+/// It fits the taller of its two tabs, Find in Files.
+const FIND_WINDOW_SIZE: Size = Size::new(780.0, 420.0);
+
+/// The width of the labels before the dialog's fields and of its button column
+const FIND_LABEL_WIDTH: f32 = 110.0;
+pub(crate) const FIND_BUTTON_WIDTH: f32 = 250.0;
+
+/// A label before a field of the dialog, all of one width
+pub(crate) fn dialog_label<'a>(text: String) -> Element<'a, Message> {
+    widget::text::body(text)
+        .width(Length::Fixed(FIND_LABEL_WIDTH))
+        .into()
+}
+
+/// A text button of the dialog's button column, as wide as the column, as in Notepad++
+pub(crate) fn dialog_button<'a>(
+    text: String,
+    class: style::Button,
+    message: Message,
+    space_xxs: u16,
+    space_s: u16,
+) -> Element<'a, Message> {
+    button::custom(
+        widget::text::body(text)
+            .width(Length::Fill)
+            .align_x(Alignment::Center),
+    )
+    .class(class)
+    .on_press(message)
+    .padding([space_xxs, space_s])
+    .width(Length::Fill)
+    .into()
+}
+
+/// Notepad++'s "Search Mode": the find options `find_use_regex` and `find_extended` as one
+/// choice
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FindMode {
+    Normal,
+    /// `\n`, `\r`, `\t`, `\0` and `\x..` stand for those characters
+    Extended,
+    Regex,
+}
+
+impl FindMode {
+    /// The mode the two options select; regex wins, as the find code reads them
+    fn of(use_regex: bool, extended: bool) -> Self {
+        match (use_regex, extended) {
+            (true, _) => Self::Regex,
+            (false, true) => Self::Extended,
+            (false, false) => Self::Normal,
+        }
+    }
+
+    /// `(find_use_regex, find_extended)` for this mode: only one of them on
+    fn flags(self) -> (bool, bool) {
+        (self == Self::Regex, self == Self::Extended)
+    }
+}
+
+/// The Find dialog's own controls
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FindUiMessage {
+    /// A "Search Mode" radio button
+    Mode(FindMode),
+    /// "Find All in Current Document" (`false`) or "Find All in All Opened Documents" (`true`):
+    /// the matches go to the Search results panel
+    FindAll(bool),
+    /// Enter in a field of the dialog (see [`find_submit`])
+    Submit(DialogField),
+    /// The "Go to line" field took focus: it no longer shares the find field's focus, as both
+    /// may be open
+    GotoFocused,
+}
+
+/// A field of the Find dialog, for what Enter in it does (see [`find_submit`])
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DialogField {
+    Find,
+    Replace,
+}
+
+/// Enter in a field of the dialog, as in Notepad++: Find Next in "Find what" (Shift+Enter the
+/// previous match), Replace in "Replace with"
+fn find_submit(field: DialogField, shift: bool) -> Message {
+    match (field, shift) {
+        (DialogField::Find, false) => Message::FindNext,
+        (DialogField::Find, true) => Message::FindPrevious,
+        (DialogField::Replace, _) => Message::FindReplace,
+    }
+}
+
+/// What opening the dialog (Ctrl+F, Ctrl+H) takes from the active tab's selection
+#[derive(Debug, PartialEq, Eq)]
+enum FindSeed {
+    /// Nothing: no selection, or the match the last find selected (a result, not a query)
+    Keep,
+    /// The selection becomes the query
+    Query,
+    /// The selection is a range to search in: "In selection" is ticked, the query stays
+    InSelection,
+}
+
+/// What a selection of `chars` characters (see `find_range::chars`) seeds, as in Notepad++: a
+/// short one-line selection fills "Find what"; a selection over line breaks, or of at least
+/// `find_range::AUTO_CHARS`, ticks "In selection" instead.
+fn find_seed_of(chars: usize, multi_line: bool, last_hit: bool) -> FindSeed {
+    if chars == 0 || last_hit {
+        FindSeed::Keep
+    } else if multi_line || chars >= find_range::AUTO_CHARS {
+        FindSeed::InSelection
+    } else {
+        FindSeed::Query
+    }
+}
+
+/// Which of the two messages one Escape in the dialog sends came first: our key message,
+/// or libcosmic's, which runs `on_escape` and names no window. They come on separate
+/// subscriptions in either order.
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+enum EscapeOrder {
+    #[default]
+    None,
+    Key,
+    Nav,
+}
+
+/// The Escape key message from the dialog came (its window then closes)
+fn escape_key(order: &mut EscapeOrder) {
+    *order = match order {
+        EscapeOrder::Nav => EscapeOrder::None,
+        _ => EscapeOrder::Key,
+    };
+}
+
+/// libcosmic's Escape came: `true` when it belongs to the dialog and `on_escape` must not run.
+/// `dialog_focused`: the dialog has the keyboard, so its key message is still to come.
+fn escape_nav(order: &mut EscapeOrder, dialog_focused: bool) -> bool {
+    match order {
+        EscapeOrder::Key => {
+            *order = EscapeOrder::None;
+            true
+        }
+        _ if dialog_focused => {
+            *order = EscapeOrder::Nav;
+            true
+        }
+        _ => false,
+    }
+}
+
+/// The last word of a regex error, for the status line: its message line without the pattern
+/// and caret lines before it
+fn regex_error_summary(err: &str) -> &str {
+    let last = err.lines().rev().find(|line| !line.trim().is_empty());
+    let last = last.unwrap_or(err).trim();
+    last.strip_prefix("error: ").unwrap_or(last)
+}
+
+/// State of the Find dialog that outlives its window
+#[derive(Debug, Default)]
+pub(crate) struct FindDialog {
+    /// "Replace all" replaced this many: the status line says so until the next find action
+    pub(crate) replaced: Option<usize>,
+    escape: EscapeOrder,
+    /// The Find in Files tab, and which tab shows
+    pub(crate) files: find_files::State,
+}
+
+/// The Find dialog's window while open
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub(crate) struct FindWindow {
+    id: window::Id,
+    /// It has the keyboard: of our windows, it took focus last
+    focused: bool,
+    /// Ctrl+F asked to bring it to the front: the find field takes focus once it has the keyboard
+    raise_pending: bool,
+}
+
+/// What the Find dialog's window must do to match the find state (see [`find_window_step`])
+#[derive(Debug, PartialEq)]
+enum FindWindowStep {
+    /// Nothing: it matches already
+    Keep,
+    /// It was opened under this new id
+    Opened(window::Id),
+    /// It has the keyboard: focus the find field
+    FocusField,
+    /// Ask the compositor to give it the keyboard
+    Activate(window::Id),
+    /// It must close; it is already forgotten
+    Close(window::Id),
+}
+
+/// Bring `window` in line with whether find is open. `raise` asks for an open dialog in front
+/// with its find field focused, as Ctrl+F does; `open` opens the window and returns its new id.
+fn find_window_step(
+    window: &mut Option<FindWindow>,
+    find_open: bool,
+    raise: bool,
+    open: impl FnOnce() -> window::Id,
+) -> FindWindowStep {
+    match (find_open, window.as_mut()) {
+        (true, None) => {
+            let id = open();
+            *window = Some(FindWindow {
+                id,
+                focused: false,
+                raise_pending: false,
+            });
+            FindWindowStep::Opened(id)
+        }
+        (true, Some(open)) if raise && open.focused => FindWindowStep::FocusField,
+        (true, Some(open)) if raise => {
+            open.raise_pending = true;
+            FindWindowStep::Activate(open.id)
+        }
+        (false, Some(open)) => {
+            let id = open.id;
+            *window = None;
+            FindWindowStep::Close(id)
+        }
+        _ => FindWindowStep::Keep,
+    }
+}
+
+/// Note that our window `window_id` took the keyboard. `true` when it is the dialog and a raise
+/// waited for that.
+fn find_window_focused(window: &mut Option<FindWindow>, window_id: window::Id) -> bool {
+    let Some(open) = window.as_mut() else {
+        return false;
+    };
+    open.focused = open.id == window_id;
+    open.focused && std::mem::take(&mut open.raise_pending)
+}
+
+/// Focus the find field (`id`) with its text selected, to type a new query over it
+fn find_field_focus(id: widget::Id) -> Task<Message> {
+    Task::batch([
+        widget::text_input::focus(id.clone()),
+        widget::text_input::select_all(id),
+    ])
+}
+
+impl App {
+    /// Whether `window_id` is the Find dialog's window
+    pub(crate) fn is_find_window(&self, window_id: window::Id) -> bool {
+        self.find_window.is_some_and(|open| open.id == window_id)
+    }
+
+    /// Our step before upstream's `update` for the Find dialog's window. Escape in it and its
+    /// close button close find, as in Notepad++; Escape in the editor leaves it open. `Some`
+    /// when the message is done.
+    pub(crate) fn find_window_message(&mut self, message: &Message) -> Option<Task<Message>> {
+        let escape = keyboard::Key::Named(keyboard::key::Named::Escape);
+        // "Replaced 5" stays until the next find action, as in Notepad++
+        if matches!(
+            message,
+            Message::Find(Some(_))
+                | Message::FindNext
+                | Message::FindPrevious
+                | Message::FindReplace
+                | Message::FindReplaceAll
+                | Message::FindSearchValueChanged(_)
+                | Message::FindReplaceValueChanged(_)
+                | Message::FindCaseSensitive(_)
+                | Message::FindWholeWord(_)
+                | Message::FindWrapAround(_)
+                | Message::FindUseRegex(_)
+                | Message::FindExtended(_)
+                | Message::FindDotMatchesNewline(_)
+                | Message::FindUi(FindUiMessage::FindAll(_))
+        ) {
+            self.find_dialog.replaced = None;
+        }
+        // Ctrl+F and Ctrl+H show the Replace tab; Ctrl+Shift+F the Find in Files tab
+        if matches!(message, Message::Find(Some(_))) {
+            self.find_dialog
+                .files
+                .set_tab(find_files::DialogTab::Replace);
+        }
+        match message {
+            Message::Key(window_id, _, _, key, _) | Message::FindFieldKey(window_id, _, _, key)
+                if *key == escape && self.is_find_window(*window_id) =>
+            {
+                // An unused key (no field focused) also runs libcosmic's `on_escape`
+                if matches!(message, Message::Key(..)) && self.core().keyboard_nav() {
+                    escape_key(&mut self.find_dialog.escape);
+                }
+                self.close_find();
+                Some(self.find_window_sync(false))
+            }
+            Message::FindUi(message) => Some(self.find_ui_message(*message)),
+            // The find field took focus: the "Go to line" bar, which may be open too, no longer
+            // has it (upstream's arm gives both bars the focus, from when only one was open)
+            Message::FindFocused(true) => {
+                if let Some(find) = self.find_opt.as_mut() {
+                    find.has_focus = true;
+                }
+                if let Some(goto) = self.goto_line_opt.as_mut() {
+                    goto.has_focus = false;
+                }
+                Some(Task::none())
+            }
+            Message::CloseWindow(window_id) if self.is_find_window(*window_id) => {
+                self.close_find();
+                Some(self.find_window_sync(false))
+            }
+            // Ctrl+F away from the open dialog: upstream would focus the find field in a window
+            // without the keyboard, and typing would go nowhere. The field waits for the dialog.
+            Message::Find(Some(_)) if self.find_window.is_some_and(|open| !open.focused) => {
+                self.find_seed();
+                Some(self.find_window_sync(true))
+            }
+            Message::Focus(window_id) => {
+                let raised = find_window_focused(&mut self.find_window, *window_id);
+                // The find field has the keyboard only while its window does: back in the
+                // editor (also by Alt+Tab), upstream's `update_focus` must focus the text
+                let dialog = self.is_find_window(*window_id);
+                if let Some(find) = self.find_opt.as_mut()
+                    && (raised || !dialog)
+                {
+                    find.has_focus = dialog;
+                }
+                raised.then(|| find_field_focus(self.find_search_id.clone()))
+            }
+            _ => None,
+        }
+    }
+
+    /// Whether libcosmic's `on_escape` is for an Escape in the Find dialog, which must only
+    /// close the dialog (see [`escape_nav`])
+    pub(crate) fn find_escape_nav(&mut self) -> bool {
+        let focused = self.find_window.is_some_and(|open| open.focused);
+        escape_nav(&mut self.find_dialog.escape, focused)
+    }
+
+    fn find_ui_message(&mut self, message: FindUiMessage) -> Task<Message> {
+        match message {
+            FindUiMessage::Mode(mode) => {
+                let (use_regex, extended) = mode.flags();
+                Task::batch([
+                    self.update(Message::FindUseRegex(use_regex)),
+                    self.update(Message::FindExtended(extended)),
+                ])
+            }
+            // Shift as the key came, not as the field was drawn
+            FindUiMessage::Submit(field) => self.update(find_submit(field, self.modifiers.shift())),
+            FindUiMessage::FindAll(opened) => self.find_all(opened),
+            FindUiMessage::GotoFocused => {
+                if let Some(goto) = self.goto_line_opt.as_mut() {
+                    goto.has_focus = true;
+                }
+                if let Some(find) = self.find_opt.as_mut() {
+                    find.has_focus = false;
+                }
+                Task::none()
+            }
+        }
+    }
+
+    /// Open or close the Find/Replace dialog's window after `find_opt` changed: the window
+    /// follows the find state, so every way of opening or closing find also does the window.
+    /// `raise` (Ctrl+F or Ctrl+H) brings an open dialog to the front.
+    pub(crate) fn find_window_sync(&mut self, raise: bool) -> Task<Message> {
+        let mut open_task = None;
+        let step = find_window_step(
+            &mut self.find_window,
+            self.find_opt.is_some(),
+            raise,
+            || {
+                let (id, task) = window::open(window::Settings {
+                    size: FIND_WINDOW_SIZE,
+                    min_size: Some(FIND_WINDOW_SIZE),
+                    max_size: Some(FIND_WINDOW_SIZE),
+                    resizable: false,
+                    decorations: true,
+                    exit_on_close_request: false,
+                    platform_specific: window::settings::PlatformSpecific {
+                        application_id: App::APP_ID.to_string(),
+                        ..Default::default()
+                    },
+                    ..Default::default()
+                });
+                open_task = Some(task);
+                id
+            },
+        );
+        match step {
+            FindWindowStep::Opened(id) => {
+                let search_id = self.find_search_id.clone();
+                // The field can take focus only once its window exists
+                Task::batch([
+                    open_task
+                        .map(|open| open.then(move |_| find_field_focus(search_id.clone())))
+                        .unwrap_or_else(Task::none),
+                    self.set_window_title(fl!("find-and-replace"), id),
+                ])
+            }
+            FindWindowStep::FocusField => find_field_focus(self.find_search_id.clone()),
+            FindWindowStep::Activate(id) => self.find_window_activate(id),
+            FindWindowStep::Close(id) => window::close(id),
+            FindWindowStep::Keep => Task::none(),
+        }
+    }
+
+    /// Ask the compositor to give the dialog's window (`id`) the keyboard. On Wayland, as
+    /// `raise_main_window` does, with an activation token of the main window, whose key asked
+    /// for it: winit's `gain_focus` does nothing there. A compositor may only mark it urgent.
+    fn find_window_activate(&self, id: window::Id) -> Task<Message> {
+        #[cfg(feature = "wayland")]
+        {
+            use cosmic::iced::platform_specific::shell::commands::activation;
+            activation::request_token(Some(App::APP_ID.to_string()), self.core().main_window_id())
+                .then(move |token| {
+                    token.map_or_else(Task::none, |token| activation::activate(id, token))
+                })
+        }
+        #[cfg(not(feature = "wayland"))]
+        {
+            window::gain_focus(id)
+        }
+    }
+
+    /// A "Find what" or "Replace with" field: shared by both tabs, as in Notepad++. Enter
+    /// finds or replaces on the Replace tab, runs Find All or Replace in Files on the other.
+    pub(crate) fn find_what_input(&self, field: DialogField) -> Element<'_, Message> {
+        let files = self.find_dialog.files.tab() == find_files::DialogTab::Files;
+        let submit = move |_| {
+            if files {
+                find_files::submit_message(field)
+            } else {
+                Message::FindUi(FindUiMessage::Submit(field))
+            }
+        };
+        match field {
+            DialogField::Find => {
+                widget::text_input::text_input(fl!("find-placeholder"), &self.find_search_value)
+                    .id(self.find_search_id.clone())
+                    .on_input(Message::FindSearchValueChanged)
+                    .on_submit(submit)
+                    .on_focus(Message::FindFocused(true))
+                    .width(Length::Fill)
+                    .into()
+            }
+            DialogField::Replace => {
+                widget::text_input::text_input(fl!("replace-placeholder"), &self.find_replace_value)
+                    .id(self.find_replace_id.clone())
+                    .on_input(Message::FindReplaceValueChanged)

+    /// The dialog's status line: why the query does not compile, else what "Replace all" did,
+    /// else the match count ("3 of 17")
+    fn find_status_text(&self) -> String {
+        if let Some(Err(err)) = &self.find_regex {
+            return format!(
+                "{}: {}",
+                fl!("find-invalid-pattern"),
+                regex_error_summary(&err.to_string())
+            );
+        }
+        if let Some(count) = self.find_dialog.replaced {
+            return fl!("find-replaced", count = count);
+        }
+        self.find_count_text().unwrap_or_default()
+    }
+
+    /// Compile the find query again after it or a find option changed. The match count scans
+    /// for it once typing in the find field pauses, or at once with `now`.
+    pub(crate) fn find_query_changed(&mut self, now: bool) -> Task<Message> {
+        self.find_regex = (!self.find_search_value.is_empty())
+            .then(|| self.config.find_regex(&self.find_search_value));
+        self.find_query = self.find_query.wrapping_add(1);
+        if now {
+            self.find_query_settled = self.find_query;
+            return Task::none();
+        }
+        let query = self.find_query;
+        Task::perform(time::sleep(FIND_COUNT_DELAY), move |()| {
+            action::app(Message::FindCountQuery(query))
+        })
+    }
+
+    /// For a find query that can match a line break, which is searched in the joined lines:
+    /// whether it needs each line's real ending (it names `\r`). `None` for a query searched
+    /// line by line.
+    pub(crate) fn find_joined(&self) -> Option<bool> {
+        find_text::spans_lines(
+            &self.find_search_value,
+            self.config.find_use_regex,
+            self.config.find_extended,
+            self.config.find_dot_matches_newline,
+        )
+        .then(|| find_text::needs_real_endings(&self.find_search_value, self.config.find_use_regex))
+    }
+
+    /// What Replace all, the count and the highlights act on: the active tab's selection while
+    /// "In selection" is ticked, as in Notepad++; `None` for the whole text.
+    pub(crate) fn find_range(&self) -> Option<(find_range::Pos, find_range::Pos)> {
+        find_range::scope(self.find_in_selection, self.find_selection())
+    }
+
+    /// The active tab's selection, when not empty and not a column block: "In selection" is
+    /// enabled only with one
+    pub(crate) fn find_selection(&self) -> Option<(find_range::Pos, find_range::Pos)> {
+        let Some(Tab::Editor(tab)) = self.active_tab() else {
+            return None;
+        };
+        if tab
+            .column
+            .lock()
+            .unwrap()
+            .is_some_and(|block| !block.is_empty())
+        {
+            return None;
+        }
+        let (start, end) = tab.editor.lock().unwrap().selection_bounds()?;
+        (start != end).then_some(((start.line, start.index), (end.line, end.index)))
+    }
+
+    /// Close find and its dialog. "In selection" is for one use of the dialog: it ends with it.
+    pub(crate) fn close_find(&mut self) {
+        self.find_opt = None;
+        self.find_in_selection = false;
+        // Its matches are not needed until the dialog opens again
+        self.find_count.get_mut().clear();
+    }
+
+    /// Take the active tab's selection into the dialog as it opens (Ctrl+F, Ctrl+H), as in
+    /// Notepad++: a short one-line selection becomes the query, a longer one ticks "In
+    /// selection" (see [`find_seed_of`])
+    pub(crate) fn find_seed(&mut self) {
+        // Ctrl+F in the dialog itself keeps what was typed there
+        if self.find_window.is_some_and(|open| open.focused) {
+            return;
+        }
+        let Some(Tab::Editor(tab)) = self.active_tab() else {
+            return;
+        };
+        let Some((start, end)) = self.find_selection() else {
+            return;
+        };
+        // Before the editor lock below: it takes that lock too
+        let last_hit = tab.selection_is_last_hit();
+        let (seed, query) = tab.editor.lock().unwrap().with_buffer(|buffer| {
+            let lines = buffer.lines.get(start.0..=end.0).unwrap_or_default();
+            let chars = find_range::chars(lines.iter().map(|line| line.text()), start, end);
+            let seed = find_seed_of(chars, start.0 != end.0, last_hit);
+            let query = (seed == FindSeed::Query)
+                .then(|| buffer.lines[start.0].text()[start.1..end.1].to_string());
+            (seed, query)
+        });
+        match seed {
+            FindSeed::Keep => {}
+            FindSeed::Query => {
+                self.find_in_selection = false;
+                if let Some(query) = query {
+                    self.find_search_value = query;
+                    let _ = self.find_query_changed(true);
+                }
+            }
+            FindSeed::InSelection => self.find_in_selection = true,
+        }
+    }
+
+    /// The replace text as the find options read it (see `find_text::Replacement`)
+    pub(crate) fn find_replacement(&self) -> find_text::Replacement {
+        find_text::Replacement::new(
+            &self.find_replace_value,
+            self.config.find_use_regex,
+            self.config.find_extended,
+        )
+    }
+
+    /// The find bar's match count for the active tab, e.g. "3 of 17"; `None` without a query
+    pub(crate) fn find_count_text(&self) -> Option<String> {
+        let regex = match self.find_regex.as_ref()? {
+            Ok(regex) => regex,
+            Err(_) => return Some(find_count::Count::Invalid.text()),
+        };
+        let entity = self.tab_model.active();
+        let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(entity) else {
+            return None;
+        };
+        // Before the editor lock below: the range reads the selection under its own lock
+        let range = self.find_range();
+        let editor = tab.editor.lock().unwrap();
+        let cursor = editor.cursor();
+        let anchor = match editor.selection() {
+            Selection::Normal(anchor) => Some((anchor.line, anchor.index)),
+            _ => None,
+        };
+        let mut cache = self.find_count.borrow_mut();
+        // The counted generation moves only once typing pauses: no scan per key
+        let key = (entity, tab.generation.counted, self.find_query_settled);
+        let joined = self.find_joined();
+        let matches = editor.with_buffer(|buffer| {
+            // Made only once typing pauses
+            cache.get(key, || {
+                find_count::scan_text(
+                    buffer.lines.iter().map(|line| (line.text(), line.ending())),
+                    regex,
+                    joined,
+                    find_count::MATCH_CAP,
+                )
+            })
+        });
+        // "In selection": only the matches inside its range
+        let clipped;
+        let matches = match range {
+            Some(range) => {
+                clipped = find_range::clip(matches, range);
+                &clipped
+            }
+            None => matches,
+        };
+        let current = find_count::current_index(matches, (cursor.line, cursor.index), anchor);
+        Some(find_count::Count::of(matches, current).text())
+    }
+
+    /// The "Go to line" bar under the text while open
+    pub(crate) fn goto_line_bar(&self) -> Option<Element<'_, Message>> {
+        let cosmic_theme::Spacing { space_xxs, .. } = self.core().system_theme().cosmic().spacing;
+        let goto = self.goto_line_opt.as_ref()?;
+        let mut goto_input =
+            widget::text_input::text_input(fl!("go-to-line-placeholder"), &goto.value)
+                .id(self.goto_line_id.clone())
+                .on_input(Message::GotoLineValueChanged)
+                .on_submit(|_| Message::GotoLineSubmit)
+                .on_focus(Message::FindUi(FindUiMessage::GotoFocused))
+                .width(Length::Fixed(320.0));
+        if goto.invalid {
+            goto_input = goto_input.error(fl!("go-to-line-invalid"));
+        }
+        let goto_widget = widget::row::with_children(vec![
+            goto_input.into(),
+            widget::space::horizontal().into(),
+            button::custom(icon_cache_get("window-close-symbolic", 16))
+                .on_press(Message::GotoLine(None))
+                .padding(space_xxs)
+                .class(style::Button::Icon)
+                .into(),
+        ])
+        .align_y(Alignment::Center)
+        .padding(space_xxs)
+        .spacing(space_xxs);
+        Some(
+            widget::layer_container(goto_widget)
+                .layer(cosmic_theme::Layer::Primary)
+                .into(),
+        )
+    }
+}

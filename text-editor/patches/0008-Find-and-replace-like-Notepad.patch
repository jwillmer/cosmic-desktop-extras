+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// One sync of the dialog's window, with a fresh id as `window::open` gives
+    fn step(window: &mut Option<FindWindow>, find_open: bool, raise: bool) -> FindWindowStep {
+        find_window_step(window, find_open, raise, window::Id::unique)
+    }
+
+    #[test]
+    fn find_window_opens_raises_and_closes_with_find() {
+        let mut window = None;
+        assert_eq!(step(&mut window, false, false), FindWindowStep::Keep);
+        assert_eq!(step(&mut window, false, true), FindWindowStep::Keep);
+        assert_eq!(window, None);
+
+        let FindWindowStep::Opened(id) = step(&mut window, true, true) else {
+            panic!("find opened without its window");
+        };
+        // A new window takes the keyboard
+        assert!(!find_window_focused(&mut window, id));
+        // Every other message leaves it alone; Ctrl+F in it focuses the find field
+        assert_eq!(step(&mut window, true, false), FindWindowStep::Keep);
+        assert_eq!(step(&mut window, true, true), FindWindowStep::FocusField);
+
+        // Closed (Escape, its close button): forgotten at once, closed once
+        assert_eq!(step(&mut window, false, false), FindWindowStep::Close(id));
+        assert_eq!(window, None);
+        assert_eq!(step(&mut window, false, false), FindWindowStep::Keep);
+        assert!(!find_window_focused(&mut window, id));
+    }
+
+    #[test]
+    fn find_window_raise_focuses_the_field_once_it_has_the_keyboard() {
+        let main = window::Id::unique();
+        let mut window = None;
+        let FindWindowStep::Opened(id) = step(&mut window, true, false) else {
+            panic!("not opened");
+        };
+        find_window_focused(&mut window, id);
+        // Back in the editor: Ctrl+H asks the compositor for the dialog
+        assert!(!find_window_focused(&mut window, main));
+        assert_eq!(step(&mut window, true, true), FindWindowStep::Activate(id));
+        assert!(!find_window_focused(&mut window, main));
+        // The field takes focus when the dialog gets the keyboard, once
+        assert!(find_window_focused(&mut window, id));
+        assert!(!find_window_focused(&mut window, id));
+    }
+
+    #[test]
+    fn find_window_reopens_under_a_new_id() {
+        let mut window = None;
+        let FindWindowStep::Opened(first) = step(&mut window, true, false) else {
+            panic!("not opened");
+        };
+        step(&mut window, false, false);
+        let FindWindowStep::Opened(second) = step(&mut window, true, false) else {
+            panic!("not opened again");
+        };
+        assert_ne!(first, second);
+        // The old window's late focus is not the dialog's
+        assert!(!find_window_focused(&mut window, first));
+        assert!(window.is_some_and(|open| open.id == second));
+    }
+
+    #[test]
+    fn search_mode_radio_matches_the_two_options() {
+        for mode in [FindMode::Normal, FindMode::Extended, FindMode::Regex] {
+            let (use_regex, extended) = mode.flags();
+            assert_eq!(FindMode::of(use_regex, extended), mode);
+            // One option at most is on
+            assert!(!(use_regex && extended), "{mode:?}");
+        }
+        assert_eq!(FindMode::Normal.flags(), (false, false));
+        assert_eq!(FindMode::Extended.flags(), (false, true));
+        assert_eq!(FindMode::Regex.flags(), (true, false));
+        // Both on (an old config): regex wins, as the search reads them
+        assert_eq!(FindMode::of(true, true), FindMode::Regex);
+    }
+
+    #[test]
+    fn enter_finds_in_find_what_and_replaces_in_replace_with() {
+        let is = |message: Message, expected: &str| {
+            assert_eq!(format!("{message:?}"), expected);
+        };
+        is(find_submit(DialogField::Find, false), "FindNext");
+        is(find_submit(DialogField::Find, true), "FindPrevious");
+        is(find_submit(DialogField::Replace, false), "FindReplace");
+        is(find_submit(DialogField::Replace, true), "FindReplace");
+    }
+
+    #[test]
+    fn selection_fills_the_query_or_ticks_in_selection() {
+        // A short one-line selection is the query
+        assert_eq!(find_seed_of(5, false, false), FindSeed::Query);
+        assert_eq!(
+            find_seed_of(find_range::AUTO_CHARS - 1, false, false),
+            FindSeed::Query
+        );
+        // Over line breaks, or long: a range to search in
+        assert_eq!(find_seed_of(5, true, false), FindSeed::InSelection);
+        assert_eq!(
+            find_seed_of(find_range::AUTO_CHARS, false, false),
+            FindSeed::InSelection
+        );
+        // No selection, or the match the last find selected: both stay
+        assert_eq!(find_seed_of(0, false, false), FindSeed::Keep);
+        assert_eq!(find_seed_of(5, false, true), FindSeed::Keep);
+        assert_eq!(find_seed_of(5, true, true), FindSeed::Keep);
+    }
+
+    #[test]
+    fn escape_in_the_dialog_skips_on_escape_in_either_order() {
+        let mut order = EscapeOrder::default();
+        // Key first: the dialog closed, so it no longer has the keyboard
+        escape_key(&mut order);
+        assert!(escape_nav(&mut order, false));
+        assert_eq!(order, EscapeOrder::None);
+        // The next Escape in the editor runs it again
+        assert!(!escape_nav(&mut order, false));
+
+        // libcosmic's first, while the dialog has the keyboard
+        assert!(escape_nav(&mut order, true));
+        escape_key(&mut order);
+        assert_eq!(order, EscapeOrder::None);
+        assert!(!escape_nav(&mut order, false));
+    }
+
+    #[test]
+    fn regex_error_summary_is_its_message_line() {
+        let err = regex::Regex::new("(a").unwrap_err().to_string();
+        assert_eq!(regex_error_summary(&err), "unclosed group");
+        assert_eq!(regex_error_summary("plain"), "plain");
+    }

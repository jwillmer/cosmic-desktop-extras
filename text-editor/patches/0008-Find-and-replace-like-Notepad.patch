+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Find over line breaks: whether a query can match one, and the text its matches are found in.
+//!
+//! Find searches each line on its own, which is fast and needs no copy of the file. A query that
+//! can match a line break is searched in the lines joined instead ([`Joined`]), and its matches
+//! are turned back into buffer cursors.
+//!
+//! The lines are joined with `\n` for every line ending, so `foo\nbar` matches in LF, CRLF and
+//! CR files alike. A query that names `\r` itself gets each line's own ending (`\r\n` in a CRLF
+//! file), so `foo\r\nbar` matches what is on disk.
+//!
+//! Extended mode (normal mode, not regex) reads escapes in the find and replace text
+//! ([`unescape`]): a find text with a line break after that is searched in the joined lines
+//! too, by the same rule.
+
+use std::borrow::Cow;
+
+use cosmic_text::{Cursor, LineEnding};
+use regex::Regex;
+
+/// Whether a find query can match a line break, so it is searched in the joined text.
+///
+/// A plain-text query never does, an extended one ([`unescape`]) when it holds a line break
+/// after unescaping. A regex query does when any part of it can match `\n` or `\r`, as in
+/// Notepad++, which searches the whole text: `\n`, `\s`, `[^x]`, `\x0A`, or `.` with ". matches
+/// newline" on (or `(?s)`). So `\s+$` takes the blank lines after a line's trailing spaces too.
+/// `^` and `$` are line anchors either way and match no line break themselves.
+pub fn spans_lines(
+    pattern: &str,
+    use_regex: bool,
+    extended: bool,
+    dot_matches_newline: bool,
+) -> bool {
+    if !use_regex {
+        return extended && unescape(pattern).contains(['\n', '\r']);
+    }
+    // Parsed as `Config::find_regex` builds it; an invalid pattern finds nothing anyway
+    regex_syntax::ParserBuilder::new()
+        .dot_matches_new_line(dot_matches_newline)
+        .multi_line(true)
+        .crlf(true)
+        .build()
+        .parse(pattern)
+        .is_ok_and(|hir| matches_line_break(&hir))
+}
+
+/// Whether any literal or class in `hir` can match `\n` or `\r`
+fn matches_line_break(hir: &regex_syntax::hir::Hir) -> bool {
+    use regex_syntax::hir::{Class, HirKind};
+    match hir.kind() {
+        HirKind::Empty | HirKind::Look(_) => false,
+        HirKind::Literal(literal) => literal.0.iter().any(|&b| b == b'\n' || b == b'\r'),
+        HirKind::Class(Class::Unicode(class)) => class.ranges().iter().any(|r| {
+            let range = r.start()..=r.end();
+            range.contains(&'\n') || range.contains(&'\r')
+        }),
+        HirKind::Class(Class::Bytes(class)) => class.ranges().iter().any(|r| {
+            let range = r.start()..=r.end();
+            range.contains(&b'\n') || range.contains(&b'\r')
+        }),
+        HirKind::Repetition(repetition) => {
+            repetition.max != Some(0) && matches_line_break(&repetition.sub)
+        }
+        HirKind::Capture(capture) => matches_line_break(&capture.sub),
+        HirKind::Concat(hirs) | HirKind::Alternation(hirs) => hirs.iter().any(matches_line_break),
+    }
+}
+
+/// Whether a query that spans lines needs each line's real ending rather than `\n`: it names
+/// `\r`. A query that is no regex spans lines only in extended mode, so it is read unescaped.
+pub fn needs_real_endings(pattern: &str, use_regex: bool) -> bool {
+    if !use_regex {
+        return unescape(pattern).contains('\r');
+    }
+    let mut chars = pattern.chars();
+    while let Some(c) = chars.next() {
+        if c == '\\' && chars.next() == Some('r') {
+            return true;
+        }
+    }
+    false
+}
+
+/// Lines joined into one text, with where each line starts, to find matches over line breaks
+/// and turn their byte offsets back into cursors.
+#[derive(Debug, Default)]
+pub struct Joined {
+    pub text: String,
+    /// The byte offset each line starts at
+    starts: Vec<usize>,
+    /// Each line's length without its ending
+    lens: Vec<usize>,
+    /// The first line's number in the buffer, for a part of it
+    first: usize,
+}
+
+impl Joined {
+    /// Join `lines` (text and ending), the first being buffer line `first`. A line ending is
+    /// `\n`, or the line's own ending with `real_endings`. A line without an ending (the last)
+    /// adds none.
+    pub fn new<'t>(
+        lines: impl IntoIterator<Item = (&'t str, LineEnding)>,
+        first: usize,
+        real_endings: bool,
+    ) -> Self {
+        let mut text = String::new();
+        let mut starts = Vec::new();
+        let mut lens = Vec::new();
+        for (line, ending) in lines {
+            starts.push(text.len());
+            lens.push(line.len());
+            text.push_str(line);
+            if ending != LineEnding::None {
+                text.push_str(if real_endings { ending.as_str() } else { "\n" });
+            }
+        }
+        if starts.is_empty() {
+            starts.push(0);
+            lens.push(0);
+        }
+        Self {
+            text,
+            starts,
+            lens,
+            first,
+        }
+    }
+
+    /// The byte offset of `cursor` in the text; a cursor before or after the joined lines
+    /// clamps to its start or end, an index past its line's end to that end.
+    pub fn offset(&self, cursor: Cursor) -> usize {
+        let Some(i) = cursor.line.checked_sub(self.first) else {
+            return 0;
+        };
+        let Some(&start) = self.starts.get(i) else {
+            return self.text.len();
+        };
+        start + cursor.index.min(self.lens[i])
+    }
+
+    /// The cursor at byte `offset` of the text. An offset inside a line ending (after its
+    /// first byte) is the end of that line; the end of a line ending is the next line's start.
+    pub fn cursor(&self, offset: usize) -> Cursor {
+        let i = self.starts.partition_point(|&start| start <= offset) - 1;
+        let index = (offset - self.starts[i]).min(self.lens[i]);
+        Cursor::new(self.first + i, index)
+    }
+}
+
+/// `replace` with each line break written as `ending`, as the file's own: inserting `\n` into a
+/// CRLF file would otherwise add LF lines.
+pub fn with_line_ending(replace: &str, ending: LineEnding) -> String {
+    if !replace.contains(['\n', '\r']) {
+        return replace.to_string();
+    }
+    let ending = match ending {
+        LineEnding::None => LineEnding::Lf,
+        ending => ending,
+    };
+    let mut text = String::with_capacity(replace.len());
+    let mut chars = replace.chars().peekable();
+    while let Some(c) = chars.next() {
+        match c {
+            '\r' => {
+                if chars.peek() == Some(&'\n') {
+                    chars.next();
+                }
+                text.push_str(ending.as_str());
+            }
+            '\n' => text.push_str(ending.as_str()),
+            c => text.push(c),
+        }
+    }
+    text
+}
+
+/// One escape at the start of `rest` (the text after a backslash): the char it stands for and
+/// how many bytes of `rest` it takes. `\n`, `\r`, `\t`, `\0`, `\\`, `\xNN` (two hex digits) and
+/// `\uNNNN` (four hex digits, a valid char); `None` for anything else.
+fn escape(rest: &str) -> Option<(char, usize)> {
+    let hex = |digits: usize| {
+        let code = rest.get(1..1 + digits)?;
+        if !code.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return None;
+        }
+        let c = char::from_u32(u32::from_str_radix(code, 16).ok()?)?;
+        Some((c, 1 + digits))
+    };
+    match rest.chars().next()? {
+        'n' => Some(('\n', 1)),
+        'r' => Some(('\r', 1)),
+        't' => Some(('\t', 1)),
+        '0' => Some(('\0', 1)),
+        '\\' => Some(('\\', 1)),
+        'x' => hex(2),
+        'u' => hex(4),
+        _ => None,
+    }
+}
+
+/// The find or replace text of extended mode (Notepad++ "Extended") with its escapes read:
+/// `\n`, `\r`, `\t`, `\0`, `\\`, `\xNN` and `\uNNNN`. Any other backslash, an incomplete
+/// `\x`/`\u` or a surrogate (`\uD800`) is kept as typed, so `C:\data` stays `C:\data`.
+pub fn unescape(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut rest = text;
+    while let Some(at) = rest.find('\\') {
+        out.push_str(&rest[..at]);
+        let after = &rest[at + 1..];
+        match escape(after) {
+            Some((c, len)) => {
+                out.push(c);
+                rest = &after[len..];
+            }
+            None => {
+                out.push('\\');
+                rest = after;
+            }
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+/// The replace text of regex mode as a template for `regex::Captures::expand`.
+///
+/// `$1`, `${name}` and `$0` (the whole match) name groups as in the regex crate, and `$$` is a
+/// literal `$`; `${1}0` is group 1 and a `0` (`$10` would be group 10). As in Notepad++, `\0`
+/// to `\9` name groups too (`\1` is `${1}`, so `\10` is group 1 and a `0`), and the other
+/// escapes of extended mode work ([`unescape`]); any other backslash is kept as typed.
+pub fn regex_template(replace: &str) -> String {
+    let mut out = String::with_capacity(replace.len());
+    let mut rest = replace;
+    while let Some(at) = rest.find('\\') {
+        out.push_str(&rest[..at]);
+        let after = &rest[at + 1..];
+        match after.chars().next() {
+            Some(digit @ '0'..='9') => {
+                out.push_str("${");
+                out.push(digit);
+                out.push('}');
+                rest = &after[1..];
+            }
+            _ => match escape(after) {
+                Some((c, len)) => {
+                    // A `$` written as `\x24` stays literal
+                    if c == '$' {
+                        out.push('$');
+                    }
+                    out.push(c);
+                    rest = &after[len..];
+                }
+                None => {
+                    out.push('\\');
+                    rest = after;
+                }
+            },
+        }
+    }
+    out.push_str(rest);
+    out
+}
+
+/// The replace text as the find mode reads it: literal in normal mode (a `$` too), unescaped
+/// in extended mode, a template naming capture groups in regex mode.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Replacement {
+    Literal(String),
+    Template(String),
+}
+
+impl Replacement {
+    pub fn new(replace: &str, use_regex: bool, extended: bool) -> Self {
+        if use_regex {
+            Self::Template(regex_template(replace))
+        } else if extended {
+            Self::Literal(unescape(replace))
+        } else {
+            Self::Literal(replace.to_string())
+        }
+    }
+
+    /// The text that replaces the match of `regex` at byte `start` of `haystack` (where a
+    /// search of the same haystack found it), its line breaks written as `ending`, or as
+    /// written with `None` (a query that names `\r` edits line endings itself)
+    pub fn text_at(
+        &self,
+        regex: &Regex,
+        haystack: &str,
+        start: usize,
+        ending: Option<LineEnding>,
+    ) -> String {
+        let text = match self {
+            Self::Literal(text) => Cow::Borrowed(text.as_str()),
+            Self::Template(template) => {
+                let mut text = String::new();
+                if let Some(captures) = regex.captures_at(haystack, start) {
+                    captures.expand(template, &mut text);
+                }
+                Cow::Owned(text)
+            }
+        };
+        match ending {
+            Some(ending) => with_line_ending(&text, ending),
+            None => text.into_owned(),
+        }
+    }
+}
+
+/// The byte range `start..end` of `text`, widened to a whole `\r\n` at a side that falls
+/// between its `\r` and `\n` (see [`whole_endings`])
+fn whole_ending_range(text: &str, start: usize, end: usize) -> (usize, usize) {
+    let bytes = text.as_bytes();
+    let splits = |at: usize| at > 0 && bytes[at - 1] == b'\r' && bytes.get(at) == Some(&b'\n');
+    (
+        start - usize::from(splits(start)),
+        end + usize::from(splits(end)),
+    )
+}
+
+/// The edits that make the replacements `matches` (byte range in `text` and its replacement,
+/// in order, not overlapping) in a buffer, which keeps each line's ending whole: a match that
+/// starts or ends between the `\r` and `\n` of a `\r\n` takes the whole ending, and its
+/// replacement keeps the half it did not match, so `\r` → "" leaves the `\n`. Two matches that
+/// meet inside one ending become one edit. Only a query that names `\r` matches part of one
+/// ([`needs_real_endings`]).
+pub fn whole_endings(
+    text: &str,
+    matches: impl IntoIterator<Item = (usize, usize, String)>,
+) -> Vec<(usize, usize, String)> {
+    let mut edits: Vec<(usize, usize, String)> = Vec::new();
+    for (start, end, mut replace) in matches {
+        let (whole_start, whole_end) = whole_ending_range(text, start, end);
+        if whole_start < start {
+            replace.insert(0, '\r');
+        }
+        if whole_end > end {
+            replace.push('\n');
+        }
+        let (start, end) = (whole_start, whole_end);
+        // The previous match ended where this one starts, inside the same ending: drop the
+        // `\n` it kept and the `\r` this one kept
+        if let Some(last) = edits.last_mut()
+            && start < last.1
+        {
+            last.2.pop();
+            last.2.push_str(&replace[1..]);
+            last.1 = end;
+            continue;
+        }
+        edits.push((start, end, replace));
+    }
+    edits
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use regex::Regex;
+
+    #[test]
+    fn which_queries_span_lines() {
+        // Plain text never does, even with dot-all on
+        assert!(!spans_lines(r"foo\nbar", false, false, true));
+        // Dot-all only matters with a `.` in it
+        assert!(!spans_lines("foo", true, false, true));
+        assert!(spans_lines("a.b", true, false, true));
+        assert!(!spans_lines("a.b", true, false, false));
+        assert!(spans_lines(r"foo\nbar", true, false, false));
+        assert!(spans_lines(r"foo\r\n", true, false, false));
+        // As in Notepad++: anything that can match a line break searches over lines
+        assert!(spans_lines(r"foo\s+bar", true, false, false));
+        assert!(spans_lines(r"\s+$", true, false, false));
+        assert!(spans_lines(r"a[^x]b", true, false, false));
+        assert!(spans_lines(r"\x0A", true, false, false));
+        assert!(spans_lines(r"[\r]", true, false, false));
+        assert!(!spans_lines(r"[ \t]+$", true, false, false));
+        assert!(!spans_lines(r"^$", true, false, false));
+        assert!(!spans_lines(r"[ \t]+|[^\n\r]x", true, false, false));
+        assert!(!spans_lines(r"\n{0}", true, false, false));
+        // An invalid pattern does not
+        assert!(!spans_lines(r"(\n", true, false, false));
+        assert!(spans_lines("(?s)a.b", true, false, false));
+        assert!(spans_lines("(?is:a.b)", true, false, false));
+        assert!(!spans_lines("(?i)foo", true, false, false));
+        assert!(!spans_lines("(?-s:a.b)", true, false, false));
+        assert!(!spans_lines("(?:a|b)", true, false, false));
+        assert!(!spans_lines(r"a.b\d+\S", true, false, false));
+        // An escaped backslash followed by n is no line break
+        assert!(!spans_lines(r"C:\\new", true, false, false));
+        assert!(spans_lines(r"C:\\\n", true, false, false));
+    }
+
+    #[test]
+    fn real_endings_only_for_cr() {
+        assert!(needs_real_endings(r"foo\r\nbar", true));
+        assert!(!needs_real_endings(r"foo\nbar", true));
+        assert!(!needs_real_endings(r"\\r", true));
+        // Extended mode: the unescaped text
+        assert!(needs_real_endings(r"a\r\nb", false));
+        assert!(needs_real_endings(r"a\x0Db", false));
+        assert!(!needs_real_endings(r"a\nb", false));
+        assert!(!needs_real_endings(r"a\\r", false));
+    }
+
+    #[test]
+    fn extended_queries_span_lines() {
+        assert!(spans_lines(r"a\nb", false, true, false));
+        assert!(spans_lines(r"a\r", false, true, false));
+        assert!(spans_lines(r"a\x0Ab", false, true, false));
+        assert!(spans_lines(r"\u000A", false, true, false));
+        assert!(!spans_lines(r"a\tb", false, true, false));
+        assert!(!spans_lines(r"a\\nb", false, true, false));
+        // Normal mode reads no escapes
+        assert!(!spans_lines(r"a\nb", false, false, false));
+    }
+
+    #[test]
+    fn unescape_each_escape() {
+        assert_eq!(unescape(r"a\nb"), "a\nb");
+        assert_eq!(unescape(r"a\rb"), "a\rb");
+        assert_eq!(unescape(r"a\tb"), "a\tb");
+        assert_eq!(unescape(r"a\0b"), "a\0b");
+        assert_eq!(unescape(r"a\\b"), "a\\b");
+        assert_eq!(unescape(r"\x41\x7a"), "Az");
+        assert_eq!(unescape(r"\u00e9\u20AC"), "é€");
+        assert_eq!(unescape(r"\\n"), "\\n");
+        assert_eq!(unescape(r"\\\n"), "\\\n");
+        assert_eq!(unescape("plain é"), "plain é");
+    }
+
+    #[test]
+    fn unescape_keeps_invalid_escapes() {
+        assert_eq!(unescape(r"C:\data"), r"C:\data");
+        assert_eq!(unescape(r"a\qb"), r"a\qb");
+        assert_eq!(unescape(r"\x4"), r"\x4");
+        assert_eq!(unescape(r"\x4g"), r"\x4g");
+        assert_eq!(unescape(r"\u12"), r"\u12");
+        assert_eq!(unescape(r"\uD800"), r"\uD800");
+        assert_eq!(unescape(r"\xé"), r"\xé");
+        assert_eq!(unescape("end\\"), "end\\");
+        assert_eq!(unescape(r"\1"), r"\1");
+    }
+
+    #[test]
+    fn regex_templates() {
+        assert_eq!(regex_template(r"\2 at \1"), "${2} at ${1}");
+        assert_eq!(regex_template(r"\0"), "${0}");
+        // A group followed by digits
+        assert_eq!(regex_template(r"\10"), "${1}0");
+        assert_eq!(regex_template("${1}0"), "${1}0");
+        // The regex crate's own syntax passes through
+        assert_eq!(regex_template("$1 ${name} $$"), "$1 ${name} $$");
+        // Escapes, with a `$` from one kept literal
+        assert_eq!(regex_template(r"a\nb\t\\1"), "a\nb\t\\1");
+        assert_eq!(regex_template(r"\x24"), "$$");
+        assert_eq!(regex_template(r"\q"), r"\q");
+    }
+
+    fn replaced(replacement: &Replacement, pattern: &str, haystack: &str) -> String {
+        let regex = Regex::new(pattern).unwrap();
+        let mut out = String::new();
+        let mut last = 0;
+        for m in regex.find_iter(haystack) {
+            out.push_str(&haystack[last..m.start()]);
+            out.push_str(&replacement.text_at(&regex, haystack, m.start(), Some(LineEnding::Lf)));
+            last = m.end();
+        }
+        out.push_str(&haystack[last..]);
+        out
+    }
+
+    #[test]
+    fn replacement_groups_in_regex_mode() {
+        let at = Replacement::new(r"\2 at \1", true, false);
+        assert_eq!(
+            replaced(&at, r"(\w+)@(\w+)", "me@host you@there"),
+            "host at me there at you"
+        );
+        let dollar = Replacement::new("$2-$1 ($0) $$", true, false);
+        assert_eq!(replaced(&dollar, r"(\w)(\w)", "ab"), "b-a (ab) $");
+        let named = Replacement::new("${last}, ${first}", true, false);
+        assert_eq!(
+            replaced(&named, r"(?<first>\w+) (?<last>\w+)", "Ada Lovelace"),
+            "Lovelace, Ada"
+        );
+        let digits = Replacement::new("${1}0", true, false);
+        assert_eq!(replaced(&digits, r"(\d)", "7"), "70");
+        let backslash_digits = Replacement::new(r"\10", true, false);
+        assert_eq!(replaced(&backslash_digits, r"(\d)", "7"), "70");
+        // A group that did not take part is empty
+        let missing = Replacement::new("[$2]", true, false);
+        assert_eq!(replaced(&missing, r"(a)|(b)", "a"), "[]");
+    }
+
+    #[test]
+    fn replacement_literal_outside_regex_mode() {
+        let normal = Replacement::new(r"$1 \n", false, false);
+        assert_eq!(replaced(&normal, "x", "axb"), r"a$1 \nb");
+        let extended = Replacement::new(r"$1\n", false, true);
+        assert_eq!(replaced(&extended, ", ", "a, b, c"), "a$1\nb$1\nc");
+    }
+
+    #[test]
+    fn replacement_takes_the_file_ending() {
+        let regex = Regex::new(", ").unwrap();
+        let extended = Replacement::new(r",\n", false, true);
+        assert_eq!(
+            extended.text_at(&regex, "a, b", 1, Some(LineEnding::CrLf)),
+            ",\r\n"
+        );
+        // A captured line break too
+        let regex = Regex::new(r"a(\n)b").unwrap();
+        let template = Replacement::new("$1", true, false);
+        assert_eq!(
+            template.text_at(&regex, "a\nb", 0, Some(LineEnding::CrLf)),
+            "\r\n"
+        );
+    }
+
+    fn lines(ending: LineEnding) -> Vec<(&'static str, LineEnding)> {
+        vec![
+            ("foo", ending),
+            ("bar", ending),
+            ("foo", ending),
+            ("bar", LineEnding::None),
+        ]
+    }
+
+    fn found(joined: &Joined, pattern: &str) -> Vec<(Cursor, Cursor)> {
+        Regex::new(pattern)
+            .unwrap()
+            .find_iter(&joined.text)
+            .map(|m| (joined.cursor(m.start()), joined.cursor(m.end())))
+            .collect()
+    }
+
+    #[test]
+    fn joins_with_newline_for_any_ending() {
+        for ending in [LineEnding::Lf, LineEnding::CrLf, LineEnding::Cr] {
+            let joined = Joined::new(lines(ending), 0, false);
+            assert_eq!(joined.text, "foo\nbar\nfoo\nbar");
+            assert_eq!(
+                found(&joined, r"foo\nbar"),
+                vec![
+                    (Cursor::new(0, 0), Cursor::new(1, 3)),
+                    (Cursor::new(2, 0), Cursor::new(3, 3)),
+                ]
+            );
+        }
+    }
+
+    #[test]
+    fn crlf_with_real_endings() {
+        let joined = Joined::new(lines(LineEnding::CrLf), 0, true);
+        assert_eq!(joined.text, "foo\r\nbar\r\nfoo\r\nbar");
+        assert_eq!(
+            found(&joined, r"foo\r\nbar"),
+            vec![
+                (Cursor::new(0, 0), Cursor::new(1, 3)),
+                (Cursor::new(2, 0), Cursor::new(3, 3)),
+            ]
+        );
+        // `\n` alone does not follow `foo` there
+        assert!(found(&joined, r"foo\nbar").is_empty());
+        // A match ending between CR and LF ends at the line's end
+        assert_eq!(
+            found(&joined, r"bar\r"),
+            vec![(Cursor::new(1, 0), Cursor::new(1, 3))]
+        );
+        assert_eq!(joined.offset(Cursor::new(1, 0)), 5);
+        assert_eq!(joined.offset(Cursor::new(1, 3)), 8);
+    }
+
+    #[test]
+    fn match_ending_at_a_line_end() {
+        let joined = Joined::new(lines(LineEnding::Lf), 0, false);
+        // Ends at the line's end, not the next line's start
+        assert_eq!(
+            found(&joined, "(?m)bar$"),
+            vec![
+                (Cursor::new(1, 0), Cursor::new(1, 3)),
+                (Cursor::new(3, 0), Cursor::new(3, 3)),
+            ]
+        );
+        // Taking the line break ends at the next line's start
+        assert_eq!(
+            found(&joined, r"o\n"),
+            vec![
+                (Cursor::new(0, 2), Cursor::new(1, 0)),
+                (Cursor::new(2, 2), Cursor::new(3, 0)),
+            ]
+        );
+    }
+
+    #[test]
+    fn offsets_and_cursors_round_trip() {
+        let joined = Joined::new(
+            [
+                ("ab", LineEnding::CrLf),
+                ("", LineEnding::CrLf),
+                ("cd", LineEnding::None),
+            ],
+            10,
+            true,
+        );
+        for (line, index) in [(10, 0), (10, 2), (11, 0), (12, 0), (12, 2)] {
+            let cursor = Cursor::new(line, index);
+            assert_eq!(joined.cursor(joined.offset(cursor)), cursor);
+        }
+        // Outside the joined lines: clamped
+        assert_eq!(joined.offset(Cursor::new(3, 1)), 0);
+        assert_eq!(joined.offset(Cursor::new(20, 1)), joined.text.len());
+        assert_eq!(joined.offset(Cursor::new(10, 99)), 2);
+        assert_eq!(joined.cursor(joined.text.len()), Cursor::new(12, 2));
+    }
+
+    #[test]
+    fn empty_text() {
+        let joined = Joined::new(std::iter::empty(), 0, false);
+        assert_eq!(joined.cursor(0), Cursor::new(0, 0));
+        assert_eq!(joined.offset(Cursor::new(0, 0)), 0);
+    }
+
+    #[test]
+    fn replacement_line_endings() {
+        assert_eq!(with_line_ending("X", LineEnding::CrLf), "X");
+        assert_eq!(with_line_ending("a\nb", LineEnding::CrLf), "a\r\nb");
+        assert_eq!(with_line_ending("a\r\nb\rc", LineEnding::Lf), "a\nb\nc");
+        assert_eq!(with_line_ending("a\nb", LineEnding::None), "a\nb");
+        // A query that names `\r` keeps the replacement's line breaks as written
+        let regex = Regex::new(r"\r\n").unwrap();
+        let literal = Replacement::new(r"\n", true, false);
+        assert_eq!(literal.text_at(&regex, "a\r\nb", 1, None), "\n");
+    }
+
+    #[test]
+    fn edits_keep_line_endings_whole() {
+        let text = "a\r\nb\r\nc";
+        let edit = |start, end, replace: &str| (start, end, replace.to_string());
+        // `\r\n` matches a whole ending: unchanged
+        assert_eq!(
+            whole_endings(text, [edit(1, 3, "\n"), edit(4, 6, "\n")]),
+            [edit(1, 3, "\n"), edit(4, 6, "\n")]
+        );
+        // `\r` → "": the whole ending goes, its `\n` stays
+        assert_eq!(whole_endings(text, [edit(1, 2, "")]), [edit(1, 3, "\n")]);
+        // `\nb` → "X": the `\r` stays
+        assert_eq!(whole_endings(text, [edit(2, 4, "X")]), [edit(1, 4, "\rX")]);
+        // `\r|\n` → "": both halves meet in one edit
+        assert_eq!(
+            whole_endings(text, [edit(1, 2, ""), edit(2, 3, "")]),
+            [edit(1, 3, "")]
+        );
+        // LF text is left alone
+        assert_eq!(whole_endings("a\nb", [edit(1, 2, "")]), [edit(1, 2, "")]);
+    }
+}

+    fn plain(text: String) -> String {
+        text.replace(['\u{2068}', '\u{2069}'], "")
+    }
+
+    /// The result lines of `pattern` in `lines`, scanned as Find All does
+    fn find(lines: &[&str], pattern: &str, joined: Option<bool>) -> Vec<ResultLine> {
+        let regex = Regex::new(pattern).unwrap();
+        let matches = find_count::scan_text(
+            lines.iter().enumerate().map(|(i, text)| {
+                let ending = if i + 1 < lines.len() {
+                    cosmic_text::LineEnding::Lf
+                } else {
+                    cosmic_text::LineEnding::None
+                };
+                (*text, ending)
+            }),
+            &regex,
+            joined,
+            HIT_CAP,
+        );
+        result_lines(&matches.spans, |line| lines[line])
+    }
+
+    fn span(line: usize, start: usize, end_line: usize, end: usize) -> find_count::Span {
+        find_count::Span {
+            line,
+            start,
+            end_line,
+            end,
+        }
+    }
+

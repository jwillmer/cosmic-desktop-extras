+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Find and Replace in an editor tab, as in Notepad++: line by line, or in the joined lines for a
+//! query that spans lines; Replace all as one undo step. Upstream's `search` and `replace` in
+//! `tab.rs` stay as they were; the find bar calls these instead.
+
+use cosmic_text::{Cursor, Edit, Selection, ViEditor};
+use regex::Regex;
+
+use crate::{
+    find_range::{self, Pos},
+    find_text::{Joined, Replacement, whole_endings},
+    tab::EditorTab,
+    tab_pieces::apply_edits,
+};
+
+impl EditorTab {
+    /// Whether the selection is the match the last find selected (cursor on its start)
+    pub fn selection_is_last_hit(&self) -> bool {
+        let editor = self.editor.lock().unwrap();
+        editor.selection() != Selection::None
+            && self
+                .last_hit
+                .borrow()
+                .as_ref()
+                .is_some_and(|(hit, _)| *hit == editor.cursor())
+    }
+
+    /// Whether a match of `regex` at `at` is an empty one where the last Replace of it ended:
+    /// Replace skips it, as Replace all skips an empty match right after the previous match
+    /// (see `find_count::replace_matches`), so `$` → `;` moves on to the next line.
+    fn just_replaced(&self, regex: &Regex, at: Cursor, empty: bool) -> bool {
+        empty
+            && self
+                .last_replace
+                .borrow()
+                .as_ref()
+                .is_some_and(|(end, query)| *end == at && query == regex.as_str())
+    }
+
+    /// Replace, searching line by line, as in Notepad++: when the selection is the match there
+    /// (an empty selection at an empty match, of `^` or `$`, too), it is replaced with
+    /// `replacement` and the next match is selected; otherwise only the next match is selected,
+    /// for the next press to replace. Returns the edit when it replaced: the start and end of
+    /// the match and the text put there. An empty match gets the replacement inserted, as in
+    /// Replace all.
+    pub fn replace_lines(
+        &self,
+        regex: &Regex,
+        replacement: &Replacement,
+        wrap_around: bool,
+    ) -> Option<(Pos, Pos, String)> {
+        let ending = Some(self.new_line_ending());
+        let mut editor = self.editor.lock().unwrap();
+        let cursor = editor.cursor();
+        let (start, end) = editor.selection_bounds().unwrap_or((cursor, cursor));
+        let replace = (start.line == end.line && !self.just_replaced(regex, start, start == end))
+            .then(|| {
+                editor.with_buffer(|buffer| {
+                    let text = buffer.lines[start.line].text();
+                    regex
+                        .find_at(text, start.index)
+                        .filter(|m| m.start() == start.index && m.end() == end.index)
+                        .map(|_| replacement.text_at(regex, text, start.index, ending))
+                })
+            })
+            .flatten();
+        let Some(replace) = replace else {
+            drop(editor);
+            self.search_lines(regex, true, wrap_around);
+            return None;
+        };
+        // Never change hidden text
+        editor.with_buffer_mut(|buffer| crate::folding::reveal(buffer, start.line));
+        editor.start_change();
+        // An empty match deletes nothing: the replacement is inserted there
+        editor.delete_range(start, end);
+        let cursor = editor.insert_at(start, &replace, None);
+        editor.set_cursor(cursor);
+        // Need to disable selection to prevent the new cursor showing selection to old location
+        editor.set_selection(Selection::None);
+        editor.finish_change();
+        *self.last_replace.borrow_mut() = Some((cursor, regex.as_str().to_string()));
+        drop(editor);
+        self.search_after(regex, true, wrap_around, Some(cursor));
+        Some(((start.line, start.index), (end.line, end.index), replace))
+    }
+
+    /// Replace all for a query searched line by line: every match of each line, empty ones too
+    /// (see `find_count::replace_matches`), as one undo step. The cursor ends after the last replacement. With `range` ("In selection") only
+    /// the matches inside it. Returns how many were replaced and where the range ends after.
+    pub fn replace_all(
+        &self,
+        regex: &Regex,
+        replacement: &Replacement,
+        range: Option<(Pos, Pos)>,
+    ) -> (usize, Option<Pos>) {
+        let ending = Some(self.new_line_ending());
+        let mut editor = self.editor.lock().unwrap();
+        // Each line's matches with their replacement, found before any change
+        let found: Vec<(usize, Vec<(usize, usize, String)>)> = editor.with_buffer(|buffer| {
+            buffer
+                .lines
+                .iter()
+                .enumerate()
+                .filter(|(line, _)| range.is_none_or(|(from, to)| (from.0..=to.0).contains(line)))
+                .filter_map(|(line, buffer_line)| {
+                    let text = buffer_line.text();
+                    let matches: Vec<_> = crate::find_count::replace_matches(regex, text)
+                        .filter(|&(start, end)| {
+                            range.is_none_or(|range| {
+                                find_range::inside((line, start), (line, end), range)
+                            })
+                        })
+                        .map(|(start, end)| {
+                            (start, end, replacement.text_at(regex, text, start, ending))
+                        })
+                        .collect();
+                    (!matches.is_empty()).then_some((line, matches))
+                })
+                .collect()
+        });
+        let (Some((first, _)), Some((last, _))) = (found.first(), found.last()) else {
+            return (0, range.map(|(_, to)| to));
+        };
+        let edits: Vec<_> = found
+            .iter()
+            .flat_map(|(line, matches)| {
+                matches
+                    .iter()
+                    .map(|(start, end, replace)| ((*line, *start), (*line, *end), replace.as_str()))
+            })
+            .collect();
+        let range_end = range.map(|(_, to)| find_range::shift(to, &edits));
+        // Where the last replacement ends once all are made
+        let &(_, last_end, _) = edits.last().unwrap();
+        let (line, index) = find_range::shift(last_end, &edits);
+        // Never change hidden text
+        editor.with_buffer_mut(|buffer| crate::folding::unfold_lines(buffer, *first, *last));
+        editor.start_change();
+        apply_edits(&mut *editor, &edits);
+        editor.set_cursor(Cursor::new(line, index));
+        editor.set_selection(Selection::None);
+        editor.finish_change();
+        (edits.len(), range_end)
+    }
+
+    /// The buffer's lines joined, to find matches of a query that spans lines
+    /// (see `find_text::spans_lines`); `real_endings` as in `find_text::Joined::new`.
+    fn joined(editor: &ViEditor<'static, 'static>, real_endings: bool) -> Joined {
+        editor.with_buffer(|buffer| {
+            Joined::new(
+                buffer.lines.iter().map(|line| (line.text(), line.ending())),
+                0,
+                real_endings,
+            )
+        })
+    }
+
+    /// The file's line ending for the line breaks of a replacement, or `None` to keep them as
+    /// written for a query that names `\r` (`real_endings`): it edits line endings itself.
+    fn replace_ending(&self, real_endings: bool) -> Option<cosmic_text::LineEnding> {
+        (!real_endings).then(|| self.new_line_ending())
+    }
+
+    /// `replace_lines` for a query that spans lines, searched in the joined lines: the selection is
+    /// replaced when it is the match there, with its line breaks in the file's ending (see
+    /// `replace_ending`), then the next match is selected; otherwise only the next match is
+    /// selected. Empty matches as in `replace_lines`, part of a `\r\n` as in
+    /// `find_text::whole_endings`. One undo step. Returns the edit as `replace_lines` does.
+    pub fn replace_joined(
+        &self,
+        regex: &Regex,
+        real_endings: bool,
+        replacement: &Replacement,
+        wrap_around: bool,
+    ) -> Option<(Pos, Pos, String)> {
+        let ending = self.replace_ending(real_endings);
+        let mut editor = self.editor.lock().unwrap();
+        let joined = Self::joined(&editor, real_endings);
+        let cursor = editor.cursor();
+        let (sel_start, sel_end) = editor.selection_bounds().unwrap_or((cursor, cursor));
+        // A match that ends inside a `\r\n` is selected up to its line's end
+        let found = regex
+            .find_at(&joined.text, joined.offset(sel_start))
+            .map(|m| (m.start(), m.end()))
+            .filter(|&(start, end)| {
+                joined.cursor(start) == sel_start
+                    && joined.cursor(end) == sel_end
+                    && !self.just_replaced(regex, sel_start, start == end)
+            });
+        let Some((start, end)) = found else {
+            drop(editor);
+            self.search_joined(regex, real_endings, true, wrap_around);
+            return None;
+        };
+        let replace = replacement.text_at(regex, &joined.text, start, ending);
+        let (start, end, replace) = whole_endings(&joined.text, [(start, end, replace)]).pop()?;
+        let (start, end) = (joined.cursor(start), joined.cursor(end));
+        // Never change hidden text
+        editor.with_buffer_mut(|buffer| crate::folding::unfold_lines(buffer, start.line, end.line));
+        editor.start_change();
+        editor.delete_range(start, end);
+        let cursor = editor.insert_at(start, &replace, None);
+        editor.set_cursor(cursor);
+        editor.set_selection(Selection::None);
+        editor.finish_change();
+        *self.last_replace.borrow_mut() = Some((cursor, regex.as_str().to_string()));
+        drop(editor);
+        self.search_joined_after(regex, real_endings, true, wrap_around, Some(cursor));
+        Some(((start.line, start.index), (end.line, end.index), replace))
+    }
+
+    /// Replace all for a query that spans lines: every match in the joined lines, empty ones too
+    /// (see `find_count::replace_matches`), as one undo step; line endings as in
+    /// `replace_joined`. The cursor ends after the last replacement. With `range` ("In
+    /// selection") only the matches inside it. Returns how many were replaced and where the
+    /// range ends after.
+    pub fn replace_all_joined(
+        &self,
+        regex: &Regex,
+        real_endings: bool,
+        replacement: &Replacement,
+        range: Option<(Pos, Pos)>,
+    ) -> (usize, Option<Pos>) {
+        let ending = self.replace_ending(real_endings);
+        let mut editor = self.editor.lock().unwrap();
+        let joined = Self::joined(&editor, real_endings);
+        let pos = |offset| {
+            let cursor = joined.cursor(offset);
+            (cursor.line, cursor.index)
+        };
+        let in_range =
+            |start, end| range.is_none_or(|range| find_range::inside(pos(start), pos(end), range));
+        let matches = crate::find_count::replace_matches(regex, &joined.text)
+            .filter(|&(start, end)| in_range(start, end))
+            .map(|(start, end)| {
+                let replace = replacement.text_at(regex, &joined.text, start, ending);
+                (start, end, replace)
+            });
+        // A match that takes a whole `\r\n` must still be inside the range
+        let edits: Vec<(Pos, Pos, String)> = whole_endings(&joined.text, matches)
+            .into_iter()
+            .filter(|&(start, end, _)| in_range(start, end))
+            .map(|(start, end, replace)| (pos(start), pos(end), replace))
+            .collect();
+        let Some(&(_, last_end, _)) = edits.last() else {
+            return (0, range.map(|(_, to)| to));
+        };
+        let shifts: Vec<_> = edits
+            .iter()
+            .map(|(start, end, replace)| (*start, *end, replace.as_str()))
+            .collect();
+        let range_end = range.map(|(_, to)| find_range::shift(to, &shifts));
+        // Where the last replacement ends once all are made
+        let (line, index) = find_range::shift(last_end, &shifts);
+        editor.with_buffer_mut(|buffer| {
+            crate::folding::unfold_lines(buffer, edits[0].0.0, last_end.0)
+        });
+        editor.start_change();
+        apply_edits(&mut *editor, &shifts);
+        editor.set_cursor(Cursor::new(line, index));
+        editor.set_selection(Selection::None);
+        editor.finish_change();
+        (edits.len(), range_end)
+    }
+
+    /// `search_lines` for a query that spans lines: the next or previous match in the joined lines.
+    /// The match is selected (cursor at its start) and the folds it touches are opened.
+    pub fn search_joined(
+        &self,
+        regex: &Regex,
+        real_endings: bool,
+        forwards: bool,
+        wrap_around: bool,
+    ) -> bool {
+        self.search_joined_after(regex, real_endings, forwards, wrap_around, None)
+    }
+
+    /// `search_joined`, or after a Replace as in `search_after`
+    fn search_joined_after(
+        &self,
+        regex: &Regex,
+        real_endings: bool,
+        forwards: bool,
+        wrap_around: bool,
+        replaced: Option<Cursor>,
+    ) -> bool {
+        let mut editor = self.editor.lock().unwrap();
+        let joined = Self::joined(&editor, real_endings);
+        let at = joined.offset(editor.cursor());
+        let past = replaced.is_none()
+            && steps_past(
+                editor.selection() != Selection::None,
+                editor.cursor(),
+                regex.as_str(),
+                self.last_hit.borrow().as_ref(),
+            );
+        // Empty matches too, as in `search_lines`: `^` steps from line to line
+        let matches = || {
+            crate::find_count::replace_matches(regex, &joined.text)
+                .filter(|&(start, end)| start < end || replaced != Some(joined.cursor(start)))
+        };
+        let found = if forwards {
+            matches()
+                .find(|&(start, _)| start > at || start == at && !past)
+                .or_else(|| wrap_around.then(|| matches().next()).flatten())
+        } else {
+            matches()
+                .take_while(|&(start, _)| start < at || start == at && !past)
+                .last()
+                .or_else(|| wrap_around.then(|| matches().last()).flatten())
+        };
+        let Some((start, end)) = found else {
+            return false;
+        };
+        let (start, end) = (joined.cursor(start), joined.cursor(end));
+        editor.set_cursor(start);
+        editor.set_selection(Selection::Normal(end));
+        crate::folding::reveal_selection(&mut *editor);
+        *self.last_hit.borrow_mut() = Some((start, regex.as_str().to_string()));
+        true
+    }
+
+    /// The next or previous match of `regex`, searched line by line: it is selected (cursor at
+    /// its start) and its fold opened. Upstream's `search` with the find bar's steps (see
+    /// `steps_past`).
+    pub fn search_lines(&self, regex: &Regex, forwards: bool, wrap_around: bool) -> bool {
+        self.search_after(regex, forwards, wrap_around, None)
+    }
+
+    /// `search_lines`, or after a Replace that left the cursor at `replaced` (the end of its
+    /// replacement): a match there is found, except an empty one (see `just_replaced`)
+    fn search_after(
+        &self,
+        regex: &Regex,
+        forwards: bool,
+        wrap_around: bool,
+        replaced: Option<Cursor>,
+    ) -> bool {
+        let mut editor = self.editor.lock().unwrap();
+        let mut cursor = editor.cursor();
+        let mut wrapped = false; // Keeps track of whether the search has wrapped around yet.
+        let start_line = cursor.line;
+        let past = replaced.is_none()
+            && steps_past(
+                editor.selection() != Selection::None,
+                cursor,
+                regex.as_str(),
+                self.last_hit.borrow().as_ref(),
+            );
+        let skipped = |line: usize, m: &regex::Match| {
+            m.is_empty() && replaced == Some(Cursor::new(line, m.start()))
+        };
+
+        if forwards {
+            while cursor.line < editor.with_buffer(|buffer| buffer.lines.len()) {
+                if let Some((start, end)) = editor.with_buffer(|buffer| {
+                    regex
+                        .find_iter(buffer.lines[cursor.line].text())
+                        .filter(|m| !skipped(cursor.line, m))
+                        .filter_map(|m| {
+                            if cursor.line != start_line
+                                || m.start() > cursor.index
+                                || m.start() == cursor.index && !past
+                                || m.start() < cursor.index && wrapped
+                            {
+                                Some((m.start(), m.end()))
+                            } else {
+                                None
+                            }
+                        })
+                        .next()
+                }) {
+                    cursor.index = start;
+                    editor.set_cursor(cursor);
+                    editor.with_buffer_mut(|buffer| crate::folding::reveal(buffer, cursor.line));
+
+                    // Highlight searched text
+                    let selection = Selection::Normal(Cursor::new(cursor.line, end));
+                    editor.set_selection(selection);
+                    *self.last_hit.borrow_mut() = Some((cursor, regex.as_str().to_string()));
+
+                    return true;
+                }
+
+                cursor.line += 1;
+
+                // If we haven't wrapped yet and we've reached the last line, reset cursor line to 0 and
+                // set wrapped to true so we don't wrap again
+                if wrap_around
+                    && !wrapped
+                    && cursor.line == editor.with_buffer(|buffer| buffer.lines.len())
+                {
+                    cursor.line = 0;
+                    wrapped = true;
+                }
+            }
+        } else {
+            cursor.line += 1;
+            while cursor.line > 0 {
+                cursor.line -= 1;
+
+                if let Some((start, end)) = editor.with_buffer(|buffer| {
+                    regex
+                        .find_iter(buffer.lines[cursor.line].text())
+                        .filter(|m| !skipped(cursor.line, m))
+                        .filter_map(|m| {
+                            if cursor.line != start_line
+                                || m.start() < cursor.index
+                                || m.start() == cursor.index && !past
+                                || m.start() > cursor.index && wrapped
+                            {
+                                Some((m.start(), m.end()))
+                            } else {
+                                None
+                            }
+                        })
+                        .last()
+                }) {
+                    cursor.index = start;
+                    editor.set_cursor(cursor);
+                    editor.with_buffer_mut(|buffer| crate::folding::reveal(buffer, cursor.line));
+
+                    // Highlight searched text
+                    let selection = Selection::Normal(Cursor::new(cursor.line, end));
+                    editor.set_selection(selection);
+                    *self.last_hit.borrow_mut() = Some((cursor, regex.as_str().to_string()));
+
+                    return true;
+                }
+
+                // If we haven't wrapped yet and we've reached the first line, reset cursor line to the
+                // last line and set wrapped to true so we don't wrap again
+                if wrap_around && !wrapped && cursor.line == 0 {
+                    cursor.line = editor.with_buffer(|buffer| buffer.lines.len());
+                    wrapped = true;
+                }
+            }
+        }
+        false
+    }
+}
+
+/// Whether a find from `cursor` skips a match that starts right there: it does with a match
+/// selected (the cursor is on its start), and also when the last find of the same query landed
+/// there and Escape then cleared the selection. Otherwise a match at the cursor is found, so
+/// Enter on a new query finds the one under the cursor (e.g. at the start of the file).
+fn steps_past(
+    selected: bool,
+    cursor: Cursor,
+    query: &str,
+    last_hit: Option<&(Cursor, String)>,
+) -> bool {
+    selected || last_hit.is_some_and(|(hit, hit_query)| *hit == cursor && hit_query == query)
+}
+
+#[cfg(test)]
+mod tests {
+    use cosmic_text::Edit;
+
+    use crate::tab_pieces::tests::Counted;
+
+    #[test]
+    fn find_steps_past_the_last_hit_after_escape() {
+        use super::steps_past;
+        use cosmic_text::Cursor;
+        let at = Cursor::new(0, 11);
+        let hit = (at, "alpha".to_string());
+        // A selected match is always stepped past
+        assert!(steps_past(true, at, "alpha", None));
+        // Nothing selected, no earlier find: the match at the cursor counts
+        assert!(!steps_past(false, at, "alpha", None));
+        // Escape cleared the selection of the last hit: F3 moves on
+        assert!(steps_past(false, at, "alpha", Some(&hit)));
+        // The cursor moved away, or another query: the match at the cursor counts
+        assert!(!steps_past(false, Cursor::new(0, 0), "alpha", Some(&hit)));
+        assert!(!steps_past(false, at, "alp", Some(&hit)));
+    }
+
+    #[test]
+    fn find_next_after_escape_moves_on() {
+        let config = crate::Config::default();
+        let tab = crate::tab::EditorTab::new(&config);
+        tab.editor
+            .lock()
+            .unwrap()
+            .insert_string("alpha beta alpha gamma alpha", None);
+        tab.editor
+            .lock()
+            .unwrap()
+            .set_cursor(cosmic_text::Cursor::new(0, 0));
+        let regex = regex::Regex::new("alpha").unwrap();
+        let cursor = || tab.editor.lock().unwrap().cursor().index;
+        // Enter on a new query finds the match right at the cursor
+        assert!(tab.search_lines(&regex, true, true));
+        assert_eq!(cursor(), 0);
+        assert!(tab.search_lines(&regex, true, true));
+        assert_eq!(cursor(), 11);
+        // Escape clears the selection, the cursor stays on the match
+        tab.editor
+            .lock()
+            .unwrap()
+            .set_selection(cosmic_text::Selection::None);
+        assert!(tab.search_lines(&regex, true, true));
+        assert_eq!(cursor(), 23, "F3 after Escape moves on");
+        tab.editor
+            .lock()
+            .unwrap()
+            .set_selection(cosmic_text::Selection::None);
+        assert!(tab.search_lines(&regex, false, true));
+        assert_eq!(cursor(), 11, "Shift+F3 after Escape moves back");
+        tab.editor
+            .lock()
+            .unwrap()
+            .set_selection(cosmic_text::Selection::None);
+        assert!(tab.search_joined(&regex, false, true, true));
+        assert_eq!(cursor(), 23, "the same for a query across lines");
+    }
+
+    /// Find next of `pattern` (regex mode) from the start of `text` `steps` times, the way the
+    /// find bar picks the search: where each lands
+    fn find_steps(text: &str, pattern: &str, steps: usize) -> Vec<(usize, usize)> {
+        let tab = tab_with(text);
+        let (regex, joined) = regex_query(pattern);
+        (0..steps)
+            .map(|_| {
+                match joined {
+                    Some(real_endings) => tab.search_joined(&regex, real_endings, true, true),
+                    None => tab.search_lines(&regex, true, true),
+                };
+                let cursor = tab.editor.lock().unwrap().cursor();
+                (cursor.line, cursor.index)
+            })
+            .collect()
+    }
+
+    #[test]
+    fn find_next_steps_over_empty_matches() {
+        let text = "ab\n\ncd";
+        // `^` from line to line, as in Notepad++, then around
+        let lines = vec![(0, 0), (1, 0), (2, 0), (0, 0)];
+        assert_eq!(find_steps(text, "^", 4), lines);
+        // The same across lines
+        assert_eq!(find_steps(text, r"^|\n\n", 2), vec![(0, 0), (0, 2)]);
+        // `x*`: no empty match right after a match
+        assert_eq!(
+            find_steps("axxb", "x*", 4),
+            vec![(0, 0), (0, 1), (0, 4), (0, 0)]
+        );
+    }
+
+    /// A tab holding `text`, its cursor at the start
+    fn tab_with(text: &str) -> crate::tab::EditorTab {
+        let tab = crate::tab::EditorTab::new(&crate::Config::default());
+        let mut editor = tab.editor.lock().unwrap();
+        editor.insert_string(text, None);
+        editor.set_cursor(cosmic_text::Cursor::new(0, 0));
+        drop(editor);
+        tab
+    }
+
+    /// The tab's text with each line's own ending
+    fn text_of(tab: &crate::tab::EditorTab) -> String {
+        tab.editor.lock().unwrap().with_buffer(|buffer| {
+            buffer
+                .lines
+                .iter()
+                .map(|line| format!("{}{}", line.text(), line.ending().as_str()))
+                .collect()
+        })
+    }
+
+    /// The find bar's regex for `pattern` in regex mode, and how it is searched (as
+    /// `App::find_joined` gives it)
+    fn regex_query(pattern: &str) -> (regex::Regex, Option<bool>) {
+        let config = crate::Config {
+            find_use_regex: true,
+            ..crate::Config::default()
+        };
+        let joined = crate::find_text::spans_lines(pattern, true, false, false)
+            .then(|| crate::find_text::needs_real_endings(pattern, true));
+        (config.find_regex(pattern).unwrap(), joined)
+    }
+
+    /// Replace all of `pattern` with `replace_lines` in `text`, as the find bar runs it
+    fn replace_all(text: &str, pattern: &str, replace: &str) -> (usize, String) {
+        let tab = tab_with(text);
+        let (regex, joined) = regex_query(pattern);
+        let replacement = crate::find_text::Replacement::new(replace, true, false);
+        let (count, _) = match joined {
+            Some(real_endings) => tab.replace_all_joined(&regex, real_endings, &replacement, None),
+            None => tab.replace_all(&regex, &replacement, None),
+        };
+        (count, text_of(&tab))
+    }
+
+    #[test]
+    fn replace_all_anchors_each_line() {
+        // `\s` matches line breaks, as in Notepad++: `^\s+` strips every line's indent and the
+        // blank lines too, `\s+$` every line's end and the blank lines after it
+        assert_eq!(
+            replace_all("  a\n\n\tb\n  c", r"^\s+", ""),
+            (3, "a\nb\nc".to_string())
+        );
+        assert_eq!(
+            replace_all("a  \n\nb\t\n\nc ", r"\s+$", ""),
+            (3, "a\nb\nc".to_string())
+        );
+        // `[ \t]+$` trims each line's end only
+        assert_eq!(
+            replace_all("a  \n\nb\t\n\nc ", r"[ \t]+$", ""),
+            (3, "a\n\nb\n\nc".to_string())
+        );
+        // In the joined lines too: `^` and `$` are each line's start and end
+        assert_eq!(
+            replace_all("a\n\n  \nb", r"^\s*\n", ""),
+            (1, "a\nb".to_string())
+        );
+        assert_eq!(
+            replace_all("a\r\n\r\nb", r"^\r\n", ""),
+            (1, "a\r\nb".to_string())
+        );
+    }
+
+    #[test]
+    fn replace_all_in_range_sees_whole_lines() {
+        // A range that starts mid-line: `^` does not match at the range's start
+        let tab = tab_with("xa\na");
+        let (regex, joined) = regex_query("^a");
+        assert_eq!(joined, None);
+        let replacement = crate::find_text::Replacement::new("b", true, false);
+        let (count, _) = tab.replace_all(&regex, &replacement, Some(((0, 1), (1, 1))));
+        assert_eq!((count, text_of(&tab)), (1, "xa\nb".to_string()));
+    }
+
+    #[test]
+    fn replace_inserts_at_empty_matches() {
+        for (pattern, replace, once, twice) in [
+            ("^", "> ", "> a\nb\n", "> a\n> b\n"),
+            ("$", ";", "a;\nb\n", "a;\nb;\n"),
+        ] {
+            let tab = tab_with("a\nb\n");
+            let (regex, joined) = regex_query(pattern);
+            assert_eq!(joined, None);
+            let replacement = crate::find_text::Replacement::new(replace, true, false);
+            // `$` is not at the cursor: the first press only goes to it
+            if pattern == "$" {
+                assert!(tab.replace_lines(&regex, &replacement, false).is_none());
+                assert_eq!(text_of(&tab), "a\nb\n");
+            }
+            assert!(tab.replace_lines(&regex, &replacement, false).is_some());
+            assert_eq!(text_of(&tab), once, "{pattern}: no line break is deleted");
+            assert!(tab.replace_lines(&regex, &replacement, false).is_some());
+            assert_eq!(text_of(&tab), twice, "{pattern}: the next Replace moves on");
+        }
+        // The same in the joined lines
+        let tab = tab_with("a\nb\n");
+        let (regex, _) = regex_query(r"$(?:\n)?");
+        let replacement = crate::find_text::Replacement::new(";", true, false);
+        assert!(
+            tab.replace_joined(&regex, false, &replacement, false)
+                .is_none()
+        );
+        assert!(
+            tab.replace_joined(&regex, false, &replacement, false)
+                .is_some()
+        );
+        assert_eq!(text_of(&tab), "a;b\n");
+    }
+
+    /// The selection after a find bar action: start and end, as (line, index)
+    fn selected(tab: &crate::tab::EditorTab) -> ((usize, usize), (usize, usize)) {
+        let editor = tab.editor.lock().unwrap();
+        let cursor = editor.cursor();
+        let (start, end) = editor.selection_bounds().unwrap_or((cursor, cursor));
+        ((start.line, start.index), (end.line, end.index))
+    }
+
+    #[test]
+    fn replace_selects_first_then_replaces() {
+        // As in Notepad++: a selection that is no match is not replaced, the next match is
+        // selected; a press on a selected match replaces it and selects the next
+        let replacement = crate::find_text::Replacement::new("X", true, false);
+        let tab = tab_with("cat a\ncat aa");
+        let (regex, _) = regex_query("a+");
+        assert!(tab.replace_lines(&regex, &replacement, true).is_none());
+        assert_eq!(text_of(&tab), "cat a\ncat aa");
+        assert_eq!(selected(&tab), ((0, 1), (0, 2)));
+        assert!(tab.replace_lines(&regex, &replacement, true).is_some());
+        assert_eq!(text_of(&tab), "cXt a\ncat aa");
+        assert_eq!(selected(&tab), ((0, 4), (0, 5)));
+        // A match right after the replacement is found too
+        let tab = tab_with("aa");
+        let (regex, _) = regex_query("a");
+        assert!(tab.replace_lines(&regex, &replacement, false).is_none());
+        assert!(tab.replace_lines(&regex, &replacement, false).is_some());
+        assert_eq!(
+            (text_of(&tab), selected(&tab)),
+            ("Xa".to_string(), ((0, 1), (0, 2)))
+        );
+        // Across lines; the edit is returned for the "In selection" range to follow
+        let tab = tab_with("a\nb\na\nb");
+        let (regex, joined) = regex_query(r"a\n");
+        assert_eq!(joined, Some(false));
+        assert!(
+            tab.replace_joined(&regex, false, &replacement, false)
+                .is_none()
+        );
+        assert_eq!(
+            tab.replace_joined(&regex, false, &replacement, false),
+            Some(((0, 0), (1, 0), "X".to_string()))
+        );
+        assert_eq!(text_of(&tab), "Xb\na\nb");
+        assert_eq!(selected(&tab), ((1, 0), (2, 0)));
+    }
+
+    #[test]
+    fn replace_edits_crlf_line_endings() {
+        // `\r\n` → `\n` turns CRLF lines into LF ones, not back into CRLF
+        assert_eq!(
+            replace_all("a\r\nb\r\nc", r"\r\n", r"\n"),
+            (2, "a\nb\nc".to_string())
+        );
+        // `\r` → "": the `\n` stays
+        assert_eq!(
+            replace_all("a\r\nb\r\nc", r"\r", ""),
+            (2, "a\nb\nc".to_string())
+        );
+        // `\r|\n` → "" joins the lines
+        assert_eq!(
+            replace_all("a\r\nb\r\nc", r"\r|\n", ""),
+            (2, "abc".to_string())
+        );
+        // Replace selects the first, then takes one at a time
+        let tab = tab_with("a\r\nb\r\nc");
+        let (regex, joined) = regex_query(r"\r\n");
+        assert_eq!(joined, Some(true));
+        let replacement = crate::find_text::Replacement::new(r"\n", true, false);
+        assert!(
+            tab.replace_joined(&regex, true, &replacement, false)
+                .is_none()
+        );
+        assert_eq!(text_of(&tab), "a\r\nb\r\nc");
+        assert!(
+            tab.replace_joined(&regex, true, &replacement, false)
+                .is_some()
+        );
+        assert_eq!(text_of(&tab), "a\nb\r\nc");
+        assert!(
+            tab.replace_joined(&regex, true, &replacement, false)
+                .is_some()
+        );
+        assert_eq!(text_of(&tab), "a\nb\nc");
+        assert!(
+            tab.replace_joined(&regex, true, &replacement, false)
+                .is_none()
+        );
+        // Replace all leaves the cursor after the last replacement
+        let tab = tab_with("a\r\nb\r\nc");
+        let replacement = crate::find_text::Replacement::new("-", true, false);
+        tab.replace_all_joined(&regex, true, &replacement, None);
+        assert_eq!(text_of(&tab), "a-b-c");
+        assert_eq!(
+            tab.editor.lock().unwrap().cursor(),
+            cosmic_text::Cursor::new(0, 4)
+        );
+    }
+
+    #[test]
+    fn replace_all_rewrites_many_line_breaks_at_once() {
+        // 300 CRLF lines, one LF line among them: enough replacements that add a line break
+        // for the lines to be rewritten in one go
+        let mut text = "k, v\r\n".repeat(300) + "end";
+        text.replace_range(150 * 6..150 * 6 + 6, "k, v\n");
+        let tab = tab_with(&text);
+        let (regex, joined) = regex_query(", ");
+        assert_eq!(joined, None);
+        let replacement = crate::find_text::Replacement::new(r",\n", true, false);
+        let range = Some(((0, 0), (300, 3)));
+        let (count, range_end) = tab.replace_all(&regex, &replacement, range);
+        let replaced = text.replace(", ", ",\r\n");
+        assert_eq!((count, text_of(&tab)), (300, replaced.clone()));
+        assert_eq!(
+            range_end,
+            Some((600, 3)),
+            "the range ends where it did, moved down"
+        );
+        let cursor = || tab.editor.lock().unwrap().cursor();
+        assert_eq!(
+            cursor(),
+            cosmic_text::Cursor::new(599, 0),
+            "after the last one"
+        );
+        tab.editor.lock().unwrap().undo();
+        assert_eq!(text_of(&tab), text, "one undo step");
+        tab.editor.lock().unwrap().redo();
+        assert_eq!(text_of(&tab), replaced);
+        // The same back in the joined lines: each removes a line break
+        let (regex, joined) = regex_query(r",\r\n");
+        assert_eq!(joined, Some(true));
+        let replacement = crate::find_text::Replacement::new(", ", true, false);
+        let (count, _) = tab.replace_all_joined(&regex, true, &replacement, None);
+        assert_eq!((count, text_of(&tab)), (300, text.clone()));
+        assert_eq!(cursor(), cosmic_text::Cursor::new(299, 3));
+        tab.editor.lock().unwrap().undo();
+        assert_eq!(text_of(&tab), replaced);
+        // Rewritten, the lines move a number of times linear in theirs: one by one, the
+        // 3,000 edits would move 13.5 million
+        let text = "k, v\r\n".repeat(3_000);
+        let mut editor = crate::column_select::tests::editor(&text);
+        let edits: Vec<_> = (0..3_000)
+            .map(|line| ((line, 2), (line, 3), "\r\n"))
+            .collect();
+        let mut counted = Counted {
+            editor: &mut editor,
+            moved: 0,
+        };
+        counted.start_change();
+        crate::tab_pieces::apply_edits(&mut counted, &edits);
+        counted.finish_change();
+        let moved = counted.moved;
+        assert_eq!(
+            crate::tab::editor_text(&editor),
+            text.replace(", ", ",\r\n")
+        );
+        assert!(
+            moved <= 2 * 6_000 * crate::tab_pieces::INSERT_LINES,
+            "{moved} lines moved"
+        );
+        editor.undo();
+        assert_eq!(crate::tab::editor_text(&editor), text);
+    }
+
+    /// The 5 MB Markdown file of the performance runs: 24,170 sections of 18 lines, 435,060
+    /// lines in all.
+    fn big_markdown() -> String {
+        (1..=24_170)
+            .map(|n| {
+                format!(
+                    "## Section {n}\n\nSome **bold** text and a [link](https://example.org/{n}) \
+                     with `code`.\n\n- item a\n  - nested b\n- [ ] task {n}\n\n| a | b |\n\
+                     |---|---|\n| {n} | x |\n\n```python\nprint({n})\n```\n\n> quote {n}\n\n"
+                )
+            })
+            .collect()
+    }
+
+    /// A tab holding `text`, set at once (not typed in), its cursor at the start
+    fn big_tab(text: &str) -> crate::tab::EditorTab {
+        crate::SYNTAX_SYSTEM.get_or_init(crate::tab_plain::syntax_system);
+        let tab = crate::tab::EditorTab::new(&crate::Config::default());
+        tab.editor.lock().unwrap().with_buffer_mut(|buffer| {
+            buffer.set_text(
+                text,
+                &crate::monospace_attrs(),
+                cosmic_text::Shaping::Advanced,
+                None,
+            )
+        });
+        tab
+    }
+
+    /// Timings of Find and Replace all on the 5 MB file. Run with
+    /// `cargo test --release find_timings -- --ignored --nocapture`.
+    #[test]
+    #[ignore]
+    fn find_timings() {
+        use std::time::Instant;
+        let text = big_markdown();
+        let lines = text.lines().count();
+        eprintln!("{} bytes, {lines} lines", text.len());
+        let time = |name: &str, f: &dyn Fn() -> String| {
+            let at = Instant::now();
+            let result = f();
+            eprintln!("{name}: {:.3} s ({result})", at.elapsed().as_secs_f64());
+        };
+        let replace = |pattern: &str, with: &str| {
+            let tab = big_tab(&text);
+            let (regex, joined) = regex_query(pattern);
+            let replacement = crate::find_text::Replacement::new(with, true, false);
+            let at = Instant::now();
+            let (count, _) = match joined {
+                Some(real_endings) => {
+                    tab.replace_all_joined(&regex, real_endings, &replacement, None)
+                }
+                None => tab.replace_all(&regex, &replacement, None),
+            };
+            let took = at.elapsed().as_secs_f64();
+            let lines = tab.editor.lock().unwrap().with_buffer(|b| b.lines.len());
+            let at = Instant::now();
+            tab.editor.lock().unwrap().undo();
+            let undo = at.elapsed().as_secs_f64();
+            assert_eq!(crate::tab::editor_text(&tab.editor.lock().unwrap()), text);
+            format!("{took:.3} s, {count} replaced, {lines} lines after; undo {undo:.3} s")
+        };
+        time("(a) per line, no line breaks: Section -> Part", &|| {
+            replace("Section", "Part")
+        });
+        time(
+            r"(b) per line, adds line breaks: (item|nested)  -> $1\n",
+            &|| replace("(item|nested) ", r"$1\n"),
+        );
+        time(
+            r"(c) joined, removes line breaks: \n\n([|>]) -> \n$1",
+            &|| replace(r"\n\n([|>])", r"\n$1"),
+        );
+        time(r"(c2) joined, every blank line: \n\n -> \n", &|| {
+            replace(r"\n\n", r"\n")
+        });
+        let tab = big_tab(&text);
+        time("(d) Find next, joined query near the end", &|| {
+            let (regex, joined) = regex_query(r"quote 24169\n\n## Section 24170");
+            let found = tab.search_joined(&regex, joined.unwrap(), true, true);
+            format!("found {found} at {:?}", tab.editor.lock().unwrap().cursor())
+        });
+        time("(e) count of a common word: item", &|| {
+            let regex = regex::Regex::new("item").unwrap();
+            let matches = tab.editor.lock().unwrap().with_buffer(|buffer| {
+                crate::find_count::scan(
+                    buffer.lines.iter().map(|line| line.text()),
+                    &regex,
+                    crate::find_count::MATCH_CAP,
+                )
+            });
+            format!("{} matches, capped {}", matches.spans.len(), matches.capped)
+        });
+    }

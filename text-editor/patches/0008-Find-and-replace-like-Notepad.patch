+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Find in Files, as Notepad++'s "Find in Files" tab of the Find dialog: Find All lists the
+//! matches of every file under a folder in the Search results panel, Replace in Files replaces
+//! them on disk.
+//!
+//! The folder's files are walked with the `ignore` crate (as upstream's "Find in project"
+//! does), but without its `.gitignore` rules: Notepad++ searches every file the filters name.
+//! The filters are Notepad++'s: globs separated by spaces or semicolons, `*.*` for every file,
+//! and `!name` to leave out files and folders of that name. A file is searched with the same
+//! scan as the dialog's match count (`find_count::scan_text`), so the options and the search
+//! mode mean what they mean in one document. Binary files (a NUL byte in the first 8 KB) and
+//! files over 50 MB are skipped.
+//!
+//! The walk runs in a blocking task, off the UI thread; a newer search or replace makes an
+//! older one stop, and its late result is dropped.
+//!
+//! Replace in Files writes each file whole through a temporary file and a rename, so a file is
+//! never left half written; line endings stay as they were, and files that are not UTF-8 are
+//! left alone and counted. A file open in a tab with unsaved changes is replaced in that tab
+//! instead, as an edit that can be undone; disk files cannot be undone (Notepad++ neither), so
+//! the dialog asks first.
+
+use std::{
+    collections::{HashMap, HashSet},
+    fs,
+    io::{self, Write},
+    ops::Range,
+    path::{Path, PathBuf},
+    sync::{
+        Arc,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+use cosmic::{
+    Application, Element, action,
+    app::Task,
+    cosmic_theme,
+    iced::{Alignment, Length},
+    style,
+    widget::{self, segmented_button},
+};
+use cosmic_files::dialog::{Dialog, DialogKind, DialogResult, DialogSettings};
+use cosmic_text::{LineEnding, LineIter};
+use regex::Regex;
+
+use crate::{
+    App, Message as AppMessage, find_count,
+    find_results::{self, FileResult, Search, Source},
+    find_text::{Joined, Replacement, whole_endings},
+    find_ui::{self, DialogField},
+    fl,
+    status_bar::thousands,
+    tab::{Tab, editor_text},
+};
+
+/// A file larger than this is not searched
+pub const MAX_FILE_BYTES: u64 = 50 * 1024 * 1024;
+
+/// A NUL byte in this many first bytes marks a file as binary
+const BINARY_SNIFF_BYTES: usize = 8 * 1024;
+
+/// The tabs of the Find dialog
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum DialogTab {
+    /// Find and replace in the active document
+    #[default]
+    Replace,
+    Files,
+}
+
+/// The filters of Find in Files: which file names are searched
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Filters {
+    /// Globs a file name must match one of; empty for every file
+    include: Vec<String>,
+    /// File and folder names (globs) left out
+    exclude: Vec<String>,
+}
+
+impl Filters {
+    /// Notepad++'s filter text: globs separated by spaces or semicolons, `*.*` (or `*`, or
+    /// nothing) for every file, `!glob` to leave out the files and folders it names. Case does
+    /// not matter, as in Notepad++.
+    pub fn parse(text: &str) -> Self {
+        let mut filters = Self::default();
+        let mut every_file = false;
+        for word in text
+            .split(|c: char| c == ';' || c.is_whitespace())
+            .filter(|word| !word.is_empty())
+        {
+            match word.strip_prefix('!') {
+                Some("") => {}
+                Some(exclude) => filters.exclude.push(exclude.to_lowercase()),
+                None if word == "*.*" || word == "*" => every_file = true,
+                None => filters.include.push(word.to_lowercase()),
+            }
+        }
+        if every_file {
+            filters.include.clear();
+        }
+        filters
+    }
+
+    /// Whether a file or folder of this name is left out
+    pub fn excluded(&self, name: &str) -> bool {
+        let name = name.to_lowercase();
+        self.exclude.iter().any(|glob| glob_match(glob, &name))
+    }
+
+    /// Whether a file of this name is searched
+    pub fn wanted(&self, name: &str) -> bool {
+        if self.excluded(name) {
+            return false;
+        }
+        let name = name.to_lowercase();
+        self.include.is_empty() || self.include.iter().any(|glob| glob_match(glob, &name))
+    }
+}
+
+/// Whether `name` matches `glob`, where `*` stands for any run of characters and `?` for one
+fn glob_match(glob: &str, name: &str) -> bool {
+    let glob: Vec<char> = glob.chars().collect();
+    let name: Vec<char> = name.chars().collect();
+    let (mut g, mut n) = (0, 0);
+    // The last `*` seen and the name position it matched up to, to back up to
+    let mut star: Option<(usize, usize)> = None;
+    while n < name.len() {
+        match glob.get(g) {
+            Some('*') => {
+                star = Some((g, n));
+                g += 1;
+            }
+            Some(&c) if c == '?' || c == name[n] => {
+                g += 1;
+                n += 1;
+            }
+            _ => match star {
+                Some((star_g, star_n)) => {
+                    g = star_g + 1;
+                    n = star_n + 1;
+                    star = Some((star_g, star_n + 1));
+                }
+                None => return false,
+            },
+        }
+    }
+    glob[g..].iter().all(|&c| c == '*')
+}
+
+/// Notepad++'s "In all sub-folders" and "In hidden folders"
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct WalkOptions {
+    pub sub_folders: bool,
+    pub hidden: bool,
+}
+
+/// The files under `dir` that the filters and options name, sorted by path. Hidden folders
+/// (a name starting with `.`) are entered only with `hidden`; hidden files are searched, as
+/// Notepad++'s option is about folders. Symbolic links to folders are not followed.
+pub fn walk(dir: &Path, filters: &Filters, options: WalkOptions) -> Vec<PathBuf> {
+    let excluded = filters.clone();
+    let mut builder = ignore::WalkBuilder::new(dir);
+    builder
+        .standard_filters(false)
+        .hidden(false)
+        .follow_links(false)
+        .sort_by_file_name(|a, b| a.cmp(b))
+        .max_depth((!options.sub_folders).then_some(1))
+        .filter_entry(move |entry| {
+            if entry.depth() == 0 || !entry.file_type().is_some_and(|kind| kind.is_dir()) {
+                return true;
+            }
+            let name = entry.file_name().to_string_lossy();
+            (options.hidden || !name.starts_with('.')) && !excluded.excluded(&name)
+        });
+    builder
+        .build()
+        .filter_map(|entry| match entry {
+            Ok(entry) => Some(entry),
+            Err(err) => {
+                log::warn!("find in files: cannot read in {:?}: {}", dir, err);
+                None
+            }
+        })
+        // Regular files only: a symbolic link could reach a file outside the folder, or one
+        // file twice (Replace in Files would then replace in its own replacement)
+        .filter(|entry| entry.depth() > 0 && entry.file_type().is_some_and(|kind| kind.is_file()))
+        .filter(|entry| filters.wanted(&entry.file_name().to_string_lossy()))
+        .map(ignore::DirEntry::into_path)
+        .collect()
+}
+
+/// What reading a file for Find in Files gave
+#[derive(Debug, PartialEq, Eq)]
+pub enum Content {
+    Text(String),
+    /// A NUL byte in its first 8 KB
+    Binary,
+    /// Over [`MAX_FILE_BYTES`]
+    TooLarge,
+    /// Not UTF-8 (only when asked to be strict, for Replace in Files)
+    NotUtf8,
+    Unreadable,
+}
+
+/// Read `path` as text. `strict`: a file that is not UTF-8 is [`Content::NotUtf8`] rather than
+/// read with its invalid bytes replaced (good enough to find in, not to write back).
+pub fn read_text(path: &Path, strict: bool) -> Content {
+    match fs::metadata(path) {
+        Ok(meta) if meta.len() > MAX_FILE_BYTES => return Content::TooLarge,
+        Ok(_) => {}
+        Err(_) => return Content::Unreadable,
+    }
+    let Ok(bytes) = fs::read(path) else {
+        return Content::Unreadable;
+    };
+    if bytes[..bytes.len().min(BINARY_SNIFF_BYTES)].contains(&0) {
+        return Content::Binary;
+    }
+    match String::from_utf8(bytes) {
+        Ok(text) => Content::Text(text),
+        Err(_) if strict => Content::NotUtf8,
+        Err(err) => Content::Text(String::from_utf8_lossy(err.as_bytes()).into_owned()),
+    }
+}
+
+/// The lines of `text` as byte ranges with their endings, as an editor buffer holds them: a
+/// text ending in a line break (or an empty one) has an empty last line
+fn line_ranges(text: &str) -> Vec<(Range<usize>, LineEnding)> {
+    let mut lines: Vec<_> = LineIter::new(text).collect();
+    if lines
+        .last()
+        .is_none_or(|(_, ending)| *ending != LineEnding::None)
+    {
+        lines.push((text.len()..text.len(), LineEnding::None));
+    }
+    lines
+}
+
+/// The matches of `regex` in `text`, scanned as the match count scans a document, up to `cap`
+fn scan_file(
+    text: &str,
+    regex: &Regex,
+    joined: Option<bool>,
+    cap: usize,
+) -> (Vec<Range<usize>>, find_count::Matches) {
+    let ranges = line_ranges(text);
+    let ranges_only: Vec<Range<usize>> = ranges.iter().map(|(range, _)| range.clone()).collect();
+    let matches = find_count::scan_text(
+        ranges
+            .iter()
+            .map(|(range, ending)| (&text[range.clone()], *ending)),
+        regex,
+        joined,
+        cap,
+    );
+    (ranges_only, matches)
+}
+
+/// The search options of one Find in Files run, as the dialog had them when it started
+#[derive(Clone, Debug)]
+pub struct Query {
+    pub text: String,
+    pub regex: Regex,
+    /// As `App::find_joined` gives it
+    pub joined: Option<bool>,
+    pub dir: PathBuf,
+    pub filters: Filters,
+    pub options: WalkOptions,
+}
+
+/// Find All in files: the matches of `query` in the files under its folder, at most
+/// `find_results::HIT_CAP` over all of them. `open` holds the text of files open in tabs with
+/// unsaved changes, by canonical path: those are searched as the tab has them. Stops early,
+/// returning `None`, once `current` no longer holds `id` (a newer search started).
+pub fn search(
+    query: &Query,
+    open: &HashMap<PathBuf, String>,
+    id: u64,
+    current: &AtomicU64,
+) -> Option<Search> {
+    let mut files = Vec::new();
+    let mut searched = 0;
+    let mut hits = 0;
+    let mut capped = false;
+    for path in walk(&query.dir, &query.filters, query.options) {
+        if current.load(Ordering::Relaxed) != id {
+            return None;
+        }
+        let tab_text = (!open.is_empty())
+            .then(|| fs::canonicalize(&path).ok())
+            .flatten()
+            .and_then(|canonical| open.get(&canonical));
+        let read;
+        let text = match tab_text {
+            Some(text) => text.as_str(),
+            None => {
+                read = read_text(&path, false);
+                match &read {
+                    Content::Text(text) => text.as_str(),
+                    _ => continue,
+                }
+            }
+        };
+        searched += 1;
+        let budget = find_results::HIT_CAP - hits;
+        let (ranges, matches) = scan_file(text, &query.regex, query.joined, budget);
+        capped |= matches.capped;
+        if !matches.spans.is_empty() {
+            hits += matches.spans.len();
+            files.push(FileResult {
+                source: Source::Path(path.clone()),
+                name: path.display().to_string(),
+                hits: matches.spans.len(),
+                lines: find_results::result_lines(&matches.spans, |line| {
+                    &text[ranges[line].clone()]
+                }),
+            });
+        }
+        if capped {
+            // Notepad++ goes on; the panel could not list more anyway
+            break;
+        }
+    }
+    Some(Search::new(query.text.clone(), files, searched, capped))
+}
+
+/// `text` with every match of `regex` replaced, as Replace all replaces a document (see
+/// `Tab::replace_all` and `Tab::replace_all_joined`), and how many were replaced. Line breaks
+/// in the replacement are written in the file's first line ending; line endings the query does
+/// not touch stay as they are.
+pub fn replace_text(
+    text: &str,
+    regex: &Regex,
+    joined: Option<bool>,
+    replacement: &Replacement,
+) -> (String, usize) {
+    let lines = line_ranges(text);
+    let ending = lines
+        .iter()
+        .map(|(_, ending)| *ending)
+        .find(|ending| *ending != LineEnding::None)
+        .unwrap_or_default();
+    let edits: Vec<(usize, usize, String)> = match joined {
+        None => lines
+            .iter()
+            .flat_map(|(range, _)| {
+                let line = &text[range.clone()];
+                find_count::replace_matches(regex, line)
+                    .map(|(start, end)| {
+                        let replace = replacement.text_at(regex, line, start, Some(ending));
+                        (range.start + start, range.start + end, replace)
+                    })
+                    .collect::<Vec<_>>()
+            })
+            .collect(),
+        Some(real_endings) => {
+            let joined = Joined::new(
+                lines
+                    .iter()
+                    .map(|(range, ending)| (&text[range.clone()], *ending)),
+                0,
+                real_endings,
+            );
+            let ending = (!real_endings).then_some(ending);
+            let matches = find_count::replace_matches(regex, &joined.text).map(|(start, end)| {
+                let replace = replacement.text_at(regex, &joined.text, start, ending);
+                (start, end, replace)
+            });
+            if real_endings {
+                // The joined text is the file's text
+                whole_endings(text, matches)
+            } else {
+                // Each line break is one `\n` there: back to the file's offsets
+                let offset = |at: usize| {
+                    let cursor = joined.cursor(at);
+                    lines[cursor.line].0.start + cursor.index
+                };
+                matches
+                    .map(|(start, end, replace)| (offset(start), offset(end), replace))
+                    .collect()
+            }
+        }
+    };
+    let mut out = String::with_capacity(text.len());
+    let mut at = 0;
+    for (start, end, replace) in &edits {
+        out.push_str(&text[at..*start]);
+        out.push_str(replace);
+        at = *end;
+    }
+    out.push_str(&text[at..]);
+    (out, edits.len())
+}
+
+/// Write `contents` to the file `path` all or nothing: into a new file beside it (with the
+/// file's permissions from the start), flushed to disk, then renamed over it, and the folder
+/// flushed. `expected` is the text the file held when read: a file that changed since, a
+/// read-only file, one with other hard links, or one owned by another user is left alone
+/// with an error, as a rename would lose that change or that identity.
+pub fn write_atomic(path: &Path, expected: &str, contents: &str) -> io::Result<()> {
+    let target = fs::canonicalize(path)?;
+    let meta = fs::metadata(&target)?;
+    let permissions = meta.permissions();
+    if permissions.readonly() {
+        return Err(io::Error::other("read-only"));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if meta.nlink() > 1 {
+            return Err(io::Error::other("has other hard links"));
+        }
+    }
+    let Some(dir) = target.parent() else {
+        return Err(io::Error::other("no folder"));
+    };
+    let mut temp = None;
+    for n in 0..100u32 {
+        // Short: a long file name plus a suffix could pass the name length limit
+        let candidate = dir.join(format!(".fif-{}-{n}.tmp", std::process::id()));
+        let mut options = fs::OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+            // Never readable by more users than the file, not even for a moment
+            options.mode(permissions.mode() & 0o777);
+        }
+        match options.open(&candidate) {
+            Ok(file) => {
+                temp = Some((candidate, file));
+                break;
+            }
+            Err(err) if err.kind() == io::ErrorKind::AlreadyExists => continue,
+            Err(err) => return Err(err),
+        }
+    }
+    let Some((temp_path, mut file)) = temp else {
+        return Err(io::Error::other("no free temporary file name"));
+    };
+    let result = (|| {
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            // The new file is ours: renaming it over another user's file would take it over
+            if file.metadata()?.uid() != meta.uid() {
+                return Err(io::Error::other("owned by another user"));
+            }
+        }
+        file.write_all(contents.as_bytes())?;
+        file.sync_all()?;
+        fs::set_permissions(&temp_path, permissions)?;
+        // As late as can be: another program's change since the read is not overwritten
+        if fs::read(&target)? != expected.as_bytes() {
+            return Err(io::Error::other("changed while replacing"));
+        }
+        fs::rename(&temp_path, &target)?;
+        if let Ok(dir) = fs::File::open(dir) {
+            let _ = dir.sync_all();
+        }
+        Ok(())
+    })();
+    if result.is_err() {
+        let _ = fs::remove_file(&temp_path);
+    }
+    result
+}
+
+/// What Replace in Files did on disk
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct ReplaceOutcome {
+    pub occurrences: usize,
+    pub files: usize,
+    /// Files left alone because they are not UTF-8
+    pub not_utf8: usize,
+    /// Files that could not be written, with why
+    pub failed: Vec<(PathBuf, String)>,
+    /// Files open in tabs with unsaved changes (`in_tabs` of [`replace_in_files`]): the caller
+    /// replaces them in their tab
+    pub in_tabs: Vec<PathBuf>,
+}
+
+/// Replace in Files on disk: every match of `query` in the files under its folder, each file
+/// written with [`write_atomic`]. Files whose canonical path is in `in_tabs` are not touched;
+/// those with matches are listed in the outcome. `None` once `current` no longer holds `id`.
+pub fn replace_in_files(
+    query: &Query,
+    replacement: &Replacement,
+    in_tabs: &HashSet<PathBuf>,
+    id: u64,
+    current: &AtomicU64,
+) -> Option<ReplaceOutcome> {
+    let mut outcome = ReplaceOutcome::default();
+    // A file reached twice (through a symbolic link) is replaced once: a second pass would
+    // replace in the replacement
+    let mut seen = HashSet::new();
+    for path in walk(&query.dir, &query.filters, query.options) {
+        if current.load(Ordering::Relaxed) != id {
+            return None;
+        }
+        let canonical = fs::canonicalize(&path).unwrap_or_else(|_| path.clone());
+        if !seen.insert(canonical.clone()) {
+            continue;
+        }
+        // Its tab replaces it, in the text the tab has (which may match where the disk does
+        // not); a tab without a match replaces nothing
+        if in_tabs.contains(&canonical) {
+            outcome.in_tabs.push(canonical);
+            continue;
+        }
+        let text = match read_text(&path, true) {
+            Content::Text(text) => text,
+            Content::NotUtf8 => {
+                outcome.not_utf8 += 1;
+                continue;
+            }
+            _ => continue,
+        };
+        let (replaced, count) = replace_text(&text, &query.regex, query.joined, replacement);
+        if count == 0 {
+            continue;
+        }
+        match write_atomic(&path, &text, &replaced) {
+            Ok(()) => {
+                outcome.occurrences += count;
+                outcome.files += 1;
+            }
+            Err(err) => {
+                log::warn!("replace in files: left {:?} as it was: {}", path, err);
+                outcome.failed.push((path, err.to_string()));
+            }
+        }
+    }
+    Some(outcome)
+}
+
+/// The Find in Files tab's state, kept while the app runs
+pub struct State {
+    tabs: segmented_button::SingleSelectModel,
+    filters: String,
+    directory: String,
+    follow_doc: bool,
+    sub_folders: bool,
+    hidden: bool,
+    /// Replace in Files waits for its confirmation
+    confirm: bool,
+    /// The id of the newest search or replace; an older one stops when it changes
+    current: Arc<AtomicU64>,
+    /// A replace waiting for its disk part: its id and what replaces in the tabs after it
+    pending_replace: Option<(u64, Query, Replacement)>,
+    status: Option<String>,
+}
+
+impl Default for State {
+    fn default() -> Self {
+        let tabs = segmented_button::Model::builder()
+            .insert(|b| {
+                b.text(fl!("find-tab-replace"))
+                    .data(DialogTab::Replace)
+                    .activate()
+            })
+            .insert(|b| b.text(fl!("find-tab-files")).data(DialogTab::Files))
+            .build();
+        Self {
+            tabs,
+            filters: "*.*".to_string(),
+            directory: String::new(),
+            follow_doc: false,
+            sub_folders: true,
+            hidden: false,
+            confirm: false,
+            current: Arc::default(),
+            pending_replace: None,
+            status: None,
+        }
+    }
+}
+
+impl std::fmt::Debug for State {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("State")
+            .field("tab", &self.tab())
+            .field("filters", &self.filters)
+            .field("directory", &self.directory)
+            .field("follow_doc", &self.follow_doc)
+            .field("confirm", &self.confirm)
+            .field("status", &self.status)
+            .finish_non_exhaustive()
+    }
+}
+
+impl State {
+    pub fn tab(&self) -> DialogTab {
+        self.tabs
+            .active_data::<DialogTab>()
+            .copied()
+            .unwrap_or_default()
+    }
+
+    pub fn set_tab(&mut self, tab: DialogTab) {
+        let entity = self
+            .tabs
+            .iter()
+            .find(|entity| self.tabs.data::<DialogTab>(*entity) == Some(&tab));
+        if let Some(entity) = entity {
+            self.tabs.activate(entity);
+        }
+    }
+
+    pub fn tabs(&self) -> &segmented_button::SingleSelectModel {
+        &self.tabs
+    }
+
+    /// A new search or replace starts: an older one stops, and its result is dropped
+    fn next_id(&self) -> u64 {
+        self.current.fetch_add(1, Ordering::Relaxed) + 1
+    }
+
+    fn is_current(&self, id: u64) -> bool {
+        self.current.load(Ordering::Relaxed) == id
+    }
+}
+
+/// The Find in Files tab's controls
+#[derive(Clone, Debug)]
+pub enum Message {
+    /// Ctrl+Shift+F: the Find dialog on this tab
+    Open,
+    Tab(segmented_button::Entity),
+    Filters(String),
+    Directory(String),
+    /// The "…" button: pick the folder
+    Browse,
+    Browsed(DialogResult),
+    FollowDoc(bool),
+    SubFolders(bool),
+    Hidden(bool),
+    FindAll,
+    /// "Replace in Files": asks first
+    Replace,
+    /// The answer to "Are you sure…"
+    Confirm(bool),
+    Found(u64, Option<Arc<Search>>),
+    Replaced(u64, Option<Arc<ReplaceOutcome>>),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::FindFiles(message)
+    }
+}
+
+impl App {
+    pub(crate) fn update_find_files(&mut self, message: Message) -> Task<AppMessage> {
+        let state = &mut self.find_dialog.files;
+        match message {
+            Message::Open => {
+                let task = self.update(AppMessage::Find(Some(true)));
+                self.find_dialog.files.set_tab(DialogTab::Files);
+                return task;
+            }
+            Message::Tab(entity) => {
+                state.tabs.activate(entity);
+                state.confirm = false;
+            }
+            Message::Filters(text) => state.filters = text,
+            Message::Directory(text) => {
+                state.directory = text;
+                state.follow_doc = false;
+            }
+            Message::Browse => {
+                if self.dialog_opt.is_none() {
+                    let (dialog, task) = Dialog::new(
+                        DialogSettings::new().kind(DialogKind::OpenFolder),
+                        AppMessage::DialogMessage,
+                        |result| Message::Browsed(result).into(),
+                    );
+                    self.dialog_opt = Some(dialog);
+                    return task;
+                }
+            }
+            Message::Browsed(result) => {
+                self.dialog_opt = None;
+                if let DialogResult::Open(paths) = result
+                    && let Some(path) = paths.into_iter().next()
+                {
+                    let state = &mut self.find_dialog.files;
+                    state.directory = path.display().to_string();
+                    state.follow_doc = false;
+                }
+            }
+            Message::FollowDoc(on) => {
+                // Unticked, the folder it showed stays
+                if !on && let Some(dir) = self.find_files_dir() {
+                    self.find_dialog.files.directory = dir.display().to_string();
+                }
+                self.find_dialog.files.follow_doc = on;
+            }
+            Message::SubFolders(on) => state.sub_folders = on,
+            Message::Hidden(on) => state.hidden = on,
+            // A replace that has begun writing runs to its end: stopping it would leave some
+            // files replaced and not say which
+            Message::FindAll | Message::Replace | Message::Confirm(true)
+                if self.find_dialog.files.pending_replace.is_some() => {}
+            Message::FindAll => return self.find_files_all(),
+            Message::Replace => {
+                if self.find_files_query().is_some() {
+                    self.find_dialog.files.confirm = true;
+                }
+            }
+            Message::Confirm(yes) => {
+                self.find_dialog.files.confirm = false;
+                if yes {
+                    return self.find_files_replace();
+                }
+            }
+            Message::Found(id, search) => {
+                if !self.find_dialog.files.is_current(id) {
+                    return Task::none();
+                }
+                let Some(search) = search else {
+                    self.find_dialog.files.status = None;
+                    return Task::none();
+                };
+                let search = Arc::unwrap_or_clone(search);
+                self.find_dialog.files.status = Some(search.header());
+                self.find_results.push(search);
+            }
+            Message::Replaced(id, outcome) => {
+                let state = &mut self.find_dialog.files;
+                if !state.is_current(id) {
+                    return Task::none();
+                }
+                let Some((_, query, replacement)) = state.pending_replace.take() else {
+                    return Task::none();
+                };
+                let Some(outcome) = outcome else {
+                    state.status = None;
+                    return Task::none();
+                };
+                return self.find_files_replaced(&outcome, &query, &replacement);
+            }
+        }
+        Task::none()
+    }
+
+    /// The folder Find in Files searches: the active document's with "Follow current doc.",
+    /// else the one typed or picked
+    pub(crate) fn find_files_dir(&self) -> Option<PathBuf> {
+        let state = &self.find_dialog.files;
+        if state.follow_doc {
+            if let Some(Tab::Editor(tab)) = self.active_tab()
+                && let Some(dir) = tab.path_opt.as_deref().and_then(Path::parent)
+            {
+                return Some(dir.to_path_buf());
+            }
+        }
+        let dir = state.directory.trim();
+        (!dir.is_empty()).then(|| PathBuf::from(dir))
+    }
+
+    /// The query of a Find in Files run as the dialog has it; `None` (with the status line
+    /// saying why) without a query, with one that does not compile or without a folder
+    fn find_files_query(&mut self) -> Option<Query> {
+        // An earlier result would hide why nothing runs
+        self.find_dialog.files.status = None;
+        if self.find_search_value.is_empty() {
+            return None;
+        }
+        let regex = match self.config.find_regex(&self.find_search_value) {
+            Ok(regex) => regex,
+            // The status line says why
+            Err(_) => return None,
+        };
+        let dir = match self.find_files_dir() {
+            Some(dir) if dir.is_dir() => dir,
+            _ => {
+                self.find_dialog.files.status = Some(fl!("find-files-no-folder"));
+                return None;
+            }
+        };
+        let state = &self.find_dialog.files;
+        Some(Query {
+            text: self.find_search_value.clone(),
+            regex,
+            joined: self.find_joined(),
+            dir,
+            filters: Filters::parse(&state.filters),
+            options: WalkOptions {
+                sub_folders: state.sub_folders,
+                hidden: state.hidden,
+            },
+        })
+    }
+
+    /// The open tabs with unsaved changes, by canonical path, and their text when `text`
+    fn find_files_dirty_tabs(&self, text: bool) -> HashMap<PathBuf, String> {
+        self.tab_model
+            .iter()
+            .filter_map(|entity| match self.tab_model.data::<Tab>(entity) {
+                Some(Tab::Editor(tab)) if tab.changed() => {
+                    let path = fs::canonicalize(tab.path_opt.as_ref()?).ok()?;
+                    let text = if text {
+                        editor_text(&tab.editor.lock().unwrap())
+                    } else {
+                        String::new()
+                    };
+                    Some((path, text))
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    /// Find All in the folder, in a blocking task; the result goes to the Search results panel
+    fn find_files_all(&mut self) -> Task<AppMessage> {
+        let Some(query) = self.find_files_query() else {
+            return Task::none();
+        };
+        let open = self.find_files_dirty_tabs(true);
+        let state = &mut self.find_dialog.files;
+        let id = state.next_id();
+        let current = state.current.clone();
+        state.status = Some(fl!("find-files-searching"));
+        Task::perform(
+            tokio::task::spawn_blocking(move || search(&query, &open, id, &current)),
+            move |res| match res {
+                Ok(search) => action::app(Message::Found(id, search.map(Arc::new)).into()),
+                Err(err) => {
+                    log::warn!("find in files: search failed: {}", err);
+                    action::app(Message::Found(id, None).into())
+                }
+            },
+        )
+    }
+
+    /// Replace in Files, once confirmed: the disk files in a blocking task, then the open tabs
+    /// with unsaved changes in their tab (see [`App::find_files_replaced`])
+    fn find_files_replace(&mut self) -> Task<AppMessage> {
+        let Some(query) = self.find_files_query() else {
+            return Task::none();
+        };
+        let replacement = self.find_replacement();
+        let in_tabs: HashSet<PathBuf> = self.find_files_dirty_tabs(false).into_keys().collect();
+        let state = &mut self.find_dialog.files;
+        let id = state.next_id();
+        let current = state.current.clone();
+        state.pending_replace = Some((id, query.clone(), replacement.clone()));
+        state.status = Some(fl!("find-files-replacing"));
+        Task::perform(
+            tokio::task::spawn_blocking(move || {
+                replace_in_files(&query, &replacement, &in_tabs, id, &current)
+            }),
+            move |res| match res {
+                Ok(outcome) => action::app(Message::Replaced(id, outcome.map(Arc::new)).into()),
+                Err(err) => {
+                    log::warn!("replace in files: failed: {}", err);
+                    action::app(Message::Replaced(id, None).into())
+                }
+            },
+        )
+    }
+
+    /// The disk part of Replace in Files is done: replace in the tabs it left out, and say
+    /// what was replaced
+    fn find_files_replaced(
+        &mut self,
+        outcome: &ReplaceOutcome,
+        query: &Query,
+        replacement: &Replacement,
+    ) -> Task<AppMessage> {
+        let mut occurrences = outcome.occurrences;
+        let mut files = outcome.files;
+        let mut changed = Vec::new();
+        for path in &outcome.in_tabs {
+            let entity = self.tab_model.iter().find(|entity| {
+                matches!(
+                    self.tab_model.data::<Tab>(*entity),
+                    Some(Tab::Editor(tab)) if tab.path_opt.as_deref().and_then(|p| fs::canonicalize(p).ok()).as_ref() == Some(path)
+                )
+            });
+            let Some(entity) = entity else {
+                continue;
+            };
+            let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(entity) else {
+                continue;
+            };
+            let (count, _) = match query.joined {
+                Some(real_endings) => {
+                    tab.replace_all_joined(&query.regex, real_endings, replacement, None)
+                }
+                None => tab.replace_all(&query.regex, replacement, None),
+            };
+            if count > 0 {
+                occurrences += count;
+                files += 1;
+                changed.push(entity);
+            }
+        }
+        let mut status = fl!(
+            "find-files-replaced",
+            count = occurrences,
+            text = thousands(occurrences),
+            files = files
+        );
+        if outcome.not_utf8 > 0 {
+            status.push_str(&format!(
+                "; {}",
+                fl!("find-files-not-utf8", count = outcome.not_utf8)
+            ));
+        }
+        if !outcome.failed.is_empty() {
+            status.push_str(&format!(
+                "; {}",
+                fl!("find-files-failed", count = outcome.failed.len())
+            ));
+        }
+        self.find_dialog.files.status = Some(status);
+        Task::batch(
+            changed
+                .into_iter()
+                .map(|entity| self.update(AppMessage::TabChanged(entity))),
+        )
+    }
+
+    /// The dialog's status line on the Find in Files tab
+    pub(crate) fn find_files_status(&self) -> Option<String> {
+        self.find_dialog.files.status.clone()
+    }
+
+    /// The Find in Files tab, laid out as Notepad++'s: the fields with the folder and its
+    /// "…" button, the options and the search mode below, the buttons beside them. While
+    /// Replace in Files waits for its answer, the question instead.
+    pub(crate) fn find_files_view(&self) -> Element<'_, AppMessage> {
+        let cosmic_theme::Spacing {
+            space_xxs, space_s, ..
+        } = self.core().system_theme().cosmic().spacing;
+        let state = &self.find_dialog.files;
+        if state.confirm {
+            let dir = self
+                .find_files_dir()
+                .map(|dir| dir.display().to_string())
+                .unwrap_or_default();
+            return widget::column::with_children(vec![
+                widget::text::body(fl!("find-files-confirm", dir = dir.as_str())).into(),
+                widget::text::body(fl!("find-files-confirm-undo")).into(),
+                widget::row::with_children(vec![
+                    widget::space::horizontal().into(),
+                    widget::button::standard(fl!("cancel"))
+                        .on_press(Message::Confirm(false).into())
+                        .into(),
+                    widget::button::destructive(fl!("find-files-replace"))
+                        .on_press(Message::Confirm(true).into())
+                        .into(),
+                ])
+                .spacing(space_xxs)
+                .into(),
+            ])
+            .spacing(space_s)
+            .height(Length::Fill)
+            .into();
+        }
+
+        fn row<'a>(label: String, field: Element<'a, AppMessage>) -> Element<'a, AppMessage> {
+            widget::row::with_children(vec![find_ui::dialog_label(label), field])
+                .align_y(Alignment::Center)
+                .into()
+        }
+        let follow_dir = self
+            .find_files_dir()
+            .map(|dir| dir.display().to_string())
+            .unwrap_or_default();
+        let directory = if state.follow_doc {
+            follow_dir
+        } else {
+            state.directory.clone()
+        };
+        let fields = widget::column::with_children(vec![
+            row(fl!("find-what"), self.find_what_input(DialogField::Find)),
+            row(
+                fl!("replace-with"),
+                self.find_what_input(DialogField::Replace),
+            ),
+            row(
+                fl!("find-files-filters"),
+                widget::text_input::text_input("*.*", state.filters.clone())
+                    .on_input(|text| Message::Filters(text).into())
+                    .on_submit(|_| Message::FindAll.into())
+                    .width(Length::Fill)
+                    .into(),
+            ),
+            row(
+                fl!("find-files-directory"),
+                widget::row::with_children(vec![
+                    widget::text_input::text_input("", directory)
+                        .on_input(|text| Message::Directory(text).into())
+                        .on_submit(|_| Message::FindAll.into())
+                        .width(Length::Fill)
+                        .into(),
+                    widget::button::standard("…")
+                        .on_press(Message::Browse.into())
+                        .into(),
+                ])
+                .spacing(space_xxs)
+                .align_y(Alignment::Center)
+                .into(),
+            ),
+        ])
+        .spacing(space_xxs);
+
+        let checkbox = |on: bool, text: String, toggle: fn(bool) -> AppMessage| {
+            widget::checkbox(on).label(text).on_toggle(toggle).into()
+        };
+        let options = widget::column::with_children(vec![
+            checkbox(
+                self.config.find_whole_word,
+                fl!("match-whole-word-only"),
+                AppMessage::FindWholeWord,
+            ),
+            checkbox(
+                self.config.find_case_sensitive,
+                fl!("match-case"),
+                AppMessage::FindCaseSensitive,
+            ),
+            checkbox(state.sub_folders, fl!("find-files-sub-folders"), |on| {
+                Message::SubFolders(on).into()
+            }),
+            checkbox(state.hidden, fl!("find-files-hidden"), |on| {
+                Message::Hidden(on).into()
+            }),
+            checkbox(state.follow_doc, fl!("find-files-follow-doc"), |on| {
+                Message::FollowDoc(on).into()
+            }),
+        ])
+        .spacing(space_xxs)
+        .width(Length::Fill);
+
+        let buttons = widget::column::with_children(vec![
+            find_ui::dialog_button(
+                fl!("find-all"),
+                style::Button::Suggested,
+                Message::FindAll.into(),
+                space_xxs,
+                space_s,
+            ),
+            find_ui::dialog_button(
+                fl!("find-files-replace"),
+                style::Button::Standard,
+                Message::Replace.into(),
+                space_xxs,
+                space_s,
+            ),
+            find_ui::dialog_button(
+                fl!("find-close"),
+                style::Button::Standard,
+                AppMessage::Find(None),
+                space_xxs,
+                space_s,
+            ),
+        ])
+        .spacing(space_xxs)
+        .width(Length::Fixed(find_ui::FIND_BUTTON_WIDTH));
+
+        let left = widget::column::with_children(vec![
+            fields.into(),
+            widget::row::with_children(vec![options.into(), self.find_mode_view()])
+                .spacing(space_s)
+                .into(),
+        ])
+        .spacing(space_s)
+        .width(Length::Fill);
+        widget::row::with_children(vec![left.into(), buttons.into()])
+            .spacing(space_s)
+            .height(Length::Fill)
+            .into()
+    }
+}
+
+/// The message the "Find what" field's Enter sends on the Find in Files tab: Find All
+pub(crate) fn submit_message(field: DialogField) -> AppMessage {
+    match field {
+        DialogField::Find => Message::FindAll.into(),
+        DialogField::Replace => Message::Replace.into(),
+    }
+}

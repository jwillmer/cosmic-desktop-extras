new file mode 100644
index 0000000..e9703c2
--- /dev/null
+++ b/src/find_results.rs
@@ -0,0 +1,790 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Find All and its "Search results" panel, as in Notepad++: the Find dialog's "Find All in
+//! Current Document" and "Find All in All Opened Documents" list every match in a panel docked
+//! under the editor views, newest search on top, with a header per search, a row per file and
+//! one per line with its matches highlighted. A click on a line goes to its first match.
+//!
+//! The matches come from the same scan as the dialog's match count (`find_count::scan_text`),
+//! so Find All finds exactly what the count counts. The results are a snapshot: edits do not
+//! update them, and a click on a place that no longer exists lands on the nearest one.
+//!
+//! A result's file is an open tab or, for a search of files that are not open, a path
+//! ([`Source`]): the panel only shows what [`Search`] holds.
+
+use std::path::PathBuf;
+
+use cosmic::{
+    Application, Element,
+    app::Task,
+    cosmic_theme,
+    font::Font,
+    iced::{self, Alignment, Length},
+    style,
+    widget::{self, button, segmented_button::Entity},
+};
+use cosmic_text::{Cursor, Edit, Selection};
+
+use crate::{
+    App, Color, Message as AppMessage, find_count, find_range, fl, folding, goto_line,
+    icon_cache_get, markdown, status_bar::thousands, tab::Tab,
+};
+
+/// The panel keeps this many searches; an older one drops off the end
+pub const MAX_SEARCHES: usize = 10;
+
+/// One search stops listing matches here, over all its files: its header says so
+pub const HIT_CAP: usize = find_count::MATCH_CAP;
+
+/// A line longer than this many characters is cut around its first match
+const EXCERPT_CHARS: usize = 160;
+/// How many characters before the first match a cut line keeps
+const EXCERPT_BEFORE: usize = 40;
+
+/// The height of the panel's list
+const PANEL_HEIGHT: f32 = 200.0;
+
+/// Where a result's file is
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Source {
+    /// An open tab
+    Tab(Entity),
+    /// A file searched on disk (Find in Files): a click opens it, or its tab if open
+    Path(PathBuf),
+}
+
+/// One line with matches: its number, its text (cut around the first match when long) with the
+/// matched parts as byte ranges of that text, and the first match, where a click goes
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ResultLine {
+    pub line: usize,
+    pub text: String,
+    pub marks: Vec<(usize, usize)>,
+    pub target: find_count::Span,
+}
+
+/// The matches of one file: its name as listed (path, or tab title for an untitled tab)
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FileResult {
+    pub source: Source,
+    pub name: String,
+    pub hits: usize,
+    pub lines: Vec<ResultLine>,
+}
+
+/// One Find All: the query, the files with matches, how many files were searched, and
+/// whether matches past [`HIT_CAP`] were left out
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Search {
+    pub query: String,
+    pub files: Vec<FileResult>,
+    pub searched: usize,
+    pub capped: bool,
+    folded: bool,
+}
+
+impl Search {
+    pub fn new(query: String, files: Vec<FileResult>, searched: usize, capped: bool) -> Self {
+        Self {
+            query,
+            files,
+            searched,
+            capped,
+            folded: false,
+        }
+    }
+
+    pub fn hits(&self) -> usize {
+        self.files.iter().map(|file| file.hits).sum()
+    }
+
+    /// `Search "foo" (3 hits in 2 files of 5 searched)`, as in Notepad++, and that only the
+    /// first matches are listed when capped
+    pub fn header(&self) -> String {
+        let hits = self.hits();
+        let mut hits_text = thousands(hits);
+        if self.capped {
+            hits_text.push('+');
+        }
+        let header = fl!(
+            "find-results-header",
+            query = self.query.as_str(),
+            hits = fl!("find-results-hits", count = hits, text = hits_text),
+            files = fl!(
+                "find-results-files",
+                count = self.files.len(),
+                text = thousands(self.files.len())
+            ),
+            searched = thousands(self.searched)
+        );
+        if self.capped {
+            format!(
+                "{header} – {}",
+                fl!("find-results-capped", cap = thousands(HIT_CAP))
+            )
+        } else {
+            header
+        }
+    }
+}
+
+/// The Search results panel: shown while `open`, its searches newest first
+#[derive(Debug, Default)]
+pub struct Panel {
+    pub open: bool,
+    searches: Vec<Search>,
+    /// Moves on every change of `searches`, for the panel's view to build its list again
+    generation: u64,
+}
+
+impl Panel {
+    /// Put a new search on top, open and unfolded; the earlier ones fold, and only the newest
+    /// [`MAX_SEARCHES`] stay
+    pub fn push(&mut self, search: Search) {
+        for earlier in &mut self.searches {
+            earlier.folded = true;
+        }
+        self.searches.insert(0, search);
+        self.searches.truncate(MAX_SEARCHES);
+        self.open = true;
+        self.generation = self.generation.wrapping_add(1);
+    }
+
+    pub fn searches(&self) -> &[Search] {
+        &self.searches
+    }
+
+    /// The line a click on (search, file, line) goes to
+    fn line(&self, at: (usize, usize, usize)) -> Option<(&Source, &ResultLine)> {
+        let file = self.searches.get(at.0)?.files.get(at.1)?;
+        Some((&file.source, file.lines.get(at.2)?))
+    }
+}
+
+/// The panel's controls
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Message {
+    /// Fold or unfold the search at this index
+    Toggle(usize),
+    /// Go to this line of a result: (search, file, line)
+    Open(usize, usize, usize),
+    /// The × button
+    Close,
+    /// F7: show or hide the panel, as in Notepad++; shown again, it has its last results
+    TogglePanel,
+    /// Select this match in this tab, once a click on a `Source::Path` result opened it
+    Select(Entity, find_count::Span),
+}
+
+/// What a click on a result does with its file
+#[derive(Debug, PartialEq, Eq)]
+pub enum ClickTarget {
+    /// Go to the match in this tab
+    Tab(Entity),
+    /// Open this file (its tab, if open) and then go to the match
+    Open(PathBuf),
+    /// Nothing: the tab is closed
+    None,
+}
+
+/// Where a click on a result from `source` goes. `is_editor`: whether an entity is still an
+/// open editor tab.
+pub fn click_target(source: &Source, is_editor: impl Fn(Entity) -> bool) -> ClickTarget {
+    match source {
+        Source::Tab(entity) if is_editor(*entity) => ClickTarget::Tab(*entity),
+        Source::Tab(_) => ClickTarget::None,
+        Source::Path(path) => ClickTarget::Open(path.clone()),
+    }
+}
+
+/// The result lines of `spans` (in order, as a scan gives them), one per line: a match that
+/// spans lines is listed at its start line, marked to that line's end. `text` gives a line's
+/// text.
+pub fn result_lines<'t>(
+    spans: &[find_count::Span],
+    text: impl Fn(usize) -> &'t str,
+) -> Vec<ResultLine> {
+    let mut lines: Vec<ResultLine> = Vec::new();
+    for span in spans {
+        let line_text = text(span.line);
+        let end = if span.end_line == span.line {
+            span.end
+        } else {
+            line_text.len()
+        };
+        match lines.last_mut() {
+            Some(last) if last.line == span.line => last.marks.push((span.start, end)),
+            _ => lines.push(ResultLine {
+                line: span.line,
+                text: line_text.to_string(),
+                marks: vec![(span.start, end)],
+                target: *span,
+            }),
+        }
+    }
+    for line in &mut lines {
+        let (text, marks) = excerpt(&line.text, &line.marks);
+        line.text = text;
+        line.marks = marks;
+    }
+    lines
+}
+
+/// `text` cut to [`EXCERPT_CHARS`] characters around its first mark, with `…` where cut, and
+/// the marks moved to match; a short line stays as it is
+fn excerpt(text: &str, marks: &[(usize, usize)]) -> (String, Vec<(usize, usize)>) {
+    if text.chars().count() <= EXCERPT_CHARS {
+        return (text.to_string(), marks.to_vec());
+    }
+    let first = marks.first().map_or(0, |mark| mark.0);
+    let before: Vec<usize> = text[..first].char_indices().map(|(i, _)| i).collect();
+    let start = before
+        .len()
+        .checked_sub(EXCERPT_BEFORE)
+        .map_or(0, |i| before[i]);
+    let end = text[start..]
+        .char_indices()
+        .nth(EXCERPT_CHARS)
+        .map_or(text.len(), |(i, _)| start + i);
+    let prefix = if start > 0 { "…" } else { "" };
+    let suffix = if end < text.len() { "…" } else { "" };
+    let shift = |i: usize| i.clamp(start, end) - start + prefix.len();
+    let marks = marks
+        .iter()
+        .map(|&(from, to)| (shift(from), shift(to)))
+        .filter(|(from, to)| from < to)
+        .collect();
+    (format!("{prefix}{}{suffix}", &text[start..end]), marks)
+}
+
+/// Where a click on a result selects, for a document that may have changed since: the match's
+/// start and end, each clamped to the last line and that line's end, on a character boundary
+pub fn clamp_target<'t>(
+    span: find_count::Span,
+    line_count: usize,
+    text: impl Fn(usize) -> &'t str,
+) -> (Cursor, Cursor) {
+    let clamp = |line: usize, index: usize| {
+        let line = line.min(line_count.saturating_sub(1));
+        let text = text(line);
+        let mut index = index.min(text.len());
+        while !text.is_char_boundary(index) {
+            index -= 1;
+        }
+        Cursor::new(line, index)
+    };
+    let start = clamp(span.line, span.start);
+    (start, clamp(span.end_line, span.end).max(start))
+}
+
+impl App {
+    /// Find All in the active tab (`opened` false; within its selection with "In selection"),
+    /// or in every open tab, into the Search results panel. A clone in the other view is the
+    /// same document: it is searched once, as in Notepad++.
+    pub(crate) fn find_all(&mut self, opened: bool) -> Task<AppMessage> {
+        let Some(Ok(regex)) = self.find_regex.clone() else {
+            // No query, or the status line says why it does not compile
+            return Task::none();
+        };
+        let joined = self.find_joined();
+        let range = if opened { None } else { self.find_range() };
+        let tabs: Vec<Entity> = if opened {
+            self.tab_model.iter().collect()
+        } else {
+            vec![self.tab_model.active()]
+        };
+        let mut searched_tabs: Vec<Entity> = Vec::new();
+        let mut files = Vec::new();
+        let mut capped = false;
+        for entity in tabs {
+            let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(entity) else {
+                continue;
+            };
+            let searched_clone = || {
+                self.clone_group(entity)
+                    .into_iter()
+                    .any(|clone| searched_tabs.contains(&clone) && self.same_text(entity, clone))
+            };
+            if opened && searched_clone() {
+                continue;
+            }
+            searched_tabs.push(entity);
+            let budget = HIT_CAP
+                - files
+                    .iter()
+                    .map(|file: &FileResult| file.hits)
+                    .sum::<usize>();
+            let editor = tab.editor.lock().unwrap();
+            let (hits, lines) = editor.with_buffer(|buffer| {
+                if budget == 0 {
+                    // The cap is reached: only whether this file has more, without a joined
+                    // copy of it (a match over lines that no line holds alone is missed here)
+                    capped |= buffer.lines.iter().any(|line| regex.is_match(line.text()));
+                    return (0, Vec::new());
+                }
+                // "In selection": only its lines are scanned, so matches before it do not use
+                // up the cap
+                let (first, last) =
+                    range.map_or((0, buffer.lines.len()), |(start, end)| (start.0, end.0 + 1));
+                let last = last.min(buffer.lines.len());
+                let mut matches = find_count::scan_text(
+                    buffer.lines[first.min(last)..last]
+                        .iter()
+                        .map(|line| (line.text(), line.ending())),
+                    &regex,
+                    joined,
+                    budget,
+                );
+                for span in &mut matches.spans {
+                    span.line += first;
+                    span.end_line += first;
+                }
+                if let Some(range) = range {
+                    matches = find_range::clip(&matches, range);
+                }
+                capped |= matches.capped;
+                let lines = result_lines(&matches.spans, |line| buffer.lines[line].text());
+                (matches.spans.len(), lines)
+            });
+            if hits > 0 {
+                let name = tab
+                    .path_opt
+                    .as_ref()
+                    .map_or_else(|| tab.title(), |path| path.display().to_string());
+                files.push(FileResult {
+                    source: Source::Tab(entity),
+                    name,
+                    hits,
+                    lines,
+                });
+            }
+        }
+        // No document to search (a diff tab is active): the earlier results stay as they are
+        if searched_tabs.is_empty() {
+            return Task::none();
+        }
+        self.find_results.push(Search::new(
+            self.find_search_value.clone(),
+            files,
+            searched_tabs.len(),
+            capped,
+        ));
+        Task::none()
+    }
+
+    pub(crate) fn update_find_results(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Toggle(index) => {
+                if let Some(search) = self.find_results.searches.get_mut(index) {
+                    search.folded = !search.folded;
+                    self.find_results.generation = self.find_results.generation.wrapping_add(1);
+                }
+                Task::none()
+            }
+            Message::Close => {
+                self.find_results.open = false;
+                Task::none()
+            }
+            Message::TogglePanel => {
+                self.find_results.open = !self.find_results.open;
+                Task::none()
+            }
+            Message::Open(search, file, line) => self.find_result_open((search, file, line)),
+            Message::Select(entity, target) => self.find_result_select(entity, target),
+        }
+    }
+
+    /// Go to the result's first match: in its tab, or in its file, opened (or its tab
+    /// activated) first. A closed tab does nothing.
+    fn find_result_open(&mut self, at: (usize, usize, usize)) -> Task<AppMessage> {
+        let Some((source, line)) = self.find_results.line(at) else {
+            return Task::none();
+        };
+        let target = line.target;
+        let is_editor = |entity| matches!(self.tab_model.data::<Tab>(entity), Some(Tab::Editor(_)));
+        match click_target(source, is_editor) {
+            ClickTarget::Tab(entity) => self.find_result_select(entity, target),
+            ClickTarget::Open(path) => {
+                // Gone since the search: an empty tab for it would only mislead
+                if !path.is_file() {
+                    log::warn!("search result {:?} is no longer a file", path);
+                    return Task::none();
+                }
+                let Some(entity) = self.open_tab(Some(path)) else {
+                    return Task::none();
+                };
+                // As upstream's project search does: the new tab takes its cursor once
+                // `update_tab` has run
+                Task::batch([
+                    self.update_tab(),
+                    Task::done(cosmic::action::app(AppMessage::FindResults(
+                        Message::Select(entity, target),
+                    ))),
+                ])
+            }
+            ClickTarget::None => Task::none(),
+        }
+    }
+
+    /// Activate `entity` (in its view), select `target` in it and scroll to it
+    fn find_result_select(&mut self, entity: Entity, target: find_count::Span) -> Task<AppMessage> {
+        if !matches!(self.tab_model.data::<Tab>(entity), Some(Tab::Editor(_))) {
+            return Task::none();
+        }
+        let mut tasks = vec![self.update(AppMessage::TabActivate(entity))];
+        // The Preview view hides the cursor: show the source beside it, as "Go to line" does
+        let switch = goto_line::view_for_jump(self.active_markdown_view());
+        if let Some(mode) = switch {
+            tasks.push(self.update_markdown(markdown::Message::SetView(mode)));
+        }
+        if let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(entity) {
+            let mut editor = tab.editor.lock().unwrap();
+            let (start, end) = editor.with_buffer_mut(|buffer| {
+                let (start, end) =
+                    clamp_target(target, buffer.lines.len(), |line| buffer.lines[line].text());
+                // The editor that just came back does not scroll to its cursor on its own: put
+                // the line at its top, as "Go to line" does
+                if switch.is_some() {
+                    buffer.set_scroll(cosmic_text::Scroll::new(start.line, 0.0, 0.0));
+                }
+                (start, end)
+            });
+            // A column block left active would still show and take the column keys
+            *tab.column.lock().unwrap() = None;
+            editor.set_cursor(start);
+            editor.set_selection(Selection::Normal(end));
+            folding::reveal_selection(&mut *editor);
+        }
+        tasks.push(self.focus_text_box());
+        tasks.push(self.update_markdown(markdown::Message::SyncScroll));
+        Task::batch(tasks)
+    }
+
+    /// The Search results panel under the editor views while open
+    pub(crate) fn find_results_panel(&self) -> Option<Element<'_, AppMessage>> {
+        if !self.find_results.open {
+            return None;
+        }
+        let cosmic_theme::Spacing {
+            space_xxs,
+            space_xs,
+            space_s,
+            ..
+        } = self.core().system_theme().cosmic().spacing;
+        let mut mark = Color::from(self.core().system_theme().cosmic().accent_color());
+        // As the find highlight in the text (`text_box::draw::draw_find_matches`)
+        mark.a = 72.0 / 255.0;
+
+        let title = widget::row::with_children(vec![
+            widget::text::body(fl!("search-results")).into(),
+            widget::space::horizontal().into(),
+            button::custom(icon_cache_get("window-close-symbolic", 16))
+                .on_press(AppMessage::FindResults(Message::Close))
+                .padding(space_xxs)
+                .class(style::Button::Icon)
+                .into(),
+        ])
+        .align_y(Alignment::Center)
+        .padding([0, 0, 0, space_xs]);
+        // Built again only when the searches or the theme change: a search lists up to
+        // `HIT_CAP` lines, too many to build again for every key typed in the editor
+        let theme_key = (mark.into_rgba8(), [space_xxs, space_xs, space_s]);
+        let list = widget::lazy((self.find_results.generation, theme_key), move |_| {
+            self.find_results_list(mark, space_xxs, space_xs, space_s)
+        });
+        let panel = widget::column::with_children(vec![
+            title.into(),
+            widget::scrollable(list)
+                .height(Length::Fixed(PANEL_HEIGHT))
+                .into(),
+        ]);
+        Some(
+            widget::layer_container(panel)
+                .layer(cosmic_theme::Layer::Primary)
+                .width(Length::Fill)
+                .into(),
+        )
+    }
+
+    /// The panel's searches, files and lines
+    fn find_results_list(
+        &self,
+        mark: Color,
+        space_xxs: u16,
+        space_xs: u16,
+        space_s: u16,
+    ) -> Element<'static, AppMessage> {
+        let row_button = |content: Element<'static, AppMessage>,
+                          message: Message,
+                          indent: u16|
+         -> Element<'static, AppMessage> {
+            button::custom(widget::container(content).padding([0, 0, 0, indent]))
+                .class(style::Button::MenuItem)
+                .on_press(AppMessage::FindResults(message))
+                .padding([1, space_xxs])
+                .width(Length::Fill)
+                .into()
+        };
+        let mut list = widget::column::with_capacity(self.find_results.searches.len());
+        for (s, search) in self.find_results.searches().iter().enumerate() {
+            let fold_icon = if search.folded {
+                "go-next-symbolic"
+            } else {
+                "go-down-symbolic"
+            };
+            let header = widget::row::with_children(vec![
+                icon_cache_get(fold_icon, 16).into(),
+                widget::text::heading(search.header()).into(),
+            ])
+            .align_y(Alignment::Center)
+            .spacing(space_xxs);
+            list = list.push(row_button(header.into(), Message::Toggle(s), 0));
+            if search.folded {
+                continue;
+            }
+            for (f, file) in search.files.iter().enumerate() {
+                list = list.push(
+                    widget::container(widget::text::body(format!(
+                        "{} ({})",
+                        file.name,
+                        fl!(
+                            "find-results-hits",
+                            count = file.hits,
+                            text = thousands(file.hits)
+                        )
+                    )))
+                    .padding([1, space_xxs, 1, space_xxs + space_s]),
+                );
+                for (l, line) in file.lines.iter().enumerate() {
+                    list = list.push(row_button(
+                        result_line_view(line, mark),
+                        Message::Open(s, f, l),
+                        space_s * 2,
+                    ));
+                }
+            }
+        }
+        list.padding([0, space_xs, space_xxs, 0]).into()
+    }
+}
+
+/// `Line 12: <text>` with the matched parts on the find highlight colour `mark`
+fn result_line_view(line: &ResultLine, mark: Color) -> Element<'static, AppMessage> {
+    let number = fl!("find-results-line", line = (line.line + 1).to_string());
+    let mut spans: Vec<iced::widget::text::Span<'static, (), Font>> =
+        vec![iced::widget::span(format!("{number} "))];
+    let mut at = 0;
+    for &(from, to) in &line.marks {
+        if from < at {
+            continue;
+        }
+        spans.push(iced::widget::span(line.text[at..from].to_string()).font(Font::MONOSPACE));
+        spans.push(
+            iced::widget::span(line.text[from..to].to_string())
+                .font(Font::MONOSPACE)
+                .background(mark),
+        );
+        at = to;
+    }
+    spans.push(iced::widget::span(line.text[at..].to_string()).font(Font::MONOSPACE));
+    iced::widget::rich_text(spans)
+        .wrapping(iced::widget::text::Wrapping::None)
+        .into()
+}

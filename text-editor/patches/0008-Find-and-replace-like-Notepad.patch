+    fn one_row_per_line_with_every_match_marked() {
+        let lines = find(&["cat dog cat", "none", "a cat"], "cat", None);
+        assert_eq!(lines.len(), 2);
+        assert_eq!(lines[0].line, 0);
+        assert_eq!(lines[0].text, "cat dog cat");
+        assert_eq!(lines[0].marks, vec![(0, 3), (8, 11)]);
+        assert_eq!(
+            lines[0].target,
+            span(0, 0, 0, 3),
+            "a click goes to the first"
+        );
+        assert_eq!(lines[1].line, 2);
+        assert_eq!(lines[1].marks, vec![(2, 5)]);

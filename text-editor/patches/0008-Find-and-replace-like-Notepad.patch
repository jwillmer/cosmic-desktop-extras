+        let at = |span| clamp_target(span, text.len(), |line| text[line]);
+        // Unchanged: the match itself
+        assert_eq!(at(span(0, 1, 0, 3)), (Cursor::new(0, 1), Cursor::new(0, 3)));
+        // Past the last line: the last line
+        assert_eq!(at(span(7, 0, 7, 3)), (Cursor::new(1, 0), Cursor::new(1, 3)));
+        // Past the line's end, or inside a character: back to a boundary
+        assert_eq!(
+            at(span(0, 9, 0, 12)),
+            (Cursor::new(0, 5), Cursor::new(0, 5))
+        );
+        assert_eq!(at(span(1, 2, 1, 2)), (Cursor::new(1, 1), Cursor::new(1, 1)));
+        // An empty document
+        let none: [&str; 1] = [""];
+        assert_eq!(
+            clamp_target(span(3, 4, 3, 5), 1, |line| none[line]),
+            (Cursor::new(0, 0), Cursor::new(0, 0))
+        );
+    }
+}

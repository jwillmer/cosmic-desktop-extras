From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Fri, 20 Nov 2026 14:40:50 +0100
Subject: [PATCH 08/10] Find and replace like Notepad++

A movable Find and Replace window like Notepad++'s: whole word, extended mode, regex groups, a live count with highlights, F3 keys, matches across line breaks, In selection, a fast one-step Replace all, Find All with a Search results panel (F7), and Find in Files with Replace in Files.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/config_ext.rs b/src/config_ext.rs
new file mode 100644
index 0000000..c13d00d
--- /dev/null
+++ b/src/config_ext.rs
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Our `Config` methods; the fields stay in `config`, where cosmic-config stores each as a key.
+
+use crate::Config;
+
+impl Config {
+    pub fn find_regex(&self, pattern: &str) -> Result<regex::Regex, regex::Error> {
+        let pattern = if self.find_use_regex {
+            pattern.to_string()
+        } else if self.find_extended {
+            regex::escape(&crate::find_text::unescape(pattern))
+        } else {
+            regex::escape(pattern)
+        };
+        let pattern = if self.find_whole_word {
+            // A match must not continue a word on either side. `\b` alone fails
+            // when the pattern starts or ends with a non-word char (`.foo`, `foo-`),
+            // so each side also accepts a half boundary: `(?:\b|\b{start-half})`
+            // only rejects a position between two word chars.
+            format!(r"(?:\b|\b{{start-half}})(?:{pattern})(?:\b|\b{{end-half}})")
+        } else {
+            pattern
+        };
+        let mut builder = regex::RegexBuilder::new(&pattern);
+        builder.case_insensitive(!self.find_case_sensitive);
+        if self.find_use_regex {
+            // `^` and `$` at every line break, `\r\n` among them, so they mean a line's start
+            // and end in the joined lines too (see `find_text`), as in a single line
+            builder
+                .dot_matches_new_line(self.find_dot_matches_newline)
+                .multi_line(true)
+                .crlf(true);
+        }
+        builder.build()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::Config;
+
+    fn config(case: bool, regex: bool, whole_word: bool, dot: bool) -> Config {
+        Config {
+            find_case_sensitive: case,
+            find_use_regex: regex,
+            find_whole_word: whole_word,
+            find_dot_matches_newline: dot,
+            ..Config::default()
+        }
+    }
+
+    fn matches(config: &Config, pattern: &str, haystack: &str) -> Vec<String> {
+        config
+            .find_regex(pattern)
+            .unwrap()
+            .find_iter(haystack)
+            .map(|m| m.as_str().to_string())
+            .collect()
+    }
+
+    #[test]
+    fn plain_matches_inside_words() {
+        let c = config(false, false, false, false);
+        assert_eq!(matches(&c, "cat", "cat concat cat."), ["cat", "cat", "cat"]);
+        // Normal mode escapes regex syntax
+        assert_eq!(matches(&c, "a.c", "abc a.c"), ["a.c"]);
+    }
+
+    #[test]
+    fn whole_word_normal() {
+        let c = config(false, false, true, false);
+        assert_eq!(matches(&c, "cat", "cat concat cat."), ["cat", "cat"]);
+        assert_eq!(matches(&c, "cat", "cats _cat cat_ cat"), ["cat"]);
+        assert!(matches(&c, "cat", "concatenate").is_empty());
+        // Whole word plus escaping: `.` stays literal
+        assert_eq!(matches(&c, "a.c", "abc a.c xa.c"), ["a.c"]);
+    }
+
+    #[test]
+    fn whole_word_non_word_edges() {
+        let c = config(false, false, true, false);
+        // Leading non-word char: no word boundary needed before it
+        assert_eq!(matches(&c, ".foo", "file.foo"), [".foo"]);
+        assert!(matches(&c, ".foo", "file.food").is_empty());
+        // Trailing non-word char: no word boundary needed after it
+        assert_eq!(matches(&c, "foo-", "foo-bar"), ["foo-"]);
+        assert!(matches(&c, "foo-", "xfoo-bar").is_empty());
+        // Only non-word chars: matches anywhere
+        assert_eq!(matches(&c, "--", "a--b"), ["--"]);
+        // Non-ASCII word chars count as word chars
+        assert!(matches(&c, "cat", "écat").is_empty());
+    }
+
+    #[test]
+    fn whole_word_regex() {
+        let c = config(false, true, true, false);
+        assert_eq!(matches(&c, "ca[tr]", "cat car scar cart"), ["cat", "car"]);
+        // Alternation is grouped, so the boundary applies to every branch
+        assert_eq!(matches(&c, "cat|dog", "cat dogs dog"), ["cat", "dog"]);
+        assert_eq!(matches(&c, r"\.foo", "file.foo file.food"), [".foo"]);
+        assert_eq!(matches(&c, r"\d+", "a1 22 3b 44"), ["22", "44"]);
+    }
+
+    #[test]
+    fn case_sensitivity() {
+        let insensitive = config(false, false, false, false);
+        assert_eq!(matches(&insensitive, "Cat", "cat CAT"), ["cat", "CAT"]);
+        let sensitive = config(true, false, false, false);
+        assert_eq!(matches(&sensitive, "Cat", "cat Cat CAT"), ["Cat"]);
+        let sensitive_word_regex = config(true, true, true, false);
+        assert_eq!(
+            matches(&sensitive_word_regex, "C.t", "Cat cat Cats Cut"),
+            ["Cat", "Cut"]
+        );
+        let insensitive_word = config(false, false, true, false);
+        assert_eq!(matches(&insensitive_word, "CAT", "Cat concat"), ["Cat"]);
+    }
+
+    #[test]
+    fn dot_matches_newline_regex_only() {
+        let off = config(false, true, false, false);
+        assert_eq!(matches(&off, "a.b", "a\nb axb"), ["axb"]);
+        let on = config(false, true, false, true);
+        assert_eq!(matches(&on, "a.b", "a\nb axb"), ["a\nb", "axb"]);
+        // Multi-line either way: ^ and $ match at line starts and ends, CRLF ones too
+        assert_eq!(matches(&on, "^b$", "a\nb\nc"), ["b"]);
+        assert_eq!(matches(&off, "^b$", "a\nb\nc"), ["b"]);
+        assert_eq!(matches(&off, "^b$", "a\r\nb\r\nc"), ["b"]);
+        // `^\s+` takes each line's indent, not only the first line's
+        assert_eq!(matches(&off, r"^\s+\S", "  a\n\tb"), ["  a", "\tb"]);
+        // Ignored in normal mode: `.` is escaped there anyway
+        let normal = config(false, false, false, true);
+        assert!(matches(&normal, "a.b", "a\nb").is_empty());
+        // Combines with whole word
+        let on_word = config(false, true, true, true);
+        assert_eq!(matches(&on_word, "a.b", "a\nb xa\nb"), ["a\nb"]);
+    }
+
+    #[test]
+    fn extended_reads_escapes() {
+        let extended = Config {
+            find_extended: true,
+            ..config(true, false, false, false)
+        };
+        assert_eq!(matches(&extended, r"a\tb", "a\tb a\\tb"), ["a\tb"]);
+        assert_eq!(matches(&extended, r",\n", "a,\nb"), [",\n"]);
+        assert_eq!(matches(&extended, r"\x41.", "A. AB"), ["A."]);
+        assert_eq!(matches(&extended, r"C:\data", r"C:\data"), [r"C:\data"]);
+        // Off: the backslash is literal
+        let normal = config(true, false, false, false);
+        assert_eq!(matches(&normal, r"a\tb", "a\tb a\\tb"), ["a\\tb"]);
+        // Regex mode has its own escapes
+        let regex = Config {
+            find_extended: true,
+            ..config(true, true, false, false)
+        };
+        assert_eq!(matches(&regex, r"a\d", "a1"), ["a1"]);
+    }
+}
diff --git a/src/find_count.rs b/src/find_count.rs
new file mode 100644
index 0000000..6f0e08d
--- /dev/null
+++ b/src/find_count.rs
@@ -0,0 +1,443 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The find bar's match count ("3 of 17") and the matches of the visible rows that the text box
+//! highlights.
+//!
+//! The count scans each line on its own with the find regex, as Find next does: a match never
+//! spans a line break there either, so the count is what Find next can reach, and no joined copy
+//! of a large file is made. It runs once the typing pauses (see [`Cache`]), not per key.
+//!
+//! A query that can match a line break ([`crate::find_text::spans_lines`]) is counted in the
+//! joined lines instead ([`scan_joined`]), as Find next searches it: a full copy of the text,
+//! made only after the pause.
+
+use regex::Regex;
+
+use crate::find_text::Joined;
+use crate::fl;
+use crate::status_bar::thousands;
+
+/// The count stops here: the find bar says "10,000+"
+pub const MATCH_CAP: usize = 10_000;
+
+/// One match: where it starts (line and byte index) and where it ends; `end_line` is `line`
+/// unless it spans a line break
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub struct Span {
+    pub line: usize,
+    pub start: usize,
+    pub end_line: usize,
+    pub end: usize,
+}
+
+/// The matches of the whole text, in order, up to the cap
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Matches {
+    pub spans: Vec<Span>,
+    /// More matches follow than `spans` holds
+    pub capped: bool,
+}
+
+/// The non-empty matches of `regex` in `line`, as byte ranges, for the highlights: an empty
+/// match (of `^`, say) has nothing to show. The count and Find next take empty ones too
+/// ([`replace_matches`]).
+pub fn line_matches<'t>(
+    regex: &'t Regex,
+    line: &'t str,
+) -> impl Iterator<Item = (usize, usize)> + 't {
+    regex
+        .find_iter(line)
+        .filter(|m| !m.is_empty())
+        .map(|m| (m.start(), m.end()))
+}
+
+/// The matches Replace all replaces in `line`, as byte ranges: empty ones too, so `^` → `> `
+/// prefixes a line and `$` → `;` ends one. As the regex crate finds them: they do not overlap,
+/// and an empty match right where the previous match ended is skipped, so `x*` in `axxb`
+/// matches before `a`, then `xx`, then at the end, but not between `xx` and `b`. The count and
+/// Find next take the same matches, as in Notepad++: `^` counts once per line and Find next
+/// steps from line to line.
+pub fn replace_matches<'t>(
+    regex: &'t Regex,
+    line: &'t str,
+) -> impl Iterator<Item = (usize, usize)> + 't {
+    regex.find_iter(line).map(|m| (m.start(), m.end()))
+}
+
+/// The matches of `regex` in the lines `lines` yields, scanning no further once `cap` are found
+/// and one more shows there are others.
+pub fn scan<'t>(lines: impl IntoIterator<Item = &'t str>, regex: &Regex, cap: usize) -> Matches {
+    let mut spans = Vec::new();
+    for (line, text) in lines.into_iter().enumerate() {
+        for (start, end) in replace_matches(regex, text) {
+            if spans.len() == cap {
+                return Matches {
+                    spans,
+                    capped: true,
+                };
+            }
+            spans.push(Span {
+                line,
+                start,
+                end_line: line,
+                end,
+            });
+        }
+    }
+    Matches {
+        spans,
+        capped: false,
+    }
+}
+
+/// The matches of `regex` in the joined lines `joined`, up to `cap` like [`scan`]
+pub fn scan_joined(joined: &Joined, regex: &Regex, cap: usize) -> Matches {
+    let mut spans = Vec::new();
+    for (start, end) in replace_matches(regex, &joined.text) {
+        if spans.len() == cap {
+            return Matches {
+                spans,
+                capped: true,
+            };
+        }
+        let (start, end) = (joined.cursor(start), joined.cursor(end));
+        spans.push(Span {
+            line: start.line,
+            start: start.index,
+            end_line: end.line,
+            end: end.index,
+        });
+    }
+    Matches {
+        spans,
+        capped: false,
+    }
+}
+
+/// The matches of `regex` in `lines` (text and ending), up to `cap`: line by line, or in the
+/// joined lines for a query that spans lines (`joined`, as `App::find_joined` gives it). The
+/// count and Find All both scan this way.
+pub fn scan_text<'t>(
+    lines: impl IntoIterator<Item = (&'t str, cosmic_text::LineEnding)>,
+    regex: &Regex,
+    joined: Option<bool>,
+    cap: usize,
+) -> Matches {
+    match joined {
+        // A full copy of the text
+        Some(real_endings) => scan_joined(&Joined::new(lines, 0, real_endings), regex, cap),
+        None => scan(lines.into_iter().map(|(text, _)| text), regex, cap),
+    }
+}
+
+/// The 1-based number of the match the selection covers exactly, as Find next and previous
+/// leave it: from the cursor to the selection's other end, or an empty match at the cursor
+/// when Find next found one (an empty selection). `None` without a selection, for one that is
+/// not a match, or for a match past the cap.
+pub fn current_index(
+    matches: &Matches,
+    cursor: (usize, usize),
+    anchor: Option<(usize, usize)>,
+) -> Option<usize> {
+    let anchor = anchor?;
+    let (from, to) = (cursor.min(anchor), cursor.max(anchor));
+    let span = Span {
+        line: from.0,
+        start: from.1,
+        end_line: to.0,
+        end: to.1,
+    };
+    matches.spans.binary_search(&span).ok().map(|i| i + 1)
+}
+
+/// What the find bar says about the matches
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Count {
+    Invalid,
+    /// Matches found, and which one is selected
+    Found {
+        current: Option<usize>,
+        total: usize,
+        capped: bool,
+    },
+}
+
+impl Count {
+    /// The count of `matches` with the selected one, `current`
+    pub fn of(matches: &Matches, current: Option<usize>) -> Self {
+        Self::Found {
+            current,
+            total: matches.spans.len(),
+            capped: matches.capped,
+        }
+    }
+
+    /// "3 of 17", "17 matches", "No results", "10,000+ matches" or "Invalid pattern"
+    pub fn text(self) -> String {
+        match self {
+            Self::Invalid => fl!("find-invalid-pattern"),
+            Self::Found { total: 0, .. } => fl!("find-no-results"),
+            Self::Found {
+                current,
+                total,
+                capped,
+            } => {
+                let mut text = thousands(total);
+                if capped {
+                    text.push('+');
+                }
+                match current {
+                    Some(current) => {
+                        fl!("find-match-of", current = thousands(current), total = text)
+                    }
+                    None => fl!("find-matches", count = total, text = text),
+                }
+            }
+        }
+    }
+}
+
+/// The matches of one tab for one query, kept until the key changes. The key holds the tab,
+/// its counted text generation (which moves only once typing pauses) and the settled query, so
+/// a key press neither in the text nor in the find field scans again.
+#[derive(Debug)]
+pub struct Cache<K> {
+    cached: Option<(K, Matches)>,
+    scans: usize,
+}
+
+impl<K> Default for Cache<K> {
+    fn default() -> Self {
+        Self {
+            cached: None,
+            scans: 0,
+        }
+    }
+}
+
+impl<K: PartialEq> Cache<K> {
+    /// The matches for `key`, calling `scan` only when it differs from the last call's
+    pub fn get(&mut self, key: K, scan: impl FnOnce() -> Matches) -> &Matches {
+        if self
+            .cached
+            .as_ref()
+            .is_none_or(|(cached, _)| *cached != key)
+        {
+            self.scans += 1;
+            self.cached = Some((key, scan()));
+        }
+        &self.cached.as_ref().unwrap().1
+    }
+
+    /// Forget the matches: the find bar closed, or the query no longer compiles
+    pub fn clear(&mut self) {
+        self.cached = None;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Fluent may wrap arguments in isolation marks
+    fn plain(text: String) -> String {
+        text.replace(['\u{2068}', '\u{2069}'], "")
+    }
+
+    fn regex(pattern: &str) -> Regex {
+        Regex::new(pattern).unwrap()
+    }
+
+    #[test]
+    fn scans_each_line() {
+        let matches = scan(["the cat", "", "then the"], &regex("the"), MATCH_CAP);
+        assert_eq!(
+            matches.spans,
+            vec![
+                Span {
+                    line: 0,
+                    start: 0,
+                    end_line: 0,
+                    end: 3
+                },
+                Span {
+                    line: 2,
+                    start: 0,
+                    end_line: 2,
+                    end: 3
+                },
+                Span {
+                    line: 2,
+                    start: 5,
+                    end_line: 2,
+                    end: 8
+                },
+            ]
+        );
+        assert!(!matches.capped);
+    }
+
+    /// Replace all on each line of `text` as `EditorTab::replace_all` does it
+    fn replace_all(text: &str, pattern: &str, replace: &str) -> String {
+        let regex = regex(pattern);
+        text.split('\n')
+            .map(|line| {
+                let mut out = String::new();
+                let mut previous_end = 0;
+                for (start, end) in replace_matches(&regex, line) {
+                    out.push_str(&line[previous_end..start]);
+                    out.push_str(replace);
+                    previous_end = end;
+                }
+                out.push_str(&line[previous_end..]);
+                out
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
+    #[test]
+    fn replace_all_takes_empty_matches_once() {
+        let text = "cat 1\ncat 2\n\ncat 3";
+        // `^` and `$` once per line, an empty line too
+        assert_eq!(
+            replace_all(text, "^", "> "),
+            "> cat 1\n> cat 2\n> \n> cat 3"
+        );
+        assert_eq!(replace_all(text, "$", ";"), "cat 1;\ncat 2;\n;\ncat 3;");
+        // `\b` at each word's start and end
+        assert_eq!(replace_all("ab cd", r"\b", "|"), "|ab| |cd|");
+        // `x*`: no empty match right after `xx`
+        assert_eq!(replace_all("axxb", "x*", "-"), "-a-b-");
+        assert_eq!(replace_all("xx", "x*", "-"), "-");
+        // Non-empty matches as before
+        assert_eq!(replace_all(text, "cat", "dog"), "dog 1\ndog 2\n\ndog 3");
+    }
+
+    #[test]
+    fn empty_matches_count_as_in_notepad_plus_plus() {
+        // `^` once per line, an empty line too
+        let matches = scan(["cat 1", "", "cat 2"], &regex("^"), MATCH_CAP);
+        assert_eq!(matches.spans.len(), 3);
+        // `a*`: each empty match, but none right after `a`
+        let matches = scan(["bbb", "ab"], &regex("a*"), MATCH_CAP);
+        assert_eq!(matches.spans.len(), 6);
+        // In the joined lines too
+        let lines = [
+            ("a", cosmic_text::LineEnding::Lf),
+            ("", cosmic_text::LineEnding::None),
+        ];
+        let joined = Joined::new(lines, 0, false);
+        let matches = scan_joined(&joined, &regex("(?m)^"), MATCH_CAP);
+        assert_eq!(matches.spans.len(), 2);
+        // Find next leaves an empty selection on an empty match: it has a number
+        assert_eq!(current_index(&matches, (1, 0), Some((1, 0))), Some(2));
+        assert_eq!(current_index(&matches, (0, 1), Some((0, 1))), None);
+    }
+
+    #[test]
+    fn stops_at_the_cap() {
+        let lines = ["a a a", "a a"];
+        let matches = scan(lines, &regex("a"), 3);
+        assert_eq!(matches.spans.len(), 3);
+        assert!(matches.capped);
+        // Exactly the cap is not "more"
+        let matches = scan(lines, &regex("a"), 5);
+        assert_eq!(matches.spans.len(), 5);
+        assert!(!matches.capped);
+    }
+
+    #[test]
+    fn current_match_from_the_selection() {
+        let matches = scan(["the cat", "then the"], &regex("the"), MATCH_CAP);
+        // Find next leaves the cursor at the start and the other end at the end
+        assert_eq!(current_index(&matches, (1, 5), Some((1, 8))), Some(3));
+        // A selection made backwards is the same match
+        assert_eq!(current_index(&matches, (0, 3), Some((0, 0))), Some(1));
+        // No selection, a selection that is no match, one over two lines
+        assert_eq!(current_index(&matches, (0, 0), None), None);
+        assert_eq!(current_index(&matches, (0, 0), Some((0, 2))), None);
+        assert_eq!(current_index(&matches, (0, 0), Some((1, 3))), None);
+        assert_eq!(current_index(&matches, (0, 4), Some((0, 4))), None);
+        // A match past the cap has no number
+        let capped = scan(["the cat", "then the"], &regex("the"), 1);
+        assert_eq!(current_index(&capped, (1, 5), Some((1, 8))), None);
+    }
+
+    #[test]
+    fn joined_matches_span_lines() {
+        use cosmic_text::LineEnding;
+        let lines = [
+            ("foo", LineEnding::CrLf),
+            ("bar foo", LineEnding::CrLf),
+            ("bar", LineEnding::None),
+        ];
+        let joined = Joined::new(lines, 0, false);
+        let matches = scan_joined(&joined, &regex(r"foo\nbar"), MATCH_CAP);
+        assert_eq!(
+            matches.spans,
+            vec![
+                Span {
+                    line: 0,
+                    start: 0,
+                    end_line: 1,
+                    end: 3
+                },
+                Span {
+                    line: 1,
+                    start: 4,
+                    end_line: 2,
+                    end: 3
+                },
+            ]
+        );
+        // Find next leaves the cursor at the start, the selection's other end at the end
+        assert_eq!(current_index(&matches, (1, 4), Some((2, 3))), Some(2));
+        assert_eq!(current_index(&matches, (2, 3), Some((1, 4))), Some(2));
+        assert_eq!(current_index(&matches, (1, 4), Some((2, 2))), None);
+        let capped = scan_joined(&joined, &regex(r"foo\nbar"), 1);
+        assert_eq!(capped.spans.len(), 1);
+        assert!(capped.capped);
+    }
+
+    #[test]
+    fn labels() {
+        let matches = scan(["the the", "the"], &regex("the"), MATCH_CAP);
+        assert_eq!(plain(Count::of(&matches, Some(2)).text()), "2 of 3");
+        assert_eq!(plain(Count::of(&matches, None).text()), "3 matches");
+        let one = scan(["the"], &regex("the"), MATCH_CAP);
+        assert_eq!(plain(Count::of(&one, None).text()), "1 match");
+        let none = scan(["cat"], &regex("the"), MATCH_CAP);
+        assert_eq!(plain(Count::of(&none, None).text()), "No results");
+        let capped = Count::Found {
+            current: None,
+            total: MATCH_CAP,
+            capped: true,
+        };
+        assert_eq!(plain(capped.text()), "10,000+ matches");
+        let capped = Count::Found {
+            current: Some(1234),
+            total: MATCH_CAP,
+            capped: true,
+        };
+        assert_eq!(plain(capped.text()), "1,234 of 10,000+");
+        assert_eq!(plain(Count::Invalid.text()), "Invalid pattern");
+    }
+
+    #[test]
+    fn scans_again_only_for_a_new_key() {
+        let mut cache = Cache::default();
+        let lines = ["the"];
+        let first = cache
+            .get((1, 1), || scan(lines, &regex("the"), MATCH_CAP))
+            .clone();
+        let again = cache.get((1, 1), || panic!("scanned again")).clone();
+        assert_eq!(first, again);
+        cache.get((2, 1), || Matches::default());
+        cache.get((2, 2), || Matches::default());
+        assert_eq!(cache.scans, 3);
+        cache.clear();
+        cache.get((2, 2), || Matches::default());
+        assert_eq!(cache.scans, 4);
+    }
+}

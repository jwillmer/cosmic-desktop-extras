+/// Draw the whitespace and line end markers of the visible rows (see `whitespace`) in the
+/// editor's text colour at low alpha, behind the glyphs. Built from rectangles, so no glyph is
+/// shaped and nothing moves: a dot for a space, an arrow across a tab, `↵` after LF, `¶` after
+/// CRLF and `←` after CR. Trailing whitespace is a little stronger.
+fn draw_whitespace_markers(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    show_whitespace: bool,
+    show_line_endings: bool,
+    metrics: Metrics,
+) {
+    let markers = editor.with_buffer(|buffer| {
+        whitespace::visible_markers(buffer, show_whitespace, show_line_endings)
+    });
+    if markers.is_empty() {
+        return;
+    }
+    let fg = editor.foreground_color();
+    let faint = cosmic_text::Color::rgba(fg.r(), fg.g(), fg.b(), 72);
+    let strong = cosmic_text::Color::rgba(fg.r(), fg.g(), fg.b(), 128);
+    let size = metrics.font_size;
+    let line_h = metrics.line_height;
+    // Stroke width, and the half height of an arrowhead
+    let t = (size / 14.0).round().max(1.0);
+    let head = (size / 5.0).round().max(2.0);
+    let rect = |renderer: &mut CustomRenderer, x: f32, y: f32, w: f32, h: f32, color| {
+        renderer.rectangle(
+            x.round() as i32,
+            y.round() as i32,
+            w.round().max(1.0) as u32,
+            h.round().max(1.0) as u32,
+            color,
+        );
+    };
+    // An arrow pointing left with its tip at `x`, or right with its tip at `x + w`
+    let arrow = |renderer: &mut CustomRenderer, x: f32, w: f32, mid: f32, left: bool, color| {
+        rect(renderer, x, mid - (t / 2.0).floor(), w, t, color);
+        for i in 0..head as i32 {
+            let i = i as f32;
+            let col = if left { x + i } else { x + w - 1.0 - i };
+            rect(renderer, col, mid - i, 1.0, 2.0 * i + 1.0, color);
+        }
+    };
+    for marker in markers {
+        let color = if marker.trailing { strong } else { faint };
+        let mid = (marker.line_top + line_h / 2.0).round();
+        match marker.kind {
+            MarkerKind::Space => {
+                let d = (size / 8.0).round().max(1.0);
+                rect(
+                    renderer,
+                    marker.x + (marker.w - d) / 2.0,
+                    mid - (d / 2.0).floor(),
+                    d,
+                    d,
+                    color,
+                );
+            }
+            MarkerKind::Tab => {
+                let pad = (marker.w * 0.15).max(1.0);
+                arrow(
+                    renderer,
+                    marker.x + pad,
+                    marker.w - 2.0 * pad,
+                    mid,
+                    false,
+                    color,
+                );
+            }
+            MarkerKind::LineEnd(ending) => {
+                let x = marker.x + (size / 4.0).round();
+                let w = (size * 0.6).round();
+                let top = marker.line_top + line_h * 0.2;
+                let bottom = marker.line_top + line_h * 0.8;
+                match ending {
+                    LineEnding::Lf => {
+                        // Down the right side, then left to the arrowhead
+                        rect(renderer, x + w - t, top, t, mid - top + t, color);
+                        arrow(renderer, x, w, mid, true, color);
+                    }
+                    LineEnding::CrLf => {
+                        // Pilcrow: a filled bowl on two stems
+                        let stem1 = x + w * 0.5;
+                        let stem2 = x + w - t;
+                        rect(renderer, stem1, top, t, bottom - top, color);
+                        rect(renderer, stem2, top, t, bottom - top, color);
+                        rect(renderer, x, top, stem2 - x, t, color);
+                        rect(renderer, x, top, stem1 - x, (bottom - top) * 0.45, color);
+                    }
+                    _ => arrow(renderer, x, w, mid, true, color),
+                }
+            }
+        }
+    }
+}

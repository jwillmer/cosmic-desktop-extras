diff --git a/src/whitespace.rs b/src/whitespace.rs
new file mode 100644
index 0000000..357b6f1
--- /dev/null
+++ b/src/whitespace.rs
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Show whitespace and line endings (like Notepad++ "Show symbol"), and the line ending of a
+//! file with its conversion. The markers are overlays computed from the laid out glyphs: they
+//! never change the text, the layout or the cursor positions.
+
+use cosmic_text::{Buffer, BufferLine, Cursor, Edit, LayoutRun, LineEnding};
+use std::cell::Cell;
+
+/// What a marker stands for.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum MarkerKind {
+    Space,
+    Tab,
+    LineEnd(LineEnding),
+}
+
+/// A marker to draw over one visible character (or after the end of a line), in buffer
+/// coordinates: `x` and `w` along the visual row, `line_top` the top of that row.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Marker {
+    pub kind: MarkerKind,
+    pub x: f32,
+    pub w: f32,
+    pub line_top: f32,
+    /// Whitespace after the last other character of its line
+    pub trailing: bool,
+}
+
+/// The markers of one visible row. `line_ending` is the ending of the row's line; it is only
+/// shown after the last row of that line.
+fn run_markers(
+    run: &LayoutRun,
+    show_whitespace: bool,
+    line_ending: Option<LineEnding>,
+    out: &mut Vec<Marker>,
+) {
+    let text = run.text;
+    if show_whitespace {
+        let trailing_from = text.trim_end_matches([' ', '\t']).len();
+        for glyph in run.glyphs {
+            let kind = match text.get(glyph.start..glyph.end) {
+                Some(" ") => MarkerKind::Space,
+                Some("\t") => MarkerKind::Tab,
+                _ => continue,
+            };
+            out.push(Marker {
+                kind,
+                x: glyph.x,
+                w: glyph.w,
+                line_top: run.line_top,
+                trailing: glyph.start >= trailing_from,
+            });
+        }
+    }
+    if let Some(ending) = line_ending {
+        // The row that holds the end of the line text (an empty line has no glyphs)
+        let ends_line = run.glyphs.iter().map(|g| g.end).max().unwrap_or(0) >= text.len();
+        if ending != LineEnding::None && ends_line {
+            let x = if run.rtl { 0.0 } else { run.line_w };
+            out.push(Marker {
+                kind: MarkerKind::LineEnd(ending),
+                x,
+                w: 0.0,
+                line_top: run.line_top,
+                trailing: false,
+            });
+        }
+    }
+}
+
+/// The markers of the visible rows of `buffer`. Nothing is scanned when both are off.
+pub fn visible_markers(
+    buffer: &Buffer,
+    show_whitespace: bool,
+    show_line_endings: bool,
+) -> Vec<Marker> {
+    let mut markers = Vec::new();
+    if !show_whitespace && !show_line_endings {
+        return markers;
+    }
+    for run in buffer.layout_runs() {
+        let ending = show_line_endings
+            .then(|| buffer.lines.get(run.line_i).map(BufferLine::ending))
+            .flatten();
+        run_markers(&run, show_whitespace, ending, &mut markers);
+    }
+    markers
+}
+
+/// The line endings used in a file.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum FileEndings {
+    /// No line has an ending (a single line)
+    None,
+    One(LineEnding),
+    Mixed,
+}
+
+impl FileEndings {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::None => "-",
+            Self::One(ending) => ending_label(ending),
+            Self::Mixed => "Mixed",
+        }
+    }
+}
+
+pub fn ending_label(ending: LineEnding) -> &'static str {
+    match ending {
+        LineEnding::Lf => "LF",
+        LineEnding::CrLf => "CRLF",
+        LineEnding::Cr => "CR",
+        LineEnding::LfCr => "LFCR",
+        LineEnding::None => "-",
+    }
+}
+
+/// The line endings of `lines`; the last line usually has none and does not count.
+pub fn file_endings(lines: &[BufferLine]) -> FileEndings {
+    let mut found = FileEndings::None;
+    for line in lines {
+        let ending = line.ending();
+        if ending == LineEnding::None {
+            continue;
+        }
+        match found {
+            FileEndings::None => found = FileEndings::One(ending),
+            FileEndings::One(e) if e == ending => {}
+            _ => return FileEndings::Mixed,
+        }
+    }
+    found
+}
+
+/// The ending a new line gets in a file with `endings`: the file's own, the first line's when
+/// mixed, LF when there is none yet.
+pub fn new_line_ending(endings: FileEndings, lines: &[BufferLine]) -> LineEnding {
+    match endings {
+        FileEndings::One(ending) => ending,
+        FileEndings::Mixed => lines
+            .iter()
+            .map(BufferLine::ending)
+            .find(|ending| *ending != LineEnding::None)
+            .unwrap_or_default(),
+        FileEndings::None => LineEnding::default(),
+    }
+}
+
+/// The detected line endings of one tab, kept until the text may have changed them. Scanning
+/// is linear in the file, and the menu asks on every redraw. The line count is part of the key:
+/// adding or joining lines changes it; `clear` covers the rest (open, reload, undo, convert).
+#[derive(Debug, Default)]
+pub struct EndingsCache {
+    cached: Cell<Option<(usize, FileEndings)>>,
+    scans: Cell<usize>,
+}
+
+impl EndingsCache {
+    pub fn get(&self, lines: &[BufferLine]) -> FileEndings {
+        if let Some((len, endings)) = self.cached.get()
+            && len == lines.len()
+        {
+            return endings;
+        }
+        let endings = file_endings(lines);
+        self.scans.set(self.scans.get() + 1);
+        self.cached.set(Some((lines.len(), endings)));
+        endings
+    }
+
+    pub fn clear(&self) {
+        self.cached.set(None);
+    }
+}
+
+/// Enter with the new line ending `ending` instead of LF, as one undo step, keeping the
+/// indentation of the line like `Action::Enter` does with automatic indentation.
+pub fn insert_new_line<'buffer, E: Edit<'buffer>>(editor: &mut E, ending: LineEnding) {
+    let mut text = String::from(ending.as_str());
+    if editor.auto_indent() {
+        let line = editor.cursor().line;
+        editor.with_buffer(|buffer| {
+            if let Some(line) = buffer.lines.get(line) {
+                text.extend(line.text().chars().take_while(|c| c.is_whitespace()));
+            }
+        });
+    }
+    editor.start_change();
+    editor.insert_string(&text, None);
+    editor.finish_change();
+    editor.set_redraw(true);
+}
+
+/// Give every line that has an ending the ending `target`, as one undo step. The text itself
+/// does not change; the cursor stays on its line and column. Returns false when nothing had
+/// to change.
+pub fn convert_line_endings<'buffer, E: Edit<'buffer>>(editor: &mut E, target: LineEnding) -> bool {
+    let converted = editor.with_buffer(|buffer| {
+        if !buffer
+            .lines
+            .iter()
+            .any(|line| line.ending() != LineEnding::None && line.ending() != target)
+        {
+            return None;
+        }
+        let mut text = String::new();
+        for line in &buffer.lines {
+            text.push_str(line.text());
+            if line.ending() != LineEnding::None {
+                text.push_str(target.as_str());
+            }
+        }
+        let last = buffer.lines.len().saturating_sub(1);
+        let end = Cursor::new(last, buffer.lines.get(last).map_or(0, |l| l.text().len()));
+        Some((text, end))
+    });
+    let Some((text, end)) = converted else {
+        return false;
+    };
+    let cursor = editor.cursor();
+    // Replacing the whole text in one change keeps it one undo step and linear in the size of
+    // the file (removing line endings one by one shifts every following line each time).
+    editor.start_change();
+    editor.delete_range(Cursor::new(0, 0), end);
+    editor.insert_at(Cursor::new(0, 0), &text, None);
+    editor.finish_change();
+    editor.set_cursor(cursor);
+    editor.set_redraw(true);
+    true
+}

+    #[test]
+    fn own_save_keeps_folds() {
+        let dir = std::env::temp_dir().join(format!("folding-own-save-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("main.rs");
+        std::fs::write(&path, RUST).unwrap();
+        let mut config = crate::Config::default();
+        let system = crate::SYNTAX_SYSTEM.get_or_init(crate::syntax_system);
+        let theme = system.theme_set.themes.keys().next().unwrap();
+        config.syntax_theme_dark = theme.clone();
+        config.syntax_theme_light = theme.clone();
+        let mut tab = crate::tab::EditorTab::new(&config);
+        tab.open(path.clone());
+        let folded = |tab: &crate::tab::EditorTab| {
+            tab.editor
+                .lock()
+                .unwrap()
+                .with_buffer(|buffer| is_fold_header(buffer, 0))
+        };
+        tab.editor
+            .lock()
+            .unwrap()
+            .with_buffer_mut(|buffer| fold(buffer, 0, FoldKind::Brackets));
+        // The file watcher reloads after every own save: the text is the same, the fold stays
+        tab.save();
+        tab.reload();
+        assert!(folded(&tab));
+        // A change from outside drops it
+        std::fs::write(&path, format!("// new\n{RUST}")).unwrap();
+        tab.reload();
+        assert!(!folded(&tab));
+        assert!(
+            tab.editor
+                .lock()
+                .unwrap()
+                .with_buffer(|buffer| !buffer.lines.iter().any(is_hidden))
+        );
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+

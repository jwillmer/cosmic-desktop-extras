+    #[test]
+    fn click_below_fold_header_never_hits_hidden_mark() {
+        let editor = Mutex::new(crate::folding::tests::editor("a {\n  b\n  c\n}\nz\n", "rs"));
+        {
+            let mut editor = editor.lock().unwrap();
+            editor.with_buffer_mut(|buffer| folding::fold(buffer, 0, folding::FoldKind::Brackets));

+/// Whether `header` heads a fold. O(1), unlike [`folded_after`], for the
+/// per-frame drawing and hit tests (`layout_runs` still visits every
+/// zero-height row of a fold; accepted).
+pub fn is_fold_header(buffer: &Buffer, header: usize) -> bool {
+    buffer
+        .lines
+        .get(header)
+        .is_some_and(|line| !is_hidden(line))
+        && buffer.lines.get(header + 1).is_some_and(is_hidden)
+}
+
 /// The hidden lines right below `header`, if it heads a fold.
 pub fn folded_after(buffer: &Buffer, header: usize) -> Option<(usize, usize)> {
     let first = header + 1;
@@ -291,7 +302,7 @@ pub fn fold(buffer: &mut Buffer, line: usize, kind: FoldKind) -> Option<usize> {
     // Look a bounded way up, so a huge file never stalls the key press
     let header = (line.saturating_sub(2000)..=line).rev().find(|&header| {
         fold_range(&lines, header, kind).is_some_and(|(_, last)| last >= line)
-            && folded_after(buffer, header).is_none()
+            && !is_fold_header(buffer, header)
     })?;
     let range = fold_range(&lines, header, kind)?;
     set_range(buffer, range, true);
@@ -882,6 +893,46 @@ pub(crate) mod tests {

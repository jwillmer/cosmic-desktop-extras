+    #[test]
+    fn column_paste_below_block_unfolds_target_lines() {
+        let mut editor = editor("a {\n  b\n  c\n}\n");
+        editor.with_buffer_mut(|buffer| {
+            crate::folding::fold(buffer, 0, crate::folding::FoldKind::Brackets)
+        });
+        assert!(editor.with_buffer(|buffer| crate::folding::is_hidden(&buffer.lines[1])));
+        // A zero-width block on the header: the rows go to the folded lines below
+        assert_eq!(
+            paste(&mut editor, &block((0, 0), (0, 0)), "X\nY\nZ\nW"),
+            None
+        );
+        assert_eq!(editor_text(&editor), "Xa {\nY  b\nZ  c\nW}\n");
+        assert!(editor.with_buffer(|buffer| !buffer.lines.iter().any(crate::folding::is_hidden)));
+    }
+
     #[test]

+/// Whether an activation should bring the window forward. Every launch that reaches the
+/// running editor should, files or not. libcosmic only does it when the launcher passed an
+/// activation token, and it takes that token before the message reaches us, so the editor
+/// always raises itself as well.
+pub fn raises_window(details: &dbus_activation::Details) -> bool {
+    match details {
+        dbus_activation::Details::Activate | dbus_activation::Details::Open { .. } => true,
+        dbus_activation::Details::ActivateAction { action, .. } => action == OPEN,
+    }
+}
+
 /// The tab that already shows `canonical`, so opening it again focuses that tab.
 pub fn existing_tab<'a, E>(
     tabs: impl IntoIterator<Item = (E, Option<&'a Path>)>,
@@ -60,9 +75,41 @@ impl App {
         self.update_tab()
     }
 
-    /// Another launch of the editor. Without files it only raises this window (libcosmic does).
+    /// Unminimizes the main window and activates it with a token of our own. cosmic-comp gives
+    /// an unsandboxed client a token that takes focus; a sandboxed one only gets the attention
+    /// flag. Activating the window that a launcher's token already focused changes nothing.
+    fn raise_main_window(&self) -> Task<Message> {
+        let Some(id) = self.core().main_window_id() else {
+            return Task::none();
+        };
+        let unminimize = iced::window::minimize(id, false);
+
+        #[cfg(feature = "wayland")]
+        {
+            use iced::platform_specific::shell::commands::activation;
+            unminimize.chain(
+                activation::request_token(Some(Self::APP_ID.to_string()), Some(id)).then(
+                    move |token| {
+                        token.map_or_else(Task::none, |token| activation::activate(id, token))
+                    },
+                ),
+            )
+        }
+
+        #[cfg(not(feature = "wayland"))]
+        {
+            unminimize.chain(iced::window::gain_focus(id))
+        }
+    }
+
+    /// Another launch of the editor: open its files and bring this window forward.
     pub fn single_instance_activation(&mut self, msg: dbus_activation::Message) -> Task<Message> {
-        match msg.msg {
+        let raise = if raises_window(&msg.msg) {
+            self.raise_main_window()
+        } else {
+            Task::none()
+        };
+        let open = match msg.msg {
             dbus_activation::Details::ActivateAction { action, args } if action == OPEN => {
                 self.open_paths(args.into_iter().map(PathBuf::from))
             }
@@ -70,7 +117,8 @@ impl App {
                 self.open_paths(url.iter().filter_map(|url| url.to_file_path().ok()))
             }
             _ => Task::none(),
-        }
+        };
+        Task::batch([open, raise])
     }
 }
 

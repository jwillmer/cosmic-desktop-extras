+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Compare with saved: a read-only tab with the diff between the file on disk and the unsaved
+//! text of an editor tab, rendered like a git diff (removed lines red, added green, with
+//! context). Unlike the gutter marks, it shows the deleted text.
+//!
+//! The diff is a snapshot taken when the tab opens; opening it again for the same editor tab
+//! refreshes and focuses the existing compare tab. Session restore skips it like a git diff.
+
+use cosmic::{app::Task, widget::segmented_button};
+use similar::{Algorithm, ChangeTag, DiffTag, capture_diff_slices_deadline, group_diff_ops};
+use std::{
+    fs,
+    path::{Path, PathBuf},
+    time::{Duration, Instant},
+};
+
+use crate::{
+    App, Message, fl,
+    git::{GitDiff, GitDiffHunk, GitDiffLine},
+    tab::{GitDiffTab, Tab, editor_text},
+};
+
+/// Unchanged lines shown around each change.
+const CONTEXT_LINES: usize = 3;
+/// A diff that takes longer falls back to a coarser result instead of blocking.
+const DIFF_DEADLINE: Duration = Duration::from_millis(500);
+
+fn lines(text: &str) -> Vec<&str> {
+    // Same count as the editor's buffer lines: "a\n" is two lines, the second empty. Empty text
+    // has no lines, so an untitled tab shows only added lines
+    if text.is_empty() {
+        return Vec::new();
+    }
+    text.split('\n')
+        .map(|line| line.strip_suffix('\r').unwrap_or(line))
+        .collect()
+}
+
+/// The text to compare against: the file on disk, or empty for an untitled or unreadable file.
+pub fn saved_text(path_opt: Option<&Path>) -> String {
+    path_opt
+        .and_then(|path| match fs::read_to_string(path) {
+            Ok(text) => Some(text),
+            Err(err) => {
+                log::warn!("failed to read {:?} to compare with: {}", path, err);
+                None
+            }
+        })
+        .unwrap_or_default()
+}
+
+/// The diff from `saved` to `current` as git diff hunks, or `None` when no line differs.
+pub fn compare(path: PathBuf, saved: &str, current: &str) -> Option<GitDiff> {
+    let (old, new) = (lines(saved), lines(current));
+    let deadline = Instant::now() + DIFF_DEADLINE;
+    let ops = capture_diff_slices_deadline(Algorithm::Myers, &old, &new, Some(deadline));
+    let mut hunks = Vec::new();
+    for group in group_diff_ops(ops, CONTEXT_LINES) {
+        if group.iter().all(|op| op.tag() == DiffTag::Equal) {
+            continue;
+        }
+        let (Some(first), Some(last)) = (group.first(), group.last()) else {
+            continue;
+        };
+        let old_range = first.old_range().start..last.old_range().end;
+        let new_range = first.new_range().start..last.new_range().end;
+        let mut diff_lines = Vec::new();
+        for op in &group {
+            for change in op.iter_changes(&old, &new) {
+                let text = change.value().to_string();
+                let old_line = change.old_index().map(|i| i as u64 + 1);
+                let new_line = change.new_index().map(|i| i as u64 + 1);
+                diff_lines.push(match (change.tag(), old_line, new_line) {
+                    (ChangeTag::Equal, Some(old_line), Some(new_line)) => GitDiffLine::Context {
+                        old_line,
+                        new_line,
+                        text,
+                    },
+                    (ChangeTag::Delete, Some(old_line), _) => {
+                        GitDiffLine::Deleted { old_line, text }
+                    }
+                    (_, _, Some(new_line)) => GitDiffLine::Added { new_line, text },
+                    _ => continue,
+                });
+            }
+        }
+        hunks.push(GitDiffHunk {
+            old_range: patch::Range {
+                start: old_range.start as u64 + 1,
+                count: old_range.len() as u64,
+            },
+            new_range: patch::Range {
+                start: new_range.start as u64 + 1,
+                count: new_range.len() as u64,
+            },
+            lines: diff_lines,
+        });
+    }
+    if hunks.is_empty() {
+        return None;
+    }
+    Some(GitDiff {
+        path,
+        staged: false,
+        hunks,
+    })
+}
+
+/// The compare tab opened for the editor tab `source`, if any.
+pub fn find_compare_tab(
+    model: &segmented_button::SingleSelectModel,
+    source: segmented_button::Entity,
+) -> Option<segmented_button::Entity> {
+    model.iter().find(|entity| {
+        matches!(
+            model.data::<Tab>(*entity),
+            Some(Tab::GitDiff(GitDiffTab { compare_of: Some(of), .. })) if *of == source
+        )
+    })
+}
+
+impl App {
+    /// Open (or refresh and focus) the compare tab of the editor tab `entity_opt` or the active
+    /// one. Does nothing when the tab has no unsaved changes.
+    pub fn compare_with_saved(
+        &mut self,
+        entity_opt: Option<segmented_button::Entity>,
+    ) -> Task<Message> {
+        let source = entity_opt.unwrap_or_else(|| self.tab_model.active());
+        let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(source) else {
+            return Task::none();
+        };
+        if !tab.changed() {
+            return Task::none();
+        }
+        let current = editor_text(&tab.editor.lock().unwrap());
+        let saved = saved_text(tab.path_opt.as_deref());
+        let path = tab.path_opt.clone().unwrap_or_default();
+        let title = fl!("compare-title", name = tab.title());
+        let icon = tab.icon(16);
+        let Some(diff) = compare(path, &saved, &current) else {
+            return Task::none();
+        };
+        let compare_tab = Tab::GitDiff(GitDiffTab {
+            title: title.clone(),
+            diff,
+            compare_of: Some(source),
+        });
+        match find_compare_tab(&self.tab_model, source) {
+            Some(entity) => {
+                self.tab_model.data_set::<Tab>(entity, compare_tab);
+                self.tab_model.text_set(entity, title);
+                self.tab_model.activate(entity);
+            }
+            None => {
+                self.tab_model
+                    .insert()
+                    .text(title)
+                    .icon(icon)
+                    .data::<Tab>(compare_tab)
+                    .closable()
+                    .activate();
+            }
+        }
+        self.update_tab()
+    }
+}

+    fn the_selection_fill_stands_out_and_keeps_text_readable() {
+        for theme in [cosmic::Theme::light(), cosmic::Theme::dark()] {
+            let cosmic = theme.cosmic();
+            let accent = Color::from(cosmic.accent.base);
+            // The page, and code blocks on their component surface
+            for (background, text) in [
+                (cosmic.bg_color(), cosmic.on_bg_color()),
+                (cosmic.bg_component_color(), cosmic.on_bg_component_color()),
+            ] {
+                let (background, text) = (Color::from(background), Color::from(text));
+                let fill = selection_fill(accent, background, text);
+                assert_eq!((fill.r, fill.g, fill.b), (accent.r, accent.g, accent.b));
+                assert!(fill.a <= 0.6 * accent.a + 1e-6, "{fill:?}");
+                let shown = blend(accent, background, fill.a / accent.a);
+                assert!(contrast(text, shown) >= 4.0, "{text:?} on {shown:?}");
+                assert!(
+                    contrast(shown, background) >= 1.5,
+                    "{fill:?} on {background:?}"
+                );
+            }
+        }
     }
 
     #[test]

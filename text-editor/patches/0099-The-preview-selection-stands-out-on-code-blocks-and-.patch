+/// How far the selection fill stands out from the background it is drawn on, as a contrast
+/// ratio: clearly visible, while the text on it keeps its own colours.
+const FILL_CONTRAST: f32 = 1.8;
+
+/// How far `text` must stand out from the selection behind it (WCAG AA).
+const TEXT_CONTRAST: f32 = 4.5;
+
 /// The selection fill behind text that keeps its colours (links, inline code, syntax colours):
-/// the theme's selection colour, light enough for any of them to stay readable on it.
-pub fn selection_fill(selected: Color) -> Color {
+/// the theme's selection colour over `background`, strong enough to stand out from it while
+/// `text` on it stays readable.
+pub fn selection_fill(selected: Color, background: Color, text: Color) -> Color {
+    let shown = |alpha| blend(selected, background, alpha);
+    let mut alpha: f32 = 0.3;
+    while alpha < 0.6 && contrast(shown(alpha), background) < FILL_CONTRAST {
+        if contrast(text, shown(alpha + 0.05)) < TEXT_CONTRAST {
+            break;
+        }
+        alpha += 0.05;
+    }
+    // Lighter where the text would not stand out, but never so light the selection goes
+    while alpha > 0.25 && contrast(text, shown(alpha)) < TEXT_CONTRAST {
+        alpha -= 0.05;
+    }
     Color {
-        a: selected.a * 0.3,
+        a: selected.a * alpha,
         ..selected
     }
 }
 
+/// `color` at `alpha` over `background`.
+fn blend(color: Color, background: Color, alpha: f32) -> Color {
+    let mix = |over: f32, under: f32| over * alpha + under * (1.0 - alpha);
+    Color::from_rgb(
+        mix(color.r, background.r),
+        mix(color.g, background.g),
+        mix(color.b, background.b),
+    )
+}
+
+/// The WCAG contrast ratio of two colours.
+fn contrast(a: Color, b: Color) -> f32 {
+    let luminance = |color: Color| {
+        let channel = |c: f32| {
+            if c <= 0.03928 {
+                c / 12.92
+            } else {
+                ((c + 0.055) / 1.055).powf(2.4)
+            }
+        };
+        0.2126 * channel(color.r) + 0.7152 * channel(color.g) + 0.0722 * channel(color.b)
+    };
+    let (a, b) = (luminance(a), luminance(b));
+    (a.max(b) + 0.05) / (a.min(b) + 0.05)
+}
+

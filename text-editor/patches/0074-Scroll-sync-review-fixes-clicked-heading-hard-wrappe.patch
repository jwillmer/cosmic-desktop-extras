+impl Layout {
+    /// The height of paragraph line `index` of `chars` characters: the wrapped height of its
+    /// paragraph, shared by its lines by their length.
+    fn paragraph_share(&self, index: usize, chars: usize, columns: usize) -> f32 {
+        let para = |line: &(Kind, bool)| matches!(line.0, Kind::Para(_));
+        let mut start = index;
+        while start > 0 && para(&self.lines[start - 1]) && !self.lines[start - 1].1 {
+            start -= 1;
+        }
+        let mut end = index;
+        while !self.lines[end].1 && end + 1 < self.lines.len() && para(&self.lines[end + 1]) {
+            end += 1;
+        }
+        let lengths = self.lines[start..=end].iter().map(|line| match line.0 {
+            Kind::Para(chars) => chars,
+            _ => 0,
+        });
+        let count = end + 1 - start;
+        // Lines flow together with a space between them
+        let total: usize = lengths.sum::<usize>() + count - 1;
+        let height = total.div_ceil(columns).max(1) as f32;
+        if total == 0 {
+            return height / count as f32;
+        }
+        height * (chars + usize::from(index < end)) as f32 / total as f32
+    }
+}

+    #[test]
+    fn replace_all_rewrites_many_line_breaks_at_once() {
+        // 300 CRLF lines, one LF line among them: enough replacements that add a line break
+        // for the lines to be rewritten in one go
+        let mut text = "k, v\r\n".repeat(300) + "end";
+        text.replace_range(150 * 6..150 * 6 + 6, "k, v\n");
+        let tab = tab_with(&text);
+        let (regex, joined) = regex_query(", ");
+        assert_eq!(joined, None);
+        let replacement = crate::find_text::Replacement::new(r",\n", true, false);
+        let range = Some(((0, 0), (300, 3)));
+        let (count, range_end) = tab.replace_all(&regex, &replacement, range);
+        let replaced = text.replace(", ", ",\r\n");
+        assert_eq!((count, text_of(&tab)), (300, replaced.clone()));
+        assert_eq!(
+            range_end,
+            Some((600, 3)),
+            "the range ends where it did, moved down"
+        );
+        let cursor = || tab.editor.lock().unwrap().cursor();
+        assert_eq!(
+            cursor(),
+            cosmic_text::Cursor::new(599, 0),
+            "after the last one"
+        );
+        tab.editor.lock().unwrap().undo();
+        assert_eq!(text_of(&tab), text, "one undo step");
+        tab.editor.lock().unwrap().redo();
+        assert_eq!(text_of(&tab), replaced);
+        // The same back in the joined lines: each removes a line break
+        let (regex, joined) = regex_query(r",\r\n");
+        assert_eq!(joined, Some(true));
+        let replacement = crate::find_text::Replacement::new(", ", true, false);
+        let (count, _) = tab.replace_all_joined(&regex, true, &replacement, None);
+        assert_eq!((count, text_of(&tab)), (300, text.clone()));
+        assert_eq!(cursor(), cosmic_text::Cursor::new(299, 3));
+        tab.editor.lock().unwrap().undo();
+        assert_eq!(text_of(&tab), replaced);
+        // Rewritten, the lines move a number of times linear in theirs: one by one, the
+        // 3,000 edits would move 13.5 million
+        let text = "k, v\r\n".repeat(3_000);
+        let mut editor = crate::column_select::tests::editor(&text);
+        let edits: Vec<_> = (0..3_000)
+            .map(|line| ((line, 2), (line, 3), "\r\n"))
+            .collect();
+        let mut counted = Counted {
+            editor: &mut editor,
+            moved: 0,
+        };
+        counted.start_change();
+        super::apply_edits(&mut counted, &edits);
+        counted.finish_change();
+        let moved = counted.moved;
+        assert_eq!(super::editor_text(&editor), text.replace(", ", ",\r\n"));
+        assert!(
+            moved <= 2 * 6_000 * super::INSERT_LINES,
+            "{moved} lines moved"
+        );
+        editor.undo();
+        assert_eq!(super::editor_text(&editor), text);
+    }

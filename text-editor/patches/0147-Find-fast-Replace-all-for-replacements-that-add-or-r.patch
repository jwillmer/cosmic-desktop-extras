+/// How many lines cosmic-text may move per line of the edited span before [`apply_edits`]
+/// rewrites the span in one go instead: moving a line is cheaper than writing it anew.
+const REWRITE_MOVES_PER_LINE: usize = 16;
+
+/// Make the edits `edits` (each: the start and end of the replaced text and the text put
+/// there; in order, not overlapping), within the caller's change. One by one from the last back,
+/// unless that moves too many lines: cosmic-text moves every line behind an edit that adds or
+/// removes line breaks, which took minutes for 50,000 of them in a 5 MB file. Then the lines
+/// from the first edit to the last are rewritten with all edits made, deleted and inserted in
+/// pieces (see [`insert_in_pieces`]), keeping each line's own ending.
+fn apply_edits<'buffer, E: Edit<'buffer>>(editor: &mut E, edits: &[(Pos, Pos, &str)]) {
+    let (Some(&(first, _, _)), Some(&(_, last, _))) = (edits.first(), edits.last()) else {
+        return;
+    };
+    let total = editor.with_buffer(|buffer| buffer.lines.len());
+    let moves: usize = edits
+        .iter()
+        .filter(|(start, end, text)| start.0 != end.0 || text.contains(['\n', '\r']))
+        .map(|(_, end, _)| total.saturating_sub(end.0))
+        .sum();
+    if moves <= REWRITE_MOVES_PER_LINE * (last.0 - first.0 + 1) {
+        for &(start, end, text) in edits.iter().rev() {
+            let start = Cursor::new(start.0, start.1);
+            editor.delete_range(start, Cursor::new(end.0, end.1));
+            editor.insert_at(start, text, None);
+        }
+        return;
+    }
+    let start = Cursor::new(first.0, 0);
+    let (end, text) = editor.with_buffer(|buffer| {
+        // The span's text, its last line without its ending, and where each line starts in it
+        let mut old = String::new();
+        let mut starts = Vec::with_capacity(last.0 - first.0 + 1);
+        for (line, buffer_line) in buffer.lines[first.0..=last.0].iter().enumerate() {
+            starts.push(old.len());
+            old.push_str(buffer_line.text());
+            if first.0 + line < last.0 {
+                old.push_str(buffer_line.ending().as_str());
+            }
+        }
+        let offset = |pos: Pos| starts[pos.0 - first.0] + pos.1;
+        let mut text = String::with_capacity(old.len());
+        let mut done = 0;
+        for &(start, end, replace) in edits {
+            text.push_str(&old[done..offset(start)]);
+            text.push_str(replace);
+            done = offset(end);
+        }
+        text.push_str(&old[done..]);
+        let end = Cursor::new(last.0, buffer.lines[last.0].text().len());
+        (end, text)
+    });
+    delete_in_pieces(editor, start, end);
+    insert_in_pieces(editor, start, &text);
+}

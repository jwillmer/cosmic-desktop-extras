+/// The non-empty matches of `regex` in the joined lines `joined`, up to `cap` like [`scan`]
+pub fn scan_joined(joined: &Joined, regex: &Regex, cap: usize) -> Matches {
+    let mut spans = Vec::new();
+    for (start, end) in line_matches(regex, &joined.text) {
+        if spans.len() == cap {
+            return Matches {
+                spans,
+                capped: true,
+            };
+        }
+        let (start, end) = (joined.cursor(start), joined.cursor(end));
+        spans.push(Span {
+            line: start.line,
+            start: start.index,
+            end_line: end.line,
+            end: end.index,
+        });
+    }
+    Matches {
+        spans,
+        capped: false,
+    }

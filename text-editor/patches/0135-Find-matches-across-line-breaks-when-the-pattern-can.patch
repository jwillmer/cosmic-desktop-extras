+    /// The buffer's lines joined, to find matches of a query that spans lines
+    /// (see `find_text::spans_lines`); `real_endings` as in `find_text::Joined::new`.
+    fn joined(editor: &ViEditor<'static, 'static>, real_endings: bool) -> Joined {
+        editor.with_buffer(|buffer| {
+            Joined::new(
+                buffer.lines.iter().map(|line| (line.text(), line.ending())),
+                0,
+                real_endings,
+            )
+        })
+    }
+
+    /// `replace` for a query that spans lines: the next match from the cursor in the joined
+    /// lines is deleted and `replace` inserted, with its line breaks in the file's ending. One
+    /// undo step. Empty matches are skipped.
+    pub fn replace_joined(
+        &self,
+        regex: &Regex,
+        real_endings: bool,
+        replace: &str,
+        wrap_around: bool,
+    ) -> bool {
+        let replace = find_text::with_line_ending(replace, self.new_line_ending());
+        let mut editor = self.editor.lock().unwrap();
+        let joined = Self::joined(&editor, real_endings);
+        let from = joined.offset(editor.cursor());
+        let mut matches = crate::find_count::line_matches(regex, &joined.text);
+        let found = match matches.find(|&(start, _)| start >= from) {
+            Some(found) => Some(found),
+            None if wrap_around => crate::find_count::line_matches(regex, &joined.text).next(),
+            None => None,
+        };
+        let Some((start, end)) = found else {
+            return false;
+        };
+        let (start, end) = (joined.cursor(start), joined.cursor(end));
+        // Never change hidden text
+        editor.with_buffer_mut(|buffer| crate::folding::unfold_lines(buffer, start.line, end.line));
+        editor.start_change();
+        editor.delete_range(start, end);
+        let cursor = editor.insert_at(start, &replace, None);
+        editor.set_cursor(cursor);
+        editor.set_selection(Selection::None);
+        editor.finish_change();
+        true
+    }
+
+    /// Replace all for a query that spans lines: every match in the joined lines, as one undo
+    /// step. The cursor ends after the last replacement. Returns how many were replaced.
+    pub fn replace_all_joined(&self, regex: &Regex, real_endings: bool, replace: &str) -> usize {
+        let replace = find_text::with_line_ending(replace, self.new_line_ending());
+        let mut editor = self.editor.lock().unwrap();
+        let joined = Self::joined(&editor, real_endings);
+        let offsets: Vec<_> = crate::find_count::line_matches(regex, &joined.text).collect();
+        let Some(&(last_start, last_end)) = offsets.last() else {
+            return 0;
+        };
+        // Where the last replacement ends once all are made: each one before it moves it by
+        // what it adds and removes, counted as the joined text counts it
+        let inserted = Joined::new(
+            LineIter::new(&replace).map(|(range, ending)| (&replace[range], ending)),
+            0,
+            real_endings,
+        )
+        .text
+        .len();
+        let removed: usize = offsets.iter().map(|(start, end)| end - start).sum();
+        let end_offset = last_start + inserted * offsets.len() + (last_end - last_start) - removed;
+        let found: Vec<_> = offsets
+            .iter()
+            .map(|&(start, end)| (joined.cursor(start), joined.cursor(end)))
+            .collect();
+        editor.with_buffer_mut(|buffer| {
+            crate::folding::unfold_lines(buffer, found[0].0.line, found[found.len() - 1].1.line)
+        });
+        editor.start_change();
+        // From the last match back, so the earlier matches' cursors stay valid
+        for &(start, end) in found.iter().rev() {
+            editor.delete_range(start, end);
+            editor.insert_at(start, &replace, None);
+        }
+        let cursor = Self::joined(&editor, real_endings).cursor(end_offset);
+        editor.set_cursor(cursor);
+        editor.set_selection(Selection::None);
+        editor.finish_change();
+        found.len()
+    }
+
+    /// `search` for a query that spans lines: the next or previous match in the joined lines.
+    /// The match is selected (cursor at its start) and the folds it touches are opened.
+    pub fn search_joined(
+        &self,
+        regex: &Regex,
+        real_endings: bool,
+        forwards: bool,
+        wrap_around: bool,
+    ) -> bool {
+        let mut editor = self.editor.lock().unwrap();
+        let joined = Self::joined(&editor, real_endings);
+        let at = joined.offset(editor.cursor());
+        // With a match selected, the cursor is on its start: step past it
+        let past = editor.selection() != Selection::None;
+        let matches = || crate::find_count::line_matches(regex, &joined.text);
+        let found = if forwards {
+            matches()
+                .find(|&(start, _)| start > at || start == at && !past)
+                .or_else(|| wrap_around.then(|| matches().next()).flatten())
+        } else {
+            matches()
+                .take_while(|&(start, _)| start < at || start == at && !past)
+                .last()
+                .or_else(|| wrap_around.then(|| matches().last()).flatten())
+        };
+        let Some((start, end)) = found else {
+            return false;
+        };
+        let (start, end) = (joined.cursor(start), joined.cursor(end));
+        editor.set_cursor(start);
+        editor.set_selection(Selection::Normal(end));
+        crate::folding::reveal_selection(&mut *editor);
+        true
+    }

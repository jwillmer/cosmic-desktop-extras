+/// `draw_find_matches` for a query that spans lines: the visible lines and
+/// `FIND_MARGIN_LINES` around them are joined and searched, and each visible row draws its part
+/// of the matches. False, drawing nothing, when those lines exceed `FIND_JOINED_BYTES`.
+fn draw_joined_find_matches(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    regex: &regex::Regex,
+    real_endings: bool,
+    color: cosmic_text::Color,
+    line_height: f32,
+) -> bool {
+    editor.with_buffer(|buffer| {
+        let visible = || {
+            buffer
+                .layout_runs()
+                .filter(|run| !folding::is_folded_run(run))
+        };
+        let Some((first, last)) = visible().fold(None, |range, run| match range {
+            None => Some((run.line_i, run.line_i)),
+            Some((first, last)) => Some((run.line_i.min(first), run.line_i.max(last))),
+        }) else {
+            return true;
+        };
+        let from = first.saturating_sub(FIND_MARGIN_LINES);
+        let to = (last + FIND_MARGIN_LINES + 1).min(buffer.lines.len());
+        let lines = &buffer.lines[from..to];
+        if lines
+            .iter()
+            .map(|line| line.text().len() + 2)
+            .sum::<usize>()
+            > FIND_JOINED_BYTES
+        {
+            return false;
+        }
+        let joined = find_text::Joined::new(
+            lines.iter().map(|line| (line.text(), line.ending())),
+            from,
+            real_endings,
+        );
+        let spans: Vec<(Cursor, Cursor)> = find_count::line_matches(regex, &joined.text)
+            .map(|(start, end)| (joined.cursor(start), joined.cursor(end)))
+            .filter(|(start, end)| end.line >= first && start.line <= last)
+            .collect();
+        for run in visible() {
+            let line = run.line_i;
+            for &(start, end) in &spans {
+                if line < start.line || line > end.line {
+                    continue;
+                }
+                let start = if start.line == line {
+                    start
+                } else {
+                    Cursor::new(line, 0)
+                };
+                let end = if end.line == line {
+                    end
+                } else {
+                    Cursor::new(line, buffer.lines[line].text().len())
+                };
+                for (x, w) in run.highlight(start, end) {
+                    let left = x.floor();
+                    renderer.rectangle(
+                        left as i32,
+                        run.line_top as i32,
+                        (x + w - left).ceil() as u32,
+                        line_height as u32,
+                        color,
+                    );
+                }
+            }
+        }
+        true
+    })
+}

+    #[test]
+    fn the_preview_selection_follows_the_mouse() {
+        use select::{Action, Spot};
+        let mut preview = Preview::new(ViewMode::Preview);
+        let spot = |leaf, grapheme| Spot { leaf, grapheme };
+        preview.select(Action::Press(spot(0, 2)));
+        // A press elsewhere in the same event does not undo the new selection
+        preview.select(Action::Clear);
+        preview.select(Action::Drag(spot(1, 3)));
+        preview.select(Action::Release);
+        *preview.leaves.borrow_mut() = vec![
+            Leaf {
+                text: "Some intro".to_string(),
+                joint: Joint::Paragraph,
+            },
+            Leaf {
+                text: "an item".to_string(),
+                joint: Joint::Line,
+            },
+        ];
+        assert_eq!(preview.selected_text().as_deref(), Some("me intro\nan "));
+        // Moving without the button down changes nothing
+        preview.select(Action::Drag(spot(1, 7)));
+        assert_eq!(preview.selected_text().as_deref(), Some("me intro\nan "));
+        preview.select(Action::Clear);
+        assert_eq!(preview.selected_text(), None);
+        // A click without a drag selects nothing
+        preview.select(Action::Press(spot(1, 1)));
+        preview.select(Action::Release);
+        assert_eq!(preview.selected_text(), None);
+    }
+
+    /// The rendered text of `markdown`, all selected and copied.
+    fn copied_all(markdown: &str) -> String {
+        let mut preview = Preview::new(ViewMode::Preview);
+        preview.parse(markdown, None);
+        let viewer = PreviewViewer {
+            images: &preview.images,
+            highlights: &preview.highlights,
+            diagrams: &preview.diagrams,
+            syntax_theme: "",
+            entity: Entity::default(),
+            selection: None,
+            leaves: RefCell::new(LeafLog {
+                record: true,
+                ..LeafLog::default()
+            }),
+        };
+        let _ = html::view_document(
+            &preview.document,
+            settings(14.0, Font::MONOSPACE),
+            &viewer,
+            &preview.open_details,
+            &preview.anchor_ids,
+        );
+        let leaves = viewer.leaves.into_inner().leaves;
+        select::copied_text(&leaves, &select::select_all())
+    }
+

+    #[test]
+    fn copy_and_select_all_go_to_the_preview_in_preview() {
+        // Preview: its selection, else nothing, never the hidden editor's
+        assert_eq!(copy_target(Some(ViewMode::Preview), true), Target::Preview);
+        assert_eq!(copy_target(Some(ViewMode::Preview), false), Target::Nothing);
+        assert_eq!(select_all_target(Some(ViewMode::Preview)), Target::Preview);
+        // Split: the preview's selection where it has one, the editor's otherwise
+        assert_eq!(copy_target(Some(ViewMode::Split), true), Target::Preview);
+        assert_eq!(copy_target(Some(ViewMode::Split), false), Target::Editor);
+        assert_eq!(select_all_target(Some(ViewMode::Split)), Target::Editor);
+        for view in [Some(ViewMode::Source), None] {
+            assert_eq!(copy_target(view, false), Target::Editor);
+            assert_eq!(select_all_target(view), Target::Editor);

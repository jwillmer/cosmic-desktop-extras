+/// Where Copy or Select All goes in a Markdown tab.
+#[derive(Debug, PartialEq, Eq)]
+enum Target {
+    Preview,
+    Editor,
+    /// The preview shows alone and has nothing selected: never the hidden editor's selection.
+    Nothing,
+}
+
+/// Copy takes the preview's selection where it has one; in the Preview view nothing else.
+fn copy_target(view: Option<ViewMode>, preview_selected: bool) -> Target {
+    match view {
+        Some(ViewMode::Preview | ViewMode::Split) if preview_selected => Target::Preview,
+        Some(ViewMode::Preview) => Target::Nothing,
+        _ => Target::Editor,
+    }
+}
+
+/// Select All selects the rendered text in the Preview view, the editor's otherwise.
+fn select_all_target(view: Option<ViewMode>) -> Target {
+    match view {
+        Some(ViewMode::Preview) => Target::Preview,
+        _ => Target::Editor,
+    }
+}

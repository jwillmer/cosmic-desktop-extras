+
+/// Numbers the selectable text runs ("leaves") of the preview in the order they are drawn, and
+/// records their text for copying while there is a selection.
+#[derive(Default)]
+struct LeafLog {
+    next: usize,
+    record: bool,
+    leaves: Vec<Leaf>,
+    /// How the next leaf joins the one before, when not the default.
+    joint: Option<Joint>,
+    /// Inside a list or code block: leaves go on their own lines.
+    depth: usize,
+}
+
+impl LeafLog {
+    /// Number the next leaf, which shows `text`.
+    fn push(&mut self, text: impl FnOnce() -> String) -> usize {
+        let leaf = self.next;
+        self.next += 1;
+        let joint = self.joint.take().unwrap_or(if self.depth > 0 {
+            Joint::Line
+        } else {
+            Joint::Paragraph
+        });
+        if self.record {
+            self.leaves.push(Leaf {
+                text: text(),
+                joint,
+            });
+        }
+        leaf
+    }
+}
+
+/// See [`PreviewViewer::lines`].
+struct Lines<'v>(&'v RefCell<LeafLog>);
+
+impl Drop for Lines<'_> {
+    fn drop(&mut self) {
+        self.0.borrow_mut().depth -= 1;
+    }
+}
+
+impl<'a> PreviewViewer<'a> {
+    /// A run of text the mouse can select, the next leaf of the preview.
+    fn leaf(
+        &self,
+        spans: impl AsRef<[iced::widget::text::Span<'a, Uri>]> + 'a,
+        size: iced::Pixels,
+        font: Option<Font>,
+    ) -> Element<'a, AppMessage> {
+        let leaf = self.leaves.borrow_mut().push(|| {
+            spans
+                .as_ref()
+                .iter()
+                .map(|span| span.text.as_ref())
+                .collect()
+        });
+        let entity = self.entity;
+        let text = SelectableRich::new(spans)
+            .size(size)
+            .on_link_click(Self::on_link_click)
+            .selectable(leaf, self.selection, move |action| {
+                Message::Select(entity, action).into()
+            });
+        match font {
+            Some(font) => text.font(font).into(),
+            None => text.into(),
+        }
+    }
+
+    /// The next leaf joins the one before with `joint`.
+    fn joint(&self, joint: Joint) {
+        self.leaves.borrow_mut().joint = Some(joint);
+    }
+
+    /// Until the guard drops, leaves after the first go on their own lines: list items, code
+    /// lines.
+    fn lines(&self) -> Lines<'_> {
+        let mut log = self.leaves.borrow_mut();
+        if log.depth == 0 {
+            log.joint.get_or_insert(Joint::Paragraph);
+        }
+        log.depth += 1;
+        Lines(&self.leaves)
+    }
+
+    /// Cell `index` of a table of `columns` columns, counted by rows from the header; an empty
+    /// cell still counts, so the copied cells stay in their columns.
+    fn cell<R>(&self, index: usize, columns: usize, draw: impl FnOnce() -> R) -> R {
+        self.leaves.borrow_mut().joint = Some(if index == 0 {
+            Joint::Paragraph
+        } else if index.is_multiple_of(columns.max(1)) {
+            Joint::Line
+        } else {
+            Joint::Tab
+        });
+        let drawn = draw();
+        let mut log = self.leaves.borrow_mut();
+        if log.joint.is_some() {
+            log.push(String::new);
+        }
+        drawn
+    }
 }
 

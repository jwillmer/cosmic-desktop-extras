index 152748e..a113182 100644
--- a/src/text_box.rs
+++ b/src/text_box.rs
@@ -672,6 +672,71 @@ fn column_key(
     }
 }
 
+/// Behaviours under test:
+/// - Alt+Shift+arrows start a column selection at the cursor and extend it
+/// - typing goes to every line of the block; a plain click or arrow key leaves block mode
+#[cfg(test)]
+mod column_tests {
+    use super::*;
+    use crate::tab::editor_text;
+    use cosmic::iced::keyboard::{Location, key};
+
+    fn press(key: Key, modifiers: Modifiers, text: Option<&str>) -> Event {
+        Event::Keyboard(KeyEvent::KeyPressed {
+            key: key.clone(),
+            modified_key: key,
+            physical_key: key::Physical::Unidentified(key::NativeCode::Unidentified),
+            location: Location::Standard,
+            modifiers,
+            text: text.map(Into::into),
+            repeat: false,
+        })
+    }
+
+    #[test]
+    fn alt_shift_arrows_and_typing() {
+        let mut editor = column_select::tests::editor("abc\ndef\nghi\n");
+        editor.set_cursor(Cursor::new(0, 1));
+        let column = Mutex::new(None);
+        let down = press(
+            Key::Named(Named::ArrowDown),
+            Modifiers::ALT | Modifiers::SHIFT,
+            None,
+        );
+        assert!(column_key(&column, &mut editor, &down));
+        assert!(column_key(&column, &mut editor, &down));
+        assert_eq!(
+            *column.lock().unwrap(),
+            Some(Block::new(Pos::new(0, 1), Pos::new(2, 1)))
+        );
+        let x = press(Key::Character("x".into()), Modifiers::empty(), Some("x"));
+        assert!(column_key(&column, &mut editor, &x));
+        assert_eq!(editor_text(&editor), "axbc\ndxef\ngxhi\n");
+        // Shortcuts go to the app
+        let copy = press(Key::Character("c".into()), Modifiers::CTRL, Some("c"));
+        assert!(!column_key(&column, &mut editor, &copy));
+        assert!(column.lock().unwrap().is_some());
+    }
+
+    #[test]
+    fn plain_click_leaves_block_mode() {
+        let editor = Mutex::new(column_select::tests::editor("abc\ndef\n"));
+        let block = Block::new(Pos::new(0, 0), Pos::new(1, 2));
+        let column = Mutex::new(Some(block));
+        TextBox::<()>::new(&editor, Metrics::new(14.0, 20.0))
+            .column_block(&column)
+            .leave_column();
+        assert_eq!(*column.lock().unwrap(), None);
+
+        // A plain arrow key leaves it too, and still moves the cursor as usual
+        *column.lock().unwrap() = Some(block);
+        let down = press(Key::Named(Named::ArrowDown), Modifiers::empty(), None);
+        let mut editor = editor.lock().unwrap();
+        assert!(!column_key(&column, &mut editor, &down));
+        assert_eq!(*column.lock().unwrap(), None);
+    }
+}
+
 /// Draw the whitespace and line end markers of the visible rows (see `whitespace`) in the
 /// editor's text colour at low alpha, behind the glyphs. Built from rectangles, so no glyph is
 /// shaped and nothing moves: a dot for a space, an arrow across a tab, `↵` after LF, `¶` after

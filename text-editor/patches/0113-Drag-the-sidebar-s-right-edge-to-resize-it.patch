+++ b/src/sidebar.rs
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The sidebar (the project file tree) can be made wider or narrower by dragging its right edge,
+//! like the divider between two views. A resize pointer shows over a strip at the edge.
+//!
+//! Until it is dragged the sidebar keeps the upstream width: as wide as its items, at most 280
+//! px. A dragged width stays between [`MIN_WIDTH`] and half the window and is kept in the
+//! session. A condensed window (the sidebar over the whole window) has no strip.
+
+use cosmic::{
+    app::Task,
+    iced::{Subscription, event, mouse, window},
+};
+
+use crate::{App, Message as AppMessage};
+
+/// The narrowest the sidebar gets when dragged, in pixels.
+pub const MIN_WIDTH: f32 = 160.0;
+/// The widest a saved width is taken as, before the window's half applies.
+const MAX_SAVED_WIDTH: f32 = 8192.0;
+/// The strip at the sidebar's right edge to grab it by, in pixels.
+pub const HANDLE_WIDTH: u16 = 8;
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Message {
+    /// The strip was pressed.
+    Press,
+    /// While dragging: the pointer is at this x in the window.
+    Drag(f32),
+    /// The mouse button was let go, or the pointer left the window.
+    Release,
+    /// A window opened or was resized to this width.
+    WindowWidth(window::Id, f32),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::Sidebar(message)
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub struct Sidebar {
+    /// The dragged width; `None` keeps the upstream width.
+    pub width: Option<f32>,
+    pub dragging: bool,
+    /// The main window's width; 0 until known.
+    window_width: f32,
+}
+
+impl Sidebar {
+    /// The width to draw the sidebar with; `None` for the upstream width.
+    pub fn shown_width(&self) -> Option<f32> {
+        self.width.map(|width| clamp_width(width, self.window_width))
+    }
+}
+
+/// `width` kept between [`MIN_WIDTH`] and half of `window_width` (when known). A window too
+/// narrow for that gets [`MIN_WIDTH`].
+pub fn clamp_width(width: f32, window_width: f32) -> f32 {
+    let max = if window_width.is_finite() && window_width > 0.0 {
+        window_width / 2.0
+    } else {
+        MAX_SAVED_WIDTH
+    };
+    if !width.is_finite() {
+        return MIN_WIDTH;
+    }
+    width.clamp(MIN_WIDTH, max.max(MIN_WIDTH))
+}
+
+/// The sidebar width for the pointer at `x` in the window: the sidebar starts `left` pixels
+/// from the window's edge and the pointer stays in the middle of the strip.
+pub fn drag_width(x: f32, left: f32) -> f32 {
+    x - left + f32::from(HANDLE_WIDTH) / 2.0
+}
+
+/// A width read from the session; `None` when it is not a usable number.
+pub fn restored_width(saved: Option<f32>) -> Option<f32> {
+    saved
+        .filter(|width| width.is_finite() && *width > 0.0)
+        .map(|width| width.clamp(MIN_WIDTH, MAX_SAVED_WIDTH))
+}
+
+impl App {
+    pub fn update_sidebar(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Press => self.sidebar.dragging = true,
+            Message::Drag(x) => {
+                if self.sidebar.dragging {
+                    // libcosmic puts the sidebar this far from the window's left edge
+                    let left = self.core.window.border_padding.unwrap_or(
+                        if self.core.window.is_maximized { 8 } else { 7 },
+                    );
+                    self.sidebar.width = Some(clamp_width(
+                        drag_width(x, f32::from(left)),
+                        self.sidebar.window_width,
+                    ));
+                }
+            }
+            Message::Release => self.sidebar.dragging = false,
+            Message::WindowWidth(id, width) => {
+                if self.core.main_window_is(id) {
+                    self.sidebar.window_width = width;
+                }
+            }
+        }
+        Task::none()
+    }
+
+    /// The main window's width, for the limit of half of it, and while dragging: the pointer,
+    /// and the button let go anywhere in the window or the pointer leaving it to end the drag.
+    pub fn sidebar_subscription(&self) -> Subscription<AppMessage> {
+        let window_width = event::listen_with(|event, _status, id| match event {
+            event::Event::Window(
+                window::Event::Opened { size, .. } | window::Event::Resized(size),
+            ) => Some(Message::WindowWidth(id, size.width).into()),
+            _ => None,
+        });
+        if !self.sidebar.dragging {
+            return window_width;
+        }
+        let drag = event::listen_with(|event, _status, _window| match event {
+            event::Event::Mouse(mouse::Event::CursorMoved { position }) => {
+                Some(Message::Drag(position.x).into())
+            }
+            event::Event::Mouse(
+                mouse::Event::ButtonReleased(mouse::Button::Left) | mouse::Event::CursorLeft,
+            ) => Some(Message::Release.into()),
+            _ => None,
+        });
+        Subscription::batch([window_width, drag])
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn width_stays_between_minimum_and_half_the_window() {
+        assert_eq!(clamp_width(300.0, 1200.0), 300.0);
+        assert_eq!(clamp_width(90.0, 1200.0), MIN_WIDTH);
+        assert_eq!(clamp_width(900.0, 1200.0), 600.0);
+        // A window too narrow for the minimum on half of it
+        assert_eq!(clamp_width(250.0, 280.0), MIN_WIDTH);
+        // Window width not known yet: only the minimum and the saved limit
+        assert_eq!(clamp_width(700.0, 0.0), 700.0);
+        assert_eq!(clamp_width(20_000.0, 0.0), MAX_SAVED_WIDTH);
+        assert_eq!(clamp_width(f32::NAN, 1200.0), MIN_WIDTH);
+        assert_eq!(clamp_width(300.0, f32::INFINITY), 300.0);
+    }
+
+    #[test]
+    fn pointer_stays_in_the_middle_of_the_strip() {
+        assert_eq!(drag_width(250.0, 7.0), 247.0);
+    }
+
+    #[test]
+    fn shown_width_follows_the_window() {
+        let mut sidebar = Sidebar::default();
+        assert_eq!(sidebar.shown_width(), None);
+        sidebar.width = Some(500.0);
+        assert_eq!(sidebar.shown_width(), Some(500.0));
+        // A smaller window narrows it without losing the dragged width
+        sidebar.window_width = 800.0;
+        assert_eq!(sidebar.shown_width(), Some(400.0));
+        assert_eq!(sidebar.width, Some(500.0));
+    }
+
+    #[test]
+    fn saved_width_is_checked() {
+        assert_eq!(restored_width(None), None);
+        assert_eq!(restored_width(Some(320.5)), Some(320.5));
+        assert_eq!(restored_width(Some(40.0)), Some(MIN_WIDTH));
+        assert_eq!(restored_width(Some(1e9)), Some(MAX_SAVED_WIDTH));
+        assert_eq!(restored_width(Some(f32::NAN)), None);
+        assert_eq!(restored_width(Some(-5.0)), None);
+        assert_eq!(restored_width(Some(0.0)), None);
+    }
+}

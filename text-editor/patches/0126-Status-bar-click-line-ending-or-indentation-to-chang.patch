+/// Convert to LF and Convert to CRLF; the one the file already has throughout is disabled.
+fn line_endings_items(endings: crate::whitespace::FileEndings) -> Vec<MenuItem<Action, String>> {
     let convert = |label: String, target: cosmic_text::LineEnding, action: Action| {
         if endings == crate::whitespace::FileEndings::One(target) {
             MenuItem::ButtonDisabled(label, None, Action::NoOp)
@@ -630,19 +631,76 @@ fn line_endings_menu(
             MenuItem::Button(label, None, action)

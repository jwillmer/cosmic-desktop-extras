+
+/// "Tab width: 4", checked when it is the config's
+fn tab_width_item(config: &Config, tab_width: u16) -> MenuItem<Action, String> {
+    MenuItem::CheckBox(
+        fl!("tab-width", tab_width = tab_width),
+        None,
+        config.tab_width == tab_width,
+        Action::TabWidth(tab_width),
     )
 }

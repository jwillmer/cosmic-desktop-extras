+/// A status bar item that opens a menu above or below it when clicked: the text `label`
+/// styled like the bar's other buttons, and `items`.
+fn status_bar_menu<'a>(
+    core: &Core,
+    key_binds: &HashMap<KeyBind, Action>,
+    label: String,
+    padding: u16,
+    items: Vec<MenuItem<Action, String>>,
+) -> Element<'a, Message> {
+    let root = widget::button::custom(widget::text::caption(label))
+        .padding([0, padding])
+        .class(cosmic::theme::Button::Text);
+    widget::menu::bar(vec![widget::menu::Tree::with_children(
+        widget::RcElementWrapper::new(Element::from(root)),
+        widget::menu::items(key_binds, items),
+    )])
+    .item_height(ItemHeight::Dynamic(40))
+    .item_width(ItemWidth::Uniform(240))
+    .on_surface_action(Message::Surface)
+    .window_id_maybe(core.main_window_id())
+    .into()
+}
+
+/// The status bar's line ending item (`label`, e.g. "LF"): click it to convert the file.
+pub fn status_line_endings<'a>(
+    core: &Core,
+    key_binds: &HashMap<KeyBind, Action>,
+    label: String,
+    padding: u16,
+    endings: crate::whitespace::FileEndings,
+) -> Element<'a, Message> {
+    status_bar_menu(core, key_binds, label, padding, line_endings_items(endings))
+}
+
+/// The status bar's indentation item (`label`, e.g. "Spaces: 4"): click it for tab width 2,
+/// 4 or 8, as in View > Indentation.
+pub fn status_indentation<'a>(
+    core: &Core,
+    config: &Config,
+    key_binds: &HashMap<KeyBind, Action>,
+    label: String,
+    padding: u16,
+) -> Element<'a, Message> {
+    let items = [2, 4, 8]
+        .into_iter()
+        .map(|tab_width| tab_width_item(config, tab_width))
+        .collect();
+    status_bar_menu(core, key_binds, label, padding, items)
+}

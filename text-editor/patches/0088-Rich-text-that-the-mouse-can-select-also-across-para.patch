+//! Rich text in the Markdown preview that the mouse can select, also across paragraphs.
+//!
+//! A port of iced's `rich_text` (spans, colours, fonts, links) that draws a selection. The
+//! selection is not kept in the widget but in the preview, shared by all its text runs
+//! ("leaves", numbered in document order): a drag from one leaf into another selects everything
+//! in between, as in a browser. Only the leaf under the pointer hit-tests.
+
+use cosmic::iced::advanced::layout;
+use cosmic::iced::advanced::renderer;
+use cosmic::iced::advanced::text::{self as core_text, Paragraph, Span};
+use cosmic::iced::advanced::widget::tree::{self, Tree};
+use cosmic::iced::advanced::{Clipboard, Layout, Shell, Widget};
+use cosmic::iced::widget::text::{Alignment, Catalog, LineHeight, Shaping, Wrapping};
+use cosmic::iced::{
+    Element, Event, Length, Pixels, Point, Rectangle, Size, Vector, alignment, keyboard, mouse,
+};
+use std::ops::Range;
+use unicode_segmentation::UnicodeSegmentation;
+
+/// A place in the rendered text: a grapheme boundary in a leaf.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
+pub struct Spot {
+    pub leaf: usize,
+    pub grapheme: usize,
+}
+
+/// The preview's selection, from where the press was to where the pointer is.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Selection {
+    pub anchor: Spot,
+    pub focus: Spot,
+    /// The left button is still down: moving extends the selection.
+    pub dragging: bool,
+}
+
+impl Selection {
+    /// The start and end in document order, whichever way the drag went.
+    pub fn ordered(&self) -> (Spot, Spot) {
+        if self.anchor <= self.focus {
+            (self.anchor, self.focus)
+        } else {
+            (self.focus, self.anchor)
+        }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.anchor == self.focus
+    }
+
+    /// The selected graphemes of `leaf`, `usize::MAX` for "to its end"; `None` when none are.
+    pub fn in_leaf(&self, leaf: usize) -> Option<(usize, usize)> {
+        let (start, end) = self.ordered();
+        if self.is_empty() || leaf < start.leaf || leaf > end.leaf {
+            return None;
+        }
+        let from = if leaf == start.leaf {
+            start.grapheme
+        } else {
+            0
+        };
+        let to = if leaf == end.leaf {
+            end.grapheme
+        } else {
+            usize::MAX
+        };
+        (from < to).then_some((from, to))
+    }
+}
+
+/// How a leaf is separated from the one before it in copied text.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Joint {
+    /// A new block: a blank line.
+    Paragraph,
+    /// A list item or code line: a line break.
+    Line,
+    /// The next cell of a table row.
+    Tab,
+    /// More of the same line, after an image.
+    Inline,
+}
+
+/// The plain text of one rendered text run, as copied.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Leaf {
+    pub text: String,
+    pub joint: Joint,
+}
+
+/// The selected rendered text as plain text: blocks apart by a blank line, list items and code
+/// lines on their own lines, table cells tab-separated per row.
+pub fn copied_text(leaves: &[Leaf], selection: &Selection) -> String {
+    let mut copied = String::new();
+    let mut first = true;
+    for (index, leaf) in leaves.iter().enumerate() {
+        let Some((from, to)) = selection.in_leaf(index) else {
+            continue;
+        };
+        if !first {
+            copied.push_str(match leaf.joint {
+                Joint::Paragraph => "\n\n",
+                Joint::Line => "\n",
+                Joint::Tab => "\t",
+                Joint::Inline => "",
+            });
+        }
+        first = false;
+        copied.extend(leaf.text.graphemes(true).skip(from).take(to - from));
+    }
+    copied
+}
+
+/// Where select all ends: past the last leaf, however many the preview draws.
+const END: Spot = Spot {
+    leaf: usize::MAX,
+    grapheme: usize::MAX,
+};
+
+/// Everything rendered selected.
+pub fn select_all() -> Selection {
+    Selection {
+        anchor: Spot::default(),
+        focus: END,
+        dragging: false,
+    }
+}
+
+/// What the pointer did to the preview selection.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Action {
+    /// The left button went down on a leaf: start a selection there.
+    Press(Spot),
+    /// A drag reached this spot.
+    Drag(Spot),
+    /// The left button went up.
+    Release,
+    /// Escape, or a press outside the preview.
+    Clear,
+}
+
+/// Selectable rich text: leaf number `leaf` of the preview.
+pub struct SelectableRich<'a, Link, Message, Theme, Renderer>
+where
+    Link: Clone + 'static,
+    Theme: Catalog,
+    Renderer: core_text::Renderer,
+{
+    spans: Box<dyn AsRef<[Span<'a, Link, Renderer::Font>]> + 'a>,
+    size: Option<Pixels>,
+    line_height: LineHeight,
+    font: Option<Renderer::Font>,
+    class: Theme::Class<'a>,
+    hovered_link: Option<usize>,
+    on_link_click: Option<Box<dyn Fn(Link) -> Message + 'a>>,
+    leaf: usize,
+    /// The preview's selection, when there is one.
+    selection: Option<Selection>,
+    on_select: Option<Box<dyn Fn(Action) -> Message + 'a>>,
+}
+
+impl<'a, Link, Message, Theme, Renderer> SelectableRich<'a, Link, Message, Theme, Renderer>
+where
+    Link: Clone + 'static,
+    Theme: Catalog,
+    Renderer: core_text::Renderer,
+    Renderer::Font: 'a,
+{
+    pub fn new(spans: impl AsRef<[Span<'a, Link, Renderer::Font>]> + 'a) -> Self {
+        Self {
+            spans: Box::new(spans),
+            size: None,
+            line_height: LineHeight::default(),
+            font: None,
+            class: Theme::default(),
+            hovered_link: None,
+            on_link_click: None,
+            leaf: 0,
+            selection: None,
+            on_select: None,
+        }
+    }
+
+    pub fn size(mut self, size: impl Into<Pixels>) -> Self {
+        self.size = Some(size.into());
+        self
+    }
+
+    pub fn font(mut self, font: impl Into<Renderer::Font>) -> Self {
+        self.font = Some(font.into());
+        self
+    }
+
+    pub fn on_link_click(mut self, on_link_click: impl Fn(Link) -> Message + 'a) -> Self {
+        self.on_link_click = Some(Box::new(on_link_click));
+        self
+    }
+
+    /// Make this leaf `leaf` of the preview, sharing `selection` and reporting to `on_select`.
+    pub fn selectable(
+        mut self,
+        leaf: usize,
+        selection: Option<Selection>,
+        on_select: impl Fn(Action) -> Message + 'a,
+    ) -> Self {
+        self.leaf = leaf;
+        self.selection = selection;
+        self.on_select = Some(Box::new(on_select));
+        self
+    }
+}
+
+struct State<Link, P: Paragraph> {
+    spans: Vec<Span<'static, Link, P::Font>>,
+    /// The spans' text joined, what grapheme offsets count in.
+    content: String,
+    span_pressed: Option<usize>,
+    /// A selection started here and the button is still down.
+    pressed: bool,
+    paragraph: P,
+}
+
+impl<Link, P: Paragraph> State<Link, P> {
+    /// The grapheme boundary nearest to `position`, relative to the widget.
+    fn grapheme_at(&self, position: Point) -> usize {
+        match self.paragraph.hit_test(position) {
+            Some(hit) => {
+                // The hit counts in its line: a hard break starts a new one
+                let line = self.line_at(position.y);
+                let byte = line.start + hit.cursor().min(line.len());
+                // A hit inside a cluster counts as before it
+                self.content
+                    .grapheme_indices(true)
+                    .take_while(|(start, grapheme)| start + grapheme.len() <= byte)
+                    .count()
+            }
+            None => self.content.graphemes(true).count(),
+        }
+    }
+
+    /// The bytes of the line drawn at `y`: the first that reaches below it.
+    fn line_at(&self, y: f32) -> Range<usize> {
+        let mut lines = line_ranges(&self.content);
+        if !self.content.contains('\n') {
+            return lines.next().unwrap_or_default();
+        }
+        let mut last = 0..0;
+        for (index, line) in lines.enumerate() {
+            let bottom = self
+                .paragraph
+                .highlight(
+                    index,
+                    (0, core_text::Affinity::After),
+                    (line.len(), core_text::Affinity::Before),
+                )
+                .iter()
+                .map(|bounds| bounds.y + bounds.height)
+                .reduce(f32::max);
+            if bottom.is_some_and(|bottom| y < bottom) {
+                return line;
+            }
+            last = line;
+        }
+        last
+    }
+}
+
+/// The bytes of each line of `text`, as the paragraph breaks it at `\n`.
+fn line_ranges(text: &str) -> impl Iterator<Item = Range<usize>> + '_ {
+    let mut start = 0;
+    text.split('\n').map(move |line| {
+        let range = start..start + line.len();
+        start = range.end + 1;
+        range
+    })
+}
+
+fn grapheme_to_byte(text: &str, grapheme: usize) -> usize {
+    text.grapheme_indices(true)
+        .nth(grapheme)
+        .map_or(text.len(), |(byte, _)| byte)
+}
+
+impl<Link, Message, Theme, Renderer> Widget<Message, Theme, Renderer>
+    for SelectableRich<'_, Link, Message, Theme, Renderer>
+where
+    Link: Clone + 'static,
+    Theme: Catalog,
+    Renderer: core_text::Renderer,
+{
+    fn tag(&self) -> tree::Tag {
+        tree::Tag::of::<State<Link, Renderer::Paragraph>>()
+    }
+
+    fn state(&self) -> tree::State {
+        tree::State::new(State::<Link, Renderer::Paragraph> {
+            spans: Vec::new(),
+            content: String::new(),
+            span_pressed: None,
+            pressed: false,
+            paragraph: Renderer::Paragraph::default(),
+        })
+    }
+
+    fn size(&self) -> Size<Length> {
+        Size {
+            width: Length::Shrink,
+            height: Length::Shrink,
+        }
+    }
+
+    fn layout(
+        &mut self,
+        tree: &mut Tree,
+        renderer: &Renderer,
+        limits: &layout::Limits,
+    ) -> layout::Node {
+        let state = tree
+            .state
+            .downcast_mut::<State<Link, Renderer::Paragraph>>();
+        let spans = self.spans.as_ref().as_ref();
+        let line_height = self.line_height;
+        let size = self.size;
+        let font = self.font;
+        layout::sized(limits, Length::Shrink, Length::Shrink, |limits| {
+            let bounds = limits.max();
+            let size = size.unwrap_or_else(|| renderer.default_size());
+            let font = font.unwrap_or_else(|| renderer.default_font());
+            fn text<C, F>(
+                content: C,
+                bounds: Size,
+                size: Pixels,
+                line_height: LineHeight,
+                font: F,
+            ) -> core_text::Text<C, F> {
+                core_text::Text {
+                    content,
+                    bounds,
+                    size,
+                    line_height,
+                    font,
+                    align_x: Alignment::Default,
+                    align_y: alignment::Vertical::Top,
+                    shaping: Shaping::Advanced,
+                    wrapping: Wrapping::default(),
+                    ellipsize: core_text::Ellipsize::default(),
+                }
+            }
+            if state.spans != spans {
+                state.paragraph =
+                    Renderer::Paragraph::with_spans(text(spans, bounds, size, line_height, font));
+                state.spans = spans.iter().cloned().map(Span::to_static).collect();
+                state.content = spans.iter().map(|span| span.text.as_ref()).collect();
+            } else {
+                match state
+                    .paragraph
+                    .compare(text((), bounds, size, line_height, font))
+                {
+                    core_text::Difference::None => {}
+                    core_text::Difference::Bounds => state.paragraph.resize(bounds),
+                    core_text::Difference::Shape => {
+                        state.paragraph = Renderer::Paragraph::with_spans(text(
+                            spans,
+                            bounds,
+                            size,
+                            line_height,
+                            font,
+                        ));
+                    }
+                }
+            }
+            state.paragraph.min_bounds()
+        })
+    }
+
+    fn draw(
+        &self,
+        tree: &Tree,
+        renderer: &mut Renderer,
+        theme: &Theme,
+        defaults: &renderer::Style,
+        layout: Layout<'_>,
+        _cursor: mouse::Cursor,
+        viewport: &Rectangle,
+    ) {
+        if !layout.bounds().intersects(viewport) {
+            return;
+        }
+        let state = tree
+            .state
+            .downcast_ref::<State<Link, Renderer::Paragraph>>();
+        let style = theme.style(&self.class);
+        let translation = layout.position() - Point::ORIGIN;
+
+        for (index, span) in self.spans.as_ref().as_ref().iter().enumerate() {
+            let is_hovered_link = self.on_link_click.is_some() && Some(index) == self.hovered_link;
+            if span.highlight.is_none()
+                && !span.underline
+                && !span.strikethrough
+                && !is_hovered_link
+            {
+                continue;
+            }
+            let regions = state.paragraph.span_bounds(index);
+            if let Some(highlight) = span.highlight {
+                for bounds in &regions {
+                    let bounds = Rectangle::new(
+                        bounds.position() - Vector::new(span.padding.left, span.padding.top),
+                        bounds.size() + Size::new(span.padding.x(), span.padding.y()),
+                    );
+                    renderer.fill_quad(
+                        renderer::Quad {
+                            bounds: bounds + translation,
+                            border: highlight.border,
+                            ..Default::default()
+                        },
+                        highlight.background,
+                    );
+                }
+            }
+            if span.underline || span.strikethrough || is_hovered_link {
+                let size = span.size.or(self.size).unwrap_or(renderer.default_size());
+                let line_height = span
+                    .line_height
+                    .unwrap_or(self.line_height)
+                    .to_absolute(size);
+                let color = span.color.or(style.color).unwrap_or(defaults.text_color);
+                let baseline =
+                    translation + Vector::new(0.0, size.0 + (line_height.0 - size.0) / 2.0);
+                let offsets = (span.underline || is_hovered_link)
+                    .then_some(size.0 * 0.08)
+                    .into_iter()
+                    .chain(span.strikethrough.then_some(size.0 / 2.0));
+                for offset in offsets {
+                    for bounds in &regions {
+                        renderer.fill_quad(
+                            renderer::Quad {
+                                bounds: Rectangle::new(
+                                    bounds.position() + baseline - Vector::new(0.0, offset),
+                                    Size::new(bounds.width, 1.0),
+                                ),
+                                ..Default::default()
+                            },
+                            color,
+                        );
+                    }
+                }
+            }
+        }
+
+        // The selected part of this leaf, as in the editor: filled behind the text
+        let selected: Vec<Rectangle> = self
+            .selection
+            .and_then(|selection| selection.in_leaf(self.leaf))
+            .map(|(from, to)| {
+                let from = grapheme_to_byte(&state.content, from);
+                let to = grapheme_to_byte(&state.content, to);
+                line_ranges(&state.content)
+                    .enumerate()
+                    .filter(|(_, line)| line.start < to && from <= line.end)
+                    .flat_map(|(index, line)| {
+                        state.paragraph.highlight(
+                            index,
+                            (
+                                from.max(line.start) - line.start,
+                                core_text::Affinity::After,
+                            ),
+                            (to.min(line.end) - line.start, core_text::Affinity::Before),
+                        )
+                    })
+                    .map(|bounds| bounds + translation)
+                    .collect()
+            })
+            .unwrap_or_default();
+        for bounds in &selected {
+            renderer.fill_quad(
+                renderer::Quad {
+                    bounds: *bounds,
+                    ..Default::default()
+                },
+                style.selected_fill,
+            );
+        }
+
+        cosmic::iced::widget::text::draw(
+            renderer,
+            defaults,
+            layout.bounds(),
+            &state.paragraph,
+            style,
+            viewport,
+        );
+        if let Some(color) = style.selected_text_color {
+            for bounds in &selected {
+                renderer.with_layer(*bounds, |renderer| {
+                    renderer.fill_paragraph(&state.paragraph, layout.position(), color, *viewport);
+                });
+            }
+        }
+    }
+
+    fn update(
+        &mut self,
+        tree: &mut Tree,
+        event: &Event,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        _renderer: &Renderer,
+        _clipboard: &mut dyn Clipboard,
+        shell: &mut Shell<'_, Message>,
+        _viewport: &Rectangle,
+    ) {
+        let bounds = layout.bounds();
+        let state = tree
+            .state
+            .downcast_mut::<State<Link, Renderer::Paragraph>>();
+
+        if self.on_link_click.is_some() {
+            let was_hovered = self.hovered_link.is_some();
+            self.hovered_link = cursor
+                .position_in(bounds)
+                .and_then(|position| state.paragraph.hit_span(position))
+                .filter(|span| {
+                    self.spans
+                        .as_ref()
+                        .as_ref()
+                        .get(*span)
+                        .is_some_and(|span| span.link.is_some())
+                });
+            if was_hovered != self.hovered_link.is_some() {
+                shell.request_redraw();
+            }
+        }
+
+        let selection = self.selection;
+        // The leaf the drag is at answers for the whole preview: one message, not one per leaf
+        // (the first leaf for select all, which ends past every leaf)
+        let is_focus = selection.is_some_and(|selection| {
+            selection.focus.leaf == self.leaf || (selection.focus == END && self.leaf == 0)
+        });
+        let select = |action| self.on_select.as_ref().map(|on_select| on_select(action));
+
+        match event {
+            Event::Mouse(mouse::Event::ButtonPressed(mouse::Button::Left)) => {
+                if let Some(position) = cursor.position_in(bounds) {
+                    let spot = Spot {
+                        leaf: self.leaf,
+                        grapheme: state.grapheme_at(position),
+                    };
+                    if let Some(message) = select(Action::Press(spot)) {
+                        shell.publish(message);
+                    }
+                    // Only a link takes the press, as in rich text: the summary of a
+                    // `<details>` still toggles
+                    state.span_pressed = self.hovered_link;
+                    state.pressed = true;
+                    if state.span_pressed.is_some() {
+                        shell.capture_event();
+                    }
+                } else if is_focus {
+                    // Pressed elsewhere: beside the text, or in the editor of the Split view
+                    if let Some(message) = select(Action::Clear) {
+                        shell.publish(message);
+                    }
+                }
+            }
+            Event::Mouse(mouse::Event::CursorMoved { .. }) => {
+                if let Some(selection) = selection.filter(|selection| selection.dragging)
+                    && let Some(position) = cursor.position_in(bounds)
+                {
+                    let spot = Spot {
+                        leaf: self.leaf,
+                        grapheme: state.grapheme_at(position),
+                    };
+                    if spot != selection.focus
+                        && let Some(message) = select(Action::Drag(spot))
+                    {
+                        shell.publish(message);
+                    }
+                }
+            }
+            Event::Mouse(mouse::Event::ButtonReleased(mouse::Button::Left)) => {
+                // The leaf pressed also ends the drag: a quick click may release before the
+                // view shows the new selection
+                let pressed = std::mem::take(&mut state.pressed);
+                if (pressed || is_focus && selection.is_some_and(|selection| selection.dragging))
+                    && let Some(message) = select(Action::Release)
+                {
+                    shell.publish(message);
+                }
+                // A click without a drag follows the link
+                if let Some(span) = state.span_pressed.take()
+                    && Some(span) == self.hovered_link
+                    && selection.is_none_or(|selection| selection.is_empty())
+                    && let Some(on_link_click) = &self.on_link_click
+                    && let Some(link) = self
+                        .spans
+                        .as_ref()
+                        .as_ref()
+                        .get(span)
+                        .and_then(|span| span.link.clone())
+                {
+                    shell.publish(on_link_click(link));
+                }
+            }
+            Event::Keyboard(keyboard::Event::KeyPressed {
+                key: keyboard::Key::Named(keyboard::key::Named::Escape),
+                ..
+            }) => {
+                if is_focus
+                    && selection.is_some_and(|selection| !selection.is_empty())
+                    && let Some(message) = select(Action::Clear)
+                {
+                    shell.publish(message);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn mouse_interaction(
+        &self,
+        _tree: &Tree,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        _viewport: &Rectangle,
+        _renderer: &Renderer,
+    ) -> mouse::Interaction {
+        if self.hovered_link.is_some() {
+            mouse::Interaction::Pointer
+        } else if self.on_select.is_some() && cursor.is_over(layout.bounds()) {
+            mouse::Interaction::Text
+        } else {
+            mouse::Interaction::None
+        }
+    }
+}
+
+impl<'a, Link, Message, Theme, Renderer> From<SelectableRich<'a, Link, Message, Theme, Renderer>>
+    for Element<'a, Message, Theme, Renderer>
+where
+    Message: 'a,
+    Link: Clone + 'a,
+    Theme: Catalog + 'a,
+    Renderer: core_text::Renderer + 'a,
+{
+    fn from(text: SelectableRich<'a, Link, Message, Theme, Renderer>) -> Self {
+        Element::new(text)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    // Behaviours covered:
+    // - hard breaks split a leaf into lines, as the paragraph draws it
+    // - copying one leaf, part of a leaf, and across paragraph, list, code lines and table cells
+    // - a drag upwards copies the same as one downwards
+    // - an empty selection copies nothing
+    // - select all spans every leaf, and copies nothing from an empty document
+    use super::*;
+
+    fn leaf(text: &str, joint: Joint) -> Leaf {
+        Leaf {
+            text: text.to_string(),
+            joint,
+        }
+    }
+
+    fn selection(anchor: (usize, usize), focus: (usize, usize)) -> Selection {
+        Selection {
+            anchor: Spot {
+                leaf: anchor.0,
+                grapheme: anchor.1,
+            },
+            focus: Spot {
+                leaf: focus.0,
+                grapheme: focus.1,
+            },
+            dragging: false,
+        }
+    }
+
+    #[test]
+    fn hard_breaks_start_lines() {
+        assert_eq!(
+            line_ranges("ab\ncde\n").collect::<Vec<_>>(),
+            [0..2, 3..6, 7..7]
+        );
+        assert_eq!(line_ranges("").collect::<Vec<_>>(), [0..0]);
+    }
+
+    #[test]
+    fn copies_part_of_one_leaf() {
+        let leaves = [leaf("The quick fox", Joint::Paragraph)];
+        assert_eq!(copied_text(&leaves, &selection((0, 4), (0, 9))), "quick");
+    }
+
+    #[test]
+    fn copies_from_a_paragraph_into_a_list() {
+        let leaves = [
+            leaf("Intro text", Joint::Paragraph),
+            leaf("first item", Joint::Paragraph),
+            leaf("second item", Joint::Line),
+        ];
+        assert_eq!(
+            copied_text(&leaves, &selection((0, 6), (2, 6))),
+            "text\n\nfirst item\nsecond"
+        );
+    }
+
+    #[test]
+    fn copies_code_lines_with_newlines() {
+        let leaves = [
+            leaf("fn main() {", Joint::Paragraph),
+            leaf("    run();", Joint::Line),
+            leaf("}", Joint::Line),
+        ];
+        assert_eq!(
+            copied_text(&leaves, &selection((0, 0), (2, 1))),
+            "fn main() {\n    run();\n}"
+        );
+    }
+
+    #[test]
+    fn copies_table_rows_tab_separated() {
+        let leaves = [
+            leaf("Name", Joint::Paragraph),
+            leaf("Size", Joint::Tab),
+            leaf("apple", Joint::Line),
+            leaf("3", Joint::Tab),
+        ];
+        assert_eq!(
+            copied_text(&leaves, &selection((0, 0), (3, 1))),
+            "Name\tSize\napple\t3"
+        );
+    }
+
+    #[test]
+    fn a_drag_upwards_copies_the_same() {
+        let leaves = [leaf("one", Joint::Paragraph), leaf("two", Joint::Paragraph)];
+        assert_eq!(
+            copied_text(&leaves, &selection((1, 2), (0, 1))),
+            copied_text(&leaves, &selection((0, 1), (1, 2)))
+        );
+        assert_eq!(copied_text(&leaves, &selection((1, 2), (0, 1))), "ne\n\ntw");
+    }
+
+    #[test]
+    fn an_empty_selection_copies_nothing() {
+        let leaves = [leaf("one", Joint::Paragraph)];
+        assert_eq!(copied_text(&leaves, &selection((0, 2), (0, 2))), "");
+        assert_eq!(selection((0, 2), (0, 2)).in_leaf(0), None);
+    }
+
+    #[test]
+    fn select_all_spans_every_leaf() {
+        let leaves = [
+            leaf("Title", Joint::Paragraph),
+            leaf("body ✓", Joint::Paragraph),
+        ];
+        let all = select_all();
+        assert_eq!(copied_text(&leaves, &all), "Title\n\nbody ✓");
+        assert_eq!(all.in_leaf(1), Some((0, usize::MAX)));
+        assert_eq!(copied_text(&[], &all), "");
+    }
+}

+    #[test]
+    fn column_block_across_fold_unfolds_it() {
+        let mut editor = column_select::tests::editor("a {\n  b\n  c\n}\nz\n");
+        let hidden = |editor: &ViEditor<'static, 'static>| {
+            editor.with_buffer(|buffer| {
+                buffer
+                    .lines
+                    .iter()
+                    .filter(|l| folding::is_hidden(l))
+                    .count()
+            })
+        };
+        editor.with_buffer_mut(|buffer| folding::fold(buffer, 0, folding::FoldKind::Brackets));
+        assert_eq!(hidden(&editor), 2);
+        // Alt+Shift+Down from the header reaches a hidden line: the fold opens
+        editor.set_cursor(Cursor::new(0, 0));
+        let column = Mutex::new(None);
+        let down = press(
+            Key::Named(Named::ArrowDown),
+            Modifiers::ALT | Modifiers::SHIFT,
+            None,
+        );
+        assert!(column_key(&column, &mut editor, &down));
+        assert_eq!(hidden(&editor), 0);
+        // Typing then edits only the lines the block shows
+        let x = press(Key::Character("x".into()), Modifiers::empty(), Some("x"));
+        assert!(column_key(&column, &mut editor, &x));
+        assert_eq!(editor_text(&editor), "xa {\nx  b\n  c\n}\nz\n");
+
+        // An Alt+drag from the header to the line below the fold opens it too
+        let mut editor = crate::folding::tests::editor("a {\n  b\n  c\n}\nz\n", "rs");
+        editor.with_buffer_mut(|buffer| folding::fold(buffer, 0, folding::FoldKind::Brackets));
+        crate::folding::tests::shape(&mut editor);
+        let column = Mutex::new(None);
+        column_press(&column, &mut editor, 1.0, 5.0, false);
+        // Right below the header row sits the closing line 3
+        column_press(&column, &mut editor, 1.0, 25.0, true);
+        assert_eq!(column.lock().unwrap().map(|block| block.bottom()), Some(3));
+        assert_eq!(hidden(&editor), 0);
+    }
+

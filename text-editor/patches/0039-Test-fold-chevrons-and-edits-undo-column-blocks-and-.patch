+    fn hidden(editor: &ViEditor<'static, 'static>) -> Vec<usize> {
+        editor.with_buffer(|buffer| {
+            (0..buffer.lines.len())
+                .filter(|&i| is_hidden(&buffer.lines[i]))
+                .collect()
+        })
+    }
+
+    /// An action as the text box runs it without vim bindings, then the reconcile after it.
+    fn act(editor: &mut ViEditor<'static, 'static>, action: cosmic_text::Action) {
+        editor.set_passthrough(true);
+        let mut font_system = font_system().lock().unwrap();
+        editor.action(&mut font_system, action);
+        let line = editor.cursor().line;
+        editor.with_buffer_mut(|buffer| reconcile(buffer, FoldKind::Brackets, line));
+    }

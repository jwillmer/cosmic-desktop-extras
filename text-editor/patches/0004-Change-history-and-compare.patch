+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Compare with saved: a read-only tab with the diff between the file on disk and the unsaved
+//! text of an editor tab, rendered like a git diff (removed lines red, added green, with
+//! context). Unlike the gutter marks, it shows the deleted text.
+//!
+//! The diff is a snapshot taken when the tab opens; opening it again for the same editor tab
+//! refreshes and focuses the existing compare tab. Session restore skips it like a git diff.
+//!
+//! Compare with... compares two open tabs the same way: "a.md ↔ b.md", from the text of the
+//! first to the text of the second, unsaved changes included. With two views, "Compare the two
+//! views" compares the tabs they show.
+
+use cosmic::{app::Task, widget::segmented_button};
+use similar::{Algorithm, ChangeTag, DiffTag, capture_diff_slices_deadline, group_diff_ops};
+use std::{
+    fs,
+    path::{Path, PathBuf},
+    time::{Duration, Instant},
+};
+
+use crate::{
+    App, Message, fl,
+    git::{GitDiff, GitDiffHunk, GitDiffLine},
+    tab::{GitDiffTab, Tab, editor_text},
+};
+
+/// Unchanged lines shown around each change.
+const CONTEXT_LINES: usize = 3;
+/// A diff that takes longer falls back to a coarser result instead of blocking.
+const DIFF_DEADLINE: Duration = Duration::from_millis(500);
+
+fn lines(text: &str) -> Vec<&str> {
+    // Same count as the editor's buffer lines: "a\n" is two lines, the second empty. Empty text
+    // has no lines, so an untitled tab shows only added lines
+    if text.is_empty() {
+        return Vec::new();
+    }
+    text.split('\n')
+        .map(|line| line.strip_suffix('\r').unwrap_or(line))
+        .collect()
+}
+
+/// The text to compare against: the file on disk, or empty for an untitled or unreadable file.
+pub fn saved_text(path_opt: Option<&Path>) -> String {
+    path_opt
+        .and_then(|path| match fs::read_to_string(path) {
+            Ok(text) => Some(text),
+            Err(err) => {
+                log::warn!("failed to read {:?} to compare with: {}", path, err);
+                None
+            }
+        })
+        .unwrap_or_default()
+}
+
+/// The diff from `saved` to `current` as git diff hunks, or `None` when no line differs.
+pub fn compare(path: PathBuf, saved: &str, current: &str) -> Option<GitDiff> {
+    let (old, new) = (lines(saved), lines(current));
+    let deadline = Instant::now() + DIFF_DEADLINE;
+    let ops = capture_diff_slices_deadline(Algorithm::Myers, &old, &new, Some(deadline));
+    let mut hunks = Vec::new();
+    for group in group_diff_ops(ops, CONTEXT_LINES) {
+        if group.iter().all(|op| op.tag() == DiffTag::Equal) {
+            continue;
+        }
+        let (Some(first), Some(last)) = (group.first(), group.last()) else {
+            continue;
+        };
+        let old_range = first.old_range().start..last.old_range().end;
+        let new_range = first.new_range().start..last.new_range().end;
+        let mut diff_lines = Vec::new();
+        for op in &group {
+            for change in op.iter_changes(&old, &new) {
+                let text = change.value().to_string();
+                let old_line = change.old_index().map(|i| i as u64 + 1);
+                let new_line = change.new_index().map(|i| i as u64 + 1);
+                diff_lines.push(match (change.tag(), old_line, new_line) {
+                    (ChangeTag::Equal, Some(old_line), Some(new_line)) => GitDiffLine::Context {
+                        old_line,
+                        new_line,
+                        text,
+                    },
+                    (ChangeTag::Delete, Some(old_line), _) => {
+                        GitDiffLine::Deleted { old_line, text }
+                    }
+                    (_, _, Some(new_line)) => GitDiffLine::Added { new_line, text },
+                    _ => continue,
+                });
+            }
+        }
+        hunks.push(GitDiffHunk {
+            old_range: patch::Range {
+                start: old_range.start as u64 + 1,
+                count: old_range.len() as u64,
+            },
+            new_range: patch::Range {
+                start: new_range.start as u64 + 1,
+                count: new_range.len() as u64,
+            },
+            lines: diff_lines,
+        });
+    }
+    if hunks.is_empty() {
+        return None;
+    }
+    Some(GitDiff {
+        path,
+        staged: false,
+        hunks,
+    })
+}
+
+/// The line above each hunk, as git prints it, so separate hunks do not run together:
+/// `@@ -old_start,old_count +new_start,new_count @@`.
+pub fn hunk_header(hunk: &GitDiffHunk) -> String {
+    format!(
+        "@@ -{},{} +{},{} @@",
+        hunk.old_range.start, hunk.old_range.count, hunk.new_range.start, hunk.new_range.count
+    )
+}
+
+/// The compare tab opened for the editor tab `source`, if any.
+pub fn find_compare_tab(
+    model: &segmented_button::SingleSelectModel,
+    source: segmented_button::Entity,
+) -> Option<segmented_button::Entity> {
+    model.iter().find(|entity| {
+        matches!(
+            model.data::<Tab>(*entity),
+            Some(Tab::GitDiff(GitDiffTab { compare_of: Some(of), .. })) if *of == source
+        )
+    })
+}
+
+/// The compare tab of two editor tabs, from the text of `left` to the text of `right` (unsaved
+/// text included). `None` when one is not an editor tab or no line differs.
+pub fn compare_tabs_diff(
+    model: &segmented_button::SingleSelectModel,
+    left: segmented_button::Entity,
+    right: segmented_button::Entity,
+) -> Option<GitDiffTab> {
+    let (Some(Tab::Editor(a)), Some(Tab::Editor(b))) =
+        (model.data::<Tab>(left), model.data::<Tab>(right))
+    else {
+        return None;
+    };
+    let text_a = editor_text(&a.editor.lock().unwrap());
+    let text_b = editor_text(&b.editor.lock().unwrap());
+    let path = b.path_opt.clone().unwrap_or_default();
+    Some(GitDiffTab {
+        title: fl!("compare-tabs-title", left = a.title(), right = b.title()),
+        diff: compare(path, &text_a, &text_b)?,
+        compare_of: None,
+    })
+}
+
+/// The editor tabs another tab can be compared with: position in the tab bar and title.
+pub fn compare_targets(
+    model: &segmented_button::SingleSelectModel,
+    source: segmented_button::Entity,
+) -> Vec<(usize, String)> {
+    model
+        .iter()
+        .enumerate()
+        .filter(|(_, entity)| *entity != source)
+        .filter_map(|(pos, entity)| match model.data::<Tab>(entity) {
+            Some(Tab::Editor(tab)) => Some((pos, tab.title())),
+            _ => None,
+        })
+        .collect()
+}
+
+impl App {
+    /// Compare the editor tab `left` (or the active one) with the tab at position `right`; with
+    /// `None`, the tabs shown by the two views. Refreshes and focuses an open compare tab of the
+    /// same two names. Does nothing when no line differs.
+    pub fn compare_tabs(
+        &mut self,
+        left: Option<segmented_button::Entity>,
+        right: Option<usize>,
+    ) -> Task<Message> {
+        let (left, right) = match right {
+            Some(pos) => (
+                left.unwrap_or_else(|| self.tab_model.active()),
+                self.tab_model.iter().nth(pos),
+            ),
+            None => match &self.split {
+                Some(split) => match (
+                    split.shown(crate::views::Side::Left),
+                    split.shown(crate::views::Side::Right),
+                ) {
+                    (Some(left), right) => (left, right),
+                    _ => return Task::none(),
+                },
+                None => return Task::none(),
+            },
+        };
+        let Some(right) = right else {
+            return Task::none();
+        };
+        let Some(compare_tab) = compare_tabs_diff(&self.tab_model, left, right) else {
+            log::info!("compare: the two tabs have the same text");
+            return Task::none();
+        };
+        let title = compare_tab.title.clone();
+        let existing = self.tab_model.iter().find(|entity| {
+            matches!(
+                self.tab_model.data::<Tab>(*entity),
+                Some(Tab::GitDiff(GitDiffTab { compare_of: None, title: t, .. })) if *t == title
+            )
+        });
+        match existing {
+            Some(entity) => {
+                self.tab_model
+                    .data_set::<Tab>(entity, Tab::GitDiff(compare_tab));
+                self.tab_model.activate(entity);
+            }
+            None => {
+                let icon = self.tab_model.icon(left).cloned();
+                let mut item = self
+                    .tab_model
+                    .insert()
+                    .text(title)
+                    .data::<Tab>(Tab::GitDiff(compare_tab))
+                    .closable();
+                if let Some(icon) = icon {
+                    item = item.icon(icon);
+                }
+                item.activate();
+            }
+        }
+        self.update_tab()
+    }
+
+    /// Open (or refresh and focus) the compare tab of the editor tab `entity_opt` or the active
+    /// one. Does nothing when the tab has no unsaved changes.
+    pub fn compare_with_saved(
+        &mut self,
+        entity_opt: Option<segmented_button::Entity>,
+    ) -> Task<Message> {
+        let source = entity_opt.unwrap_or_else(|| self.tab_model.active());
+        let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(source) else {
+            return Task::none();
+        };
+        if !tab.changed() {
+            return Task::none();
+        }
+        let current = editor_text(&tab.editor.lock().unwrap());
+        let saved = saved_text(tab.path_opt.as_deref());
+        let path = tab.path_opt.clone().unwrap_or_default();
+        let title = fl!("compare-title", name = tab.title());
+        let icon = tab.icon(16);
+        let Some(diff) = compare(path, &saved, &current) else {
+            return Task::none();
+        };
+        let compare_tab = Tab::GitDiff(GitDiffTab {
+            title: title.clone(),
+            diff,
+            compare_of: Some(source),
+        });
+        match find_compare_tab(&self.tab_model, source) {
+            Some(entity) => {
+                self.tab_model.data_set::<Tab>(entity, compare_tab);
+                self.tab_model.text_set(entity, title);
+                self.tab_model.activate(entity);
+            }
+            None => {
+                self.tab_model
+                    .insert()
+                    .text(title)
+                    .icon(icon)
+                    .data::<Tab>(compare_tab)
+                    .closable()
+                    .activate();
+            }
+        }
+        self.update_tab()
+    }
+}
+
+/// Behaviours under test:
+/// - the compare view lists removed lines and added lines, with context around them
+/// - an untitled tab compares against empty text: every line is added
+/// - a tab whose text equals the saved file has nothing to compare
+/// - opening compare again for the same tab finds and reuses its compare tab
+/// - session restore never saves a compare tab as a document (see session.rs)
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cosmic::widget::segmented_button::Entity;
+    use cosmic_text::Edit;
+
+    fn rendered(diff: &GitDiff) -> Vec<String> {
+        diff.hunks
+            .iter()
+            .flat_map(|hunk| hunk.lines.iter())
+            .map(|line| match line {
+                GitDiffLine::Context { text, .. } => format!("  {text}"),
+                GitDiffLine::Added { text, .. } => format!("+ {text}"),
+                GitDiffLine::Deleted { text, .. } => format!("- {text}"),
+            })
+            .collect()
+    }
+
+    #[test]
+    fn compare_shows_removed_and_added_lines() {
+        let saved = "one\ntwo\nthree\nfour\n";
+        let current = "one\nTWO\nthree\n";
+        let diff = compare(PathBuf::from("notes.md"), saved, current).unwrap();
+        assert_eq!(
+            rendered(&diff),
+            ["  one", "- two", "+ TWO", "  three", "- four", "  "]
+        );
+        let hunk = &diff.hunks[0];
+        assert_eq!((hunk.old_range.start, hunk.old_range.count), (1, 5));
+        assert_eq!((hunk.new_range.start, hunk.new_range.count), (1, 4));
+        assert!(hunk.lines.contains(&GitDiffLine::Deleted {
+            old_line: 4,
+            text: "four".into()
+        }));
+        assert!(hunk.lines.contains(&GitDiffLine::Added {
+            new_line: 2,
+            text: "TWO".into()
+        }));
+    }
+
+    #[test]
+    fn far_apart_changes_get_separate_hunks_with_context() {
+        let saved: String = (1..=20).map(|i| format!("{i}\n")).collect();
+        let current: String = (1..=20)
+            .map(|i| match i {
+                2 => "two\n".to_string(),
+                19 => "nineteen\n".to_string(),
+                _ => format!("{i}\n"),
+            })
+            .collect();
+        let diff = compare(PathBuf::new(), &saved, &current).unwrap();
+        assert_eq!(diff.hunks.len(), 2);
+        // Each hunk starts with its own header line, as in git
+        assert_eq!(hunk_header(&diff.hunks[0]), "@@ -1,5 +1,5 @@");
+        assert_eq!(hunk_header(&diff.hunks[1]), "@@ -16,6 +16,6 @@");
+        assert!(rendered(&diff).contains(&"  5".to_string()));
+        assert!(!rendered(&diff).contains(&"  10".to_string()));
+    }
+
+    #[test]
+    fn crlf_line_endings_are_not_shown() {
+        let diff = compare(PathBuf::new(), "a\r\nb\r\n", "a\r\nc\r\n").unwrap();
+        assert_eq!(rendered(&diff), ["  a", "- b", "+ c", "  "]);
+    }
+
+    #[test]
+    fn untitled_compares_against_empty() {
+        assert_eq!(saved_text(None), "");
+        let diff = compare(PathBuf::new(), &saved_text(None), "hello\nworld").unwrap();
+        assert_eq!(rendered(&diff), ["+ hello", "+ world"]);
+    }
+
+    #[test]
+    fn unchanged_tab_has_nothing_to_compare() {
+        assert_eq!(
+            compare(PathBuf::new(), "same\ntext\n", "same\ntext\n"),
+            None
+        );
+        assert_eq!(compare(PathBuf::new(), "", ""), None);
+    }
+
+    fn insert(model: &mut segmented_button::SingleSelectModel, tab: Option<Tab>) -> Entity {
+        let mut id = None;
+        let item = model.insert().with_id(|entity| id = Some(entity));
+        if let Some(tab) = tab {
+            item.data::<Tab>(tab);
+        }
+        id.unwrap()
+    }
+
+    fn diff_tab(compare_of: Option<Entity>) -> Option<Tab> {
+        Some(Tab::GitDiff(GitDiffTab {
+            title: "notes.md".into(),
+            diff: compare(PathBuf::new(), "a", "b").unwrap(),
+            compare_of,
+        }))
+    }
+
+    fn editor(text: &str, path: &str) -> Option<Tab> {
+        crate::SYNTAX_SYSTEM.get_or_init(cosmic_text::SyntaxSystem::new);
+        let mut config = crate::Config::default();
+        let theme = crate::SYNTAX_SYSTEM
+            .get()
+            .unwrap()
+            .theme_set
+            .themes
+            .keys()
+            .next()
+            .unwrap();
+        config.syntax_theme_dark = theme.clone();
+        config.syntax_theme_light = theme.clone();
+        let mut tab = crate::tab::EditorTab::new(&config);
+        tab.path_opt = Some(PathBuf::from(path));
+        tab.editor.lock().unwrap().insert_string(text, None);
+        Some(Tab::Editor(tab))
+    }
+
+    #[test]
+    fn compare_two_tabs_shows_differences() {
+        let mut model = segmented_button::SingleSelectModel::builder().build();
+        let a = insert(&mut model, editor("one\ntwo\nthree", "/srv/demo/a.md"));
+        let b = insert(&mut model, editor("one\nTWO\nthree", "/srv/demo/b.md"));
+        let diff_tab = insert(&mut model, diff_tab(None));
+        let tab = compare_tabs_diff(&model, a, b).unwrap();
+        // Fluent may wrap the names in isolation marks
+        let title = tab.title.replace(['\u{2068}', '\u{2069}'], "");
+        assert_eq!(title, "a.md \u{2194} b.md");
+        assert_eq!(tab.compare_of, None);
+        assert_eq!(rendered(&tab.diff), ["  one", "- two", "+ TWO", "  three"]);
+        // Same text, or a diff tab on either side: nothing to compare
+        assert!(compare_tabs_diff(&model, a, a).is_none());
+        assert!(compare_tabs_diff(&model, a, diff_tab).is_none());
+        // The submenu lists the other editor tabs only
+        assert_eq!(compare_targets(&model, a), [(1, "b.md".to_string())]);
+    }
+
+    #[test]
+    fn compare_uses_unsaved_text() {
+        let dir = std::env::temp_dir().join(format!("compare-unsaved-{}", std::process::id()));
+        fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("saved.txt");
+        fs::write(&path, "same\n").unwrap();
+        let mut model = segmented_button::SingleSelectModel::builder().build();
+        let a = insert(&mut model, editor("same\n", "/srv/demo/a.txt"));
+        let b = insert(&mut model, editor("", "/srv/demo/b.txt"));
+        if let Some(Tab::Editor(tab)) = model.data_mut::<Tab>(b) {
+            tab.open(path.clone());
+            // Typed but not saved: the file on disk still says "same"
+            tab.editor.lock().unwrap().insert_string("edited ", None);
+        }
+        assert_eq!(fs::read_to_string(&path).unwrap(), "same\n");
+        let tab = compare_tabs_diff(&model, a, b).unwrap();
+        assert!(rendered(&tab.diff).contains(&"+ edited same".to_string()));
+        fs::remove_dir_all(&dir).ok();
+    }
+
+    #[test]
+    fn reopening_compare_focuses_existing_tab() {
+        let mut model = segmented_button::SingleSelectModel::builder().build();
+        let source = insert(&mut model, None);
+        let other = insert(&mut model, None);
+        // A git diff of the same file is not its compare tab
+        insert(&mut model, diff_tab(None));
+        assert_eq!(find_compare_tab(&model, source), None);
+        let compare_tab = insert(&mut model, diff_tab(Some(source)));
+        assert_eq!(find_compare_tab(&model, source), Some(compare_tab));
+        assert_eq!(find_compare_tab(&model, other), None);
+    }
+}

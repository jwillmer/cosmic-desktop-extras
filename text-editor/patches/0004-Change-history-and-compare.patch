+    fn opened_file_keeps_no_copy_until_edited() {
+        let file = TempFile::new("lazy", FILE);
+        let history = opened_file(&file);
+        assert!(history.base.is_empty(), "no copy of the text");
+        assert!(history.untouched(false), "nothing to diff while not edited");
+        assert!(!history.untouched(true));
+    }

+    /// A file in the temp dir with `text`, removed on drop.
+    struct TempFile(std::path::PathBuf);
+
+    impl TempFile {
+        fn new(name: &str, text: &str) -> Self {
+            let path = std::env::temp_dir()
+                .join(format!("change-history-{name}-{}.txt", std::process::id()));
+            fs::write(&path, text).unwrap();
+            Self(path)
+        }
+    }
+
+    impl Drop for TempFile {
+        fn drop(&mut self) {
+            let _ = fs::remove_file(&self.0);
+        }
+    }
+
+    /// `EditorTab::open`: the history of a file opened from disk, its base not read yet.
+    fn opened_file(file: &TempFile) -> History {
+        let mut history = History::default();
+        history.opened_file(&file.0, Stat::of_path(&file.0), || panic!("checkable"));
+        history
+    }
+

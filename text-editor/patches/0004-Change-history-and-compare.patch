+    #[test]
+    fn few_edits_in_a_huge_file_stay_exact() {
+        // About 10 MB: the diff used to miss its deadline here and mark everything below the
+        // first edit. The time limit is generous so a slow machine cannot fail the test; how
+        // long it takes is measured by `diff_time_of_a_large_file`
+        let base: Vec<String> = (0..200_000)
+            .map(|i| format!("line {i} with some text to make it about fifty bytes long\n"))
+            .collect();
+        let mut saved = base.clone();
+        saved[100_000] = "saved change\n".into();
+        let mut current = saved.clone();
+        current[10] = "edited near the start\n".into();
+        current[199_990] = "edited near the end\n".into();
+        current.insert(150_000, "inserted line\n".into());
+        current.remove(50_000);
+        let (base, saved, current) = (base.concat(), saved.concat(), current.concat());
+
+        let marks = changes_within(&base, &saved, &current, Duration::from_secs(30)).0;
+        let marked = |mark: Mark| {
+            marks
+                .iter()
+                .enumerate()
+                .filter(|(_, m)| m.line == mark)
+                .map(|(i, _)| i)
+                .collect::<Vec<_>>()
+        };
+        // Line numbers of `current`: the deletion at 50,000 shifts the lines after it up by one,
+        // the insert at 150,000 down again
+        assert_eq!(marked(Mark::Unsaved), [10, 149_999, 199_990]);
+        assert_eq!(marked(Mark::Saved), [99_999]);
+        let deleted: Vec<usize> = marks
+            .iter()
+            .enumerate()
+            .filter(|(_, m)| m.deleted_above != Mark::None)
+            .map(|(i, _)| i)
+            .collect();
+        assert_eq!(deleted, [50_000]);
+    }

+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Change history: a thin bar in the gutter marks the lines changed since the file was opened,
+//! like Notepad++. Orange: changed and not saved yet. Green: changed and saved in this session.
+//!
+//! Marks come from line diffs, not from tracking edits, so undoing back to the saved text clears
+//! them: `base` is the text when the tab was opened (or reloaded from disk), `saved` the text at
+//! the last save, `current` the buffer. The diff runs off the UI thread, a short pause after the
+//! last edit, and only for the visible tab.
+//!
+//! Inside an orange line the inserted or changed text itself gets a light orange background: a
+//! word diff against the saved line it replaces, computed in the same pass. Whole new lines are
+//! tinted whole; deleted text is not shown here.
+//!
+//! A new document has no marks until its first save, since every line of it would be new; from
+//! then on it counts changes against the saved text, like an opened file.
+//!
+//! An opened file keeps no copy of its text until it is first edited: the base is read from the
+//! file then, off the UI thread, if the file is still the one opened (same modification time,
+//! length and inode). A file that changed on disk in between has no marks until the next save.
+
+use cosmic::{
+    action,
+    app::Task,
+    iced::{Subscription, advanced::input_method, event, keyboard, mouse},
+    widget::{self, segmented_button::Entity},
+};
+use cosmic_text::Edit;
+use similar::{Algorithm, DiffOp, DiffTag, capture_diff_slices_deadline};
+use std::{
+    fs,
+    hash::{DefaultHasher, Hash, Hasher},
+    ops::Range,
+    path::Path,
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+use crate::{
+    App, Message as AppMessage,
+    config::Config,
+    disk_change::Stat,
+    fl,
+    tab::{EditorTab, Tab, editor_text},
+};
+
+const DIFF_DELAY: Duration = Duration::from_millis(200);
+const DIFF_DELAY_LARGE: Duration = Duration::from_millis(500);
+/// Files above this size (bytes) wait longer after an edit before the diff runs.
+const LARGE_FILE: usize = 1024 * 1024;
+/// Each of the two diffs that takes longer falls back to a coarser result instead of blocking
+/// (large texts with many edits get up to one and a half times this, see `line_diff`).
+const DIFF_DEADLINE: Duration = Duration::from_millis(50);
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub enum Mark {
+    #[default]
+    None,
+    /// Changed and saved during this session (green).
+    Saved,
+    /// Changed and not saved yet (orange).
+    Unsaved,
+}
+
+/// The marks of one line of the current text.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct LineMark {
+    /// The line itself was inserted or changed.
+    pub line: Mark,
+    /// Lines were deleted just above this one (after the last line: on the last line).
+    pub deleted_above: Mark,
+}
+
+/// The unsaved inserted or changed text of each line of the current text, as byte ranges of the
+/// line. Only tinted lines are stored, in line order.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct Tints(Vec<(usize, Vec<Range<usize>>)>);
+
+impl Tints {
+    /// The ranges to tint in line `line`, in order and not overlapping.
+    pub fn line(&self, line: usize) -> &[Range<usize>] {
+        match self.0.binary_search_by_key(&line, |(i, _)| *i) {
+            Ok(i) => &self.0[i].1,
+            Err(_) => &[],
+        }
+    }
+}
+
+fn lines(text: &str) -> Vec<&str> {
+    // Same count as the editor's buffer lines: "a\n" is two lines, the second empty
+    text.split('\n').collect()
+}
+
+/// Splits a line into words (letters, digits and `_`), runs of whitespace and single other
+/// chars, as byte ranges: the units the inline diff compares.
+fn words(line: &str) -> Vec<Range<usize>> {
+    #[derive(PartialEq)]
+    enum Kind {
+        Word,
+        Space,
+        Other,
+    }
+    let kind = |c: char| {
+        if c.is_alphanumeric() || c == '_' {
+            Kind::Word
+        } else if c.is_whitespace() {
+            Kind::Space
+        } else {
+            Kind::Other
+        }
+    };
+    let mut words: Vec<Range<usize>> = Vec::new();
+    let mut last = None;
+    for (i, c) in line.char_indices() {
+        let k = kind(c);
+        let end = i + c.len_utf8();
+        match words.last_mut() {
+            Some(word) if k != Kind::Other && last.as_ref() == Some(&k) => word.end = end,
+            _ => words.push(i..end),
+        }
+        last = Some(k);
+    }
+    words
+}
+
+/// The byte ranges of `new` inserted or changed against `old`, by words; adjacent ranges are
+/// joined.
+fn inline_diff(old: &str, new: &str, deadline: Instant) -> Vec<Range<usize>> {
+    let old_words = words(old);
+    let new_words = words(new);
+    let old_strs: Vec<&str> = old_words.iter().map(|r| &old[r.clone()]).collect();
+    let new_strs: Vec<&str> = new_words.iter().map(|r| &new[r.clone()]).collect();
+    let mut ranges: Vec<Range<usize>> = Vec::new();
+    for op in capture_diff_slices_deadline(Algorithm::Myers, &old_strs, &new_strs, Some(deadline)) {
+        let (tag, _, new_range) = op.as_tag_tuple();
+        if !matches!(tag, DiffTag::Insert | DiffTag::Replace) || new_range.is_empty() {
+            continue;
+        }
+        let range = new_words[new_range.start].start..new_words[new_range.end - 1].end;
+        match ranges.last_mut() {
+            Some(last) if last.end == range.start => last.end = range.end,
+            _ => ranges.push(range),
+        }
+    }
+    ranges
+}
+
+/// Blocks of more lines than this pair their lines by position only.
+const PAIR_LIMIT: usize = 16;
+
+/// The changed text of each line of a replaced block `new_range`, against the old line it
+/// replaces. Blocks of the same length pair by position. Otherwise each new line, in order, takes
+/// the most similar old line after the one taken before (lines added or removed inside the
+/// block would shift the positions); a line nothing is similar to counts as new: tinted whole.
+fn pair_lines(
+    old: &[&str],
+    new: &[&str],
+    old_range: Range<usize>,
+    new_range: Range<usize>,
+    deadline: Instant,
+) -> Vec<(usize, Vec<Range<usize>>)> {
+    let whole = |text: &str| {
+        vec![Range {
+            start: 0,
+            end: text.len(),
+        }]
+    };
+    if old_range.len() == new_range.len()
+        || old_range.len() > PAIR_LIMIT
+        || new_range.len() > PAIR_LIMIT
+    {
+        return new_range
+            .enumerate()
+            .map(|(k, new_i)| {
+                let ranges = match old_range.clone().nth(k) {
+                    Some(old_i) => inline_diff(old[old_i], new[new_i], deadline),
+                    None => whole(new[new_i]),
+                };
+                (new_i, ranges)
+            })
+            .collect();
+    }
+    let mut next = old_range.start;
+    new_range
+        .map(|new_i| {
+            let text = new[new_i];
+            // Letters and digits kept: a shared space or comma alone does not make lines similar
+            let unchanged = |ranges: &[Range<usize>]| {
+                let mut kept = 0;
+                let mut at = 0;
+                for range in ranges.iter().chain([&(text.len()..text.len())]) {
+                    kept += text[at..range.start]
+                        .chars()
+                        .filter(|c| c.is_alphanumeric())
+                        .count();
+                    at = range.end;
+                }
+                kept
+            };
+            let best = (next..old_range.end)
+                .map(|old_i| (old_i, inline_diff(old[old_i], text, deadline)))
+                .max_by_key(|(old_i, ranges)| (unchanged(ranges), std::cmp::Reverse(*old_i)));
+            match best {
+                Some((old_i, ranges)) if unchanged(&ranges) > 0 => {
+                    next = old_i + 1;
+                    (new_i, ranges)
+                }
+                _ => (new_i, whole(text)),
+            }
+        })
+        .collect()
+}
+
+struct LineDiff {
+    marks: Vec<LineMark>,
+    /// Per line of `new`, the line of `old` it equals, if any.
+    origin: Vec<Option<usize>>,
+    tints: Tints,
+}
+
+/// Line diffs of more lines than this (old and new together) try plain Myers first.
+const PLAIN_MYERS_LINES: usize = 20_000;
+
+/// The line diff of `old` and `new`, coarser if it takes longer than `time`. Myers first files every line by
+/// its text to cope with many edits, which alone took most of the deadline on a 10 MB file:
+/// a few local edits then marked every line below them. Plain Myers costs about lines × edits,
+/// milliseconds for a few edits, so large texts try it first, for half the deadline; if that
+/// runs out, there are many edits and the full Myers gets a whole deadline of its own.
+fn line_diff(old: &[&str], new: &[&str], time: Duration) -> Vec<DiffOp> {
+    if old.len() + new.len() > PLAIN_MYERS_LINES {
+        let half = Instant::now() + time / 2;
+        let ops = capture_diff_slices_deadline(Algorithm::RawMyers, old, new, Some(half));
+        // Done before its deadline: it never cut a corner
+        if Instant::now() < half {
+            return ops;
+        }
+    }
+    let deadline = Instant::now() + time;
+    capture_diff_slices_deadline(Algorithm::Myers, old, new, Some(deadline))
+}
+
+/// Marks every line of `new` inserted or changed against `old` with `mark`, and the line after
+/// each deletion. With `tint`, also finds the changed text in those lines: a changed line is
+/// compared with the old line it replaces (see `pair_lines`), an inserted line is tinted whole.
+/// Past `time` the result gets coarser.
+fn diff(old: &[&str], new: &[&str], mark: Mark, tint: bool, time: Duration) -> LineDiff {
+    let deadline = Instant::now() + time;
+    let mut marks = vec![LineMark::default(); new.len()];
+    let mut origin = vec![None; new.len()];
+    let mut tints = Vec::new();
+    let last = new.len().saturating_sub(1);
+    for op in line_diff(old, new, time) {
+        let (tag, old_range, new_range) = op.as_tag_tuple();
+        match tag {
+            DiffTag::Equal => {
+                for (new_i, old_i) in new_range.zip(old_range) {
+                    origin[new_i] = Some(old_i);
+                }
+            }
+            DiffTag::Delete => {
+                if let Some(line) = marks.get_mut(new_range.start.min(last)) {
+                    line.deleted_above = mark;
+                }
+            }
+            DiffTag::Insert | DiffTag::Replace => {
+                for line in &mut marks[new_range.clone()] {
+                    line.line = mark;
+                }
+                if !tint {
+                    continue;
+                }
+                let pairs = pair_lines(old, new, old_range, new_range, deadline);
+                for (new_i, ranges) in pairs {
+                    if ranges.iter().any(|r| !r.is_empty()) {
+                        tints.push((new_i, ranges));
+                    }
+                }
+            }
+        }
+    }
+    LineDiff {
+        marks,
+        origin,
+        tints: Tints(tints),
+    }
+}
+
+/// The marks of each line of `current`: `Unsaved` where it differs from `saved`, `Saved` where
+/// it equals `saved` but `saved` differs from `base` there. Also the tints of the `Unsaved`
+/// lines: saved changes are not tinted.
+pub fn changes(base: &str, saved: &str, current: &str) -> (Vec<LineMark>, Tints) {
+    changes_within(base, saved, current, DIFF_DEADLINE)
+}
+
+/// `changes`, with each of its two diffs getting coarser past `time`.
+fn changes_within(
+    base: &str,
+    saved: &str,
+    current: &str,
+    time: Duration,
+) -> (Vec<LineMark>, Tints) {
+    let (base, saved, current) = (lines(base), lines(saved), lines(current));
+    let saved_marks = if base == saved {
+        vec![LineMark::default(); saved.len()]
+    } else {
+        diff(&base, &saved, Mark::Saved, false, time).marks
+    };
+    if saved == current {
+        return (saved_marks, Tints::default());
+    }
+    let LineDiff {
+        mut marks,
+        origin,
+        tints,
+    } = diff(&saved, &current, Mark::Unsaved, true, time);
+    for (mark, origin) in marks.iter_mut().zip(origin) {
+        if let Some(saved_mark) = origin.and_then(|i| saved_marks.get(i)) {
+            mark.line = saved_mark.line;
+            if mark.deleted_above == Mark::None {
+                mark.deleted_above = saved_mark.deleted_above;
+            }
+        }
+    }
+    (marks, tints)
+}
+
+#[cfg(test)]
+pub fn line_marks(base: &str, saved: &str, current: &str) -> Vec<LineMark> {
+    changes(base, saved, current).0
+}
+
+/// How long to wait after an edit before diffing a text of `len` bytes.
+pub fn diff_delay(len: usize) -> Duration {
+    if len > LARGE_FILE {
+        DIFF_DELAY_LARGE
+    } else {
+        DIFF_DELAY
+    }
+}
+
+fn text_hash(text: &str) -> u64 {
+    let mut hasher = DefaultHasher::new();
+    text.hash(&mut hasher);
+    hasher.finish()
+}
+
+/// The base of a file opened and not edited yet: the file at `path` as it was opened.
+#[derive(Clone, Debug)]
+struct Unread {
+    path: Arc<Path>,
+    stat: Stat,
+}
+
+impl Unread {
+    /// The text of the file, `None` when it changed since it was opened or cannot be read.
+    fn read(&self) -> Option<Arc<str>> {
+        let text = fs::read_to_string(&self.path)
+            .inspect_err(|err| {
+                log::warn!("change history: failed to read {:?}: {}", self.path, err)
+            })
+            .ok()?;
+        let same =
+            Stat::of_path(&self.path) == Some(self.stat) && text.len() as u64 == self.stat.len();
+        if !same {
+            log::warn!(
+                "change history: {:?} changed on disk before the first edit",
+                self.path
+            );
+        }
+        same.then(|| text.into())
+    }
+}
+
+/// Per tab state: the texts to diff against and the marks of the last diff.
+#[derive(Debug, Default)]
+pub struct History {
+    base: Arc<str>,
+    saved: Arc<str>,
+    /// Set when `base` and `saved` are not read yet: both are the file as it was opened.
+    unread: Option<Unread>,
+    pub marks: Arc<[LineMark]>,
+    pub tints: Arc<Tints>,
+    /// Debounce counter: only the result of the newest scheduled diff is kept.
+    generation: u64,
+    /// Hash of the text the marks belong to, `None` when they are out of date.
+    diffed: Option<u64>,
+    /// Length of the last text seen, to debounce large files longer.
+    len: usize,
+    /// Whether the text came from a file; a new document is not tracked until its first save.
+    tracking: bool,
+}
+
+/// A diff to run off the UI thread.
+pub struct Job {
+    generation: u64,
+    hash: u64,
+    base: Arc<str>,
+    saved: Arc<str>,
+    /// The base to read first, in place of `base` and `saved`.
+    unread: Option<Unread>,
+    current: String,
+}
+
+impl Job {
+    pub fn run(self) -> Diffed {
+        let read = self.unread.as_ref().map(Unread::read);
+        let (base, saved) = match &read {
+            Some(Some(text)) => (text.clone(), text.clone()),
+            Some(None) => (Arc::from(""), Arc::from("")),
+            None => (self.base, self.saved),
+        };
+        let (marks, tints) = match &read {
+            Some(None) => Default::default(),
+            _ => changes(&base, &saved, &self.current),
+        };
+        Diffed {
+            generation: self.generation,
+            hash: self.hash,
+            marks: marks.into(),
+            tints: Arc::new(tints),
+            read,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub struct Diffed {
+    generation: u64,
+    hash: u64,
+    marks: Arc<[LineMark]>,
+    tints: Arc<Tints>,
+    /// The base the job read from the file (`None` inside: it could not).
+    read: Option<Option<Arc<str>>>,
+}
+
+impl History {
+    /// The text was opened or reloaded from disk: no line counts as changed.
+    pub fn opened(&mut self, text: &str) {
+        self.unread = None;
+        self.tracking = true;
+        self.base = text.into();
+        self.saved = self.base.clone();
+        self.marks = Arc::new([]);
+        self.tints = Arc::default();
+        self.diffed = Some(text_hash(text));
+        self.len = text.len();
+        // A diff still running belongs to the old text
+        self.generation = self.generation.wrapping_add(1);
+    }
+
+    /// The file at `path` was opened as it is at `stat`: like `opened`, without copying its
+    /// text, which is read from the file on the first edit. Without a stat (the file changed
+    /// while it loaded) the text is copied now, from `text`.
+    pub fn opened_file(&mut self, path: &Path, stat: Option<Stat>, text: impl FnOnce() -> String) {
+        let Some(stat) = stat else {
+            return self.opened(&text());
+        };
+        self.opened("");
+        self.unread = Some(Unread {
+            path: path.into(),
+            stat,
+        });
+        self.diffed = None;
+        self.len = stat.len() as usize;
+    }
+
+    /// Whether the text is as opened from the file, with no copy kept: no marks, nothing to diff.
+    /// `changed` is whether the editor's text differs from its last save point.
+    pub fn untouched(&self, changed: bool) -> bool {
+        self.unread.is_some() && !changed
+    }
+
+    /// The text is about to be written to its file: read the base not read yet first, as the
+    /// file is about to lose it.
+    /// When it cannot be read, `saved` starts the marks anew, like the first save of a new
+    /// document; a save that fails keeps the history as it is.
+    pub fn writing(&mut self) {
+        if let Some(text) = self.unread.as_ref().and_then(Unread::read) {
+            self.unread = None;
+            self.base = text;
+            self.saved = self.base.clone();
+        }
+    }
+
+    /// The file was read again and holds the opened text still (`stat` now): a base not read
+    /// yet is still the file's.
+    pub fn reread_same(&mut self, stat: Option<Stat>) {
+        if let Some(unread) = &mut self.unread {
+            match stat {
+                Some(stat) => unread.stat = stat,
+                // Not checkable later: no marks rather than wrong ones, until the next save
+                None => {
+                    self.unread = None;
+                    self.tracking = false;
+                }
+            }
+        }
+    }
+
+    /// The base, for a clone of this tab whose base is not read yet (`saved_as_clone`).
+    pub fn base_for_clone(&self) -> Option<Arc<str>> {
+        (self.tracking && self.unread.is_none()).then(|| self.base.clone())
+    }
+
+    /// A clone saved the text to the file: as `saved`, with the clone's base in place of one
+    /// not read yet, as the file holds it no more.
+    pub fn saved_as_clone(&mut self, text: &str, base: Option<Arc<str>>) {
+        if self.unread.is_some()
+            && let Some(base) = base
+        {
+            self.unread = None;
+            self.base = base;
+            self.saved = self.base.clone();
+        }
+        self.saved(text);
+    }
+
+    /// The text was saved: its changed lines turn from unsaved to saved.
+    pub fn saved(&mut self, text: &str) {
+        if self.unread.is_some() {
+            // The file holds the saved text now: the base it held is gone (a clone saved it)
+            self.tracking = false;
+        }
+        if !self.tracking {
+            // First save of a new document: it starts clean, like a file just opened
+            self.opened(text);
+            return;
+        }
+        self.saved = text.into();
+        self.diffed = None;
+        self.generation = self.generation.wrapping_add(1);
+    }
+
+    /// Forget the marks; the next diff computes them again.
+    pub fn clear_marks(&mut self) {
+        self.marks = Arc::new([]);
+        self.tints = Arc::default();
+        self.diffed = None;
+    }
+
+    /// Start a new debounce period; returns its generation and how long to wait.
+    pub fn schedule(&mut self) -> (u64, Duration) {
+        self.generation = self.generation.wrapping_add(1);
+        (self.generation, diff_delay(self.len))
+    }
+
+    /// Whether `generation` is the newest scheduled diff; check before reading the text.
+    pub fn is_newest(&self, generation: u64) -> bool {
+        generation == self.generation
+    }
+
+    /// The diff to run for `current`, `None` when a newer one was scheduled or the marks
+    /// already belong to this text.
+    pub fn job(&mut self, generation: u64, current: String) -> Option<Job> {
+        if !self.tracking || !self.is_newest(generation) {
+            return None;
+        }
+        self.len = current.len();
+        let hash = text_hash(&current);
+        if self.diffed == Some(hash) {
+            return None;
+        }
+        Some(Job {
+            generation,
+            hash,
+            base: self.base.clone(),
+            saved: self.saved.clone(),
+            unread: self.unread.clone(),
+            current,
+        })
+    }
+
+    /// Keep the marks of a finished diff unless a newer one was scheduled since; returns whether
+    /// they were kept.
+    pub fn finish(&mut self, diffed: Diffed) -> bool {
+        if !self.is_newest(diffed.generation) {
+            return false;
+        }
+        match diffed.read {
+            Some(Some(text)) => {
+                self.unread = None;
+                self.base = text;
+                self.saved = self.base.clone();
+            }
+            Some(None) => {
+                // The base is not known: no marks until the next save starts them anew
+                self.unread = None;
+                self.tracking = false;
+            }
+            None => {}
+        }
+        self.diffed = Some(diffed.hash);
+        self.marks = diffed.marks;
+        self.tints = diffed.tints;
+        true
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    Diff(Entity, u64),
+    Diffed(Entity, Diffed),
+    Edited,
+    Enabled(bool),
+    TintEnabled(bool),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::ChangeHistory(message)
+    }
+}
+
+impl EditorTab {
+    /// The marks to draw, `None` when the feature is off.
+    pub fn change_marks(&self, enabled: bool) -> Option<&[LineMark]> {
+        enabled.then_some(&*self.history.marks)
+    }
+
+    /// The changed text to tint, `None` when the feature or the tint is off.
+    pub fn change_tints(&self, config: &Config) -> Option<&Tints> {
+        (config.change_history && config.highlight_changed_text).then_some(&*self.history.tints)
+    }
+}
+
+impl App {
+    /// The text of `entity` may have changed: diff it after a pause, if it is the visible tab.
+    pub fn change_history_changed(&mut self, entity: Entity) -> Task<AppMessage> {
+        if !self.config.change_history || entity != self.tab_model.active() {
+            return Task::none();
+        }
+        let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) else {
+            return Task::none();
+        };
+        let (generation, delay) = tab.history.schedule();
+        Task::perform(tokio::time::sleep(delay), move |()| {
+            action::app(Message::Diff(entity, generation).into())
+        })
+    }
+
+    pub fn update_change_history(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Diff(entity, generation) => {
+                if !self.config.change_history || entity != self.tab_model.active() {
+                    return Task::none();
+                }
+                let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) else {
+                    return Task::none();
+                };
+                // Every key schedules a diff: only the last one reads the text
+                if !tab.history.is_newest(generation) || tab.history.untouched(tab.changed()) {
+                    return Task::none();
+                }
+                let current = editor_text(&tab.editor.lock().unwrap());
+                if let Some(job) = tab.history.job(generation, current) {
+                    return Task::perform(tokio::task::spawn_blocking(|| job.run()), move |res| {
+                        match res {
+                            Ok(diffed) => action::app(Message::Diffed(entity, diffed).into()),
+                            Err(err) => {
+                                log::warn!("change history: diff failed: {}", err);
+                                action::none()
+                            }
+                        }
+                    });
+                }
+            }
+            Message::Diffed(entity, diffed) => {
+                if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity)
+                    && tab.history.finish(diffed)
+                {
+                    // The gutter is drawn with the text: redraw it with the new marks
+                    tab.editor.lock().unwrap().set_redraw(true);
+                }
+            }
+            Message::Edited => return self.change_history_changed(self.tab_model.active()),
+            Message::Enabled(enabled) => {
+                match &self.config_handler {
+                    Some(config_handler) => {
+                        if let Err(err) = self.config.set_change_history(config_handler, enabled) {
+                            log::warn!("failed to save config \"change_history\": {}", err);
+                        }
+                    }
+                    None => self.config.change_history = enabled,
+                }
+                for entity in self.tab_model.iter().collect::<Vec<_>>() {
+                    if let Some(Tab::Editor(tab)) = self.tab_model.data_mut::<Tab>(entity) {
+                        // Marks of the text before the feature was off would be misplaced
+                        tab.history.clear_marks();
+                        tab.editor.lock().unwrap().set_redraw(true);
+                    }
+                }
+                return self.change_history_changed(self.tab_model.active());
+            }
+            Message::TintEnabled(enabled) => match &self.config_handler {
+                Some(config_handler) => {
+                    if let Err(err) = self
+                        .config
+                        .set_highlight_changed_text(config_handler, enabled)
+                    {
+                        log::warn!("failed to save config \"highlight_changed_text\": {}", err);
+                    }
+                }
+                None => self.config.highlight_changed_text = enabled,
+            },
+        }
+        Task::none()
+    }
+
+    pub fn change_history_settings(&self) -> cosmic::Element<'_, AppMessage> {
+        widget::settings::section()
+            .title(fl!("change-history"))
+            .add(
+                widget::settings::item::builder(fl!("show-changed-lines"))
+                    .toggler(self.config.change_history, |enabled| {
+                        Message::Enabled(enabled).into()
+                    }),
+            )
+            .add(
+                widget::settings::item::builder(fl!("highlight-changed-text"))
+                    .toggler(self.config.highlight_changed_text, |enabled| {
+                        Message::TintEnabled(enabled).into()
+                    }),
+            )
+            .into()
+    }
+
+    /// Edits: keys, clicks and input method text, as the editor reports only its saved state.
+    pub fn change_history_subscription(&self) -> Subscription<AppMessage> {
+        if !self.config.change_history {
+            return Subscription::none();
+        }
+        event::listen_with(|event, _status, _window| match event {
+            event::Event::Keyboard(keyboard::Event::KeyPressed { .. })
+            | event::Event::Mouse(mouse::Event::ButtonReleased(_))
+            | event::Event::InputMethod(input_method::Event::Commit(_)) => {
+                Some(Message::Edited.into())
+            }
+            _ => None,
+        })
+    }
+}
+
+/// Behaviours covered:
+/// - an unchanged file has no marks
+/// - an edited line is orange until saved; saving turns it green
+/// - undoing back to the saved text clears orange (green stays: it differs from the opened text)
+/// - inserted lines are orange; deleted lines mark the next line (or the last line)
+/// - a restored draft shows orange against the file on disk
+/// - reloading from disk clears every mark
+/// - a new document has no marks until its first save, then counts changes from that save
+/// - a diff result older than the newest scheduled diff is ignored; an unchanged text is not
+///   diffed again
+/// - files over 1 MB wait longer after an edit before the diff runs
+/// - a few edits far apart in a very large file mark only those lines
+///
+/// Tint of the changed text:
+/// - only the changed words of an unsaved line are tinted, not the whole line
+/// - a new line is tinted whole; extra lines of a replaced block too
+/// - saved changes are not tinted
+/// - undoing back to the saved text removes the tint; reloading from disk clears it
+/// - ranges of multibyte text lie on char boundaries
+/// - tints follow the line mapping when lines were inserted or deleted above
+/// - a diff past its deadline still tints the changed text, more coarsely
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// One char per line: `.` unchanged, `g` saved, `o` unsaved.
+    fn lines_of(marks: &[LineMark]) -> String {
+        marks
+            .iter()
+            .map(|m| match m.line {
+                Mark::None => '.',
+                Mark::Saved => 'g',
+                Mark::Unsaved => 'o',
+            })
+            .collect()
+    }
+
+    /// One char per line for the deletion tick: `.` none, `g` saved, `o` unsaved.
+    fn deletions_of(marks: &[LineMark]) -> String {
+        marks
+            .iter()
+            .map(|m| match m.deleted_above {
+                Mark::None => '.',
+                Mark::Saved => 'g',
+                Mark::Unsaved => 'o',
+            })
+            .collect()
+    }
+
+    /// Run the scheduled diff of `history` for `current` the way the app does.
+    fn diff_now(history: &mut History, current: &str) -> bool {
+        let (generation, _) = history.schedule();
+        match history.job(generation, current.to_string()) {
+            Some(job) => history.finish(job.run()),
+            None => false,
+        }
+    }
+
+    const FILE: &str = "one\ntwo\nthree\n";
+
+    /// The tinted lines of `current`, with each tinted range in brackets.
+    fn tinted(current: &str, tints: &Tints) -> Vec<String> {
+        lines(current)
+            .iter()
+            .enumerate()
+            .filter(|(i, _)| !tints.line(*i).is_empty())
+            .map(|(i, line)| {
+                let mut out = String::new();
+                let mut at = 0;
+                for range in tints.line(i) {
+                    out += &line[at..range.start];
+                    out += &format!("[{}]", &line[range.clone()]);
+                    at = range.end;
+                }
+                out + &line[at..]
+            })
+            .collect()
+    }
+
+    fn tints_of(base: &str, saved: &str, current: &str) -> Vec<String> {
+        tinted(current, &changes(base, saved, current).1)
+    }
+
+    #[test]
+    fn unchanged_file_has_no_marks() {
+        let marks = line_marks(FILE, FILE, FILE);
+        assert_eq!(lines_of(&marks), "....");
+        assert_eq!(deletions_of(&marks), "....");
+    }
+

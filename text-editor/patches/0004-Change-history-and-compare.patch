+        a.writing();
+        fs::write(&file.0, current).unwrap();
+        a.saved(current);
+        // `mirror::mark_saved`: the clone's file holds the saved text now
+        b.saved_as_clone(current, a.base_for_clone());
+        assert!(diff_now(&mut b, current));
+        assert_eq!(lines_of(&b.marks), ".g..");
+    }
+
+    /// Not a behaviour: prints how long a diff of a 1 MB and a 10 MB file takes, two edits far
+    /// apart (`--release -- --ignored --nocapture`).
+    #[test]
+    #[ignore]
+    fn diff_time_of_a_large_file() {
+        for lines in [40_000, 200_000] {
+            let base: String = (0..lines)
+                .map(|i| format!("line {i} with some text to make it about fifty bytes long\n"))
+                .collect();
+            let current = base
+                .replacen("line 20000 ", "inserted line\nline 20000 ", 1)
+                .replacen("line 100 ", "LINE 100 ", 1);
+            let start = Instant::now();
+            let marks = line_marks(&base, &base, &current);
+            println!("{} bytes: {:?}", base.len(), start.elapsed());
+            assert_eq!(marks.iter().filter(|m| m.line == Mark::Unsaved).count(), 2);
+        }
+    }
+}

+    #[test]
+    fn twin_is_a_clone_in_the_given_view() {
+        let (_, t) = tabs(4);
+        let split = Split::new(&t, t[3], Some(t[0]));
+        // t[0] on the left, its clone t[3] on the right; t[1] is not a clone
+        assert_eq!(split.twin_in(Side::Right, t[0], &[t[0], t[3]]), Some(t[3]));
+        assert_eq!(split.twin_in(Side::Left, t[3], &[t[0], t[3]]), Some(t[0]));
+        assert_eq!(split.twin_in(Side::Left, t[0], &[t[0], t[3]]), None, "itself");
+        assert_eq!(split.twin_in(Side::Right, t[1], &[t[1]]), None, "no clones");
+    }

+    /// A clone of `tab` in `side` that mirrors it and holds the same text. Like Notepad++, a
+    /// view shows a document once: moving or cloning `tab` there shows this clone instead.
+    /// Clones whose drafts drifted apart are not paired and never count.
+    fn twin_in(&self, side: Side, tab: Entity) -> Option<Entity> {
+        let twin = self
+            .split
+            .as_ref()?
+            .twin_in(side, tab, &self.clone_group(tab))?;
+        self.same_text(tab, twin).then_some(twin)
+    }
+
+    /// Any clone of `tab` that mirrors it and holds the same text: while one is open, closing
+    /// `tab` loses nothing, so it closes without the save prompt, as in Notepad++.
+    pub fn twin(&self, tab: Entity) -> Option<Entity> {
+        self.clone_group(tab)
+            .into_iter()
+            .find(|clone| *clone != tab && self.same_text(tab, *clone))
+    }
+
+    pub fn same_text(&self, a: Entity, b: Entity) -> bool {
+        let text = |entity| match self.tab_model.data::<Tab>(entity) {
+            Some(Tab::Editor(tab)) => Some(crate::tab::editor_text(&tab.editor.lock().unwrap())),
+            _ => None,
+        };
+        matches!((text(a), text(b)), (Some(a), Some(b)) if a == b)
+    }
+
+    /// `tab` would join `twin` in one view: close `tab` (its twin holds the same text) and show
+    /// `twin`.
+    fn merge_into_twin(&mut self, tab: Entity, twin: Entity) -> Task<AppMessage> {
+        Task::batch([
+            self.update(AppMessage::TabCloseForce(tab)),
+            self.update(AppMessage::TabActivate(twin)),
+        ])
+    }

+    #[test]
+    fn the_selection_fill_lets_coloured_text_show_through() {
+        let accent = Color::from_rgb(0.0, 0.7, 0.8);
+        let fill = selection_fill(accent);
+        assert_eq!((fill.r, fill.g, fill.b), (accent.r, accent.g, accent.b));
+        assert!(fill.a <= 0.3);
+    }

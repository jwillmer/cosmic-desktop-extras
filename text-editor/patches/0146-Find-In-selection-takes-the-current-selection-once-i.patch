+
+    /// The active tab's selection, when not empty
+    fn find_selection(&self) -> Option<(find_range::Pos, find_range::Pos)> {
+        let Some(Tab::Editor(tab)) = self.active_tab() else {
+            return None;
+        };
+        let (start, end) = tab.editor.lock().unwrap().selection_bounds()?;
+        (start != end).then_some(((start.line, start.index), (end.line, end.index)))
+    }
+
+    /// Before a find bar action: a stale "In selection" range takes the selection as it is
+    /// now, as in Notepad++, or ends without one (the action takes the whole text).
+    fn find_range_refresh(&mut self) {
+        if self.find_range.is_some() && !self.find_range_holds() {
+            self.find_range = None;
+            self.find_range_from_selection(false);
+        }
     }
 

+    /// Whether the "In selection" range is for the active tab and the text as it is now
+    fn find_range_holds(&self) -> bool {
+        self.find_range.is_some_and(|range| {
             range.tab == self.tab_model.active()
                 && matches!(
                     self.tab_model.data::<Tab>(range.tab),
                     Some(Tab::Editor(tab)) if tab.generation.current == range.generation
                 )
-        });
-        find_range::scope(self.find_range.map(|range| (range.start, range.end)), holds)
+        })

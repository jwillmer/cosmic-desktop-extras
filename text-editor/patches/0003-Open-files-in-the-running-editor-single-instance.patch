+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Single instance: a second launch hands its files to the running editor.
+
+use cosmic::{app::CosmicFlags, app::Task, dbus_activation};
+use std::path::{Path, PathBuf};
+
+use crate::{App, Flags, Message};
+
+const OPEN: &str = "open";
+
+impl CosmicFlags for Flags {
+    type SubCommand = &'static str;
+    type Args = Vec<String>;
+
+    fn action(&self) -> Option<&Self::SubCommand> {
+        (!self.files.is_empty()).then_some(&OPEN)
+    }
+
+    fn args(&self) -> Vec<&str> {
+        self.files.iter().map(String::as_str).collect()
+    }
+}
+
+/// Command line arguments as absolute paths: the running editor has its own working directory.
+pub fn absolute_args(args: impl IntoIterator<Item = String>, cwd: &Path) -> Vec<String> {
+    args.into_iter()
+        .map(|arg| {
+            let path = PathBuf::from(&arg);
+            if path.is_absolute() {
+                arg
+            } else {
+                cwd.join(path).to_string_lossy().into_owned()
+            }
+        })
+        .collect()
+}
+
+impl App {
+    /// Opens files as tabs (an open file gets its tab focused) and folders as projects.
+    fn open_paths(&mut self, paths: impl IntoIterator<Item = PathBuf>) -> Task<Message> {
+        for path in paths {
+            if path.is_dir() {
+                self.open_project(path);
+            } else {
+                self.open_tab(Some(path));
+            }
+        }
+        self.update_nav_bar_placeholder();
+        self.update_tab()
+    }
+
+    /// Another launch of the editor. Without files it only raises this window (libcosmic does).
+    pub fn single_instance_activation(&mut self, msg: dbus_activation::Message) -> Task<Message> {
+        match msg.msg {
+            dbus_activation::Details::ActivateAction { action, args } if action == OPEN => {
+                self.open_paths(args.into_iter().map(PathBuf::from))
+            }
+            dbus_activation::Details::Open { url } => {
+                self.open_paths(url.iter().filter_map(|url| url.to_file_path().ok()))
+            }
+            _ => Task::none(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn single_instance_args_become_absolute() {
+        let args = ["notes.md", "../b.txt", "/etc/hosts", "sub dir/c.md"].map(String::from);
+        assert_eq!(
+            absolute_args(args, Path::new("/srv/demo")),
+            [
+                "/srv/demo/notes.md",
+                "/srv/demo/../b.txt",
+                "/etc/hosts",
+                "/srv/demo/sub dir/c.md"
+            ]
+        );
+    }
+}

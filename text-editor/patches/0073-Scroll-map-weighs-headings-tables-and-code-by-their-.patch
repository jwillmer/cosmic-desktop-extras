-    /// The `|---|` row of a table, not drawn as a row.
+    /// The ``` or ~~~ line of a fenced code block: the block's padding.
+    Fence,
+    /// A row of a table.
+    Row,
+    /// The `|---|` row of a table, or the underline of a setext heading: not drawn.
     Rule,
 }
 
+fn is_fence(line: &str) -> bool {
+    let line = line.trim_start();
+    line.starts_with("```") || line.starts_with("~~~")
+}

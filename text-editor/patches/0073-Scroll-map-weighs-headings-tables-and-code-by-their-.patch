 //! scroll the preview to the part the editor shows, and the headings for the outline.
 //!
 //! The preview widget does not report where it draws each block, so the preview position is an
-//! estimate, line by line: a line of prose counts the lines it wraps to at the preview's width, a
-//! code line one, a table row one and its `|---|` rule none, every block one more of spacing, and
-//! blank lines between blocks nothing. A long paragraph or table maps line by line (row by row),
-//! not as one block. Images and closed `<details>` are taller or shorter than their source.
-
-use pulldown_cmark::{Event, Parser, Tag, TagEnd};
+//! estimate, line by line, from the sizes the Markdown widget draws with: a line of prose counts
+//! the lines it wraps to at the preview's width, a heading its larger size and the space above it,
+//! code its smaller size and the block's padding, a table row its cell padding and the `|---|` rule
+//! nothing, every block the spacing after it, and blank lines between blocks nothing. A long
+//! paragraph or table maps line by line (row by row), not as one block. Lists, quotes, images and
+//! closed `<details>` count as prose, so they can be taller or shorter than estimated.
+
+use pulldown_cmark::{CodeBlockKind, Event, Parser, Tag, TagEnd};
 use std::ops::Range;
 
 use super::html::OPTIONS;
 
-/// Space between two rendered blocks, in source lines.
-const BLOCK_GAP: f32 = 1.0;
+// Sizes as the preview's Markdown widget draws them (`Settings::with_text_size`), in lines of
+// prose: text is drawn 1.3 times its size high.
+const LINE_HEIGHT: f32 = 1.3;
+/// Space between two blocks: 0.875 of the text size.
+const BLOCK_GAP: f32 = 0.875 / LINE_HEIGHT;
+/// Heading sizes by level, as a share of the text size.
+const HEADING_SIZE: [f32; 6] = [2.0, 1.75, 1.5, 1.25, 1.0, 1.0];
+/// Space above a heading: half the text size.
+const HEADING_PADDING: f32 = 0.5 / LINE_HEIGHT;
+/// A table row: a line of text with half the block gap above and below.
+const TABLE_ROW: f32 = 1.0 + BLOCK_GAP;
+/// Code is drawn at 0.875 of the text size; the block has a padding of 1.25 code sizes at the top
+/// and bottom, here on the fence lines.
+const CODE_LINE: f32 = 0.875;
+const CODE_FENCE: f32 = 0.875 * 1.25 / LINE_HEIGHT;
 
 /// Line index of every line start, to turn byte offsets into lines.

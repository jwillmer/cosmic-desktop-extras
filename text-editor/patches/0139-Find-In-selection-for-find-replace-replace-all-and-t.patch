+    /// The "In selection" range of the active tab, while it holds: `None` with the option off,
+    /// in another tab, or after an edit that was not a replace of the find bar.
+    fn find_range(&self) -> Option<(find_range::Pos, find_range::Pos)> {
+        let range = self.find_range?;
+        let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(range.tab) else {
+            return None;
+        };
+        (range.tab == self.tab_model.active() && tab.generation.current == range.generation)
+            .then_some((range.start, range.end))
+    }
+
+    /// Turn "In selection" on for the active tab's selection. With `auto` (the find bar opens)
+    /// only for a selection that spans lines or is at least `find_range::AUTO_BYTES` long;
+    /// otherwise for any selection. Without one the option stays as it is. Returns whether it
+    /// was set.
+    fn find_range_from_selection(&mut self, auto: bool) -> bool {
+        let entity = self.tab_model.active();
+        let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(entity) else {
+            return false;
+        };
+        let Some((start, end)) = tab.editor.lock().unwrap().selection_bounds() else {
+            return false;
+        };
+        let (start, end) = ((start.line, start.index), (end.line, end.index));
+        let long = start.0 != end.0 || end.1 - start.1 >= find_range::AUTO_BYTES;
+        if start == end || auto && !long {
+            return false;
+        }
+        self.find_range = Some(FindRange {
+            tab: entity,
+            start,
+            end,
+            generation: tab.generation.current,
+        });
+        true
+    }
+
+    /// A replace of the find bar inside the "In selection" range changed the text: the range
+    /// now ends at `end`, and holds for the text as it is now.
+    fn find_range_replaced(&mut self, end: find_range::Pos) {
+        let Some(range) = self.find_range.as_mut() else {
+            return;
+        };
+        if let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(range.tab) {
+            range.end = end;
+            range.generation = tab.generation.current;
+        }
+    }

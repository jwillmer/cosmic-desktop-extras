index 0000000..7d1cd27
--- /dev/null
+++ b/src/find_range.rs
@@ -0,0 +1,219 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The find bar's "In selection" option: find, replace, count and highlight only inside a range
+//! of the text, the selection the option was turned on with (or that the find bar opened with,
+//! when it spans lines).
+//!
+//! The range is two positions, (line, byte index), start before end. A match counts when it
+//! lies wholly inside. Replace and Replace all change the text inside it, so its end moves with
+//! their edits ([`shift`]); any other edit makes the range stale and the option turns off (the
+//! caller compares text generations), as the range would no longer cover what was selected.
+
+use crate::find_count::{Matches, Span};
+
+/// A position in the text: line and byte index
+pub type Pos = (usize, usize);
+
+/// A selection of at least this many bytes on one line turns "In selection" on when the find
+/// bar opens, as one that spans lines does: it is a range to search, not a query
+pub const AUTO_BYTES: usize = 1024;
+
+/// Whether the match from `start` to `end` lies wholly inside the range `from` to `to`
+pub fn inside(start: Pos, end: Pos, (from, to): (Pos, Pos)) -> bool {
+    start >= from && end <= to
+}
+
+/// The matches of `matches` inside `range`, for the count. Matches past the cap are not known:
+/// the result is capped when the input was and the range reaches past its last match.
+pub fn clip(matches: &Matches, range: (Pos, Pos)) -> Matches {
+    let spans: Vec<Span> = matches
+        .spans
+        .iter()
+        .filter(|span| inside((span.line, span.start), (span.end_line, span.end), range))
+        .copied()
+        .collect();
+    let capped = matches.capped
+        && matches
+            .spans
+            .last()
+            .is_none_or(|last| (last.end_line, last.end) < range.1);
+    Matches { spans, capped }
+}
+
+/// Where `pos` is after the edits `edits` (each: the start and end of the replaced text and the
+/// text put there), which are in order, do not overlap and all end at or before `pos`.
+pub fn shift(mut pos: Pos, edits: &[(Pos, Pos, &str)]) -> Pos {
+    // From the last edit back: the earlier ones stay where they were
+    for &(start, end, text) in edits.iter().rev() {
+        let (breaks, last_len) = line_breaks(text);
+        if end.0 == pos.0 {
+            let tail = pos.1 - end.1;
+            let head = if breaks == 0 {
+                start.1 + text.len()
+            } else {
+                last_len
+            };
+            pos = (start.0 + breaks, head + tail);
+        } else {
+            pos.0 = pos.0 - (end.0 - start.0) + breaks;
+        }
+    }
+    pos
+}
+
+/// How many line breaks `text` holds (`\r\n` is one) and how long its text after the last is
+fn line_breaks(text: &str) -> (usize, usize) {
+    let mut breaks = 0;
+    let mut last_start = 0;
+    let bytes = text.as_bytes();
+    let mut i = 0;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'\r' if bytes.get(i + 1) == Some(&b'\n') => {
+                breaks += 1;
+                i += 2;
+                last_start = i;
+            }
+            b'\r' | b'\n' => {
+                breaks += 1;
+                i += 1;
+                last_start = i;
+            }
+            _ => i += 1,
+        }
+    }
+    (breaks, text.len() - last_start)
+}
+
+/// The match Find next (`forwards`) or Find previous picks from `matches` (in order), seen from
+/// `cursor`: the first one after it, or the last one before it. A match starting at the cursor
+/// is taken unless `past` (it is the current one). With `wrap_around` the search goes on from
+/// the other end of the list.
+pub fn pick(
+    matches: &[(Pos, Pos)],
+    cursor: Pos,
+    past: bool,
+    forwards: bool,
+    wrap_around: bool,
+) -> Option<(Pos, Pos)> {
+    let found = if forwards {
+        matches
+            .iter()
+            .find(|(start, _)| *start > cursor || *start == cursor && !past)
+            .or_else(|| wrap_around.then(|| matches.first()).flatten())
+    } else {
+        matches
+            .iter()
+            .rev()
+            .find(|(start, _)| *start < cursor || *start == cursor && !past)
+            .or_else(|| wrap_around.then(|| matches.last()).flatten())
+    };
+    found.copied()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn span(line: usize, start: usize, end: usize) -> Span {
+        Span {
+            line,
+            start,
+            end_line: line,
+            end,
+        }
+    }
+
+    #[test]
+    fn clips_matches_to_the_range() {
+        let matches = Matches {
+            spans: vec![span(0, 0, 3), span(2, 0, 3), span(2, 4, 7), span(5, 0, 3)],
+            capped: false,
+        };
+        // From line 2 index 1 to line 5 index 3: the first match of line 2 starts before
+        let clipped = clip(&matches, ((2, 1), (5, 3)));
+        assert_eq!(clipped.spans, vec![span(2, 4, 7), span(5, 0, 3)]);
+        assert!(!clipped.capped);
+        // A match reaching past the end is outside
+        let clipped = clip(&matches, ((2, 0), (5, 2)));
+        assert_eq!(clipped.spans, vec![span(2, 0, 3), span(2, 4, 7)]);
+        // A match over a line break counts when both ends are inside
+        let spanning = Matches {
+            spans: vec![Span {
+                line: 1,
+                start: 2,
+                end_line: 2,
+                end: 1,
+            }],
+            capped: false,
+        };
+        assert_eq!(clip(&spanning, ((1, 0), (2, 1))).spans.len(), 1);
+        assert_eq!(clip(&spanning, ((1, 3), (2, 1))).spans.len(), 0);
+    }
+
+    #[test]
+    fn clipped_count_is_capped_only_past_the_last_known_match() {
+        let matches = Matches {
+            spans: vec![span(0, 0, 3), span(4, 0, 3)],
+            capped: true,
+        };
+        assert!(!clip(&matches, ((0, 0), (2, 0))).capped);
+        assert!(clip(&matches, ((0, 0), (9, 0))).capped);
+    }
+
+    #[test]
+    fn end_shifts_with_edits_on_its_line() {
+        // "cat cat|" with both replaced by "dog!": the end moves by 1 per replacement
+        let edits = [((0, 0), (0, 3), "dog!"), ((0, 4), (0, 7), "dog!")];
+        assert_eq!(shift((0, 7), &edits), (0, 9));
+        // Text after the last match stays after it
+        assert_eq!(shift((0, 9), &edits), (0, 11));
+        // A shorter replacement moves it back
+        assert_eq!(shift((0, 7), &[((0, 4), (0, 7), "")]), (0, 4));
+    }
+
+    #[test]
+    fn end_shifts_with_edits_on_earlier_lines() {
+        // Edits on lines 1 and 2 that keep the line count leave a later line alone
+        let edits = [((1, 0), (1, 3), "dog"), ((2, 0), (2, 3), "elephant")];
+        assert_eq!(shift((5, 4), &edits), (5, 4));
+        // A replacement with a line break adds a line; one over a break removes one
+        assert_eq!(shift((5, 4), &[((1, 0), (1, 3), "a\nb")]), (6, 4));
+        assert_eq!(shift((5, 4), &[((1, 2), (2, 1), "-")]), (4, 4));
+        assert_eq!(shift((5, 4), &[((1, 0), (1, 3), "a\r\nb\r\n")]), (7, 4));
+    }
+
+    #[test]
+    fn end_shifts_with_line_breaks_on_its_line() {
+        // "ab|cd" on line 3, "ab" replaced by "x\nyz": the end is on line 4 after "yz"
+        assert_eq!(shift((3, 2), &[((3, 0), (3, 2), "x\nyz")]), (4, 2));
+        // A match over a break ending on the end's line
+        assert_eq!(shift((3, 5), &[((2, 4), (3, 1), "Q")]), (2, 9));
+        // Prefixing every line ("> " at index 0 of lines 0..=2) moves the end on line 2 by 2
+        let edits = [
+            ((0, 0), (0, 0), "> "),
+            ((1, 0), (1, 0), "> "),
+            ((2, 0), (2, 0), "> "),
+        ];
+        assert_eq!(shift((2, 5), &edits), (2, 7));
+        // A replacement ending in a break puts the end at the start of the next line's text
+        assert_eq!(shift((0, 5), &[((0, 0), (0, 3), "a\n")]), (1, 2));
+    }
+
+    #[test]
+    fn picks_inside_the_list() {
+        let matches = [((2, 0), (2, 3)), ((3, 0), (3, 3)), ((4, 0), (4, 3))];
+        // From before the range, forwards: the first; backwards wraps to the last
+        assert_eq!(pick(&matches, (0, 0), false, true, true), Some(matches[0]));
+        assert_eq!(pick(&matches, (0, 0), false, false, true), Some(matches[2]));
+        assert_eq!(pick(&matches, (0, 0), false, false, false), None);
+        // On a match: past it, or on it with a new query
+        assert_eq!(pick(&matches, (3, 0), true, true, true), Some(matches[2]));
+        assert_eq!(pick(&matches, (3, 0), false, true, true), Some(matches[1]));
+        assert_eq!(pick(&matches, (3, 0), true, false, true), Some(matches[0]));
+        // From the last, forwards wraps to the first, or stops
+        assert_eq!(pick(&matches, (4, 0), true, true, true), Some(matches[0]));
+        assert_eq!(pick(&matches, (4, 0), true, true, false), None);
+        assert_eq!(pick(&[], (0, 0), false, true, true), None);
+    }
+}

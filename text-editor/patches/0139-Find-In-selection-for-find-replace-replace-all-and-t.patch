+/// Draw the find bar's "In selection" range behind its matches, in the accent colour at a lower
+/// alpha than they have: the selection it was taken from goes as soon as Find next selects a
+/// match, the range stays visible.
+fn draw_find_range(
+    renderer: &mut CustomRenderer,
+    editor: &ViEditor<'static, 'static>,
+    (from, to): (find_range::Pos, find_range::Pos),
+    theme: &cosmic::cosmic_theme::Theme,
+    line_height: f32,
+) {
+    let c = theme.accent_color();
+    let channel = |v: f32| (v.clamp(0.0, 1.0) * 255.0).round() as u8;
+    let color = cosmic_text::Color::rgba(channel(c.red), channel(c.green), channel(c.blue), 28);
+    editor.with_buffer(|buffer| {
+        for run in buffer
+            .layout_runs()
+            .filter(|run| !folding::is_folded_run(run))
+        {
+            let line = run.line_i;
+            if line < from.0 || line > to.0 {
+                continue;
+            }
+            let start = Cursor::new(line, if line == from.0 { from.1 } else { 0 });
+            let len = buffer.lines[line].text().len();
+            let end = Cursor::new(line, if line == to.0 { to.1.min(len) } else { len });
+            for (x, w) in run.highlight(start, end) {
+                // An empty line inside the range still shows a sliver
+                let w = if w < 1.0 && line < to.0 { 4.0 } else { w };
+                let left = x.floor();
+                renderer.rectangle(
+                    left as i32,
+                    run.line_top as i32,
+                    (x + w - left).ceil() as u32,
+                    line_height as u32,
+                    color,
+                );
+            }
+        }
+    });
+}

+    /// The grapheme nearest to `pointer`, in absolute coordinates, for a leaf drawn in
+    /// `bounds`: above the leaf its start, below its end, beside a line that line's start or end.
+    fn grapheme_near(&self, bounds: Rectangle, pointer: Point) -> usize {
+        if pointer.y < bounds.y {
+            0
+        } else if pointer.y >= bounds.y + bounds.height {
+            self.content.graphemes(true).count()
+        } else {
+            let x = (pointer.x - bounds.x).clamp(0.0, bounds.width);
+            self.grapheme_at(Point::new(x, pointer.y - bounds.y))
+        }
+    }

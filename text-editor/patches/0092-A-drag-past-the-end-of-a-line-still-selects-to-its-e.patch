+/// Leaves farther than this above or below the pointer ignore it.
+const REACH: f32 = 48.0;
+
+/// How near the pointer is to a leaf, for the leaves near it to agree which one it is at: the
+/// pointer's position, and how far it is above or below the leaf, then beside it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Near {
+    pub pointer: Point,
+    pub off: (f32, f32),
+}
+
+impl Near {
+    /// The pointer at `pointer` is near the leaf drawn in `bounds`; `None` when out of reach.
+    pub fn of(bounds: Rectangle, pointer: Point) -> Option<Self> {
+        let below = pointer.y - (bounds.y + bounds.height);
+        let dy = (bounds.y - pointer.y).max(below).max(0.0);
+        let dx = (bounds.x - pointer.x)
+            .max(pointer.x - (bounds.x + bounds.width))
+            .max(0.0);
+        (dy <= REACH).then_some(Self {
+            pointer,
+            off: (dy, dx),
+        })
+    }
+
+    pub fn is_over(&self) -> bool {
+        self.off == (0.0, 0.0)
+    }
+
+    /// Of two leaves near the pointer at the same place, `self` is not nearer than `other`.
+    pub fn loses_to(&self, other: &Near) -> bool {
+        self.pointer == other.pointer && self.off >= other.off
+    }
+}

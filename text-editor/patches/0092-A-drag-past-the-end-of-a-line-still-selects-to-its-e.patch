+    #[test]
+    fn leaves_near_the_pointer_are_ranked() {
+        let bounds = Rectangle::new(Point::new(10.0, 100.0), Size::new(200.0, 40.0));
+        let off = |x, y| Near::of(bounds, Point::new(x, y)).map(|near| near.off);
+        assert_eq!(off(50.0, 120.0), Some((0.0, 0.0)));
+        // Past the end of a line, in the margin, above and below
+        assert_eq!(off(260.0, 120.0), Some((0.0, 50.0)));
+        assert_eq!(off(0.0, 120.0), Some((0.0, 10.0)));
+        assert_eq!(off(50.0, 90.0), Some((10.0, 0.0)));
+        assert_eq!(off(50.0, 150.0), Some((10.0, 0.0)));
+        assert_eq!(off(50.0, 500.0), None);
+        // Beside beats above or below; nearer beats farther
+        let at = |off| Near {
+            pointer: Point::ORIGIN,
+            off,
+        };
+        assert!(at((5.0, 0.0)).loses_to(&at((0.0, 300.0))));
+        assert!(at((0.0, 20.0)).loses_to(&at((0.0, 10.0))));
+        assert!(!at((0.0, 0.0)).loses_to(&at((0.0, 10.0))));
+        let elsewhere = Near {
+            pointer: Point::new(1.0, 0.0),
+            off: (40.0, 0.0),
+        };
+        assert!(!elsewhere.loses_to(&at((0.0, 0.0))));
+    }

+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::session::{SessionFile, SessionTab};
+
+    /// The app's tab model with `n` tabs; the last one is active.
+    fn tabs(n: usize) -> (SingleSelectModel, Vec<Entity>) {
+        let mut model = SingleSelectModel::default();
+        let entities = (0..n)
+            .map(|i| model.insert().text(format!("tab {i}")).activate().id())
+            .collect();
+        (model, entities)
+    }
+
+    #[test]
+    fn move_to_other_view_splits_window() {
+        let (model, t) = tabs(3);
+        let split = Split::new(&t, t[2], Some(t[1]));
+        assert_eq!(split.tabs(Side::Left), vec![t[0], t[1]]);
+        assert_eq!(split.tabs(Side::Right), vec![t[2]]);
+        assert_eq!(split.active, Side::Right);
+        assert_eq!(split.shown(Side::Left), Some(t[1]));
+        assert_eq!(split.shown(Side::Right), Some(t[2]));
+        assert!(split.is_complete());
+
+        // Moving a left tab over too: it shows on the right, the left shows its neighbour
+        let mut split = split;
+        split.move_tab(t[1]);
+        assert_eq!(split.tabs(Side::Left), vec![t[0]]);
+        assert_eq!(split.tabs(Side::Right), vec![t[2], t[1]]);
+        assert_eq!(split.shown(Side::Left), Some(t[0]));
+        assert_eq!(split.shown(Side::Right), Some(t[1]));
+
+        // Titles follow the app's tabs, and the order of its tab bar
+        let mut split = split;
+        split.sync(&model);
+        assert_eq!(split.tabs(Side::Right), vec![t[1], t[2]]);
+        let right = split.model(Side::Right);
+        assert_eq!(right.text(right.active()), Some("tab 2"));
+    }
+
+    #[test]
+    fn last_tab_leaving_a_view_closes_the_split() {
+        let (mut model, t) = tabs(3);
+        let mut split = Split::new(&t, t[2], Some(t[1]));
+        split.move_tab(t[2]);
+        assert!(!split.is_complete(), "moving back the only right tab");
+
+        let mut split = Split::new(&t, t[2], Some(t[1]));
+        model.remove(t[2]);
+        model.activate(t[1]);
+        split.sync(&model);
+        assert!(!split.is_complete(), "closing the only right tab");
+
+        // Closing a tab of a view that keeps tabs shows its neighbour there
+        let (mut model, t) = tabs(4);
+        let mut split = Split::new(&t, t[3], Some(t[2]));
+        split.move_tab(t[0]);
+        assert_eq!(split.tabs(Side::Right), vec![t[3], t[0]]);
+        // The app activates a tab of the other view after closing the shown tab of this one
+        model.remove(t[0]);
+        model.activate(t[2]);
+        assert_eq!(split.sync(&model), Some(t[3]));
+        assert!(split.is_complete());
+        assert_eq!(split.shown(Side::Right), Some(t[3]));
+    }
+
+    #[test]
+    fn menu_actions_target_the_active_view() {
+        let (mut model, t) = tabs(3);
+        let mut split = Split::new(&t, t[2], Some(t[0]));
+        model.activate(t[2]);
+        split.sync(&model);
+        assert_eq!(split.active, Side::Right);
+
+        // A click into the left view activates its shown tab: menus act on it
+        model.activate(split.shown(Side::Left).unwrap());
+        split.sync(&model);
+        assert_eq!(split.active, Side::Left);
+        assert_eq!(model.active(), t[0]);
+        assert_eq!(
+            split.shown(Side::Right),
+            Some(t[2]),
+            "the right view keeps its tab"
+        );
+
+        // A new tab opens in the active view; Ctrl+Tab cycles the tabs of that view only
+        let new = model.insert().text("new").activate().id();
+        split.sync(&model);
+        assert_eq!(split.tabs(Side::Left), vec![t[0], t[1], new]);
+        assert_eq!(split.tabs(Side::Right), vec![t[2]]);
+        assert_eq!(split.shown(Side::Left), Some(new));
+    }
+
+    #[test]
+    fn sync_scroll_moves_both_views_by_lines() {
+        // Down 3 lines, up 3 lines
+        assert_eq!(follow_scroll(10, 5, 8, 100), 13);
+        assert_eq!(follow_scroll(10, 8, 5, 100), 7);
+        // The other view stops at its first and last line
+        assert_eq!(follow_scroll(1, 8, 2, 100), 0);
+        assert_eq!(follow_scroll(98, 0, 5, 100), 99);
+        assert_eq!(follow_scroll(0, 0, 5, 0), 0);
+    }
+
+    #[test]
+    fn session_restores_views() {
+        let (model, t) = tabs(4);
+        let mut split = Split::new(&t, t[3], Some(t[1]));
+        split.move_tab(t[0]);
+        split.sync(&model);
+        // The app shows t[0] on the right (active); the left shows t[1]
+        let (views, other) = session_views(Some(&split), &t);
+        assert_eq!(views, vec![1, 0, 0, 1]);
+        assert_eq!(other, Some(t[1]));
+
+        // Through the session file
+        let session = SessionFile {
+            active: 0,
+            other_active: Some(1),
+            tabs: views
+                .iter()
+                .map(|view| SessionTab {
+                    view: *view,
+                    ..Default::default()
+                })
+                .collect(),
+            ..Default::default()
+        };
+        let data = ron::to_string(&session).unwrap();
+        let session: SessionFile = ron::from_str(&data).unwrap();
+        let restored: Vec<(Entity, u8)> = t
+            .iter()
+            .copied()
+            .zip(session.tabs.iter().map(|tab| tab.view))
+            .collect();
+        let restored = restore_split(&restored, Some(t[0]), Some(t[1])).unwrap();
+        assert_eq!(restored.tabs(Side::Left), vec![t[1], t[2]]);
+        assert_eq!(restored.tabs(Side::Right), vec![t[0], t[3]]);
+        assert_eq!(restored.active, Side::Right);
+        assert_eq!(restored.shown(Side::Right), Some(t[0]));
+        assert_eq!(restored.shown(Side::Left), Some(t[1]));
+    }
+
+    #[test]
+    fn old_session_loads_into_one_view() {
+        let old = "(version: 1, active: 0, tabs: [(path: Some(\"/srv/demo/a.md\"), backup: None, \
+                   file_modified: None, cursor: (0, 0), scroll: (0, 0.0), markdown_view: None)])";
+        let session: SessionFile = ron::from_str(old).unwrap();
+        assert_eq!(session.tabs[0].view, 0);
+        assert_eq!(session.other_active, None);
+        let (_, t) = tabs(2);
+        assert!(restore_split(&[(t[0], 0), (t[1], 0)], Some(t[0]), None).is_none());
+        assert_eq!(session_views(None, &t), (vec![0, 0], None));
+    }
+}

diff --git a/src/views.rs b/src/views.rs
new file mode 100644
index 0000000..4c42916
--- /dev/null
+++ b/src/views.rs
@@ -0,0 +1,665 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Two views side by side, like Notepad++: View, "Move to other view" and "Clone to other view"
+//! (also in the tab's right-click menu) split the window into a left and a right view, each with
+//! its own tab bar and shown tab.
+//!
+//! Every tab stays in `App::tab_model`, so everything keyed by its entity (drafts, diffs, disk
+//! checks) works unchanged. A [`Split`] adds one display model per view whose items point at
+//! those tabs. The active tab of `tab_model` is the shown tab of the active view, so menus and
+//! shortcuts act on it; `App::views_after_update` keeps the display models in step after every
+//! message. A view left without tabs closes the split.
+//!
+//! Clone opens the saved file a second time: the two tabs have separate buffers and both follow
+//! changes on disk.
+
+use cosmic::{
+    Application,
+    app::Task,
+    widget::segmented_button::{Entity, SingleSelectModel},
+};
+use cosmic_text::Edit;
+use std::collections::HashSet;
+
+use crate::{App, Message as AppMessage, tab::Tab};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Side {
+    Left,
+    Right,
+}
+
+impl Side {
+    pub fn other(self) -> Self {
+        match self {
+            Self::Left => Self::Right,
+            Self::Right => Self::Left,
+        }
+    }
+
+    fn index(self) -> usize {
+        match self {
+            Self::Left => 0,
+            Self::Right => 1,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+pub enum Message {
+    /// Move the tab, or the active tab, to the other view.
+    Move(Option<Entity>),
+    /// Open the tab's file, or the active tab's, again in the other view.
+    Clone(Option<Entity>),
+    /// The tab bar's right-click menu entries; they act on `App::tab_bar_context`.
+    TabBarMove,
+    TabBarClone,
+    /// A view's tab bar, with its display entity.
+    Activate(Side, Entity),
+    Close(Side, Entity),
+    Context(Side, Entity),
+    /// The "+" button of a view's tab bar.
+    NewFile(Side),
+    /// A click into a view.
+    Focus(Side),
+    /// The editor shown in a view scrolled.
+    Scrolled(Side),
+}
+
+impl From<Message> for AppMessage {
+    fn from(message: Message) -> Self {
+        AppMessage::Views(message)
+    }
+}
+
+/// The two views. Items of `left` and `right` carry the [`Entity`] of their tab in
+/// `App::tab_model`.
+pub struct Split {
+    pub left: SingleSelectModel,
+    pub right: SingleSelectModel,
+    pub active: Side,
+    /// The shown tabs and their top lines when the last scroll was followed.
+    scroll_base: Option<([Option<Entity>; 2], [usize; 2])>,
+}
+
+impl Split {
+    /// Split `tabs` (in tab bar order): `moving` goes to the right view and is active there, the
+    /// rest stays left with `left_shown` shown.
+    pub fn new(tabs: &[Entity], moving: Entity, left_shown: Option<Entity>) -> Self {
+        let mut split = Self {
+            left: SingleSelectModel::default(),
+            right: SingleSelectModel::default(),
+            active: Side::Right,
+            scroll_base: None,
+        };
+        for tab in tabs.iter().copied().filter(|tab| *tab != moving) {
+            split.insert(Side::Left, tab);
+        }
+        if let Some(shown) = left_shown.and_then(|tab| split.display(Side::Left, tab)) {
+            split.left.activate(shown);
+        }
+        split.insert(Side::Right, moving);
+        split
+    }
+
+    pub fn model(&self, side: Side) -> &SingleSelectModel {
+        match side {
+            Side::Left => &self.left,
+            Side::Right => &self.right,
+        }
+    }
+
+    fn model_mut(&mut self, side: Side) -> &mut SingleSelectModel {
+        match side {
+            Side::Left => &mut self.left,
+            Side::Right => &mut self.right,
+        }
+    }
+
+    /// Add a tab at the end of a view and show it there.
+    pub fn insert(&mut self, side: Side, tab: Entity) {
+        self.model_mut(side)
+            .insert()
+            .data::<Entity>(tab)
+            .closable()
+            .activate();
+    }
+
+    /// The tab a display item of a view points at.
+    pub fn tab(&self, side: Side, display: Entity) -> Option<Entity> {
+        self.model(side).data::<Entity>(display).copied()
+    }
+
+    /// The display item of a tab in a view.
+    fn display(&self, side: Side, tab: Entity) -> Option<Entity> {
+        let model = self.model(side);
+        model
+            .iter()
+            .find(|display| model.data::<Entity>(*display) == Some(&tab))
+    }
+
+    pub fn side_of(&self, tab: Entity) -> Option<Side> {
+        [Side::Left, Side::Right]
+            .into_iter()
+            .find(|side| self.display(*side, tab).is_some())
+    }
+
+    /// The tab shown in a view.
+    pub fn shown(&self, side: Side) -> Option<Entity> {
+        let model = self.model(side);
+        self.tab(side, model.active())
+    }
+
+    /// The tabs of a view, in tab bar order.
+    pub fn tabs(&self, side: Side) -> Vec<Entity> {
+        let model = self.model(side);
+        model
+            .iter()
+            .filter_map(|display| model.data::<Entity>(display).copied())
+            .collect()
+    }
+
+    /// Move a tab to the other view, show it there and make that view active.
+    pub fn move_tab(&mut self, tab: Entity) {
+        let Some(from) = self.side_of(tab) else {
+            return;
+        };
+        self.remove(from, tab);
+        self.insert(from.other(), tab);
+        self.active = from.other();
+    }
+
+    /// Remove a tab from a view; the tab next to it is shown if it was.
+    fn remove(&mut self, side: Side, tab: Entity) {
+        let Some(display) = self.display(side, tab) else {
+            return;
+        };
+        let model = self.model_mut(side);
+        let shown = model.is_active(display);
+        let pos = model.position(display).unwrap_or(0);
+        model.remove(display);
+        if shown {
+            let len = model.len() as u16;
+            if len > 0 {
+                model.activate_position(pos.min(len - 1));
+            }
+        }
+    }
+
+    /// Both views have tabs; otherwise the split closes.
+    pub fn is_complete(&self) -> bool {
+        self.left.len() > 0 && self.right.len() > 0
+    }
+
+    /// Follow `tabs` (the app's tab model): drop closed tabs, add new ones to the active view,
+    /// keep tab bar order, titles and icons, and make the view of its active tab active. Returns
+    /// a tab to activate when closing the shown tab of the active view moved `tabs` to the other
+    /// view while this one still has tabs.
+    pub fn sync(&mut self, tabs: &SingleSelectModel) -> Option<Entity> {
+        let open: HashSet<Entity> = tabs.iter().collect();
+        let mut lost_shown = [false; 2];
+        for side in [Side::Left, Side::Right] {
+            let gone: Vec<Entity> = self
+                .tabs(side)
+                .into_iter()
+                .filter(|tab| !open.contains(tab))
+                .collect();
+            for tab in gone {
+                if self.shown(side) == Some(tab) {
+                    lost_shown[side.index()] = true;
+                }
+                self.remove(side, tab);
+            }
+        }
+        for tab in tabs.iter() {
+            if self.side_of(tab).is_none() {
+                self.insert(self.active, tab);
+            }
+        }
+        for side in [Side::Left, Side::Right] {
+            let mut pos = 0;
+            for tab in tabs.iter() {
+                if let Some(display) = self.display(side, tab) {
+                    let model = self.model_mut(side);
+                    model.position_set(display, pos);
+                    model.text_set(display, tabs.text(tab).unwrap_or_default().to_string());
+                    if let Some(icon) = tabs.icon(tab) {
+                        model.icon_set(display, icon.clone());
+                    }
+                    pos += 1;
+                }
+            }
+        }
+        let active = tabs.active();
+        let side = self.side_of(active)?;
+        if side != self.active
+            && lost_shown[self.active.index()]
+            && self.model(self.active).len() > 0
+        {
+            return self.shown(self.active);
+        }
+        self.active = side;
+        if let Some(display) = self.display(side, active) {
+            self.model_mut(side).activate(display);
+        }
+        None
+    }
+}
+
+/// The other view's new top line when one view's top line went from `from` to `to`: moved by
+/// the same number of lines, within `0..lines`.
+pub fn follow_scroll(other_top: usize, from: usize, to: usize, lines: usize) -> usize {
+    let top = if to >= from {
+        other_top.saturating_add(to - from)
+    } else {
+        other_top.saturating_sub(from - to)
+    };
+    top.min(lines.saturating_sub(1))
+}
+
+/// What the View menu needs to know about the views.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct MenuState {
+    pub split: bool,
+    /// The active tab can move: there is another tab to stay behind.
+    pub can_move: bool,
+    /// The active tab is a saved file.
+    pub can_clone: bool,
+}
+
+impl App {
+    /// The view state for the menus of `tab`.
+    pub fn views_menu_state(&self, tab: Entity) -> MenuState {
+        MenuState {
+            split: self.split.is_some(),
+            can_move: self.tab_model.len() > 1,
+            can_clone: self.can_clone(tab),
+        }
+    }
+
+    fn can_clone(&self, tab: Entity) -> bool {
+        matches!(
+            self.tab_model.data::<Tab>(tab),
+            Some(Tab::Editor(tab)) if tab.path_opt.is_some() && !tab.changed()
+        )
+    }
+
+    /// The tabs of the view that holds `tab` (every tab without a split), in tab bar order.
+    pub fn view_tabs_with(&self, tab: Entity) -> Vec<Entity> {
+        match &self.split {
+            Some(split) => match split.side_of(tab) {
+                Some(side) => split.tabs(side),
+                None => self.tab_model.iter().collect(),
+            },
+            None => self.tab_model.iter().collect(),
+        }
+    }
+
+    /// Keep the views in step with the tabs after a message.
+    pub fn views_after_update(&mut self, task: Task<AppMessage>) -> Task<AppMessage> {
+        let Some(split) = &mut self.split else {
+            return task;
+        };
+        let activate = split.sync(&self.tab_model);
+        if !split.is_complete() {
+            self.split = None;
+            return task;
+        }
+        if !self.config.sync_scroll_views {
+            split.scroll_base = None;
+        } else {
+            let shown = [split.shown(Side::Left), split.shown(Side::Right)];
+            if split.scroll_base.is_none_or(|(base, _)| base != shown) {
+                let tops = shown.map(|tab| tab.map_or(0, |tab| top_line(&self.tab_model, tab)));
+                split.scroll_base = Some((shown, tops));
+            }
+        }
+        match activate {
+            Some(tab) => Task::batch([task, self.update(AppMessage::TabActivate(tab))]),
+            None => task,
+        }
+    }
+
+    pub fn update_views(&mut self, message: Message) -> Task<AppMessage> {
+        match message {
+            Message::Move(tab) => {
+                let tab = tab.unwrap_or_else(|| self.tab_model.active());
+                match &mut self.split {
+                    Some(split) => split.move_tab(tab),
+                    None => {
+                        if self.tab_model.len() < 2 || !self.tab_model.contains_item(tab) {
+                            return Task::none();
+                        }
+                        let tabs: Vec<Entity> = self.tab_model.iter().collect();
+                        let left_shown = self.left_shown_after_move(&tabs, tab);
+                        self.split = Some(Split::new(&tabs, tab, left_shown));
+                    }
+                }
+                return self.update(AppMessage::TabActivate(tab));
+            }
+            Message::Clone(tab) => {
+                let tab = tab.unwrap_or_else(|| self.tab_model.active());
+                if !self.can_clone(tab) {
+                    return Task::none();
+                }
+                let Some(Tab::Editor(source)) = self.tab_model.data::<Tab>(tab) else {
+                    return Task::none();
+                };
+                let (path, view) = (source.path_opt.clone(), source.markdown_view());
+                let Some(clone) = self.open_tab_again(path, view) else {
+                    return Task::none();
+                };
+                let side = match &mut self.split {
+                    Some(split) => split.side_of(tab).unwrap_or(split.active).other(),
+                    None => {
+                        let tabs: Vec<Entity> = self.tab_model.iter().collect();
+                        self.split = Some(Split::new(&tabs, clone, Some(tab)));
+                        Side::Right
+                    }
+                };
+                if let Some(split) = &mut self.split
+                    && split.side_of(clone).is_none()
+                {
+                    split.insert(side, clone);
+                }
+                return self.update(AppMessage::TabActivate(clone));
+            }
+            Message::TabBarMove => {
+                let tab = self.tab_bar_context.take();
+                return self.update_views(Message::Move(tab));
+            }
+            Message::TabBarClone => {
+                let tab = self.tab_bar_context.take();
+                return self.update_views(Message::Clone(tab));
+            }
+            Message::Activate(side, display) => {
+                if let Some(tab) = self.split.as_ref().and_then(|s| s.tab(side, display)) {
+                    return self.update(AppMessage::TabActivate(tab));
+                }
+            }
+            Message::Close(side, display) => {
+                if let Some(tab) = self.split.as_ref().and_then(|s| s.tab(side, display)) {
+                    return self.update(AppMessage::TabClose(tab));
+                }
+            }
+            Message::Context(side, display) => {
+                if let Some(tab) = self.split.as_ref().and_then(|s| s.tab(side, display)) {
+                    self.tab_bar_context = Some(tab);
+                }
+            }
+            Message::NewFile(side) => {
+                let focus = self.update_views(Message::Focus(side));
+                return Task::batch([focus, self.update(AppMessage::NewFile)]);
+            }
+            Message::Focus(side) => {
+                if let Some(split) = &self.split
+                    && split.active != side
+                    && let Some(tab) = split.shown(side)
+                {
+                    return self.update(AppMessage::TabActivate(tab));
+                }
+            }
+            Message::Scrolled(side) => self.follow_scroll(side),
+        }
+        Task::none()
+    }
+
+    /// The tab the left view shows after `moving` leaves it: the active tab, or its neighbour
+    /// when the active tab is the one moving.
+    fn left_shown_after_move(&self, tabs: &[Entity], moving: Entity) -> Option<Entity> {
+        let active = self.tab_model.active();
+        if active != moving {
+            return Some(active);
+        }
+        crate::close_tabs::next_active(tabs, &[moving], moving)
+    }
+
+    /// Scroll the other view by as many lines as this one moved.
+    fn follow_scroll(&mut self, side: Side) {
+        if !self.config.sync_scroll_views {
+            return;
+        }
+        let Some(split) = &mut self.split else {
+            return;
+        };
+        let (Some(this), Some(other)) = (split.shown(side), split.shown(side.other())) else {
+            return;
+        };
+        let Some((_, tops)) = &mut split.scroll_base else {
+            return;
+        };
+        let to = top_line(&self.tab_model, this);
+        let from = tops[side.index()];
+        if to == from {
+            return;
+        }
+        let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(other) else {
+            return;
+        };
+        let other_top = {
+            let mut editor = tab.editor.lock().unwrap();
+            editor.with_buffer_mut(|buffer| {
+                let mut scroll = buffer.scroll();
+                scroll.line = follow_scroll(scroll.line, from, to, buffer.lines.len());
+                buffer.set_scroll(scroll);
+                scroll.line
+            })
+        };
+        tops[side.index()] = to;
+        tops[side.other().index()] = other_top;
+    }
+}
+
+fn top_line(tabs: &SingleSelectModel, tab: Entity) -> usize {
+    match tabs.data::<Tab>(tab) {
+        Some(Tab::Editor(tab)) => tab
+            .editor
+            .lock()
+            .unwrap()
+            .with_buffer(|buffer| buffer.scroll().line),
+        _ => 0,
+    }
+}
+
+/// The view of each saved tab and the shown tab of the inactive view, for the session.
+pub fn session_views(split: Option<&Split>, tabs: &[Entity]) -> (Vec<u8>, Option<Entity>) {
+    let Some(split) = split else {
+        return (vec![0; tabs.len()], None);
+    };
+    let views = tabs
+        .iter()
+        .map(|tab| u8::from(split.side_of(*tab) == Some(Side::Right)))
+        .collect();
+    (views, split.shown(split.active.other()))
+}
+
+/// The split a restored session asks for: tabs with view 1 go right. `None` when one view would
+/// be empty (old sessions have every tab in view 0).
+pub fn restore_split(
+    tabs: &[(Entity, u8)],
+    active: Option<Entity>,
+    other_shown: Option<Entity>,
+) -> Option<Split> {
+    let right: Vec<Entity> = tabs
+        .iter()
+        .filter(|(_, v)| *v == 1)
+        .map(|(t, _)| *t)
+        .collect();
+    if right.is_empty() || right.len() == tabs.len() {
+        return None;
+    }
+    let mut split = Split {
+        left: SingleSelectModel::default(),
+        right: SingleSelectModel::default(),
+        active: Side::Left,
+        scroll_base: None,
+    };
+    for (tab, view) in tabs {
+        split.insert(if *view == 1 { Side::Right } else { Side::Left }, *tab);
+    }
+    for shown in [other_shown, active].into_iter().flatten() {
+        if let Some(side) = split.side_of(shown) {
+            let display = split.display(side, shown).unwrap();
+            split.model_mut(side).activate(display);
+            split.active = side;
+        }
+    }
+    Some(split)
+}

+    fn tab_dragged_to_other_view_is_the_one_under_the_pointer() {
+        let (_, t) = tabs(3);
+        let mut split = Split::new(&t, t[2], Some(t[1]));
+        let display = |split: &Split, side, tab| split.display(side, tab).unwrap();
+        // The source bar reports the dragged tab first, then whatever it passes over

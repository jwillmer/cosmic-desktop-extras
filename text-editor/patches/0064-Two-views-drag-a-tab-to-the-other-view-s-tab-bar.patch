+    /// A tab drag reported a drop hint over `display` in `side`: the first one names the tab
+    /// being dragged.
+    pub fn drag_hint(&mut self, side: Side, display: Option<Entity>) {
+        if self.drag_source.is_none()
+            && let Some(tab) = display.and_then(|display| self.tab(side, display))
+        {
+            self.drag_source = Some((side, tab));
+        }
+    }
+
+    /// A tab drag ended on `display` in `side`: the dragged tab and the tab it was dropped on,
+    /// when it came from the other view.
+    pub fn drop_on(&mut self, side: Side, display: Entity) -> Option<(Entity, Entity)> {
+        let (from, tab) = self.drag_source.take()?;
+        let target = self.tab(side, display)?;
+        (from != side && self.side_of(tab) == Some(from)).then_some((tab, target))
+    }

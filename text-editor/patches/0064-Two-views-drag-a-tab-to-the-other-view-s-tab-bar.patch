+pub const TAB_MIME: &str = "x-cosmic-edit/view-tab";
+
+#[derive(Clone, Debug)]
+pub struct TabDrag;
+
+impl AllowedMimeTypes for TabDrag {
+    fn allowed() -> Cow<'static, [String]> {
+        Cow::Owned(vec![TAB_MIME.to_string()])
+    }

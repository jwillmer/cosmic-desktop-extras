+    /// Find next of `pattern` (regex mode) from the start of `text` `steps` times, the way the
+    /// find bar picks the search, with `range` ("In selection"): where each lands
+    fn find_steps(
+        text: &str,
+        pattern: &str,
+        range: Option<(super::Pos, super::Pos)>,
+        steps: usize,
+    ) -> Vec<(usize, usize)> {
+        let tab = tab_with(text);
+        let (regex, joined) = regex_query(pattern);
+        (0..steps)
+            .map(|_| {
+                match (range, joined) {
+                    (Some(range), joined) => tab.search_in_range(&regex, joined, range, true, true),
+                    (None, Some(real_endings)) => {
+                        tab.search_joined(&regex, real_endings, true, true)
+                    }
+                    (None, None) => tab.search(&regex, true, true),
+                };
+                let cursor = tab.editor.lock().unwrap().cursor();
+                (cursor.line, cursor.index)
+            })
+            .collect()
+    }
+
+    #[test]
+    fn find_next_steps_over_empty_matches() {
+        let text = "ab\n\ncd";
+        // `^` from line to line, as in Notepad++, then around
+        let lines = vec![(0, 0), (1, 0), (2, 0), (0, 0)];
+        assert_eq!(find_steps(text, "^", None, 4), lines);
+        // The same across lines and inside a range
+        assert_eq!(find_steps(text, r"^|\n\n", None, 2), vec![(0, 0), (0, 2)]);
+        assert_eq!(
+            find_steps(text, "^", Some(((1, 0), (2, 2))), 3),
+            vec![(1, 0), (2, 0), (1, 0)]
+        );
+        // `x*`: no empty match right after a match
+        assert_eq!(
+            find_steps("axxb", "x*", None, 4),
+            vec![(0, 0), (0, 1), (0, 4), (0, 0)]
+        );
+    }
+

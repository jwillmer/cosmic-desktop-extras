+/// The drag-and-drop id of a whole view: the same in every frame, so the offer of a drag that
+/// entered in one frame reaches it in the next. Far above libcosmic's counted widget ids.
+pub fn drop_id(side: Side) -> u64 {
+    u64::MAX - 0xED17 - side.index() as u64
+}

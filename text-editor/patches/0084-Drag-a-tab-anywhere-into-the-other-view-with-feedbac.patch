+    /// The tab a drop in `side` moves there: one dragged from the other view.
+    fn moves_to(&self, side: Side) -> Option<Entity> {
+        let (from, tab) = self.drag_source.or_else(|| {
+            let from = self.drag_from?;
+            Some((from, self.shown(from)?))
+        })?;
+        (from != side && self.side_of(tab) == Some(from)).then_some(tab)
+    }
+
+    /// A drag entered or left a view.
+    pub fn drag_over(&mut self, side: Side, inside: bool) {
+        if inside {
+            self.drag_over = Some(side);
+            self.drag_from.get_or_insert(side);
+        } else if self.drag_over == Some(side) {
+            self.drag_over = None;
+        }
+    }
+
+    /// The view to highlight while a tab is dragged: the one a drop moves it to.
+    pub fn drop_highlight(&self) -> Option<Side> {
+        self.drag_over.filter(|side| self.moves_to(*side).is_some())
+    }
+
+    /// The drag is over (a drop, Esc, a drop outside the views).
+    pub fn forget_drag(&mut self) {
+        self.drag_source = None;
+        self.drag_over = None;
+        self.drag_from = None;
+    }
+
+    /// A tab drag ended anywhere in `side`: the dragged tab, when it came from the other view,
+    /// and the last tab of `side`, which it goes after.
+    pub fn drop_into(&mut self, side: Side) -> Option<(Entity, Option<Entity>)> {
+        let tab = self.moves_to(side);
+        self.forget_drag();
+        Some((tab?, self.tabs(side).last().copied()))
     }
 

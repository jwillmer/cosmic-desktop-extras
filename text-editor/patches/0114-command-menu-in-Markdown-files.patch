+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The popup of the "/" command menu (see `slash_menu`): an overlay above the whole window, so
+//! the editor area never clips it. It sits below the "/" (above it when there is no room
+//! below, shifted left at the right edge), shows at most `MAX_ROWS` items and scrolls, follows
+//! the mouse and picks on a click. Keys stay with `text_box`, which owns the editor.
+
+use cosmic::widget::segmented_button::Entity;
+use cosmic::{
+    Renderer,
+    iced::{
+        Color, Point, Rectangle, Shadow, Size, Vector,
+        core::{
+            Border, Clipboard, Layout, Shell, layout, overlay,
+            renderer::{self, Quad, Renderer as _},
+            text::{self, Paragraph as _, Renderer as _},
+        },
+        event::Event,
+        mouse::{self, Button, Event as MouseEvent, ScrollDelta},
+    },
+    theme::Theme,
+};
+use cosmic_text::ViEditor;
+use std::sync::Mutex;
+
+use crate::slash_menu::{ITEMS, Item, Menu};
+
+/// The most rows shown at once; more scroll.
+pub const MAX_ROWS: usize = 8;
+const MIN_W: f32 = 200.0;
+const MAX_W: f32 = 360.0;
+/// Room around the popup for its shadow, inside the overlay's layer.
+const SHADOW_MARGIN: f32 = 20.0;
+
+/// The open menu, kept in the text box's state.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Open {
+    pub menu: Menu,
+    /// The first row shown.
+    pub first: usize,
+    /// The editor the menu belongs to: another tab in the same text box closes it.
+    pub editor: EditorId,
+    /// Wheel movement short of a whole row, in rows.
+    pub wheel: f32,
+    /// The highlight follows the mouse (hover look) rather than the keys (accent look).
+    pub hover: bool,
+}
+
+/// Which editor a menu belongs to: its tab when the text box knows it (a tab id is never
+/// reused), and the editor's address, which tells tabs apart otherwise.
+pub type EditorId = (Option<Entity>, usize);
+
+/// The measured widths of every item's label and hint, by index into `ITEMS`: measured once per
+/// open menu, not on every layout.
+pub type Widths = Vec<(f32, f32)>;
+
+/// Where a popup of `size` goes for an anchor (the line box of the "/") inside a window of
+/// `window`: below the anchor, above it when only there it fits, else on the roomier side;
+/// shifted left so it ends at the window's right edge, never past its left edge.
+pub fn place(anchor: Rectangle, size: Size, window: Size) -> Point {
+    let x = anchor.x.min(window.width - size.width).max(0.0);
+    let below = anchor.y + anchor.height;
+    let above = anchor.y - size.height;
+    let y = if below + size.height <= window.height {
+        below
+    } else if above >= 0.0 || anchor.y > window.height - below {
+        above.max(0.0)
+    } else {
+        // Neither fits: keep as much as possible in the window
+        below.min(window.height - size.height).max(0.0)
+    };
+    Point::new(x, y)
+}
+
+/// The first row to show so that row `selected` of `count` is visible, scrolling as little as
+/// possible from `first`.
+pub fn scroll_to_show(first: usize, selected: usize, count: usize) -> usize {
+    let visible = count.min(MAX_ROWS);
+    let first = first.min(count - visible);
+    if selected < first {
+        selected
+    } else if selected >= first + visible {
+        selected + 1 - visible
+    } else {
+        first
+    }
+}
+
+/// The highlighted row after the list changed: the item highlighted before (`prev`) if it is
+/// still listed, else the first.
+pub fn keep_highlight<T: PartialEq>(prev: Option<T>, items: impl IntoIterator<Item = T>) -> usize {
+    prev.and_then(|prev| items.into_iter().position(|item| item == prev))
+        .unwrap_or(0)
+}
+
+/// An item's identity across filterings.
+pub fn item_id(item: &'static Item) -> *const Item {
+    item
+}
+
+/// Sizes taken from the theme and the font.
+#[derive(Clone, Copy)]
+struct Metrics {
+    text_size: f32,
+    row_h: f32,
+    pad: f32,
+    row_pad_x: f32,
+    gap: f32,
+}
+
+pub struct Popup<'a, Message> {
+    open: &'a mut Option<Open>,
+    widths: &'a mut Widths,
+    editor: &'a Mutex<ViEditor<'static, 'static>>,
+    items: Vec<&'static Item>,
+    anchor: Rectangle,
+    on_changed: Option<Message>,
+    pick: Box<dyn Fn(&mut ViEditor<'static, 'static>, &Item) + 'a>,
+    metrics: Metrics,
+}
+
+impl<'a, Message: Clone + 'a> Popup<'a, Message> {
+    /// `anchor` is the line box of the "/" in window coordinates; `pick` applies an item.
+    pub fn new(
+        open: &'a mut Option<Open>,
+        widths: &'a mut Widths,
+        editor: &'a Mutex<ViEditor<'static, 'static>>,
+        items: Vec<&'static Item>,
+        anchor: Rectangle,
+        on_changed: Option<Message>,
+        pick: Box<dyn Fn(&mut ViEditor<'static, 'static>, &Item) + 'a>,
+        renderer: &Renderer,
+    ) -> overlay::Element<'a, Message, Theme, Renderer> {
+        // Not in `layout`: the runtime draws a fresh overlay with the layout of an earlier one
+        let spacing = cosmic::theme::spacing();
+        let text_size = renderer.default_size().0;
+        let line_h = text::LineHeight::default().to_absolute(text_size.into()).0;
+        let metrics = Metrics {
+            text_size,
+            row_h: (line_h + 2.0 * f32::from(spacing.space_xxs)).round(),
+            pad: f32::from(spacing.space_xxs),
+            row_pad_x: f32::from(spacing.space_s),
+            gap: f32::from(spacing.space_l),
+        };
+        overlay::Element::new(Box::new(Self {
+            open,
+            widths,
+            editor,
+            items,
+            anchor,
+            on_changed,
+            pick,
+            metrics,
+        }))
+    }
+
+    fn first(&self) -> usize {
+        let count = self.items.len();
+        self.open
+            .map_or(0, |open| open.first.min(count - count.min(MAX_ROWS)))
+    }
+
+    /// The popup itself, without the shadow margin.
+    fn inner(layout: Layout<'_>) -> Rectangle {
+        layout.bounds().shrink(SHADOW_MARGIN)
+    }
+
+    /// The item row under `p`, as an index into `items`.
+    fn row_at(&self, layout: Layout<'_>, p: Point) -> Option<usize> {
+        let inner = Self::inner(layout);
+        if !inner.contains(p) {
+            return None;
+        }
+        let row = ((p.y - inner.y - self.metrics.pad) / self.metrics.row_h).floor();
+        let index = self.first() + row.max(0.0) as usize;
+        (row >= 0.0 && index < self.items.len() && (row as usize) < MAX_ROWS).then_some(index)
+    }
+
+    fn text(&self, content: &str, renderer: &Renderer) -> cosmic::iced::core::Text<String> {
+        cosmic::iced::core::Text {
+            content: content.to_string(),
+            bounds: Size::INFINITE,
+            size: self.metrics.text_size.into(),
+            line_height: text::LineHeight::default(),
+            font: renderer.default_font(),
+            align_x: text::Alignment::Left,
+            align_y: cosmic::iced::core::alignment::Vertical::Center,
+            shaping: text::Shaping::Advanced,
+            wrapping: text::Wrapping::None,
+            ellipsize: Default::default(),
+        }
+    }
+}
+
+impl<'a, Message: Clone + 'a> overlay::Overlay<Message, Theme, Renderer> for Popup<'a, Message> {
+    fn layout(&mut self, renderer: &Renderer, bounds: Size) -> layout::Node {
+        let m = self.metrics;
+        if self.widths.len() != ITEMS.len() {
+            let measure = |s: &str| {
+                let text = self.text(s, renderer);
+                <Renderer as text::Renderer>::Paragraph::with_text(text.with_content(s)).min_width()
+            };
+            let widths = ITEMS
+                .iter()
+                .map(|item| (measure(item.label()), measure(item.hint())))
+                .collect();
+            *self.widths = widths;
+        }
+        let content_w = self
+            .items
+            .iter()
+            .map(|item| {
+                let (label_w, hint_w) = self.widths[item.index()];
+                label_w + m.gap + hint_w
+            })
+            .fold(0.0, f32::max);
+        let width = (content_w + 2.0 * (m.pad + m.row_pad_x))
+            .ceil()
+            .clamp(MIN_W, MAX_W);
+        let rows = self.items.len().min(MAX_ROWS);
+        let size = Size::new(width, rows as f32 * m.row_h + 2.0 * m.pad);
+        // Labels line up with the "/"
+        let anchor = Rectangle {
+            x: self.anchor.x - m.pad - m.row_pad_x,
+            ..self.anchor
+        };
+        let origin = place(anchor, size, bounds);
+        layout::Node::new(Size::new(
+            size.width + 2.0 * SHADOW_MARGIN,
+            size.height + 2.0 * SHADOW_MARGIN,
+        ))
+        .move_to(origin - Vector::new(SHADOW_MARGIN, SHADOW_MARGIN))
+    }
+
+    fn draw(
+        &self,
+        renderer: &mut Renderer,
+        theme: &Theme,
+        _style: &renderer::Style,
+        layout: Layout<'_>,
+        _cursor: mouse::Cursor,
+    ) {
+        let Some(open) = *self.open else {
+            return;
+        };
+        let cosmic = theme.cosmic();
+        let component = &cosmic.background(false).component;
+        let m = self.metrics;
+        let inner = Self::inner(layout);
+        renderer.fill_quad(
+            Quad {
+                bounds: inner,
+                border: Border {
+                    radius: cosmic.corner_radii.radius_s.into(),
+                    width: 1.0,
+                    color: component.divider.into(),
+                },
+                shadow: Shadow {
+                    color: cosmic.shade.into(),
+                    offset: Vector::new(0.0, 4.0),
+                    blur_radius: 16.0,
+                },
+                snap: true,
+            },
+            Color::from(component.base),
+        );
+
+        let first = self.first();
+        let selected = open.menu.selected.min(self.items.len() - 1);
+        let rows = self.items.iter().enumerate().skip(first).take(MAX_ROWS);
+        for (i, (index, item)) in rows.enumerate() {
+            let row = Rectangle::new(
+                Point::new(inner.x + m.pad, inner.y + m.pad + i as f32 * m.row_h),
+                Size::new(inner.width - 2.0 * m.pad, m.row_h),
+            );
+            // Like the stock COSMIC menus: hover colour under the mouse, accent for the keys
+            let (color, dim) = if index == selected && open.hover {
+                renderer.fill_quad(
+                    Quad {
+                        bounds: row,
+                        border: Border {
+                            radius: cosmic.corner_radii.radius_s.into(),
+                            ..Default::default()
+                        },
+                        ..Default::default()
+                    },
+                    Color::from(component.hover),
+                );
+                (
+                    Color::from(component.on),
+                    Color::from(component.on).scale_alpha(0.6),
+                )
+            } else if index == selected {
+                renderer.fill_quad(
+                    Quad {
+                        bounds: row,
+                        border: Border {
+                            radius: cosmic.corner_radii.radius_s.into(),
+                            ..Default::default()
+                        },
+                        ..Default::default()
+                    },
+                    Color::from(cosmic.accent.base),
+                );
+                (Color::from(cosmic.accent.on), Color::from(cosmic.accent.on))
+            } else {
+                (
+                    Color::from(component.on),
+                    Color::from(component.on).scale_alpha(0.6),
+                )
+            };
+            let width = self
+                .widths
+                .get(item.index())
+                .map_or(0.0, |(_, hint_w)| *hint_w);
+            renderer.fill_text(
+                cosmic::iced::core::Text {
+                    bounds: Size::new(width + 1.0, row.height),
+                    align_x: text::Alignment::Right,
+                    ..self.text(item.hint(), renderer)
+                },
+                Point::new(row.x + row.width - m.row_pad_x, row.center_y()),
+                dim.scale_alpha(if index == selected && !open.hover {
+                    0.8
+                } else {
+                    1.0
+                }),
+                row,
+            );
+            let hint_w = width + m.gap;
+            let label_w = (row.width - 2.0 * m.row_pad_x - hint_w).max(0.0);
+            renderer.fill_text(
+                cosmic::iced::core::Text {
+                    bounds: Size::new(label_w, row.height),
+                    ellipsize: text::Ellipsize::End(text::EllipsizeHeightLimit::Lines(1)),
+                    ..self.text(item.label(), renderer)
+                },
+                Point::new(row.x + m.row_pad_x, row.center_y()),
+                color,
+                row,
+            );
+        }
+    }
+
+    fn update(
+        &mut self,
+        event: &Event,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        _renderer: &Renderer,
+        _clipboard: &mut dyn Clipboard,
+        shell: &mut Shell<'_, Message>,
+    ) {
+        let over = cursor
+            .position()
+            .filter(|p| Self::inner(layout).contains(*p));
+        let row = over.and_then(|p| self.row_at(layout, p));
+        let count = self.items.len();
+        let Some(open) = self.open.as_mut() else {
+            return;
+        };
+        match event {
+            Event::Mouse(MouseEvent::CursorMoved { .. }) => {
+                if let Some(index) = row
+                    && (index != open.menu.selected || !open.hover)
+                {
+                    open.menu.selected = index;
+                    open.hover = true;
+                    shell.request_redraw();
+                }
+            }
+            Event::Mouse(MouseEvent::ButtonPressed(button)) => {
+                if over.is_none() {
+                    // A click elsewhere closes the menu and goes on to whatever is there
+                    *self.open = None;
+                    shell.request_redraw();
+                    return;
+                }
+                if *button == Button::Left
+                    && let Some(index) = row
+                {
+                    let mut editor = self.editor.lock().unwrap();
+                    (self.pick)(&mut editor, self.items[index]);
+                    *self.open = None;
+                    if let Some(on_changed) = &self.on_changed {
+                        shell.publish(on_changed.clone());
+                    }
+                    shell.request_redraw();
+                }
+                shell.capture_event();
+            }
+            Event::Mouse(MouseEvent::ButtonReleased(_)) if over.is_some() => {
+                shell.capture_event();
+            }
+            Event::Mouse(MouseEvent::WheelScrolled { delta }) if over.is_some() => {
+                // Whole rows; touchpad pixels add up until they make one
+                let rows = match delta {
+                    ScrollDelta::Lines { y, .. } => {
+                        open.wheel = 0.0;
+                        -y.signum() * y.abs().ceil()
+                    }
+                    ScrollDelta::Pixels { y, .. } => {
+                        open.wheel -= y / self.metrics.row_h;
+                        let rows = open.wheel.trunc();
+                        open.wheel -= rows;
+                        rows
+                    }
+                };
+                shell.capture_event();
+                if rows == 0.0 {
+                    return;
+                }
+                let step = rows.abs() as usize;
+                let max = count - count.min(MAX_ROWS);
+                let first = open.first.min(max);
+                open.first = if rows < 0.0 {
+                    first.saturating_sub(step)
+                } else {
+                    (first + step).min(max)
+                };
+                // The highlight stays under the pointer
+                if let Some(index) = row {
+                    open.menu.selected = (index - first + open.first).min(count - 1);
+                    open.hover = true;
+                }
+                shell.request_redraw();
+                shell.capture_event();
+            }
+            _ => (),
+        }
+    }
+
+    fn mouse_interaction(
+        &self,
+        layout: Layout<'_>,
+        cursor: mouse::Cursor,
+        _renderer: &Renderer,
+    ) -> mouse::Interaction {
+        match cursor.position() {
+            Some(p) if self.row_at(layout, p).is_some() => mouse::Interaction::Pointer,
+            Some(p) if Self::inner(layout).contains(p) => mouse::Interaction::Idle,
+            _ => mouse::Interaction::None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const WINDOW: Size = Size::new(800.0, 600.0);
+    const POPUP: Size = Size::new(200.0, 300.0);
+
+    fn anchor(x: f32, y: f32) -> Rectangle {
+        Rectangle::new(Point::new(x, y), Size::new(1.0, 20.0))
+    }
+
+    #[test]
+    fn below_the_slash_when_it_fits() {
+        assert_eq!(
+            place(anchor(100.0, 50.0), POPUP, WINDOW),
+            Point::new(100.0, 70.0)
+        );
+        // Exactly fits
+        assert_eq!(
+            place(anchor(100.0, 280.0), POPUP, WINDOW),
+            Point::new(100.0, 300.0)
+        );
+    }
+
+    #[test]
+    fn flips_above_near_the_bottom() {
+        assert_eq!(
+            place(anchor(100.0, 500.0), POPUP, WINDOW),
+            Point::new(100.0, 200.0)
+        );
+    }
+
+    #[test]
+    fn roomier_side_when_neither_fits() {
+        let window = Size::new(800.0, 400.0);
+        // 250 above, 130 below: above, pinned to the top
+        assert_eq!(
+            place(anchor(10.0, 250.0), POPUP, window),
+            Point::new(10.0, 0.0)
+        );
+        // 100 above, 280 below: below, moved up to end at the window's bottom
+        assert_eq!(
+            place(anchor(10.0, 100.0), POPUP, window),
+            Point::new(10.0, 100.0)
+        );
+    }
+
+    #[test]
+    fn shifted_left_at_the_right_edge() {
+        assert_eq!(
+            place(anchor(700.0, 50.0), POPUP, WINDOW),
+            Point::new(600.0, 70.0)
+        );
+        // Never past the left edge, even when wider than the window
+        assert_eq!(
+            place(anchor(5.0, 50.0), Size::new(900.0, 100.0), WINDOW).x,
+            0.0
+        );
+        assert_eq!(place(anchor(-8.0, 50.0), POPUP, WINDOW).x, 0.0);
+    }
+
+    #[test]
+    fn scrolls_just_enough_to_show_the_highlight() {
+        // Fits: never scrolls
+        assert_eq!(scroll_to_show(0, 4, 5), 0);
+        assert_eq!(scroll_to_show(3, 4, 5), 0);
+        // Down past the last visible row
+        assert_eq!(scroll_to_show(0, 7, 13), 0);
+        assert_eq!(scroll_to_show(0, 8, 13), 1);
+        assert_eq!(scroll_to_show(0, 12, 13), 5);
+        // Up above the first visible row, and wrapping to the top
+        assert_eq!(scroll_to_show(5, 3, 13), 3);
+        assert_eq!(scroll_to_show(5, 0, 13), 0);
+        // A shorter list clamps a stale scroll position
+        assert_eq!(scroll_to_show(5, 9, 10), 2);
+    }
+
+    #[test]
+    fn highlight_stays_on_its_item() {
+        // Still listed, at another row
+        assert_eq!(keep_highlight(Some("Table"), ["Task list", "Table"]), 1);
+        // Filtered out, or nothing highlighted before: the first
+        assert_eq!(keep_highlight(Some("Quote"), ["Task list", "Table"]), 0);
+        assert_eq!(keep_highlight(None, ["Task list", "Table"]), 0);
+    }
+
+    #[test]
+    fn item_ids_survive_filtering() {
+        let table = crate::slash_menu::filter("table")[0];
+        let all = crate::slash_menu::filter("");
+        let index = keep_highlight(Some(item_id(table)), all.iter().map(|i| item_id(i)));
+        assert!(std::ptr::eq(all[index], table));
+    }
+}

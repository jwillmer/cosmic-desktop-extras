+    let at = |(below, index): slash_menu::RelPos| Cursor::new(line + below, index);
+    editor.start_change();
+    editor.set_selection(Selection::None);
+    editor.delete_range(Cursor::new(line, edit.start), Cursor::new(line, edit.end));
+    let text = match ending {

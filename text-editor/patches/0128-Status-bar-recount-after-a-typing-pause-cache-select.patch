+/// The characters (`None` above [`SELECTION_COUNT_BYTES`]) and lines between `start` and `end`,
+/// as [`selection_counts`] counts them. The size is summed first, which only reads lengths.
+pub fn selection_size<'a, I: Iterator<Item = &'a str> + Clone>(
+    lines: I,
+    start: Cursor,
+    end: Cursor,
+) -> (Option<usize>, usize) {
+    let (first, last) = if end.line < start.line {
+        (end.line, start.line)
+    } else {
+        (start.line, end.line)
+    };
+    let mut bytes = 0;
+    for text in lines.clone().skip(first).take(last - first + 1) {
+        bytes += text.len();
+        if bytes > SELECTION_COUNT_BYTES {
+            return (None, last - first + 1);
+        }
+    }
+    let (chars, lines) = selection_counts(lines, start, end);
+    (Some(chars), lines)
+}
+
+/// The text for a selection's [`selection_size`]
+pub fn selection_size_text((chars, lines): (Option<usize>, usize)) -> String {
+    match chars {
+        Some(chars) => selection_text(chars, lines),
+        None => selection_lines_text(lines),
+    }
+}
+
+/// The size of one tab's selection, kept while the text and the selection stay the same, so
+/// a view rebuilt for other reasons does not count it again.
+#[derive(Debug, Default)]
+pub struct SelectionCache {
+    cached: Option<(SelectionKey, (Option<usize>, usize))>,
+    scans: usize,
+}
+
+/// Text generation, start and end (line, index) of a selection
+type SelectionKey = (u64, (usize, usize), (usize, usize));
+
+impl SelectionCache {
+    /// The [`selection_size`] of the selection from `start` to `end` in text generation
+    /// `generation`, counting the lines `lines` returns only when one of them differs from the
+    /// last call
+    pub fn get<'a, I: Iterator<Item = &'a str> + Clone>(
+        &mut self,
+        generation: u64,
+        start: Cursor,
+        end: Cursor,
+        lines: impl FnOnce() -> I,
+    ) -> (Option<usize>, usize) {
+        let key = (generation, (start.line, start.index), (end.line, end.index));
+        if let Some((cached_key, size)) = self.cached
+            && cached_key == key
+        {
+            return size;
+        }
+        let size = selection_size(lines(), start, end);
+        self.scans += 1;
+        self.cached = Some((key, size));
+        size
+    }
+}

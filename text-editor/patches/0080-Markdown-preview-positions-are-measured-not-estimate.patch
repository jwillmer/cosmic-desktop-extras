+/// Where the preview drew its top-level elements, measured after layout: pairs of source line
+/// and position, in pixels from the top of the preview's content. Between two of them a line
+/// takes its share of the space by its estimated height, so the estimate only spreads a block's
+/// measured height over its lines.
+#[derive(Debug, Default, PartialEq)]
+pub struct Anchors {
+    points: Vec<(usize, f32)>,
+    height: f32,
+}
+
+impl Anchors {
+    /// `lines` and `tops` of the drawn elements in order, `None` where unknown; `height` of all
+    /// content. Points out of order (footnotes drawn at the end) are left out.
+    pub fn new(lines: &[Option<usize>], tops: &[Option<f32>], height: f32) -> Self {
+        let mut points: Vec<(usize, f32)> = Vec::with_capacity(lines.len());
+        for (line, top) in lines.iter().zip(tops) {
+            let (Some(line), Some(top)) = (*line, *top) else {
+                continue;
+            };
+            if points
+                .last()
+                .is_none_or(|&(last, y)| line > last && top >= y)
+            {
+                points.push((line, top));
+            }
+        }
+        Self { points, height }
+    }
+
+    /// The anchors around `index`, a position in `points` from a partition: the one before
+    /// (else the top of the document) and the one after (else its end).
+    fn segment(&self, index: usize, heights: &Heights) -> ((usize, f32), (usize, f32)) {
+        let lines = heights.0.len().saturating_sub(1);
+        let before = index
+            .checked_sub(1)
+            .map_or((0, 0.0), |index| self.points[index]);
+        let after = self
+            .points
+            .get(index)
+            .copied()
+            .unwrap_or((lines, self.height));
+        (before, after)
+    }
+
+    /// How far down the content source `line` is drawn, in pixels.
+    pub fn y(&self, heights: &Heights, line: usize) -> f32 {
+        let line = line.min(heights.0.len().saturating_sub(1));
+        let index = self.points.partition_point(|&(start, _)| start <= line);
+        let ((a, top_a), (b, top_b)) = self.segment(index, heights);
+        let (above_a, above_b) = (heights.0[a], heights.0[b.max(a)]);
+        let share = if above_b > above_a {
+            (heights.0[line] - above_a) / (above_b - above_a)
+        } else {
+            0.0
+        };
+        top_a + share.clamp(0.0, 1.0) * (top_b - top_a)
+    }
+
+    /// The source line drawn `y` pixels down the content: the inverse of [`Self::y`], to the
+    /// line.
+    pub fn line(&self, heights: &Heights, y: f32) -> usize {
+        let index = self.points.partition_point(|&(_, top)| top <= y);
+        let ((a, top_a), (b, top_b)) = self.segment(index, heights);
+        if b <= a {
+            return a;
+        }
+        let share = if top_b > top_a {
+            ((y - top_a) / (top_b - top_a)).clamp(0.0, 1.0)
+        } else {
+            0.0
+        };
+        let target = heights.0[a] + share * (heights.0[b] - heights.0[a]);
+        // The last line of the segment that starts at or above the target
+        a + heights.0[a..b]
+            .partition_point(|above| *above <= target)
+            .saturating_sub(1)
+    }
+}

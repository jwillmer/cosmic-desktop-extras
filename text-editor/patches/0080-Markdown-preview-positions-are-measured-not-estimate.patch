+/// Draw the document; each top-level element (see [`anchors`]) is wrapped in a container with
+/// the next of `ids`, so its position can be measured.
+pub fn view_document<'a>(
+    document: &'a Document,
+    settings: Settings,
+    viewer: &PreviewViewer<'a>,
+    open: &HashSet<DetailsKey>,
+    ids: &[widget::Id],
+) -> Element<'a, AppMessage> {
+    let mut elements = Vec::new();

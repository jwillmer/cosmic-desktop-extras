+/// Source byte offset of each element the top level of the preview is drawn as, in order, `None`
+/// when unknown: the elements [`view_document`] measures.
+pub fn anchors(document: &Document) -> Vec<Option<usize>> {
+    let mut anchors = Vec::new();
+    for (block, starts) in document.blocks.iter().zip(&document.starts) {
+        match block {
+            Block::Markdown(content) if split_items(content, starts) => {
+                anchors.extend(starts.iter().copied().map(Some));
+            }
+            _ => anchors.push(starts.first().copied()),
+        }
+    }
+    anchors

+/// Finds where the containers with the given ids sit in the content of the scrollable `scroll`.
+struct Measure {
+    scroll: widget::Id,
+    ids: HashMap<widget::Id, usize>,
+    tops: Vec<Option<f32>>,
+    /// Top and height of the scrollable's content.
+    content: Option<(f32, f32)>,
+}
+
+impl Measure {
+    fn new(scroll: widget::Id, ids: &[widget::Id]) -> Self {
+        Self {
+            scroll,
+            ids: ids
+                .iter()
+                .enumerate()
+                .map(|(index, id)| (id.clone(), index))
+                .collect(),
+            tops: vec![None; ids.len()],
+            content: None,
+        }
+    }
+}
+
+impl iced::advanced::widget::Operation<(Vec<Option<f32>>, f32)> for Measure {
+    fn traverse(
+        &mut self,
+        operate: &mut dyn FnMut(
+            &mut dyn iced::advanced::widget::Operation<(Vec<Option<f32>>, f32)>,
+        ),
+    ) {
+        operate(self);
+    }
+
+    fn container(&mut self, id: Option<&widget::Id>, bounds: iced::Rectangle) {
+        if let Some(&index) = id.and_then(|id| self.ids.get(id)) {
+            self.tops[index] = Some(bounds.y);
+        }
+    }
+
+    fn scrollable(
+        &mut self,
+        id: Option<&widget::Id>,
+        _bounds: iced::Rectangle,
+        content_bounds: iced::Rectangle,
+        _translation: iced::Vector,
+        _state: &mut dyn iced::advanced::widget::operation::Scrollable,
+    ) {
+        if id == Some(&self.scroll) {
+            self.content = Some((content_bounds.y, content_bounds.height));
+        }
+    }
+
+    fn finish(&self) -> iced::advanced::widget::operation::Outcome<(Vec<Option<f32>>, f32)> {
+        use iced::advanced::widget::operation::Outcome;
+        // Not drawn (another tab, hidden): nothing measured
+        let Some((top, height)) = self.content else {
+            return Outcome::None;
+        };
+        let tops = self.tops.iter().map(|y| y.map(|y| y - top)).collect();
+        Outcome::Some((tops, height))
+    }
+}

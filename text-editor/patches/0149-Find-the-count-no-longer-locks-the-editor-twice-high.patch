From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Fri, 20 Nov 2026 01:05:38 +0100
Subject: [PATCH 149/151] Find: the count no longer locks the editor twice;
 highlights and Replace use the same In-selection scope

The count took the editor lock and then read the In-selection scope, which locks
the same editor again: the app froze as soon as the find bar had a query. The
scope is now read before the lock. The range shading uses the same scope as the
count and Replace all, and a single Replace no longer turns a stale range into
the match it is about to replace.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main.rs b/src/main.rs
index 574c25e..c195659 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -1321,6 +1321,8 @@ impl App {
         let Some(Tab::Editor(tab)) = self.tab_model.data::<Tab>(entity) else {
             return None;
         };
+        // Before the editor lock below: the scope reads the selection under its own lock
+        let scope = self.find_scope();
         let editor = tab.editor.lock().unwrap();
         let cursor = editor.cursor();
         let anchor = match editor.selection() {
@@ -1352,7 +1354,7 @@ impl App {
         });
         // "In selection": only the matches inside its range
         let clipped;
-        let matches = match self.find_scope() {
+        let matches = match scope {
             find_range::Scope::Range(range) => {
                 clipped = find_range::clip(matches, range);
                 &clipped
@@ -2198,12 +2200,13 @@ impl App {
                 {
                     text_box = text_box.find_matches(regex, self.find_joined());
                 }
+                // The same scope as the count and Replace all (a stale range gives way to
+                // the selection); only the active tab has one
                 if self.find_opt.is_some()
-                    && let Some(range) = self.find_range
-                    && range.tab == tab_id
-                    && range.generation == tab.generation.current
+                    && tab_id == self.tab_model.active()
+                    && let Some(range) = self.find_range()
                 {
-                    text_box = text_box.find_range((range.start, range.end));
+                    text_box = text_box.find_range(range);

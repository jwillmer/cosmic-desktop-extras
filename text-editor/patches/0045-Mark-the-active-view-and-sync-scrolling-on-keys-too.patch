From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Fri, 13 Nov 2026 09:48:13 +0100
Subject: [PATCH 045/111] Mark the active view, and sync scrolling on keys too

An accent line above the tab bar marks the active view.

Keys scroll the editor while it lays out (to keep the cursor visible), not
while it handles the key, so on_scroll missed PageUp/PageDown and arrows
past the edge. It now compares with the position it last reported, and the
next event (key release, redraw) reports such a scroll.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/src/main.rs b/src/main.rs
index 194f1fd..e2fe7b6 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -3558,7 +3558,19 @@ impl Application for App {
             }
             Some(split) => {
                 let pane = |side: views::Side| -> Element<'_, Message> {
-                    let mut pane = widget::column::with_capacity(2)
+                    // An accent line above the tab bar marks the active view
+                    let active = split.active == side;
+                    let marker =
+                        widget::container(widget::Space::new().width(Length::Fill).height(2))
+                            .class(theme::Container::custom(move |theme| {
+                                widget::container::Style {
+                                    background: active
+                                        .then(|| Color::from(theme.cosmic().accent_color()).into()),
+                                    ..Default::default()
+                                }
+                            }));
+                    let mut pane = widget::column::with_capacity(3)
+                        .push(marker)
                         .push(self.tab_bar(split.model(side), Some(side)));
                     if let Some(tab_id) = split.shown(side) {
                         pane = pane.push(self.tab_content(tab_id, Some(side)));
diff --git a/src/text_box.rs b/src/text_box.rs
index 56c33de..c3e9ec4 100644
--- a/src/text_box.rs
+++ b/src/text_box.rs
@@ -252,7 +252,7 @@ where
         self
     }
 
-    /// Published when an event moved the view up or down (wheel, keys, cursor motion).
+    /// Published when the view moved up or down (wheel, scroll bar, keys, cursor motion).
     pub fn on_scroll(mut self, on_scroll: Message) -> Self {
         self.on_scroll = Some(on_scroll);
         self
@@ -2373,10 +2373,18 @@ where
             }
         }
 
+        // Keys scroll during layout (to keep the cursor visible), so compare with the position
+        // last reported, not the one at the start of this event; the next event (key release,
+        // redraw) reports it
         if let Some(on_scroll) = &self.on_scroll {
             let scroll = editor.with_buffer(|buffer| buffer.scroll());
-            if (scroll.line, scroll.vertical) != (buffer_scroll.line, buffer_scroll.vertical) {
-                shell.publish(on_scroll.clone());
+            let scroll = Some((scroll.line, scroll.vertical));
+            let state = tree.state.downcast_ref::<State>();
+            if state.reported_scroll.get() != scroll {
+                if state.reported_scroll.get().is_some() {
+                    shell.publish(on_scroll.clone());
+                }
+                state.reported_scroll.set(scroll);
             }
         }
 
@@ -2425,6 +2433,8 @@ pub struct State {
     scale_factor: Cell<f32>,
     scrollbar_v_rect: Cell<Option<Rectangle<f32>>>,
     scrollbar_h_rect: Cell<Option<Rectangle<f32>>>,
+    /// The scroll position last reported by `on_scroll`.
+    reported_scroll: Cell<Option<(usize, f32)>>,
     handle_opt: Mutex<Option<image::Handle>>,
     shift_anchor: Mutex<Option<Cursor>>,
     caret_position: (i32, i32),
@@ -2447,6 +2457,7 @@ impl State {
             scale_factor: Cell::new(1.0),
             scrollbar_v_rect: Cell::new(None),
             scrollbar_h_rect: Cell::new(None),
+            reported_scroll: Cell::new(None),
             handle_opt: Mutex::new(None),
             shift_anchor: Mutex::new(None),
             caret_position: (0, 0),

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Tue, 10 Nov 2026 23:02:00 +0100
Subject: [PATCH 14/44] minimize: offer move to workspace when COSMIC
 advertises the old capability

The window menu showed no "Move to workspace" entries: the check wanted
the move_to_ext_workspace capability, but cosmic-comp binds the manager
at version 4 and advertises only move_to_workspace, while it handles the
move_to_ext_workspace request. At version 4 either capability now
enables the entries.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BLrpLktNVQBZowKMy1ebh2

diff --git a/cosmic-applet-minimize/src/wayland_handler.rs b/cosmic-applet-minimize/src/wayland_handler.rs
index a43be447..f5a92832 100644
--- a/cosmic-applet-minimize/src/wayland_handler.rs
+++ b/cosmic-applet-minimize/src/wayland_handler.rs
@@ -401,10 +401,8 @@ impl ToplevelManagerHandler for AppData {
         >,
     ) {
         // TODO capabilities could affect the options in the applet
-        let can_move = self.toplevel_manager_state.manager.version() >= 4
-            && capabilities.contains(&WEnum::Value(
-                zcosmic_toplevel_manager_v1::ZcosmicToplelevelManagementCapabilitiesV1::MoveToExtWorkspace,
-            ));
+        let can_move =
+            can_move_to_workspace(self.toplevel_manager_state.manager.version(), &capabilities);
         if can_move != self.can_move_to_workspace {
             self.can_move_to_workspace = can_move;
             self.send_workspaces();
@@ -571,6 +569,22 @@ impl WorkspaceHandler for AppData {
     }
 }
 
+/// Whether `move_to_ext_workspace` can be sent. It needs manager version 4. COSMIC handles it but
+/// advertises only the older `move_to_workspace` capability, so either one counts.
+fn can_move_to_workspace(
+    version: u32,
+    capabilities: &[WEnum<zcosmic_toplevel_manager_v1::ZcosmicToplelevelManagementCapabilitiesV1>],
+) -> bool {
+    use zcosmic_toplevel_manager_v1::ZcosmicToplelevelManagementCapabilitiesV1 as Capability;
+    version >= 4
+        && capabilities.iter().any(|capability| {
+            matches!(
+                capability,
+                WEnum::Value(Capability::MoveToExtWorkspace | Capability::MoveToWorkspace)
+            )
+        })
+}
+

index e5e749e2..e5947a00 100644
--- a/cosmic-applet-minimize/src/lib.rs
+++ b/cosmic-applet-minimize/src/lib.rs
@@ -432,6 +432,7 @@ impl Minimize {
             .iter()
             .map(|a| media::WindowRef {
                 app_id: &a.toplevel_info.app_id,
+                title: &a.toplevel_info.title,
                 // The toplevel protocols carry no pid.
                 pid: None,
                 active: self.last_focused.get(&a.toplevel_info.app_id)
diff --git a/cosmic-applet-minimize/src/media.rs b/cosmic-applet-minimize/src/media.rs
index f7219b63..0682f800 100644
--- a/cosmic-applet-minimize/src/media.rs
+++ b/cosmic-applet-minimize/src/media.rs
@@ -90,14 +90,18 @@ pub enum Event {
 #[derive(Debug, Clone, Copy)]
 pub struct WindowRef<'a> {
     pub app_id: &'a str,
+    /// The window title, to tell which of an app's windows plays the media.
+    pub title: &'a str,
     pub pid: Option<u32>,
     /// The app's focused, or last focused, window.
     pub active: bool,
 }
 
 /// Media shown on each window. A player goes to the windows of its desktop entry, else of its
-/// pid; when that leaves several, the one with its pid, else the app's active window. A playing
-/// player wins over a paused one.
+/// pid; when that leaves several, the one with its pid, else the one whose title contains the
+/// media title (the active one when several do), else none: one player can serve all windows of a
+/// process (Firefox), so the active window may not be the one playing. A playing player wins over
+/// a paused one.
 pub fn assign(players: &[Player], windows: &[WindowRef<'_>]) -> Vec<Option<Media>> {
     let mut media = vec![None; windows.len()];
     let mut players: Vec<(&Player, Media)> = players
@@ -138,7 +142,15 @@ fn window_of(player: &Player, windows: &[WindowRef<'_>]) -> Option<usize> {
     if with_pid.len() == 1 {
         return with_pid.first().copied();
     }
-    active_window(&candidates, windows)
+    let showing: Vec<usize> = candidates
+        .into_iter()
+        .filter(|&i| !player.title.is_empty() && windows[i].title.contains(&player.title))
+        .collect();
+    match showing.as_slice() {
+        [] => None,
+        [one] => Some(*one),
+        several => several.iter().copied().find(|&i| windows[i].active),
+    }
 }
 
 /// The active window among `candidates`, else the first.
@@ -392,11 +404,19 @@ mod tests {
     fn window(app_id: &str, pid: Option<u32>, active: bool) -> WindowRef<'_> {
         WindowRef {
             app_id,
+            title: "",
             pid,
             active,
         }
     }
 
+    fn titled<'a>(app_id: &'a str, title: &'a str, active: bool) -> WindowRef<'a> {
+        WindowRef {
+            title,
+            ..window(app_id, None, active)
+        }
+    }
+
     /// The title of the player each window shows.
     fn shown(players: &[Player], windows: &[WindowRef<'_>]) -> Vec<Option<String>> {
         assign(players, windows)

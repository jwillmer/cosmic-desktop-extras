+        let mut memory = Remembered::default();
+        // Both windows counted while window 2 was still on "Mail".
+        memory.note(1, Some(Window { tabs: 6, items: None }));
+        memory.note(2, Some(Window { tabs: 3, items: None }));
+        // Window 2 switched to "Notes"; the stale file still has it on "Mail".
+        let stale = vec![window("Notes", &["Docs"], 6), window("Mail", &[], 3)];
+        // The fresh file has both windows on "Notes".
+        let fresh = vec![window("Notes", &["Docs"], 6), window("Notes", &["Mail"], 3)];
+        let windows = [(1, "Notes", histories[0]), (2, "Notes", histories[1])];
+        [stale, fresh].map(|session| {
+            let found = matches(&session, &windows);
+            [1, 2].map(|key| {
+                let matched = match found[&key] {
+                    Match::Tabs(tabs) => Some(Window { tabs, items: None }),
+                    Match::Ambiguous => {

+/// Indexes of a window and the session window it takes, if any.
+fn best_claim<K>(
+    windows: &[(K, &[String])],
+    session: &[&SessionWindow],
+    score: impl Fn(&[String], &SessionWindow) -> usize,
+) -> Option<(usize, usize)> {
+    /// The index of the single highest value.
+    fn single_max(values: impl Iterator<Item = usize>) -> Option<usize> {
+        let mut best: Option<(usize, usize)> = None;
+        let mut tie = false;
+        for (i, v) in values.enumerate() {
+            match best {
+                Some((_, b)) if v < b => {}
+                Some((_, b)) if v == b => tie = true,
+                _ => {
+                    best = Some((i, v));
+                    tie = false;
+                }
+            }
+        }
+        best.filter(|_| !tie).map(|(i, _)| i)
     }
-    Ok(counts)
+
+    let best: Vec<Option<usize>> = windows
+        .iter()
+        .map(|(_, history)| single_max(session.iter().map(|w| score(history, w))))
+        .collect();
+    (0..session.len()).find_map(|j| {
+        // Windows that do not want `j` score 0, below any claim on it.
+        let claims = windows
+            .iter()
+            .zip(&best)
+            .map(|((_, history), &b)| {
+                if b == Some(j) { score(history, session[j]) + 1 } else { 0 }
+            });
+        let i = single_max(claims)?;
+        (best[i] == Some(j)).then_some((i, j))
+    })
 }
 

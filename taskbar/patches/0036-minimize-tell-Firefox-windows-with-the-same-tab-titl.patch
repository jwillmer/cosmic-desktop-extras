+/// Titles kept per window.
+const HISTORY: usize = 8;
+
+impl<K: Hash + Eq> TitleHistory<K> {
+    pub fn note(&mut self, window: K, title: &str) {
+        let titles = self.windows.entry(window).or_default();
+        if titles.last().is_some_and(|last| last == title) {
+            return;
+        }
+        titles.retain(|t| t != title);
+        titles.push(title.to_owned());
+        if titles.len() > HISTORY {
+            titles.remove(0);
+        }
+    }
+
+    pub fn get(&self, window: &K) -> &[String] {
+        self.windows.get(window).map_or(&[], Vec::as_slice)
+    }
+
+    pub fn remove(&mut self, window: &K) {
+        self.windows.remove(window);
+    }
+}

+/// Matches windows, given as (key, selected-tab title, recent titles), to the session's windows.
+///
+/// Windows and session windows with the same selected title form a group. A window's score for a
+/// session window is the number of its recent titles among the titles of the session window's
+/// pages, back and forward history included. A window takes its single best session window,
+/// unless another window with the same single best scores as high; taken session windows are out,
+/// and taking repeats. The windows left are `Unknown` when fewer session windows are left (the
+/// file is older than their titles), else get the count the session windows left agree on, else
+/// are `Ambiguous`.
+pub fn match_windows<'a, K: Hash + Eq + Clone + 'a>(
+    session: &[SessionWindow],
+    windows: impl IntoIterator<Item = (K, &'a str, &'a [String])>,
+) -> HashMap<K, Match> {
+    let mut groups: HashMap<&str, Vec<(K, &[String])>> = HashMap::new();
+    for (key, title, history) in windows {
+        groups.entry(title).or_default().push((key, history));
+    }
+    let mut matches = HashMap::new();
+    for (title, mut free_windows) in groups {
+        let mut free: Vec<&SessionWindow> =
+            session.iter().filter(|w| w.selected == title).collect();
+        let score = |history: &[String], w: &SessionWindow| {
+            history.iter().filter(|t| w.titles.contains(*t)).count()
         };
-        if counts.insert(title.clone(), window.tabs.len()).is_some_and(|n| n != window.tabs.len()) {
-            conflicting.push(title);
+        while let Some((i, j)) = best_claim(&free_windows, &free, score) {
+            let (key, _) = free_windows.swap_remove(i);
+            matches.insert(key, Match::Tabs(free.swap_remove(j).tabs));
         }
+        let rest = if free_windows.is_empty() {
+            continue;
+        } else if free_windows.len() > free.len() {
+            Match::Unknown
+        } else if free.iter().all(|w| w.tabs == free[0].tabs) {
+            Match::Tabs(free[0].tabs)
+        } else {
+            Match::Ambiguous
+        };
+        matches.extend(free_windows.into_iter().map(|(key, _)| (key, rest)));
     }
-    // Windows that share a title are told apart only when they have the same count.
-    for title in conflicting {
-        counts.remove(&title);

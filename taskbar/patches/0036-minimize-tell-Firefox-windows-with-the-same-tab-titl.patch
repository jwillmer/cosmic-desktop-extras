+/// Windows of the decompressed session JSON.
+fn parse_session(json: &[u8]) -> serde_json::Result<Session> {
+    let file: File = serde_json::from_slice(json)?;
+    Ok(file
+        .windows
+        .into_iter()
+        .filter_map(|window| {

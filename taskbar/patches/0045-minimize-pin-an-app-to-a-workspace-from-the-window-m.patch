diff --git a/cosmic-applet-minimize/src/pins.rs b/cosmic-applet-minimize/src/pins.rs
new file mode 100644
index 00000000..c27a6101
--- /dev/null
+++ b/cosmic-applet-minimize/src/pins.rs
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! `$XDG_CONFIG_HOME/ws-keeper/pins`: the workspace an app always opens on, one
+//! `app_id = Workspace Name` rule per line, `#` comments. Workspace Keeper reads the file and
+//! moves the windows; the window menu only edits it.
+
+use std::{
+    collections::HashMap,
+    io,
+    path::{Path, PathBuf},
+};
+
+/// `$XDG_CONFIG_HOME/ws-keeper/pins`, or `~/.config/ws-keeper/pins`.
+pub fn path() -> Option<PathBuf> {
+    std::env::var_os("XDG_CONFIG_HOME")
+        .filter(|dir| !dir.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".config")))
+        .map(|dir| dir.join("ws-keeper/pins"))
+}
+
+/// Workspace Keeper is installed: without it a pin does nothing.
+pub fn keeper_installed() -> bool {
+    std::env::var_os("HOME")
+        .is_some_and(|home| PathBuf::from(home).join(".local/bin/ws-keeper").is_file())
+}
+
+/// App id and workspace name of a rule line; `None` for comments, blank and other lines. Like
+/// Workspace Keeper, a byte order mark at the start of the file is not part of the app id.
+fn rule(line: &str) -> Option<(&str, &str)> {
+    let line = line.trim_start_matches('\u{feff}').trim();
+    if line.starts_with('#') {
+        return None;
+    }
+    let (app_id, name) = line.split_once('=')?;
+    Some((app_id.trim(), name.trim()))
+}
+
+/// Workspace of every pinned app id in `text`; the last rule for an app wins. A rule without an
+/// app id or a name is skipped, as Workspace Keeper does.
+pub fn parse(text: &str) -> HashMap<String, String> {
+    text.lines()
+        .filter_map(rule)
+        .filter(|(app_id, name)| !app_id.is_empty() && !name.is_empty())
+        .map(|(app_id, name)| (app_id.to_owned(), name.to_owned()))
+        .collect()
+}
+
+/// `text` with the rules for `app_id` removed and, with `name`, a new rule at the end. Every
+/// other line stays as it is.
+pub fn set(text: &str, app_id: &str, name: Option<&str>) -> String {
+    let mut out: String = text
+        .lines()
+        .filter(|line| rule(line).is_none_or(|(id, _)| id != app_id))
+        .flat_map(|line| [line, "\n"])
+        .collect();
+    if let Some(name) = name {
+        out.push_str(&format!("{app_id} = {name}\n"));
+    }
+    out
+}
+
+/// Pins `app_id` to `name` in the file at `path`, or removes its pin with `None`. Writes through
+/// a temporary file in the same directory, so Workspace Keeper never reads a partial file.
+pub fn write(path: &Path, app_id: &str, name: Option<&str>) -> io::Result<()> {
+    let bad = |s: &str| s.trim().is_empty() || s.contains(['\n', '\r']);
+    if bad(app_id) || app_id.contains('=') || app_id.trim_start().starts_with('#') {
+        return Err(io::Error::other(format!(
+            "app id {app_id:?} cannot be pinned"
+        )));
+    }
+    if name.is_some_and(bad) {
+        return Err(io::Error::other(format!(
+            "workspace name {name:?} cannot be pinned"
+        )));
+    }
+    // Replace the file a link points to, not the link.
+    let path = &std::fs::canonicalize(path).unwrap_or_else(|_| path.to_owned());
+    let text = match std::fs::read_to_string(path) {
+        Ok(text) => text,
+        Err(err) if err.kind() == io::ErrorKind::NotFound => String::new(),
+        Err(err) => return Err(err),
+    };
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    let file_name = path.file_name().unwrap_or_default().to_string_lossy();
+    let tmp = path.with_file_name(format!(".{file_name}.{}.tmp", std::process::id()));
+    let result =
+        std::fs::write(&tmp, set(&text, app_id, name)).and_then(|()| std::fs::rename(&tmp, path));
+    if result.is_err() {
+        let _ = std::fs::remove_file(&tmp);
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pinned(text: &str, app_id: &str) -> Option<String> {
+        parse(text).remove(app_id)
+    }
+
+    const FILE: &str = "\
+# apps and their workspaces
+org.example.Mail = Mail
+
+teams-for-linux=Work
+org.example.Mail = Web  # not a comment
+";
+
+    #[test]
+    fn parses_rules() {
+        assert_eq!(pinned(FILE, "teams-for-linux").as_deref(), Some("Work"));
+        assert_eq!(
+            pinned(FILE, "org.example.Mail").as_deref(),
+            Some("Web  # not a comment")
+        );
+        assert_eq!(pinned(FILE, "org.example"), None);
+        assert_eq!(pinned(FILE, "# apps and their workspaces"), None);
+        assert_eq!(pinned("", "teams-for-linux"), None);
+        assert_eq!(pinned("teams-for-linux =", "teams-for-linux"), None);
+        assert_eq!(
+            pinned(
+                "teams-for-linux = Work\nteams-for-linux =\n",
+                "teams-for-linux"
+            )
+            .as_deref(),
+            Some("Work")
+        );
+        assert_eq!(
+            pinned("\u{feff}teams-for-linux = Work\n", "teams-for-linux").as_deref(),
+            Some("Work")
+        );
+    }
+
+    #[test]
+    fn name_may_hold_an_equals_sign() {
+        assert_eq!(
+            pinned("org.example.Calc = a = b\n", "org.example.Calc").as_deref(),
+            Some("a = b")
+        );
+        let text = set("", "org.example.Calc", Some("x=y"));
+        assert_eq!(pinned(&text, "org.example.Calc").as_deref(), Some("x=y"));
+    }
+
+    #[test]
+    fn sets_a_new_rule_at_the_end() {
+        assert_eq!(
+            set("# pins\nfoo = Mail", "teams-for-linux", Some("Work")),
+            "# pins\nfoo = Mail\nteams-for-linux = Work\n"
+        );
+        assert_eq!(set("", "foo", Some("Mail")), "foo = Mail\n");
+    }
+
+    #[test]
+    fn replaces_every_rule_of_the_app_and_keeps_the_rest() {
+        assert_eq!(
+            set(FILE, "org.example.Mail", Some("Code")),
+            "# apps and their workspaces\n\nteams-for-linux=Work\norg.example.Mail = Code\n"
+        );
+    }
+
+    #[test]
+    fn removes_the_rules_of_the_app() {
+        assert_eq!(
+            set(FILE, "teams-for-linux", None),
+            "# apps and their workspaces\norg.example.Mail = Mail\n\n\
+             org.example.Mail = Web  # not a comment\n"
+        );
+        assert_eq!(set(FILE, "org.example.Other", None), FILE);
+    }
+
+    #[test]
+    fn keeps_comments_that_look_like_rules() {
+        let text = "# teams-for-linux = Old\nteams-for-linux = Work\n";
+        assert_eq!(
+            set(text, "teams-for-linux", None),
+            "# teams-for-linux = Old\n"
+        );
+    }
+
+    fn temp_dir(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!("minimize-pins-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        dir
+    }
+
+    #[test]
+    fn writes_the_file_and_creates_its_directory() {
+        let dir = temp_dir("write");
+        let path = dir.join("ws-keeper/pins");
+        assert_eq!(
+            pinned(
+                &std::fs::read_to_string(&path).unwrap_or_default(),
+                "teams-for-linux"
+            ),
+            None
+        );
+        write(&path, "teams-for-linux", Some("Work")).unwrap();
+        std::fs::write(
+            &path,
+            format!("# mine\n{}", std::fs::read_to_string(&path).unwrap()),
+        )
+        .unwrap();
+        write(&path, "org.example.Mail", Some("Mail")).unwrap();
+        write(&path, "teams-for-linux", Some("Chat")).unwrap();
+        assert_eq!(
+            std::fs::read_to_string(&path).unwrap(),
+            "# mine\norg.example.Mail = Mail\nteams-for-linux = Chat\n"
+        );
+        assert_eq!(
+            pinned(
+                &std::fs::read_to_string(&path).unwrap_or_default(),
+                "teams-for-linux"
+            )
+            .as_deref(),
+            Some("Chat")
+        );
+        write(&path, "teams-for-linux", None).unwrap();
+        assert_eq!(
+            pinned(
+                &std::fs::read_to_string(&path).unwrap_or_default(),
+                "teams-for-linux"
+            ),
+            None
+        );
+        // No temporary file is left next to it.
+        assert_eq!(
+            std::fs::read_dir(path.parent().unwrap()).unwrap().count(),
+            1
+        );
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn refuses_what_would_break_the_file() {
+        let dir = temp_dir("refuse");
+        let path = dir.join("pins");
+        assert!(write(&path, "", Some("Work")).is_err());
+        assert!(write(&path, "a=b", Some("Work")).is_err());
+        assert!(write(&path, "#app", Some("Work")).is_err());
+        assert!(write(&path, "app", Some("Two\nLines")).is_err());
+        assert!(write(&path, "app", Some(" ")).is_err());
+        assert!(!path.exists());
+    }
+}

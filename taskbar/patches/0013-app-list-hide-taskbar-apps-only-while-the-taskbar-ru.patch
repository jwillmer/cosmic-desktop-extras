+/// Where the taskbar writes its pid; the same rule as the taskbar's `taskbar_pid::pid_file`.
+fn taskbar_pid_file() -> Option<PathBuf> {
+    std::env::var_os("XDG_RUNTIME_DIR")
+        .filter(|dir| !dir.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".cache")))
+        .map(|dir| dir.join("minimize-ws/taskbar.pid"))
+}
+
+/// Whether `pid_file` names a live process of the executable `name`, looked up in `proc`. A
+/// stale pid file can name a reused pid, so the executable is checked too.
+fn taskbar_running(pid_file: &Path, proc: &Path, name: &str) -> bool {
+    let Some(pid) = std::fs::read_to_string(pid_file)
+        .ok()
+        .and_then(|pid| pid.trim().parse::<u32>().ok())
+    else {
+        return false;
+    };
+    let dir = proc.join(pid.to_string());
+    let exe = match std::fs::read_link(dir.join("exe")) {
+        Ok(exe) => exe.to_string_lossy().into_owned(),
+        Err(_) => {
+            let Ok(cmdline) = std::fs::read(dir.join("cmdline")) else {
+                return false;
+            };
+            let argv0 = cmdline.split(|b| *b == 0).next().unwrap_or_default();
+            String::from_utf8_lossy(argv0).into_owned()
+        }
+    };
+    // A replaced executable still runs, its link then ends in " (deleted)".
+    let exe = exe.strip_suffix(" (deleted)").unwrap_or(&exe);
+    Path::new(exe).file_name().is_some_and(|file| file == name)
+}
+
 fn load_ignore(path: &Path) -> Vec<String> {
     parse_ignore(&std::fs::read_to_string(path).unwrap_or_default())
 }
@@ -574,4 +618,60 @@ mod tests {
     fn missing_ignore_file_is_empty() {
         assert!(load_ignore(Path::new("/nonexistent/minimize-ws/ignore")).is_empty());
     }
+
+    fn temp_dir(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!("{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(&dir).unwrap();
+        dir
+    }
+
+    #[test]
+    fn taskbar_running_checks_pid_and_executable() {
+        let dir = temp_dir("app-list-taskbar-pid");
+        let pid_file = dir.join("taskbar.pid");
+        let proc = Path::new("/proc");
+        let exe = std::env::current_exe().unwrap();
+        let own_name = exe.file_name().unwrap().to_str().unwrap();
+
+        assert!(!taskbar_running(&pid_file, proc, own_name));
+
+        std::fs::write(&pid_file, format!("{}\n", std::process::id())).unwrap();
+        assert!(taskbar_running(&pid_file, proc, own_name));
+        assert!(!taskbar_running(&pid_file, proc, TASKBAR_NAME));
+
+        std::fs::write(&pid_file, "not a pid").unwrap();
+        assert!(!taskbar_running(&pid_file, proc, own_name));
+
+        // Above the kernel's pid limit, so never a live process.
+        std::fs::write(&pid_file, "4194305").unwrap();
+        assert!(!taskbar_running(&pid_file, proc, own_name));
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn taskbar_running_reads_deleted_exe_and_cmdline() {
+        let dir = temp_dir("app-list-taskbar-proc");
+        let pid_file = dir.join("taskbar.pid");
+
+        std::fs::create_dir(dir.join("7")).unwrap();
+        std::os::unix::fs::symlink(
+            "/home/u/.local/bin/cosmic-applet-minimize-ws (deleted)",
+            dir.join("7/exe"),
+        )
+        .unwrap();
+        std::fs::write(&pid_file, "7").unwrap();
+        assert!(taskbar_running(&pid_file, &dir, TASKBAR_NAME));
+
+        std::fs::create_dir(dir.join("8")).unwrap();
+        std::fs::write(dir.join("8/cmdline"), "/usr/bin/cosmic-applet-minimize-ws\0--x\0").unwrap();
+        std::fs::write(&pid_file, "8").unwrap();
+        assert!(taskbar_running(&pid_file, &dir, TASKBAR_NAME));
+
+        std::fs::create_dir(dir.join("9")).unwrap();
+        std::fs::write(dir.join("9/cmdline"), "/usr/bin/cosmic-applet-minimize\0").unwrap();
+        std::fs::write(&pid_file, "9").unwrap();
+        assert!(!taskbar_running(&pid_file, &dir, TASKBAR_NAME));
+        std::fs::remove_dir_all(&dir).unwrap();
+    }

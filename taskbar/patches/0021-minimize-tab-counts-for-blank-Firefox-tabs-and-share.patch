+                {"selected":1,"tabs":[{"entries":[{"title":"Same"}],"index":1},{}]}
+            ]}"#,
+        );
+        assert_eq!(counts, TabCounts::from([("Same".to_owned(), 2)]));
+    }
+
+    #[test]
+    fn session_blank_tab_matches_the_bare_window_title() {
+        let counts = parse(
+            r#"{"windows":[
+                {"selected":1,"tabs":[{"entries":[{"title":"","url":"about:newtab"}],"index":1}]},
+                {"selected":2,"tabs":[{},{"entries":[{"title":"","url":"chrome://browser/content/blanktab.html"}],"index":1}]}
+            ]}"#,
+        );
+        assert_eq!(counts, TabCounts::new());
+        let counts = parse(
+            r#"{"windows":[
+                {"selected":1,"tabs":[{"entries":[{"title":"","url":"about:newtab"}],"index":1}]},
+                {"selected":1,"tabs":[{"entries":[{"title":"","url":"about:home"}],"index":1}]}
+            ]}"#,
+        );
+        assert_eq!(counts, TabCounts::from([("Mozilla Firefox".to_owned(), 1)]));
+    }

@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Pages of the window menu: the main page offers one "Move to workspace" entry, which opens a
+//! page listing the workspaces the window can move to.
+
+/// Page of the window menu that is shown.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub enum MenuPage {
+    #[default]
+    Main,
+    Workspaces,
+}
+
+/// Workspace entries of a menu page, in order.
+#[derive(Debug, PartialEq, Eq)]
+pub enum WorkspaceItem<'a, W> {
+    Divider,
+    /// Opens the workspace page.
+    MoveToWorkspace,
+    /// Returns to the main page.
+    Back,
+    Workspace(&'a W),
+}
+
+/// Page to show: the workspace page only while there is a workspace to move to.
+pub fn shown_page<W>(page: MenuPage, targets: &[W]) -> MenuPage {
+    if targets.is_empty() {
+        MenuPage::Main
+    } else {
+        page
+    }
+}
+
+/// Workspace entries of `page` (as returned by [`shown_page`]) for the given move targets.
+pub fn workspace_items<W>(page: MenuPage, targets: &[W]) -> Vec<WorkspaceItem<'_, W>> {
+    match shown_page(page, targets) {
+        MenuPage::Main if targets.is_empty() => Vec::new(),
+        MenuPage::Main => vec![WorkspaceItem::Divider, WorkspaceItem::MoveToWorkspace],
+        MenuPage::Workspaces => [WorkspaceItem::Back, WorkspaceItem::Divider]
+            .into_iter()
+            .chain(targets.iter().map(WorkspaceItem::Workspace))
+            .collect(),
+    }
+}
+
+/// A workspace without a custom name is labelled with its position, shown as "Workspace N".
+pub fn is_numbered(label: &str) -> bool {
+    !label.is_empty() && label.bytes().all(|b| b.is_ascii_digit())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn numbered_and_named_workspaces() {
+        assert!(is_numbered("3"));
+        assert!(is_numbered("12"));
+        assert!(!is_numbered("Mail"));
+        assert!(!is_numbered("2 Dev"));
+        assert!(!is_numbered(""));
+    }
+
+    #[test]
+    fn main_page_without_targets_has_no_entries() {
+        assert!(workspace_items::<u32>(MenuPage::Main, &[]).is_empty());
+    }
+
+    #[test]
+    fn main_page_has_one_entry_for_all_targets() {
+        assert_eq!(
+            workspace_items(MenuPage::Main, &[1, 2, 3]),
+            vec![WorkspaceItem::Divider, WorkspaceItem::MoveToWorkspace]
+        );
+    }
+
+    #[test]
+    fn workspace_page_lists_targets_after_back() {
+        assert_eq!(
+            workspace_items(MenuPage::Workspaces, &[1, 2]),
+            vec![
+                WorkspaceItem::Back,
+                WorkspaceItem::Divider,
+                WorkspaceItem::Workspace(&1),
+                WorkspaceItem::Workspace(&2),
+            ]
+        );
+    }
+
+    #[test]
+    fn workspace_page_falls_back_to_main_without_targets() {
+        assert_eq!(shown_page::<u32>(MenuPage::Workspaces, &[]), MenuPage::Main);
+        assert!(workspace_items::<u32>(MenuPage::Workspaces, &[]).is_empty());
+    }
+}

+/// Window title -> its tabs. Titles shared by several windows have no count, because they cannot
+/// be told apart, but they are still listed.
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct Windows {
+    counts: HashMap<String, Window>,
+    shared: HashSet<String>,
+}
+
+impl Windows {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// The tabs of the window with this title, unless several windows have it.
+    pub fn get(&self, title: &str) -> Option<&Window> {
+        self.counts.get(title)
+    }
+
+    /// Whether a window with this title is in the files, also when several windows have it.
+    pub fn lists(&self, title: &str) -> bool {
+        self.counts.contains_key(title) || self.shared.contains(title)
+    }
+
+    #[cfg(test)]
+    pub fn is_empty(&self) -> bool {
+        self.counts.is_empty() && self.shared.is_empty()
+    }
+}
+
+impl<const N: usize> From<[(String, Window); N]> for Windows {
+    fn from(counts: [(String, Window); N]) -> Self {
+        Self {
+            counts: HashMap::from(counts),
+            shared: HashSet::new(),
+        }
+    }
+}
 

diff --git a/cosmic-applet-minimize/src/menu_page.rs b/cosmic-applet-minimize/src/menu_page.rs
index 5f407413..a1570f27 100644
--- a/cosmic-applet-minimize/src/menu_page.rs
+++ b/cosmic-applet-minimize/src/menu_page.rs
@@ -1,7 +1,8 @@
 // SPDX-License-Identifier: GPL-3.0-only
 
 //! Pages of the window menu: the main page offers one "Move to workspace" entry, which opens a
-//! page listing the workspaces the window can move to.
+//! page listing every workspace; the window's own workspace stays in the list (marked, not
+//! clickable) so the entries keep their place.
 
 /// Page of the window menu that is shown.
 #[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
@@ -19,26 +20,39 @@ pub enum WorkspaceItem<'a, W> {
     MoveToWorkspace,
     /// Returns to the main page.
     Back,
+    /// A workspace to move to.
     Workspace(&'a W),
+    /// The workspace the window is on.
+    Current(&'a W),
 }
 
 /// Page to show: the workspace page only while there is a workspace to move to.
-pub fn shown_page<W>(page: MenuPage, targets: &[W]) -> MenuPage {
-    if targets.is_empty() {
+pub fn shown_page<W>(page: MenuPage, workspaces: &[W], is_current: impl Fn(&W) -> bool) -> MenuPage {
+    if workspaces.iter().all(is_current) {
         MenuPage::Main
     } else {
         page
     }
 }
 
-/// Workspace entries of `page` (as returned by [`shown_page`]) for the given move targets.
-pub fn workspace_items<W>(page: MenuPage, targets: &[W]) -> Vec<WorkspaceItem<'_, W>> {
-    match shown_page(page, targets) {
-        MenuPage::Main if targets.is_empty() => Vec::new(),
+/// Workspace entries of `page` (as returned by [`shown_page`]) for all workspaces, in order.
+pub fn workspace_items<W>(
+    page: MenuPage,
+    workspaces: &[W],
+    is_current: impl Fn(&W) -> bool,
+) -> Vec<WorkspaceItem<'_, W>> {
+    match shown_page(page, workspaces, &is_current) {
+        MenuPage::Main if workspaces.iter().all(&is_current) => Vec::new(),
         MenuPage::Main => vec![WorkspaceItem::Divider, WorkspaceItem::MoveToWorkspace],
         MenuPage::Workspaces => [WorkspaceItem::Back, WorkspaceItem::Divider]
             .into_iter()
-            .chain(targets.iter().map(WorkspaceItem::Workspace))
+            .chain(workspaces.iter().map(|w| {
+                if is_current(w) {
+                    WorkspaceItem::Current(w)
+                } else {
+                    WorkspaceItem::Workspace(w)
+                }
+            }))
             .collect(),
     }
 }

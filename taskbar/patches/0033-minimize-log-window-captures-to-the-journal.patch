+/// Numbers the thumbnail captures in their journal lines.
+static THUMBNAIL_CAPTURE_SERIAL: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(0);
+
+/// Journal line for a capture that got its buffer. A crash recorder matches the `capture start`,
+/// `capture frame failed` and `capture end` prefixes to tell whether a capture was in progress.
+/// Both kinds use shm buffers; the dmabuf device the compositor offered is logged as well.
+fn log_capture_start(kind: &str, id: u64, app_id: &str, formats: &Formats) {
+    let (width, height) = formats.buffer_size;
+    let dmabuf_offered = match formats.dmabuf_device {
+        Some(dev) => {
+            let (major, minor) = (rustix::fs::major(dev), rustix::fs::minor(dev));
+            let name = std::fs::read_link(format!("/sys/dev/char/{major}:{minor}"))
+                .ok()
+                .and_then(|path| Some(path.file_name()?.to_string_lossy().into_owned()))
+                .unwrap_or_else(|| "?".into());
+            format!("{name}({major}:{minor}) dmabuf_formats={}", formats.dmabuf_formats.len())
+        }
+        None => "none".into(),
+    };
+    tracing::info!(
+        "capture start kind={kind} id={id} window={} size={width}x{height} buffer=shm \
+         fmt=Abgr8888 dmabuf_offered={dmabuf_offered}",
+        window_name(app_id)
+    );
+}
+
+fn window_name(app_id: &str) -> &str {
+    if app_id.is_empty() { "unknown" } else { app_id }
+}
+

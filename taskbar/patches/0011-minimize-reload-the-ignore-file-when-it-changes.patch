From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jens Willmer <info@jwillmer.de>
Date: Tue, 10 Nov 2026 22:56:03 +0100
Subject: [PATCH 11/44] minimize: reload the ignore file when it changes

The taskbar read ~/.config/minimize-ws/ignore only at start, while the
App List re-reads it every 2 s, so after an edit the two disagreed until
the panel restarted. The taskbar now checks the file's modification
time every 2 s and, when it changed, re-reads it and updates what it
shows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/cosmic-applet-minimize/src/ignore_file.rs b/cosmic-applet-minimize/src/ignore_file.rs
new file mode 100644
index 00000000..23e85832
--- /dev/null
+++ b/cosmic-applet-minimize/src/ignore_file.rs
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! `~/.config/minimize-ws/ignore`: app ids the taskbar never shows (one per line, `#` comments).
+
+use std::{path::PathBuf, time::SystemTime};
+
+#[derive(Debug, Default)]
+pub struct IgnoreFile {
+    path: Option<PathBuf>,
+    /// Modification time of the file `apps` was read from; `None` while it is missing.
+    modified: Option<SystemTime>,
+    pub apps: Vec<String>,
+}
+
+impl IgnoreFile {
+    pub fn new() -> Self {
+        let path = std::env::var_os("HOME")
+            .map(|home| PathBuf::from(home).join(".config/minimize-ws/ignore"));
+        Self::at(path)
+    }
+
+    fn at(path: Option<PathBuf>) -> Self {
+        let mut this = Self {
+            path,
+            ..Self::default()
+        };
+        this.reload();
+        this
+    }
+
+    /// Re-reads the file when its modification time changed. Returns whether it was re-read.
+    pub fn reload(&mut self) -> bool {
+        let Some(path) = self.path.as_deref() else {
+            return false;
+        };
+        let modified = path.metadata().and_then(|m| m.modified()).ok();
+        if modified == self.modified {
+            return false;
+        }
+        self.modified = modified;
+        self.apps = parse_ignore(&std::fs::read_to_string(path).unwrap_or_default());
+        true
+    }
+}
+
+/// Lines of the ignore file, without `#` comments and blank lines.
+fn parse_ignore(content: &str) -> Vec<String> {
+    content
+        .lines()
+        .map(|line| line.split('#').next().unwrap_or_default().trim().to_owned())
+        .filter(|line| !line.is_empty())
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::time::Duration;
+
+    #[test]
+    fn ignore_file() {
+        let content = "# apps to hide\n\nfirefox\n  com.system76.CosmicTerm  # terminal\n#steam\n   \n";
+        assert_eq!(parse_ignore(content), ["firefox", "com.system76.CosmicTerm"]);
+    }
+
+    #[test]
+    fn reloads_when_modified() {
+        let dir = std::env::temp_dir().join(format!("minimize-ignore-test-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("ignore");
+        let set_modified = |secs| {
+            std::fs::File::options()
+                .write(true)
+                .open(&path)
+                .unwrap()
+                .set_modified(SystemTime::UNIX_EPOCH + Duration::from_secs(secs))
+                .unwrap();
+        };
+
+        let mut file = IgnoreFile::at(Some(path.clone()));
+        assert!(file.apps.is_empty());
+        assert!(!file.reload());
+
+        std::fs::write(&path, "firefox\n").unwrap();
+        set_modified(1);
+        assert!(file.reload());
+        assert_eq!(file.apps, ["firefox"]);
+        assert!(!file.reload());
+
+        std::fs::write(&path, "steam\n").unwrap();
+        set_modified(2);
+        assert!(file.reload());
+        assert_eq!(file.apps, ["steam"]);
+
+        std::fs::remove_file(&path).unwrap();
+        assert!(file.reload());
+        assert!(file.apps.is_empty());
+        std::fs::remove_dir(&dir).unwrap();
+    }
+}

+/// Side of the hovered item the preview opens on.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Side {
+    Left,
+    Right,
+    Top,
+    Bottom,
+    /// Right of the item, growing up from its bottom edge: beside a list near the bottom.
+    RightUp,
+    /// Right of the item, growing down from its top edge: beside a list near the top.
+    RightDown,
+}
+
+impl Side {
+    /// For an item on the panel: the side away from the panel's screen edge.
+    pub fn away_from(anchor: PanelAnchor) -> Self {
+        match anchor {
+            PanelAnchor::Left => Side::Right,
+            PanelAnchor::Right => Side::Left,
+            PanelAnchor::Top => Side::Bottom,
+            PanelAnchor::Bottom => Side::Top,
+        }
+    }
+
+    /// For an item in the overflow popup's list: beside it, growing away from the panel, so a
+    /// row near the panel does not push the preview off the screen.
+    pub fn beside_list(anchor: PanelAnchor) -> Self {
+        match anchor {
+            PanelAnchor::Bottom => Side::RightUp,
+            _ => Side::RightDown,
+        }
+    }
+
+    /// Positioner anchor, gravity and offset that put the popup GAP pixels off this side.
+    fn placement(self) -> (Anchor, Gravity, (i32, i32)) {
+        const GAP: i32 = 8;
+        match self {
+            Side::Right => (Anchor::Right, Gravity::Right, (GAP, 0)),
+            Side::Left => (Anchor::Left, Gravity::Left, (-GAP, 0)),
+            Side::Bottom => (Anchor::Bottom, Gravity::Bottom, (0, GAP)),
+            Side::Top => (Anchor::Top, Gravity::Top, (0, -GAP)),
+            Side::RightUp => (Anchor::BottomRight, Gravity::TopRight, (GAP, 0)),
+            Side::RightDown => (Anchor::TopRight, Gravity::BottomRight, (GAP, 0)),
+        }
+    }
+}
+

+    /// Whether the window's item is in the overflow popup rather than on the panel.
+    fn is_in_overflow(&self, handle: &ExtForeignToplevelHandleV1) -> bool {
+        let shown = self.item_layout().0;
+        self.visible_apps()
+            .iter()
+            .position(|a| a.toplevel_info.foreign_toplevel == *handle)
+            .is_some_and(|pos| pos >= shown)
+    }
+
+    /// Closes the preview popup and stops capturing the window it showed.
+    fn close_preview(&mut self) -> app::Task<Message> {
+        if self.hovered.take().is_none() {
+            return Task::none();
+        }
+        self.update_live_capture();
+        cosmic::task::message(cosmic::Action::Surface(surface::Action::DestroyPopup(
+            *preview::PREVIEW_WINDOW_ID,
+        )))
+    }
+
+    /// How long the pointer rests on an item before its preview opens.
+    fn preview_delay(&self) -> std::time::Duration {
+        if self
+            .preview_left
+            .is_some_and(|left| left.elapsed() < std::time::Duration::from_millis(700))
+        {
+            std::time::Duration::ZERO
+        } else {
+            std::time::Duration::from_millis(120)
+        }
+    }

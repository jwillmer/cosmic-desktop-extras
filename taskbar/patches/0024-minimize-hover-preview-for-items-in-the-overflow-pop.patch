+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn panel_preview_opens_away_from_the_panel() {
+        assert_eq!(Side::away_from(PanelAnchor::Bottom), Side::Top);
+        assert_eq!(Side::away_from(PanelAnchor::Top), Side::Bottom);
+        assert_eq!(Side::away_from(PanelAnchor::Left), Side::Right);
+        assert_eq!(Side::away_from(PanelAnchor::Right), Side::Left);
+    }
+
+    #[test]
+    fn list_preview_grows_away_from_the_panel() {
+        assert_eq!(Side::beside_list(PanelAnchor::Bottom), Side::RightUp);
+        assert_eq!(Side::beside_list(PanelAnchor::Top), Side::RightDown);
+    }
+
+    #[test]
+    fn placement_offsets_point_outward_from_the_item() {
+        for side in [Side::Left, Side::Right, Side::Top, Side::Bottom, Side::RightUp, Side::RightDown] {
+            let (anchor, gravity, (x, y)) = side.placement();
+            let (expected_anchor, expected_gravity, outward) = match side {
+                Side::Left => (Anchor::Left, Gravity::Left, x < 0 && y == 0),
+                Side::Right => (Anchor::Right, Gravity::Right, x > 0 && y == 0),
+                Side::Top => (Anchor::Top, Gravity::Top, y < 0 && x == 0),
+                Side::Bottom => (Anchor::Bottom, Gravity::Bottom, y > 0 && x == 0),
+                Side::RightUp => (Anchor::BottomRight, Gravity::TopRight, x > 0 && y == 0),
+                Side::RightDown => (Anchor::TopRight, Gravity::BottomRight, x > 0 && y == 0),
+            };
+            assert_eq!(anchor, expected_anchor);
+            assert_eq!(gravity, expected_gravity);
+            assert!(outward, "{side:?} offset ({x}, {y})");
+        }
+    }
+}

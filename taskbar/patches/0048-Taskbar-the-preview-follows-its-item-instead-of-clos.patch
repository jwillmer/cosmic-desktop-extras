+/// Where the hovered item is: its index among the shown windows, and the lengths of the panel
+/// items up to and including it (`Minimize::hovered_position`). An item in the overflow list
+/// has all panel lengths, fewer than its index + 1.
+pub type ItemPosition = (usize, Vec<u32>);
+
+/// What the preview does when the items were laid out again under a resting pointer.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Follow {
+    /// The item did not move.
+    Keep,
+    /// The panel item moved along the panel or changed length: move the popup with it.
+    Move { start: i32, len: i32 },
+    /// The window has no item any more.
+    Gone,
+    /// The item changed index or moved between the panel and the overflow list. Item widgets are
+    /// keyed by index, so the one under the pointer now belongs to another window: close.
+    Moved,
+}
+
+/// How the hovered item changed from `before` to `after`. A change of length does not close the
+/// preview: closing it while the pointer rests on the item leaves the item hovered, so the
+/// preview only came back when the pointer crossed an item edge.
+pub fn follow(before: &ItemPosition, after: Option<&ItemPosition>) -> Follow {
+    let Some(after) = after else {
+        return Follow::Gone;
+    };
+    let ((index, lens), (new_index, new_lens)) = (before, after);
+    let on_panel = |index: usize, lens: &[u32]| lens.len() > index;
+    if index != new_index || on_panel(*index, lens) != on_panel(*new_index, new_lens) {
+        return Follow::Moved;
+    }
+    if !on_panel(*index, lens) {
+        // In the overflow list, at index - panel items: it moves when the panel count changes.
+        return if lens.len() == new_lens.len() {
+            Follow::Keep
+        } else {
+            Follow::Moved
+        };
+    }
+    if lens == new_lens {
+        return Follow::Keep;
+    }
+    let sum = |lens: &[u32]| lens[..*index].iter().map(|l| i64::from(*l)).sum::<i64>();
+    Follow::Move {
+        start: (sum(new_lens) - sum(lens)) as i32,
+        len: new_lens[*index] as i32 - lens[*index] as i32,
+    }
+}
+
+/// `positioner` with its anchor rectangle shifted by `start` and grown by `len` along the panel.
+pub fn moved(
+    mut positioner: SctkPositioner,
+    horizontal: bool,
+    start: i32,
+    len: i32,
+) -> SctkPositioner {
+    let rect = &mut positioner.anchor_rect;
+    if horizontal {
+        rect.x += start;
+        rect.width = (rect.width + len).max(1);
+    } else {
+        rect.y += start;
+        rect.height = (rect.height + len).max(1);
+    }
+    positioner
 }
 

+    #[test]
+    fn reload_reads_unchanged_mtime() {
+        let dir = TempDir::new("reload");
+        let path = dir.0.join(own_file());
+        let old = SystemTime::now() - Duration::from_secs(10);
+        let set_old = || {
+            std::fs::File::options()
+                .write(true)
+                .open(&path)
+                .unwrap()
+                .set_modified(old)
+                .unwrap()
+        };
+        let mut reader = Reader::default();
+        dir.write(&own_file(), r#"{"windows":[{"title":"~","tabs":2}]}"#);
+        set_old();
+        assert_eq!(reader.load_from(&dir.0), Windows::from([("~".to_owned(), tabs(2))]));
+
+        dir.write(&own_file(), r#"{"windows":[{"title":"~","tabs":4}]}"#);
+        set_old();
+        assert_eq!(reader.load_from(&dir.0), Windows::from([("~".to_owned(), tabs(2))]));
+        assert_eq!(reader.reload_from(&dir.0), Windows::from([("~".to_owned(), tabs(4))]));
+    }
+

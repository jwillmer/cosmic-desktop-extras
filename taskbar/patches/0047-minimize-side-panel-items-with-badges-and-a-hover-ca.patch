+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Window items on a left or right panel: a square icon with a pin badge at the top right and a
+//! count badge at the bottom right. Hovering one opens a card beside the panel with the icon,
+//! the title rows and the live preview.
+
+use crate::{detail, window_tabs};
+
+/// The number at the bottom right of a side panel item.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Badge {
+    /// Unread messages, from the launcher entry or a `(3) Chat` style title: a red badge.
+    Unread(u32),
+    /// Tabs or items the app reports itself, the count of the second line: a neutral badge.
+    Count(usize),
+}
+
+/// Badges above this show as `99+`.
+const BADGE_MAX: usize = 99;
+
+impl Badge {
+    pub fn text(self) -> String {
+        let count = match self {
+            Badge::Unread(count) => count as usize,
+            Badge::Count(count) => count,
+        };
+        if count > BADGE_MAX {
+            format!("{BADGE_MAX}+")
+        } else {
+            count.to_string()
+        }
+    }
+
+    pub fn is_unread(self) -> bool {
+        matches!(self, Badge::Unread(_))
+    }
+}
+
+/// The badge of a window: its unread count when there is one, else its tab or item count.
+pub fn badge(unread: Option<u32>, own: Option<window_tabs::Detail>) -> Option<Badge> {
+    if let Some(unread) = unread.filter(|&unread| unread > 0) {
+        return Some(Badge::Unread(unread));
+    }
+    match own? {
+        window_tabs::Detail::Tabs(count) | window_tabs::Detail::Items(count) if count > 0 => {
+            Some(Badge::Count(count))
+        }
+        _ => None,
+    }
+}
+
+/// Unread count of a window: the launcher entry's count, else a count in front of its title.
+/// The `detail` file's `-launcher` and `-count` rules turn either off, as for the second line.
+pub fn unread(
+    title: &str,
+    app_id: &str,
+    launcher: Option<&detail::Status>,
+    overrides: &detail::Overrides,
+) -> Option<u32> {
+    launcher
+        .filter(|_| overrides.allows(app_id, detail::Rule::Launcher))
+        .and_then(|status| status.count)
+        .filter(|&count| count > 0)
+        .or_else(|| {
+            detail::count_prefix(title)
+                .filter(|_| overrides.allows(app_id, detail::Rule::Count))
+                .map(|(count, _)| count)
+        })
+}
+
+/// Lengths of the square items shown on a side panel with `space` along it (`None`: no limit);
+/// the rest go to the overflow popup, whose button is as long as an item.
+pub fn layout(space: Option<u32>, count: usize, len: u32, spacing: u32) -> Vec<u32> {
+    crate::fit_items(space, &vec![len; count], len, len, len + spacing, spacing)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::preview::Side;
+    use cosmic::applet::cosmic_panel_config::PanelAnchor;
+
+    fn launcher(count: u32) -> detail::Status {
+        detail::Status {
+            count: Some(count),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn unread_wins_over_tabs() {
+        let tabs = Some(window_tabs::Detail::Tabs(4));
+        assert_eq!(badge(Some(3), tabs), Some(Badge::Unread(3)));
+        assert_eq!(badge(Some(0), Some(window_tabs::Detail::Tabs(4))), Some(Badge::Count(4)));
+        assert_eq!(badge(None, Some(window_tabs::Detail::Items(12))), Some(Badge::Count(12)));
+    }
+
+    #[test]
+    fn no_badge_without_a_count() {
+        assert_eq!(badge(None, None), None);
+        assert_eq!(badge(Some(0), None), None);
+        assert_eq!(badge(None, Some(window_tabs::Detail::Items(0))), None);
+    }
+
+    #[test]
+    fn badge_text_caps_at_99() {
+        assert_eq!(Badge::Count(7).text(), "7");
+        assert_eq!(Badge::Count(99).text(), "99");
+        assert_eq!(Badge::Count(100).text(), "99+");
+        assert_eq!(Badge::Unread(2500).text(), "99+");
+        assert!(Badge::Unread(1).is_unread());
+        assert!(!Badge::Count(1).is_unread());
+    }
+
+    #[test]
+    fn unread_from_launcher_then_title() {
+        let none = detail::Overrides::default();
+        assert_eq!(unread("Chat", "org.example.Chat", Some(&launcher(5)), &none), Some(5));
+        assert_eq!(unread("(3) Chat", "org.example.Chat", Some(&launcher(5)), &none), Some(5));
+        assert_eq!(unread("(3) Chat", "org.example.Chat", Some(&launcher(0)), &none), Some(3));
+        assert_eq!(unread("(3) Chat", "org.example.Chat", None, &none), Some(3));
+        assert_eq!(unread("Chat", "org.example.Chat", None, &none), None);
+    }
+
+    #[test]
+    fn unread_follows_the_detail_rules() {
+        let off = detail::parse_overrides("org.example.Chat -launcher,-count\n");
+        assert_eq!(unread("(3) Chat", "org.example.Chat", Some(&launcher(5)), &off), None);
+        assert_eq!(unread("(3) Mail", "org.example.Mail", None, &off), Some(3));
+    }
+
+    #[test]
+    fn items_are_square_while_they_fit() {
+        assert_eq!(layout(None, 3, 40, 4), vec![40, 40, 40]);
+        assert_eq!(layout(Some(300), 3, 40, 4), vec![40, 40, 40]);
+        assert_eq!(layout(Some(300), 0, 40, 4), Vec::<u32>::new());
+    }
+
+    #[test]
+    fn items_that_do_not_fit_go_to_the_overflow_popup() {
+        // 10 items of 44 with spacing need 440; 200 holds the button (44) and 3 items.
+        let shown = layout(Some(200), 10, 40, 4);
+        assert_eq!(shown.len(), 3);
+        assert!(shown.iter().all(|&len| len == 40), "{shown:?}");
+    }
+
+    #[test]
+    fn card_opens_beside_the_side_panel() {
+        assert_eq!(Side::away_from(PanelAnchor::Left), Side::Right);
+        assert_eq!(Side::away_from(PanelAnchor::Right), Side::Left);
+    }
+}

+/// The preview image scaled to fit PREVIEW_SIZE on its long side.
+fn preview_image<'a, Message: 'static>(img: PreviewImage) -> Element<'a, Message> {
+    let ratio = img.width.max(img.height).max(1) as f32 / PREVIEW_SIZE;
+    Image::new(img.handle)
+        .width(Length::Fixed(img.width as f32 / ratio))
+        .height(Length::Fixed(img.height as f32 / ratio))
+        .content_fit(iced::ContentFit::Contain)
+        .into()
+}
+
+/// A title for two wrapped lines, trimmed. cosmic-text 0.19 starts the last line of an
+/// ellipsized text with the space it broke at, so the second line looked indented. A zero-width
+/// space after each space moves the break behind it: the space stays at the end of line 1.
+fn wrap_title(title: &str) -> String {
+    title
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" \u{200B}")
+}
+
+/// Card of a side panel item: icon, title and second line in the taskbar item styles, above
+/// the preview (none when it is turned off).
+fn card<'a, Message: 'static>(
+    header: Header,
+    title: Cow<'static, str>,
+    image: Option<PreviewImage>,
+) -> Element<'a, Message> {
+    let row2 = header.row2.map(|row2| {
+        text(row2.trim().to_owned())
+            .size(crate::DETAIL_SIZE)
+            .shaping(text::Shaping::Advanced)
+            .wrapping(text::Wrapping::None)
+            .ellipsize(cosmic::iced::core::text::Ellipsize::End(
+                cosmic::iced::core::text::EllipsizeHeightLimit::Lines(1),
+            ))
+            .class(cosmic::theme::Text::Custom(|theme| {
+                let mut color: iced::Color = theme.cosmic().on_bg_color().into();
+                color.a *= 0.75;
+                iced::widget::text::Style {
+                    color: Some(color),
+                    ..Default::default()
+                }
+            }))
+    });
+    let rows = Column::new()
+        .push(
+            text(wrap_title(&title))
+                .size(crate::TITLE_SIZE)
+                .shaping(text::Shaping::Advanced)
+                .wrapping(text::Wrapping::WordOrGlyph)
+                .ellipsize(cosmic::iced::core::text::Ellipsize::End(
+                    cosmic::iced::core::text::EllipsizeHeightLimit::Lines(2),
+                )),
+        )
+        .push_maybe(row2)
+        .width(Length::Fill);
+    let head = iced::widget::Row::new()
+        .push(
+            cosmic::widget::icon(header.icon)
+                .width(Length::Fixed(CARD_ICON_SIZE))
+                .height(Length::Fixed(CARD_ICON_SIZE)),
+        )
+        .push(rows)
+        .spacing(10.)
+        .align_y(Alignment::Center)
+        .width(Length::Fixed(PREVIEW_SIZE));
+    let column = Column::new()
+        .push(head)
+        .push_maybe(image.map(preview_image))
+        .spacing(8.)
+        .align_x(Alignment::Center)
+        .max_width(PREVIEW_SIZE);
+    Element::from(autosize(
+        layer_container(column)
+            .layer(cosmic::cosmic_theme::Layer::Background)
+            .padding(8.),
+        PREVIEW_AUTOSIZE_ID.clone(),
+    ))
+}

+
+/// Lines of the ignore file, without `#` comments and blank lines.
+fn parse_ignore(content: &str) -> Vec<String> {
+    content
+        .lines()
+        .map(|line| line.split('#').next().unwrap_or_default().trim().to_owned())
+        .filter(|line| !line.is_empty())
+        .collect()
+}
+
+/// Title of the selected tab of a Firefox window with the given window title.
+fn firefox_tab_title(title: &str) -> &str {
+    [" — Mozilla Firefox Private Browsing", " — Mozilla Firefox"]
+        .iter()
+        .find_map(|suffix| title.strip_suffix(suffix))
+        .unwrap_or(title)
+}
+
+/// `title` without a trailing " — Mozilla Firefox" style app suffix, to save space.
+fn short_title(title: &str, app_name: &str, app_id: &str) -> String {
+    // Match the suffix against the app name ("COSMIC Terminal") or the last part of the
+    // app id ("firefox" for "Mozilla Firefox").
+    let names = [
+        app_name.to_lowercase(),
+        app_id.rsplit('.').next().unwrap_or_default().to_lowercase(),
+    ];
+    for sep in [" — ", " – ", " - "] {
+        if let Some((head, tail)) = title.rsplit_once(sep) {
+            let tail = tail.to_lowercase();
+            if !head.is_empty() && names.iter().any(|n| n.len() > 2 && tail.contains(n.as_str())) {
+                return head.to_owned();
+            }
+        }
+    }
+    title.to_owned()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn ignore_file() {
+        let content = "# apps to hide\n\nfirefox\n  com.system76.CosmicTerm  # terminal\n#steam\n   \n";
+        assert_eq!(parse_ignore(content), ["firefox", "com.system76.CosmicTerm"]);
+    }
+
+    #[test]
+    fn firefox_tab_title_strips_suffix() {
+        assert_eq!(firefox_tab_title("Docs — Mozilla Firefox"), "Docs");
+        assert_eq!(firefox_tab_title("Docs — Mozilla Firefox Private Browsing"), "Docs");
+        assert_eq!(firefox_tab_title("Docs"), "Docs");
+    }
+
+    #[test]
+    fn short_title_firefox() {
+        assert_eq!(short_title("Docs — Mozilla Firefox", "Firefox", "firefox"), "Docs");
+        assert_eq!(
+            short_title("A - B — Mozilla Firefox Private Browsing", "Firefox", "firefox"),
+            "A - B"
+        );
+    }
+
+    #[test]
+    fn short_title_terminal() {
+        assert_eq!(
+            short_title("~/src — COSMIC Terminal", "COSMIC Terminal", "com.system76.CosmicTerm"),
+            "~/src"
+        );
+    }
+
+    #[test]
+    fn short_title_without_suffix() {
+        assert_eq!(short_title("Docs", "Firefox", "firefox"), "Docs");
+    }
+
+    #[test]
+    fn short_title_keeps_other_suffix() {
+        assert_eq!(
+            short_title("Inbox — Thunderbird", "Firefox", "firefox"),
+            "Inbox — Thunderbird"
+        );
+    }
+
+    #[test]
+    fn short_title_only_suffix() {
+        assert_eq!(
+            short_title(" — Mozilla Firefox", "Firefox", "firefox"),
+            " — Mozilla Firefox"
+        );
+        assert_eq!(short_title("Mozilla Firefox", "Firefox", "firefox"), "Mozilla Firefox");
+    }
+}

+/// Tab counts from the decompressed session JSON.
+fn parse_session(json: &[u8]) -> serde_json::Result<TabCounts> {
+    let session: Session = serde_json::from_slice(json)?;
     let mut counts = TabCounts::new();
     let mut shared = Vec::new();
     for window in session.windows {
@@ -111,7 +115,7 @@ pub fn load(last: Option<SystemTime>) -> Option<(SystemTime, TabCounts)> {
     for title in shared {
         counts.remove(&title);
     }
-    Some((modified, counts))
+    Ok(counts)
 }
 
 /// Firefox's lz4 container: magic `mozLz40\0`, u32 decompressed size, one raw lz4 block.
@@ -142,6 +146,9 @@ fn lz4_block(src: &[u8], size: usize) -> Option<Vec<u8>> {
         let token = src[i];
         i += 1;
         let literals = length(src, &mut i, (token >> 4) as usize)?;
+        if dst.len() + literals > size {
+            return None;
+        }
         dst.extend_from_slice(src.get(i..i + literals)?);
         i += literals;
         if i >= src.len() {
@@ -151,6 +158,9 @@ fn lz4_block(src: &[u8], size: usize) -> Option<Vec<u8>> {
         i += 2;
         let matched = length(src, &mut i, (token & 15) as usize)? + 4;
         let start = dst.len().checked_sub(offset).filter(|_| offset > 0)?;
+        if dst.len() + matched > size {
+            return None;
+        }
         for k in 0..matched {
             let b = dst[start + k];
             dst.push(b);
@@ -158,3 +168,163 @@ fn lz4_block(src: &[u8], size: usize) -> Option<Vec<u8>> {
     }
     (dst.len() == size).then_some(dst)
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn mozlz4_file(size: u32, block: &[u8]) -> Vec<u8> {
+        let mut data = b"mozLz40\0".to_vec();
+        data.extend_from_slice(&size.to_le_bytes());
+        data.extend_from_slice(block);
+        data
+    }
+
+    #[test]
+    fn lz4_literals_only() {
+        assert_eq!(lz4_block(b"\x50hello", 5).as_deref(), Some(&b"hello"[..]));
+    }
+
+    #[test]
+    fn lz4_long_literal_run() {
+        let text = b"abcdefghijklmnopqrst";
+        let mut block = vec![0xf0, 20 - 15];
+        block.extend_from_slice(text);
+        assert_eq!(lz4_block(&block, 20).as_deref(), Some(&text[..]));
+    }
+
+    #[test]
+    fn lz4_back_reference() {
+        // "abc", then 9 bytes from offset 3, then a final literal "x".
+        let block = b"\x35abc\x03\x00\x10x";
+        assert_eq!(lz4_block(block, 13).as_deref(), Some(&b"abcabcabcabcx"[..]));
+    }
+
+    #[test]
+    fn lz4_overlapping_match_with_long_length() {
+        // "a", then a 19-byte match at offset 1: 15 in the token, 0 extra, plus the implicit 4.
+        let block = b"\x1fa\x01\x00\x00";
+        assert_eq!(lz4_block(block, 20), Some(vec![b'a'; 20]));
+    }
+
+    #[test]
+    fn lz4_truncated_literals() {
+        assert_eq!(lz4_block(b"\x50hell", 5), None);
+    }
+
+    #[test]
+    fn lz4_truncated_offset() {
+        assert_eq!(lz4_block(b"\x35abc\x03", 12), None);
+    }
+
+    #[test]
+    fn lz4_truncated_length_byte() {
+        assert_eq!(lz4_block(b"\xf0", 20), None);
+    }
+
+    #[test]
+    fn lz4_offset_zero() {
+        assert_eq!(lz4_block(b"\x35abc\x00\x00", 12), None);
+    }
+
+    #[test]
+    fn lz4_offset_before_start() {
+        assert_eq!(lz4_block(b"\x35abc\x04\x00", 12), None);
+    }
+
+    #[test]
+    fn lz4_size_mismatch() {
+        assert_eq!(lz4_block(b"\x50hello", 4), None);
+        assert_eq!(lz4_block(b"\x50hello", 6), None);
+    }
+
+    #[test]
+    fn lz4_match_longer_than_size() {
+        // A huge match length must not grow the output past the declared size.
+        let mut block = b"\x1fa\x01\x00".to_vec();
+        block.extend_from_slice(&[0xff; 64]);
+        block.push(0);
+        assert_eq!(lz4_block(&block, 20), None);
+    }
+
+    #[test]
+    fn mozlz4_valid() {
+        let data = mozlz4_file(5, b"\x50hello");
+        assert_eq!(mozlz4(&data).as_deref(), Some(&b"hello"[..]));
+    }
+
+    #[test]
+    fn mozlz4_wrong_magic() {
+        let mut data = mozlz4_file(5, b"\x50hello");
+        data[3] = b'X';
+        assert_eq!(mozlz4(&data), None);
+    }
+
+    #[test]
+    fn mozlz4_short_header() {
+        assert_eq!(mozlz4(b"mozLz40\0\x05\x00"), None);
+        assert_eq!(mozlz4(b"mozLz4"), None);
+    }
+
+    #[test]
+    fn mozlz4_wrong_size() {
+        assert_eq!(mozlz4(&mozlz4_file(6, b"\x50hello")), None);
+    }
+
+    fn parse(json: &str) -> TabCounts {
+        parse_session(json.as_bytes()).unwrap()
+    }
+
+    #[test]
+    fn session_uses_selected_tab_and_history_index() {
+        let counts = parse(
+            r#"{"windows":[{"selected":2,"tabs":[
+                {"entries":[{"title":"One"}],"index":1},
+                {"entries":[{"title":"Back"},{"title":"Current"},{"title":"Forward"}],"index":2},
+                {"entries":[{"title":"Three"}],"index":1}
+            ]}]}"#,
+        );
+        assert_eq!(counts, TabCounts::from([("Current".to_owned(), 3)]));
+    }
+
+    #[test]
+    fn session_url_when_title_empty() {
+        let counts = parse(
+            r#"{"windows":[{"selected":1,"tabs":[
+                {"entries":[{"title":"","url":"https://example.com/"}],"index":1}
+            ]}]}"#,
+        );
+        assert_eq!(counts, TabCounts::from([("https://example.com/".to_owned(), 1)]));
+    }
+
+    #[test]
+    fn session_drops_shared_titles() {
+        let counts = parse(
+            r#"{"windows":[
+                {"selected":1,"tabs":[{"entries":[{"title":"Same"}],"index":1}]},
+                {"selected":1,"tabs":[{"entries":[{"title":"Same"}],"index":1},{}]},
+                {"selected":1,"tabs":[{"entries":[{"title":"Other"}],"index":1},{},{}]}
+            ]}"#,
+        );
+        assert_eq!(counts, TabCounts::from([("Other".to_owned(), 3)]));
+    }
+
+    #[test]
+    fn session_out_of_range_indexes() {
+        let counts = parse(
+            r#"{"windows":[
+                {"selected":5,"tabs":[{"entries":[{"title":"Gone"}],"index":1}]},
+                {"selected":0,"tabs":[{"entries":[{"title":"A"},{"title":"Last"}],"index":9},{}]},
+                {"selected":1,"tabs":[{"entries":[],"index":1}]},
+                {"selected":1,"tabs":[]},
+                {}
+            ]}"#,
+        );
+        assert_eq!(counts, TabCounts::from([("Last".to_owned(), 2)]));
+    }
+
+    #[test]
+    fn session_invalid_json() {
+        assert!(parse_session(b"{").is_err());
+    }
+}

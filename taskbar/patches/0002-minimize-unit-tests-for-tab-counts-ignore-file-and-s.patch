+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A unique empty directory, removed on drop.
+    struct TempDir(PathBuf);
+
+    impl TempDir {
+        fn new(name: &str) -> Self {
+            let dir = std::env::temp_dir().join(format!(
+                "cosmic-applet-minimize-{name}-{}",
+                std::process::id()
+            ));
+            _ = std::fs::remove_dir_all(&dir);
+            std::fs::create_dir_all(&dir).unwrap();
+            Self(dir)
+        }
+
+        fn write(&self, file: &str, content: &str) {
+            std::fs::write(self.0.join(file), content).unwrap();
+        }
+    }
+
+    impl Drop for TempDir {
+        fn drop(&mut self) {
+            _ = std::fs::remove_dir_all(&self.0);
+        }
+    }
+
+    /// A pid with no running process: above the kernel's maximum pid (2^22).
+    const DEAD_PID: u32 = 4_194_305;
+
+    #[test]
+    fn counts_running_process() {
+        let dir = TempDir::new("running");
+        dir.write(
+            &format!("{}.json", std::process::id()),
+            r#"{"windows":[{"title":"~","tabs":3},{"title":"vim","tabs":1}]}"#,
+        );
+        let counts = load_from(&dir.0);
+        assert_eq!(
+            counts,
+            TabCounts::from([("~".to_owned(), 3), ("vim".to_owned(), 1)])
+        );
+    }
+
+    #[test]
+    fn skips_dead_process_and_other_files() {
+        let dir = TempDir::new("dead");
+        let file = r#"{"windows":[{"title":"~","tabs":3}]}"#;
+        dir.write(&format!("{DEAD_PID}.json"), file);
+        dir.write("notapid.json", file);
+        dir.write(&format!("{}.txt", std::process::id()), file);
+        assert!(load_from(&dir.0).is_empty());
+    }
+
+    #[test]
+    fn skips_malformed_file() {
+        let dir = TempDir::new("malformed");
+        dir.write(&format!("{}.json", std::process::id()), r#"{"windows":[{"title":"~"}"#);
+        assert!(load_from(&dir.0).is_empty());
+    }
+
+    #[test]
+    fn drops_shared_titles() {
+        let dir = TempDir::new("shared");
+        dir.write(
+            &format!("{}.json", std::process::id()),
+            r#"{"windows":[{"title":"~","tabs":3},{"title":"~","tabs":2},{"title":"vim","tabs":4}]}"#,
+        );
+        // pid 1 is always running.
+        dir.write("1.json", r#"{"windows":[{"title":"vim","tabs":1},{"title":"htop","tabs":1}]}"#);
+        assert_eq!(load_from(&dir.0), TabCounts::from([("htop".to_owned(), 1)]));
+    }
+
+    #[test]
+    fn missing_dir() {
+        assert!(load_from(Path::new("/nonexistent/cosmic-term-tabs")).is_empty());
+    }
+}

+
+    /// A profile base created after the watch started, as on the first start of snap Firefox,
+    /// is found through its nearest existing ancestor, one directory at a time.
+    #[test]
+    fn rescans_for_firefox_profile_bases_created_later() {
+        let home = TempDir::new("firefox-base");
+        std::fs::create_dir_all(home.0.join(".mozilla/firefox/a.default/sessionstore-backups"))
+            .unwrap();
+        let snap = home.0.join("snap/firefox/common/.mozilla/firefox");
+        let mut watcher = Watcher::new(firefox_spec(&home.0)).unwrap();
+        assert!(!watcher.rescan_due);
+
+        // Other directories and a file of that name do not count.
+        std::fs::create_dir(home.0.join("other")).unwrap();
+        std::fs::write(home.0.join(".config"), "").unwrap();
+        watcher.read().unwrap();
+        assert!(!watcher.rescan_due);
+        std::fs::remove_file(home.0.join(".config")).unwrap();
+
+        // Each look-up watches one level deeper, until the base itself is watched.
+        for dir in snap.ancestors().take(5).collect::<Vec<_>>().into_iter().rev() {
+            std::fs::create_dir(dir).unwrap();
+            assert!(wait_for_rescan(&mut watcher), "{}", dir.display());
+            watcher = Watcher::new(firefox_spec(&home.0)).unwrap();
+            assert!(!watcher.rescan_due);
+        }
+        assert!(firefox_spec(&home.0).rescan.contains(&(snap.clone(), None)));
+        std::fs::create_dir(snap.join("x.default")).unwrap();
+        assert!(wait_for_rescan(&mut watcher));
+    }
+
+    #[test]
+    fn existing_ancestor_names_the_next_dir() {
+        let home = TempDir::new("firefox-ancestor");
+        assert_eq!(
+            existing_ancestor(&home.0.join("snap/firefox/common")),
+            Some((home.0.clone(), "snap".into()))
+        );
+        std::fs::create_dir(home.0.join("snap")).unwrap();
+        assert_eq!(
+            existing_ancestor(&home.0.join("snap/firefox/common")),
+            Some((home.0.join("snap"), "firefox".into()))
+        );
+    }
 }

+                if name.as_ref().is_some_and(|name| dir.join(name).is_dir()) {
+                    watcher.rescan_due = true;
+                }
+                // One directory can be watched for several names, under one watch descriptor.
+                watcher.rescan.entry(wd).or_default().push(name);
             }
         }
         for i in 0..watcher.dirs.len() {

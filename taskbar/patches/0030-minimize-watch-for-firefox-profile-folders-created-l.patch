+/// The nearest existing directory above `path`, and the name of its subdirectory on the way to
+/// `path`, whose creation brings `path` closer.
+fn existing_ancestor(path: &Path) -> Option<(PathBuf, OsString)> {
+    let mut child = path;
+    for parent in path.ancestors().skip(1) {
+        if parent.is_dir() {
+            return Some((parent.to_owned(), child.file_name()?.to_owned()));
+        }
+        child = parent;
+    }
+    None
+}
+

                     }
                     changed.push(self.dirs[i].1);
                 }
-            } else if let Some(&wanted) = self.rescan.get(&event.wd) {
+            } else if let Some(wanted) = self.rescan.get(&event.wd) {
                 // Firefox also writes files in a profile; only directories count.
                 if event.flags.contains(ReadFlags::IGNORED)
                     || event.flags.contains(ReadFlags::ISDIR)
-                        && name.is_some_and(|name| wanted.is_none_or(|wanted| name == wanted))
+                        && name.is_some_and(|name| {

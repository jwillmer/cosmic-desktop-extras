+/// The last counts matched for each window. Windows are matched by their title, which often
+/// changes before the app rewrites its file (an animated terminal title, a Firefox tab switch
+/// up to 15 s before the session file), so a window keeps its count until a new one matches.
+pub struct Remembered<K> {
+    windows: HashMap<K, Window>,
+}
+
+impl<K> Default for Remembered<K> {
+    fn default() -> Self {
+        Self {
+            windows: HashMap::new(),
+        }
+    }
+}
+
+impl<K: std::hash::Hash + Eq> Remembered<K> {
+    /// Stores the count matched by the window's current title, if any.
+    pub fn note(&mut self, window: K, matched: Option<Window>) {
+        if let Some(matched) = matched {
+            self.windows.insert(window, matched);
+        }
+    }
+
+    /// The count matched by the window's current title, else the last one stored for it.
+    pub fn get(&self, window: &K, matched: Option<Window>) -> Option<Window> {
+        matched.or_else(|| self.windows.get(window).copied())
+    }
+
+    pub fn remove(&mut self, window: &K) {
+        self.windows.remove(window);
+    }
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
@@ -357,4 +390,46 @@ mod tests {
         assert_eq!(Detail::Items(1).label(), "1 item");
         assert_eq!(Detail::Items(42).label(), "\u{2068}42\u{2069} items");
     }
+
+    fn window(tabs: usize) -> Window {
+        Window { tabs, items: None }
+    }
+
+    #[test]
+    fn remembered_keeps_count_when_title_changes_first() {
+        let mut memory = Remembered::default();
+        let mut source = Windows::from([("claude ⠂".to_string(), window(3))]);
+        memory.note(1, source.get("claude ⠂").copied());
+        // The title moves on before the source is rewritten.
+        assert_eq!(memory.get(&1, source.get("claude ⠄").copied()), Some(window(3)));
+        source = Windows::from([("claude ⠄".to_string(), window(3))]);
+        memory.note(1, source.get("claude ⠄").copied());
+        assert_eq!(memory.get(&1, source.get("claude ⠆").copied()), Some(window(3)));
+    }
+
+    #[test]
+    fn remembered_takes_new_count_from_rewritten_source() {
+        let mut memory = Remembered::default();
+        memory.note(1, Some(window(3)));
+        let source = Windows::from([("claude ⠄".to_string(), window(4))]);
+        memory.note(1, source.get("claude ⠄").copied());
+        assert_eq!(memory.get(&1, source.get("claude ⠄").copied()), Some(window(4)));
+        assert_eq!(memory.get(&1, source.get("claude ⠆").copied()), Some(window(4)));
+    }
+
+    #[test]
+    fn remembered_unmatched_window_has_no_count() {
+        let mut memory = Remembered::default();
+        memory.note(1, Some(window(2)));
+        memory.note(2, None);
+        assert_eq!(memory.get(&2, None), None);
+    }
+
+    #[test]
+    fn remembered_forgets_removed_window() {
+        let mut memory = Remembered::default();
+        memory.note(1, Some(window(2)));
+        memory.remove(&1);
+        assert_eq!(memory.get(&1, None), None);
+    }
 }

diff --git a/cosmic-applet-minimize/src/options.rs b/cosmic-applet-minimize/src/options.rs
new file mode 100644
index 00000000..efce3d99
--- /dev/null
+++ b/cosmic-applet-minimize/src/options.rs
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! `~/.config/minimize-ws/options`: switches for parts of the window items, one `key = value`
+//! per line (`#` comments). Missing keys keep their defaults.
+
+/// Parts of the taskbar that can be turned off.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Options {
+    /// The second line under the title (tabs, media, unread count, title part); without it
+    /// every item shows the title on one line.
+    pub second_line: bool,
+    /// The preview popup when the pointer rests on an item; without it no window is captured
+    /// for it.
+    pub hover_preview: bool,
+}
+
+impl Default for Options {
+    fn default() -> Self {
+        Self {
+            second_line: true,
+            hover_preview: true,
+        }
+    }
+}
+
+pub fn parse(content: &str) -> Options {
+    let mut options = Options::default();
+    for (number, line) in content.lines().enumerate() {
+        let line = line.split('#').next().unwrap_or_default().trim();
+        if line.is_empty() {
+            continue;
+        }
+        let Some((key, value)) = line.split_once('=') else {
+            tracing::error!("options file line {}: expected key = value, got {line:?}", number + 1);
+            continue;
+        };
+        let (key, value) = (key.trim(), value.trim());
+        let field = match key {
+            "second_line" => &mut options.second_line,
+            "hover_preview" => &mut options.hover_preview,
+            _ => {
+                tracing::error!(
+                    "options file line {}: unknown key {key:?}, expected second_line or \
+                     hover_preview",
+                    number + 1
+                );
+                continue;
+            }
+        };
+        match value {
+            "true" => *field = true,
+            "false" => *field = false,
+            _ => tracing::error!(
+                "options file line {}: {key} = {value:?} is not true or false, keeping {}",
+                number + 1,
+                field
+            ),
+        }
+    }
+    options
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn empty_file_gives_defaults() {
+        assert_eq!(parse(""), Options::default());
+        assert_eq!(parse("# nothing\n\n"), Options::default());
+        assert!(Options::default().second_line);
+        assert!(Options::default().hover_preview);
+    }
+
+    #[test]
+    fn reads_true_and_false() {
+        assert_eq!(
+            parse("second_line = false  # narrow panel\nhover_preview=false\n"),
+            Options {
+                second_line: false,
+                hover_preview: false,
+            }
+        );
+        let options = parse("second_line = false\nsecond_line = true\nhover_preview = false\n");
+        assert!(options.second_line);
+        assert!(!options.hover_preview);
+    }
+
+    #[test]
+    fn bad_lines_keep_the_value_of_that_key() {
+        assert_eq!(
+            parse("second_line = no\nhover_preview = 0\nfoo = false\nbar\nhover_preview\n"),
+            Options::default()
+        );
+        let options = parse("hover_preview = false\nhover_preview = off\nsecond_line = False\n");
+        assert!(!options.hover_preview);
+        assert!(options.second_line);
+    }
+}

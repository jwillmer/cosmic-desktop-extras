+        assert_eq!(
+            item_rows("Downloads".into(), "com.system76.CosmicFiles", false, files(2, Some(9)), video, &overrides, 0),
+            ("(2) Downloads".into(), None)
+        );
+        assert_eq!(
+            item_rows("Downloads".into(), "com.system76.CosmicFiles", false, files(1, Some(9)), video, &overrides, 0),
+            ("Downloads".into(), None)
+        );

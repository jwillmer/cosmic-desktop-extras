+
+    #[test]
+    fn without_the_second_line_a_long_title_stays_on_one_line() {
+        let title = "A window title far too long to fit on one line of a narrow item";
+        let rows = |wrap| item_width::Rows {
+            row1: title.into(),
+            row2: None,
+            max_width: 100,
+            wrap,
+        };
+        let one_line = title_rows::width(title, TITLE_SIZE) + 1.0;
+        assert_eq!(measure_rows(&rows(false)), one_line);
+        assert!(measure_rows(&rows(true)) < one_line);
+    }
+
+    #[test]
+    fn hover_starts_the_preview_only_when_it_is_on() {
+        let on = options::Options::default();
+        let off = options::parse("hover_preview = false\n");
+        assert!(starts_preview(&on, true, false));
+        assert!(!starts_preview(&on, false, false));
+        assert!(!starts_preview(&on, true, true));
+        for (allowed, hovered) in [(true, false), (false, false), (true, true), (false, true)] {
+            assert!(!starts_preview(&off, allowed, hovered));
+        }
+    }

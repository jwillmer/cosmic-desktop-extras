+/// Row 1 and row 2 of a window whose title already lost its trailing app name, from what the
+/// app reports itself (`own`), the other `sources` and the title rules. Without `second_line`
+/// (`options` file) only the title, with a tab count as a `(n) ` prefix.
+fn item_rows(
+    title: String,
+    app_id: &str,
+    second_line: bool,
+    own: Option<window_tabs::Detail>,
+    sources: impl FnOnce() -> detail::Sources,
+    overrides: &detail::Overrides,
+    now: i64,
+) -> (String, Option<String>) {
+    if !second_line {
+        return match own {
+            Some(window_tabs::Detail::Tabs(tabs)) => (format!("({tabs}) {title}"), None),
+            _ => (title, None),
+        };
+    }
+    let sources = detail::Sources {
+        own: own.map(|own| detail::Status::detail(own.label())),
+        ..sources()
+    };
+    detail::detail(&title, app_id, sources, overrides, now)
+}
+
+/// Whether entering an item starts its preview: only when previews are on (`options` file), the
+/// item may show one now (`allowed`) and it is not the one already shown.
+fn starts_preview(options: &options::Options, allowed: bool, already_hovered: bool) -> bool {
+    options.hover_preview && allowed && !already_hovered
+}

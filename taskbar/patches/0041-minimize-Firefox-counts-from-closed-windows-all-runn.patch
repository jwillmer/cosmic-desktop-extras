+    /// A mozlz4 file of `json`, stored as literals.
+    fn mozlz4_json(json: &str) -> Vec<u8> {
+        let mut block = vec![0xf0];
+        let mut len = json.len() - 15;
+        while len >= 255 {
+            block.push(255);
+            len -= 255;
+        }
+        block.push(len as u8);
+        block.extend_from_slice(json.as_bytes());
+        mozlz4_file(json.len() as u32, &block)
+    }

+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Hides an app while the per-workspace taskbar (`cosmic-applet-minimize`) shows one of its
+//! windows, so the app is not listed twice. Without that taskbar installed nothing is hidden.
+
+use cctk::{
+    toplevel_info::ToplevelInfo,
+    wayland_protocols::ext::workspace::v1::client::ext_workspace_handle_v1::ExtWorkspaceHandleV1,
+};
+use cosmic::iced::Subscription;
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+const TASKBAR_BIN: &str = ".local/bin/cosmic-applet-minimize-ws";
+const IGNORE_FILE: &str = ".config/minimize-ws/ignore";
+
+#[derive(Debug, Clone, Default)]
+pub struct TaskbarHide {
+    /// The ignore file; `None` when the taskbar is not installed.
+    ignore_path: Option<PathBuf>,
+    /// App ids the taskbar never shows, so they stay in the App List.
+    ignored: Vec<String>,
+}
+
+impl TaskbarHide {
+    pub fn new() -> Self {
+        let Some(home) = std::env::var_os("HOME").map(PathBuf::from) else {
+            return Self::default();
+        };
+        if !home.join(TASKBAR_BIN).exists() {
+            return Self::default();
+        }
+        let mut this = Self {
+            ignore_path: Some(home.join(IGNORE_FILE)),
+            ignored: Vec::new(),
+        };
+        this.reload();
+        this
+    }
+
+    pub fn is_enabled(&self) -> bool {
+        self.ignore_path.is_some()
+    }
+
+    /// Re-reads the ignore file.
+    pub fn reload(&mut self) {
+        if let Some(path) = self.ignore_path.as_deref() {
+            self.ignored = load_ignore(path);
+        }
+    }
+
+    /// Re-reads the ignore file every 2 s, as often as the taskbar polls.
+    pub fn subscription(&self) -> Subscription<()> {
+        if self.is_enabled() {
+            cosmic::iced::time::every(Duration::from_secs(2)).map(|_| ())
+        } else {
+            Subscription::none()
+        }
+    }
+
+    /// Whether the taskbar shows one of these windows, given the active workspaces.
+    pub fn hides<'a>(
+        &self,
+        toplevels: impl IntoIterator<Item = &'a ToplevelInfo>,
+        active_workspaces: &[ExtWorkspaceHandleV1],
+    ) -> bool {
+        self.is_enabled()
+            && toplevels.into_iter().any(|info| {
+                in_taskbar(
+                    &info.app_id,
+                    &info.workspace,
+                    active_workspaces,
+                    &self.ignored,
+                )
+            })
+    }
+
+}
+
+/// Upstream's `panel_overflow_lengths` over the items the App List shows: `btn_count` buttons fit
+/// in the panel, `pinned_windows[i]` is whether pinned item `i` has a window. Returns the favorite
+/// and active cutoffs, `None` when everything fits.
+pub fn overflow_lengths(
+    btn_count: u32,
+    pinned_hidden: &[bool],
+    pinned_windows: &[bool],
+    active_hidden: &[bool],
+) -> (Option<usize>, Option<usize>) {
+    let pinned_len = pinned_hidden.iter().filter(|h| !**h).count();
+    let active_len = active_hidden.iter().filter(|h| !**h).count();
+    let favorite_active_cnt = pinned_hidden
+        .iter()
+        .zip(pinned_windows)
+        .filter(|(hidden, windows)| !**hidden && **windows)
+        .count();
+
+    if btn_count >= pinned_len as u32 + active_len as u32 {
+        return (None, None);
+    }
+    let mut favorite_index = (btn_count as usize).min(favorite_active_cnt).max(2);
+
+    let active_index_max =
+        (btn_count as i32) - (pinned_len as i32).saturating_sub(favorite_index as i32);
+    let active_index = if active_index_max >= active_len as i32 {
+        active_len
+    } else {
+        (active_index_max.max(2) as usize).min(active_len)
+    };
+
+    let favorite_index_max = (btn_count as i32) - active_index as i32;
+    favorite_index = favorite_index_max.max(2) as usize;
+    (Some(favorite_index), Some(active_index))
+}
+
+/// Splits the pinned list at the favorite cutoff, as upstream's view and favorites popup do:
+/// indexes into the pinned list of the items in the panel (in order) and of the items in the
+/// overflow popup (in upstream's popup order). Hidden items are in neither; pinned items without
+/// a window move to the popup first.
+pub fn split_pinned(
+    cutoff: Option<usize>,
+    hidden: &[bool],
+    windows: &[bool],
+) -> (Vec<usize>, Vec<usize>) {
+    let shown: Vec<usize> = (0..hidden.len()).filter(|&i| !hidden[i]).collect();
+    let mut to_remove = match cutoff {
+        Some(cutoff) if cutoff < shown.len() => shown.len() - cutoff + 1,
+        _ => 0,
+    };
+    let mut popup = Vec::with_capacity(to_remove);
+    let mut kept = Vec::with_capacity(shown.len());
+    for &i in shown.iter().rev() {
+        if to_remove > 0 && !windows[i] {
+            to_remove -= 1;
+            popup.push(i);
+        } else {
+            kept.push(i);
+        }
+    }
+    let to_remove = to_remove.min(kept.len());
+    popup.extend_from_slice(&kept[..to_remove]);
+    popup.reverse();
+    let panel = kept[to_remove..].iter().rev().copied().collect();
+    (panel, popup)
+}
+
+/// How many of the `len` shown active items the panel shows at the active cutoff.
+pub fn active_panel_len(cutoff: Option<usize>, len: usize) -> usize {
+    cutoff.map_or(len, |n| if n < len { n.saturating_sub(1) } else { len })
+}
+
+/// How many of the `len` shown active items the overflow popup shows, taken from the end; all of
+/// them without a cutoff.
+pub fn active_popup_len(cutoff: Option<usize>, len: usize) -> usize {
+    match cutoff {
+        Some(_) => len - active_panel_len(cutoff, len),
+        None => len,
+    }
+}
+
+/// Position in the whole pinned list for `index` counted over the shown pinned items, so a drop
+/// lands next to the icon it was dropped on.
+pub fn pinned_index(index: usize, hidden: impl IntoIterator<Item = bool>) -> usize {
+    let mut len = 0;
+    let mut shown = 0;
+    for is_hidden in hidden {
+        if !is_hidden {
+            if shown == index {
+                return len;
+            }
+            shown += 1;
+        }
+        len += 1;
+    }
+    len
+}
+
+/// Same rule as the taskbar's `visible_apps`: the window is on an active workspace (or either
+/// side has no workspace information) and its app is not ignored.
+fn in_taskbar<'w, W: PartialEq + 'w>(
+    app_id: &str,
+    window_workspaces: impl IntoIterator<Item = &'w W>,
+    active_workspaces: &[W],
+    ignored: &[String],
+) -> bool {
+    let mut window_workspaces = window_workspaces.into_iter().peekable();
+    let on_active_workspace = active_workspaces.is_empty()
+        || window_workspaces.peek().is_none()
+        || window_workspaces.any(|w| active_workspaces.contains(w));
+    on_active_workspace && !ignored.iter().any(|id| id == app_id)
+}
+
+fn load_ignore(path: &Path) -> Vec<String> {
+    parse_ignore(&std::fs::read_to_string(path).unwrap_or_default())
+}
+
+/// Lines of the ignore file, without `#` comments and blank lines (as the taskbar reads it).
+fn parse_ignore(content: &str) -> Vec<String> {
+    content
+        .lines()
+        .map(|line| line.split('#').next().unwrap_or_default().trim().to_owned())
+        .filter(|line| !line.is_empty())
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {

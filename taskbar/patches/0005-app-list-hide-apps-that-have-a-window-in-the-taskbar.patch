+
+    /// App ids left visible, for apps given as (app id, workspaces of each window).
+    fn visible<'a>(
+        apps: &[(&'a str, Vec<Vec<u32>>)],
+        active: &[u32],
+        ignored: &[String],
+    ) -> Vec<&'a str> {
+        apps.iter()
+            .filter(|(id, windows)| !windows.iter().any(|ws| in_taskbar(id, ws, active, ignored)))
+            .map(|(id, _)| *id)
+            .collect()
+    }
+
+    fn ignore(ids: &[&str]) -> Vec<String> {
+        ids.iter().map(|id| id.to_string()).collect()
+    }
+

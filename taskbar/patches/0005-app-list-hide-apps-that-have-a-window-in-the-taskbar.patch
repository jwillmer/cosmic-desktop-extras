+    #[test]
+    fn pinned_index_skips_hidden_items() {
+        // pinned: A(hidden) B C(hidden) D, shown: B D
+        let hidden = [true, false, true, false];
+        assert_eq!(pinned_index(0, hidden), 1);
+        assert_eq!(pinned_index(1, hidden), 3);
+        assert_eq!(pinned_index(2, hidden), 4);
+        assert_eq!(pinned_index(9, hidden), 4);
+        assert_eq!(pinned_index(0, []), 0);
+        assert_eq!(pinned_index(1, [false, false]), 1);
+    }
+
+    const MAX_LEN: usize = 7;
+    const MAX_COUNT: usize = 8;
+
+    fn masks(len: usize) -> impl Iterator<Item = Vec<bool>> {
+        (0..1u32 << len).map(move |bits| (0..len).map(|i| bits & (1 << i) != 0).collect())
+    }
+
+    fn cutoffs() -> impl Iterator<Item = Option<usize>> {
+        std::iter::once(None).chain((0..=MAX_COUNT).map(Some))
+    }
+
+    fn shown(hidden: &[bool]) -> Vec<usize> {
+        (0..hidden.len()).filter(|&i| !hidden[i]).collect()
+    }
+
+    fn keep<T: Copy>(items: &[T], hidden: &[bool]) -> Vec<T> {
+        shown(hidden).into_iter().map(|i| items[i]).collect()
+    }
+
+    /// Upstream's `panel_overflow_lengths` after the panel size is known.
+    fn upstream_overflow_lengths(
+        btn_count: u32,
+        pinned_len: usize,
+        favorite_active_cnt: usize,
+        active_len: usize,
+    ) -> (Option<usize>, Option<usize>) {
+        let mut favorite_index;
+        let active_index;
+        if btn_count >= pinned_len as u32 + active_len as u32 {
+            return (None, None);
+        } else {
+            favorite_index = (btn_count as usize).min(favorite_active_cnt).max(2);
+        }
+        let active_index_max =
+            (btn_count as i32) - (pinned_len as i32).saturating_sub(favorite_index as i32);
+        if active_index_max >= active_len as i32 {
+            active_index = Some(active_len);
+        } else {
+            active_index = Some((active_index_max.max(2) as usize).min(active_len));
+        }
+        if let Some(active_index) = active_index {
+            let favorite_index_max = (btn_count as i32) - active_index as i32;
+            favorite_index = favorite_index_max.max(2) as usize;
+        } else {
+            favorite_index = (btn_count as usize).min(pinned_len);
+        }
+        (Some(favorite_index), active_index)
+    }
+
+    /// Upstream's panel favorites and favorites popup, as indexes into the pinned list.
+    fn upstream_split_pinned(cutoff: Option<usize>, windows: &[bool]) -> (Vec<usize>, Vec<usize>) {
+        let pinned: Vec<usize> = (0..windows.len()).collect();
+        let to_remove_total = match cutoff {
+            Some(cutoff) if cutoff < pinned.len() => pinned.len() - cutoff + 1,
+            _ => 0,
+        };
+
+        let mut favorite_to_remove = to_remove_total;
+        let favorites: Vec<_> = pinned
+            .iter()
+            .rev()
+            .filter(|&&f| {
+                if favorite_to_remove > 0 && !windows[f] {
+                    favorite_to_remove -= 1;
+                    false
+                } else {
+                    true
+                }
+            })
+            .collect();
+        let panel: Vec<usize> = favorites[favorite_to_remove..].iter().rev().map(|f| **f).collect();
+
+        let mut favorite_to_remove = to_remove_total;
+        let mut favorites_extra = Vec::new();
+        let mut favorites: Vec<_> = pinned
+            .iter()
+            .rev()
+            .filter(|&f| {
+                if favorite_to_remove > 0 && !windows[*f] {
+                    favorite_to_remove -= 1;
+                    true
+                } else {
+                    favorites_extra.push(f);
+                    false
+                }
+            })
+            .collect();
+        favorites.extend(favorites_extra[..favorite_to_remove].iter().copied());
+        let popup: Vec<usize> = favorites.iter().rev().map(|f| **f).collect();
+        (panel, popup)
+    }
+
+    #[test]
+    fn overflow_lengths_counts_only_shown_items() {
+        let active_masks: Vec<_> = (0..=MAX_LEN)
+            .flat_map(masks)
+            .map(|hidden| (shown(&hidden).len(), hidden))
+            .collect();
+        for pinned_len in 0..=MAX_LEN {
+            for pinned_hidden in masks(pinned_len) {
+                for pinned_windows in masks(pinned_len) {
+                    let shown_pinned = keep(&pinned_windows, &pinned_hidden);
+                    let favorite_active_cnt = shown_pinned.iter().filter(|w| **w).count();
+                    for &(shown_active, ref active_hidden) in &active_masks {
+                        for btn_count in 0..=MAX_COUNT as u32 {
+                            let lengths = overflow_lengths(
+                                btn_count,
+                                &pinned_hidden,
+                                &pinned_windows,
+                                active_hidden,
+                            );
+                            assert_eq!(
+                                lengths,
+                                upstream_overflow_lengths(
+                                    btn_count,
+                                    shown_pinned.len(),
+                                    favorite_active_cnt,
+                                    shown_active,
+                                ),
+                                "{btn_count} {pinned_hidden:?} {pinned_windows:?} {active_hidden:?}"
+                            );
+                            let fits = btn_count as usize >= shown_pinned.len() + shown_active;
+                            assert_eq!(lengths == (None, None), fits);
+                            if let (Some(favorite), Some(active)) = lengths {
+                                assert!(favorite >= 2 && active <= shown_active);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn overflow_lengths_without_hidden_items_is_upstream() {
+        for pinned_len in 0..=MAX_LEN {
+            let none = vec![false; pinned_len];
+            for pinned_windows in masks(pinned_len) {
+                let favorite_active_cnt = pinned_windows.iter().filter(|w| **w).count();
+                for active_len in 0..=MAX_LEN {
+                    for btn_count in 0..=MAX_COUNT as u32 {
+                        assert_eq!(
+                            overflow_lengths(
+                                btn_count,
+                                &none,
+                                &pinned_windows,
+                                &vec![false; active_len]
+                            ),
+                            upstream_overflow_lengths(
+                                btn_count,
+                                pinned_len,
+                                favorite_active_cnt,
+                                active_len
+                            ),
+                        );
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn split_pinned_partitions_shown_items() {
+        for len in 0..=MAX_LEN {
+            for hidden in masks(len) {
+                let shown = shown(&hidden);
+                for windows in masks(len) {
+                    for cutoff in cutoffs() {
+                        let ctx = format!("{cutoff:?} {hidden:?} {windows:?}");
+                        let (panel, popup) = split_pinned(cutoff, &hidden, &windows);
+
+                        assert!(
+                            panel.iter().chain(&popup).all(|&i| i < len && !hidden[i]),
+                            "{ctx}"
+                        );
+                        assert!(panel.windows(2).all(|w| w[0] < w[1]), "{ctx}");
+                        let mut all: Vec<_> = panel.iter().chain(&popup).copied().collect();
+                        all.sort_unstable();
+                        assert_eq!(all, shown, "{ctx}");
+
+                        match cutoff {
+                            Some(cutoff) if cutoff < shown.len() => {
+                                assert_eq!(panel.len(), cutoff.saturating_sub(1), "{ctx}")
+                            }
+                            _ => assert!(popup.is_empty(), "{ctx}"),
+                        }
+                        if popup.iter().any(|&i| windows[i]) {
+                            assert!(panel.iter().all(|&i| windows[i]), "{ctx}");
+                        }
+
+                        if cutoff.is_none_or(|c| c >= 2) {
+                            let reference = upstream_split_pinned(cutoff, &keep(&windows, &hidden));
+                            let to_real = |v: Vec<usize>| v.into_iter().map(|i| shown[i]).collect();
+                            assert_eq!(
+                                (panel, popup),
+                                (to_real(reference.0), to_real(reference.1)),
+                                "{ctx}"
+                            );
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn split_pinned_without_hidden_items_is_upstream() {
+        for len in 0..=MAX_LEN {
+            for windows in masks(len) {
+                for cutoff in cutoffs().filter(|c| c.is_none_or(|c| c >= 2)) {
+                    assert_eq!(
+                        split_pinned(cutoff, &vec![false; len], &windows),
+                        upstream_split_pinned(cutoff, &windows),
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn active_lengths_partition_shown_items() {
+        for len in 0..=MAX_LEN {
+            for hidden in masks(len) {
+                let shown = shown(&hidden).len();
+                for cutoff in cutoffs() {
+                    let panel = active_panel_len(cutoff, shown);
+                    let popup = active_popup_len(cutoff, shown);
+                    assert!(panel <= shown && popup <= shown);
+                    match cutoff {
+                        Some(n) if n < shown => {
+                            assert_eq!(panel, n.saturating_sub(1));
+                            assert_eq!(panel + popup, shown);
+                        }
+                        Some(_) => assert_eq!((panel, popup), (shown, 0)),
+                        None => assert_eq!((panel, popup), (shown, shown)),
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn active_lengths_without_hidden_items_is_upstream() {
+        for len in 0..=MAX_LEN {
+            for n in 0..=len {
+                let upstream_panel = if n < len { n.saturating_sub(1) } else { n };
+                let upstream_popup = if n < len { (len - n + 1).min(len) } else { 0 };
+                assert_eq!(active_panel_len(Some(n), len), upstream_panel);
+                assert_eq!(active_popup_len(Some(n), len), upstream_popup);
+            }
+            assert_eq!(active_panel_len(None, len), len);
+            assert_eq!(active_popup_len(None, len), len);
+        }
+    }
+
+    #[test]
+    fn pinned_index_maps_shown_position_to_pinned_position() {
+        for len in 0..=MAX_LEN {
+            for hidden in masks(len) {
+                let shown = shown(&hidden);
+                for (position, &real) in shown.iter().enumerate() {
+                    assert_eq!(pinned_index(position, hidden.iter().copied()), real);
+                }
+                for index in 0..=MAX_COUNT + 1 {
+                    let real = pinned_index(index, hidden.iter().copied());
+                    assert!(real <= len, "{index} {hidden:?}");
+                    if index >= shown.len() {
+                        assert_eq!(real, len);
+                    }
+
+                    let mut items: Vec<Option<usize>> = (0..len).map(Some).collect();
+                    let mut after = hidden.clone();
+                    items.insert(real, None);
+                    after.insert(real, false);
+                    let mut expected: Vec<_> = shown.iter().copied().map(Some).collect();
+                    expected.insert(index.min(shown.len()), None);
+                    assert_eq!(keep(&items, &after), expected, "{index} {hidden:?}");
+                    if !hidden.contains(&true) {
+                        assert_eq!(real, index.min(len));
+                    }
+                }
+            }
+        }
+    }

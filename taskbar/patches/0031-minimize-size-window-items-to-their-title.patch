+/// Natural width of a title column: the wider of its rows, each on one line, and a pixel. A title without
+/// row 2 is split over both rows as `label_item` does at the widest item.
+fn measure_rows(rows: &item_width::Rows) -> f32 {
+    let (row1, row2) = match &rows.row2 {
+        Some(row2) => (rows.row1.as_str(), Some(row2.as_str())),
+        None => title_rows::split(&rows.row1, |prefix| {
+            title_rows::width(prefix, TITLE_SIZE) <= rows.max_width as f32
+        }),
+    };
+    let row2 = row2.map_or(0.0, |row2| title_rows::width(row2, DETAIL_SIZE));
+    // A pixel to spare, so layout rounding does not split or cut the title elsewhere.
+    title_rows::width(row1, TITLE_SIZE).max(row2) + 1.0

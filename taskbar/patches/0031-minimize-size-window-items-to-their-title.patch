new file mode 100644
index 00000000..b5670bb2
--- /dev/null
+++ b/cosmic-applet-minimize/src/item_width.rs
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Width each window's title needs on a top or bottom panel, measured only when its rows
+//! change, and held steady so a small change of the title does not move the items.
+
+use std::collections::HashMap;
+use std::hash::Hash;
+
+/// Text widths go up and down in steps of this many pixels.
+pub const STEP: u32 = 20;
+
+/// What a window's title column shows, and the widest it may get.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Rows {
+    pub row1: String,
+    pub row2: Option<String>,
+    pub max_width: u32,
+}
+
+#[derive(Debug)]
+struct Entry {
+    rows: Rows,
+    width: u32,
+}
+
+/// Text width per window, kept between updates.
+#[derive(Debug)]
+pub struct TextWidths<K> {
+    windows: HashMap<K, Entry>,
+}
+
+impl<K> Default for TextWidths<K> {
+    fn default() -> Self {
+        Self {
+            windows: HashMap::new(),
+        }
+    }
+}
+
+impl<K: Hash + Eq> TextWidths<K> {
+    /// Notes the window's rows; `measure` gives their natural width and runs only when the
+    /// rows differ from the last ones noted.
+    pub fn note(&mut self, key: K, rows: Rows, measure: impl FnOnce(&Rows) -> f32) {
+        let previous = self.windows.get(&key);
+        if previous.is_some_and(|entry| entry.rows == rows) {
+            return;
+        }
+        let natural = measure(&rows).max(0.0).ceil() as u32;
+        let width = calm(previous.map(|entry| entry.width), natural);
+        self.windows.insert(key, Entry { rows, width });
+    }
+
+    /// Text width of the window; `None` until its rows were noted.
+    pub fn get(&self, key: &K) -> Option<u32> {
+        self.windows.get(key).map(|entry| entry.width)
+    }
+
+    /// Forgets the windows `keep` returns false for.
+    pub fn retain(&mut self, mut keep: impl FnMut(&K) -> bool) {
+        self.windows.retain(|key, _| keep(key));
+    }
+}
+
+/// Width for content `natural` px wide, given the width it had: `natural` rounded up to a
+/// whole `STEP`. It grows as soon as the content needs it, but shrinks only when the content
+/// fits with a whole step to spare, so content that wavers around a step does not move.
+pub fn calm(previous: Option<u32>, natural: u32) -> u32 {
+    let stepped = natural.div_ceil(STEP) * STEP;
+    match previous {
+        Some(previous) if stepped <= previous && natural + 2 * STEP > previous => previous,
+        _ => stepped,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rounds_up_to_a_step() {
+        assert_eq!(calm(None, 0), 0);
+        assert_eq!(calm(None, 1), 20);
+        assert_eq!(calm(None, 20), 20);
+        assert_eq!(calm(None, 141), 160);
+    }
+
+    #[test]
+    fn grows_at_once() {
+        assert_eq!(calm(Some(100), 101), 120);
+        assert_eq!(calm(Some(100), 170), 180);
+    }
+
+    #[test]
+    fn shrinks_only_with_a_whole_step_to_spare() {
+        // 81..=100 needs the 100 step, 61..=80 would fit the 80 step but has no step to spare.
+        assert_eq!(calm(Some(100), 81), 100);
+        assert_eq!(calm(Some(100), 61), 100);
+        assert_eq!(calm(Some(100), 60), 60);
+        assert_eq!(calm(Some(100), 10), 20);
+    }
+
+    #[test]
+    fn content_wavering_around_a_step_stays_put() {
+        let mut width = calm(None, 100);
+        for natural in [101, 100, 99, 101, 95, 102] {
+            width = calm(Some(width), natural);
+            assert_eq!(width, 120, "natural {natural}");
+        }
+    }
+
+    #[test]
+    fn measures_only_when_the_rows_change() {
+        let mut widths = TextWidths::default();
+        let rows = |row1: &str| Rows {
+            row1: row1.to_owned(),
+            row2: None,
+            max_width: 190,
+        };
+        let measured = &std::cell::Cell::new(0);
+        let measure = |width: f32| {
+            move |_: &Rows| {
+                measured.set(measured.get() + 1);
+                width
+            }
+        };
+        widths.note(1, rows("a"), measure(50.5));
+        widths.note(1, rows("a"), measure(150.0));
+        assert_eq!(widths.get(&1), Some(60));
+        widths.note(1, rows("b"), measure(45.0));
+        assert_eq!(widths.get(&1), Some(60));
+        widths.note(1, rows("c"), measure(10.0));
+        assert_eq!(widths.get(&1), Some(20));
+        assert_eq!(measured.get(), 3);
+        widths.retain(|_| false);
+        assert_eq!(widths.get(&1), None);
+    }
+}

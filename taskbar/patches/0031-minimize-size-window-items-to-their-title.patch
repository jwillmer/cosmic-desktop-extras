+
+/// Lengths for items that want `widths` (each within `min..=max`) to fill `room`: the widest
+/// shrink towards `min` when they need more, the narrowest grow towards `max` when they need
+/// less. Leftover pixels go one each to items that can still change.
+fn level_fill(widths: &[u32], room: u32, min: u32, max: u32) -> Vec<u32> {
+    let shrink = widths.iter().sum::<u32>() > room;
+    let bounds: Vec<(u32, u32)> = widths

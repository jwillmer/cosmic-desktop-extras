+    #[test]
+    fn fit_items_without_a_limit_shows_all_at_full_length() {
+        assert_eq!(fit_items(None, 7, 180, 100, 56, 0), (7, 180));
+    }
+
+    #[test]
+    fn fit_items_shrinks_before_it_overflows() {
+        assert_eq!(fit_items(Some(2000), 5, 180, 100, 56, 0), (5, 180));
+        assert_eq!(fit_items(Some(1000), 8, 180, 100, 56, 0), (8, 125));
+        assert_eq!(fit_items(Some(1000), 10, 180, 100, 56, 0), (10, 100));
+        // 11 at 100 px do not fit: 9 next to the overflow button.
+        assert_eq!(fit_items(Some(1000), 11, 180, 100, 56, 0), (9, 104));
+        assert_eq!(fit_items(Some(150), 3, 180, 100, 56, 0), (0, 180));
+        assert_eq!(fit_items(Some(1000), 0, 180, 100, 56, 0), (0, 180));
+    }
+
+    #[test]
+    fn fit_items_fills_a_limited_space_without_exceeding_it() {
+        for spacing in [0, 4] {
+            for space in 0..3000 {
+                for count in 1..30 {
+                    let (shown, len) = fit_items(Some(space), count, 180, 100, 56 + spacing, spacing);
+                    let used = (len + spacing) * shown as u32
+                        + if shown < count { 56 + spacing } else { 0 };
+                    if shown == 0 {
+                        continue;
+                    }
+                    assert!(used <= space, "space {space} count {count}: uses {used}");
+                    // Spare room under 84 px (1.5 panel units at size M) does not make the
+                    // panel grow the applet again.
+                    if len < 180 {
+                        assert!(space - used < 84, "space {space} count {count}: {} spare", space - used);
+                    }
+                }
+            }
+        }
+    }

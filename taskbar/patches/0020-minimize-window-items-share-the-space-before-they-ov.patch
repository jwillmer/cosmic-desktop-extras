+/// Lays out `count` items along a panel with `space` on its major axis (`None`: no limit).
+/// Items are `max` long while they fit, else they share the space down to `min`; below that
+/// the rest go to the overflow popup, whose button takes `button`. Returns the number of
+/// items shown and their length. A limited space is filled to within a few pixels, so the
+/// panel sees no spare room to give back, which would make it resize the applet in a loop.
+fn fit_items(
+    space: Option<u32>,
+    count: usize,
+    max: u32,
+    min: u32,
+    button: u32,
+    spacing: u32,
+) -> (usize, u32) {
+    let Some(space) = space else {
+        return (count, max);
+    };
+    let share = |space: u32, n: usize| (space / n as u32).saturating_sub(spacing).clamp(min, max);
+    if count == 0 {
+        (0, max)
+    } else if (min + spacing) * count as u32 <= space {
+        (count, share(space, count))
+    } else {
+        let space = space.saturating_sub(button);
+        match (space / (min + spacing)) as usize {
+            0 => (0, max),
+            shown => (shown, share(space, shown)),
+        }
+    }
+}

--- /dev/null
+++ b/cosmic-applet-minimize/src/sizes.rs
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! `~/.config/minimize-ws/sizes`: widths of the taskbar's window items in pixels, one
+//! `key = value` per line (`#` comments). Missing keys keep their defaults.
+
+/// Widths of the window items on a top or bottom panel.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Sizes {
+    /// Width while all items fit.
+    pub item_width: u32,
+    /// Narrowest an item gets before the rest go to the overflow popup.
+    pub item_min_width: u32,
+    /// Width of an item in the overflow popup's list.
+    pub overflow_item_width: u32,
+}
+
+impl Default for Sizes {
+    fn default() -> Self {
+        Self {
+            item_width: 180,
+            item_min_width: 120,
+            overflow_item_width: 300,
+        }
+    }
+}
+
+/// Smallest accepted width, so an item still shows its icon.
+const MIN_WIDTH: u32 = 40;
+
+pub fn parse(content: &str) -> Sizes {
+    let mut sizes = Sizes::default();
+    for (number, line) in content.lines().enumerate() {
+        let line = line.split('#').next().unwrap_or_default().trim();
+        if line.is_empty() {
+            continue;
+        }
+        let Some((key, value)) = line.split_once('=') else {
+            tracing::error!("sizes file line {}: expected key = value, got {line:?}", number + 1);
+            continue;
+        };
+        let (key, value) = (key.trim(), value.trim());
+        let Some(value) = value.parse::<u32>().ok().filter(|v| *v >= MIN_WIDTH) else {
+            tracing::error!(
+                "sizes file line {}: {key} = {value:?} is not a width of at least {MIN_WIDTH} px",
+                number + 1
+            );
+            continue;
+        };
+        match key {
+            "item_width" => sizes.item_width = value,
+            "item_min_width" => sizes.item_min_width = value,
+            "overflow_item_width" => sizes.overflow_item_width = value,
+            _ => tracing::error!(
+                "sizes file line {}: unknown key {key:?}, expected item_width, item_min_width \
+                 or overflow_item_width",
+                number + 1
+            ),
+        }
+    }
+    if sizes.item_min_width > sizes.item_width {
+        tracing::error!(
+            "sizes file: item_min_width {} is larger than item_width {}, using {}",
+            sizes.item_min_width,
+            sizes.item_width,
+            sizes.item_width
+        );
+        sizes.item_min_width = sizes.item_width;
+    }
+    sizes
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn empty_file_gives_defaults() {
+        assert_eq!(parse(""), Sizes::default());
+        assert_eq!(parse("# nothing\n\n"), Sizes::default());
+    }
+
+    #[test]
+    fn reads_keys_and_skips_bad_lines() {
+        let sizes = parse(
+            "item_width = 200  # wider\nitem_min_width=140\noverflow_item_width = 10\nfoo = 3\nbar\n",
+        );
+        assert_eq!(
+            sizes,
+            Sizes {
+                item_width: 200,
+                item_min_width: 140,
+                overflow_item_width: 300,
+            }
+        );
+    }
+
+    #[test]
+    fn min_width_never_exceeds_width() {
+        let sizes = parse("item_width = 150\nitem_min_width = 160\n");
+        assert_eq!((sizes.item_width, sizes.item_min_width), (150, 150));
+    }
+}

             self.tx.send(WaylandUpdate::Workspace(active_workspaces)),
         );
+        self.send_workspaces();
     }
 }
 
+/// One group's workspaces ordered by coordinates, each labelled with its name or, when it has
+/// none, its 1-based position.
+fn labelled_workspaces<T>(mut workspaces: Vec<(T, &str, &[u32])>) -> Vec<(T, String)> {
+    workspaces.sort_by(|a, b| a.2.cmp(b.2));
+    workspaces
+        .into_iter()
+        .enumerate()
+        .map(|(i, (handle, name, _))| {
+            let label = if name.is_empty() {
+                (i + 1).to_string()
+            } else {
+                name.to_owned()
+            };
+            (handle, label)
+        })
+        .collect()
+}

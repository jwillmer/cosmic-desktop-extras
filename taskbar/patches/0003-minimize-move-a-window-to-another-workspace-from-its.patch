 }
 impl AppData {
+    fn send_workspaces(&mut self) {
+        let mut entries = Vec::new();
+        if self.can_move_to_workspace {
+            for group in self.workspace_state.workspace_groups() {
+                let Some(output) = group.outputs.first() else {
+                    continue;
+                };
+                let workspaces = group
+                    .workspaces
+                    .iter()
+                    .filter_map(|handle| self.workspace_state.workspace_info(handle))
+                    .map(|w| (w.handle.clone(), w.name.as_str(), w.coordinates.as_slice()))
+                    .collect();
+                entries.extend(labelled_workspaces(workspaces).into_iter().map(
+                    |(handle, label)| WorkspaceEntry {
+                        handle,
+                        label,
+                        output: output.clone(),
+                    },
+                ));
+            }
+        }
+        let _ = futures::executor::block_on(self.tx.send(WaylandUpdate::Workspaces(entries)));
+    }
+
     fn cosmic_toplevel(
         &self,
         handle: &ExtForeignToplevelHandleV1,
@@ -493,9 +530,28 @@ impl WorkspaceHandler for AppData {

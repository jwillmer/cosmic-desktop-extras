+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn workspaces_ordered_by_coordinates() {
+        let workspaces = vec![("c", "", &[2][..]), ("a", "", &[0][..]), ("b", "", &[1][..])];
+        assert_eq!(
+            labelled_workspaces(workspaces),
+            [("a", "1".to_owned()), ("b", "2".to_owned()), ("c", "3".to_owned())]
+        );
+    }
+
+    #[test]
+    fn workspaces_named_keep_name() {
+        let workspaces = vec![("b", "Mail", &[1][..]), ("a", "", &[0][..])];
+        assert_eq!(
+            labelled_workspaces(workspaces),
+            [("a", "1".to_owned()), ("b", "Mail".to_owned())]
+        );
+    }
+}

+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Tab counts of Firefox windows. Wayland does not expose tabs, so they are read from Firefox's
+//! session file (`sessionstore-backups/recovery.jsonlz4`, rewritten about every 15 s) and matched
+//! to a window by the title of its selected tab, which is also the window title.
+
+use std::{collections::HashMap, path::PathBuf, time::SystemTime};
+
+use serde::Deserialize;
+
+/// Selected-tab title -> number of tabs in that window. Titles shared by several windows are left
+/// out, because they cannot be told apart.
+pub type TabCounts = HashMap<String, usize>;
+
+#[derive(Deserialize)]
+struct Session {
+    #[serde(default)]
+    windows: Vec<Window>,
+}
+
+#[derive(Deserialize)]
+struct Window {
+    #[serde(default)]
+    tabs: Vec<Tab>,
+    #[serde(default)]
+    selected: usize,
+}
+
+#[derive(Deserialize)]
+struct Tab {
+    #[serde(default)]
+    entries: Vec<Entry>,
+    #[serde(default)]
+    index: usize,
+}
+
+#[derive(Deserialize)]
+struct Entry {
+    #[serde(default)]
+    title: String,
+    #[serde(default)]
+    url: String,
+}
+
+/// The session file of the most recently used Firefox profile.
+fn session_file() -> Option<PathBuf> {
+    let home = PathBuf::from(std::env::var_os("HOME")?);
+    let bases = [
+        home.join(".config/mozilla/firefox"),
+        home.join(".mozilla/firefox"),
+        home.join("snap/firefox/common/.mozilla/firefox"),
+    ];
+    bases
+        .iter()
+        .filter_map(|base| std::fs::read_dir(base).ok())
+        .flatten()
+        .flatten()
+        .map(|profile| profile.path().join("sessionstore-backups/recovery.jsonlz4"))
+        .filter_map(|path| Some((path.metadata().ok()?.modified().ok()?, path)))
+        .max_by_key(|(modified, _)| *modified)
+        .map(|(_, path)| path)
+}
+
+/// Reads the tab counts if the session file changed since `last`.
+/// Returns the file's modification time with the counts, or `None` when nothing changed or the
+/// file is missing or unreadable.
+pub fn load(last: Option<SystemTime>) -> Option<(SystemTime, TabCounts)> {
+    let path = session_file()?;
+    let modified = path.metadata().ok()?.modified().ok()?;
+    if last == Some(modified) {
+        return None;
+    }
+    let data = match std::fs::read(&path) {
+        Ok(data) => data,
+        Err(err) => {
+            tracing::warn!("cannot read Firefox session file {}: {err}", path.display());
+            return None;
+        }
+    };
+    let Some(json) = mozlz4(&data) else {
+        tracing::warn!("Firefox session file {} is not valid mozlz4", path.display());
+        return None;
+    };
+    let session: Session = match serde_json::from_slice(&json) {
+        Ok(session) => session,
+        Err(err) => {
+            tracing::warn!("cannot parse Firefox session file {}: {err}", path.display());
+            return None;
+        }
+    };
+
+    let mut counts = TabCounts::new();
+    let mut shared = Vec::new();
+    for window in session.windows {
+        let Some(tab) = window.tabs.get(window.selected.max(1) - 1) else {
+            continue;
+        };
+        let Some(entry) = tab.entries.get(tab.index.clamp(1, tab.entries.len().max(1)) - 1) else {
+            continue;
+        };
+        // Firefox shows the URL as window title for pages without a title.
+        let title = if entry.title.is_empty() {
+            entry.url.clone()
+        } else {
+            entry.title.clone()
+        };
+        if counts.insert(title.clone(), window.tabs.len()).is_some() {
+            shared.push(title);
+        }
+    }
+    for title in shared {
+        counts.remove(&title);
+    }
+    Some((modified, counts))
+}
+
+/// Firefox's lz4 container: magic `mozLz40\0`, u32 decompressed size, one raw lz4 block.
+fn mozlz4(data: &[u8]) -> Option<Vec<u8>> {
+    let body = data.strip_prefix(b"mozLz40\0")?;
+    let size = u32::from_le_bytes(body.get(..4)?.try_into().ok()?) as usize;
+    lz4_block(body.get(4..)?, size)
+}
+
+fn lz4_block(src: &[u8], size: usize) -> Option<Vec<u8>> {
+    fn length(src: &[u8], i: &mut usize, mut len: usize) -> Option<usize> {
+        if len == 15 {
+            loop {
+                let b = *src.get(*i)?;
+                *i += 1;
+                len += b as usize;
+                if b != 255 {
+                    break;
+                }
+            }
+        }
+        Some(len)
+    }
+
+    let mut dst = Vec::with_capacity(size);
+    let mut i = 0;
+    while i < src.len() {
+        let token = src[i];
+        i += 1;
+        let literals = length(src, &mut i, (token >> 4) as usize)?;
+        dst.extend_from_slice(src.get(i..i + literals)?);
+        i += literals;
+        if i >= src.len() {
+            break;
+        }
+        let offset = u16::from_le_bytes([*src.get(i)?, *src.get(i + 1)?]) as usize;
+        i += 2;
+        let matched = length(src, &mut i, (token & 15) as usize)? + 4;
+        let start = dst.len().checked_sub(offset).filter(|_| offset > 0)?;
+        for k in 0..matched {
+            let b = dst[start + k];
+            dst.push(b);
+        }
+    }
+    (dst.len() == size).then_some(dst)
+}

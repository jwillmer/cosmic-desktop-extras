@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Tab counts of COSMIC Terminal windows. A patched cosmic-term (cosmic-desktop-extras `terminal-tabs`)
+//! writes `$XDG_RUNTIME_DIR/cosmic-term-tabs/<pid>.json` as
+//! `{"windows":[{"title":"<window title>","tabs":<n>}]}`; windows are matched by their title.
+
+use std::path::PathBuf;
+
+use serde::Deserialize;
+
+use crate::firefox_tabs::TabCounts;
+
+#[derive(Deserialize)]
+struct File {
+    #[serde(default)]
+    windows: Vec<Window>,
+}
+
+#[derive(Deserialize)]
+struct Window {
+    title: String,
+    tabs: usize,
+}
+
+/// Reads all files of running cosmic-term processes. Titles shared by several windows are left
+/// out, because they cannot be told apart.
+pub fn load() -> TabCounts {
+    let mut counts = TabCounts::new();
+    let Some(dir) = std::env::var_os("XDG_RUNTIME_DIR").map(|d| PathBuf::from(d).join("cosmic-term-tabs"))
+    else {
+        return counts;
+    };
+    let Ok(entries) = std::fs::read_dir(&dir) else {
+        return counts;
+    };
+    let mut shared = Vec::new();
+    for entry in entries.flatten() {
+        let path = entry.path();
+        if path.extension().is_none_or(|ext| ext != "json") {
+            continue;
+        }
+        // Skip files left behind by a terminal that crashed.
+        let alive = path
+            .file_stem()
+            .and_then(|pid| pid.to_str())
+            .and_then(|pid| pid.parse::<u32>().ok())
+            .is_some_and(|pid| std::path::Path::new(&format!("/proc/{pid}")).exists());
+        if !alive {
+            continue;
+        }
+        let file: File = match std::fs::read(&path).map(|data| serde_json::from_slice(&data)) {
+            Ok(Ok(file)) => file,
+            Ok(Err(err)) => {
+                tracing::warn!("cannot parse terminal tab file {}: {err}", path.display());
+                continue;
+            }
+            Err(_) => continue, // removed between listing and reading
+        };
+        for window in file.windows {
+            if counts.insert(window.title.clone(), window.tabs).is_some() {
+                shared.push(window.title);
+            }
+        }
+    }
+    for title in shared {
+        counts.remove(&title);
+    }
+    counts
+}

 impl Minimize {
+    /// Same rule as the App List's `ActiveWorkspace` filter: a window shows when it is on an
+    /// active workspace, or when either side has no workspace information.
+    fn is_on_active_workspace(&self, info: &ToplevelInfo) -> bool {
+        self.active_workspaces.is_empty()
+            || info.workspace.is_empty()
+            || self
+                .active_workspaces
+                .iter()
+                .any(|workspace| info.workspace.contains(workspace))
+    }
+
+    /// Window title for the tooltip, so two windows of one app can be told apart.
+    fn tooltip_text(app: &App) -> String {
+        if app.toplevel_info.title.is_empty() {
+            app.name.clone()
+        } else {
+            app.toplevel_info.title.clone()
+        }
+    }
+
+    /// Starts or stops the live capture so it follows the hovered, not minimized, window.
+    fn update_live_capture(&mut self) {
+        let target = self.hovered.clone().filter(|handle| {
+            self.apps.iter().any(|a| {
+                a.toplevel_info.foreign_toplevel == *handle
+                    && !a.toplevel_info.state.contains(&ToplevelState::Minimized)
+            })
+        });
+        if target != self.live_capture {
+            if let Some(tx) = self.tx.as_ref() {
+                let _ = tx.send(WaylandRequest::LiveCapture(target.clone()));
+            }
+            self.live_capture = target;
+        }
+    }
+
+    fn is_focused(info: &ToplevelInfo) -> bool {
+        info.state.contains(&ToplevelState::Activated) && !info.state.contains(&ToplevelState::Minimized)
+    }
+
+    /// Windows to show: only those on an active workspace.
+    fn visible_apps(&self) -> Vec<&App> {
+        self.apps
+            .iter()
+            .filter(|app| self.is_on_active_workspace(&app.toplevel_info))
+            .filter(|app| !self.ignored_apps.contains(&app.toplevel_info.app_id))
+            .collect()
+    }
+
+    fn load_ignored_apps() -> Vec<String> {
+        let Some(home) = std::env::var_os("HOME") else {
+            return Vec::new();
+        };
+        let path = std::path::Path::new(&home).join(".config/minimize-ws/ignore");
+        std::fs::read_to_string(path)
+            .unwrap_or_default()
+            .lines()
+            .map(|line| line.split('#').next().unwrap_or_default().trim().to_owned())
+            .filter(|line| !line.is_empty())
+            .collect()
+    }
+
+    fn is_firefox(app: &App) -> bool {
+        app.toplevel_info.app_id == "firefox"
+    }
+
+    fn is_terminal(app: &App) -> bool {
+        app.toplevel_info.app_id == "com.system76.CosmicTerm"
+    }
+
+    /// Number of tabs of a Firefox or COSMIC Terminal window; `None` when unknown.
+    fn tab_count(&self, app: &App) -> Option<usize> {
+        if Self::is_terminal(app) {
+            return self.term_tabs.get(&app.toplevel_info.title).copied();
+        }
+        if !Self::is_firefox(app) {
+            return None;
+        }
+        let title = &app.toplevel_info.title;
+        let tab_title = [" — Mozilla Firefox Private Browsing", " — Mozilla Firefox"]
+            .iter()
+            .find_map(|suffix| title.strip_suffix(suffix))
+            .unwrap_or(title);
+        self.firefox_tabs.get(tab_title).copied()
+    }
+
+    fn is_horizontal(&self) -> bool {
+        matches!(
+            self.core.applet.anchor,
+            PanelAnchor::Top | PanelAnchor::Bottom
+        )
+    }
+
+    /// Title without a trailing " — Mozilla Firefox" style app suffix, to save space.
+    fn short_title(app: &App) -> String {
+        let title = Self::tooltip_text(app);
+        // Match the suffix against the app name ("COSMIC Terminal") or the last part of the
+        // app id ("firefox" for "Mozilla Firefox").
+        let names = [
+            app.name.to_lowercase(),
+            app.toplevel_info
+                .app_id
+                .rsplit('.')
+                .next()
+                .unwrap_or_default()
+                .to_lowercase(),
+        ];
+        for sep in [" — ", " – ", " - "] {
+            if let Some((head, tail)) = title.rsplit_once(sep) {
+                let tail = tail.to_lowercase();
+                if !head.is_empty() && names.iter().any(|n| n.len() > 2 && tail.contains(n.as_str())) {
+                    return head.to_owned();
+                }
+            }
+        }
+        title
+    }
+
+    /// Panel item for a top or bottom panel: app icon and window title. The focused window
+    /// gets an accent background.
+    fn label_item(&self, app: &App, on_press: Message) -> Element<'_, Message> {
+        let (icon_size, _) = self.core.applet.suggested_size(false);
+        let (_, cross_padding) = self.core.applet.suggested_padding(false);
+        let focused = Self::is_focused(&app.toplevel_info);
+        // A little smaller than the panel's icon size, to leave room for two lines of text.
+        let small_icon = (icon_size as f32 * 0.8).round();
+        let title = text(Self::short_title(app))
+            .size(13)
+            .wrapping(text::Wrapping::None)
+            .ellipsize(iced::core::text::Ellipsize::End(
+                iced::core::text::EllipsizeHeightLimit::Lines(1),
+            ))
+            .width(Length::Fill);
+        // Tab count as a second line, so it costs no width.
+        let tabs = self.tab_count(app).filter(|n| *n > 1).map(|n| {
+            text(format!("{n} tabs"))
+                .size(10)
+                .class(cosmic::theme::Text::Custom(|theme| iced::widget::text::Style {
+                    color: Some(theme.cosmic().palette.neutral_7.into()),
+                    ..Default::default()
+                }))
+        });
+        let content = Row::new()
+            .push(
+                cosmic::widget::icon(app.icon_source.as_cosmic_icon())
+                    .width(Length::Fixed(small_icon))
+                    .height(Length::Fixed(small_icon)),
+            )
+            .push(
+                cosmic::widget::Column::new()
+                    .push(title)
+                    .push_maybe(tabs)
+                    .width(Length::Fill),
+            )
+            .spacing(6)
+            // Fill the item's height so icon and title sit in the vertical middle.
+            .height(Length::Fill)
+            .align_y(iced::Alignment::Center);
+        let item = cosmic::widget::button::custom(content)
+            .on_press(on_press)
+            .width(Length::Fixed(LABEL_WIDTH as f32))
+            .height(Length::Fixed((icon_size + 2 * cross_padding) as f32))
+            .padding([0, 8])
+            .class(cosmic::theme::Button::AppletIcon);
+        cosmic::widget::container(item)
+            .class(cosmic::theme::Container::custom(move |theme| {
+                let cosmic = theme.cosmic();
+                let mut accent: iced::Color = cosmic.accent_color().into();
+                accent.a = if focused { 0.25 } else { 0.0 };
+                iced::widget::container::Style {
+                    background: Some(accent.into()),
+                    border: iced::Border {
+                        radius: cosmic.corner_radii.radius_s.into(),
+                        ..Default::default()
+                    },
+                    ..Default::default()
+                }
+            }))
+            .into()
+    }

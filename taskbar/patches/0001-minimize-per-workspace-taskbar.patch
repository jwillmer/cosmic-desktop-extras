+    fn close_menu(&mut self) -> app::Task<Message> {
+        if let Some((id, _)) = self.menu_popup.take() {
+            return cosmic::surface::surface_task(cosmic::surface::action::destroy_popup(id));
+        }
+        Task::none()
+    }
+
+    /// Wraps a taskbar item: middle click closes the window, right click opens its menu.
+    fn item_mouse_area<'a>(
+        item: Element<'a, Message>,
+        app: &App,
+        parent: window::Id,
+        index: usize,
+    ) -> Element<'a, Message> {
+        let handle = &app.toplevel_info.foreign_toplevel;
+        mouse_area(item)
+            .on_middle_press(Message::Close(handle.clone()))
+            .on_right_release(Message::OpenMenu(handle.clone(), parent, index))
+            .into()
+    }

+
+//! Hover preview: a popup next to a taskbar item with a larger image of the window and its title.
+
+use std::{
+    borrow::Cow,
+    sync::{Arc, LazyLock, Mutex},
+    time::Duration,
+};
+
+use cosmic::{
+    Element,
+    applet::{Context, cosmic_panel_config::PanelAnchor},
+    cctk::sctk::reexports::protocols::xdg::shell::client::xdg_positioner::{Anchor, Gravity},
+    iced::{
+        self, Alignment, Length, Limits, Rectangle,
+        runtime::platform_specific::wayland::popup::{SctkPopupSettings, SctkPositioner},
+        widget::{Column, text},
+        window,
+    },
+    surface,
+    widget::{
+        Image, autosize::autosize, image::Handle, layer_container,
+        wayland::tooltip::widget::Tooltip,
+    },
+};
+
+use crate::wayland_subscription::WaylandImage;
+
+/// Long side of the preview image, in logical pixels.
+const PREVIEW_SIZE: f32 = 240.0;
+
+pub static PREVIEW_WINDOW_ID: LazyLock<window::Id> = LazyLock::new(window::Id::unique);
+static PREVIEW_AUTOSIZE_ID: LazyLock<iced::id::Id> =
+    LazyLock::new(|| iced::id::Id::new("preview-autosize"));
+
+#[derive(Clone)]
+struct PreviewImage {
+    handle: Handle,
+    width: u32,
+    height: u32,
+}
+
+/// The image the open preview popup shows. The popup's view is fixed when the popup opens, so
+/// it reads the image from here on every redraw; that is what lets the preview update live.
+#[derive(Clone, Default)]
+pub struct SharedPreview(Arc<Mutex<Option<PreviewImage>>>);
+
+impl SharedPreview {
+    pub fn set(&self, img: Option<&WaylandImage>) {
+        let img = img.map(|img| PreviewImage {
+            handle: Handle::from_rgba(img.width, img.height, img.img.clone()),
+            width: img.width,
+            height: img.height,
+        });
+        *self.0.lock().unwrap() = img;
+    }
+
+    fn get(&self) -> Option<PreviewImage> {
+        self.0.lock().unwrap().clone()
+    }
+}
+
+/// Like `Context::applet_tooltip`, but the popup shows the window preview above the title.
+pub fn preview_tooltip<'a, Message: Clone + 'static>(
+    applet: &Context,
+    content: impl Into<Element<'a, Message>>,
+    title: impl Into<Cow<'static, str>>,
+    preview: SharedPreview,
+    has_popup: bool,
+    delay: Duration,
+    on_leave: Message,
+    on_surface_action: impl Fn(surface::Action<Message>) -> Message + 'static,
+) -> Tooltip<'a, Message, Message> {
+    let anchor = applet.anchor;
+    let title = title.into();
+
+    Tooltip::new(
+        content,
+        (!has_popup).then_some(move |bounds: Rectangle| {
+            // GAP pixels between the panel item and the preview, pointing away from the panel.
+            const GAP: i32 = 8;
+            let (popup_anchor, gravity, offset) = match anchor {
+                PanelAnchor::Left => (Anchor::Right, Gravity::Right, (GAP, 0)),
+                PanelAnchor::Right => (Anchor::Left, Gravity::Left, (-GAP, 0)),
+                PanelAnchor::Top => (Anchor::Bottom, Gravity::Bottom, (0, GAP)),
+                PanelAnchor::Bottom => (Anchor::Top, Gravity::Top, (0, -GAP)),
+            };
+
+            SctkPopupSettings {
+                parent: window::Id::RESERVED,
+                id: *PREVIEW_WINDOW_ID,
+                grab: false,
+                // Not clickable: pointer input goes through to the panel.
+                input_zone: Some(vec![Rectangle::new(
+                    iced::Point::new(-1000., -1000.),
+                    iced::Size::default(),
+                )]),
+                positioner: SctkPositioner {
+                    size: None,
+                    size_limits: Limits::NONE.min_width(1.).min_height(1.),
+                    anchor_rect: Rectangle {
+                        x: bounds.x.round() as i32,
+                        y: bounds.y.round() as i32,
+                        width: bounds.width.round() as i32,
+                        height: bounds.height.round() as i32,
+                    },
+                    anchor: popup_anchor,
+                    gravity,
+                    constraint_adjustment: 15,
+                    offset,
+                    reactive: true,
+                },
+                parent_size: None,
+                close_with_children: true,
+            }
+        }),
+        move || {
+            let mut column = Column::new()
+                .spacing(4.)
+                .align_x(Alignment::Center)
+                .max_width(PREVIEW_SIZE);
+            if let Some(img) = preview.get() {
+                let ratio = img.width.max(img.height).max(1) as f32 / PREVIEW_SIZE;
+                column = column.push(
+                    Image::new(img.handle)
+                        .width(Length::Fixed(img.width as f32 / ratio))
+                        .height(Length::Fixed(img.height as f32 / ratio))
+                        .content_fit(iced::ContentFit::Contain),
+                );
+            }
+            column = column.push(
+                text(title.clone())
+                    .shaping(text::Shaping::Advanced)
+                    .wrapping(text::Wrapping::WordOrGlyph),
+            );
+            Element::from(autosize(
+                layer_container(column)
+                    .layer(cosmic::cosmic_theme::Layer::Background)
+                    .padding(8.),
+                PREVIEW_AUTOSIZE_ID.clone(),
+            ))
+        },
+        on_leave,
+        on_surface_action,
+    )
+    .delay(delay)
+}

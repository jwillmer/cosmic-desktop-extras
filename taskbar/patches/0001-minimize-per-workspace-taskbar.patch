+    /// Right-click menu for one window: desktop actions, window state, close.
+    fn menu_view(&self, handle: &ExtForeignToplevelHandleV1) -> Element<'_, Message> {
+        let mut content = column![].padding([8, 0]);
+        if let Some(app) = self
+            .apps
+            .iter()
+            .find(|a| a.toplevel_info.foreign_toplevel == *handle)
+        {
+            let theme = self.core.system_theme().cosmic();
+            let menu_divider = || {
+                padded_control(divider::horizontal::default())
+                    .padding([theme.space_xxs(), theme.space_s()])
+            };
+            let desktop_entry = &app.desktop_entry;
+            let entry = Arc::new(desktop_entry.clone());
+            let actions: Vec<&str> = desktop_entry.actions().into_iter().flatten().collect();
+
+            if desktop_entry.exec().is_some() {
+                // Most browsers ship a "new-window" action; only add our own entry without one.
+                if !actions.contains(&"new-window") {
+                    content = content.push(
+                        menu_button(cosmic::widget::text::body(fl!("new-window")))
+                            .on_press(Message::MenuExec(Arc::clone(&entry), None)),
+                    );
+                }
+                for action in &actions {
+                    let Some(name) = desktop_entry.action_entry_localized(action, "Name", &self.locales)

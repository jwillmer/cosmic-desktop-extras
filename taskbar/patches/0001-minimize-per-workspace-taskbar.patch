diff --git a/cosmic-applet-minimize/src/wayland_handler/live_capture.rs b/cosmic-applet-minimize/src/wayland_handler/live_capture.rs
new file mode 100644
index 00000000..f61b95a3
--- /dev/null
+++ b/cosmic-applet-minimize/src/wayland_handler/live_capture.rs
@@ -0,0 +1,370 @@
+// Copyright 2023 System76 <info@system76.com>
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Live capture of the one window whose preview is shown while its taskbar item is hovered.
+//!
+//! Ported from the persistent-session approach of cosmic-workspaces: the session stays open,
+//! and every `ready` frame re-attaches the buffer and commits again, so the compositor sends a
+//! frame whenever the window redraws. Only shm buffers are used, so frames are throttled to
+//! [`FRAME_INTERVAL`] to keep the copy and downscale cheap.
+
+use std::{
+    os::fd::{AsFd, OwnedFd},
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+use cosmic::{
+    cctk::{
+        screencopy::{
+            CaptureOptions, CaptureSession, CaptureSource, FailureReason, Formats, Rect,
+            ScreencopyFrameData, ScreencopyFrameDataExt, ScreencopySessionData,
+            ScreencopySessionDataExt,
+        },
+        sctk::reexports::calloop::{
+            RegistrationToken,
+            timer::{TimeoutAction, Timer},
+        },
+        wayland_client::{
+            WEnum,
+            protocol::{wl_buffer::WlBuffer, wl_shm},
+        },
+        wayland_protocols::ext::foreign_toplevel_list::v1::client::ext_foreign_toplevel_handle_v1::ExtForeignToplevelHandleV1,
+    },
+    iced::futures,
+};
+use futures::SinkExt;
+
+use super::{AppData, thumbnail};
+use crate::wayland_subscription::{WaylandImage, WaylandUpdate};
+
+/// At most 5 frames per second.
+const FRAME_INTERVAL: Duration = Duration::from_millis(200);
+
+pub(super) struct LiveCapture {
+    handle: ExtForeignToplevelHandleV1,
+    /// Tells this session's events apart from those of an earlier, already stopped one.
+    id: u64,
+    session: CaptureSession,
+    formats: Option<Formats>,
+    buffer: Option<Arc<ShmBuffer>>,
+    /// A frame was committed and its `ready` or `failed` has not arrived yet.
+    in_flight: bool,
+    last_commit: Option<Instant>,
+    timer: Option<RegistrationToken>,
+    /// A frame is being downscaled; newer frames are skipped until it is sent, keeping order.
+    converting: Arc<AtomicBool>,
+}
+
+struct ShmBuffer {
+    buffer: WlBuffer,
+    mmap: memmap2::Mmap,
+    width: u32,
+    height: u32,
+    _fd: OwnedFd,
+}
+
+impl Drop for ShmBuffer {
+    fn drop(&mut self) {
+        self.buffer.destroy();
+    }
+}
+
+pub(super) struct LiveSessionData {
+    session_data: ScreencopySessionData,
+    id: u64,
+}
+
+impl ScreencopySessionDataExt for LiveSessionData {
+    fn screencopy_session_data(&self) -> &ScreencopySessionData {
+        &self.session_data
+    }
+}
+
+pub(super) struct LiveFrameData {
+    frame_data: ScreencopyFrameData,
+    id: u64,
+    /// The buffer this frame was attached to, kept alive until the compositor is done with it.
+    buffer: Arc<ShmBuffer>,
+}
+
+impl ScreencopyFrameDataExt for LiveFrameData {
+    fn screencopy_frame_data(&self) -> &ScreencopyFrameData {
+        &self.frame_data
+    }
+}
+
+impl AppData {
+    /// Starts the live capture of `handle`, or stops it with `None`. Any earlier one is stopped.
+    pub(super) fn set_live_capture(&mut self, handle: Option<ExtForeignToplevelHandleV1>) {
+        if self.live_capture.as_ref().map(|live| &live.handle) == handle.as_ref() {
+            return;
+        }
+        self.stop_live_capture();
+        let Some(handle) = handle else {
+            return;
+        };
+
+        self.live_capture_serial += 1;
+        let id = self.live_capture_serial;
+        let session = match self.screencopy_state.capturer().create_session(
+            &CaptureSource::Toplevel(handle.clone()),
+            CaptureOptions::empty(),
+            &self.queue_handle,
+            LiveSessionData {
+                session_data: ScreencopySessionData::default(),
+                id,
+            },
+        ) {
+            Ok(session) => session,
+            Err(err) => {
+                tracing::error!(?handle, "Failed to create live capture session: {err:?}");
+                return;
+            }
+        };
+        let _ = self.conn.flush();
+        self.live_capture = Some(LiveCapture {
+            handle,
+            id,
+            session,
+            formats: None,
+            buffer: None,
+            in_flight: false,
+            last_commit: None,
+            timer: None,
+            converting: Arc::default(),
+        });
+    }
+
+    pub(super) fn stop_live_capture(&mut self) {
+        if let Some(live) = self.live_capture.take() {
+            if let Some(timer) = live.timer {
+                self.loop_handle.remove(timer);
+            }
+            // Dropping the session destroys it; an in-flight frame keeps its buffer alive.
+        }
+    }
+
+    pub(super) fn live_capture_handle(&self) -> Option<&ExtForeignToplevelHandleV1> {
+        self.live_capture.as_ref().map(|live| &live.handle)
+    }
+
+    fn current_live(&mut self, id: u64) -> Option<&mut LiveCapture> {
+        self.live_capture.as_mut().filter(|live| live.id == id)
+    }
+
+    pub(super) fn live_init_done(&mut self, session: &CaptureSession, formats: &Formats) {
+        let Some(id) = session.data::<LiveSessionData>().map(|data| data.id) else {
+            return;
+        };
+        let Some(live) = self.current_live(id) else {
+            return;
+        };
+        live.formats = Some(formats.clone());
+        let size_changed = live
+            .buffer
+            .as_ref()
+            .is_none_or(|buffer| (buffer.width, buffer.height) != formats.buffer_size);
+        if size_changed && !self.create_live_buffer() {
+            self.stop_live_capture();
+            return;
+        }
+        self.commit_live_frame();
+    }
+
+    pub(super) fn live_ready(&mut self, frame_data: &LiveFrameData) {
+        let Some(live) = self.current_live(frame_data.id) else {
+            return;
+        };
+        live.in_flight = false;
+        let handle = live.handle.clone();
+        let buffer = &frame_data.buffer;
+        if !live.converting.swap(true, Ordering::AcqRel) {
+            if let Some(img) =
+                image::RgbaImage::from_raw(buffer.width, buffer.height, buffer.mmap.to_vec())
+            {
+                // Downscale off the event loop, on the copy made above.
+                let converting = live.converting.clone();
+                let mut tx = self.tx.clone();
+                std::thread::spawn(move || {
+                    let img = thumbnail(img);
+                    if let Err(err) = futures::executor::block_on(
+                        tx.send(WaylandUpdate::Image(handle, WaylandImage::new(img))),
+                    ) {
+                        tracing::error!("Failed to send live image event to subscription {err:?}");
+                    }
+                    converting.store(false, Ordering::Release);
+                });
+            } else {
+                live.converting.store(false, Ordering::Release);
+            }
+        }
+        self.schedule_live_frame();
+    }
+
+    pub(super) fn live_failed(&mut self, frame_data: &LiveFrameData, reason: WEnum<FailureReason>) {
+        let Some(live) = self.current_live(frame_data.id) else {
+            return;
+        };
+        live.in_flight = false;
+        if reason == WEnum::Value(FailureReason::BufferConstraints) {
+            // The window was resized. If the new constraints already replaced the buffer, try
+            // again with it; otherwise `live_init_done` allocates one and commits when they come.
+            let replaced = live
+                .buffer
+                .as_ref()
+                .is_some_and(|buffer| !Arc::ptr_eq(buffer, &frame_data.buffer));
+            if replaced {
+                // Not commit_live_frame(): the failed frame still exists (see schedule_live_frame).
+                self.schedule_live_frame();
+            } else {
+                live.buffer = None;
+            }
+        } else {
+            if reason != WEnum::Value(FailureReason::Stopped) {
+                tracing::error!(handle = ?live.handle, "Live capture failed: {reason:?}");
+            }
+            self.stop_live_capture();
+        }
+    }
+
+    pub(super) fn live_stopped(&mut self, session: &CaptureSession) {
+        if let Some(id) = session.data::<LiveSessionData>().map(|data| data.id)
+            && self.current_live(id).is_some()
+        {
+            self.stop_live_capture();
+        }
+    }
+
+    /// Commits the next frame once [`FRAME_INTERVAL`] has passed since the previous commit.
+    fn schedule_live_frame(&mut self) {
+        let Some(live) = self.live_capture.as_mut() else {
+            return;
+        };
+        if live.timer.is_some() {
+            return;
+        }
+        let wait = live
+            .last_commit
+            .map(|last| FRAME_INTERVAL.saturating_sub(last.elapsed()))
+            .unwrap_or_default();
+        // Always go through the event loop, even with no wait: this runs inside the frame's
+        // ready/failed handler, and cctk destroys that frame only after the handler returns.
+        // Creating the next frame before that is a `duplicate_frame` protocol error, which
+        // kills the Wayland connection.
+        let id = live.id;
+        match self
+            .loop_handle
+            .insert_source(Timer::from_duration(wait), move |_, _, state| {
+                if let Some(live) = state.current_live(id) {
+                    live.timer = None;
+                    state.commit_live_frame();
+                }
+                TimeoutAction::Drop
+            }) {
+            Ok(token) => live.timer = Some(token),
+            Err(err) => tracing::error!("Failed to schedule live capture frame: {err}"),
+        }
+    }
+
+    fn commit_live_frame(&mut self) {
+        let Some(live) = self.live_capture.as_mut() else {
+            return;
+        };
+        if live.in_flight || live.timer.is_some() {
+            return;
+        }
+        let Some(buffer) = live.buffer.clone() else {
+            return;
+        };
+        let damage = [Rect {
+            x: 0,
+            y: 0,
+            width: buffer.width as i32,
+            height: buffer.height as i32,
+        }];
+        live.session.capture(
+            &buffer.buffer,
+            &damage,
+            &self.queue_handle,
+            LiveFrameData {
+                frame_data: ScreencopyFrameData::default(),
+                id: live.id,
+                buffer: buffer.clone(),
+            },
+        );
+        live.in_flight = true;
+        live.last_commit = Some(Instant::now());
+        let _ = self.conn.flush();
+    }
+
+    /// Replaces the live buffer with one matching the latest formats. False if that fails.
+    fn create_live_buffer(&mut self) -> bool {
+        let Some(live) = self.live_capture.as_mut() else {
+            return false;
+        };
+        let Some(formats) = live.formats.as_ref() else {
+            return false;
+        };
+        let (width, height) = formats.buffer_size;
+        if width == 0 || height == 0 {
+            return false;
+        }
+        if !formats.shm_formats.contains(&wl_shm::Format::Abgr8888) {
+            tracing::error!(
+                handle = ?live.handle,
+                shm_formats = ?formats.shm_formats,
+                "No Abgr8888 shm format offered for live capture"
+            );
+            return false;
+        }
+        let handle = live.handle.clone();
+        match create_shm_buffer(self, width, height) {
+            Ok(buffer) => {
+                if let Some(live) = self.live_capture.as_mut() {
+                    live.buffer = Some(Arc::new(buffer));
+                }
+                true
+            }
+            Err(err) => {
+                tracing::error!(?handle, width, height, "Failed to create live capture buffer: {err}");
+                false
+            }
+        }
+    }
+}
+
+fn create_shm_buffer(app_data: &AppData, width: u32, height: u32) -> anyhow::Result<ShmBuffer> {
+    let fd = rustix::fs::memfd_create(
+        c"minimize-applet-live-screencopy",
+        rustix::fs::MemfdFlags::CLOEXEC,
+    )?;
+    let len = width * height * 4;
+    rustix::fs::ftruncate(&fd, len.into())?;
+    let mmap = unsafe { memmap2::Mmap::map(&fd)? };
+    let pool =
+        app_data
+            .shm_state
+            .wl_shm()
+            .create_pool(fd.as_fd(), len as i32, &app_data.queue_handle, ());
+    let buffer = pool.create_buffer(
+        0,
+        width as i32,
+        height as i32,
+        width as i32 * 4,
+        wl_shm::Format::Abgr8888,
+        &app_data.queue_handle,
+        (),
+    );
+    pool.destroy();
+    Ok(ShmBuffer {
+        buffer,
+        mmap,
+        width,
+        height,
+        _fd: fd,
+    })
+}

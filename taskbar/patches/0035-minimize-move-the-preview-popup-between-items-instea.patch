     use super::*;
 
+    type P = Popup<u8, &'static str>;
+    const PANEL: u8 = 0;
+    const LIST: u8 = 1;
+
+    fn open(p: &mut P, parent: u8, owner: &'static str) {
+        let Open::Create(n) = p.request(parent, owner) else {
+            panic!("expected a create");
+        };
+        assert!(p.created(n, parent));
+    }
+
+    #[test]
+    fn next_item_moves_the_open_popup() {
+        let mut p = P::default();
+        open(&mut p, PANEL, "a");
+        let n = p.leave(&"a").unwrap();
+        assert_eq!(p.request(PANEL, "b"), Open::Reposition);
+        assert!(!p.linger_over(n), "b took the popup, it stays");
+    }
+
+    #[test]
+    fn enter_reported_before_leave_keeps_the_popup() {
+        let mut p = P::default();
+        open(&mut p, PANEL, "a");
+        assert_eq!(p.request(PANEL, "b"), Open::Reposition);
+        assert_eq!(p.leave(&"a"), None);
+    }
+
+    #[test]
+    fn leaving_the_taskbar_closes_after_the_linger() {
+        let mut p = P::default();
+        open(&mut p, PANEL, "a");
+        let n = p.leave(&"a").unwrap();
+        assert!(p.linger_over(n));
+        assert!(!p.linger_over(n), "closed once");
+        assert!(matches!(p.request(PANEL, "b"), Open::Create(_)));
+    }
+
+    #[test]
+    fn stale_linger_does_not_close_a_later_hover() {
+        let mut p = P::default();
+        open(&mut p, PANEL, "a");
+        let first = p.leave(&"a").unwrap();
+        assert_eq!(p.request(PANEL, "b"), Open::Reposition);
+        let second = p.leave(&"b").unwrap();
+        assert!(!p.linger_over(first));
+        assert!(p.linger_over(second));
+    }
+
+    #[test]
+    fn leaving_during_the_hover_delay_cancels_the_open() {
+        let mut p = P::default();
+        let Open::Create(n) = p.request(PANEL, "a") else { panic!() };
+        assert_eq!(p.leave(&"a"), None);
+        assert!(!p.created(n, PANEL));
+    }
+
+    #[test]
+    fn next_item_during_the_hover_delay_restarts_it() {
+        let mut p = P::default();
+        let Open::Create(a) = p.request(PANEL, "a") else { panic!() };
+        let Open::Create(b) = p.request(PANEL, "b") else { panic!() };
+        assert!(!p.created(a, PANEL), "a's delay is void");
+        assert!(p.created(b, PANEL));
+        assert_eq!(p.request(PANEL, "c"), Open::Reposition);
+    }
+
+    #[test]
+    fn other_parent_surface_recreates() {
+        let mut p = P::default();
+        open(&mut p, PANEL, "a");
+        let Open::Recreate(n) = p.request(LIST, "b") else { panic!() };
+        assert!(p.created(n, LIST));
+        assert_eq!(p.request(LIST, "c"), Open::Reposition);
+    }
+
+    #[test]
+    fn closed_from_outside_creates_again() {

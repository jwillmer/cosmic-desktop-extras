+/// How long the popup stays after the pointer left its item, so the next item can take it over.
+pub const LINGER: Duration = Duration::from_millis(100);
+
+/// What to do when an item asks for its preview.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Open {
+    /// No popup yet: create it, at once or after the hover delay, then `Popup::created(n)`.
+    Create(u64),
+    /// The popup is open on the same parent surface: move it to the item.
+    Reposition,
+    /// The popup is open on another parent (panel vs overflow list): destroy it, then create.
+    Recreate(u64),
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+enum Phase<P> {
+    #[default]
+    Closed,
+    /// Asked for; the surface is not created yet (hover delay).
+    Pending(u64),
+    Open(P),
+}
+
+/// The one preview popup. Moving the pointer from item to item moves the popup instead of
+/// destroying its surface and creating the next: the compositor draws a destroyed surface for
+/// one more frame, which fails once its buffer is gone ("import for wrong devices").
+/// `P` is the parent surface, `K` the item the popup belongs to.
+#[derive(Debug)]
+pub struct Popup<P, K> {
+    phase: Phase<P>,
+    owner: Option<K>,
+    counter: u64,
+}
+
+impl<P, K> Default for Popup<P, K> {
+    fn default() -> Self {
+        Self {
+            phase: Phase::Closed,
+            owner: None,
+            counter: 0,
+        }
     }
 }
 
+impl<P: PartialEq + Copy, K: PartialEq> Popup<P, K> {
+    fn next(&mut self) -> u64 {
+        self.counter += 1;
+        self.counter
+    }
+
+    /// Item `owner` on surface `parent` wants its preview.
+    pub fn request(&mut self, parent: P, owner: K) -> Open {
+        self.owner = Some(owner);
+        match self.phase {
+            Phase::Open(p) if p == parent => Open::Reposition,
+            Phase::Open(_) => {
+                let n = self.next();
+                self.phase = Phase::Pending(n);
+                Open::Recreate(n)
+            }
+            Phase::Closed | Phase::Pending(_) => {
+                let n = self.next();
+                self.phase = Phase::Pending(n);
+                Open::Create(n)
+            }
+        }
+    }
+
+    /// The delay of `Open::Create(n)` is over. True: still wanted, create the surface now.
+    pub fn created(&mut self, n: u64, parent: P) -> bool {
+        let wanted = self.phase == Phase::Pending(n);
+        if wanted {
+            self.phase = Phase::Open(parent);
+        }
+        wanted
+    }
+
+    /// The pointer left item `owner`. `Some(n)`: the popup is open and nobody else took it; close
+    /// it after `LINGER` if `linger_over(n)` still says so. A leave of an item that no longer
+    /// owns the popup (the next item was entered first) changes nothing.
+    pub fn leave(&mut self, owner: &K) -> Option<u64> {
+        if self.owner.as_ref() != Some(owner) {
+            return None;
+        }
+        self.owner = None;
+        match self.phase {
+            Phase::Open(_) => Some(self.next()),
+            Phase::Pending(_) => {
+                self.phase = Phase::Closed;
+                None
+            }
+            Phase::Closed => None,
+        }
+    }
+
+    /// True: no item took the popup since `leave` returned `n`; it counts as closed, destroy it.
+    pub fn linger_over(&mut self, n: u64) -> bool {
+        let close = matches!(self.phase, Phase::Open(_)) && self.owner.is_none() && self.counter == n;
+        if close {
+            self.phase = Phase::Closed;
+        }
+        close
+    }
+
+    /// The popup was destroyed or is being destroyed. True when it was open.
+    pub fn closed(&mut self) -> bool {
+        self.owner = None;
+        matches!(std::mem::take(&mut self.phase), Phase::Open(_))
+    }
+}

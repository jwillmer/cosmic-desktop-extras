index 00000000..51f38bd7
--- /dev/null
+++ b/cosmic-applet-minimize/src/title_rows.rs
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Splits a title that has no second row over both rows: row 1 takes what fits on one line,
+//! row 2 the rest.
+
+use cosmic::iced::{
+    Pixels, Size,
+    core::text::{self, Paragraph as _},
+};
+
+type Paragraph = <cosmic::Renderer as text::Renderer>::Paragraph;
+
+/// Width of `content` on one line at `size` px in the interface font, as the text widget
+/// shapes it.
+pub fn width(content: &str, size: f32) -> f32 {
+    Paragraph::with_text(text::Text {
+        content,
+        bounds: Size::INFINITE,
+        size: Pixels(size),
+        line_height: text::LineHeight::default(),
+        font: cosmic::font::default(),
+        align_x: text::Alignment::Default,
+        align_y: cosmic::iced::alignment::Vertical::Top,
+        shaping: text::Shaping::default(),
+        wrapping: text::Wrapping::None,
+        ellipsize: text::Ellipsize::None,
+    })
+    .min_bounds()
+    .width
+}
+
+/// Row 1 and row 2 of `title`. Row 1 is the longest prefix that `fits`, broken after a word,
+/// or after a character when not even the first word fits. Row 2 is the rest without its
+/// leading whitespace, or `None` when the whole title fits.
+pub fn split<'a>(title: &'a str, fits: impl Fn(&str) -> bool) -> (&'a str, Option<&'a str>) {
+    let title = title.trim();
+    if title.is_empty() || fits(title) {
+        return (title, None);
+    }
+    // Ends of words: each byte offset where a whitespace run starts.
+    let word_ends: Vec<usize> = title
+        .char_indices()
+        .zip(title.chars().skip(1))
+        .filter(|&((_, c), next)| !c.is_whitespace() && next.is_whitespace())
+        .map(|((i, c), _)| i + c.len_utf8())
+        .collect();
+    let end = match longest_fitting(&word_ends, |&end| fits(&title[..end])) {
+        Some(end) => end,
+        None => {
+            let char_ends: Vec<usize> =
+                title.char_indices().map(|(i, c)| i + c.len_utf8()).collect();
+            // At least one character, so row 1 is never empty.
+            longest_fitting(&char_ends, |&end| fits(&title[..end])).unwrap_or(char_ends[0])
+        }
+    };
+    let rest = title[end..].trim_start();
+    (&title[..end], (!rest.is_empty()).then_some(rest))
+}
+
+/// Last of the ascending `ends` that `fits`, assuming that every end before a fitting one
+/// fits too.
+fn longest_fitting(ends: &[usize], fits: impl Fn(&usize) -> bool) -> Option<usize> {
+    let count = ends.partition_point(fits);
+    count.checked_sub(1).map(|i| ends[i])
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Fits up to `max` characters.
+    fn chars(max: usize) -> impl Fn(&str) -> bool {
+        move |s: &str| s.chars().count() <= max
+    }
+
+    #[test]
+    fn breaks_after_the_last_word_that_fits() {
+        assert_eq!(
+            split("Inbox - Mail from Anna", chars(12)),
+            ("Inbox - Mail", Some("from Anna"))
+        );
+    }
+
+    #[test]
+    fn breaks_a_word_that_does_not_fit_after_a_character() {
+        assert_eq!(
+            split("Supercalifragilistic word", chars(5)),
+            ("Super", Some("califragilistic word"))
+        );
+    }
+
+    #[test]
+    fn a_title_that_fits_has_no_second_row() {
+        assert_eq!(split("Terminal", chars(20)), ("Terminal", None));
+    }
+
+    #[test]
+    fn row_2_starts_without_whitespace() {
+        assert_eq!(split("one   two", chars(5)), ("one", Some("two")));
+    }
+
+    #[test]
+    fn an_empty_title_stays_empty() {
+        assert_eq!(split("", chars(0)), ("", None));
+        assert_eq!(split("   ", chars(0)), ("", None));
+    }
+
+    #[test]
+    fn splits_multibyte_characters_whole() {
+        assert_eq!(split("äöü", chars(2)), ("äö", Some("ü")));
+    }
+
+    #[test]
+    fn keeps_at_least_one_character_on_row_1() {
+        assert_eq!(split("ab", chars(0)), ("a", Some("b")));
+    }
+}

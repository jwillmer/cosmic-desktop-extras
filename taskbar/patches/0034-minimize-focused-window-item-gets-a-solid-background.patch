--- /dev/null
+++ b/cosmic-applet-minimize/src/colors.rs
@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! `~/.config/minimize-ws/colors`: colours of the focused window item, one `key = value` per
+//! line (`#` comments: a whole line, or after a value and a space). Missing or invalid keys keep
+//! their defaults.
+
+use cosmic::iced::Color;
+
+/// A colour from the theme or a fixed one.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum Choice {
+    /// The theme's colour for this place.
+    System,
+    /// `#RRGGBB`.
+    Rgb(u8, u8, u8),
+}
+
+impl Choice {
+    fn or(self, system: Color) -> Color {
+        match self {
+            Self::System => system,
+            Self::Rgb(r, g, b) => Color::from_rgb8(r, g, b),
+        }
+    }
+}
+
+/// Colours of the focused window item on a top or bottom panel.
+#[derive(Debug, Clone, PartialEq)]
+pub struct Colors {
+    /// Background; `System` is the theme's accent.
+    pub focused_bg: Choice,
+    /// How far `focused_bg` is mixed toward black, 0 (unchanged) to 1 (black).
+    pub focused_darken: f32,
+    /// Title and second row; `System` is the text colour of the theme's accent buttons.
+    pub focused_text: Choice,
+}
+
+impl Default for Colors {
+    fn default() -> Self {
+        Self {
+            focused_bg: Choice::System,
+            focused_darken: 0.3,
+            focused_text: Choice::System,
+        }
+    }
+}
+
+impl Colors {
+    /// Background and text colour of the focused item, from the theme's accent and the text
+    /// colour of its accent buttons. The background is opaque.
+    pub fn focused(&self, accent: Color, accent_text: Color) -> (Color, Color) {
+        let bg = self.focused_bg.or(accent);
+        let keep = 1.0 - self.focused_darken;
+        let bg = Color::from_rgb(bg.r * keep, bg.g * keep, bg.b * keep);
+        (bg, self.focused_text.or(accent_text))
+    }
+}
+
+pub fn parse(content: &str) -> Colors {
+    let mut colors = Colors::default();
+    for (number, line) in content.lines().enumerate() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let Some((key, rest)) = line.split_once('=') else {
+            tracing::error!("colors file line {}: expected key = value, got {line:?}", number + 1);
+            continue;
+        };
+        // A value is one word, so a `#RRGGBB` value is not taken for a comment; a comment
+        // after it starts with `#` after a space.
+        let key = key.trim();
+        let mut words = rest.split_whitespace();
+        let value = words.next().unwrap_or_default();
+        if words.next().is_some_and(|word| !word.starts_with('#')) {
+            tracing::error!(
+                "colors file line {}: {key} = {:?} is more than one value, using the default",
+                number + 1,
+                rest.trim()
+            );
+            continue;
+        }
+        match key {
+            "focused_bg" | "focused_text" => match choice(value) {
+                Some(choice) if key == "focused_bg" => colors.focused_bg = choice,
+                Some(choice) => colors.focused_text = choice,
+                None => tracing::error!(
+                    "colors file line {}: {key} = {value:?} is not system or #RRGGBB, using system",
+                    number + 1
+                ),
+            },
+            "focused_darken" => {
+                match value.parse::<f32>().ok().filter(|v| (0.0..=1.0).contains(v)) {
+                    Some(darken) => colors.focused_darken = darken,
+                    None => tracing::error!(
+                        "colors file line {}: focused_darken = {value:?} is not a number from 0 \
+                         to 1, using {}",
+                        number + 1,
+                        Colors::default().focused_darken
+                    ),
+                }
+            }
+            _ => tracing::error!(
+                "colors file line {}: unknown key {key:?}, expected focused_bg, focused_darken \
+                 or focused_text",
+                number + 1
+            ),
+        }
+    }
+    colors
+}
+
+/// `system` or `#RRGGBB`.
+fn choice(value: &str) -> Option<Choice> {
+    if value == "system" {
+        return Some(Choice::System);
+    }
+    let hex = value.strip_prefix('#')?;
+    if hex.len() != 6 || !hex.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return None;
+    }
+    let channel = |i: usize| u8::from_str_radix(&hex[i..i + 2], 16).ok();
+    Some(Choice::Rgb(channel(0)?, channel(2)?, channel(4)?))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn empty_file_gives_defaults() {
+        assert_eq!(parse(""), Colors::default());
+        assert_eq!(parse("# nothing\n\n"), Colors::default());
+    }
+
+    #[test]
+    fn reads_hex_and_system() {
+        let colors = parse(
+            "focused_bg = #0067B8  # blue\nfocused_text=#ffffff\nfocused_darken = 0\n",
+        );
+        assert_eq!(
+            colors,
+            Colors {
+                focused_bg: Choice::Rgb(0x00, 0x67, 0xb8),
+                focused_darken: 0.0,
+                focused_text: Choice::Rgb(0xff, 0xff, 0xff),
+            }
+        );
+        let colors = parse("focused_bg = #123456\nfocused_bg = system # theme\n");
+        assert_eq!(colors.focused_bg, Choice::System);
+    }
+
+    #[test]
+    fn bad_values_keep_the_default_of_that_key_only() {
+        let colors = parse(
+            "focused_bg = #12345\nfocused_text = red\nfocused_darken = 1.5\nfoo = 1\nbar\n\
+             focused_bg = #GG0000\nfocused_text = #ffffff white\n",
+        );
+        assert_eq!(colors, Colors::default());
+        let colors = parse("focused_darken = -0.1\nfocused_text = #000000\n");
+        assert_eq!(colors.focused_darken, 0.3);
+        assert_eq!(colors.focused_text, Choice::Rgb(0, 0, 0));
+        assert_eq!(parse("focused_darken = x\n").focused_darken, 0.3);
+        assert_eq!(parse("focused_darken = 1\n").focused_darken, 1.0);
+    }
+
+    #[test]
+    fn focused_mixes_the_background_toward_black() {
+        let accent = Color::from_rgb8(0x00, 0x67, 0xb8);
+        let text = Color::WHITE;
+        let (bg, fg) = Colors::default().focused(accent, text);
+        assert_eq!(fg, text);
+        assert_eq!(bg.a, 1.0);
+        let rgb8 = |c: f32| (c * 255.0).round() as u8;
+        assert_eq!((rgb8(bg.r), rgb8(bg.g), rgb8(bg.b)), (0x00, 0x48, 0x81));
+
+        let colors = parse("focused_bg = #808080\nfocused_darken = 0\nfocused_text = #000000\n");
+        let (bg, fg) = colors.focused(accent, text);
+        assert_eq!(bg, Color::from_rgb8(0x80, 0x80, 0x80));
+        assert_eq!(fg, Color::BLACK);
+    }
+}

@@ -246,6 +254,13 @@ pub fn match_windows<'a, K: Hash + Eq + Clone + 'a>(
     for (key, title, history) in windows {
         groups.entry(title).or_default().push((key, history));
     }
+    // Session windows whose selected tab no window shows: switched away from since the file
+    // was written.
+    let mut stale: Vec<&SessionWindow> = session
+        .iter()
+        .filter(|w| !groups.contains_key(w.selected.as_str()))
+        .collect();
+    let mut late: Vec<(K, &str, &[String])> = Vec::new();
     let mut matches = HashMap::new();
     for (title, mut free_windows) in groups {
         let mut free: Vec<&SessionWindow> =
@@ -253,12 +268,16 @@ pub fn match_windows<'a, K: Hash + Eq + Clone + 'a>(
         let score = |history: &[String], w: &SessionWindow| {
             history.iter().filter(|t| w.titles.contains(*t)).count()
         };
-        while let Some((i, j)) = best_claim(&free_windows, &free, score) {
+        while let Some((i, j)) = best_claim(&free_windows, &free, |(_, history), w| score(history, w)) {
             let (key, _) = free_windows.swap_remove(i);
             matches.insert(key, Match::Tabs(free.swap_remove(j).tabs));
         }
         let rest = if free_windows.is_empty() {
             continue;
+        } else if free.is_empty() && title != BLANK_TITLE {
+            // Every window has blank tabs now and then: a blank title tells none apart.
+            late.extend(free_windows.into_iter().map(|(key, history)| (key, title, history)));
+            continue;
         } else if free_windows.len() > free.len() {
             Match::Unknown
         } else if free.iter().all(|w| w.tabs == free[0].tabs) {
@@ -268,14 +287,38 @@ pub fn match_windows<'a, K: Hash + Eq + Clone + 'a>(
         };
         matches.extend(free_windows.into_iter().map(|(key, _)| (key, rest)));
     }
+    // Only pages with the window's title count, so a window takes none without it.
+    let score = |title: &str, history: &[String], w: &SessionWindow| {
+        if w.titles.contains(title) {
+            history.iter().filter(|t| w.titles.contains(*t)).count().max(1)
+        } else {
+            0
+        }
+    };
+    loop {
+        let (mut wanting, rest): (Vec<_>, Vec<_>) = late
+            .into_iter()
+            .partition(|(_, title, history)| stale.iter().any(|w| score(title, history, w) > 0));
+        late = rest;
+        let claim =
+            best_claim(&wanting, &stale, |(_, title, history), w| score(title, history, w));
+        let Some((i, j)) = claim else {
+            late.append(&mut wanting);
+            break;
+        };
+        let (key, _, _) = wanting.swap_remove(i);
+        matches.insert(key, Match::Tabs(stale.swap_remove(j).tabs));
+        late.append(&mut wanting);
+    }
+    matches.extend(late.into_iter().map(|(key, _, _)| (key, Match::Unknown)));
     matches
 }
 

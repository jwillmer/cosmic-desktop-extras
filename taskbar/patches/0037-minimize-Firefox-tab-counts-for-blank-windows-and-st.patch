+        // Not a new blank window: blank tabs are in many windows.
+        let session = vec![window("Weather", &[BLANK_TITLE], 3), window("Notes", &[], 4)];
+        assert_eq!(
+            matches(&session, &[(1, BLANK_TITLE, &[]), (2, "Notes", &[])])[&1],

-            // A new or blank tab: the window title is only the app name.
+        // A new or blank tab: the window title is only the app name. Firefox stores the blank
+        // tab's URL as its title too.
+        if BLANK_PAGES.contains(&self.url.as_str())
+            && (self.title.is_empty() || self.title == self.url)
+        {
             BLANK_TITLE.to_owned()
+        } else if !self.title.is_empty() {
+            self.title.clone()
         } else {
             // Firefox shows the URL as window title for pages without a title.
             self.url.clone()
@@ -238,6 +241,11 @@ impl<K: Hash + Eq> TitleHistory<K> {

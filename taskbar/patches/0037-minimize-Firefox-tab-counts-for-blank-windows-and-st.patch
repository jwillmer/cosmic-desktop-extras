+            window("Weather", &["Recipes"], 3),
+            window("Docs", &["Recipes"], 5),
+            window("Notes", &[], 4),
+        ];
+        assert_eq!(
+            matches(&session, &[(1, "Recipes", &["Weather", "Recipes"]), (2, "Notes", &[])])[&1],
+            Match::Tabs(3)
+        );
+    }

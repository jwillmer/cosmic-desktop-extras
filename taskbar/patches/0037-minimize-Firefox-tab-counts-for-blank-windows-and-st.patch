+    /// A session file like a real one: many blank windows, two windows on the same page with
+    /// different counts, and windows on pages of their own.
+    fn realistic_session() -> Session {
+        let blank = r#"{"selected":1,"tabs":[{"entries":[{"title":"chrome://browser/content/blanktab.html","url":"chrome://browser/content/blanktab.html"}],"index":1}]}"#;
+        let windows = [
+            r#"{"selected":1,"tabs":[{"entries":[{"title":"Inbox"}],"index":1},{"entries":[{"title":"Calendar"}],"index":1},{"entries":[{"title":"Docs"}],"index":1},{"entries":[{"title":"Wiki"}],"index":1},{"entries":[{"title":"Chat"}],"index":1}]}"#,
+            r#"{"selected":2,"tabs":[{"entries":[{"title":"Shop"}],"index":1},{"entries":[{"title":"News"}],"index":1}]}"#,
+            r#"{"selected":1,"tabs":[{"entries":[{"title":"Same page"}],"index":1},{"entries":[{"title":"A"}],"index":1},{"entries":[{"title":"B"}],"index":1}]}"#,
+            r#"{"selected":1,"tabs":[{"entries":[{"title":"Same page"}],"index":1},{"entries":[{"title":"C"}],"index":1},{"entries":[{"title":"D"}],"index":1},{"entries":[{"title":"E"}],"index":1}]}"#,
+        ];
+        let blanks = vec![blank; 11];
+        let json = format!(r#"{{"windows":[{}]}}"#, [&windows[..], &blanks].concat().join(","));
+        parse(&json)
+    }
+
+    #[test]
+    fn match_unique_titles_on_first_sight() {
+        // Just started: every window's history is its current title only.
+        let session = realistic_session();
+        let mut windows: Vec<(u32, &str, &[&str])> = vec![
+            (1, "Inbox", &["Inbox"]),
+            (2, "News", &["News"]),
+            (3, "Same page", &["Same page"]),
+            (4, "Same page", &["Same page"]),
+        ];
+        windows.extend((10..21).map(|key| (key, BLANK_TITLE, &[BLANK_TITLE][..])));
+        let found = matches(&session, &windows);
+        assert_eq!(found[&1], Match::Tabs(5));
+        assert_eq!(found[&2], Match::Tabs(2));
+        assert_eq!((found[&3], found[&4]), (Match::Ambiguous, Match::Ambiguous));
+        for key in 10..21 {
+            assert_eq!(found[&key], Match::Tabs(1));
+        }
+        // Also with no history at all.
+        let found = matches(&session, &[(1, "Inbox", &[]), (2, "News", &[])]);
+        assert_eq!((found[&1], found[&2]), (Match::Tabs(5), Match::Tabs(2)));
+        // With history the two windows on one page are told apart.
+        let found = matches(&session, &[(3, "Same page", &["A", "Same page"]), (4, "Same page", &["E", "Same page"])]);
+        assert_eq!((found[&3], found[&4]), (Match::Tabs(3), Match::Tabs(4)));
+    }
+
+    /// Window A (3 tabs) switched from "Weather" to "Recipes", window B (4 tabs) to "Notes";
+    /// the file still has A on "Weather". Both have all three pages open.
+    fn switched_session() -> Session {
+        vec![
+            window("Weather", &["Recipes", "Notes"], 3),
+            window("Notes", &["Blank", "Weather", "Recipes"], 4),
+        ]
+    }
+
+    #[test]
+    fn match_window_on_its_own_selected_title_while_another_is_stale() {
+        let session = switched_session();
+        let found = matches(&session, &[(1, "Recipes", &[]), (2, "Notes", &[])]);
+        assert_eq!(found[&2], Match::Tabs(4));
+        assert_ne!(found[&1], Match::Tabs(4));
+        let found =
+            matches(&session, &[(1, "Recipes", &["Weather", "Recipes"]), (2, "Notes", &["Notes"])]);
+        assert_eq!(found[&2], Match::Tabs(4));
+        assert_ne!(found[&1], Match::Tabs(4));
+    }

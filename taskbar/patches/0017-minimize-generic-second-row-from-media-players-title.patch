index 0000000..db112ee
--- /dev/null
+++ b/cosmic-applet-minimize/src/launcher.rs
@@ -0,0 +1,304 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! State of the Unity LauncherEntry API (`com.canonical.Unity.LauncherEntry.Update`), which apps
+//! send for docks: the standard `count`, `progress` and `urgent` keys plus our `x-detail`,
+//! `x-busy`, `x-busy-since` and `x-window-title`. Updates are partial and merged per app and
+//! window title.
+
+use std::collections::{HashMap, HashSet};
+
+use zbus::zvariant::OwnedValue;
+
+use crate::detail::{Status, normalise_app_id};
+
+/// The keys one `Update` signal carries; `None` for keys it leaves out.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct Update {
+    pub count: Option<i64>,
+    pub count_visible: Option<bool>,
+    pub progress: Option<f64>,
+    pub progress_visible: Option<bool>,
+    pub urgent: Option<bool>,
+    pub detail: Option<String>,
+    pub busy: Option<String>,
+    pub busy_since: Option<i64>,
+    pub window_title: Option<String>,
+}
+
+impl Update {
+    pub fn from_properties(properties: &HashMap<String, OwnedValue>) -> Self {
+        let get = |key: &str| properties.get(key);
+        let int = |key| {
+            get(key).and_then(|v| {
+                v.downcast_ref::<i64>()
+                    .or_else(|_| v.downcast_ref::<i32>().map(i64::from))
+                    .or_else(|_| v.downcast_ref::<u32>().map(i64::from))
+                    .ok()
+            })
+        };
+        let bool = |key| get(key).and_then(|v| v.downcast_ref::<bool>().ok());
+        let string = |key| get(key).and_then(|v| v.downcast_ref::<String>().ok());
+        Self {
+            count: int("count"),
+            count_visible: bool("count-visible"),
+            progress: get("progress").and_then(|v| v.downcast_ref::<f64>().ok()),
+            progress_visible: bool("progress-visible"),
+            urgent: bool("urgent"),
+            detail: string("x-detail"),
+            busy: string("x-busy"),
+            busy_since: int("x-busy-since"),
+            window_title: string("x-window-title"),
+        }
+    }
+}
+
+/// The merged state of one app, or one window of it.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct Entry {
+    pub count: i64,
+    pub count_visible: bool,
+    pub progress: f64,
+    pub progress_visible: bool,
+    pub urgent: bool,
+    pub detail: Option<String>,
+    pub busy: Option<String>,
+    pub busy_since: Option<i64>,
+}
+
+impl Entry {
+    /// An empty string or a `x-busy-since` of 0 clears the key.
+    pub fn merge(&mut self, update: &Update) {
+        let text = |value: &Option<String>, old: &mut Option<String>| {
+            if let Some(value) = value {
+                *old = (!value.is_empty()).then(|| value.clone());
+            }
+        };
+        if let Some(count) = update.count {
+            self.count = count;
+        }
+        if let Some(visible) = update.count_visible {
+            self.count_visible = visible;
+        }
+        if let Some(progress) = update.progress {
+            self.progress = progress;
+        }
+        if let Some(visible) = update.progress_visible {
+            self.progress_visible = visible;
+        }
+        if let Some(urgent) = update.urgent {
+            self.urgent = urgent;
+        }
+        text(&update.detail, &mut self.detail);
+        text(&update.busy, &mut self.busy);
+        if let Some(since) = update.busy_since {
+            self.busy_since = (since != 0).then_some(since);
+        }
+    }
+
+    /// Hidden count and progress are left out.
+    pub fn status(&self) -> Status {
+        Status {
+            detail: self.detail.clone(),
+            count: self
+                .count_visible
+                .then(|| u32::try_from(self.count).ok())
+                .flatten(),
+            progress: self.progress_visible.then_some(self.progress as f32),
+            busy: self.busy.clone().map(|busy| (busy, self.busy_since)),
+        }
+    }
+}
+
+/// `application://firefox.desktop` -> `firefox`.
+pub fn app_id_from_uri(uri: &str) -> String {
+    normalise_app_id(uri.strip_prefix("application://").unwrap_or(uri))
+}
+
+/// Entries by normalised app id and window title (`None` for the whole app), with the bus name
+/// of their sender, and the apps that have a window.
+#[derive(Debug, Default)]
+pub struct Launchers {
+    entries: HashMap<(String, Option<String>), (String, Entry)>,
+    apps: HashSet<String>,
+}
+
+impl Launchers {
+    pub fn update(&mut self, sender: &str, app_uri: &str, update: &Update) {
+        let title = update.window_title.clone().filter(|title| !title.is_empty());
+        let (owner, entry) = self.entries.entry((app_id_from_uri(app_uri), title)).or_default();
+        sender.clone_into(owner);
+        entry.merge(update);
+    }
+
+    pub fn sender_gone(&mut self, sender: &str) {
+        self.entries.retain(|_, (owner, _)| owner != sender);
+    }
+
+    /// Forgets apps whose last window closed, given the app ids of all windows. Apps that never
+    /// had a window keep their entries: they may send updates before their window maps.
+    pub fn windows_changed<'a>(&mut self, app_ids: impl IntoIterator<Item = &'a str>) {
+        let apps: HashSet<String> = app_ids.into_iter().map(normalise_app_id).collect();
+        let closed: Vec<&String> = self.apps.difference(&apps).collect();
+        if !closed.is_empty() {
+            self.entries.retain(|(app, _), _| !closed.contains(&app));
+        }
+        self.apps = apps;
+    }
+
+    /// The entry for the window titled `title`, else the app's entry when `active` is the app's
+    /// active window.
+    pub fn get(&self, app_id: &str, title: &str, active: bool) -> Option<&Entry> {
+        let app = normalise_app_id(app_id);
+        self.entries
+            .get(&(app.clone(), Some(title.to_owned())))
+            .or_else(|| active.then(|| self.entries.get(&(app, None))).flatten())
+            .map(|(_, entry)| entry)
+    }
+
+    pub fn any_timed(&self) -> bool {
+        self.entries
+            .values()
+            .any(|(_, entry)| entry.busy.is_some() && entry.busy_since.is_some())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use zbus::zvariant::Value;
+
+    fn props(pairs: &[(&str, Value<'_>)]) -> HashMap<String, OwnedValue> {
+        pairs
+            .iter()
+            .map(|(key, value)| ((*key).to_owned(), value.try_to_owned().unwrap()))
+            .collect()
+    }
+
+    #[test]
+    fn parses_properties() {
+        let update = Update::from_properties(&props(&[
+            ("count", Value::from(5i64)),
+            ("count-visible", Value::from(true)),
+            ("progress", Value::from(0.25f64)),
+            ("urgent", Value::from(false)),
+            ("x-detail", Value::from("v13 · unsaved")),
+            ("x-busy-since", Value::from(100i64)),
+            ("x-window-title", Value::from("Doc")),
+            ("unknown", Value::from(1u8)),
+        ]));
+        assert_eq!(
+            update,
+            Update {
+                count: Some(5),
+                count_visible: Some(true),
+                progress: Some(0.25),
+                urgent: Some(false),
+                detail: Some("v13 · unsaved".into()),
+                busy_since: Some(100),
+                window_title: Some("Doc".into()),
+                ..Update::default()
+            }
+        );
+        assert_eq!(Update::from_properties(&props(&[("count", Value::from(3i32))])).count, Some(3));
+        assert_eq!(Update::from_properties(&props(&[("count", Value::from("3"))])).count, None);
+    }
+
+    #[test]
+    fn merges_partial_updates() {
+        let mut entry = Entry::default();
+        entry.merge(&Update { count: Some(4), count_visible: Some(true), ..Update::default() });
+        entry.merge(&Update { progress: Some(0.4), ..Update::default() });
+        entry.merge(&Update { detail: Some("draft".into()), busy: Some("Cut".into()), busy_since: Some(10), ..Update::default() });
+        assert_eq!(
+            entry,
+            Entry {
+                count: 4,
+                count_visible: true,
+                progress: 0.4,
+                detail: Some("draft".into()),
+                busy: Some("Cut".into()),
+                busy_since: Some(10),
+                ..Entry::default()
+            }
+        );
+        entry.merge(&Update { busy: Some(String::new()), busy_since: Some(0), urgent: Some(true), ..Update::default() });
+        assert_eq!(entry.busy, None);
+        assert_eq!(entry.busy_since, None);
+        assert!(entry.urgent);
+        assert_eq!(entry.detail.as_deref(), Some("draft"));
+        entry.merge(&Update { detail: Some(String::new()), ..Update::default() });
+        assert_eq!(entry.detail, None);
+        assert_eq!(entry.count, 4);
+    }
+
+    #[test]
+    fn maps_to_status() {
+        let mut entry = Entry { count: 3, progress: 0.4, detail: Some("draft".into()), ..Entry::default() };
+        assert_eq!(entry.status(), Status::detail("draft".into()));
+        entry.count_visible = true;
+        entry.progress_visible = true;
+        entry.busy = Some("Cut".into());
+        entry.busy_since = Some(1_000);
+        assert_eq!(
+            entry.status(),
+            Status {
+                detail: Some("draft".into()),
+                count: Some(3),
+                progress: Some(0.4),
+                busy: Some(("Cut".into(), Some(1_000))),
+            }
+        );
+        entry.count = -1;
+        assert_eq!(entry.status().count, None);
+        assert_eq!(
+            crate::detail::label(&entry.status(), 1_037),
+            Some(format!("Cut · {} · {}", crate::fl!("percent", percent = 40), crate::detail::elapsed(37)))
+        );
+    }
+
+    #[test]
+    fn uri_to_app_id() {
+        assert_eq!(app_id_from_uri("application://firefox.desktop"), "firefox");
+        assert_eq!(app_id_from_uri("application://org.Mozilla.Firefox.desktop"), "org.mozilla.firefox");
+        assert_eq!(app_id_from_uri("firefox"), "firefox");
+    }
+
+    #[test]
+    fn targets_window_or_app() {
+        let mut launchers = Launchers::default();
+        let detail = |text: &str, title: Option<&str>| Update {
+            detail: Some(text.into()),
+            window_title: title.map(Into::into),
+            ..Update::default()
+        };
+        launchers.update(":1.5", "application://Editor.desktop", &detail("app", None));
+        assert!(!launchers.any_timed());
+        launchers.update(":1.5", "application://editor.desktop", &detail("one", Some("One")));
+        let label = |l: &Launchers, title, active| {
+            l.get("editor", title, active).and_then(|e| crate::detail::label(&e.status(), 0))
+        };
+        assert_eq!(label(&launchers, "One", false), Some("one".into()));
+        assert_eq!(label(&launchers, "One", true), Some("one".into()));
+        assert_eq!(label(&launchers, "Two", true), Some("app".into()));
+        assert_eq!(label(&launchers, "Two", false), None);
+
+        launchers.windows_changed(["Editor", "other"]);
+        assert_eq!(label(&launchers, "One", false), Some("one".into()));
+        launchers.sender_gone(":1.6");
+        assert_eq!(label(&launchers, "Two", true), Some("app".into()));
+        launchers.sender_gone(":1.5");
+        assert_eq!(label(&launchers, "Two", true), None);
+        assert_eq!(label(&launchers, "One", true), None);
+
+        launchers.update(":1.7", "application://editor.desktop", &detail("app", None));
+        launchers.windows_changed(["other"]);
+        assert_eq!(label(&launchers, "Two", true), None);
+
+        launchers.update(":1.8", "application://early.desktop", &detail("early", None));
+        launchers.windows_changed(["other"]);
+        assert!(launchers.get("early", "", true).is_some());
+        launchers.windows_changed(["early"]);
+        launchers.windows_changed(["other"]);
+        assert!(launchers.get("early", "", true).is_none());
+    }
+}

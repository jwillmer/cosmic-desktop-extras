@@ -0,0 +1,434 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Session bus watcher for MPRIS media players (`org.mpris.MediaPlayer2.*`) and Unity
+//! LauncherEntry updates, driven by signals only, and the matching of players to windows.
+
+use std::{
+    collections::{HashMap, HashSet},
+    sync::Arc,
+};
+
+use cosmic::iced::{
+    self, Subscription,
+    futures::{self, SinkExt, StreamExt, channel::mpsc::Sender},
+    stream,
+};
+use zbus::{
+    MatchRule, MessageStream,
+    fdo::{DBusProxy, PropertiesProxy},
+    message::Type,
+    names::{BusName, InterfaceName},
+    proxy::CacheProperties,
+    zvariant::OwnedValue,
+};
+
+use crate::{
+    detail::{Media, normalise_app_id},
+    launcher,
+};
+
+const PREFIX: &str = "org.mpris.MediaPlayer2.";
+const PATH: &str = "/org/mpris/MediaPlayer2";
+/// Proxy for whichever player was active last; the real players are listed themselves.
+const PLAYERCTLD: &str = "org.mpris.MediaPlayer2.playerctld";
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct Player {
+    pub bus_name: String,
+    /// Unique bus name of the connection that owns `bus_name`.
+    pub owner: String,
+    pub desktop_entry: Option<String>,
+    pub pid: Option<u32>,
+    /// `None` while stopped.
+    pub playing: Option<bool>,
+    pub title: String,
+    pub artist: String,
+}
+
+impl Player {
+    fn media(&self) -> Option<Media> {
+        Some(Media {
+            playing: self.playing?,
+            title: self.title.clone(),
+            artist: self.artist.clone(),
+        })
+    }
+
+    /// The `DesktopEntry` property, else the part of the bus name after the prefix:
+    /// `firefox` for `org.mpris.MediaPlayer2.firefox.instance_1_23`.
+    fn app_id(&self) -> String {
+        match self.desktop_entry.as_deref().filter(|entry| !entry.is_empty()) {
+            Some(entry) => normalise_app_id(entry),
+            None => normalise_app_id(
+                self.bus_name
+                    .strip_prefix(PREFIX)
+                    .and_then(|rest| rest.split('.').next())
+                    .unwrap_or_default(),
+            ),
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub enum Event {
+    /// Every player that is playing or paused.
+    Players(Arc<[Player]>),
+    Launcher {
+        sender: String,
+        app_uri: String,
+        update: launcher::Update,
+    },
+    /// A connection that sent LauncherEntry updates left the bus.
+    SenderGone(String),
+}
+
+/// A window as the matching sees it.
+#[derive(Debug, Clone, Copy)]
+pub struct WindowRef<'a> {
+    pub app_id: &'a str,
+    pub pid: Option<u32>,
+    /// The app's focused, or last focused, window.
+    pub active: bool,
+}
+
+/// Media shown on each window. A player goes to the windows of its desktop entry, else of its
+/// pid; when that leaves several, the one with its pid, else the app's active window. A playing
+/// player wins over a paused one.
+pub fn assign(players: &[Player], windows: &[WindowRef<'_>]) -> Vec<Option<Media>> {
+    let mut media = vec![None; windows.len()];
+    let mut players: Vec<(&Player, Media)> =
+        players.iter().filter_map(|p| Some((p, p.media()?))).collect();
+    players.sort_by_key(|(_, media)| !media.playing);
+    for (player, player_media) in players {
+        if let Some(index) = window_of(player, windows)
+            && media[index].is_none()
+        {
+            media[index] = Some(player_media);
+        }
+    }
+    media
+}
+
+fn window_of(player: &Player, windows: &[WindowRef<'_>]) -> Option<usize> {
+    let app_id = player.app_id();
+    let indices = |pred: &dyn Fn(&WindowRef<'_>) -> bool| -> Vec<usize> {
+        (0..windows.len()).filter(|&i| pred(&windows[i])).collect()
+    };
+    let by_app = indices(&|w| !app_id.is_empty() && normalise_app_id(w.app_id) == app_id);
+    let by_pid = indices(&|w| player.pid.is_some() && w.pid == player.pid);
+    let candidates = if by_app.is_empty() { by_pid.clone() } else { by_app };
+    if candidates.len() <= 1 {
+        return candidates.first().copied();
+    }
+    let with_pid: Vec<usize> = candidates.iter().copied().filter(|i| by_pid.contains(i)).collect();
+    if with_pid.len() == 1 {
+        return with_pid.first().copied();
+    }
+    active_window(&candidates, windows)
+}
+
+/// The active window among `candidates`, else the first.
+pub fn active_window(candidates: &[usize], windows: &[WindowRef<'_>]) -> Option<usize> {
+    candidates
+        .iter()
+        .copied()
+        .find(|&i| windows[i].active)
+        .or_else(|| candidates.first().copied())
+}
+
+fn playback(status: &str) -> Option<bool> {
+    match status {
+        "Playing" => Some(true),
+        "Paused" => Some(false),
+        _ => None,
+    }
+}
+
+/// `xesam:title` and the `xesam:artist` list (some players send a plain string).
+fn metadata(metadata: &HashMap<String, OwnedValue>) -> (String, String) {
+    let title = metadata
+        .get("xesam:title")
+        .and_then(|v| v.downcast_ref::<String>().ok())
+        .unwrap_or_default();
+    let artist = metadata
+        .get("xesam:artist")
+        .and_then(|v| {
+            v.try_clone()
+                .ok()
+                .and_then(|v| Vec::<String>::try_from(v).ok())
+                .map(|artists| artists.join(", "))
+                .or_else(|| v.downcast_ref::<String>().ok())
+        })
+        .unwrap_or_default();
+    (title, artist)
+}
+
+fn is_player(name: &str) -> bool {
+    name.starts_with(PREFIX) && name != PLAYERCTLD
+}
+
+pub fn subscription() -> Subscription<Event> {
+    Subscription::run_with(std::any::TypeId::of::<Event>(), |_| {
+        stream::channel(16, |mut output: Sender<Event>| async move {
+            if let Err(err) = watch(&mut output).await {
+                tracing::warn!("media player and launcher entry watcher stopped: {err}");
+            }
+            iced::futures::future::pending().await
+        })
+    })
+}
+
+async fn watch(output: &mut Sender<Event>) -> zbus::Result<()> {
+    let conn = zbus::Connection::session().await?;
+    let dbus = DBusProxy::new(&conn).await?;
+    let owners = MatchRule::builder()
+        .msg_type(Type::Signal)
+        .sender("org.freedesktop.DBus")?
+        .interface("org.freedesktop.DBus")?
+        .member("NameOwnerChanged")?
+        .build();
+    let properties = MatchRule::builder()
+        .msg_type(Type::Signal)
+        .interface("org.freedesktop.DBus.Properties")?
+        .member("PropertiesChanged")?
+        .path(PATH)?
+        .arg(0, "org.mpris.MediaPlayer2.Player")?
+        .build();
+    let launcher_entry = MatchRule::builder()
+        .msg_type(Type::Signal)
+        .interface("com.canonical.Unity.LauncherEntry")?
+        .member("Update")?
+        .build();
+    // Subscribed before listing the players, so none appears unseen in between.
+    let mut messages = futures::stream::select_all([
+        MessageStream::for_match_rule(owners, &conn, None).await?,
+        MessageStream::for_match_rule(properties, &conn, None).await?,
+        MessageStream::for_match_rule(launcher_entry, &conn, None).await?,
+    ]);
+
+    let mut players = HashMap::new();
+    for name in dbus.list_names().await? {
+        if is_player(name.as_str())
+            && let Some(player) = read_player(&conn, &dbus, name.as_str()).await
+        {
+            players.insert(player.bus_name.clone(), player);
+        }
+    }
+    send_players(output, &players).await;
+
+    let mut launcher_senders = HashSet::new();
+    while let Some(message) = messages.next().await {
+        let Ok(message) = message else {
+            continue;
+        };
+        let header = message.header();
+        let sender = header.sender().map(|sender| sender.to_string());
+        match header.member().map(|member| member.as_str()) {
+            Some("NameOwnerChanged") => {
+                let Ok((name, _, new_owner)) = message.body().deserialize::<(String, String, String)>()
+                else {
+                    continue;
+                };
+                if is_player(&name) {
+                    players.remove(&name);
+                    if !new_owner.is_empty()
+                        && let Some(player) = read_player(&conn, &dbus, &name).await
+                    {
+                        players.insert(name, player);
+                    }
+                    send_players(output, &players).await;
+                } else if new_owner.is_empty() && launcher_senders.remove(&name) {
+                    _ = output.send(Event::SenderGone(name)).await;
+                }
+            }
+            Some("PropertiesChanged") => {
+                let Some(sender) = sender else {
+                    continue;
+                };
+                let names: Vec<String> = players
+                    .values()
+                    .filter(|player| player.owner == sender)
+                    .map(|player| player.bus_name.clone())
+                    .collect();
+                if names.is_empty() {
+                    continue;
+                }
+                for name in names {
+                    match read_player(&conn, &dbus, &name).await {
+                        Some(player) => players.insert(name, player),
+                        None => players.remove(&name),
+                    };
+                }
+                send_players(output, &players).await;
+            }
+            Some("Update") => {
+                let (Some(sender), Ok((app_uri, properties))) = (
+                    sender,
+                    message
+                        .body()
+                        .deserialize::<(String, HashMap<String, OwnedValue>)>(),
+                ) else {
+                    continue;
+                };
+                launcher_senders.insert(sender.clone());
+                let update = launcher::Update::from_properties(&properties);
+                _ = output
+                    .send(Event::Launcher {
+                        sender,
+                        app_uri,
+                        update,
+                    })
+                    .await;
+            }
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+async fn send_players(output: &mut Sender<Event>, players: &HashMap<String, Player>) {
+    let mut active: Vec<Player> = players
+        .values()
+        .filter(|player| player.playing.is_some())
+        .cloned()
+        .collect();
+    active.sort_by(|a, b| a.bus_name.cmp(&b.bus_name));
+    _ = output.send(Event::Players(active.into())).await;
+}
+
+async fn read_player(conn: &zbus::Connection, dbus: &DBusProxy<'_>, name: &str) -> Option<Player> {
+    let bus_name = BusName::try_from(name).ok()?;
+    let owner = dbus.get_name_owner(bus_name.clone()).await.ok()?.to_string();
+    let pid = match BusName::try_from(owner.as_str()) {
+        Ok(owner) => dbus.get_connection_unix_process_id(owner).await.ok(),
+        Err(_) => None,
+    };
+    let properties = PropertiesProxy::builder(conn)
+        .destination(bus_name)
+        .ok()?
+        .path(PATH)
+        .ok()?
+        .cache_properties(CacheProperties::No)
+        .build()
+        .await
+        .ok()?;
+    let desktop_entry = properties
+        .get(InterfaceName::from_static_str_unchecked("org.mpris.MediaPlayer2"), "DesktopEntry")
+        .await
+        .ok()
+        .and_then(|value| String::try_from(value).ok());
+    // A player not ready yet is kept as stopped, so its next PropertiesChanged reads it again.
+    let player = properties
+        .get_all(InterfaceName::from_static_str_unchecked("org.mpris.MediaPlayer2.Player"))
+        .await
+        .unwrap_or_default();
+    let playing = player
+        .get("PlaybackStatus")
+        .and_then(|status| status.downcast_ref::<String>().ok())
+        .and_then(|status| playback(&status));
+    let (title, artist) = player
+        .get("Metadata")
+        .and_then(|value| value.try_clone().ok())
+        .and_then(|value| HashMap::<String, OwnedValue>::try_from(value).ok())
+        .map(|value| metadata(&value))
+        .unwrap_or_default();
+    Some(Player {
+        bus_name: name.to_owned(),
+        owner,
+        desktop_entry,
+        pid,
+        playing,
+        title,
+        artist,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use zbus::zvariant::Value;
+
+    fn player(bus_name: &str, desktop_entry: Option<&str>, pid: Option<u32>, playing: Option<bool>) -> Player {
+        Player {
+            bus_name: format!("{PREFIX}{bus_name}"),
+            owner: ":1.1".into(),
+            desktop_entry: desktop_entry.map(Into::into),
+            pid,
+            playing,
+            title: bus_name.into(),
+            artist: String::new(),
+        }
+    }
+
+    fn window(app_id: &str, pid: Option<u32>, active: bool) -> WindowRef<'_> {
+        WindowRef { app_id, pid, active }
+    }
+
+    /// The title of the player each window shows.
+    fn shown(players: &[Player], windows: &[WindowRef<'_>]) -> Vec<Option<String>> {
+        assign(players, windows).into_iter().map(|m| m.map(|m| m.title)).collect()
+    }
+
+    #[test]
+    fn matches_desktop_entry() {
+        let players = [player("spotify", Some("Spotify.desktop"), None, Some(true))];
+        let windows = [window("firefox", None, true), window("spotify", None, false)];
+        assert_eq!(shown(&players, &windows), [None, Some("spotify".into())]);
+    }
+
+    #[test]
+    fn falls_back_to_bus_name_then_pid() {
+        let players = [
+            player("firefox.instance_1_23", None, None, Some(true)),
+            player("mpv", Some("io.mpv.Mpv"), Some(42), Some(false)),
+        ];
+        let windows = [window("firefox", None, true), window("mpv", Some(42), false)];
+        assert_eq!(shown(&players, &windows), [Some("firefox.instance_1_23".into()), Some("mpv".into())]);
+    }
+
+    #[test]
+    fn several_windows_use_pid_then_active() {
+        let players = [player("firefox.instance_1_23", Some("firefox"), None, Some(true))];
+        let windows = [
+            window("firefox", None, false),
+            window("firefox", None, true),
+            window("org.gnome.Nautilus", None, false),
+        ];
+        assert_eq!(shown(&players, &windows), [None, Some("firefox.instance_1_23".into()), None]);
+        let no_active = [window("firefox", None, false), window("firefox", None, false)];
+        assert_eq!(shown(&players, &no_active), [Some("firefox.instance_1_23".into()), None]);
+
+        let players = [player("vlc", Some("vlc"), Some(7), Some(true))];
+        let windows = [window("vlc", Some(6), true), window("vlc", Some(7), false)];
+        assert_eq!(shown(&players, &windows), [None, Some("vlc".into())]);
+    }
+
+    #[test]
+    fn skips_stopped_and_prefers_playing() {
+        let players = [
+            player("a", Some("app"), None, Some(false)),
+            player("b", Some("app"), None, Some(true)),
+            player("c", Some("other"), None, None),
+        ];
+        let windows = [window("app", None, true), window("other", None, true)];
+        assert_eq!(shown(&players, &windows), [Some("b".into()), None]);
+        assert!(!is_player(PLAYERCTLD));
+        assert!(is_player("org.mpris.MediaPlayer2.vlc"));
+        assert!(!is_player("org.freedesktop.Notifications"));
+    }
+
+    #[test]
+    fn reads_metadata() {
+        let owned = |value: Value<'_>| value.try_to_owned().unwrap();
+        let data = HashMap::from([
+            ("xesam:title".to_owned(), owned(Value::from("Song"))),
+            ("xesam:artist".to_owned(), owned(Value::from(vec!["A", "B"]))),
+        ]);
+        assert_eq!(metadata(&data), ("Song".into(), "A, B".into()));
+        let data = HashMap::from([("xesam:artist".to_owned(), owned(Value::from("Solo")))]);
+        assert_eq!(metadata(&data), (String::new(), "Solo".into()));
+        assert_eq!(playback("Playing"), Some(true));
+        assert_eq!(playback("Paused"), Some(false));
+        assert_eq!(playback("Stopped"), None);
+    }
+}

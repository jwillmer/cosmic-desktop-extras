@@ -0,0 +1,412 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! The two rows of a taskbar item, from data every app already shares: the app's own tab or item
+//! counts, the Unity LauncherEntry, an MPRIS player, an unread count
+//! at the start of the title, or the last part of the title. `~/.config/minimize-ws/detail`
+//! turns rules off per app: lines of `<app-id> <rule>[,<rule>]` with the rules
+//! `-launcher`, `-media`, `-count` and `-split`; `#` comments.
+
+use std::collections::HashMap;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Rule {
+    Launcher,
+    Media,
+    Count,
+    Split,
+}
+
+impl Rule {
+    fn parse(name: &str) -> Option<Self> {
+        Some(match name {
+            "-launcher" => Rule::Launcher,
+            "-media" => Rule::Media,
+            "-count" => Rule::Count,
+            "-split" => Rule::Split,
+            _ => return None,
+        })
+    }
+}
+
+/// Rules turned off, by normalised app id.
+#[derive(Debug, Default, PartialEq)]
+pub struct Overrides(HashMap<String, Vec<Rule>>);
+
+impl Overrides {
+    pub fn allows(&self, app_id: &str, rule: Rule) -> bool {
+        self.0
+            .get(&normalise_app_id(app_id))
+            .is_none_or(|off| !off.contains(&rule))
+    }
+}
+
+pub fn parse_overrides(content: &str) -> Overrides {
+    let mut overrides = Overrides::default();
+    for (number, line) in content.lines().enumerate() {
+        let line = line.split('#').next().unwrap_or_default().trim();
+        let Some((app_id, rules)) = line.split_once(char::is_whitespace) else {
+            if !line.is_empty() {
+                tracing::error!("detail file line {}: no rule after app id {line:?}", number + 1);
+            }
+            continue;
+        };
+        let off = overrides.0.entry(normalise_app_id(app_id)).or_default();
+        for name in rules.split([',', ' ', '\t']).filter(|name| !name.is_empty()) {
+            match Rule::parse(name) {
+                Some(rule) => off.push(rule),
+                None => tracing::error!(
+                    "detail file line {}: unknown rule {name:?} for {app_id}, expected -launcher, \
+                     -media, -count or -split",
+                    number + 1
+                ),
+            }
+        }
+    }
+    overrides
+}
+
+/// Desktop ids and app ids compared case-insensitively and without a `.desktop` suffix.
+pub fn normalise_app_id(id: &str) -> String {
+    let id = id.trim().to_lowercase();
+    match id.strip_suffix(".desktop") {
+        Some(stem) => stem.to_owned(),
+        None => id,
+    }
+}
+
+/// What a media player of the window plays.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub struct Media {
+    pub playing: bool,
+    pub title: String,
+    pub artist: String,
+}
+
+impl Media {
+    pub fn status(&self) -> Status {
+        Status::detail(self.label())
+    }
+
+    fn label(&self) -> String {
+        let mut label = String::from(if self.playing { "▶" } else { "⏸" });
+        let parts: Vec<&str> = [self.title.trim(), self.artist.trim()]
+            .into_iter()
+            .filter(|part| !part.is_empty())
+            .collect();
+        if !parts.is_empty() {
+            label.push(' ');
+            label.push_str(&parts.join(" – "));
+        }
+        label
+    }
+}
+
+/// What one source knows for row 2 of a window. Every source maps its data into this, and
+/// [`label`] turns it into text.
+#[derive(Debug, Clone, Default, PartialEq)]
+pub struct Status {
+    pub detail: Option<String>,
+    pub count: Option<u32>,
+    /// 0..1.
+    pub progress: Option<f32>,
+    /// A running operation and, when known, the unix time it started.
+    pub busy: Option<(String, Option<i64>)>,
+}
+
+impl Status {
+    pub fn detail(text: String) -> Self {
+        Self {
+            detail: Some(text),
+            ..Self::default()
+        }
+    }
+}
+
+/// Row 2 of one status at unix time `now`: busy (with progress and elapsed time), else progress,
+/// else the detail, else the count.
+pub fn label(status: &Status, now: i64) -> Option<String> {
+    let progress = status
+        .progress
+        .filter(|progress| progress.is_finite())
+        .map(|progress| {
+            let percent = (progress.clamp(0.0, 1.0) * 100.0).round() as i64;
+            crate::fl!("percent", percent = percent)
+        });
+    if let Some((busy, since)) = &status.busy {
+        let elapsed = since.map(|since| elapsed(now - since));
+        let parts: Vec<String> = [Some(busy.clone()), progress, elapsed].into_iter().flatten().collect();
+        return Some(parts.join(" · "));
+    }
+    progress
+        .or_else(|| status.detail.clone().filter(|detail| !detail.is_empty()))
+        .or_else(|| status.count.filter(|&count| count > 0).map(unread))
+}
+
+/// `37 s`, `2:05` or `1:02:05`.
+pub fn elapsed(seconds: i64) -> String {
+    let seconds = seconds.max(0);
+    let (hours, minutes, seconds) = (seconds / 3600, seconds / 60 % 60, seconds % 60);
+    if hours > 0 {
+        format!("{hours}:{minutes:02}:{seconds:02}")
+    } else if minutes > 0 {
+        format!("{minutes}:{seconds:02}")
+    } else {
+        crate::fl!("seconds", seconds = seconds)
+    }
+}
+
+fn unread(count: u32) -> String {
+    crate::fl!("unread", count = count)
+}
+
+/// The status of each source for one window, best first. The title rules come last and are
+/// derived from the title in [`detail`].
+#[derive(Debug, Default)]
+pub struct Sources {
+    /// Tabs or items the app reports itself.
+    pub own: Option<Status>,
+    pub launcher: Option<Status>,
+    pub media: Option<Status>,
+}
+
+/// Row 1 and row 2 of a window whose title already lost its trailing app name, at unix time
+/// `now`.
+pub fn detail(
+    title: &str,
+    app_id: &str,
+    sources: Sources,
+    overrides: &Overrides,
+    now: i64,
+) -> (String, Option<String>) {
+    let allows = |rule| overrides.allows(app_id, rule);
+    let full = title;
+    let (title, count) = match count_prefix(title) {
+        Some((count, rest)) if allows(Rule::Count) => (rest, Some(count)),
+        _ => (title, None),
+    };
+    let split = split(title).filter(|_| allows(Rule::Split));
+    let statuses = [
+        sources.own,
+        sources.launcher.filter(|_| allows(Rule::Launcher)),
+        sources.media.filter(|_| allows(Rule::Media)),
+        count.map(|count| Status {
+            count: Some(count),
+            ..Status::default()
+        }),
+        split.map(|(_, tail)| Status::detail(tail.to_owned())),
+    ];
+    let mut labels = statuses
+        .iter()
+        .enumerate()
+        .filter_map(|(index, status)| Some((index, label(status.as_ref()?, now)?)));
+    match labels.next() {
+        Some((index, row2)) if index == statuses.len() - 1 => {
+            (split.map_or(title, |(head, _)| head).to_owned(), Some(row2))
+        }
+        Some((index, row2)) if index < 3 => (full.to_owned(), Some(row2)),
+        Some((_, row2)) => (title.to_owned(), Some(row2)),
+        None => (title.to_owned(), None),
+    }
+}
+
+/// `(3) Chat`, `[3] Chat` or `3 • Chat`: the count and the rest, when the rest is not empty.
+fn count_prefix(title: &str) -> Option<(u32, &str)> {
+    let (digits, rest) = if let Some(rest) = title.strip_prefix('(') {
+        let (digits, rest) = rest.split_once(") ")?;
+        (digits, rest)
+    } else if let Some(rest) = title.strip_prefix('[') {
+        rest.split_once("] ")?
+    } else {
+        title.split_once(" • ")?
+    };
+    let valid = (1..=4).contains(&digits.len())
+        && digits.bytes().all(|b| b.is_ascii_digit())
+        && !digits.starts_with('0');
+    let rest = rest.trim_start();
+    (valid && !rest.is_empty()).then(|| (digits.parse().unwrap_or_default(), rest))
+}
+
+/// The title before and after its last ` — `, ` – ` or ` - `, when both parts have text.
+fn split(title: &str) -> Option<(&str, &str)> {
+    let (at, sep) = [" — ", " – ", " - "]
+        .into_iter()
+        .filter_map(|sep| title.rfind(sep).map(|at| (at, sep)))
+        .max_by_key(|&(at, _)| at)?;
+    let (head, tail) = (title[..at].trim(), title[at + sep.len()..].trim());
+    (!head.is_empty() && !tail.is_empty()).then_some((head, tail))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn rows(title: &str, app_name: &str, app_id: &str) -> (String, Option<String>) {
+        detail(
+            &crate::short_title(title, app_name, app_id),
+            app_id,
+            Sources::default(),
+            &Overrides::default(),
+            0,
+        )
+    }
+
+    #[test]
+    fn real_titles() {
+        let unread = |n| Some(super::unread(n));
+        let some = |s: &str| Some(s.to_owned());
+        let cases: &[(&str, &str, &str, &str, Option<String>)] = &[
+            ("(3) Chat | Microsoft Teams", "Microsoft Teams", "teams-for-linux", "Chat | Microsoft Teams", unread(3)),
+            ("[12] Inbox - Mail", "Thunderbird", "thunderbird", "Inbox - Mail", unread(12)),
+            ("7 • Discord | #general", "Discord", "discord", "Discord | #general", unread(7)),
+            ("Slack | general | Acme", "Slack", "slack", "Slack | general | Acme", None),
+            (
+                "main.rs — demo-project — Visual Studio Code",
+                "Visual Studio Code",
+                "code",
+                "main.rs",
+                some("demo-project"),
+            ),
+            ("Page - Site - Google Chrome", "Google Chrome", "google-chrome", "Page", some("Site")),
+            (
+                "How to parse - Stack Overflow — Mozilla Firefox",
+                "Firefox",
+                "firefox",
+                "How to parse",
+                some("Stack Overflow"),
+            ),
+            (
+                "Fix crash · owner/repo — Mozilla Firefox",
+                "Firefox",
+                "firefox",
+                "Fix crash · owner/repo",
+                None,
+            ),
+            ("Untitled", "Text Editor", "org.gnome.TextEditor", "Untitled", None),
+            ("(3)", "Teams", "teams", "(3)", None),
+            ("(3) ", "Teams", "teams", "(3) ", None),
+            ("(0) Chat", "Teams", "teams", "(0) Chat", None),
+            ("(10000) Chat", "Teams", "teams", "(10000) Chat", None),
+            ("(9999) Chat", "Teams", "teams", "Chat", unread(9999)),
+            ("Song – Band", "Player", "player", "Song", some("Band")),
+            ("Song - Band", "Player", "player", "Song", some("Band")),
+            ("well-known-name", "Player", "player", "well-known-name", None),
+            ("A - B — C", "Player", "player", "A - B", some("C")),
+            (" - Band", "Player", "player", " - Band", None),
+            ("Song - ", "Player", "player", "Song - ", None),
+        ];
+        for (title, name, id, row1, row2) in cases {
+            assert_eq!(rows(title, name, id), (row1.to_string(), row2.clone()), "{title}");
+        }
+    }
+
+    #[test]
+    fn priority() {
+        let media = Media { playing: true, title: "Song".into(), artist: "Band".into() };
+        let all = || Sources {
+            own: Some(Status::detail("3 tabs".into())),
+            launcher: Some(Status { progress: Some(0.4), ..Status::default() }),
+            media: Some(media.status()),
+        };
+        let none = Overrides::default();
+        let row = |sources, overrides: &Overrides| detail("(2) Page - Site", "app", sources, overrides, 0);
+        let percent = crate::fl!("percent", percent = 40);
+        assert_eq!(row(all(), &none), ("(2) Page - Site".into(), Some("3 tabs".into())));
+        assert_eq!(row(Sources { own: None, ..all() }, &none), ("(2) Page - Site".into(), Some(percent)));
+        assert_eq!(
+            row(Sources { own: None, launcher: None, ..all() }, &none),
+            ("(2) Page - Site".into(), Some("▶ Song – Band".into()))
+        );
+        assert_eq!(
+            row(Sources { launcher: Some(Status::default()), media: Some(media.status()), ..Sources::default() }, &none),
+            ("(2) Page - Site".into(), Some("▶ Song – Band".into()))
+        );
+        assert_eq!(row(Sources::default(), &none), ("Page - Site".into(), Some(unread(2))));
+        assert_eq!(
+            detail("Page - Site", "app", Sources::default(), &none, 0),
+            ("Page".into(), Some("Site".into()))
+        );
+    }
+
+    #[test]
+    fn status_labels() {
+        let status = |f: fn(&mut Status)| {
+            let mut status = Status::default();
+            f(&mut status);
+            label(&status, 1_037)
+        };
+        let percent = |p: i64| crate::fl!("percent", percent = p);
+        assert_eq!(status(|_| {}), None);
+        assert_eq!(status(|s| s.count = Some(0)), None);
+        assert_eq!(status(|s| s.count = Some(3)), Some(unread(3)));
+        assert_eq!(status(|s| { s.count = Some(3); s.detail = Some("draft".into()) }), Some("draft".into()));
+        assert_eq!(status(|s| { s.count = Some(3); s.detail = Some(String::new()) }), Some(unread(3)));
+        assert_eq!(status(|s| { s.detail = Some("draft".into()); s.progress = Some(0.4) }), Some(percent(40)));
+        assert_eq!(status(|s| s.progress = Some(7.0)), Some(percent(100)));
+        assert_eq!(status(|s| s.progress = Some(f32::NAN)), None);
+        assert_eq!(status(|s| s.busy = Some(("Cut".into(), None))), Some("Cut".into()));
+        assert_eq!(
+            status(|s| { s.busy = Some(("Cut".into(), None)); s.progress = Some(0.4) }),
+            Some(format!("Cut · {}", percent(40)))
+        );
+        assert_eq!(status(|s| s.busy = Some(("Cut".into(), Some(1_000)))), Some(format!("Cut · {}", elapsed(37))));
+        assert_eq!(status(|s| s.busy = Some(("Cut".into(), Some(2_000)))), Some(format!("Cut · {}", elapsed(0))));
+    }
+
+    #[test]
+    fn elapsed_format() {
+        assert_eq!(elapsed(37), "\u{2068}37\u{2069} s");
+        assert_eq!(elapsed(-5), "\u{2068}0\u{2069} s");
+        assert_eq!(elapsed(125), "2:05");
+        assert_eq!(elapsed(3725), "1:02:05");
+    }
+
+    #[test]
+    fn overrides_turn_rules_off() {
+        let media = Media { playing: false, title: "Song".into(), artist: String::new() };
+        let overrides = parse_overrides(
+            "# rules\nApp.desktop -media, -count  # quiet\nother -split\nbroken\nx -nope,-launcher\n",
+        );
+        assert!(!overrides.allows("app", Rule::Media));
+        assert!(!overrides.allows("APP", Rule::Count));
+        assert!(overrides.allows("app", Rule::Split));
+        assert!(!overrides.allows("x", Rule::Launcher));
+        assert!(overrides.allows("broken", Rule::Split));
+        let sources = || Sources { media: Some(media.status()), ..Sources::default() };
+        assert_eq!(
+            detail("(2) Page - Site", "app", sources(), &overrides, 0),
+            ("(2) Page".into(), Some("Site".into()))
+        );
+        assert_eq!(
+            detail("(2) Page - Site", "other", sources(), &overrides, 0),
+            ("(2) Page - Site".into(), Some("⏸ Song".into()))
+        );
+        assert_eq!(
+            detail("Page - Site", "other", Sources::default(), &overrides, 0),
+            ("Page - Site".into(), None)
+        );
+        let launcher = || Sources { launcher: Some(Status::detail("draft".into())), ..Sources::default() };
+        assert_eq!(detail("Doc", "x", launcher(), &overrides, 0), ("Doc".into(), None));
+        assert_eq!(detail("Doc", "y", launcher(), &overrides, 0), ("Doc".into(), Some("draft".into())));
+        assert_eq!(parse_overrides(""), Overrides::default());
+    }
+
+    #[test]
+    fn media_labels() {
+        let media = |playing, title: &str, artist: &str| Media {
+            playing,
+            title: title.into(),
+            artist: artist.into(),
+        };
+        assert_eq!(media(true, "Song", "Band").label(), "▶ Song – Band");
+        assert_eq!(media(false, "Song", "Band").label(), "⏸ Song – Band");
+        assert_eq!(media(true, "Song", "").label(), "▶ Song");
+        assert_eq!(media(true, "", "Band").label(), "▶ Band");
+        assert_eq!(media(true, " ", "").label(), "▶");
+    }
+
+    #[test]
+    fn app_ids() {
+        assert_eq!(normalise_app_id("Firefox.desktop"), "firefox");
+        assert_eq!(normalise_app_id("org.mozilla.firefox"), "org.mozilla.firefox");
+    }
+}

+    /// Re-reads the ignore file when its modification time changed, or always with `force` (an
+    /// event: a write within the timestamp granularity of the last read keeps the time).
+    fn reload_ignore(&mut self, force: bool) {
+        let Some(path) = self.ignore_path.as_deref() else {
+            return;
+        };
+        let modified = path.metadata().and_then(|m| m.modified()).ok();
+        if modified != self.ignore_modified || force {
+            self.ignore_modified = modified;
+            self.ignored = load_ignore(path);
+        }
+    }
+
+    /// Checks every 2 s whether the taskbar runs, as a taskbar that crashed leaves its pid file
+    /// behind; re-reads the ignore file when it changes.
+    pub fn subscription(&self) -> Subscription<Update> {
+        match &self.ignore_path {
+            Some(path) => Subscription::batch([
+                cosmic::iced::time::every(Duration::from_secs(2)).map(|_| Update::Tick),
+                ignore_watch::subscription(path.clone()).map(|event| Update::Ignore { event }),
+            ]),
+            None => Subscription::none(),
         }
     }
 

+
+fn tab_files_spec(runtime: &Path) -> Spec {
+    Spec {
+        root: Some(runtime.to_owned()),
+        dirs: vec![
+            (runtime.join(TERM_DIR), Source::Terminal),
+            (runtime.join(FILES_DIR), Source::Files),
+        ],
+        rescan: Vec::new(),
+    }

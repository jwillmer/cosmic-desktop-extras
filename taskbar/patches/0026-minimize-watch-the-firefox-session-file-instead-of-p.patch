+/// The session directory of each profile, and the profile bases for new profiles. A profile
+/// without a session directory is watched for its creation; one with a session directory is
+/// not, as its files change often, but the deletion of the session directory is reported.
+fn firefox_spec(home: &Path) -> Spec {
+    let mut spec = Spec::default();
+    for base in firefox_tabs::profile_bases(home) {
+        let Ok(entries) = std::fs::read_dir(&base) else {
+            continue;
+        };
+        let mut profiles: Vec<_> = entries
+            .flatten()
+            .map(|entry| entry.path())
+            .filter(|path| path.is_dir())
+            .collect();
+        profiles.sort_unstable();
+        for profile in profiles {
+            let dir = profile.join(firefox_tabs::SESSION_DIR);
+            if dir.is_dir() {
+                spec.dirs.push((dir, Source::Firefox));
+            } else {
+                spec.rescan.push((profile, Some(firefox_tabs::SESSION_DIR)));
+            }
+        }
+        spec.rescan.push((base, None));
+    }
+    spec
+}

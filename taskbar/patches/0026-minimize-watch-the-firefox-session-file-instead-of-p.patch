+fn run(group: Group) -> Subscription<Change> {
+    Subscription::run_with(group, |&group| {
+        stream::channel(16, move |mut output: Sender<Change>| async move {
+            loop {
+                let spec = match blocking(move || group.spec()).await {
+                    Some(Ok(spec)) => spec,
+                    Some(Err(err)) => {
+                        fall_back(&mut output, group, &err).await;
+                        return;
+                    }
+                    None => return,
+                };
+                if group == Group::Firefox && spec.dirs.is_empty() {
+                    static NO_FIREFOX: Once = Once::new();
+                    NO_FIREFOX.call_once(|| {
+                        tracing::info!(
+                            "no Firefox session directory yet, polling every 2 s until one exists"
+                        );
+                    });
+                    // Nothing to read until then.
+                    tokio::time::sleep(POLL).await;
+                    if output.is_closed() {
+                        return;
+                    }
+                    continue;
+                }
+                // `Ok` when the directories must be looked up again.
+                if let Err(err) = watch(&mut output, group, spec).await {
+                    fall_back(&mut output, group, &err).await;
+                    return;
+                }
             }
         })
     })
 }
 

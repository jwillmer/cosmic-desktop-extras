@@ -0,0 +1,294 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! When a live capture session allocates its buffer and commits its next frame. No Wayland
+//! types, so every sequence of events can be tested.
+//!
+//! The compositor raises `duplicate_frame` when a frame is created while the previous one still
+//! exists, which kills the Wayland connection, and cctk destroys a frame only after its ready or
+//! failed handler returns. So [`Action::Commit`] is never a reaction to [`Event::Ready`] or a
+//! failure: those arm a timer, even with no wait, and the commit follows from the event loop.
+
+use std::time::{Duration, Instant};
+
+/// At most 5 frames per second.
+pub(super) const FRAME_INTERVAL: Duration = Duration::from_millis(200);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Event {
+    /// The session sent its buffer constraints, with this buffer size.
+    Done((u32, u32)),
+    Ready,
+    /// The frame did not fit the buffer constraints. `replaced` if a buffer for the new
+    /// constraints was allocated while the frame was in flight.
+    FailedConstraints { replaced: bool },
+    FailedOther,
+    Stopped,
+    TimerFired(u64),
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Action {
+    /// Replace the buffer with one of the latest size.
+    AllocBuffer,
+    Commit,
+    /// Send [`Event::TimerFired`] with `id` after `wait`.
+    ArmTimer { id: u64, wait: Duration },
+    Stop,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Phase {
+    WaitingConstraints,
+    InFlight,
+    Scheduled(u64),
+    Stopped,
+}
+
+#[derive(Debug)]
+pub(super) struct Pacing {
+    phase: Phase,
+    buffer_size: Option<(u32, u32)>,
+    last_commit: Option<Instant>,
+    timer_serial: u64,
+}
+
+impl Pacing {
+    pub(super) fn new() -> Self {
+        Self {
+            phase: Phase::WaitingConstraints,
+            buffer_size: None,
+            last_commit: None,
+            timer_serial: 0,
+        }
+    }
+
+    pub(super) fn handle(&mut self, event: Event, now: Instant) -> Vec<Action> {
+        let mut actions = Vec::new();
+        match (self.phase, event) {
+            (Phase::Stopped, _) => {}
+            (_, Event::FailedOther | Event::Stopped) => {
+                self.phase = Phase::Stopped;
+                actions.push(Action::Stop);
+            }
+            (phase, Event::Done(size)) => {
+                if self.buffer_size != Some(size) {
+                    self.buffer_size = Some(size);
+                    actions.push(Action::AllocBuffer);
+                }
+                if phase == Phase::WaitingConstraints {
+                    self.commit(now, &mut actions);
+                }
+            }
+            (Phase::InFlight, Event::Ready | Event::FailedConstraints { replaced: true }) => {
+                self.timer_serial += 1;
+                self.phase = Phase::Scheduled(self.timer_serial);
+                let wait = self
+                    .last_commit
+                    .map(|last| FRAME_INTERVAL.saturating_sub(now.saturating_duration_since(last)))
+                    .unwrap_or_default();
+                actions.push(Action::ArmTimer {
+                    id: self.timer_serial,
+                    wait,
+                });
+            }
+            // The next `Done` allocates a buffer for the new constraints and commits.
+            (Phase::InFlight, Event::FailedConstraints { replaced: false }) => {
+                self.buffer_size = None;
+                self.phase = Phase::WaitingConstraints;
+            }
+            (Phase::Scheduled(timer), Event::TimerFired(id)) if timer == id => {
+                self.commit(now, &mut actions);
+            }
+            _ => {}
+        }
+        actions
+    }
+
+    fn commit(&mut self, now: Instant, actions: &mut Vec<Action>) {
+        self.phase = Phase::InFlight;
+        self.last_commit = Some(now);
+        actions.push(Action::Commit);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const SIZE: (u32, u32) = (800, 600);
+    const OTHER_SIZE: (u32, u32) = (1024, 768);
+
+    /// A session with a frame in flight, and the time it was committed.
+    fn in_flight() -> (Pacing, Instant) {
+        let now = Instant::now();
+        let mut pacing = Pacing::new();
+        assert_eq!(
+            pacing.handle(Event::Done(SIZE), now),
+            [Action::AllocBuffer, Action::Commit]
+        );
+        (pacing, now)
+    }
+
+    fn armed_timer(actions: &[Action]) -> u64 {
+        match actions {
+            [Action::ArmTimer { id, .. }] => *id,
+            _ => panic!("expected only ArmTimer, got {actions:?}"),
+        }
+    }
+
+    #[test]
+    fn ready_arms_timer_and_does_not_commit() {
+        let (mut pacing, start) = in_flight();
+        let now = start + Duration::from_millis(50);
+        assert_eq!(
+            pacing.handle(Event::Ready, now),
+            [Action::ArmTimer {
+                id: 1,
+                wait: Duration::from_millis(150)
+            }]
+        );
+    }
+
+    #[test]
+    fn ready_after_interval_still_waits_for_the_timer() {
+        let (mut pacing, start) = in_flight();
+        let now = start + FRAME_INTERVAL * 2;
+        assert_eq!(
+            pacing.handle(Event::Ready, now),
+            [Action::ArmTimer {
+                id: 1,
+                wait: Duration::ZERO
+            }]
+        );
+    }
+
+    #[test]
+    fn replaced_constraints_failure_only_arms_timer() {
+        let (mut pacing, start) = in_flight();
+        assert_eq!(pacing.handle(Event::Done(OTHER_SIZE), start), [Action::AllocBuffer]);
+        let actions = pacing.handle(Event::FailedConstraints { replaced: true }, start);
+        let id = armed_timer(&actions);
+        assert_eq!(pacing.handle(Event::TimerFired(id), start), [Action::Commit]);
+    }
+
+    #[test]
+    fn constraints_failure_without_new_buffer_waits_for_done() {
+        let (mut pacing, start) = in_flight();
+        assert_eq!(
+            pacing.handle(Event::FailedConstraints { replaced: false }, start),
+            []
+        );
+        assert_eq!(
+            pacing.handle(Event::Done(OTHER_SIZE), start),
+            [Action::AllocBuffer, Action::Commit]
+        );
+    }
+
+    #[test]
+    fn done_while_in_flight_allocates_without_commit() {
+        let (mut pacing, start) = in_flight();
+        assert_eq!(pacing.handle(Event::Done(OTHER_SIZE), start), [Action::AllocBuffer]);
+        assert_eq!(pacing.handle(Event::Done(OTHER_SIZE), start), []);
+    }
+
+    #[test]
+    fn stale_timer_is_ignored() {
+        let (mut pacing, start) = in_flight();
+        let first = armed_timer(&pacing.handle(Event::Ready, start));
+        assert_eq!(pacing.handle(Event::TimerFired(first), start), [Action::Commit]);
+        let second = armed_timer(&pacing.handle(Event::Ready, start));
+        assert_ne!(first, second);
+        assert_eq!(pacing.handle(Event::TimerFired(first), start), []);
+        assert_eq!(pacing.handle(Event::TimerFired(second), start), [Action::Commit]);
+    }
+
+    #[test]
+    fn stopped_while_in_flight_stops() {
+        let (mut pacing, start) = in_flight();
+        assert_eq!(pacing.handle(Event::Stopped, start), [Action::Stop]);
+        assert_eq!(pacing.handle(Event::Done(OTHER_SIZE), start), []);
+        assert_eq!(pacing.handle(Event::Ready, start), []);
+    }
+
+    #[test]
+    fn other_failure_stops() {
+        let (mut pacing, start) = in_flight();
+        assert_eq!(pacing.handle(Event::FailedOther, start), [Action::Stop]);
+    }
+
+    #[test]
+    fn repeated_done_keeps_one_frame_in_flight() {
+        let (mut pacing, start) = in_flight();
+        for i in 0..10 {
+            let size = if i % 2 == 0 { OTHER_SIZE } else { SIZE };
+            let actions = pacing.handle(Event::Done(size), start);
+            assert!(!actions.contains(&Action::Commit), "{actions:?}");
+        }
+    }
+
+    #[test]
+    fn no_event_sequence_commits_twice_or_from_a_frame_handler() {
+        let events = [
+            Event::Done(SIZE),
+            Event::Done(OTHER_SIZE),
+            Event::Ready,
+            Event::FailedConstraints { replaced: true },
+            Event::FailedConstraints { replaced: false },
+            Event::FailedOther,
+            Event::Stopped,
+            Event::TimerFired(1),
+            Event::TimerFired(2),
+            Event::TimerFired(3),
+        ];
+        const MAX_LEN: u32 = 6;
+        let start = Instant::now();
+        let mut checked = 0;
+        for len in 1..=MAX_LEN {
+            for n in 0..events.len().pow(len) {
+                let mut pacing = Pacing::new();
+                // What the compositor sees: a commit puts a frame in flight, and its ready or
+                // failed event ends it.
+                let mut frame_in_flight = false;
+                let mut stopped = false;
+                let mut index = n;
+                let mut sequence = Vec::new();
+                for step in 0..len {
+                    let event = events[index % events.len()];
+                    index /= events.len();
+                    sequence.push(event);
+                    let now = start + Duration::from_millis(70) * step;
+                    let actions = pacing.handle(event, now);
+                    let ends_frame = matches!(
+                        event,
+                        Event::Ready | Event::FailedConstraints { .. } | Event::FailedOther
+                    );
+                    if ends_frame {
+                        assert!(
+                            !actions.contains(&Action::Commit),
+                            "commit in a frame handler: {sequence:?} -> {actions:?}"
+                        );
+                        frame_in_flight = false;
+                    }
+                    if stopped {
+                        assert!(
+                            actions.is_empty(),
+                            "action after stop: {sequence:?} -> {actions:?}"
+                        );
+                    }
+                    let commits = actions.iter().filter(|a| **a == Action::Commit).count();
+                    assert!(commits <= 1, "{sequence:?} -> {actions:?}");
+                    if commits == 1 {
+                        assert!(
+                            !frame_in_flight,
+                            "commit with a frame in flight: {sequence:?} -> {actions:?}"
+                        );
+                        frame_in_flight = true;
+                    }
+                    stopped |= actions.contains(&Action::Stop);
+                    checked += 1;
+                }
+            }
+        }
+        assert!(checked > 1_000_000);
+    }
+}

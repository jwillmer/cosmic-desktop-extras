diff --git a/cosmic-applet-minimize/src/window_tabs.rs b/cosmic-applet-minimize/src/window_tabs.rs
new file mode 100644
index 0000000..2fd190a
--- /dev/null
+++ b/cosmic-applet-minimize/src/window_tabs.rs
@@ -0,0 +1,323 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+//! Tab counts of COSMIC Terminal and COSMIC Files windows. A patched cosmic-term (cosmic-desktop-extras
+//! `terminal-tabs`) or cosmic-files writes `$XDG_RUNTIME_DIR/<dir>/<pid>.json` as
+//! `{"windows":[{"title":"<window title>","tabs":<n>,"items":<m>}]}`, where only Files writes
+//! `items`; windows are matched by their title.
+
+use std::{
+    collections::HashMap,
+    path::{Path, PathBuf},
+    time::{Duration, SystemTime},
+};
+
+use serde::Deserialize;
+
+pub const TERM_DIR: &str = "cosmic-term-tabs";
+pub const FILES_DIR: &str = "cosmic-files-tabs";
+
+/// Window title -> its tabs. Titles shared by several windows are left out, because they cannot
+/// be told apart.
+pub type Windows = HashMap<String, Window>;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Deserialize)]
+pub struct Window {
+    pub tabs: usize,
+    #[serde(default)]
+    pub items: Option<usize>,
+}
+
+#[derive(Deserialize)]
+struct File {
+    #[serde(default)]
+    windows: Vec<Entry>,
+}
+
+#[derive(Deserialize)]
+struct Entry {
+    title: String,
+    #[serde(flatten)]
+    window: Window,
+}
+
+/// What the second line of a taskbar item shows.
+#[derive(Debug, PartialEq, Eq)]
+pub enum Detail {
+    Tabs(usize),
+    Items(usize),
+}
+
+impl Detail {
+    pub fn label(&self) -> String {
+        match *self {
+            Detail::Tabs(count) => crate::fl!("tabs", count = count),
+            Detail::Items(count) => crate::fl!("items", count = count),
+        }
+    }
+}
+
+/// The tab count when there are several tabs, else the item count when the app reports one.
+pub fn detail(window: Option<Window>) -> Option<Detail> {
+    let window = window?;
+    if window.tabs > 1 {
+        Some(Detail::Tabs(window.tabs))
+    } else {
+        window.items.map(Detail::Items)
+    }
+}
+
+/// The files of one directory, kept between reads so unchanged files are not parsed again.
+#[derive(Default)]
+pub struct Reader {
+    files: HashMap<PathBuf, Cached>,
+}
+
+struct Cached {
+    modified: SystemTime,
+    /// Read at least `SETTLED` after it was written, so a later write cannot share its mtime.
+    settled: bool,
+    entries: Vec<Entry>,
+}
+
+/// More than the kernel's coarse file timestamp granularity.
+const SETTLED: Duration = Duration::from_secs(1);
+
+impl Reader {
+    /// Reads all files of running processes in `$XDG_RUNTIME_DIR/<dir>`.
+    pub fn load(&mut self, dir: &str) -> Windows {
+        match std::env::var_os("XDG_RUNTIME_DIR") {
+            Some(runtime) => self.load_from(&PathBuf::from(runtime).join(dir)),
+            None => Windows::new(),
+        }
+    }
+
+    fn load_from(&mut self, dir: &Path) -> Windows {
+        let mut files = HashMap::new();
+        if let Ok(entries) = std::fs::read_dir(dir) {
+            for entry in entries.flatten() {
+                let path = entry.path();
+                if let Some(file) = self.read(&path) {
+                    files.insert(path, file);
+                }
+            }
+        }
+        self.files = files;
+
+        let mut windows = Windows::new();
+        let mut shared = Vec::new();
+        for file in self.files.values() {
+            for entry in &file.entries {
+                if windows.insert(entry.title.clone(), entry.window).is_some() {
+                    shared.push(&entry.title);
+                }
+            }
+        }
+        for title in shared {
+            windows.remove(title);
+        }
+        windows
+    }
+
+    fn read(&mut self, path: &Path) -> Option<Cached> {
+        if path.extension().is_none_or(|ext| ext != "json") {
+            return None;
+        }
+        // Skip files left behind by an app that crashed.
+        let alive = path
+            .file_stem()
+            .and_then(|pid| pid.to_str())
+            .and_then(|pid| pid.parse::<u32>().ok())
+            .is_some_and(|pid| Path::new(&format!("/proc/{pid}")).exists());
+        if !alive {
+            return None;
+        }
+        // Fails when the file was removed between listing and reading.
+        let modified = path.metadata().ok()?.modified().ok()?;
+        if let Some(cached) = self.files.remove(path)
+            && cached.settled
+            && cached.modified == modified
+        {
+            return Some(cached);
+        }
+        let settled = SystemTime::now()
+            .duration_since(modified)
+            .is_ok_and(|age| age >= SETTLED);
+        match serde_json::from_slice::<File>(&std::fs::read(path).ok()?) {
+            Ok(file) => Some(Cached {
+                modified,
+                settled,
+                entries: file.windows,
+            }),
+            Err(err) => {
+                tracing::warn!("cannot parse tab file {}: {err}", path.display());
+                None
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A unique empty directory, removed on drop.
+    struct TempDir(PathBuf);
+
+    impl TempDir {
+        fn new(name: &str) -> Self {
+            let dir = std::env::temp_dir().join(format!(
+                "cosmic-applet-minimize-{name}-{}",
+                std::process::id()
+            ));
+            _ = std::fs::remove_dir_all(&dir);
+            std::fs::create_dir_all(&dir).unwrap();
+            Self(dir)
+        }
+
+        fn write(&self, file: &str, content: &str) {
+            std::fs::write(self.0.join(file), content).unwrap();
+        }
+    }
+
+    impl Drop for TempDir {
+        fn drop(&mut self) {
+            _ = std::fs::remove_dir_all(&self.0);
+        }
+    }
+
+    /// A pid with no running process: above the kernel's maximum pid (2^22).
+    const DEAD_PID: u32 = 4_194_305;
+
+    fn own_file() -> String {
+        format!("{}.json", std::process::id())
+    }
+
+    fn tabs(tabs: usize) -> Window {
+        Window { tabs, items: None }
+    }
+
+    fn load(dir: &TempDir) -> Windows {
+        Reader::default().load_from(&dir.0)
+    }
+
+    #[test]
+    fn counts_running_process() {
+        let dir = TempDir::new("running");
+        dir.write(
+            &own_file(),
+            r#"{"windows":[{"title":"~","tabs":3},{"title":"vim","tabs":1}]}"#,
+        );
+        assert_eq!(
+            load(&dir),
+            Windows::from([("~".to_owned(), tabs(3)), ("vim".to_owned(), tabs(1))])
+        );
+    }
+
+    #[test]
+    fn reads_items() {
+        let dir = TempDir::new("items");
+        dir.write(
+            &own_file(),
+            r#"{"windows":[{"title":"Downloads","tabs":1,"items":0},{"title":"Home","tabs":2,"items":7}]}"#,
+        );
+        assert_eq!(
+            load(&dir),
+            Windows::from([
+                ("Downloads".to_owned(), Window { tabs: 1, items: Some(0) }),
+                ("Home".to_owned(), Window { tabs: 2, items: Some(7) }),
+            ])
+        );
+    }
+
+    #[test]
+    fn skips_dead_process_and_other_files() {
+        let dir = TempDir::new("dead");
+        let file = r#"{"windows":[{"title":"~","tabs":3}]}"#;
+        dir.write(&format!("{DEAD_PID}.json"), file);
+        dir.write("notapid.json", file);
+        dir.write(&format!("{}.txt", std::process::id()), file);
+        assert!(load(&dir).is_empty());
+    }
+
+    #[test]
+    fn skips_malformed_file() {
+        let dir = TempDir::new("malformed");
+        dir.write(&own_file(), r#"{"windows":[{"title":"~"}"#);
+        assert!(load(&dir).is_empty());
+    }
+
+    #[test]
+    fn drops_shared_titles() {
+        let dir = TempDir::new("shared");
+        dir.write(
+            &own_file(),
+            r#"{"windows":[{"title":"~","tabs":3},{"title":"~","tabs":2},{"title":"vim","tabs":4}]}"#,
+        );
+        // pid 1 is always running.
+        dir.write("1.json", r#"{"windows":[{"title":"vim","tabs":1},{"title":"htop","tabs":1}]}"#);
+        assert_eq!(load(&dir), Windows::from([("htop".to_owned(), tabs(1))]));
+    }
+
+    #[test]
+    fn rereads_only_changed_files() {
+        let dir = TempDir::new("cache");
+        let path = dir.0.join(own_file());
+        let set_modified = |time| {
+            std::fs::File::options()
+                .write(true)
+                .open(&path)
+                .unwrap()
+                .set_modified(time)
+                .unwrap()
+        };
+        let mut reader = Reader::default();
+
+        // Written just now: a second write in the same timestamp tick is still picked up.
+        dir.write(&own_file(), r#"{"windows":[{"title":"~","tabs":2}]}"#);
+        let fresh = path.metadata().unwrap().modified().unwrap();
+        assert_eq!(reader.load_from(&dir.0), Windows::from([("~".to_owned(), tabs(2))]));
+        dir.write(&own_file(), r#"{"windows":[{"title":"~","tabs":3}]}"#);
+        set_modified(fresh);
+        assert_eq!(reader.load_from(&dir.0), Windows::from([("~".to_owned(), tabs(3))]));
+
+        // Settled and unchanged: the cached content is used.
+        let old = SystemTime::now() - Duration::from_secs(10);
+        set_modified(old);
+        assert_eq!(reader.load_from(&dir.0), Windows::from([("~".to_owned(), tabs(3))]));
+        dir.write(&own_file(), r#"{"windows":[{"title":"~","tabs":5}]}"#);
+        set_modified(old);
+        assert_eq!(reader.load_from(&dir.0), Windows::from([("~".to_owned(), tabs(3))]));
+
+        set_modified(old + Duration::from_secs(1));
+        assert_eq!(reader.load_from(&dir.0), Windows::from([("~".to_owned(), tabs(5))]));
+
+        std::fs::remove_file(&path).unwrap();
+        assert!(reader.load_from(&dir.0).is_empty());
+        assert!(reader.files.is_empty());
+    }
+
+    #[test]

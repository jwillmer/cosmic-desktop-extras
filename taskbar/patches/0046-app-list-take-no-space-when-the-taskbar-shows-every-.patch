+/// Whether the App List draws nothing: the taskbar shows every app it would show. Upstream draws
+/// its own icon when both lists are empty; next to the taskbar that icon is a dead button, so the
+/// applet shrinks to one pixel instead and comes back when it has an item to show again.
+pub fn hides_list(enabled: bool, shows_pinned: bool, shows_active: bool) -> bool {
+    enabled && !shows_pinned && !shows_active
+}
